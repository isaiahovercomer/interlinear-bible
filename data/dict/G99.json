{"G9980":{"lemma":"πηρόω","translit":"pēroō","gloss":"to disable","def":"disable, cripple (<ref='Jhn.12.40'>JHN.12:40</ref> - variant א P66 P75)"},"G9981":{"lemma":"προβάτιον","translit":"probation","gloss":"lamb","def":"<b>προβάτιον</b>, -ου, τό, <BR /> dimin. of πρόβατον (used as a term of endearment, see El., § 27, 4), <b>a little sheep</b>: <ref='Jhn.21.16-17'>Jhn.21:16-17</ref> (πρόβατα, WH, mg.).†<BR /> (AS)"},"G9982":{"lemma":"προσανέχω","translit":"prosanechō","gloss":"to rise up","def":"<b>προσ-αν-έχω</b>, <BR /> <b>to approach</b>: seel. for προσαχέω, <ref='Act.27.27'>Act.27:27</ref> L.†<BR /> (AS)"},"G9983":{"lemma":"προσβιβάζω","translit":"prosbibazō","gloss":"to persuade","def":"persuade (<ref='Act.19.33'>ACT.19:33</ref> - variant)"},"G9984":{"lemma":"προσλέγω","translit":"proslegō","gloss":"to answer","def":"answer, reply (<ref='Mrk.16.14'>MRK.16:14</ref> - variant)"},"G9985":{"lemma":"Πύθιος","translit":"Puthios","gloss":"Pythius","def":"Pythius (<ref='Act.20.4'>ACT.20:4</ref> - variant)"},"G9986":{"lemma":"ὑσσός","translit":"hussos","gloss":"javelin","def":"<b>ὑσσός</b>, -ο, ό, a javelin (see ref. s.v, ὕσσωπος) <BR /> (AS)"},"G9987":{"lemma":"περιραίνω","translit":"perirainō","m":"G:V","gloss":"to sprinkle","def":"sprinkle or cover with (REV.19:13 - variant); pf. <i>passive</i> περιρέραμμαι"},"G9989":{"lemma":"ὅρος","translit":"horos","gloss":"boundary","def":"limit, boundary (<ref='Mrk.16.14-15'>MRK.16:14-15</ref> - variant)"},"G9990":{"lemma":"ιβ","translit":"ib","m":"G:A","gloss":"12","def":"12 as a numeral <br />12 as a numeral"},"G9991":{"lemma":"ρμδ","translit":"rmd","m":"G:A","gloss":"144","def":"144 as a numeral <br />144 as a numeral"},"G9992":{"lemma":"τυπικῶς","translit":"tupikōs","m":"G:ADV","gloss":"figuratively","def":"<b>figuratively, typically, as an example</b> <ref='1Co.10.11'>1Cor. 10:11</ref>*"},"G9993":{"lemma":"ἕλιγμα","translit":"heligma","m":"G:N","gloss":"wrapping","def":"<b>ἕλιγμα</b>, -τος, τό <BR /> (ἑλίσσω), <BR /><b>a roll</b>: <ref='Jhn.19.39'>Jhn.19:39</ref>, WH, txt. (μῖγμα, Rec.; μίγμα, WH, mg., R, txt.).†<BR /> (AS)"},"G9994":{"lemma":"οἰκουργός","translit":"oikourgos","m":"G:A","gloss":"home-working","def":"<b>οἰκουργός</b>, -όν <BR /> (οἶκος + root of ἔργον), <BR /><b>working at home</b>: <ref='Tit.2.5'>Tit.2:5</ref> (Rec. οἰκουρός, which see).†<BR /> (AS)"},"G9995":{"lemma":"ἱερόθυτος","translit":"eirothuros","m":"G:A","gloss":"sacrificed to idols","def":"(food) sacrificed to idols noun <b>meat offered to an idol,</b> <ref='1Co.10.28'>1Cor.10:28</ref>*"},"G9996":{"lemma":"συναλλάσσω","translit":"sunallassō","m":"G:V","gloss":"to reconcile","def":"<b>συν-αλλάσσω</b>, <BR /> <b>to reconcile</b>: imperfect (conative, see M, <i>Pr.</i>, 129), <ref='Act.7.26.'>Act.7:26.</ref>†<BR /> (AS)"}}
