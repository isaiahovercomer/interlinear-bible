3068"]},{"t":" terrors, "},{"t":"I","s":["H5315"]},{"t":" "},{"t":"am","s":["H3068"]},{"t":" distracted."}]},{"n":16,"text":"Your fierce wrath has gone over me. Your terrors have cut me off.","tok":[{"t":"Your","s":["H5375"]},{"t":" fierce wrath has gone "},{"t":"over","s":["H5375"]},{"t":" me. "},{"t":"Your","s":["H5375"]},{"t":" terrors "},{"t":"have","s":["H5375"]},{"t":" cut me "},{"t":"off","s":["H5375"]},{"t":"."}]},{"n":17,"text":"They came around me like water all day long. They completely engulfed me.","tok":[{"t":"They","s":["H5921"],"a":[5]},{"t":" "},{"t":"came","s":["H5674"]},{"t":" "},{"t":"around","s":["H5921"]},{"t":" "},{"t":"me","s":["H5921"]},{"t":" "},{"t":"like","s":["H5921"]},{"t":" water "},{"t":"all","s":["H5921"]},{"t":" day "},{"t":"long","s":["H5921"]},{"t":". "},{"t":"They","s":["H5921"]},{"t":" completely "},{"t":"engulfed","s":["H5921"]},{"t":" "},{"t":"me","s":["H5921"]},{"t":"."}]},{"n":18,"text":"You have put lover and friend far from me, and my friends into darkness.","tok":[{"t":"You","s":["H3605"]},{"t":" "},{"t":"have","s":["H3117"]},{"t":" put lover "},{"t":"and","s":["H3117"]},{"t":" friend "},{"t":"far","s":["H5921"]},{"t":" "},{"t":"from","s":["H5921"]},{"t":" "},{"t":"me","s":["H5921"]},{"t":", "},{"t":"and","s":["H3117"]},{"t":" "},{"t":"my","s":["H3605"]},{"t":" friends "},{"t":"into","s":["H5921"]},{"t":" darkness."}]}]}
