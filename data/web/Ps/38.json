 mouth.","tok":[{"t":"But","s":["H1696"]},{"t":" "},{"t":"I","s":["H3117"]},{"t":", "},{"t":"as","s":["H3117"]},{"t":" "},{"t":"a","s":["H3068"]},{"t":" deaf "},{"t":"man","s":["H5315"]},{"t":", don’t hear. "},{"t":"I","s":["H3117"]},{"t":" am "},{"t":"as","s":["H3117"]},{"t":" "},{"t":"a","s":["H3068"]},{"t":" mute "},{"t":"man","s":["H5315"]},{"t":" "},{"t":"who","s":["H3605"]},{"t":" doesn’t open "},{"t":"his","s":["H3605"]},{"t":" "},{"t":"mouth","s":["H5315"]},{"t":"."}]},{"n":14,"text":"Yes, I am as a man who doesn’t hear, in whose mouth are no reproofs.","tok":[{"t":"Yes, "},{"t":"I","s":["H8085"],"a":[4]},{"t":" am "},{"t":"as","s":["H6310"],"a":[6]},{"t":" "},{"t":"a","s":["H3068"]},{"t":" "},{"t":"man","s":["H2795"]},{"t":" "},{"t":"who","s":["H3808"],"a":[3]},{"t":" doesn’t "},{"t":"hear","s":["H8085"]},{"t":", "},{"t":"in","s":["H8085"]},{"t":" whose "},{"t":"mouth","s":["H6310"]},{"t":" "},{"t":"are","s":["H6310"]},{"t":" "},{"t":"no","s":["H3808"]},{"t":" reproofs."}]},{"n":15,"text":"For I hope in you, LORD. You will answer, Lord my God.","tok":[{"t":"For","s":["H3808"]},{"t":" "},{"t":"I","s":["H3808"]},{"t":" hope "},{"t":"in","s":["H8085"]},{"t":" "},{"t":"you","s":["H3808"]},{"t":", "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":". "},{"t":"You","s":["H3808"]},{"t":" "},{"t":"will","s":["H1961"]},{"t":" answer, Lord "},{"t":"my","s":["H8085"]},{"t":" "},{"t":"God","s":["H3808"]},{"t":"."}]},{"n":16,"text":"For I said, “Don’t let them gloat over me, or exalt themselves over me when my foot slips.”","tok":[{"t":"For","s":["H3588"],"a":[0]},{"t":" "},{"t":"I","s":["H3588"],"a":[0]},{"t":" "},{"t":"said","s":["H6030"]},{"t":", “Don’t let "},{"t":"them","s":["H6030"]},{"t":" gloat "},{"t":"over","s":["H3068"]},{"t":" "},{"t":"me","s":["H6030"]},{"t":", "},{"t":"or","s":["H3068"]},{"t":" exalt themselves "},{"t":"over","s":["H3068"]},{"t":" "},{"t":"me","s":["H6030"]},{"t":" "},{"t":"when","s":["H3588"]},{"t":" "},{"t":"my","s":["H3068"]},{"t":" foot slips.