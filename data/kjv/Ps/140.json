"s":["H5402"],"a":[7]},{"t":"."}]},{"n":8,"text":"Grant not, O LORD, the desires of the wicked: further not his wicked device; lest they exalt themselves. Selah.","tok":[{"t":"Grant","s":["H5414"],"a":[1]},{"t":" not, O "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":", the "},{"t":"desires","s":["H3970"],"a":[3]},{"t":" of the "},{"t":"wicked","s":["H7563"],"a":[4]},{"t":": "},{"t":"further","s":["H6329"],"a":[7]},{"t":" not his wicked "},{"t":"device","s":["H2162"],"a":[5]},{"t":"; lest they "},{"t":"exalt","s":["H7311"],"a":[8]},{"t":" themselves. "},{"t":"Selah","s":["H5542"],"a":[9]},{"t":"."}]},{"n":9,"text":"As for the head of those that compass me about, let the mischief of their own lips cover them.","tok":[{"t":"As for the "},{"t":"head","s":["H7218"],"a":[0]},{"t":" of those that compass me "},{"t":"about","s":["H4524"],"a":[1]},{"t":", let the "},{"t":"mischief","s":["H5999"],"a":[2]},{"t":" of their own "},{"t":"lips","s":["H8193"],"a":[3]},{"t":" "},{"t":"cover","s":["H3680"],"a":[4]},{"t":" them."}]},{"n":10,"text":"Let burning coals fall upon them: let them be cast into the fire; into deep pits, that they rise not up again.","tok":[{"t":"Let burning "},{"t":"coals","s":["H1513"],"a":[2]},{"t":" "},{"t":"fall","s":["H4131"],"a":[0]},{"t":" upon them: let them be "},{"t":"cast","s":["H5307"],"a":[4]},{"t":" into the "},{"t":"fire","s":["H0784"],"a":[3]},{"t":"; into deep "},{"t":"pits","s":["H4113"],"a":[5]},{"t":", that they rise not up "},{"t":"again","s":["H6965"],"a":[7]},{"t":"."}]},{"n":11,"text":"Let not an evil speaker be established in the earth: evil shall hunt the violent man to overthrow him.","tok":[{"t":"Let not an evil "},{"t":"speaker","s":["H0376"],"a":[0]},{"t":" be "},{"t":"established","s":["H3559"],"a":[3]},{"t":" in the "},{"t":"earth","s":["H0776"],"a":[4]},{"t":": "},{"t":"evil","s":["H7451"],"a":[7]},{"t":" shall "},{"t":"hunt","s":["H6679"],"a":[8]},{"t":" the "},{"t":"violent","s":["H2555"],"a":[6]},{"t":" "},{"t":"man","s":["H037