{"v":1,"book":"Ps","ch":90,"verses":[{"n":0,"text":"A Prayer of Moses the man of God.","tok":[{"t":"A "},{"t":"Prayer","s":["H8605"],"a":[0]},{"t":" of "},{"t":"Moses","s":["H4872"],"a":[1]},{"t":" the "},{"t":"man","s":["H0376"],"a":[2]},{"t":" of "},{"t":"God","s":["H0430"],"a":[3]},{"t":"."}]},{"n":1,"text":"Lord, thou hast been our dwelling place in all generations.","tok":[{"t":"Lord","s":["H0136"],"a":[0]},{"t":", thou hast been our dwelling "},{"t":"place","s":["H4583"],"a":[1]},{"t":" in "},{"t":"all","s":["H1755"],"a":[5]},{"t":" "},{"t":"generations","s":["H1755"],"a":[6]},{"t":"."}]},{"n":2,"text":"Before the mountains were brought forth, or ever thou hadst formed the earth and the world, even from everlasting to everlasting, thou art God.","tok":[{"t":"Before the "},{"t":"mountains","s":["H2022"],"a":[1]},{"t":" were brought "},{"t":"forth","s":["H3205"],"a":[2]},{"t":", or ever thou hadst "},{"t":"formed","s":["H2342"],"a":[3]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[4]},{"t":" and the "},{"t":"world","s":["H8398"],"a":[5]},{"t":", even from "},{"t":"everlasting","s":["H5769"],"a":[6]},{"t":" "},{"t":"to","s":["H5704"],"a":[7]},{"t":" "},{"t":"everlasting","s":["H5769"],"a":[8]},{"t":", thou art "},{"t":"God","s":["H0410"],"a":[10]},{"t":"."}]},{"n":3,"text":"Thou turnest man to destruction; and sayest, Return, ye children of men.","tok":[{"t":"Thou "},{"t":"turnest","s":["H7725"],"a":[0]},{"t":" "},{"t":"man","s":["H0582"],"a":[1]},{"t":" to "},{"t":"destruction","s":["H1793"],"a":[3]},{"t":"; and "},{"t":"sayest","s":["H0559"],"a":[4]},{"t":", "},{"t":"Return","s":["H7725"],"a":[5]},{"t":", ye "},{"t":"children","s":["H1121"],"a":[6]},{"t":" of "},{"t":"men","s":["H0120"],"a":[7]},{"t":"."}]},{"n":4,"text":"For a thousand years in thy sight are but as yesterday when it is past, and as a watch in the night.","tok":[{"t":"For a "},{"t":"thousand","s":["H0505"],"a":[1]},{"t":" "},{"t":"years","s":["H8141"],"a":[2]},{"t":" in thy "},{"t":"sight","s":["H5869"],"a":[3]},{"t":" are but "},{"t":"as","s":["H3117"],"a":[4]},{"t":" "},{"t":"yesterday","s":["H0865"],"a":[5]},{"t":" when it is "},{"t":"past","s":["H5674"],"a":[7]},{"t":", and as a "},{"t":"watch","s":["H0821"],"a":[8]},{"t":" in the "},{"t":"night","s":["H3915"],"a":[9]},{"t":"."}]},{"n":5,"text":"Thou carriest them away as with a flood; they are as a sleep: in the morning they are like grass which groweth up.","tok":[{"t":"Thou carriest them away as with a "},{"t":"flood","s":["H2229"],"a":[0]},{"t":"; they are as a "},{"t":"sleep","s":["H8142"],"a":[1]},{"t":": in the "},{"t":"morning","s":["H1242"],"a":[3]},{"t":" they are like "},{"t":"grass","s":["H2682"],"a":[4]},{"t":" which groweth "},{"t":"up","s":["H2498"],"a":[5]},{"t":"."}]},{"n":6,"text":"In the morning it flourisheth, and groweth up; in the evening it is cut down, and withereth.","tok":[{"t":"In the "},{"t":"morning","s":["H1242"],"a":[0]},{"t":" it "},{"t":"flourisheth","s":["H6692"],"a":[1]},{"t":", and groweth "},{"t":"up","s":["H2498"],"a":[2]},{"t":"; in the "},{"t":"evening","s":["H6153"],"a":[3]},{"t":" it is cut "},{"t":"down","s":["H4135"],"a":[4]},{"t":", and "},{"t":"withereth","s":["H3001"],"a":[5]},{"t":"."}]},{"n":7,"text":"For we are consumed by thine anger, and by thy wrath are we troubled.","tok":[{"t":"For we are "},{"t":"consumed","s":["H3615"],"a":[1]},{"t":" by thine "},{"t":"anger","s":["H0639"],"a":[2]},{"t":", and by thy "},{"t":"wrath","s":["H2534"],"a":[3]},{"t":" are we "},{"t":"troubled","s":["H0926"],"a":[4]},{"t":"."}]},{"n":8,"text":"Thou hast set our iniquities before thee, our secret sins in the light of thy countenance.","tok":[{"t":"Thou hast "},{"t":"set","s":["H7896"],"a":[0]},{"t":" our "},{"t":"iniquities","s":["H5771"],"a":[1]},{"t":" before thee, our "},{"t":"secret","s":["H5956"],"a":[3]},{"t":" sins in the "},{"t":"light","s":["H3974"],"a":[4]},{"t":" of thy "},{"t":"countenance","s":["H6440"],"a":[5]},{"t":"."}]},{"n":9,"text":"For all our days are passed away in thy wrath: we spend our years as a tale that is told.","tok":[{"t":"For all our "},{"t":"days","s":["H3117"],"a":[2]},{"t":" are passed "},{"t":"away","s":["H6437"],"a":[3]},{"t":" in thy "},{"t":"wrath","s":["H5678"],"a":[4]},{"t":": we "},{"t":"spend","s":["H3615"],"a":[5]},{"t":" our "},{"t":"years","s":["H8141"],"a":[6]},{"t":" as a "},{"t":"tale","s":["H1899"],"a":[8]},{"t":" that is told."}]},{"n":10,"text":"The days of our years are threescore years and ten; and if by reason of strength they be fourscore years, yet is their strength labour and sorrow; for it is soon cut off, and we fly away.","tok":[{"t":"The "},{"t":"days","s":["H3117"],"a":[0]},{"t":" of our "},{"t":"years","s":["H8141"],"a":[1]},{"t":" are "},{"t":"threescore","s":["H7657"],"a":[3]},{"t":" "},{"t":"years","s":["H8141"],"a":[4]},{"t":" and "},{"t":"ten","s":["H7657"]},{"t":"; and if by reason of "},{"t":"strength","s":["H1369"],"a":[6]},{"t":" they be "},{"t":"fourscore","s":["H8084"],"a":[7]},{"t":" "},{"t":"years","s":["H8141"],"a":[8]},{"t":", yet is their "},{"t":"strength","s":["H7296"],"a":[9]},{"t":" "},{"t":"labour","s":["H5999"],"a":[10]},{"t":" and "},{"t":"sorrow","s":["H0205"],"a":[11]},{"t":"; for it is "},{"t":"soon","s":["H2440"],"a":[14]},{"t":" cut "},{"t":"off","s":["H1468"],"a":[13]},{"t":", and we fly "},{"t":"away","s":["H5774"],"a":[15]},{"t":"."}]},{"n":11,"text":"Who knoweth the power of thine anger? even according to thy fear, so is thy wrath.","tok":[{"t":"Who "},{"t":"knoweth","s":["H3045"],"a":[1]},{"t":" the "},{"t":"power","s":["H5797"],"a":[2]},{"t":" of thine "},{"t":"anger","s":["H0639"],"a":[3]},{"t":"? even according to thy "},{"t":"fear","s":["H3374"],"a":[4]},{"t":", so is thy "},{"t":"wrath","s":["H5678"],"a":[5]},{"t":"."}]},{"n":12,"text":"So teach us to number our days, that we may apply our hearts unto wisdom.","tok":[{"t":"So "},{"t":"teach","s":["H3045"],"a":[3]},{"t":" us to "},{"t":"number","s":["H4487"],"a":[0]},{"t":" our "}