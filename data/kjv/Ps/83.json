{"v":1,"book":"Ps","ch":83,"verses":[{"n":0,"text":"A Song or Psalm of Asaph.","tok":[{"t":"A "},{"t":"Song","s":["H7892"],"a":[0]},{"t":" or "},{"t":"Psalm","s":["H4210"],"a":[1]},{"t":" of "},{"t":"Asaph","s":["H0623"],"a":[2]},{"t":"."}]},{"n":1,"text":"Keep not thou silence, O God: hold not thy peace, and be not still, O God.","tok":[{"t":"Keep not thou "},{"t":"silence","s":["H1824"],"a":[2]},{"t":", O "},{"t":"God","s":["H0430"],"a":[0]},{"t":": hold not thy "},{"t":"peace","s":["H2790"],"a":[5]},{"t":", and be not "},{"t":"still","s":["H8252"],"a":[7]},{"t":", O "},{"t":"God","s":["H0410"],"a":[8]},{"t":"."}]},{"n":2,"text":"For, lo, thine enemies make a tumult: and they that hate thee have lifted up the head.","tok":[{"t":"For, lo, thine "},{"t":"enemies","s":["H0341"],"a":[2]},{"t":" make a "},{"t":"tumult","s":["H1993"],"a":[3]},{"t":": and they that "},{"t":"hate","s":["H8130"],"a":[4]},{"t":" thee have lifted "},{"t":"up","s":["H5375"],"a":[5]},{"t":" the "},{"t":"head","s":["H7218"],"a":[6]},{"t":"."}]},{"n":3,"text":"They have taken crafty counsel against thy people, and consulted against thy hidden ones.","tok":[{"t":"They have taken "},{"t":"crafty","s":["H6191"],"a":[2]},{"t":" "},{"t":"counsel","s":["H5475"],"a":[3]},{"t":" against thy "},{"t":"people","s":["H5971"],"a":[1]},{"t":", and "},{"t":"consulted","s":["H3289"],"a":[4]},{"t":" against thy hidden "},{"t":"ones","s":["H6845"],"a":[6]},{"t":"."}]},{"n":4,"text":"They have said, Come, and let us cut them off from being a nation; that the name of Israel may be no more in remembrance.","tok":[{"t":"They have "},{"t":"said","s":["H0559"],"a":[0]},{"t":", "},{"t":"Come","s":["H3212"]},{"t":", and let us cut them "},{"t":"off","s":["H3582"],"a":[2]},{"t":" from being a "},{"t":"nation","s":["H1471"],"a":[3]},{"t":"; that the "},{"t":"name","s":["H8034"],"a":[6]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[7]},{"t":" may be no more in "},{"t":"remembrance","s":["H2142"],"a":[5]},{"t":"."}]},{"n":5,"text":"For they have consulted together with one consent: they are confederate against thee:","tok":[{"t":"For they have "},{"t":"consulted","s":["H3289"],"a":[1]},{"t":" "},{"t":"together","s":["H3162"],"a":[3]},{"t":" with one "},{"t":"consent","s":["H3820"],"a":[2]},{"t":": they "},{"t":"are","s":["H3772"],"a":[6]},{"t":" "},{"t":"confederate","s":["H1285"],"a":[5]},{"t":" against thee:"}]},{"n":6,"text":"The tabernacles of Edom, and the Ishmaelites; of Moab, and the Hagarenes;","tok":[{"t":"The "},{"t":"tabernacles","s":["H0168"],"a":[0]},{"t":" of "},{"t":"Edom","s":["H0123"],"a":[1]},{"t":", and the "},{"t":"Ishmaelites","s":["H3459"],"a":[2]},{"t":"; of "},{"t":"Moab","s":["H4124"],"a":[3]},{"t":", and the "},{"t":"Hagarenes","s":["H1905"],"a":[4]},{"t":";"}]},{"n":7,"text":"Gebal, and Ammon, and Amalek; the Philistines with the inhabitants of Tyre;","tok":[{"t":"Gebal","s":["H1381"],"a":[0]},{"t":", and "},{"t":"Ammon","s":["H5983"],"a":[1]},{"t":", and "},{"t":"Amalek","s":["H6002"],"a":[2]},{"t":"; the "},{"t":"Philistines","s":["H6429"],"a":[3]},{"t":" with the "},{"t":"inhabitants","s":["H3427"],"a":[5]},{"t":" of "},{"t":"Tyre","s":["H6865"],"a":[6]},{"t":";"}]},{"n":8,"text":"Assur also is joined with them: they have holpen the children of Lot. Selah.","tok":[{"t":"Assur","s":["H0804"],"a":[1]},{"t":" also is "},{"t":"joined","s":["H3867"],"a":[2]},{"t":" with them: they have "},{"t":"holpen","s":["H2220"],"a":[5]},{"t":" the "},{"t":"children","s":["H1121"],"a":[6]},{"t":" of "},{"t":"Lot","s":["H3876"],"a":[7]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[8]},{"t":"."}]},{"n":9,"text":"Do unto them as unto the Midianites; as to Sisera, as to Jabin, at the brook of Kison:","tok":[{"t":"Do","s":["H6213"],"a":[0]},{"t":" unto them as unto the "},{"t":"Midianites","s":["H4080"],"a":[2]},{"t":"; as to "},{"t":"Sisera","s":["H5516"],"a":[3]},{"t":", as to "},{"t":"Jabin","s":["H2985"],"a":[4]},{"t":", at the "},{"t":"brook","s":["H5158"],"a":[5]},{"t":" of "},{"t":"Kison","s":["H7028"],"a":[6]},{"t":":"}]},{"n":10,"text":"Which perished at Endor: they became as dung for the earth.","tok":[{"t":"Which "},{"t":"perished","s":["H8045"],"a":[0]},{"t":" at "},{"t":"Endor","s":["H5874"],"a":[1]},{"t":": they became as "},{"t":"dung","s":["H1828"],"a":[4]},{"t":" for the "},{"t":"earth","s":["H0127"],"a":[5]},{"t":"."}]},{"n":11,"text":"Make their nobles like Oreb, and like Zeeb: yea, all their princes as Zebah, and as Zalmunna:","tok":[{"t":"Make","s":["H7896"],"a":[0]},{"t":" their "},{"t":"nobles","s":["H5081"],"a":[1]},{"t":" like "},{"t":"Oreb","s":["H6159"],"a":[2]},{"t":", and like "},{"t":"Zeeb","s":["H2062"],"a":[3]},{"t":": yea, all their "},{"t":"princes","s":["H5257"],"a":[7]},{"t":" as "},{"t":"Zebah","s":["H2078"],"a":[4]},{"t":", and as "},{"t":"Zalmunna","s":["H6759"],"a":[5]},{"t":":"}]},{"n":12,"text":"Who said, Let us take to ourselves the houses of God in possession.","tok":[{"t":"Who "},{"t":"said","s":["H0559"],"a":[1]},{"t":", Let us take to ourselves the "},{"t":"houses","s":["H4999"],"a":[5]},{"t":" of "},{"t":"God","s":["H0430"],"a":[6]},{"t":" in "},{"t":"possession","s":["H3423"],"a":[2]},{"t":"."}]},{"n":13,"text":"O my God, make them like a wheel; as the stubble before the wind.","tok":[{"t":"O my "},{"t":"God","s":["H0430"],"a":[0]},{"t":", "},{"t":"make","s":["H7896"],"a":[1]},{"t":" them like a "},{"t":"wheel","s":["H1534"],"a":[2]},{"t":"; as the "},{"t":"stubble","s":["H7179"],"a":[3]},{"t":" "},{"t":"before","s":["H6440"],"a":[4]},{"t":" the "},{"t":"wind","s":["H7307"],"a":[5]},{"t":"."}]},{"n":14,"text":"As the fire burneth a wood, and as the flame setteth the mountains on fire;","tok":[{"t":"As the "},{"t":"fire","s":["H0784"],"a":[0]},{"t":" "},{"t":"burneth","s":["H1197"],"a":[1]},{"t":" a "},{"t":"wood","s":["H3293"],"a":[2]},{"t":", and as the "},{"t":"flame","s":["H3852"],"a":[3]},{"t":" "},{"t":"setteth","s":["H3857"],"a":[4]},{"t":" the "},{"t":"mountains","s":["H2022"],"a":[5]},{"t":" on "},{"t":"fire","s":["H3857"]},{"t":";"}]},{"n":15,"text":"So persecute them with thy tempest, and make them afraid with thy storm.","tok":[{"t":"So "},{"t":"persecute","s":["H7291"],"a":[1]},{"t":" them with thy "},{"t":"tempest","s":["H5591"],"a":[2]},{"t":", and make them "},{"t":"afraid","s":["H0926"],"a":[4]},{"t":" with thy "},{"t":"storm","s":["H5492"],"a":[3]},{"t":"."}]},{"n":16,"text":"Fill their faces with shame; that they may seek thy name, O LORD.","tok":[{"t":"Fill","s":["H4390"],"a":[0]},{"t":" their "},{"t":"faces","s":["H6440"],"a":[1]},{"t":" with "},{"t":"shame","s":["H7036"],"a":[2]},{"t":"; that they may "},{"t":"seek","s":["H1245"],"a":[3]},{"t":" thy "},{"t":"name","s":["H8034"],"a":[4]},{"t":", O "},{"t":"LORD","s":["H3068"],"a":[5]},{"t":"."}]},{"n":17,"text":"Let them be confounded and troubled for ever; yea, let them be put to shame, and perish:","tok":[{"t":"Let them be "},{"t":"confounded","s":["H0954"],"a":[0]},{"t":" and "},{"t":"troubled","s":["H0926"],"a":[1]},{"t":" for "},{"t":"ever","s":["H5703"],"a":[2]},{"t":"; yea, let them be put to "},{"t":"shame","s":["H2659"],"a":[4]},{"t":", and "},{"t":"perish","s":["H0006"],"a":[5]},{"t":":"}]},{"n":18,"text":"That men may know that thou, whose name alone is JEHOVAH, art the most high over all the earth.","tok":[{"t":"That men may "},{"t":"know","s":["H3045"],"a":[0]},{"t":" that thou, whose "},{"t":"name","s":["H8034"],"a":[3]},{"t":" alone is "},{"t":"JEHOVAH","s":["H3068"],"a":[4]},{"t":", art the most "},{"t":"high","s":["H5945"],"a":[6]},{"t":" over all the "},{"t":"earth","s":["H0776"],"a":[9]},{"t":"."}]}]}
