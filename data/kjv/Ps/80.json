,"s":["H1121"],"a":[6]},{"t":" of "},{"t":"man","s":["H0120"],"a":[7]},{"t":" whom thou madest "},{"t":"strong","s":["H0553"],"a":[8]},{"t":" for thyself."}]},{"n":18,"text":"So will not we go back from thee: quicken us, and we will call upon thy name.","tok":[{"t":"So will not we go "},{"t":"back","s":["H5472"],"a":[1]},{"t":" from thee: "},{"t":"quicken","s":["H2421"],"a":[3]},{"t":" us, and we will "},{"t":"call","s":["H7121"],"a":[5]},{"t":" upon thy "},{"t":"name","s":["H8034"],"a":[4]},{"t":"."}]},{"n":19,"text":"Turn us again, O LORD God of hosts, cause thy face to shine; and we shall be saved.","tok":[{"t":"Turn us "},{"t":"again","s":["H7725"],"a":[3]},{"t":", O "},{"t":"LORD","s":["H3068"],"a":[0]},{"t":" "},{"t":"God","s":["H0430"],"a":[1]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[2]},{"t":", cause thy "},{"t":"face","s":["H6440"],"a":[5]},{"t":" to "},{"t":"shine","s":["H0215"],"a":[4]},{"t":"; and we shall be "},{"t":"saved","s":["H3467"],"a":[6]},{"t":"."}]}]}
