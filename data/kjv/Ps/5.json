"a":[6]},{"t":" them: let them also that "},{"t":"love","s":["H0157"],"a":[10]},{"t":" thy "},{"t":"name","s":["H8034"],"a":[11]},{"t":" be "},{"t":"joyful","s":["H5970"],"a":[8]},{"t":" in thee."}]},{"n":12,"text":"For thou, LORD, wilt bless the righteous; with favour wilt thou compass him as with a shield.","tok":[{"t":"For thou, "},{"t":"LORD","s":["H3068"],"a":[4]},{"t":", wilt "},{"t":"bless","s":["H1288"],"a":[2]},{"t":" the "},{"t":"righteous","s":["H6662"],"a":[3]},{"t":"; with "},{"t":"favour","s":["H7522"],"a":[6]},{"t":" wilt thou "},{"t":"compass","s":["H5849"],"a":[7]},{"t":" him as with a "},{"t":"shield","s":["H6793"],"a":[5]},{"t":"."}]}]}
