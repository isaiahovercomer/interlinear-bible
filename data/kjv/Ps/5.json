{"v":1,"book":"Ps","ch":5,"verses":[{"n":0,"text":"To the chief Musician upon Nehiloth, A Psalm of David.","tok":[{"t":"To the chief "},{"t":"Musician","s":["H5329"],"a":[0]},{"t":" upon "},{"t":"Nehiloth","s":["H5155"],"a":[2]},{"t":", A "},{"t":"Psalm","s":["H4210"],"a":[3]},{"t":" of "},{"t":"David","s":["H1732"],"a":[4]},{"t":"."}]},{"n":1,"text":"Give ear to my words, O LORD, consider my meditation.","tok":[{"t":"Give "},{"t":"ear","s":["H0238"],"a":[1]},{"t":" to my "},{"t":"words","s":["H0561"],"a":[0]},{"t":", O "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":", "},{"t":"consider","s":["H0995"],"a":[3]},{"t":" my "},{"t":"meditation","s":["H1901"],"a":[4]},{"t":"."}]},{"n":2,"text":"Hearken unto the voice of my cry, my King, and my God: for unto thee will I pray.","tok":[{"t":"Hearken","s":["H7181"],"a":[0]},{"t":" unto the "},{"t":"voice","s":["H6963"],"a":[1]},{"t":" of my "},{"t":"cry","s":["H7773"],"a":[2]},{"t":", my "},{"t":"King","s":["H4428"],"a":[3]},{"t":", and my "},{"t":"God","s":["H0430"],"a":[4]},{"t":": for unto thee will I "},{"t":"pray","s":["H6419"],"a":[7]},{"t":"."}]},{"n":3,"text":"My voice shalt thou hear in the morning, O LORD; in the morning will I direct my prayer unto thee, and will look up.","tok":[{"t":"My "},{"t":"voice","s":["H6963"],"a":[3]},{"t":" shalt thou "},{"t":"hear","s":["H8085"],"a":[2]},{"t":" in the "},{"t":"morning","s":["H1242"],"a":[1]},{"t":", O "},{"t":"LORD","s":["H3068"],"a":[0]},{"t":"; in the "},{"t":"morning","s":["H1242"],"a":[4]},{"t":" will I "},{"t":"direct","s":["H6186"],"a":[5]},{"t":" my prayer unto thee, and will look "},{"t":"up","s":["H6822"],"a":[7]},{"t":"."}]},{"n":4,"text":"For thou art not a God that hath pleasure in wickedness: neither shall evil dwell with thee.","tok":[{"t":"For thou art not a "},{"t":"God","s":["H0410"],"a":[2]},{"t":" that hath "},{"t":"pleasure","s":["H2655"],"a":[3]},{"t":" in "},{"t":"wickedness","s":["H7562"],"a":[4]},{"t":": neither shall "},{"t":"evil","s":["H7451"],"a":[8]},{"t":" "},{"t":"dwell","s":["H1481"],"a":[7]},{"t":" with thee."}]},{"n":5,"text":"The foolish shall not stand in thy sight: thou hatest all workers of iniquity.","tok":[{"t":"The "},{"t":"foolish","s":["H1984"],"a":[2]},{"t":" shall not "},{"t":"stand","s":["H3320"],"a":[1]},{"t":" in thy "},{"t":"sight","s":["H5869"],"a":[4]},{"t":": thou "},{"t":"hatest","s":["H8130"],"a":[5]},{"t":" all "},{"t":"workers","s":["H6466"],"a":[7]},{"t":" of "},{"t":"iniquity","s":["H0205"],"a":[8]},{"t":"."}]},{"n":6,"text":"Thou shalt destroy them that speak leasing: the LORD will abhor the bloody and deceitful man.","tok":[{"t":"Thou shalt "},{"t":"destroy","s":["H0006"],"a":[0]},{"t":" them that "},{"t":"speak","s":["H1696"],"a":[1]},{"t":" "},{"t":"leasing","s":["H3577"],"a":[2]},{"t":": the "},{"t":"LORD","s":["H3068"],"a":[7]},{"t":" will "},{"t":"abhor","s":["H8581"],"a":[6]},{"t":" the "},{"t":"bloody","s":["H1818"],"a":[4]},{"t":" and "},{"t":"deceitful","s":["H4820"],"a":[5]},{"t":" "},{"t":"man","s":["H0376"],"a":[3]},{"t":"."}]},{"n":7,"text":"But as for me, I will come into thy house in the multitude of thy mercy: and in thy fear will I worship toward thy holy temple.","tok":[{"t":"But as for me, I will "},{"t":"come","s":["H0935"],"a":[3]},{"t":" into thy "},{"t":"house","s":["H1004"],"a":[4]},{"t":" in the "},{"t":"multitude","s":["H7230"],"a":[1]},{"t":" of thy "},{"t":"mercy","s":["H2617"],"a":[2]},{"t":": and in thy "},{"t":"fear","s":["H3374"],"a":[9]},{"t":" will I "},{"t":"worship","s":["H7812"],"a":[5]},{"t":" toward thy "},{"t":"holy","s":["H6944"],"a":[8]},{"t":" "},{"t":"temple","s":["H1964"],"a":[7]},{"t":"."}]},{"n":8,"text":"Lead me, O LORD, in thy righteousness because of mine enemies; make thy way straight before my face.","tok":[{"t":"Lead","s":["H5148"],"a":[1]},{"t":" me, O "},{"t":"LORD","s":["H3068"],"a":[0]},{"t":", in thy "},{"t":"righteousness","s":["H6666"],"a":[2]},{"t":" because of mine "},{"t":"enemies","s":["H8324"],"a":[4]},{"t":"; m