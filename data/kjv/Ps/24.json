:5,"text":"He shall receive the blessing from the LORD, and righteousness from the God of his salvation.","tok":[{"t":"He shall "},{"t":"receive","s":["H5375"],"a":[0]},{"t":" the "},{"t":"blessing","s":["H1293"],"a":[1]},{"t":" from the "},{"t":"LORD","s":["H3068"],"a":[3]},{"t":", and "},{"t":"righteousness","s":["H6666"],"a":[4]},{"t":" from the "},{"t":"God","s":["H0430"],"a":[5]},{"t":" of his "},{"t":"salvation","s":["H3468"],"a":[6]},{"t":"."}]},{"n":6,"text":"This is the generation of them that seek him, that seek thy face, O Jacob. Selah.","tok":[{"t":"This is the "},{"t":"generation","s":["H1755"],"a":[1]},{"t":" of them that "},{"t":"seek","s":["H1875"],"a":[2]},{"t":" him, that "},{"t":"seek","s":["H1245"],"a":[3]},{"t":" thy "},{"t":"face","s":["H6440"],"a":[4]},{"t":", O "},{"t":"Jacob","s":["H3290"],"a":[5]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[6]},{"t":"."}]},{"n":7,"text":"Lift up your heads, O ye gates; and be ye lift up, ye everlasting doors; and the King of glory shall come in.","tok":[{"t":"Lift "},{"t":"up","s":["H5375"],"a":[0]},{"t":" your "},{"t":"heads","s":["H7218"],"a":[2]},{"t":", O ye "},{"t":"gates","s":["H8179"],"a":[1]},{"t":"; and be ye lift "},{"t":"up","s":["H5375"],"a":[3]},{"t":", ye "},{"t":"everlasting","s":["H5769"],"a":[5]},{"t":" "},{"t":"doors","s":["H6607"],"a":[4]},{"t":"; and the "},{"t":"King","s":["H4428"],"a":[7]},{"t":" of "},{"t":"glory","s":["H3519"],"a":[8]},{"t":" shall come "},{"t":"in","s":["H0935"],"a":[6]},{"t":"."}]},{"n":8,"text":"Who is this King of glory? The LORD strong and mighty, the LORD mighty in battle.","tok":[{"t":"Who is this "},{"t":"King","s":["H4428"],"a":[2]},{"t":" of "},{"t":"glory","s":["H3519"],"a":[3]},{"t":"? The "},{"t":"LORD","s":["H3068"],"a":[4]},{"t":" "},{"t":"strong","s":["H5808"],"a":[5]},{"t":" and "},{"t":"mighty","s":["H1368"],"a":[6]},{"t":", the "},{"t":"LORD","s":["H3068"],"a":[7]},{"t":" "},{"t":"mighty","s":["H1368"],"a":[8]},{"t":" in "},{"t":"battle","s":["H4421