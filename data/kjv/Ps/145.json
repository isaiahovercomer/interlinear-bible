{"v":1,"book":"Ps","ch":145,"verses":[{"n":0,"text":"David’s Psalm of praise.","tok":[{"t":"David’s","s":["H1732"],"a":[1]},{"t":" Psalm of "},{"t":"praise","s":["H8416"],"a":[0]},{"t":"."}]},{"n":1,"text":"I will extol thee, my God, O king; and I will bless thy name for ever and ever.","tok":[{"t":"I will "},{"t":"extol","s":["H7311"],"a":[0]},{"t":" thee, my "},{"t":"God","s":["H0430"],"a":[1]},{"t":", O "},{"t":"king","s":["H4428"],"a":[2]},{"t":"; and I will "},{"t":"bless","s":["H1288"],"a":[3]},{"t":" thy "},{"t":"name","s":["H8034"],"a":[4]},{"t":" for "},{"t":"ever","s":["H5769"],"a":[5]},{"t":" and "},{"t":"ever","s":["H5703"],"a":[6]},{"t":"."}]},{"n":2,"text":"Every day will I bless thee; and I will praise thy name for ever and ever.","tok":[{"t":"Every "},{"t":"day","s":["H3117"],"a":[1]},{"t":" will I "},{"t":"bless","s":["H1288"],"a":[2]},{"t":" thee; and I will "},{"t":"praise","s":["H1984"],"a":[3]},{"t":" thy "},{"t":"name","s":["H8034"],"a":[4]},{"t":" for "},{"t":"ever","s":["H5769"],"a":[5]},{"t":" and "},{"t":"ever","s":["H5703"],"a":[6]},{"t":"."}]},{"n":3,"text":"Great is the LORD, and greatly to be praised; and his greatness is unsearchable.","tok":[{"t":"Great","s":["H1419"],"a":[0]},{"t":" is the "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":", and "},{"t":"greatly","s":["H3966"],"a":[3]},{"t":" to be "},{"t":"praised","s":["H1984"],"a":[2]},{"t":"; and his "},{"t":"greatness","s":["H1420"],"a":[4]},{"t":" is "},{"t":"unsearchable","s":["H2714"],"a":[6]},{"t":"."}]},{"n":4,"text":"One generation shall praise thy works to another, and shall declare thy mighty acts.","tok":[{"t":"One","s":["H1755"],"a":[0]},{"t":" "},{"t":"generation","s":["H1755"],"a":[1]},{"t":" shall "},{"t":"praise","s":["H7623"],"a":[2]},{"t":" thy "},{"t":"works","s":["H4639"],"a":[3]},{"t":" to another, and shall "},{"t":"declare","s":["H5046"],"a":[5]},{"t":" thy mighty "},{"t":"acts","s":["H1369"],"a":[4]},{"t":"."}]},{"n":5,"text":"I will speak of the glorious honour of thy majesty, and of thy wondrous works.","tok":[{"t":"I will "},{"t":"speak","s":["H7878"],"a":[5]},{"t":" of the "},{"t":"glorious","s":["H3519"],"a":[1]},{"t":" "},{"t":"honour","s":["H1926"],"a":[0]},{"t":" of thy "},{"t":"majesty","s":["H1935"],"a":[2]},{"t":", and of thy "},{"t":"wondrous","s":["H6381"],"a":[4]},{"t":" "},{"t":"works","s":["H1697"],"a":[3]},{"t":"."}]},{"n":6,"text":"And men shall speak of the might of thy terrible acts: and I will declare thy greatness.","tok":[{"t":"And men shall "},{"t":"speak","s":["H0559"],"a":[2]},{"t":" of the "},{"t":"might","s":["H5807"],"a":[0]},{"t":" of thy terrible "},{"t":"acts","s":["H3372"],"a":[1]},{"t":": and I will "},{"t":"declare","s":["H5608"],"a":[4]},{"t":" thy "},{"t":"greatness","s":["H1420"],"a":[3]},{"t":"."}]},{"n":7,"text":"They shall abundantly utter the memory of thy great goodness, and shall sing of thy righteousness.","tok":[{"t":"They shall abundantly "},{"t":"utter","s":["H5042"],"a":[3]},{"t":" the "},{"t":"memory","s":["H2143"],"a":[0]},{"t":" of thy "},{"t":"great","s":["H7227"],"a":[1]},{"t":" "},{"t":"goodness","s":["H2898"],"a":[2]},{"t":", and shall "},{"t":"sing","s":["H7442"],"a":[5]},{"t":" of thy "},{"t":"righteousness","s":["H6666"],"a":[4]},{"t":"."}]},{"n":8,"text":"The LORD is gracious, and full of compassion; slow to anger, and of great mercy.","tok":[{"t":"The "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":" is "},{"t":"gracious","s":["H2587"],"a":[0]},{"t":", and full of "},{"t":"compassion","s":["H7349"],"a":[1]},{"t":"; "},{"t":"slow","s":["H0750"],"a":[3]},{"t":" to "},{"t":"anger","s":["H0639"],"a":[4]},{"t":", and of "},{"t":"great","s":["H1419"],"a":[5]},{"t":" "},{"t":"mercy","s":["H2617"],"a":[6]},{"t":"."}]},{"n":9,"text":"The LORD is good to all: and his tender mercies are over all his works.","tok":[{"t":"The "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":" is "},{"t":"good","s":["H2896"],"a":[0]},{"t":" to all: and his tender "},{"t":"mercies","s":["H7356"],"a":[3]},{"t":" are over all his "},{"t":"works","s":["H4639"],"a":[6]},{"t":"."}]},{"n":10,"text":"All thy works shall praise thee, O LORD; and thy saints shall bless thee.","tok":[{"t":"All thy "},{"t":"works","s":["H4639"],"a":[3]},{"t":" shall "},{"t":"praise","s":["H3034"],"a":[0]},{"t":" thee, O "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":"; and thy "},{"t":"saints","s":["H2623"],"a":[4]},{"t":" shall "},{"t":"bless","s":["H1288"],"a":[5]},{"t":" thee."}]},{"n":11,"text":"They shall speak of the glory of thy kingdom, and talk of thy power;","tok":[{"t":"They shall "},{"t":"speak","s":["H0559"],"a":[2]},{"t":" of the "},{"t":"glory","s":["H3519"],"a":[0]},{"t":" of thy "},{"t":"kingdom","s":["H4438"],"a":[1]},{"t":", and "},{"t":"talk","s":["H1696"],"a":[4]},{"t":" of thy "},{"t":"power","s":["H1369"],"a":[3]},{"t":";"}]},{"n":12,"text":"To make known to the sons of men his mighty acts, and the glorious majesty of his kingdom.","tok":[{"t":"To make "},{"t":"known","s":["H3045"],"a":[0]},{"t":" to the "},{"t":"sons","s":["H1121"],"a":[1]},{"t":" of "},{"t":"men","s":["H0120"],"a":[2]},{"t":" his mighty "},{"t":"acts","s":["H1369"],"a":[3]},{"t":", and the "},{"t":"glorious","s":["H3519"],"a":[4]},{"t":" "},{"t":"majesty","s":["H1926"],"a":[5]},{"t":" of his "},{"t":"kingdom","s":["H4438"],"a":[6]},{"t":"."}]},{"n":13,"text":"Thy kingdom is an everlasting kingdom, and thy dominion endureth throughout all generations.","tok":[{"t":"Thy "},{"t":"kingdom","s":["H4438"],"a":[0]},{"t":" is an "},{"t":"everlasting","s":["H5769"],"a":[3]},{"t":" "},{"t":"kingdom","s":["H4438"],"a":[1]},{"t":", and thy "},{"t":"dominion","s":["H4475"],"a":[4]},{"t":" endureth throughout "},{"t":"all","s":["H1755"],"a":[6]},{"t":" "},{"t":"generations","s":["H1755"],"a":[7]},{"t":"."}]},{"n":14,"text":"The LORD upholdeth all that fall, and raiseth up all those that be bowed down.","tok":[{"t":"The "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":" "},{"t":"upholdeth","s":["H5564"],"a":[0]},{"t":" all that "},{"t":"fall","s":["H5307"],"a":[3]},{"t":", and raiseth "},{"t":"up","s":["H2210"],"a":[4]},{"t":" all those that be bowed "},{"t":"down","s":["H3721"],"a":[6]},{"t":"."}]},{"n":15,"text":"The eyes of all wait upon thee; and thou givest them their meat in due season.","tok":[{"t":"The "},{"t":"eyes","s":["H5869"],"a":[0]},{"t":" of all "},{"t":"wait","s":["H7663"],"a":[3]},{"t":" upon thee; and thou "},{"t":"givest","s":["H5414"],"a":[5]},{"t":" them their "},{"t":"meat","s":["H0400"],"a":[8]},{"t":" in due "},{"t":"season","s":["H6256"],"a":[9]},{"t":"."}]},{"n":16,"text":"Thou openest thine hand, and satisfiest the desire of every living thing.","tok":[{"t":"Thou "},{"t":"openest","s":["H6605"],"a":[0]},{"t":" thine "},{"t":"hand","s":["H3027"],"a":[2]},{"t":", and "},{"t":"satisfiest","s":["H7646"],"a":[3]},{"t":" the "},{"t":"desire","s":["H7522"],"a":[6]},{"t":" of every living "},{"t":"thing","s":["H2416"],"a":[5]},{"t":"."}]},{"n":17,"text":"The LORD is righteous in all his ways, and holy in all his works.","tok":[{"t":"The "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":" is "},{"t":"righteous","s":["H6662"],"a":[0]},{"t":" in all his "},{"t":"ways","s":["H1870"],"a":[3]},{"t":", and "},{"t":"holy","s":["H2623"],"a":[4]},{"t":" in all his "},{"t":"works","s":["H4639"],"a":[6]},{"t":"."}]},{"n":18,"text":"The LORD is nigh unto all them that call upon him, to all that call upon him in truth.","tok":[{"t":"The "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":" is "},{"t":"nigh","s":["H7138"],"a":[0]},{"t":" unto all them that "},{"t":"call","s":["H7121"],"a":[3]},{"t":" upon him, to all that "},{"t":"call","s":["H7121"],"a":[6]},{"t":" upon him in "},{"t":"truth","s":["H0571"],"a":[7]},{"t":"."}]},{"n":19,"text":"He will fulfil the desire of them that fear him: he also will hear their cry, and will save them.","tok":[{"t":"He will "},{"t":"fulfil","s":["H6213"],"a":[2]},{"t":" the "},{"t":"desire","s":["H7522"],"a":[0]},{"t":" of them that "},{"t":"fear","s":["H3373"],"a":[1]},{"t":" him: he also will "},{"t":"hear","s":["H8085"],"a":[5]},{"t":" their "},{"t":"cry","s":["H7775"],"a":[4]},{"t":", and will "},{"t":"save","s":["H3467"],"a":[6]},{"t":" them."}]},{"n":20,"text":"The LORD preserveth all them that love him: but all the wicked will he destroy.","tok":[{"t":"The "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":" "},{"t":"preserveth","s":["H8104"],"a":[0]},{"t":" all them that "},{"t":"love","s":["H0157"],"a":[4]},{"t":" him: but all the "},{"t":"wicked","s":["H7563"],"a":[7]},{"t":" will he "},{"t":"destroy","s":["H8045"],"a":[8]},{"t":"."}]},{"n":21,"text":"My mouth shall speak the praise of the LORD: and let all flesh bless his holy name for ever and ever.","tok":[{"t":"My "},{"t":"mouth","s":["H6310"],"a":[3]},{"t":" shall "},{"t":"speak","s":["H1696"],"a":[2]},{"t":" the "},{"t":"praise","s":["H8416"],"a":[0]},{"t":" of the "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":": and let all "},{"t":"flesh","s":["H1320"],"a":[6]},{"t":" "},{"t":"bless","s":["H1288"],"a":[4]},{"t":" his "},{"t":"holy","s":["H6944"],"a":[8]},{"t":" "},{"t":"name","s":["H8034"],"a":[7]},{"t":" for "},{"t":"ever","s":["H5769"],"a":[9]},{"t":" and "},{"t":"ever","s":["H5703"],"a":[10]},{"t":"."}]}]}
