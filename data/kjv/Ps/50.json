]},{"t":", then thou "},{"t":"consentedst","s":["H7521"],"a":[3]},{"t":" with him, and hast been "},{"t":"partaker","s":["H2506"],"a":[7]},{"t":" with "},{"t":"adulterers","s":["H5003"],"a":[6]},{"t":"."}]},{"n":19,"text":"Thou givest thy mouth to evil, and thy tongue frameth deceit.","tok":[{"t":"Thou "},{"t":"givest","s":["H7971"],"a":[1]},{"t":" thy "},{"t":"mouth","s":["H6310"],"a":[0]},{"t":" to "},{"t":"evil","s":["H7451"],"a":[2]},{"t":", and thy "},{"t":"tongue","s":["H3956"],"a":[3]},{"t":" "},{"t":"frameth","s":["H6775"],"a":[4]},{"t":" "},{"t":"deceit","s":["H4820"],"a":[5]},{"t":"."}]},{"n":20,"text":"Thou sittest and speakest against thy brother; thou slanderest thine own mother’s son.","tok":[{"t":"Thou "},{"t":"sittest","s":["H3427"],"a":[0]},{"t":" and "},{"t":"speakest","s":["H1696"],"a":[2]},{"t":" against thy "},{"t":"brother","s":["H0251"],"a":[1]},{"t":"; "},{"t":"thou","s":["H5414"],"a":[5]},{"t":" "},{"t":"slanderest","s":["H1848"],"a":[6]},{"t":" thine own "},{"t":"mother’s","s":["H0517"],"a":[4]},{"t":" "},{"t":"son","s":["H1121"],"a":[3]},{"t":"."}]},{"n":21,"text":"These things hast thou done, and I kept silence; thou thoughtest that I was altogether such an one as thyself: but I will reprove thee, and set them in order before thine eyes.","tok":[{"t":"These things hast thou "},{"t":"done","s":["H6213"],"a":[1]},{"t":", and I kept "},{"t":"silence","s":["H2790"],"a":[2]},{"t":"; thou "},{"t":"thoughtest","s":["H1819"],"a":[3]},{"t":" that I was "},{"t":"altogether","s":["H1961"],"a":[4]},{"t":" such an one as thyself: but I will "},{"t":"reprove","s":["H3198"],"a":[7]},{"t":" thee, and set them in "},{"t":"order","s":["H6186"],"a":[8]},{"t":" before thine "},{"t":"eyes","s":["H5869"],"a":[9]},{"t":"."}]},{"n":22,"text":"Now consider this, ye that forget God, lest I tear you in pieces, and there be none to deliver.","tok":[{"t":"Now "},{"t":"consider","s":["H0995"],"a":[0]},{"t":" this, ye that "},{"t":"forget","s":["H7911"],"a":[3]},{"t":" "},{"t":"God","s":["H0433"],"a":[4]},{"t":", lest I tear you in "},{"t":"pieces","s":["H2963"],"a":[6]},{"t":", and there be none to "},{"t":"deliver","s":["H5337"],"a":[8]},{"t":"."}]},{"n":23,"text":"Whoso offereth praise glorifieth me: and to him that ordereth his conversation aright will I shew the salvation of God.","tok":[{"t":"Whoso "},{"t":"offereth","s":["H2076"],"a":[0]},{"t":" "},{"t":"praise","s":["H8426"],"a":[1]},{"t":" "},{"t":"glorifieth","s":["H3513"],"a":[2]},{"t":" me: and to him that "},{"t":"ordereth","s":["H7760"],"a":[3]},{"t":" his "},{"t":"conversation","s":["H1870"],"a":[4]},{"t":" aright will I "},{"t":"shew","s":["H7200"],"a":[5]},{"t":" the "},{"t":"salvation","s":["H3468"],"a":[6]},{"t":" of "},{"t":"God","s":["H0430"],"a":[7]},{"t":"."}]}]}
