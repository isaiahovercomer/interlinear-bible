{"v":1,"book":"Ps","ch":50,"verses":[{"n":0,"text":"A Psalm of Asaph.","tok":[{"t":"A "},{"t":"Psalm","s":["H4210"],"a":[0]},{"t":" of "},{"t":"Asaph","s":["H0623"],"a":[1]},{"t":"."}]},{"n":1,"text":"The mighty God, even the LORD, hath spoken, and called the earth from the rising of the sun unto the going down thereof.","tok":[{"t":"The "},{"t":"mighty","s":["H0410"],"a":[0]},{"t":" "},{"t":"God","s":["H0430"],"a":[1]},{"t":", even the "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":", hath "},{"t":"spoken","s":["H1696"],"a":[3]},{"t":", and "},{"t":"called","s":["H7121"],"a":[4]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[5]},{"t":" from the "},{"t":"rising","s":["H4217"],"a":[6]},{"t":" of the "},{"t":"sun","s":["H8121"],"a":[7]},{"t":" unto the going "},{"t":"down","s":["H3996"],"a":[9]},{"t":" thereof."}]},{"n":2,"text":"Out of Zion, the perfection of beauty, God hath shined.","tok":[{"t":"Out of "},{"t":"Zion","s":["H6726"],"a":[0]},{"t":", the "},{"t":"perfection","s":["H4359"],"a":[1]},{"t":" of "},{"t":"beauty","s":["H3308"],"a":[2]},{"t":", "},{"t":"God","s":["H0430"],"a":[3]},{"t":" hath "},{"t":"shined","s":["H3313"],"a":[4]},{"t":"."}]},{"n":3,"text":"Our God shall come, and shall not keep silence: a fire shall devour before him, and it shall be very tempestuous round about him.","tok":[{"t":"Our "},{"t":"God","s":["H0430"],"a":[1]},{"t":" shall "},{"t":"come","s":["H0935"],"a":[0]},{"t":", and shall not keep "},{"t":"silence","s":["H2790"],"a":[3]},{"t":": a "},{"t":"fire","s":["H0784"],"a":[4]},{"t":" shall "},{"t":"devour","s":["H0398"],"a":[6]},{"t":" "},{"t":"before","s":["H6440"],"a":[5]},{"t":" him, and it shall be "},{"t":"very","s":["H3966"],"a":[9]},{"t":" "},{"t":"tempestuous","s":["H8175"],"a":[8]},{"t":" round "},{"t":"about","s":["H5439"],"a":[7]},{"t":" him."}]},{"n":4,"text":"He shall call to the heavens from above, and to the earth, that he may judge his people.","tok":[{"t":"He shall "},{"t":"call","s":["H7121"],"a":[0]},{"t":" to the "},{"t":"heavens","s":["H8064"],"a":[2]},{"t":" from "},{"t":"above","s":["H5920"],"a":[3]},{"t":", and to the "},{"t":"earth","s":["H0776"],"a":[5]},{"t":", that he may "},{"t":"judge","s":["H1777"],"a":[6]},{"t":" his "},{"t":"people","s":["H5971"],"a":[7]},{"t":"."}]},{"n":5,"text":"Gather my saints together unto me; those that have made a covenant with me by sacrifice.","tok":[{"t":"Gather","s":["H0622"],"a":[0]},{"t":" my "},{"t":"saints","s":["H2623"],"a":[2]},{"t":" together unto me; those that have "},{"t":"made","s":["H3772"],"a":[3]},{"t":" a "},{"t":"covenant","s":["H1285"],"a":[4]},{"t":" with me by "},{"t":"sacrifice","s":["H2077"],"a":[6]},{"t":"."}]},{"n":6,"text":"And the heavens shall declare his righteousness: for God is judge himself. Selah.","tok":[{"t":"And the "},{"t":"heavens","s":["H8064"],"a":[1]},{"t":" shall "},{"t":"declare","s":["H5046"],"a":[0]},{"t":" his "},{"t":"righteousness","s":["H6664"],"a":[2]},{"t":": for "},{"t":"God","s":["H0430"],"a":[4]},{"t":" is "},{"t":"judge","s":["H8199"],"a":[5]},{"t":" himself. "},{"t":"Selah","s":["H5542"],"a":[7]},{"t":"."}]},{"n":7,"text":"Hear, O my people, and I will speak; O Israel, and I will testify against thee: I am God, even thy God.","tok":[{"t":"Hear","s":["H8085"],"a":[0]},{"t":", O my "},{"t":"people","s":["H5971"],"a":[1]},{"t":", and I will "},{"t":"speak","s":["H1696"],"a":[2]},{"t":"; O "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":", and I will "},{"t":"testify","s":["H5749"],"a":[4]},{"t":" against thee: I am "},{"t":"God","s":["H0430"],"a":[6]},{"t":", even thy "},{"t":"God","s":["H0430"],"a":[7]},{"t":"."}]},{"n":8,"text":"I will not reprove thee for thy sacrifices or thy burnt offerings, to have been continually before me.","tok":[{"t":"I will not "},{"t":"reprove","s":["H3198"],"a":[3]},{"t":" thee for thy "},{"t":"sacrifices","s":["H2077"],"a":[2]},{"t":" or thy burnt "},{"t":"offerings","s":["H5930"],"a":[4]},{"t":", to have been "},{"t":"continually","s":["H8548"],"a":[6]},{"t":" before me."}]},{"n":9,"text":"I will take no bullock out of thy house, nor he goats out of thy folds.","tok":[{"t":"I will "},{"t":"take","s":["H3947"],"a":[1]},{"t":" no "},{"t":"bullock","s":["H6499"],"a":[3]},{"t":" out of thy "},{"t":"house","s":["H1004"],"a":[2]},{"t":", nor he "},{"t":"goats","s":["H6260"],"a":[5]},{"t":" out of thy "},{"t":"folds","s":["H4356"],"a":[4]},{"t":"."}]},{"n":10,"text":"For every beast of the forest is mine, and the cattle upon a thousand hills.","tok":[{"t":"For every "},{"t":"beast","s":["H2416"],"a":[3]},{"t":" of the "},{"t":"forest","s":["H3293"],"a":[4]},{"t":" is mine, and the "},{"t":"cattle","s":["H0929"],"a":[5]},{"t":" upon a "},{"t":"thousand","s":["H0505"],"a":[7]},{"t":" "},{"t":"hills","s":["H2042"],"a":[6]},{"t":"."}]},{"n":11,"text":"I know all the fowls of the mountains: and the wild beasts of the field are mine.","tok":[{"t":"I "},{"t":"know","s":["H3045"],"a":[0]},{"t":" all the "},{"t":"fowls","s":["H5775"],"a":[2]},{"t":" of the "},{"t":"mountains","s":["H2022"],"a":[3]},{"t":": and the wild "},{"t":"beasts","s":["H2123"],"a":[4]},{"t":" of the "},{"t":"field","s":["H7704"],"a":[5]},{"t":" are "},{"t":"mine","s":["H5978"],"a":[6]},{"t":"."}]},{"n":12,"text":"If I were hungry, I would not tell thee: for the world is mine, and the fulness thereof.","tok":[{"t":"If I were "},{"t":"hungry","s":["H7456"],"a":[1]},{"t":", I would not "},{"t":"tell","s":["H0559"],"a":[3]},{"t":" thee: for the "},{"t":"world","s":["H8398"],"a":[7]},{"t":" is mine, and the "},{"t":"fulness","s":["H4393"],"a":[8]},{"t":" thereof."}]},{"n":13,"text":"Will I eat the flesh of bulls, or drink the blood of goats?","tok":[{"t":"Will I "},{"t":"eat","s":["H0398"],"a":[0]},{"t":" the "},{"t":"flesh","s":["H1320"],"a":[1]},{"t":" of "},{"t":"bulls","s":["H0047"],"a":[2]},{"t":", or "},{"t":"drink","s":["H8354"],"a":[5]},{"t":" the "},{"t":"blood","s":["H1818"],"a":[3]},{"t":" of "},{"t":"goats","s":["H6260"],"a":[4]},{"t":"?"}]},{"n":14,"te