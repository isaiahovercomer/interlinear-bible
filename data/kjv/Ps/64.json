{"v":1,"book":"Ps","ch":64,"verses":[{"n":0,"text":"To the chief Musician, A Psalm of David.","tok":[{"t":"To the chief "},{"t":"Musician","s":["H5329"],"a":[0]},{"t":", A "},{"t":"Psalm","s":["H4210"],"a":[1]},{"t":" of "},{"t":"David","s":["H1732"],"a":[2]},{"t":"."}]},{"n":1,"text":"Hear my voice, O God, in my prayer: preserve my life from fear of the enemy.","tok":[{"t":"Hear","s":["H8085"],"a":[0]},{"t":" my "},{"t":"voice","s":["H6963"],"a":[2]},{"t":", O "},{"t":"God","s":["H0430"],"a":[1]},{"t":", in my "},{"t":"prayer","s":["H7879"],"a":[3]},{"t":": "},{"t":"preserve","s":["H5341"],"a":[6]},{"t":" my "},{"t":"life","s":["H2416"],"a":[7]},{"t":" from "},{"t":"fear","s":["H6343"],"a":[4]},{"t":" of the "},{"t":"enemy","s":["H0341"],"a":[5]},{"t":"."}]},{"n":2,"text":"Hide me from the secret counsel of the wicked; from the insurrection of the workers of iniquity:","tok":[{"t":"Hide","s":["H5641"],"a":[0]},{"t":" me from the secret "},{"t":"counsel","s":["H5475"],"a":[1]},{"t":" of the "},{"t":"wicked","s":["H7489"],"a":[2]},{"t":"; from the "},{"t":"insurrection","s":["H7285"],"a":[3]},{"t":" of the "},{"t":"workers","s":["H6466"],"a":[4]},{"t":" of "},{"t":"iniquity","s":["H0205"],"a":[5]},{"t":":"}]},{"n":3,"text":"Who whet their tongue like a sword, and bend their bows to shoot their arrows, even bitter words:","tok":[{"t":"Who "},{"t":"whet","s":["H8150"],"a":[1]},{"t":" their "},{"t":"tongue","s":["H3956"],"a":[3]},{"t":" like a "},{"t":"sword","s":["H2719"],"a":[2]},{"t":", and "},{"t":"bend","s":["H1869"],"a":[4]},{"t":" their bows to shoot their "},{"t":"arrows","s":["H2671"],"a":[5]},{"t":", even "},{"t":"bitter","s":["H4751"],"a":[7]},{"t":" "},{"t":"words","s":["H1697"],"a":[6]},{"t":":"}]},{"n":4,"text":"That they may shoot in secret at the perfect: suddenly do they shoot at him, and fear not.","tok":[{"t":"That they may "},{"t":"shoot","s":["H3384"],"a":[0]},{"t":" in "},{"t":"secret","s":["H4565"],"a":[1]},{"t":" at the "},{"t":"perfect","s":["H8535"],"a":[2]},{"t":": "},{"t":"suddenly","s":["H6597"],"a":[3]},{"t":" do they "},{"t":"shoot","s":["H3384"],"a":[4]},{"t":" at him, and "},{"t":"fear","s":["H3372"],"a":[6]},{"t":" not."}]},{"n":5,"text":"They encourage themselves in an evil matter: they commune of laying snares privily; they say, Who shall see them?","tok":[{"t":"They "},{"t":"encourage","s":["H2388"],"a":[0]},{"t":" themselves in an "},{"t":"evil","s":["H7451"],"a":[3]},{"t":" "},{"t":"matter","s":["H1697"],"a":[2]},{"t":": they "},{"t":"commune","s":["H5608"],"a":[4]},{"t":" of "},{"t":"laying","s":["H2934"],"a":[5]},{"t":" "},{"t":"snares","s":["H4170"],"a":[6]},{"t":" "},{"t":"privily","s":["H2934"]},{"t":"; they "},{"t":"say","s":["H0559"],"a":[7]},{"t":", Who shall "},{"t":"see","s":["H7200"],"a":[9]},{"t":" them?"}]},{"n":6,"text":"They search out iniquities; they accomplish a diligent search: both the inward thought of every one of them, and the heart, is deep.","tok":[{"t":"They search "},{"t":"out","s":["H2664"],"a":[0]},{"t":" "},{"t":"iniquities","s":["H5766"],"a":[1]},{"t":"; they "},{"t":"accomplish","s":["H8552"],"a":[2]},{"t":" a "},{"t":"diligent","s":["H2664"],"a":[4]},{"t":" "},{"t":"search","s":["H2665"],"a":[3]},{"t":": both the "},{"t":"inward","s":["H7130"],"a":[5]},{"t":" thought of every "},{"t":"one","s":["H0376"],"a":[6]},{"t":" of them, and the "},{"t":"heart","s":["H3820"],"a":[7]},{"t":", is "},{"t":"deep","s":["H6013"],"a":[8]},{"t":"."}]},{"n":7,"text":"But God shall shoot at them with an arrow; suddenly shall they be wounded.","tok":[{"t":"But "},{"t":"God","s":["H0430"],"a":[1]},{"t":" shall "},{"t":"shoot","s":["H3384"],"a":[0]},{"t":" at them with an "},{"t":"arrow","s":["H2671"],"a":[2]},{"t":"; "},{"t":"suddenly","s":["H6597"],"a":[3]},{"t":" shall they be "},{"t":"wounded","s":["H4347"],"a":[5]},{"t":"."}]},{"n":8,"text":"So they shall make their own tongue to fall upon themselves: all that see them shall flee away.","tok":[{"t":"So they shall make their own "},{"t":"tongue","s":["H3956"],"a":[2]},{"t":" to "},{"t":"fall","s":["H3782"],"a":[0]},{"t":" upon themselves: all that "},{"t":"see","s":["H7200"],"a":[5]},{"t":" them shall flee "},{"t":"away","s":["H5074"],"a":[3]},{"t":"."}]},{"n":9,"text":"And all men shall fear, and shall declare the work of God; for they shall wisely consider of his doing.","tok":[{"t":"And all "},{"t":"men","s":["H0120"],"a":[2]},{"t":" shall "},{"t":"fear","s":["H3372"],"a":[0]},{"t":", and shall "},{"t":"declare","s":["H5046"],"a":[3]},{"t":" the "},{"t":"work","s":["H6467"],"a":[4]},{"t":" of "},{"t":"God","s":["H0430"],"a":[5]},{"t":"; for they shall wisely "},{"t":"consider","s":["H7919"],"a":[7]},{"t":" of his "},{"t":"doing","s":["H4639"],"a":[6]},{"t":"."}]},{"n":10,"text":"The righteous shall be glad in the LORD, and shall trust in him; and all the upright in heart shall glory.","tok":[{"t":"The "},{"t":"righteous","s":["H6662"],"a":[1]},{"t":" shall be "},{"t":"glad","s":["H8055"],"a":[0]},{"t":" in the "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":", and shall "},{"t":"trust","s":["H2620"],"a":[3]},{"t":" in him; and all the "},{"t":"upright","s":["H3477"],"a":[7]},{"t":" in "},{"t":"heart","s":["H3820"],"a":[8]},{"t":" shall "},{"t":"glory","s":["H1984"],"a":[5]},{"t":"."}]}]}
