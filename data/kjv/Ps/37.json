":["H2603"],"a":[5]},{"t":", and "},{"t":"giveth","s":["H5414"],"a":[6]},{"t":"."}]},{"n":22,"text":"For such as be blessed of him shall inherit the earth; and they that be cursed of him shall be cut off.","tok":[{"t":"For such as be "},{"t":"blessed","s":["H1288"],"a":[1]},{"t":" of him shall "},{"t":"inherit","s":["H3423"],"a":[2]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[3]},{"t":"; and they that be "},{"t":"cursed","s":["H7043"],"a":[4]},{"t":" of him shall be cut "},{"t":"off","s":["H3772"],"a":[5]},{"t":"."}]},{"n":23,"text":"The steps of a good man are ordered by the LORD: and he delighteth in his way.","tok":[{"t":"The "},{"t":"steps","s":["H4703"],"a":[1]},{"t":" of a good "},{"t":"man","s":["H1397"],"a":[2]},{"t":" are "},{"t":"ordered","s":["H3559"],"a":[3]},{"t":" by the "},{"t":"LORD","s":["H3068"],"a":[0]},{"t":": and he "},{"t":"delighteth","s":["H2654"],"a":[5]},{"t":" in his "},{"t":"way","s":["H1870"],"a":[4]},{"t":"."}]},{"n":24,"text":"Though he fall, he shall not be utterly cast down: for the LORD upholdeth him with his hand.","tok":[{"t":"Though he "},{"t":"fall","s":["H5307"],"a":[1]},{"t":", he shall not be utterly cast "},{"t":"down","s":["H2904"],"a":[3]},{"t":": for the "},{"t":"LORD","s":["H3068"],"a":[5]},{"t":" "},{"t":"upholdeth","s":["H5564"],"a":[6]},{"t":" him with his "},{"t":"hand","s":["H3027"],"a":[7]},{"t":"."}]},{"n":25,"text":"I have been young, and now am old; yet have I not seen the righteous forsaken, nor his seed begging bread.","tok":[{"t":"I have been "},{"t":"young","s":["H5288"],"a":[0]},{"t":", and now am "},{"t":"old","s":["H2204"],"a":[3]},{"t":"; yet have I not "},{"t":"seen","s":["H7200"],"a":[5]},{"t":" the "},{"t":"righteous","s":["H6662"],"a":[6]},{"t":" "},{"t":"forsaken","s":["H5800"],"a":[7]},{"t":", nor his "},{"t":"seed","s":["H2233"],"a":[8]},{"t":" "},{"t":"begging","s":["H1245"],"a":[9]},{"t":" "},{"t":"bread","s":["H3899"],"a":[10]},{"t":"."}]},{"n":26,"text":"He is ever merciful, and lendeth; an