y shall inherit the earth.","tok":[{"t":"For "},{"t":"evildoers","s":["H7489"],"a":[1]},{"t":" shall be cut "},{"t":"off","s":["H3772"],"a":[2]},{"t":": but those that "},{"t":"wait","s":["H6960"],"a":[3]},{"t":" upon the "},{"t":"LORD","s":["H3068"],"a":[4]},{"t":", they shall "},{"t":"inherit","s":["H3423"],"a":[6]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[7]},{"t":"."}]},{"n":10,"text":"For yet a little while, and the wicked shall not be: yea, thou shalt diligently consider his place, and it shall not be.","tok":[{"t":"For yet a little "},{"t":"while","s":["H4592"],"a":[1]},{"t":", and the "},{"t":"wicked","s":["H7563"],"a":[3]},{"t":" shall not be: yea, thou shalt diligently "},{"t":"consider","s":["H0995"],"a":[4]},{"t":" his "},{"t":"place","s":["H4725"],"a":[6]},{"t":", and it shall not be."}]},{"n":11,"text":"But the meek shall inherit the earth; and shall delight themselves in the abundance of peace.","tok":[{"t":"But the "},{"t":"meek","s":["H6035"],"a":[0]},{"t":" shall "},{"t":"inherit","s":["H3423"],"a":[1]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[2]},{"t":"; and shall "},{"t":"delight","s":["H6026"],"a":[3]},{"t":" themselves in the "},{"t":"abundance","s":["H7230"],"a":[5]},{"t":" of "},{"t":"peace","s":["H7965"],"a":[6]},{"t":"."}]},{"n":12,"text":"The wicked plotteth against the just, and gnasheth upon him with his teeth.","tok":[{"t":"The "},{"t":"wicked","s":["H7563"],"a":[1]},{"t":" "},{"t":"plotteth","s":["H2161"],"a":[0]},{"t":" against the "},{"t":"just","s":["H6662"],"a":[2]},{"t":", and "},{"t":"gnasheth","s":["H2786"],"a":[3]},{"t":" upon him with his "},{"t":"teeth","s":["H8127"],"a":[5]},{"t":"."}]},{"n":13,"text":"The Lord shall laugh at him: for he seeth that his day is coming.","tok":[{"t":"The "},{"t":"Lord","s":["H0136"],"a":[0]},{"t":" shall "},{"t":"laugh","s":["H7832"],"a":[1]},{"t":" at him: for he "},{"t":"seeth","s":["H7200"],"a":[4]},{"t":" that his "},{"t":"day","s":["H3117"],"a":[7]},{"t":" is "},{"t":"coming","s"