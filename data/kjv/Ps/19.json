arned","s":["H2094"],"a":[2]},{"t":": and in "},{"t":"keeping","s":["H8104"],"a":[4]},{"t":" of them there is "},{"t":"great","s":["H7227"],"a":[6]},{"t":" "},{"t":"reward","s":["H6118"],"a":[5]},{"t":"."}]},{"n":12,"text":"Who can understand his errors? cleanse thou me from secret faults.","tok":[{"t":"Who can "},{"t":"understand","s":["H0995"],"a":[2]},{"t":" his "},{"t":"errors","s":["H7691"],"a":[0]},{"t":"? "},{"t":"cleanse","s":["H5352"],"a":[4]},{"t":" thou me from "},{"t":"secret","s":["H5641"],"a":[3]},{"t":" faults."}]},{"n":13,"text":"Keep back thy servant also from presumptuous sins; let them not have dominion over me: then shall I be upright, and I shall be innocent from the great transgression.","tok":[{"t":"Keep "},{"t":"back","s":["H2820"],"a":[2]},{"t":" thy "},{"t":"servant","s":["H5650"],"a":[3]},{"t":" also from "},{"t":"presumptuous","s":["H2086"],"a":[1]},{"t":" sins; let them not have "},{"t":"dominion","s":["H4910"],"a":[5]},{"t":" over me: then shall I be "},{"t":"upright","s":["H8552"],"a":[8]},{"t":", and I shall be "},{"t":"innocent","s":["H5352"],"a":[9]},{"t":" from the "},{"t":"great","s":["H7227"],"a":[11]},{"t":" "},{"t":"transgression","s":["H6588"],"a":[10]},{"t":"."}]},{"n":14,"text":"Let the words of my mouth, and the meditation of my heart, be acceptable in thy sight, O LORD, my strength, and my redeemer.","tok":[{"t":"Let the "},{"t":"words","s":["H0561"],"a":[2]},{"t":" of my "},{"t":"mouth","s":["H6310"],"a":[3]},{"t":", and the "},{"t":"meditation","s":["H1902"],"a":[4]},{"t":" of my "},{"t":"heart","s":["H3820"],"a":[5]},{"t":", be "},{"t":"acceptable","s":["H7522"],"a":[1]},{"t":" in thy "},{"t":"sight","s":["H6440"],"a":[6]},{"t":", O "},{"t":"LORD","s":["H3068"],"a":[7]},{"t":", my "},{"t":"strength","s":["H6697"],"a":[8]},{"t":", and my "},{"t":"redeemer","s":["H1350"],"a":[9]},{"t":"."}]}]}
