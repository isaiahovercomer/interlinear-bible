ght about me.","tok":[{"t":"If I "},{"t":"say","s":["H0559"],"a":[0]},{"t":", Surely the "},{"t":"darkness","s":["H2822"],"a":[2]},{"t":" shall "},{"t":"cover","s":["H7779"],"a":[3]},{"t":" me; even the "},{"t":"night","s":["H3915"],"a":[4]},{"t":" shall be "},{"t":"light","s":["H0216"],"a":[5]},{"t":" about "},{"t":"me","s":["H1157"],"a":[6]},{"t":"."}]},{"n":12,"text":"Yea, the darkness hideth not from thee; but the night shineth as the day: the darkness and the light are both alike to thee.","tok":[{"t":"Yea, the "},{"t":"darkness","s":["H2822"],"a":[1]},{"t":" "},{"t":"hideth","s":["H2821"],"a":[3]},{"t":" not from thee; but the "},{"t":"night","s":["H3915"],"a":[5]},{"t":" "},{"t":"shineth","s":["H0215"],"a":[7]},{"t":" as the "},{"t":"day","s":["H3117"],"a":[6]},{"t":": the "},{"t":"darkness","s":["H2825"],"a":[8]},{"t":" and the "},{"t":"light","s":["H0219"],"a":[9]},{"t":" are both alike to thee."}]},{"n":13,"text":"For thou hast possessed my reins: thou hast covered me in my mother’s womb.","tok":[{"t":"For thou hast "},{"t":"possessed","s":["H7069"],"a":[2]},{"t":" my "},{"t":"reins","s":["H3629"],"a":[3]},{"t":": thou hast "},{"t":"covered","s":["H5526"],"a":[4]},{"t":" me in my "},{"t":"mother’s","s":["H0517"],"a":[6]},{"t":" "},{"t":"womb","s":["H0990"],"a":[5]},{"t":"."}]},{"n":14,"text":"I will praise thee; for I am fearfully and wonderfully made: marvellous are thy works; and that my soul knoweth right well.","tok":[{"t":"I will "},{"t":"praise","s":["H3034"],"a":[0]},{"t":" thee; for I am "},{"t":"fearfully","s":["H3372"],"a":[3]},{"t":" and wonderfully "},{"t":"made","s":["H6395"],"a":[4]},{"t":": "},{"t":"marvellous","s":["H6381"],"a":[5]},{"t":" are thy "},{"t":"works","s":["H4639"],"a":[6]},{"t":"; and that my "},{"t":"soul","s":["H5315"],"a":[7]},{"t":" "},{"t":"knoweth","s":["H3045"],"a":[8]},{"t":" right "},{"t":"well","s":["H3966"],"a":[9]},{"t":"."}]},{"n":15,"text":"My substance was not hid from thee, when I was made in secret, and curious