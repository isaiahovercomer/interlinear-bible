{"v":1,"book":"Ps","ch":92,"verses":[{"n":0,"text":"A Psalm or Song for the sabbath day.","tok":[{"t":"A "},{"t":"Psalm","s":["H4210"],"a":[0]},{"t":" or "},{"t":"Song","s":["H7892"],"a":[1]},{"t":" for the "},{"t":"sabbath","s":["H7676"],"a":[3]},{"t":" "},{"t":"day","s":["H3117"],"a":[2]},{"t":"."}]},{"n":1,"text":"It is a good thing to give thanks unto the LORD, and to sing praises unto thy name, O most High:","tok":[{"t":"It is a "},{"t":"good","s":["H2896"]},{"t":" thing to give "},{"t":"thanks","s":["H3034"],"a":[1]},{"t":" unto the "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":", and to sing "},{"t":"praises","s":["H2167"],"a":[3]},{"t":" unto thy "},{"t":"name","s":["H8034"],"a":[4]},{"t":", O most "},{"t":"High","s":["H5945"],"a":[5]},{"t":":"}]},{"n":2,"text":"To shew forth thy lovingkindness in the morning, and thy faithfulness every night,","tok":[{"t":"To shew "},{"t":"forth","s":["H5046"],"a":[0]},{"t":" thy "},{"t":"lovingkindness","s":["H2617"],"a":[2]},{"t":" in the "},{"t":"morning","s":["H1242"],"a":[1]},{"t":", and thy "},{"t":"faithfulness","s":["H0530"],"a":[3]},{"t":" every "},{"t":"night","s":["H3915"],"a":[4]},{"t":","}]},{"n":3,"text":"Upon an instrument of ten strings, and upon the psaltery; upon the harp with a solemn sound.","tok":[{"t":"Upon an instrument of ten "},{"t":"strings","s":["H6218"],"a":[1]},{"t":", and upon the "},{"t":"psaltery","s":["H5035"],"a":[3]},{"t":"; upon the "},{"t":"harp","s":["H3658"],"a":[6]},{"t":" with a solemn "},{"t":"sound","s":["H1902"],"a":[5]},{"t":"."}]},{"n":4,"text":"For thou, LORD, hast made me glad through thy work: I will triumph in the works of thy hands.","tok":[{"t":"For thou, "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":", hast made me "},{"t":"glad","s":["H8055"],"a":[1]},{"t":" through thy "},{"t":"work","s":["H6467"],"a":[3]},{"t":": I will "},{"t":"triumph","s":["H7442"],"a":[6]},{"t":" in the "},{"t":"works","s":["H4639"],"a":[4]},{"t":" of thy "},{"t":"hands","s":["H3027"],"a":[5]},{"t":"."}]},{"n":5,"text":"O LORD, how great are thy works! and thy thoughts are very deep.","tok":[{"t":"O "},{"t":"LORD","s":["H3068"],"a":[3]},{"t":", how "},{"t":"great","s":["H1431"],"a":[1]},{"t":" are thy "},{"t":"works","s":["H4639"],"a":[2]},{"t":"! and thy "},{"t":"thoughts","s":["H4284"],"a":[6]},{"t":" are "},{"t":"very","s":["H3966"],"a":[4]},{"t":" "},{"t":"deep","s":["H6009"],"a":[5]},{"t":"."}]},{"n":6,"text":"A brutish man knoweth not; neither doth a fool understand this.","tok":[{"t":"A "},{"t":"brutish","s":["H1198"],"a":[1]},{"t":" "},{"t":"man","s":["H0376"],"a":[0]},{"t":" "},{"t":"knoweth","s":["H3045"],"a":[3]},{"t":" not; neither doth a "},{"t":"fool","s":["H3684"],"a":[4]},{"t":" "},{"t":"understand","s":["H0995"],"a":[6]},{"t":" this."}]},{"n":7,"text":"When the wicked spring as the grass, and when all the workers of iniquity do flourish; it is that they shall be destroyed for ever:","tok":[{"t":"When the "},{"t":"wicked","s":["H7563"],"a":[1]},{"t":" "},{"t":"spring","s":["H6524"],"a":[0]},{"t":" as the "},{"t":"grass","s":["H6212"],"a":[3]},{"t":", and when all the "},{"t":"workers","s":["H6466"],"a":[6]},{"t":" of "},{"t":"iniquity","s":["H0205"],"a":[7]},{"t":" do "},{"t":"flourish","s":["H6692"],"a":[4]},{"t":"; it is that they shall be "},{"t":"destroyed","s":["H8045"],"a":[8]},{"t":" for "},{"t":"ever","s":["H5703"],"a":[9]},{"t":":"}]},{"n":8,"text":"But thou, LORD, art most high for evermore.","tok":[{"t":"But thou, "},{"t":"LORD","s":["H3068"],"a":[3]},{"t":", art most "},{"t":"high","s":["H4791"],"a":[1]},{"t":" for "},{"t":"evermore","s":["H5769"],"a":[2]},{"t":"."}]},{"n":9,"text":"For, lo, thine enemies, O LORD, for, lo, thine enemies shall perish; all the workers of iniquity shall be scattered.","tok":[{"t":"For, lo, thine "},{"t":"enemies","s":["H0341"],"a":[2]},{"t":", O "},{"t":"LORD","s":["H3068"],"a":[3]},{"t":", for, lo, thine "},{"t":"enemies","s":["H0341"],"a":[6]},{"t":" shall "},{"t":"perish","s":["H0006"],"a":[7]},{"t":"; all the "},{"t":"workers","s":["H6466"],"a":[10]},{"t":" of "},{"t":"iniquity","s":["H0205"],"a":[11]},{"t":" shall be "},{"t":"scattered","s":["H6504"],"a":[8]},{"t":"."}]},{"n":10,"text":"But my horn shalt thou exalt like the horn of an unicorn: I shall be anointed with fresh oil.","tok":[{"t":"But my "},{"t":"horn","s":["H7161"],"a":[2]},{"t":" shalt thou "},{"t":"exalt","s":["H7311"],"a":[0]},{"t":" like the horn of an "},{"t":"unicorn","s":["H7214"],"a":[1]},{"t":": I shall be "},{"t":"anointed","s":["H1101"],"a":[3]},{"t":" with "},{"t":"fresh","s":["H7488"],"a":[5]},{"t":" "},{"t":"oil","s":["H8081"],"a":[4]},{"t":"."}]},{"n":11,"text":"Mine eye also shall see my desire on mine enemies, and mine ears shall hear my desire of the wicked that rise up against me.","tok":[{"t":"Mine "},{"t":"eye","s":["H5869"],"a":[1]},{"t":" also shall "},{"t":"see","s":["H5027"],"a":[0]},{"t":" my desire on mine "},{"t":"enemies","s":["H7790"],"a":[2]},{"t":", and mine "},{"t":"ears","s":["H0241"],"a":[7]},{"t":" shall "},{"t":"hear","s":["H8085"],"a":[6]},{"t":" my desire of the "},{"t":"wicked","s":["H7489"],"a":[5]},{"t":" that rise "},{"t":"up","s":["H6965"],"a":[3]},{"t":" against me."}]},{"n":12,"text":"The righteous shall flourish like the palm tree: he shall grow like a cedar in Lebanon.","tok":[{"t":"The "},{"t":"righteous","s":["H6662"],"a":[0]},{"t":" shall "},{"t":"flourish","s":["H6524"],"a":[2]},{"t":" like the palm "},{"t":"tree","s":["H8558"],"a":[1]},{"t":": he shall "},{"t":"grow","s":["H7685"],"a":[5]},{"t":" like a "},{"t":"cedar","s":["H0730"],"a":[3]},{"t":" in "},{"t":"Lebanon","s":["H3844"],"a":[4]},{"t":"."}]},{"n":13,"text":"Those that be planted in the house of the LORD shall flourish in the courts of our God.","tok":[{"t":"Those that be "},{"t":"planted","s":["H8362"],"a":[0]},{"t":" in the "},{"t":"house","s":["H1004"],"a":[1]},{"t":" of the "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":" shall "},{"t":"flourish","s":["H6524"],"a":[5]},{"t":" in the "},{"t":"courts","s":["H2691"],"a":[3]},{"t":" of our "},{"t":"God","s":["H0430"],"a":[4]},{"t":"."}]},{"n":14,"text":"They shall still bring forth fruit in old age; they shall be fat and flourishing;","tok":[{"t":"They shall still bring forth "},{"t":"fruit","s":["H5107"],"a":[1]},{"t":" in old "},{"t":"age","s":["H7872"],"a":[2]},{"t":"; they shall be "},{"t":"fat","s":["H1879"],"a":[3]},{"t":" and "},{"t":"flourishing","s":["H7488"],"a":[4]},{"t":";"}]},{"n":15,"text":"To shew that the LORD is upright: he is my rock, and there is no unrighteousness in him.","tok":[{"t":"To "},{"t":"shew","s":["H5046"],"a":[0]},{"t":" that the "},{"t":"LORD","s":["H3068"],"a":[3]},{"t":" is "},{"t":"upright","s":["H3477"],"a":[2]},{"t":": he is my "},{"t":"rock","s":["H6697"],"a":[4]},{"t":", and there is no "},{"t":"unrighteousness","s":["H5766"],"a":[6]},{"t":" in him."}]}]}
