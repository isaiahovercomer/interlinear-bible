{"v":1,"book":"Ps","ch":138,"verses":[{"n":0,"text":"A Psalm of David.","tok":[{"t":"A Psalm of "},{"t":"David","s":["H1732"],"a":[0]},{"t":"."}]},{"n":1,"text":"I will praise thee with my whole heart: before the gods will I sing praise unto thee.","tok":[{"t":"I will "},{"t":"praise","s":["H3034"],"a":[0]},{"t":" thee with my whole "},{"t":"heart","s":["H3820"],"a":[2]},{"t":": before the "},{"t":"gods","s":["H0430"],"a":[4]},{"t":" will I sing "},{"t":"praise","s":["H2167"],"a":[5]},{"t":" unto thee."}]},{"n":2,"text":"I will worship toward thy holy temple, and praise thy name for thy lovingkindness and for thy truth: for thou hast magnified thy word above all thy name.","tok":[{"t":"I will "},{"t":"worship","s":["H7812"],"a":[0]},{"t":" toward thy "},{"t":"holy","s":["H6944"],"a":[3]},{"t":" "},{"t":"temple","s":["H1964"],"a":[2]},{"t":", and "},{"t":"praise","s":["H3034"],"a":[4]},{"t":" thy "},{"t":"name","s":["H8034"],"a":[6]},{"t":" for thy "},{"t":"lovingkindness","s":["H2617"],"a":[8]},{"t":" and for thy "},{"t":"truth","s":["H0571"],"a":[10]},{"t":": for thou hast "},{"t":"magnified","s":["H1431"],"a":[12]},{"t":" thy "},{"t":"word","s":["H0565"],"a":[16]},{"t":" above all thy "},{"t":"name","s":["H8034"],"a":[15]},{"t":"."}]},{"n":3,"text":"In the day when I cried thou answeredst me, and strengthenedst me with strength in my soul.","tok":[{"t":"In the "},{"t":"day","s":["H3117"],"a":[0]},{"t":" when I "},{"t":"cried","s":["H7121"],"a":[1]},{"t":" thou "},{"t":"answeredst","s":["H6030"],"a":[2]},{"t":" me, and "},{"t":"strengthenedst","s":["H7292"],"a":[3]},{"t":" me with "},{"t":"strength","s":["H5797"],"a":[5]},{"t":" in my "},{"t":"soul","s":["H5315"],"a":[4]},{"t":"."}]},{"n":4,"text":"All the kings of the earth shall praise thee, O LORD, when they hear the words of thy mouth.","tok":[{"t":"All the "},{"t":"kings","s":["H4428"],"a":[3]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[4]},{"t":" shall "},{"t":"praise","s":["H3034"],"a":[0]},{"t":" thee