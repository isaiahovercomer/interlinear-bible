{"v":1,"book":"Ps","ch":65,"verses":[{"n":0,"text":"To the chief Musician, A Psalm and Song of David.","tok":[{"t":"To the chief "},{"t":"Musician","s":["H5329"],"a":[0]},{"t":", A "},{"t":"Psalm","s":["H4210"],"a":[1]},{"t":" and "},{"t":"Song","s":["H7892"],"a":[3]},{"t":" of "},{"t":"David","s":["H1732"],"a":[2]},{"t":"."}]},{"n":1,"text":"Praise waiteth for thee, O God, in Sion: and unto thee shall the vow be performed.","tok":[{"t":"Praise","s":["H8416"],"a":[2]},{"t":" "},{"t":"waiteth","s":["H1747"],"a":[1]},{"t":" for thee, O "},{"t":"God","s":["H0430"],"a":[3]},{"t":", in "},{"t":"Sion","s":["H6726"],"a":[4]},{"t":": and unto thee shall the "},{"t":"vow","s":["H5088"],"a":[7]},{"t":" be "},{"t":"performed","s":["H7999"],"a":[6]},{"t":"."}]},{"n":2,"text":"O thou that hearest prayer, unto thee shall all flesh come.","tok":[{"t":"O thou that "},{"t":"hearest","s":["H8085"],"a":[0]},{"t":" "},{"t":"prayer","s":["H8605"],"a":[1]},{"t":", unto thee shall all "},{"t":"flesh","s":["H1320"],"a":[4]},{"t":" "},{"t":"come","s":["H0935"],"a":[5]},{"t":"."}]},{"n":3,"text":"Iniquities prevail against me: as for our transgressions, thou shalt purge them away.","tok":[{"t":"Iniquities","s":["H1697"],"a":[0]},{"t":" "},{"t":"prevail","s":["H1396"],"a":[2]},{"t":" against me: as for our "},{"t":"transgressions","s":["H6588"],"a":[4]},{"t":", thou shalt purge them "},{"t":"away","s":["H3722"],"a":[6]},{"t":"."}]},{"n":4,"text":"Blessed is the man whom thou choosest, and causest to approach unto thee, that he may dwell in thy courts: we shall be satisfied with the goodness of thy house, even of thy holy temple.","tok":[{"t":"Blessed","s":["H0835"],"a":[0]},{"t":" is the man whom thou "},{"t":"choosest","s":["H0977"],"a":[1]},{"t":", and causest to "},{"t":"approach","s":["H7126"],"a":[2]},{"t":" unto thee, that he may "},{"t":"dwell","s":["H7931"],"a":[3]},{"t":" in thy "},{"t":"courts","s":["H2691"],"a":[4]},{"t":": we shall be "},{"t":"satisfied","s":["H7646"],"a":[5]},{"t