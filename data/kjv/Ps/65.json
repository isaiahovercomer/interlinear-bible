outgoings of the morning and evening to rejoice.","tok":[{"t":"They also that "},{"t":"dwell","s":["H3427"],"a":[1]},{"t":" in the uttermost "},{"t":"parts","s":["H7099"]},{"t":" are "},{"t":"afraid","s":["H3372"],"a":[0]},{"t":" at thy "},{"t":"tokens","s":["H0226"],"a":[3]},{"t":": thou makest the "},{"t":"outgoings","s":["H4161"],"a":[4]},{"t":" of the "},{"t":"morning","s":["H1242"],"a":[5]},{"t":" and "},{"t":"evening","s":["H6153"],"a":[6]},{"t":" to "},{"t":"rejoice","s":["H7442"],"a":[7]},{"t":"."}]},{"n":9,"text":"Thou visitest the earth, and waterest it: thou greatly enrichest it with the river of God, which is full of water: thou preparest them corn, when thou hast so provided for it.","tok":[{"t":"Thou "},{"t":"visitest","s":["H6485"],"a":[0]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[1]},{"t":", and "},{"t":"waterest","s":["H7783"],"a":[2]},{"t":" it: thou "},{"t":"greatly","s":["H7227"],"a":[3]},{"t":" "},{"t":"enrichest","s":["H6238"],"a":[4]},{"t":" it with the "},{"t":"river","s":["H6388"],"a":[5]},{"t":" of "},{"t":"God","s":["H0430"],"a":[6]},{"t":", which is "},{"t":"full","s":["H4390"],"a":[7]},{"t":" of "},{"t":"water","s":["H4325"],"a":[8]},{"t":": thou "},{"t":"preparest","s":["H3559"],"a":[9]},{"t":" them "},{"t":"corn","s":["H1715"],"a":[10]},{"t":", when thou hast so "},{"t":"provided","s":["H3559"],"a":[13]},{"t":" for it."}]},{"n":10,"text":"Thou waterest the ridges thereof abundantly: thou settlest the furrows thereof: thou makest it soft with showers: thou blessest the springing thereof.","tok":[{"t":"Thou "},{"t":"waterest","s":["H7301"],"a":[1]},{"t":" the "},{"t":"ridges","s":["H8525"],"a":[0]},{"t":" thereof "},{"t":"abundantly","s":["H7301"]},{"t":": thou "},{"t":"settlest","s":["H5181"],"a":[2]},{"t":" the "},{"t":"furrows","s":["H1417"],"a":[3]},{"t":" thereof: thou makest it "},{"t":"soft","s":["H4127"],"a":[5]},{"t":" with "},{"t":"showers","s":["H7241"],"a":[4]},{"t":": thou "},{"t":"blessest","s":["H1288"],"a":[7]},{"t":