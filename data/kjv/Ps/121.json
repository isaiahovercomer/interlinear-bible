{"v":1,"book":"Ps","ch":121,"verses":[{"n":0,"text":"A Song of degrees.","tok":[{"t":"A "},{"t":"Song","s":["H7892"],"a":[0]},{"t":" of "},{"t":"degrees","s":["H4609"],"a":[1]},{"t":"."}]},{"n":1,"text":"I will lift up mine eyes unto the hills, from whence cometh my help.","tok":[{"t":"I will lift "},{"t":"up","s":["H5375"],"a":[0]},{"t":" mine "},{"t":"eyes","s":["H5869"],"a":[1]},{"t":" unto the "},{"t":"hills","s":["H2022"],"a":[3]},{"t":", from "},{"t":"whence","s":["H0370"],"a":[4]},{"t":" "},{"t":"cometh","s":["H0935"],"a":[5]},{"t":" my "},{"t":"help","s":["H5828"],"a":[6]},{"t":"."}]},{"n":2,"text":"My help cometh from the LORD, which made heaven and earth.","tok":[{"t":"My "},{"t":"help","s":["H5828"],"a":[0]},{"t":" cometh from the "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":", which "},{"t":"made","s":["H6213"],"a":[3]},{"t":" "},{"t":"heaven","s":["H8064"],"a":[4]},{"t":" and "},{"t":"earth","s":["H0776"],"a":[5]},{"t":"."}]},{"n":3,"text":"He will not suffer thy foot to be moved: he that keepeth thee will not slumber.","tok":[{"t":"He will not "},{"t":"suffer","s":["H5414"],"a":[1]},{"t":" thy "},{"t":"foot","s":["H7272"],"a":[3]},{"t":" to be "},{"t":"moved","s":["H4132"],"a":[2]},{"t":": he that "},{"t":"keepeth","s":["H8104"],"a":[6]},{"t":" thee will not "},{"t":"slumber","s":["H5123"],"a":[5]},{"t":"."}]},{"n":4,"text":"Behold, he that keepeth Israel shall neither slumber nor sleep.","tok":[{"t":"Behold, he that "},{"t":"keepeth","s":["H8104"],"a":[5]},{"t":" "},{"t":"Israel","s":["H3478"],"a":[6]},{"t":" shall neither "},{"t":"slumber","s":["H5123"],"a":[2]},{"t":" nor "},{"t":"sleep","s":["H3462"],"a":[4]},{"t":"."}]},{"n":5,"text":"The LORD is thy keeper: the LORD is thy shade upon thy right hand.","tok":[{"t":"The "},{"t":"LORD","s":["H3068"],"a":[0]},{"t":" is thy "},{"t":"keeper","s":["H8104"],"a":[1]},{"t":": the "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":" is thy "},{"t":"shade","s":["H6738"],"a":[3]},{"t":" upon thy "},{"t":"right","s":["H3