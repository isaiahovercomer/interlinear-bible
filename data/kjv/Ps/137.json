{"v":1,"book":"Ps","ch":137,"verses":[{"n":1,"text":"By the rivers of Babylon, there we sat down, yea, we wept, when we remembered Zion.","tok":[{"t":"By the "},{"t":"rivers","s":["H5104"],"a":[1]},{"t":" of "},{"t":"Babylon","s":["H0894"],"a":[2]},{"t":", there we sat "},{"t":"down","s":["H3427"],"a":[4]},{"t":", yea, we "},{"t":"wept","s":["H1058"],"a":[6]},{"t":", when we "},{"t":"remembered","s":["H2142"],"a":[7]},{"t":" "},{"t":"Zion","s":["H6726"],"a":[9]},{"t":"."}]},{"n":2,"text":"We hanged our harps upon the willows in the midst thereof.","tok":[{"t":"We "},{"t":"hanged","s":["H8518"],"a":[3]},{"t":" our "},{"t":"harps","s":["H3658"],"a":[4]},{"t":" upon the "},{"t":"willows","s":["H6155"],"a":[1]},{"t":" in the "},{"t":"midst","s":["H8432"],"a":[2]},{"t":" thereof."}]},{"n":3,"text":"For there they that carried us away captive required of us a song; and they that wasted us required of us mirth, saying, Sing us one of the songs of Zion.","tok":[{"t":"For there they that carried us away "},{"t":"captive","s":["H7617"],"a":[3]},{"t":" "},{"t":"required","s":["H7592"],"a":[2]},{"t":" of us a "},{"t":"song","s":["H1697"],"a":[4]},{"t":"; and they that "},{"t":"wasted","s":["H8437"],"a":[6]},{"t":" us required of us "},{"t":"mirth","s":["H8057"],"a":[7]},{"t":", saying, "},{"t":"Sing","s":["H7891"],"a":[8]},{"t":" us one of the "},{"t":"songs","s":["H7892"],"a":[5]},{"t":" of "},{"t":"Zion","s":["H6726"],"a":[11]},{"t":"."}]},{"n":4,"text":"How shall we sing the LORD’s song in a strange land?","tok":[{"t":"How shall we "},{"t":"sing","s":["H7891"],"a":[1]},{"t":" the "},{"t":"LORD’s","s":["H3068"],"a":[4]},{"t":" "},{"t":"song","s":["H7892"],"a":[3]},{"t":" in a "},{"t":"strange","s":["H5236"],"a":[7]},{"t":" "},{"t":"land","s":["H0127"],"a":[6]},{"t":"?"}]},{"n":5,"text":"If I forget thee, O Jerusalem, let my right hand forget her cunning.","tok":[{"t":"If I "},{"t":"forget","s":["H7911"],"a":[1]},{"t":" thee, O "},{"t":"Jerusalem","s":["H3389"],"a":[2]},{"t":", let my right "},{"t":"hand","s":["H3225"],"a":[4]},{"t":" "},{"t":"forget","s":["H7911"],"a":[3]},{"t":" her cunning."}]},{"n":6,"text":"If I do not remember thee, let my tongue cleave to the roof of my mouth; if I prefer not Jerusalem above my chief joy.","tok":[{"t":"If I do not "},{"t":"remember","s":["H2142"],"a":[5]},{"t":" thee, let my "},{"t":"tongue","s":["H3956"],"a":[1]},{"t":" "},{"t":"cleave","s":["H1692"],"a":[0]},{"t":" to the roof of my "},{"t":"mouth","s":["H2441"],"a":[2]},{"t":"; if I "},{"t":"prefer","s":["H5927"],"a":[8]},{"t":" not "},{"t":"Jerusalem","s":["H3389"],"a":[10]},{"t":" above my "},{"t":"chief","s":["H7218"],"a":[12]},{"t":" "},{"t":"joy","s":["H8057"],"a":[13]},{"t":"."}]},{"n":7,"text":"Remember, O LORD, the children of Edom in the day of Jerusalem; who said, Rase it, rase it, even to the foundation thereof.","tok":[{"t":"Remember","s":["H2142"],"a":[0]},{"t":", O "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":", the "},{"t":"children","s":["H1121"],"a":[2]},{"t":" of "},{"t":"Edom","s":["H0123"],"a":[3]},{"t":" in the "},{"t":"day","s":["H3117"],"a":[5]},{"t":" of "},{"t":"Jerusalem","s":["H3389"],"a":[6]},{"t":"; who "},{"t":"said","s":["H0559"],"a":[7]},{"t":", "},{"t":"Rase","s":["H6168"],"a":[8]},{"t":" it, "},{"t":"rase","s":["H6168"],"a":[9]},{"t":" it, even to the "},{"t":"foundation","s":["H3247"],"a":[11]},{"t":" thereof."}]},{"n":8,"text":"O daughter of Babylon, who art to be destroyed; happy shall he be, that rewardeth thee as thou hast served us.","tok":[{"t":"O "},{"t":"daughter","s":["H1323"],"a":[0]},{"t":" of "},{"t":"Babylon","s":["H0894"],"a":[1]},{"t":", who art to be "},{"t":"destroyed","s":["H7703"],"a":[2]},{"t":"; "},{"t":"happy","s":["H0835"],"a":[3]},{"t":" shall he be, that "},{"t":"rewardeth","s":["H7999"],"a":[4]},{"t":" thee as thou hast "},{"t":"served","s":["H1580"],"a":[8]},{"t":" us."}]},{"n":9,"text":"Happy shall he be, that taketh and dasheth thy little ones against the stones.","tok":[{"t":"Happy","s":["H0835"],"a":[0]},{"t":" shall he be, that "},{"t":"taketh","s":["H0270"],"a":[1]},{"t":" and "},{"t":"dasheth","s":["H5310"],"a":[2]},{"t":" thy little "},{"t":"ones","s":["H5768"],"a":[4]},{"t":" against the "},{"t":"stones","s":["H5553"],"a":[6]},{"t":"."}]}]}
