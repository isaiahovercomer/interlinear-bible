{"v":1,"book":"Ps","ch":79,"verses":[{"n":0,"text":"A Psalm of Asaph.","tok":[{"t":"A "},{"t":"Psalm","s":["H4210"],"a":[0]},{"t":" of "},{"t":"Asaph","s":["H0623"],"a":[1]},{"t":"."}]},{"n":1,"text":"O God, the heathen are come into thine inheritance; thy holy temple have they defiled; they have laid Jerusalem on heaps.","tok":[{"t":"O "},{"t":"God","s":["H0430"],"a":[0]},{"t":", the "},{"t":"heathen","s":["H1471"],"a":[2]},{"t":" are "},{"t":"come","s":["H0935"],"a":[1]},{"t":" into thine "},{"t":"inheritance","s":["H5159"],"a":[3]},{"t":"; thy "},{"t":"holy","s":["H6944"],"a":[7]},{"t":" "},{"t":"temple","s":["H1964"],"a":[6]},{"t":" have they "},{"t":"defiled","s":["H2930"],"a":[4]},{"t":"; they have "},{"t":"laid","s":["H7760"],"a":[8]},{"t":" "},{"t":"Jerusalem","s":["H3389"],"a":[10]},{"t":" on "},{"t":"heaps","s":["H5856"],"a":[11]},{"t":"."}]},{"n":2,"text":"The dead bodies of thy servants have they given to be meat unto the fowls of the heaven, the flesh of thy saints unto the beasts of the earth.","tok":[{"t":"The dead "},{"t":"bodies","s":["H5038"],"a":[2]},{"t":" of thy "},{"t":"servants","s":["H5650"],"a":[3]},{"t":" have they "},{"t":"given","s":["H5414"],"a":[0]},{"t":" to be "},{"t":"meat","s":["H3978"],"a":[4]},{"t":" unto the "},{"t":"fowls","s":["H5775"],"a":[5]},{"t":" of the "},{"t":"heaven","s":["H8064"],"a":[6]},{"t":", the "},{"t":"flesh","s":["H1320"],"a":[7]},{"t":" of thy "},{"t":"saints","s":["H2623"],"a":[8]},{"t":" unto the "},{"t":"beasts","s":["H2416"],"a":[9]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[10]},{"t":"."}]},{"n":3,"text":"Their blood have they shed like water round about Jerusalem; and there was none to bury them.","tok":[{"t":"Their "},{"t":"blood","s":["H1818"],"a":[1]},{"t":" have they "},{"t":"shed","s":["H8210"],"a":[0]},{"t":" like "},{"t":"water","s":["H4325"],"a":[2]},{"t":" round "},{"t":"about","s":["H5439"],"a":[3]},{"t":" "},{"t":"Jerusalem","s":["H3389"],"a":[4]},{"t":"; and there was none to "},{"t":"bury","s":["H6912"],"a":[6]},{"t":" them."}]},{"n":4,"text":"We are become a reproach to our neighbours, a scorn and derision to them that are round about us.","tok":[{"t":"We are become a "},{"t":"reproach","s":["H2781"],"a":[1]},{"t":" to our "},{"t":"neighbours","s":["H7934"],"a":[2]},{"t":", a "},{"t":"scorn","s":["H3933"],"a":[3]},{"t":" and "},{"t":"derision","s":["H7047"],"a":[4]},{"t":" to them that are round "},{"t":"about","s":["H5439"],"a":[5]},{"t":" us."}]},{"n":5,"text":"How long, LORD? wilt thou be angry for ever? shall thy jealousy burn like fire?","tok":[{"t":"How long, "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":"? wilt thou be "},{"t":"angry","s":["H0599"],"a":[3]},{"t":" for "},{"t":"ever","s":["H5331"],"a":[4]},{"t":"? shall thy "},{"t":"jealousy","s":["H7068"],"a":[8]},{"t":" "},{"t":"burn","s":["H1197"],"a":[5]},{"t":" like "},{"t":"fire","s":["H0784"],"a":[7]},{"t":"?"}]},{"n":6,"text":"Pour out thy wrath upon the heathen that have not known thee, and upon the kingdoms that have not called upon thy name.","tok":[{"t":"Pour "},{"t":"out","s":["H8210"],"a":[0]},{"t":" thy "},{"t":"wrath","s":["H2534"],"a":[1]},{"t":" upon the "},{"t":"heathen","s":["H1471"],"a":[3]},{"t":" that have not "},{"t":"known","s":["H3045"],"a":[6]},{"t":" thee, and upon the "},{"t":"kingdoms","s":["H4467"],"a":[8]},{"t":" that have not "},{"t":"called","s":["H7121"],"a":[12]},{"t":" upon thy "},{"t":"name","s":["H8034"],"a":[10]},{"t":"."}]},{"n":7,"text":"For they have devoured Jacob, and laid waste his dwelling place.","tok":[{"t":"For they have "},{"t":"devoured","s":["H0398"],"a":[1]},{"t":" "},{"t":"Jacob","s":["H3290"],"a":[3]},{"t":", and laid "},{"t":"waste","s":["H8074"],"a":[6]},{"t":" his dwelling "},{"t":"place","s":["H5116"],"a":[5]},{"t":"."}]},{"n":8,"text":"O remember not against us former iniquities: let thy tender mercies speedily prevent us: for we are brought very low.","tok":[{"t":"O "},{"t":"remember","s":["H2142"],"a":[1]},{"t":" not against us "},{"t":"former","s":["H7223"],"a":[4]},{"t":" "},{"t":"iniquities","s":["H5771"],"a":[3]},{"t":": let thy tender "},{"t":"mercies","s":["H7356"],"a":[7]},{"t":" "},{"t":"speedily","s":["H4118"]},{"t":" "},{"t":"prevent","s":["H6923"],"a":[6]},{"t":" us: for we are "},{"t":"brought","s":["H1809"],"a":[9]},{"t":" "},{"t":"very","s":["H3966"],"a":[10]},{"t":" "},{"t":"low","s":["H1809"]},{"t":"."}]},{"n":9,"text":"Help us, O God of our salvation, for the glory of thy name: and deliver us, and purge away our sins, for thy name’s sake.","tok":[{"t":"Help","s":["H5826"],"a":[0]},{"t":" us, O "},{"t":"God","s":["H0430"],"a":[1]},{"t":" of our "},{"t":"salvation","s":["H3468"],"a":[2]},{"t":", "},{"t":"for","s":["H1697"],"a":[4]},{"t":" the "},{"t":"glory","s":["H3519"],"a":[5]},{"t":" of thy "},{"t":"name","s":["H8034"],"a":[6]},{"t":": and "},{"t":"deliver","s":["H5337"],"a":[7]},{"t":" us, and purge "},{"t":"away","s":["H3722"],"a":[8]},{"t":" our "},{"t":"sins","s":["H2403"],"a":[10]},{"t":", for thy "},{"t":"name’s","s":["H8034"],"a":[12]},{"t":" sake."}]},{"n":10,"text":"Wherefore should the heathen say, Where is their God? let him be known among the heathen in our sight by the revenging of the blood of thy servants which is shed.","tok":[{"t":"Wherefore should the "},{"t":"heathen","s":["H1471"],"a":[2]},{"t":" "},{"t":"say","s":["H0559"],"a":[1]},{"t":", Where is their "},{"t":"God","s":["H0430"],"a":[4]},{"t":"? let him be "},{"t":"known","s":["H3045"],"a":[5]},{"t":" among the "},{"t":"heathen","s":["H1471"],"a":[6]},{"t":" in our "},{"t":"sight","s":["H5869"],"a":[7]},{"t":" by the "},{"t":"revenging","s":["H5360"],"a":[8]},{"t":" of the "},{"t":"blood","s":["H1818"],"a":[9]},{"t":" of thy "},{"t":"servants","s":["H5650"],"a":[10]},{"t":" which is "},{"t":"shed","s":["H8210"],"a":[11]},{"t":"."}]},{"n":11,"text":"Let the sighing of the prisoner come before thee; according to the greatness of thy power preserve thou those that are appointed to die;","tok":[{"t":"L