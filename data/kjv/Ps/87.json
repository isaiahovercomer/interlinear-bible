{"v":1,"book":"Ps","ch":87,"verses":[{"n":0,"text":"A Psalm or Song for the sons of Korah.","tok":[{"t":"A "},{"t":"Psalm","s":["H4210"],"a":[2]},{"t":" or "},{"t":"Song","s":["H7892"],"a":[3]},{"t":" for the "},{"t":"sons","s":["H1121"],"a":[0]},{"t":" of "},{"t":"Korah","s":["H7141"],"a":[1]},{"t":"."}]},{"n":1,"text":"His foundation is in the holy mountains.","tok":[{"t":"His "},{"t":"foundation","s":["H3248"],"a":[0]},{"t":" is in the "},{"t":"holy","s":["H6944"],"a":[2]},{"t":" "},{"t":"mountains","s":["H2042"],"a":[1]},{"t":"."}]},{"n":2,"text":"The LORD loveth the gates of Zion more than all the dwellings of Jacob.","tok":[{"t":"The "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":" "},{"t":"loveth","s":["H0157"],"a":[0]},{"t":" the "},{"t":"gates","s":["H8179"],"a":[2]},{"t":" of "},{"t":"Zion","s":["H6726"],"a":[3]},{"t":" more than all the "},{"t":"dwellings","s":["H4908"],"a":[5]},{"t":" of "},{"t":"Jacob","s":["H3290"],"a":[6]},{"t":"."}]},{"n":3,"text":"Glorious things are spoken of thee, O city of God. Selah.","tok":[{"t":"Glorious "},{"t":"things","s":["H3513"],"a":[0]},{"t":" are "},{"t":"spoken","s":["H1696"],"a":[1]},{"t":" of thee, O "},{"t":"city","s":["H5892"],"a":[3]},{"t":" of "},{"t":"God","s":["H0430"],"a":[4]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[5]},{"t":"."}]},{"n":4,"text":"I will make mention of Rahab and Babylon to them that know me: behold Philistia, and Tyre, with Ethiopia; this man was born there.","tok":[{"t":"I will make "},{"t":"mention","s":["H2142"],"a":[0]},{"t":" of "},{"t":"Rahab","s":["H7294"]},{"t":" and "},{"t":"Babylon","s":["H0894"],"a":[2]},{"t":" to them that "},{"t":"know","s":["H3045"],"a":[3]},{"t":" me: behold "},{"t":"Philistia","s":["H6429"],"a":[5]},{"t":", and "},{"t":"Tyre","s":["H6865"],"a":[6]},{"t":", with "},{"t":"Ethiopia","s":["H3568"],"a":[8]},{"t":"; this man was "},{"t":"born","s":["H3205"],"a":[10]},{"t":" there."}]},{"n":5,"text":"And of Zion it shall be said, This and that man was born in her: and the highest himself shall establish her.","tok":[{"t":"And of "},{"t":"Zion","s":["H6726"],"a":[0]},{"t":" it shall be "},{"t":"said","s":["H0559"],"a":[1]},{"t":", This and that "},{"t":"man","s":["H0376"],"a":[2]},{"t":" was "},{"t":"born","s":["H3205"],"a":[4]},{"t":" in her: and the "},{"t":"highest","s":["H5945"],"a":[8]},{"t":" himself shall "},{"t":"establish","s":["H3559"],"a":[7]},{"t":" her."}]},{"n":6,"text":"The LORD shall count, when he writeth up the people, that this man was born there. Selah.","tok":[{"t":"The "},{"t":"LORD","s":["H3068"],"a":[0]},{"t":" shall "},{"t":"count","s":["H5608"],"a":[1]},{"t":", when he writeth "},{"t":"up","s":["H3789"],"a":[2]},{"t":" the "},{"t":"people","s":["H5971"],"a":[3]},{"t":", that this man was "},{"t":"born","s":["H3205"],"a":[5]},{"t":" there. "},{"t":"Selah","s":["H5542"],"a":[7]},{"t":"."}]},{"n":7,"text":"As well the singers as the players on instruments shall be there: all my springs are in thee.","tok":[{"t":"As well the "},{"t":"singers","s":["H7891"],"a":[0]},{"t":" as the "},{"t":"players","s":["H2490"],"a":[1]},{"t":" on instruments shall be there: all my "},{"t":"springs","s":["H4599"],"a":[3]},{"t":" are in thee."}]}]}
