{"v":1,"book":"Ps","ch":61,"verses":[{"n":0,"text":"To the chief Musician upon Neginah, A Psalm of David.","tok":[{"t":"To the chief "},{"t":"Musician","s":["H5329"],"a":[0]},{"t":" upon "},{"t":"Neginah","s":["H5058"],"a":[2]},{"t":", A Psalm of "},{"t":"David","s":["H1732"],"a":[3]},{"t":"."}]},{"n":1,"text":"Hear my cry, O God; attend unto my prayer.","tok":[{"t":"Hear","s":["H8085"],"a":[0]},{"t":" my "},{"t":"cry","s":["H7440"],"a":[2]},{"t":", O "},{"t":"God","s":["H0430"],"a":[1]},{"t":"; "},{"t":"attend","s":["H7181"],"a":[3]},{"t":" unto my "},{"t":"prayer","s":["H8605"],"a":[4]},{"t":"."}]},{"n":2,"text":"From the end of the earth will I cry unto thee, when my heart is overwhelmed: lead me to the rock that is higher than I.","tok":[{"t":"From the "},{"t":"end","s":["H7097"],"a":[0]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[1]},{"t":" will I "},{"t":"cry","s":["H7121"],"a":[3]},{"t":" unto thee, when my "},{"t":"heart","s":["H3820"],"a":[5]},{"t":" is "},{"t":"overwhelmed","s":["H5848"],"a":[4]},{"t":": "},{"t":"lead","s":["H5148"],"a":[9]},{"t":" me to the "},{"t":"rock","s":["H6697"],"a":[6]},{"t":" that is "},{"t":"higher","s":["H7311"],"a":[7]},{"t":" than I."}]},{"n":3,"text":"For thou hast been a shelter for me, and a strong tower from the enemy.","tok":[{"t":"For thou hast been a "},{"t":"shelter","s":["H4268"],"a":[2]},{"t":" for me, and a "},{"t":"strong","s":["H5797"],"a":[5]},{"t":" "},{"t":"tower","s":["H4026"],"a":[4]},{"t":" "},{"t":"from","s":["H6440"],"a":[6]},{"t":" the "},{"t":"enemy","s":["H0341"],"a":[7]},{"t":"."}]},{"n":4,"text":"I will abide in thy tabernacle for ever: I will trust in the covert of thy wings. Selah.","tok":[{"t":"I will "},{"t":"abide","s":["H1481"],"a":[0]},{"t":" in thy "},{"t":"tabernacle","s":["H0168"],"a":[1]},{"t":" for "},{"t":"ever","s":["H5769"],"a":[2]},{"t":": I will "},{"t":"trust","s":["H2620"],"a":[3]},{"t":" in the "},{"t":"covert","s":["H5643"],"a":[4]},{"t":" of thy "},{"t":"wings","s":["H3671"],"a":[5]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[6]},{"t":"."}]},{"n":5,"text":"For thou, O God, hast heard my vows: thou hast given me the heritage of those that fear thy name.","tok":[{"t":"For thou, O "},{"t":"God","s":["H0430"],"a":[2]},{"t":", hast "},{"t":"heard","s":["H8085"],"a":[3]},{"t":" my "},{"t":"vows","s":["H5088"],"a":[4]},{"t":": thou hast "},{"t":"given","s":["H5414"],"a":[5]},{"t":" me the "},{"t":"heritage","s":["H3425"],"a":[6]},{"t":" of those that "},{"t":"fear","s":["H3373"],"a":[7]},{"t":" thy "},{"t":"name","s":["H8034"],"a":[8]},{"t":"."}]},{"n":6,"text":"Thou wilt prolong the king’s life: and his years as many generations.","tok":[{"t":"Thou wilt "},{"t":"prolong","s":["H3254"],"a":[4]},{"t":" the "},{"t":"king’s","s":["H4428"],"a":[3]},{"t":" "},{"t":"life","s":["H3117"],"a":[0]},{"t":": and his "},{"t":"years","s":["H8141"],"a":[5]},{"t":" as "},{"t":"many","s":["H1755"],"a":[7]},{"t":" "},{"t":"generations","s":["H1755"],"a":[8]},{"t":"."}]},{"n":7,"text":"He shall abide before God for ever: O prepare mercy and truth, which may preserve him.","tok":[{"t":"He shall "},{"t":"abide","s":["H3427"],"a":[0]},{"t":" "},{"t":"before","s":["H6440"],"a":[2]},{"t":" "},{"t":"God","s":["H0430"],"a":[3]},{"t":" for "},{"t":"ever","s":["H5769"],"a":[1]},{"t":": O "},{"t":"prepare","s":["H4487"],"a":[6]},{"t":" "},{"t":"mercy","s":["H2617"],"a":[4]},{"t":" and "},{"t":"truth","s":["H0571"],"a":[5]},{"t":", which may "},{"t":"preserve","s":["H5341"],"a":[7]},{"t":" him."}]},{"n":8,"text":"So will I sing praise unto thy name for ever, that I may daily perform my vows.","tok":[{"t":"So will I "},{"t":"sing","s":["H2167"],"a":[1]},{"t":" praise unto thy "},{"t":"name","s":["H8034"],"a":[2]},{"t":" for "},{"t":"ever","s":["H5703"],"a":[3]},{"t":", that I may "},{"t":"daily","s":["H3117"],"a":[6]},{"t":" "},{"t":"perform","s":["H7999"],"a":[4]},{"t":" my "},{"t":"vows","s":["H5088"],"a":[5]},{"t":"."}]}]}
