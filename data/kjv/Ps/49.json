sterity","s":["H0310"],"a":[4]},{"t":" "},{"t":"approve","s":["H7521"],"a":[6]},{"t":" their "},{"t":"sayings","s":["H6310"],"a":[5]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[7]},{"t":"."}]},{"n":14,"text":"Like sheep they are laid in the grave; death shall feed on them; and the upright shall have dominion over them in the morning; and their beauty shall consume in the grave from their dwelling.","tok":[{"t":"Like "},{"t":"sheep","s":["H6629"],"a":[0]},{"t":" they are "},{"t":"laid","s":["H8371"],"a":[2]},{"t":" in the "},{"t":"grave","s":["H7585"],"a":[1]},{"t":"; "},{"t":"death","s":["H4194"],"a":[3]},{"t":" shall "},{"t":"feed","s":["H7462"],"a":[4]},{"t":" on them; and the "},{"t":"upright","s":["H3477"],"a":[7]},{"t":" shall have "},{"t":"dominion","s":["H7287"],"a":[5]},{"t":" over them in the "},{"t":"morning","s":["H1242"],"a":[8]},{"t":"; and their "},{"t":"beauty","s":["H6697"],"a":[9]},{"t":" shall "},{"t":"consume","s":["H1086"],"a":[10]},{"t":" in the "},{"t":"grave","s":["H7585"],"a":[11]},{"t":" from their "},{"t":"dwelling","s":["H2073"],"a":[12]},{"t":"."}]},{"n":15,"text":"But God will redeem my soul from the power of the grave: for he shall receive me. Selah.","tok":[{"t":"But "},{"t":"God","s":["H0430"],"a":[1]},{"t":" will "},{"t":"redeem","s":["H6299"],"a":[2]},{"t":" my "},{"t":"soul","s":["H5315"],"a":[3]},{"t":" from the "},{"t":"power","s":["H3027"],"a":[4]},{"t":" of the "},{"t":"grave","s":["H7585"],"a":[5]},{"t":": for he shall "},{"t":"receive","s":["H3947"],"a":[7]},{"t":" me. "},{"t":"Selah","s":["H5542"],"a":[8]},{"t":"."}]},{"n":16,"text":"Be not thou afraid when one is made rich, when the glory of his house is increased;","tok":[{"t":"Be not thou "},{"t":"afraid","s":["H3372"],"a":[1]},{"t":" when "},{"t":"one","s":["H0376"],"a":[4]},{"t":" is made "},{"t":"rich","s":["H6238"],"a":[3]},{"t":", when the "},{"t":"glory","s":["H3519"],"a":[7]},{"t":" of his "},{"t":"house","s":["H1004"],"a":[8]},{"t":" is "},{"t":"increased","s":["H7235"],"a":[6]},{"t":";"}]},{"n":17,"text":"For when he dieth he shall carry nothing away: his glory shall not descend after him.","tok":[{"t":"For when he "},{"t":"dieth","s":["H4194"],"a":[2]},{"t":" he shall carry nothing "},{"t":"away","s":["H3947"],"a":[3]},{"t":": his "},{"t":"glory","s":["H3519"],"a":[8]},{"t":" shall not "},{"t":"descend","s":["H3381"],"a":[6]},{"t":" "},{"t":"after","s":["H0310"],"a":[7]},{"t":" him."}]},{"n":18,"text":"Though while he lived he blessed his soul: and men will praise thee, when thou doest well to thyself.","tok":[{"t":"Though while he "},{"t":"lived","s":["H2416"],"a":[2]},{"t":" he "},{"t":"blessed","s":["H1288"],"a":[3]},{"t":" his "},{"t":"soul","s":["H5315"],"a":[1]},{"t":": and men will "},{"t":"praise","s":["H3034"],"a":[4]},{"t":" thee, when thou doest "},{"t":"well","s":["H3190"],"a":[6]},{"t":" to thyself."}]},{"n":19,"text":"He shall go to the generation of his fathers; they shall never see light.","tok":[{"t":"He shall "},{"t":"go","s":["H0935"],"a":[0]},{"t":" to the "},{"t":"generation","s":["H1755"],"a":[2]},{"t":" of his "},{"t":"fathers","s":["H0001"],"a":[3]},{"t":"; they shall "},{"t":"never","s":["H3808"],"a":[6]},{"t":" "},{"t":"see","s":["H7200"],"a":[7]},{"t":" "},{"t":"light","s":["H0216"],"a":[8]},{"t":"."}]},{"n":20,"text":"Man that is in honour, and understandeth not, is like the beasts that perish.","tok":[{"t":"Man","s":["H0120"],"a":[0]},{"t":" that is in "},{"t":"honour","s":["H3366"],"a":[1]},{"t":", and "},{"t":"understandeth","s":["H0995"],"a":[3]},{"t":" not, is "},{"t":"like","s":["H4911"],"a":[4]},{"t":" the "},{"t":"beasts","s":["H0929"],"a":[5]},{"t":" that "},{"t":"perish","s":["H1820"],"a":[6]},{"t":"."}]}]}
