{"v":1,"book":"Ps","ch":49,"verses":[{"n":0,"text":"To the chief Musician, A Psalm for the sons of Korah.","tok":[{"t":"To the chief "},{"t":"Musician","s":["H5329"],"a":[0]},{"t":", A "},{"t":"Psalm","s":["H4210"],"a":[3]},{"t":" for the "},{"t":"sons","s":["H1121"],"a":[1]},{"t":" of "},{"t":"Korah","s":["H7141"],"a":[2]},{"t":"."}]},{"n":1,"text":"Hear this, all ye people; give ear, all ye inhabitants of the world:","tok":[{"t":"Hear","s":["H8085"],"a":[0]},{"t":" this, all ye "},{"t":"people","s":["H5971"],"a":[3]},{"t":"; give "},{"t":"ear","s":["H0238"],"a":[4]},{"t":", all ye "},{"t":"inhabitants","s":["H3427"],"a":[6]},{"t":" of the "},{"t":"world","s":["H2465"],"a":[7]},{"t":":"}]},{"n":2,"text":"Both low and high, rich and poor, together.","tok":[{"t":"Both "},{"t":"low","s":["H1121"],"a":[1]},{"t":" and "},{"t":"high","s":["H1121"],"a":[4]},{"t":", "},{"t":"rich","s":["H6223"],"a":[7]},{"t":" and "},{"t":"poor","s":["H0034"],"a":[8]},{"t":", "},{"t":"together","s":["H3162"],"a":[6]},{"t":"."}]},{"n":3,"text":"My mouth shall speak of wisdom; and the meditation of my heart shall be of understanding.","tok":[{"t":"My "},{"t":"mouth","s":["H6310"],"a":[0]},{"t":" shall "},{"t":"speak","s":["H1696"],"a":[1]},{"t":" of "},{"t":"wisdom","s":["H2454"]},{"t":"; and the "},{"t":"meditation","s":["H1900"],"a":[3]},{"t":" of my "},{"t":"heart","s":["H3820"],"a":[4]},{"t":" shall be of "},{"t":"understanding","s":["H8394"],"a":[5]},{"t":"."}]},{"n":4,"text":"I will incline mine ear to a parable: I will open my dark saying upon the harp.","tok":[{"t":"I will "},{"t":"incline","s":["H5186"],"a":[0]},{"t":" mine "},{"t":"ear","s":["H0241"],"a":[2]},{"t":" to a "},{"t":"parable","s":["H4912"],"a":[1]},{"t":": I will "},{"t":"open","s":["H6605"],"a":[3]},{"t":" my dark "},{"t":"saying","s":["H2420"],"a":[5]},{"t":" upon the "},{"t":"harp","s":["H3658"],"a":[4]},{"t":"."}]},{"n":5,"text":"Wherefore should I fear in the days of evil, when the iniquity of my heels shall compa