{"v":1,"book":"Ps","ch":41,"verses":[{"n":0,"text":"To the chief Musician, A Psalm of David.","tok":[{"t":"To the chief "},{"t":"Musician","s":["H5329"],"a":[0]},{"t":", A "},{"t":"Psalm","s":["H4210"],"a":[1]},{"t":" of "},{"t":"David","s":["H1732"],"a":[2]},{"t":"."}]},{"n":1,"text":"Blessed is he that considereth the poor: the LORD will deliver him in time of trouble.","tok":[{"t":"Blessed","s":["H0835"],"a":[0]},{"t":" is he that "},{"t":"considereth","s":["H7919"],"a":[1]},{"t":" the "},{"t":"poor","s":["H1800"],"a":[3]},{"t":": the "},{"t":"LORD","s":["H3068"],"a":[7]},{"t":" will "},{"t":"deliver","s":["H4422"],"a":[6]},{"t":" him in "},{"t":"time","s":["H3117"],"a":[4]},{"t":" of "},{"t":"trouble","s":["H7451"],"a":[5]},{"t":"."}]},{"n":2,"text":"The LORD will preserve him, and keep him alive; and he shall be blessed upon the earth: and thou wilt not deliver him unto the will of his enemies.","tok":[{"t":"The "},{"t":"LORD","s":["H3068"],"a":[0]},{"t":" will "},{"t":"preserve","s":["H8104"],"a":[1]},{"t":" him, and keep him "},{"t":"alive","s":["H2421"],"a":[2]},{"t":"; and he shall be "},{"t":"blessed","s":["H0833"],"a":[3]},{"t":" upon the "},{"t":"earth","s":["H0776"],"a":[4]},{"t":": and thou wilt not "},{"t":"deliver","s":["H5414"],"a":[6]},{"t":" him unto the "},{"t":"will","s":["H5315"],"a":[7]},{"t":" of his "},{"t":"enemies","s":["H0341"],"a":[8]},{"t":"."}]},{"n":3,"text":"The LORD will strengthen him upon the bed of languishing: thou wilt make all his bed in his sickness.","tok":[{"t":"The "},{"t":"LORD","s":["H3068"],"a":[0]},{"t":" will "},{"t":"strengthen","s":["H5582"],"a":[1]},{"t":" him upon the "},{"t":"bed","s":["H6210"],"a":[3]},{"t":" of "},{"t":"languishing","s":["H1741"],"a":[4]},{"t":": thou wilt "},{"t":"make","s":["H2015"],"a":[7]},{"t":" all his "},{"t":"bed","s":["H4904"],"a":[6]},{"t":" in his "},{"t":"sickness","s":["H2483"],"a":[8]},{"t":"."}]},{"n":4,"text":"I said, LORD, be merciful unto me: heal my soul; for I have sinned against thee.","tok":[{"t":"I "},{"t":"said","s":["H0559"],"a":[1]},{"t":", "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":", be "},{"t":"merciful","s":["H2603"],"a":[3]},{"t":" unto me: "},{"t":"heal","s":["H7495"],"a":[4]},{"t":" my "},{"t":"soul","s":["H5315"],"a":[5]},{"t":"; for I have "},{"t":"sinned","s":["H2398"],"a":[7]},{"t":" against thee."}]},{"n":5,"text":"Mine enemies speak evil of me, When shall he die, and his name perish?","tok":[{"t":"Mine "},{"t":"enemies","s":["H0341"],"a":[0]},{"t":" "},{"t":"speak","s":["H0559"],"a":[1]},{"t":" "},{"t":"evil","s":["H7451"],"a":[2]},{"t":" of me, When shall he "},{"t":"die","s":["H4191"],"a":[5]},{"t":", and his "},{"t":"name","s":["H8034"],"a":[7]},{"t":" "},{"t":"perish","s":["H0006"],"a":[6]},{"t":"?"}]},{"n":6,"text":"And if he come to see me, he speaketh vanity: his heart gathereth iniquity to itself; when he goeth abroad, he telleth it.","tok":[{"t":"And if he "},{"t":"come","s":["H0935"],"a":[1]},{"t":" to "},{"t":"see","s":["H7200"],"a":[2]},{"t":" me, he "},{"t":"speaketh","s":["H1696"],"a":[4]},{"t":" "},{"t":"vanity","s":["H7723"],"a":[3]},{"t":": his "},{"t":"heart","s":["H3820"],"a":[5]},{"t":" "},{"t":"gathereth","s":["H6908"],"a":[6]},{"t":" "},{"t":"iniquity","s":["H0205"],"a":[7]},{"t":" to itself; when he "},{"t":"goeth","s":["H3318"],"a":[9]},{"t":" "},{"t":"abroad","s":["H2351"],"a":[10]},{"t":", he "},{"t":"telleth","s":["H1696"],"a":[11]},{"t":" it."}]},{"n":7,"text":"All that hate me whisper together against me: against me do they devise my hurt.","tok":[{"t":"All that "},{"t":"hate","s":["H8130"],"a":[4]},{"t":" me "},{"t":"whisper","s":["H3907"],"a":[2]},{"t":" "},{"t":"together","s":["H3162"],"a":[0]},{"t":" against me: against me do they "},{"t":"devise","s":["H2803"],"a":[6]},{"t":" my "},{"t":"hurt","s":["H7451"],"a":[7]},{"t":"."}]},{"n":8,"text":"An evil disease, say they, cleaveth fast unto him: and now that he lieth he shall rise up no more.","tok":[{"t":"An "},{"t":"evil","s":["H1100"