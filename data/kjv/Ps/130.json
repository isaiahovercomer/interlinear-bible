{"v":1,"book":"Ps","ch":130,"verses":[{"n":0,"text":"A Song of degrees.","tok":[{"t":"A "},{"t":"Song","s":["H7892"],"a":[0]},{"t":" of "},{"t":"degrees","s":["H4609"],"a":[1]},{"t":"."}]},{"n":1,"text":"Out of the depths have I cried unto thee, O LORD.","tok":[{"t":"Out of the "},{"t":"depths","s":["H4615"],"a":[0]},{"t":" have I "},{"t":"cried","s":["H7121"],"a":[1]},{"t":" unto thee, O "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":"."}]},{"n":2,"text":"Lord, hear my voice: let thine ears be attentive to the voice of my supplications.","tok":[{"t":"Lord","s":["H0136"],"a":[0]},{"t":", "},{"t":"hear","s":["H8085"],"a":[1]},{"t":" my "},{"t":"voice","s":["H6963"],"a":[2]},{"t":": let thine "},{"t":"ears","s":["H0241"],"a":[4]},{"t":" be "},{"t":"attentive","s":["H7183"],"a":[5]},{"t":" to the "},{"t":"voice","s":["H6963"],"a":[6]},{"t":" of my "},{"t":"supplications","s":["H8469"],"a":[7]},{"t":"."}]},{"n":3,"text":"If thou, LORD, shouldest mark iniquities, O Lord, who shall stand?","tok":[{"t":"If thou, "},{"t":"LORD","s":["H3050"],"a":[3]},{"t":", shouldest "},{"t":"mark","s":["H8104"],"a":[2]},{"t":" "},{"t":"iniquities","s":["H5771"],"a":[1]},{"t":", O "},{"t":"Lord","s":["H0136"],"a":[4]},{"t":", who shall "},{"t":"stand","s":["H5975"],"a":[6]},{"t":"?"}]},{"n":4,"text":"But there is forgiveness with thee, that thou mayest be feared.","tok":[{"t":"But there is "},{"t":"forgiveness","s":["H5547"],"a":[2]},{"t":" with thee, that thou mayest be "},{"t":"feared","s":["H3372"],"a":[4]},{"t":"."}]},{"n":5,"text":"I wait for the LORD, my soul doth wait, and in his word do I hope.","tok":[{"t":"I "},{"t":"wait","s":["H6960"],"a":[0]},{"t":" for the "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":", my "},{"t":"soul","s":["H5315"],"a":[3]},{"t":" doth "},{"t":"wait","s":["H6960"],"a":[2]},{"t":", and in his "},{"t":"word","s":["H1697"],"a":[4]},{"t":" do I "},{"t":"hope","s":["H3176"],"a":[5]},{"t":"."}]},{"n":6,"text":"My soul waiteth for the Lord more than they that watch for the morning: I say, more than they that watch for the morning.","tok":[{"t":"My "},{"t":"soul","s":["H5315"],"a":[0]},{"t":" waiteth for the "},{"t":"Lord","s":["H0136"],"a":[1]},{"t":" more than they that "},{"t":"watch","s":["H8104"],"a":[2]},{"t":" for the "},{"t":"morning","s":["H1242"],"a":[3]},{"t":": I say, more than they that "},{"t":"watch","s":["H8104"],"a":[4]},{"t":" for the "},{"t":"morning","s":["H1242"],"a":[5]},{"t":"."}]},{"n":7,"text":"Let Israel hope in the LORD: for with the LORD there is mercy, and with him is plenteous redemption.","tok":[{"t":"Let "},{"t":"Israel","s":["H3478"],"a":[1]},{"t":" "},{"t":"hope","s":["H3176"],"a":[0]},{"t":" in the "},{"t":"LORD","s":["H3068"],"a":[3]},{"t":": for with the "},{"t":"LORD","s":["H3068"],"a":[6]},{"t":" there is "},{"t":"mercy","s":["H2617"],"a":[7]},{"t":", and with him is "},{"t":"plenteous","s":["H7235"],"a":[8]},{"t":" "},{"t":"redemption","s":["H6304"],"a":[10]},{"t":"."}]},{"n":8,"text":"And he shall redeem Israel from all his iniquities.","tok":[{"t":"And he shall "},{"t":"redeem","s":["H6299"],"a":[1]},{"t":" "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":" from all his "},{"t":"iniquities","s":["H5771"],"a":[5]},{"t":"."}]}]}
