{"v":1,"book":"Eccl","ch":1,"verses":[{"n":1,"text":"The words of the Preacher, the son of David, king in Jerusalem.","tok":[{"t":"The "},{"t":"words","s":["H1697"],"a":[0]},{"t":" of the "},{"t":"Preacher","s":["H6953"],"a":[1]},{"t":", the "},{"t":"son","s":["H1121"],"a":[2]},{"t":" of "},{"t":"David","s":["H1732"],"a":[3]},{"t":", "},{"t":"king","s":["H4428"],"a":[4]},{"t":" in "},{"t":"Jerusalem","s":["H3389"],"a":[5]},{"t":"."}]},{"n":2,"text":"Vanity of vanities, saith the Preacher, vanity of vanities; all is vanity.","tok":[{"t":"Vanity","s":["H1892"],"a":[0]},{"t":" of "},{"t":"vanities","s":["H1892"],"a":[1]},{"t":", "},{"t":"saith","s":["H0559"],"a":[2]},{"t":" the "},{"t":"Preacher","s":["H6953"],"a":[3]},{"t":", "},{"t":"vanity","s":["H1892"],"a":[4]},{"t":" of "},{"t":"vanities","s":["H1892"],"a":[5]},{"t":"; all is "},{"t":"vanity","s":["H1892"],"a":[7]},{"t":"."}]},{"n":3,"text":"What profit hath a man of all his labour which he taketh under the sun?","tok":[{"t":"What "},{"t":"profit","s":["H3504"],"a":[1]},{"t":" hath a "},{"t":"man","s":["H0120"],"a":[2]},{"t":" of all his "},{"t":"labour","s":["H5999"],"a":[4]},{"t":" which he "},{"t":"taketh","s":["H5998"],"a":[5]},{"t":" under the "},{"t":"sun","s":["H8121"],"a":[7]},{"t":"?"}]},{"n":4,"text":"One generation passeth away, and another generation cometh: but the earth abideth for ever.","tok":[{"t":"One "},{"t":"generation","s":["H1755"],"a":[0]},{"t":" passeth "},{"t":"away","s":["H1980"],"a":[1]},{"t":", and another "},{"t":"generation","s":["H1755"],"a":[2]},{"t":" "},{"t":"cometh","s":["H0935"],"a":[3]},{"t":": but the "},{"t":"earth","s":["H0776"],"a":[4]},{"t":" "},{"t":"abideth","s":["H5975"],"a":[6]},{"t":" for "},{"t":"ever","s":["H5769"],"a":[5]},{"t":"."}]},{"n":5,"text":"The sun also ariseth, and the sun goeth down, and hasteth to his place where he arose.","tok":[{"t":"The "},{"t":"sun","s":["H8121"],"a":[1]},{"t":" also "},{"t":"ariseth","s":["H2224"],"a":[0]},{"t":", and the "},{"t":"sun","s":["H8121"],"a":[3]},{"t":" goeth "},{"t":"down","s":["H0935"],"a":[2]},{"t":", and "},{"t":"hasteth","s":["H7602"],"a":[6]},{"t":" to his "},{"t":"place","s":["H4725"],"a":[5]},{"t":" where he "},{"t":"arose","s":["H2224"],"a":[7]},{"t":"."}]},{"n":6,"text":"The wind goeth toward the south, and turneth about unto the north; it whirleth about continually, and the wind returneth again according to his circuits.","tok":[{"t":"The "},{"t":"wind","s":["H7307"],"a":[9]},{"t":" "},{"t":"goeth","s":["H1980"],"a":[0]},{"t":" toward the "},{"t":"south","s":["H1864"],"a":[2]},{"t":", and turneth "},{"t":"about","s":["H5437"],"a":[3]},{"t":" unto the "},{"t":"north","s":["H6828"],"a":[5]},{"t":"; it whirleth about "},{"t":"continually","s":["H1980"],"a":[8]},{"t":", and the "},{"t":"wind","s":["H7307"],"a":[13]},{"t":" returneth "},{"t":"again","s":["H7725"],"a":[12]},{"t":" according to his "},{"t":"circuits","s":["H5439"],"a":[11]},{"t":"."}]},{"n":7,"text":"All the rivers run into the sea; yet the sea is not full; unto the place from whence the rivers come, thither they return again.","tok":[{"t":"All the "},{"t":"rivers","s":["H5158"],"a":[1]},{"t":" "},{"t":"run","s":["H1980"],"a":[2]},{"t":" into the "},{"t":"sea","s":["H3220"],"a":[4]},{"t":"; yet the "},{"t":"sea","s":["H3220"],"a":[5]},{"t":" is not "},{"t":"full","s":["H4392"],"a":[7]},{"t":"; unto the "},{"t":"place","s":["H4725"],"a":[9]},{"t":" from whence the "},{"t":"rivers","s":["H5158"],"a":[10]},{"t":" "},{"t":"come","s":["H1980"],"a":[11]},{"t":", thither they "},{"t":"return","s":["H7725"],"a":[14]},{"t":" "},{"t":"again","s":["H3212"]},{"t":"."}]},{"n":8,"text":"All things are full of labour; man cannot utter it: the eye is not satisfied with seeing, nor the ear filled with hearing.","tok":[{"t":"All "},{"t":"things","s":["H1697"],"a":[1]},{"t":" are full of "},{"t":"labour","s":["H3023"],"a":[2]},{"t":"; "},{"t":"man","s":["H0376"],"a":[5]},{"t":" "},{"t":"cannot","s":["H3201"],"a":[4]},{"t":" "},{"t":"utter","s":["H1696"],"a":[6]},{"t":" it: the "},{"t":"eye","s":["H5869"],"a":[9]},{"t":" is not "},{"t":"satisfied","s":["H7646"],"a":[8]},{"t":" with "},{"t":"seeing","s":["H7200"],"a":[10]},{"t":", nor the "},{"t":"ear","s":["H0241"],"a":[13]},{"t":" "},{"t":"filled","s":["H4390"],"a":[12]},{"t":" with "},{"t":"hearing","s":["H8085"],"a":[14]},{"t":"."}]},{"n":9,"text":"The thing that hath been, it is that which shall be; and that which is done is that which shall be done: and there is no new thing under the sun.","tok":[{"t":"The thing that hath been, it is that which shall be; and that which is "},{"t":"done","s":["H6213"],"a":[5]},{"t":" is that which shall be "},{"t":"done","s":["H6213"],"a":[7]},{"t":": and there is no "},{"t":"new","s":["H2319"],"a":[10]},{"t":" thing under the "},{"t":"sun","s":["H8121"],"a":[12]},{"t":"."}]},{"n":10,"text":"Is there any thing whereof it may be said, See, this is new? it hath been already of old time, which was before us.","tok":[{"t":"Is "},{"t":"there","s":["H3426"],"a":[0]},{"t":" any "},{"t":"thing","s":["H1697"],"a":[1]},{"t":" whereof it may be "},{"t":"said","s":["H0559"],"a":[2]},{"t":", "},{"t":"See","s":["H7200"],"a":[3]},{"t":", this is "},{"t":"new","s":["H2319"],"a":[5]},{"t":"? it hath been "},{"t":"already","s":["H3528"],"a":[7]},{"t":" of old "},{"t":"time","s":["H5769"],"a":[9]},{"t":", which was "},{"t":"before","s":["H6440"],"a":[12]},{"t":" us."}]},{"n":11,"text":"There is no remembrance of former things; neither shall there be any remembrance of things that are to come with those that shall come after.","tok":[{"t":"There is no "},{"t":"remembrance","s":["H2146"],"a":[1]},{"t":" of "},{"t":"former","s":["H7223"],"a":[2]},{"t":" things; neither shall there be any "},{"t":"remembrance","s":["H2146"],"a":[9]},{"t":" of things that are to "},{"t":"come","s":["H0314"],"a":[4]},{"t":" with those that shall come "},{"t":"after","s":["H0314"],"a":[12]},{"t":"."}]},{"n":12,"text":"¶ I the Preacher was king over Israel in Jerusalem.","tok":[{"t":"¶ I the "},{"t":"Preacher","s":["H6953"],"a":[1]},{"t":" was "},{"t":"king","s":["H4428"],"a":[3]},{"t":" over "},{"t":"Israel","s":["H3478"],"a":[5]},{"t":" in "},{"t":"Jerusalem","s":["H3389"],"a":[6]},{"t":"."}]},{"n":13,"text":"And I gave my heart to seek and search out by wisdom concerning all things that are done under heaven: this sore travail hath God given to the sons of man to be exercised therewith.","tok":[{"t":"And I "},{"t":"gave","s":["H5414"],"a":[0]},{"t":" my "},{"t":"heart","s":["H3820"],"a":[2]},{"t":" to "},{"t":"seek","s":["H1875"],"a":[3]},{"t":" and search "},{"t":"out","s":["H8446"],"a":[4]},{"t":" by "},{"t":"wisdom","s":["H2451"],"a":[5]},{"t":" concerning all things that are "},{"t":"done","s":["H6213"],"a":[9]},{"t":" under "},{"t":"heaven","s":["H8064"],"a":[11]},{"t":": this "},{"t":"sore","s":["H7451"],"a":[14]},{"t":" "},{"t":"travail","s":["H6045"],"a":[13]},{"t":" hath "},{"t":"God","s":["H0430"],"a":[16]},{"t":" "},{"t":"given","s":["H5414"],"a":[15]},{"t":" to the "},{"t":"sons","s":["H1121"],"a":[17]},{"t":" of "},{"t":"man","s":["H0120"],"a":[18]},{"t":" to be "},{"t":"exercised","s":["H6031"],"a":[19]},{"t":" therewith."}]},{"n":14,"text":"I have seen all the works that are done under the sun; and, behold, all is vanity and vexation of spirit.","tok":[{"t":"I have "},{"t":"seen","s":["H7200"],"a":[0]},{"t":" all the "},{"t":"works","s":["H4639"],"a":[3]},{"t":" that are "},{"t":"done","s":["H6213"],"a":[4]},{"t":" under the "},{"t":"sun","s":["H8121"],"a":[6]},{"t":"; and, behold, all is "},{"t":"vanity","s":["H1892"],"a":[9]},{"t":" and "},{"t":"vexation","s":["H7469"],"a":[10]},{"t":" of "},{"t":"spirit","s":["H7307"],"a":[11]},{"t":"."}]},{"n":15,"text":"That which is crooked cannot be made straight: and that which is wanting cannot be numbered.","tok":[{"t":"That which is "},{"t":"crooked","s":["H5791"],"a":[0]},{"t":" "},{"t":"cannot","s":["H3201"],"a":[2]},{"t":" be made "},{"t":"straight","s":["H8626"],"a":[3]},{"t":": and that which is "},{"t":"wanting","s":["H2642"],"a":[4]},{"t":" "},{"t":"cannot","s":["H3201"],"a":[6]},{"t":" be "},{"t":"numbered","s":["H4487"],"a":[7]},{"t":"."}]},{"n":16,"text":"I communed with mine own heart, saying, Lo, I am come to great estate, and have gotten more wisdom than all they that have been before me in Jerusalem: yea, my heart had great experience of wisdom and knowledge.","tok":[{"t":"I "},{"t":"communed","s":["H1696"],"a":[0]},{"t":" with mine own "},{"t":"heart","s":["H3820"],"a":[3]},{"t":", "},{"t":"saying","s":["H0559"],"a":[4]},{"t":", Lo, I am come to great "},{"t":"estate","s":["H1431"],"a":[7]},{"t":", and have "},{"t":"gotten","s":["H3254"],"a":[8]},{"t":" more "},{"t":"wisdom","s":["H2451"],"a":[9]},{"t":" than all they that have been "},{"t":"before","s":["H6440"],"a":[14]},{"t":" me in "},{"t":"Jerusalem","s":["H3389"],"a":[16]},{"t":": yea, my "},{"t":"heart","s":["H3820"],"a":[17]},{"t":" had "},{"t":"great","s":["H7235"],"a":[19]},{"t":" "},{"t":"experience","s":["H7200"],"a":[18]},{"t":" of "},{"t":"wisdom","s":["H2451"],"a":[20]},{"t":" and "},{"t":"knowledge","s":["H1847"],"a":[21]},{"t":"."}]},{"n":17,"text":"And I gave my heart to know wisdom, and to know madness and folly: I perceived that this also is vexation of spirit.","tok":[{"t":"And I "},{"t":"gave","s":["H5414"],"a":[0]},{"t":" my "},{"t":"heart","s":["H3820"],"a":[1]},{"t":" to "},{"t":"know","s":["H3045"],"a":[2]},{"t":" "},{"t":"wisdom","s":["H2451"],"a":[3]},{"t":", and to "},{"t":"know","s":["H3045"],"a":[4]},{"t":" "},{"t":"madness","s":["H1947"],"a":[5]},{"t":" and "},{"t":"folly","s":["H5531"],"a":[6]},{"t":": I "},{"t":"perceived","s":["H3045"],"a":[7]},{"t":" that "},{"t":"this","s":["H1571"],"a":[8]},{"t":" also is "},{"t":"vexation","s":["H7475"],"a":[11]},{"t":" of "},{"t":"spirit","s":["H7307"],"a":[12]},{"t":"."}]},{"n":18,"text":"For in much wisdom is much grief: and he that increaseth knowledge increaseth