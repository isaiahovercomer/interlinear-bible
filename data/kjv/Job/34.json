ands","s":["H3027"],"a":[12]},{"t":"."}]},{"n":20,"text":"In a moment shall they die, and the people shall be troubled at midnight, and pass away: and the mighty shall be taken away without hand.","tok":[{"t":"In a "},{"t":"moment","s":["H7281"],"a":[0]},{"t":" shall they "},{"t":"die","s":["H4191"],"a":[1]},{"t":", and the "},{"t":"people","s":["H5971"],"a":[5]},{"t":" shall be "},{"t":"troubled","s":["H1607"],"a":[4]},{"t":" at "},{"t":"midnight","s":["H2676"],"a":[2]},{"t":", and pass "},{"t":"away","s":["H5674"],"a":[6]},{"t":": and the "},{"t":"mighty","s":["H0047"],"a":[8]},{"t":" shall be taken "},{"t":"away","s":["H5493"],"a":[7]},{"t":" without "},{"t":"hand","s":["H3027"],"a":[10]},{"t":"."}]},{"n":21,"text":"For his eyes are upon the ways of man, and he seeth all his goings.","tok":[{"t":"For his "},{"t":"eyes","s":["H5869"],"a":[1]},{"t":" are upon the "},{"t":"ways","s":["H1870"],"a":[3]},{"t":" of "},{"t":"man","s":["H0376"],"a":[4]},{"t":", and he "},{"t":"seeth","s":["H7200"],"a":[7]},{"t":" all his "},{"t":"goings","s":["H6806"],"a":[6]},{"t":"."}]},{"n":22,"text":"There is no darkness, nor shadow of death, where the workers of iniquity may hide themselves.","tok":[{"t":"There is no "},{"t":"darkness","s":["H2822"],"a":[1]},{"t":", nor shadow of "},{"t":"death","s":["H6757"],"a":[3]},{"t":", where the "},{"t":"workers","s":["H6466"],"a":[6]},{"t":" of "},{"t":"iniquity","s":["H0205"],"a":[7]},{"t":" may "},{"t":"hide","s":["H5641"],"a":[4]},{"t":" themselves."}]},{"n":23,"text":"For he will not lay upon man more than right; that he should enter into judgment with God.","tok":[{"t":"For he will not "},{"t":"lay","s":["H7760"],"a":[4]},{"t":" upon "},{"t":"man","s":["H0376"],"a":[3]},{"t":" more than right; that he should "},{"t":"enter","s":["H1980"],"a":[6]},{"t":" into "},{"t":"judgment","s":["H4941"],"a":[9]},{"t":" with "},{"t":"God","s":["H0410"],"a":[8]},{"t":"."}]},{"n":24,"text":"He shall break in pieces mighty men without number, and set oth