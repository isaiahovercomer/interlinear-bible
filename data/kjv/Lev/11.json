":" of it shall "},{"t":"wash","s":["H3526"],"a":[10]},{"t":" his "},{"t":"clothes","s":["H0899"],"a":[11]},{"t":", and be "},{"t":"unclean","s":["H2930"],"a":[12]},{"t":" until the "},{"t":"even","s":["H6153"],"a":[14]},{"t":"."}]},{"n":41,"text":"And every creeping thing that creepeth upon the earth shall be an abomination; it shall not be eaten.","tok":[{"t":"And every creeping "},{"t":"thing","s":["H8318"],"a":[1]},{"t":" that "},{"t":"creepeth","s":["H8317"],"a":[2]},{"t":" upon the "},{"t":"earth","s":["H0776"],"a":[4]},{"t":" shall be an "},{"t":"abomination","s":["H8263"],"a":[5]},{"t":"; it shall not be "},{"t":"eaten","s":["H0398"],"a":[8]},{"t":"."}]},{"n":42,"text":"Whatsoever goeth upon the belly, and whatsoever goeth upon all four, or whatsoever hath more feet among all creeping things that creep upon the earth, them ye shall not eat; for they are an abomination.","tok":[{"t":"Whatsoever "},{"t":"goeth","s":["H1980"],"a":[1]},{"t":" upon the "},{"t":"belly","s":["H1512"],"a":[3]},{"t":", and whatsoever "},{"t":"goeth","s":["H1980"],"a":[5]},{"t":" upon all "},{"t":"four","s":["H0702"],"a":[7]},{"t":", or whatsoever hath "},{"t":"more","s":["H7235"],"a":[10]},{"t":" "},{"t":"feet","s":["H7272"],"a":[11]},{"t":" among all creeping "},{"t":"things","s":["H8318"],"a":[13]},{"t":" that "},{"t":"creep","s":["H8317"],"a":[14]},{"t":" upon the "},{"t":"earth","s":["H0776"],"a":[16]},{"t":", them ye shall not "},{"t":"eat","s":["H0398"],"a":[18]},{"t":"; for they are an "},{"t":"abomination","s":["H8263"],"a":[20]},{"t":"."}]},{"n":43,"text":"Ye shall not make yourselves abominable with any creeping thing that creepeth, neither shall ye make yourselves unclean with them, that ye should be defiled thereby.","tok":[{"t":"Ye shall not "},{"t":"make","s":["H8262"],"a":[1]},{"t":" "},{"t":"yourselves","s":["H5315"],"a":[3]},{"t":" "},{"t":"abominable","s":["H8262"]},{"t":" with any creeping "},{"t":"thing","s":["H8318"],"a":[5]},{"t":" that "},{"t":"creepeth","s":["H8317"],"a":[6]},{"t":", neither shall ye make yourselves "},{"t":"unclean","s":["H2933"]},{"t":" with them, that ye should be "},{"t":"defiled","s":["H2930"],"a":[8]},{"t":" thereby."}]},{"n":44,"text":"For I am the LORD your God: ye shall therefore sanctify yourselves, and ye shall be holy; for I am holy: neither shall ye defile yourselves with any manner of creeping thing that creepeth upon the earth.","tok":[{"t":"For I am the "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":" your "},{"t":"God","s":["H0430"],"a":[3]},{"t":": ye shall therefore sanctify "},{"t":"yourselves","s":["H6942"],"a":[4]},{"t":", and ye shall be "},{"t":"holy","s":["H6918"],"a":[6]},{"t":"; for I am "},{"t":"holy","s":["H6918"],"a":[8]},{"t":": neither shall ye "},{"t":"defile","s":["H2930"],"a":[11]},{"t":" "},{"t":"yourselves","s":["H5315"],"a":[13]},{"t":" with any manner of creeping "},{"t":"thing","s":["H8318"],"a":[15]},{"t":" that "},{"t":"creepeth","s":["H7430"],"a":[16]},{"t":" upon the "},{"t":"earth","s":["H0776"],"a":[18]},{"t":"."}]},{"n":45,"text":"For I am the LORD that bringeth you up out of the land of Egypt, to be your God: ye shall therefore be holy, for I am holy.","tok":[{"t":"For I am the "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":" that "},{"t":"bringeth","s":["H5927"],"a":[3]},{"t":" you up out of the "},{"t":"land","s":["H0776"],"a":[5]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[6]},{"t":", to be your "},{"t":"God","s":["H0430"],"a":[9]},{"t":": ye shall therefore be "},{"t":"holy","s":["H6918"],"a":[11]},{"t":", for I am "},{"t":"holy","s":["H6918"],"a":[13]},{"t":"."}]},{"n":46,"text":"This is the law of the beasts, and of the fowl, and of every living creature that moveth in the waters, and of every creature that creepeth upon the earth:","tok":[{"t":"This is the "},{"t":"law","s":["H8451"],"a":[1]},{"t":" of the "},{"t":"beasts","s":["H0929"],"a":[2]},{"t":", and of the "},{"t":"fowl","s":["H5775"],"a":[3]},{"t":", and of every "},{"t":"living","s":["H2416"],"a"