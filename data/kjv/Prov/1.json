{"v":1,"book":"Prov","ch":1,"verses":[{"n":1,"text":"The proverbs of Solomon the son of David, king of Israel;","tok":[{"t":"The "},{"t":"proverbs","s":["H4912"],"a":[0]},{"t":" of "},{"t":"Solomon","s":["H8010"],"a":[1]},{"t":" the "},{"t":"son","s":["H1121"],"a":[2]},{"t":" of "},{"t":"David","s":["H1732"],"a":[3]},{"t":", "},{"t":"king","s":["H4428"],"a":[4]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[5]},{"t":";"}]},{"n":2,"text":"To know wisdom and instruction; to perceive the words of understanding;","tok":[{"t":"To "},{"t":"know","s":["H3045"],"a":[0]},{"t":" "},{"t":"wisdom","s":["H2451"],"a":[1]},{"t":" and "},{"t":"instruction","s":["H4148"],"a":[2]},{"t":"; to "},{"t":"perceive","s":["H0995"],"a":[3]},{"t":" the "},{"t":"words","s":["H0561"],"a":[4]},{"t":" of "},{"t":"understanding","s":["H0998"],"a":[5]},{"t":";"}]},{"n":3,"text":"To receive the instruction of wisdom, justice, and judgment, and equity;","tok":[{"t":"To "},{"t":"receive","s":["H3947"],"a":[0]},{"t":" the "},{"t":"instruction","s":["H4148"],"a":[1]},{"t":" of "},{"t":"wisdom","s":["H7919"],"a":[2]},{"t":", "},{"t":"justice","s":["H6664"],"a":[3]},{"t":", and "},{"t":"judgment","s":["H4941"],"a":[4]},{"t":", and "},{"t":"equity","s":["H4339"],"a":[5]},{"t":";"}]},{"n":4,"text":"To give subtilty to the simple, to the young man knowledge and discretion.","tok":[{"t":"To "},{"t":"give","s":["H5414"],"a":[0]},{"t":" "},{"t":"subtilty","s":["H6195"],"a":[2]},{"t":" to the "},{"t":"simple","s":["H6612"],"a":[1]},{"t":", to the young "},{"t":"man","s":["H5288"],"a":[3]},{"t":" "},{"t":"knowledge","s":["H1847"],"a":[4]},{"t":" and "},{"t":"discretion","s":["H4209"],"a":[5]},{"t":"."}]},{"n":5,"text":"A wise man will hear, and will increase learning; and a man of understanding shall attain unto wise counsels:","tok":[{"t":"A "},{"t":"wise","s":["H2450"],"a":[1]},{"t":" man will "},{"t":"hear","s":["H8085"],"a":[0]},{"t":", and will "},{"t":"increase","s":["H3254"],"a":[2]},{"t":" "},{"t":"learning","s":["H3948"],"a":[3]},{"t":"; and a man of "},{"t":"understanding","s":["H0995"],"a":[4]},{"t":" shall "},{"t":"attain","s":["H7069"],"a":[6]},{"t":" unto wise "},{"t":"counsels","s":["H8458"],"a":[5]},{"t":":"}]},{"n":6,"text":"To understand a proverb, and the interpretation; the words of the wise, and their dark sayings.","tok":[{"t":"To "},{"t":"understand","s":["H0995"],"a":[0]},{"t":" a "},{"t":"proverb","s":["H4912"],"a":[1]},{"t":", and the "},{"t":"interpretation","s":["H4426"],"a":[2]},{"t":"; the "},{"t":"words","s":["H1697"],"a":[3]},{"t":" of the "},{"t":"wise","s":["H2450"],"a":[4]},{"t":", and their dark "},{"t":"sayings","s":["H2420"],"a":[5]},{"t":"."}]},{"n":7,"text":"¶ The fear of the LORD is the beginning of knowledge: but fools despise wisdom and instruction.","tok":[{"t":"¶ The "},{"t":"fear","s":["H3374"],"a":[0]},{"t":" of the "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":" is the "},{"t":"beginning","s":["H7225"],"a":[2]},{"t":" of "},{"t":"knowledge","s":["H1847"],"a":[3]},{"t":": but "},{"t":"fools","s":["H0191"],"a":[6]},{"t":" "},{"t":"despise","s":["H0936"],"a":[7]},{"t":" "},{"t":"wisdom","s":["H2451"],"a":[4]},{"t":" and "},{"t":"instruction","s":["H4148"],"a":[5]},{"t":"."}]},{"n":8,"text":"My son, hear the instruction of thy father, and forsake not the law of thy mother:","tok":[{"t":"My "},{"t":"son","s":["H1121"],"a":[1]},{"t":", "},{"t":"hear","s":["H8085"],"a":[0]},{"t":" the "},{"t":"instruction","s":["H4148"],"a":[2]},{"t":" of thy "},{"t":"father","s":["H0001"],"a":[3]},{"t":", and "},{"t":"forsake","s":["H5203"],"a":[5]},{"t":" not the "},{"t":"law","s":["H8451"],"a":[6]},{"t":" of thy "},{"t":"mother","s":["H0517"],"a":[7]},{"t":":"}]},{"n":9,"text":"For they shall be an ornament of grace unto thy head, and chains about thy neck.","tok":[{"t":"For they shall be an "},{"t":"ornament","s":["H3880"],"a":[1]},{"t":" of "},{"t":"grace","s":["H2580"],"a":[2]},{"t":" unto thy "},{"t":"head","s":["H7218"],"a":[4]},{"t":", and "},{"t":"chains","s":["H6060"],"a":[5]},{"t":" about thy "},{"t":"neck","s":["H1621"],"a":[6]},{"t":"."}]},{"n":10,"text":"¶ My son, if sinners entice thee, consent thou not.","tok":[{"t":"¶ My "},{"t":"son","s":["H1121"],"a":[0]},{"t":", if "},{"t":"sinners","s":["H2400"],"a":[3]},{"t":" "},{"t":"entice","s":["H6601"],"a":[2]},{"t":" thee, "},{"t":"consent","s":["H0014"],"a":[5]},{"t":" thou not."}]},{"n":11,"text":"If they say, Come with us, let us lay wait for blood, let us lurk privily for the innocent without cause:","tok":[{"t":"If they "},{"t":"say","s":["H0559"],"a":[1]},{"t":", "},{"t":"Come","s":["H3212"]},{"t":" with us, let us lay "},{"t":"wait","s":["H0693"],"a":[4]},{"t":" for "},{"t":"blood","s":["H1818"],"a":[5]},{"t":", let us "},{"t":"lurk","s":["H6845"],"a":[6]},{"t":" privily for the "},{"t":"innocent","s":["H5355"],"a":[7]},{"t":" without "},{"t":"cause","s":["H2600"],"a":[8]},{"t":":"}]},{"n":12,"text":"Let us swallow them up alive as the grave; and whole, as those that go down into the pit:","tok":[{"t":"Let us swallow them "},{"t":"up","s":["H1104"],"a":[0]},{"t":" "},{"t":"alive","s":["H2416"],"a":[2]},{"t":" as the "},{"t":"grave","s":["H7585"],"a":[1]},{"t":"; and "},{"t":"whole","s":["H8549"],"a":[3]},{"t":", as those that go "},{"t":"down","s":["H3381"],"a":[4]},{"t":" into the "},{"t":"pit","s":["H0953"],"a":[5]},{"t":":"}]},{"n":13,"text":"We shall find all precious substance, we shall fill our houses with spoil:","tok":[{"t":"We shall "},{"t":"find","s":["H4672"],"a":[3]},{"t":" all "},{"t":"precious","s":["H3368"],"a":[2]},{"t":" "},{"t":"substance","s":["H1952"],"a":[1]},{"t":", we shall "},{"t":"fill","s":["H4390"],"a":[4]},{"t":" our "},{"t":"houses","s":["H1004"],"a":[5]},{"t":" with "},{"t":"spoil","s":["H7998"],"a":[6]},{"t":":"}]},{"n":14,"text":"Cast in thy lot among us; let us all have one purse:","tok":[{"t":"Cast","s":["H5307"],"a":[1]},{"t":" in thy "},{"t":"lot","s":["H1486"],"a":[0]},{"t":" "},{"t":"among","s":["H8432"],"a":[2]},{"t":" us; let us all have "},{"t":"one","s":["H0259"],"a":[4]},{"t":" "},{"t":"purse","s":["H3599"],"a":[3]},{"t":":"}]},{"n":15,"text":"My son, walk not thou in the way with them; refrain thy foot from their path:","tok":[{"t":"My "},{"t":"son","s":["H1121"],"a":[0]},{"t":", "},{"t":"walk","s":["H3212"]},{"t":" not thou in the "},{"t":"way","s":["H1870"],"a":[3]},{"t":" with them; "},{"t":"refrain","s":["H4513"],"a":[5]},{"t":" thy "},{"t":"foot","s":["H7272"],"a":[6]},{"t":" from their "},{"t":"path","s":["H5410"],"a":[7]},{"t":":"}]},{"n":16,"text":"For their feet run to evil, and make haste to shed blood.","tok":[{"t":"For their "},{"t":"feet","s":["H7272"],"a":[1]},{"t":" "},{"t":"run","s":["H7323"],"a":[3]},{"t":" to "},{"t":"evil","s":["H7451"],"a":[2]},{"t":", and make "},{"t":"haste","s":["H4116"],"a":[4]},{"t":" to "},{"t":"shed","s":["H8210"],"a":[5]},{"t":" "},{"t":"blood","s":["H1818"],"a":[6]},{"t":"."}]},{"n":17,"text":"Surely in vain the net is spread in the sight of any bird.","tok":[{"t":"Surely in "},{"t":"vain","s":["H2600"],"a":[1]},{"t":" the "},{"t":"net","s":["H7568"],"a":[3]},{"t":" is "},{"t":"spread","s":["H2219"],"a":[2]},{"t":" in the "},{"t":"sight","s":["H5869"],"a":[4]},{"t":" of any "},{"t":"bird","s":["H1167"],"a":[6]},{"t":"."}]},{"n":18,"text":"And they lay wait for their own blood; they lurk privily for their own lives.","tok":[{"t":"And they lay "},{"t":"wait","s":["H0693"],"a":[2]},{"t":" for their own "},{"t":"blood","s":["H1818"],"a":[1]},{"t":"; they lurk "},{"t":"privily","s":["H6845"],"a":[3]},{"t":" for their own "},{"t":"lives","s":["H5315"],"a":[4]},{"t":"."}]},{"n":19,"text":"So are the ways of every one that is greedy of gain; which taketh away the life of the owners thereof.","tok":[{"t":"So are the "},{"t":"ways","s":["H0734"],"a":[1]},{"t":" of every one that is "},{"t":"greedy","s":["H1214"],"a":[3]},{"t":" of "},{"t":"gain","s":["H1215"],"a":[4]},{"t":"; which taketh "},{"t":"away","s":["H3947"],"a":[8]},{"t":" the "},{"t":"life","s":["H5315"],"a":[6]},{"t":" of the "},{"t":"owners","s":["H1167"],"a":[7]},{"t":" thereof."}]},{"n":20,"text":"¶ Wisdom crieth without; she uttereth her voice in the streets:","tok":[{"t":"¶ "},{"t":"Wisdom","s":["H2454"]},{"t":" "},{"t":"crieth","s":["H7442"],"a":[2]},{"t":" "},{"t":"without","s":["H2351"],"a":[1]},{"t":"; she "},{"t":"uttereth","s":["H5414"],"a":[4]},{"t":" her "},{"t":"voice","s":["H6963"],"a":[5]},{"t":" in the "},{"t":"streets","s":["H7339"],"a":[3]},{"t":":"}]},{"n":21,"text":"She crieth in the chief place of concourse, in the openings of the gates: in the city she uttereth her words, saying,","tok":[{"t":"She "},{"t":"crieth","s":["H7121"],"a":[2]},{"t":" in the chief "},{"t":"place","s":["H7218"],"a":[0]},{"t":" of "},{"t":"concourse","s":["H1993"],"a":[1]},{"t":", in the "},{"t":"openings","s":["H6607"],"a":[3]},{"t":" of the "},{"t":"gates","s":["H8179"],"a":[4]},{"t":": in the "},{"t":"city","s":["H5892"],"a":[5]},{"t":" she "},{"t":"uttereth","s":["H0559"],"a":[7]},{"t":" her "},{"t":"words","s":["H0561"],"a":[6]},{"t":", saying,"}]},{"n":22,"text":"How long, ye simple ones, will ye love simplicity? and the scorners delight in their scorning, and fools hate knowledge?","tok":[{"t":"How long, ye simple "},{"t":"ones","s":["H6612"],"a":[2]},{"t":", will ye "},{"t":"love","s":["H0157"],"a":[3]},{"t":" "},{"t":"simplicity","s":["H6612"],"a":[4]},{"t":"? and the "},{"t":"scorners","s":["H3887"],"a":[5]},{"t":" "},{"t":"delight","s":["H2530"],"a":[7]},{"t":" in their "},{"t":"scorning","s":["H3944"],"a":[6]},{"t":", and "},{"t":"fools","s":["H3684"],"a":[9]},{"t":" "},{"t":"hate","s":["H8130"],"a":[10]},{"t":" "},{"t":"knowledge","s":["H1847"],"a":[11]},{"t":"?"}]},{"n":23,"text":"Turn you at my reproof: behold, I will pour out my spirit unto you, I will make known my words unto you.","tok":[{"t":"Turn","s":["H7725"],"a":[0]},{"t":" you at my "},{"t":"reproof","s":["H8433"],"a":[1]},{"t":": behold, I will pour "},{"t":"out","s":["H5042"],"a":[3]},{"t":" my "},{"t":"spirit","s":["H7307"],"a":[5]},{"t":" unto you, I will make "},{"t":"known","s":["H3045"],"a":[6]},{"t":" my "},{"t":"words","s":["H1697"],"a":[7]},{"t":" unto you."}]},{"n":24,"text":"¶ Because I have called, and ye refused; I have stretched out my hand, and no man regarded;","tok":[{"t":"¶ Because I have "},{"t":"called","s":["H7121"],"a":[1]},{"t":", and ye "},{"t":"refused","s":["H3985"],"a":[2]},{"t":"; I have stretched "},{"t":"out","s":["H5186"],"a":[3]},{"t":" my "},{"t":"hand","s":["H3027"],"a":[4]},{"t":", and no man "},{"t":"regarded","s":["H7181"],"a":[6]},{"t":";"}]},{"n":25,"text":"But ye have set at nought all my counsel, and would none of my reproof:","tok":[{"t":"But ye have set at "},{"t":"nought","s":["H6544"],"a":[0]},{"t":" all my "},{"t":"counsel","s":["H6098"],"a":[2]},{"t":", and "},{"t":"would","s":["H0014"],"a":[5]},{"t":" none of my "},{"t":"reproof","s":["H8433"],"a":[3]},{"t":":"}]},{"n":26,"text":"I also will laugh at your calamity; I will mock when your fear cometh;","tok":[{"t":"I also will "},{"t":"laugh","s":["H7832"],"a":[3]},{"t":" at your "},{"t":"calamity","s":["H0343"],"a":[2]},{"t":"; I will "},{"t":"mock","s":["H3932"],"a":[4]},{"t":" when your "},{"t":"fear","s":["H6343"],"a":[6]},{"t":" "},{"t":"cometh","s":["H0935"],"a":[5]},{"t":";"}]},{"n":27,"text":"When your fear cometh as desolation, and your destruction cometh as a whirlwind; when distress and anguish cometh upon you.","tok":[{"t":"When your "},{"t":"fear","s":["H6343"],"a":[2]},{"t":" "},{"t":"cometh","s":["H0935"],"a":[0]},{"t":" as "},{"t":"desolation","s":["H7722"],"a":[1]},{"t":", and your "},{"t":"destruction","s":["H0343"],"a":[3]},{"t":" "},{"t":"cometh","s":["H0857"],"a":[5]},{"t":" as a "},{"t":"whirlwind","s":["H5492"],"a":[4]},{"t":"; when "},{"t":"distress","s":["H6869"],"a":[8]},{"t":" and "},{"t":"anguish","s":["H6695"],"a":[9]},{"t":" "},{"t":"cometh","s":["H0935"],"a":[6]},{"t":" upon you."}]},{"n":28,"text":"Then shall they call upon me, but I will not answer; they shall seek me early, but they shall not find me:","tok":[{"t":"Then shall they "},{"t":"call","s":["H7121"],"a":[1]},{"t":" upon me, but I will not "},{"t":"answer","s":["H6030"],"a":[3]},{"t":"; they shall seek me "},{"t":"early","s":["H7836"],"a":[4]},{"t":", but they shall not "},{"t":"find","s":["H4672"],"a":[6]},{"t":" me:"}]},{"n":29,"text":"For that they hated knowledge, and did not choose the fear of the LORD:","tok":[{"t":"For that they "},{"t":"hated","s":["H8130"],"a":[2]},{"t":" "},{"t":"knowledge","s":["H1847"],"a":[3]},{"t":", and did not "},{"t":"choose","s":["H0977"],"a":[7]},{"t":" the "},{"t":"fear","s":["H3374"],"a":[4]},{"t":" of the "},{"t":"LORD","s":["H3068"],"a":[5]},{"t":":"}]},{"n":30,"text":"They would none of my counsel: they despised all my reproof.","tok":[{"t":"They "},{"t":"would","s":["H0014"],"a":[1]},{"t":" none of my "},{"t":"counsel","s":["H6098"],"a":[2]},{"t":": they "},{"t":"despised","s":["H5006"],"a":[3]},{"t":" all my "},{"t":"reproof","s":["H8433"],"a":[5]},{"t":"."}]},{"n":31,"text":"Therefore shall they eat of the fruit of their own way, and be filled with their own devices.","tok":[{"t":"Therefore shall they "},{"t":"eat","s":["H0398"],"a":[0]},{"t":" of the "},{"t":"fruit","s":["H6529"],"a":[1]},{"t":" of their own "},{"t":"way","s":["H1870"],"a":[2]},{"t":", and be "},{"t":"filled","s":["H7646"],"a":[4]},{"t":" with their own "},{"t":"devices","s":["H4156"],"a":[3]},{"t":"."}]},{"n":32,"text":"For the turning away of the simple shall slay them, and the prosperity of fools shall destroy them.","tok":[{"t":"For the turning "},{"t":"away","s":["H4878"],"a":[1]},{"t":" of the "},{"t":"simple","s":["H6612"],"a":[2]},{"t":" shall "},{"t":"slay","s":["H2026"],"a":[3]},{"t":" them, and the "},{"t":"prosperity","s":["H7962"],"a":[4]},{"t":" of "},{"t":"fools","s":["H3684"],"a":[5]},{"t":" shall "},{"t":"destroy","s":["H0006"],"a":[6]},{"t":" them."}]},{"n":33,"text":"But whoso hearkeneth unto me shall dwell safely, and shall be quiet from fear of evil.","tok":[{"t":"But whoso "},{"t":"hearkeneth","s":["H8085"],"a":[0]},{"t":" unto me shall "},{"t":"dwell","s":["H7931"],"a":[2]},{"t":" "},{"t":"safely","s":["H0983"],"a":[3]},{"t":", and shall be "},{"t":"quiet","s":["H7599"],"a":[4]},{"t":" from "},{"t":"fear","s":["H6343"],"a":[5]},{"t":" of "},{"t":"evil","s":["H7451"],"a":[6]},{"t":"."}]}]}
