{"v":1,"book":"Prov","ch":9,"verses":[{"n":1,"text":"Wisdom hath builded her house, she hath hewn out her seven pillars:","tok":[{"t":"Wisdom","s":["H2454"]},{"t":" hath "},{"t":"builded","s":["H1129"],"a":[1]},{"t":" her "},{"t":"house","s":["H1004"],"a":[2]},{"t":", she hath hewn "},{"t":"out","s":["H2672"],"a":[3]},{"t":" her "},{"t":"seven","s":["H7651"],"a":[5]},{"t":" "},{"t":"pillars","s":["H5982"],"a":[4]},{"t":":"}]},{"n":2,"text":"She hath killed her beasts; she hath mingled her wine; she hath also furnished her table.","tok":[{"t":"She hath "},{"t":"killed","s":["H2873"],"a":[0]},{"t":" her "},{"t":"beasts","s":["H2874"],"a":[1]},{"t":"; she hath "},{"t":"mingled","s":["H4537"],"a":[2]},{"t":" her "},{"t":"wine","s":["H3196"],"a":[3]},{"t":"; she hath also "},{"t":"furnished","s":["H6186"],"a":[5]},{"t":" her "},{"t":"table","s":["H7979"],"a":[6]},{"t":"."}]},{"n":3,"text":"She hath sent forth her maidens: she crieth upon the highest places of the city,","tok":[{"t":"She hath sent "},{"t":"forth","s":["H7971"],"a":[0]},{"t":" her "},{"t":"maidens","s":["H5291"],"a":[1]},{"t":": she "},{"t":"crieth","s":["H7121"],"a":[2]},{"t":" "},{"t":"upon","s":["H1610"],"a":[4]},{"t":" the highest "},{"t":"places","s":["H4791"],"a":[5]},{"t":" of the "},{"t":"city","s":["H7176"],"a":[6]},{"t":","}]},{"n":4,"text":"Whoso is simple, let him turn in hither: as for him that wanteth understanding, she saith to him,","tok":[{"t":"Whoso is "},{"t":"simple","s":["H6612"],"a":[1]},{"t":", let him turn "},{"t":"in","s":["H5493"],"a":[2]},{"t":" hither: as for him that "},{"t":"wanteth","s":["H2638"],"a":[4]},{"t":" "},{"t":"understanding","s":["H3820"],"a":[5]},{"t":", she "},{"t":"saith","s":["H0559"],"a":[6]},{"t":" to him,"}]},{"n":5,"text":"Come, eat of my bread, and drink of the wine which I have mingled.","tok":[{"t":"Come","s":["H3212"]},{"t":", "},{"t":"eat","s":["H3898"],"a":[1]},{"t":" of my "},{"t":"bread","s":["H3899"],"a":[2]},{"t":", and "},{"t":"drink","s":["H8354"],"a":[3]},{"t":" of the "},{"t":"wine","s":["H3196"],"a":[4]},{"t":" which I have "},{"t":"mingled","s":["H4537"],"a":[5]},{"t":"."}]},{"n":6,"text":"Forsake the foolish, and live; and go in the way of understanding.","tok":[{"t":"Forsake","s":["H5800"],"a":[0]},{"t":" the "},{"t":"foolish","s":["H6612"],"a":[1]},{"t":", and "},{"t":"live","s":["H2421"],"a":[2]},{"t":"; and "},{"t":"go","s":["H0833"],"a":[3]},{"t":" in the "},{"t":"way","s":["H1870"],"a":[4]},{"t":" of "},{"t":"understanding","s":["H0998"],"a":[5]},{"t":"."}]},{"n":7,"text":"He that reproveth a scorner getteth to himself shame: and he that rebuketh a wicked man getteth himself a blot.","tok":[{"t":"He that "},{"t":"reproveth","s":["H3256"],"a":[0]},{"t":" a "},{"t":"scorner","s":["H3887"],"a":[1]},{"t":" "},{"t":"getteth","s":["H3947"],"a":[2]},{"t":" to himself "},{"t":"shame","s":["H7036"],"a":[4]},{"t":": and he that "},{"t":"rebuketh","s":["H3198"],"a":[5]},{"t":" a "},{"t":"wicked","s":["H7563"],"a":[6]},{"t":" man getteth himself a "},{"t":"blot","s":["H3971"],"a":[7]},{"t":"."}]},{"n":8,"text":"Reprove not a scorner, lest he hate thee: rebuke a wise man, and he will love thee.","tok":[{"t":"Reprove","s":["H3198"],"a":[1]},{"t":" not a "},{"t":"scorner","s":["H3887"],"a":[2]},{"t":", lest he "},{"t":"hate","s":["H8130"],"a":[4]},{"t":" thee: "},{"t":"rebuke","s":["H3198"],"a":[5]},{"t":" a wise "},{"t":"man","s":["H2450"],"a":[6]},{"t":", and he will "},{"t":"love","s":["H0157"],"a":[7]},{"t":" thee."}]},{"n":9,"text":"Give instruction to a wise man, and he will be yet wiser: teach a just man, and he will increase in learning.","tok":[{"t":"Give","s":["H5414"],"a":[0]},{"t":" instruction to a "},{"t":"wise","s":["H2450"],"a":[1]},{"t":" man, and he will be yet "},{"t":"wiser","s":["H2449"],"a":[2]},{"t":": "},{"t":"teach","s":["H3045"],"a":[4]},{"t":" a "},{"t":"just","s":["H6662"],"a":[5]},{"t":" man, and he will "},{"t":"increase","s":["H3254"],"a":[6]},{"t":" in "},{"t":"learning","s":["H3948"],"a":[7]},{"t":"."}]},{"n":10,"text":"The fear of the LORD is the beginning of wisdom: and the knowledge of the holy is understanding.","tok":[{"t":"The "},{"t":"fear","s":["H3374"],"a":[2]},{"t":" of the "},{"t":"LORD","s":["H3068"],"a":[3]},{"t":" is the "},{"t":"beginning","s":["H8462"],"a":[0]},{"t":" of "},{"t":"wisdom","s":["H2451"],"a":[1]},{"t":": and the "},{"t":"knowledge","s":["H1847"],"a":[4]},{"t":" of the "},{"t":"holy","s":["H6918"],"a":[5]},{"t":" is "},{"t":"understanding","s":["H0998"],"a":[6]},{"t":"."}]},{"n":11,"text":"For by me thy days shall be multiplied, and the years of thy life shall be increased.","tok":[{"t":"For by me thy "},{"t":"days","s":["H3117"],"a":[3]},{"t":" shall be "},{"t":"multiplied","s":["H7235"],"a":[2]},{"t":", and the "},{"t":"years","s":["H8141"],"a":[6]},{"t":" of thy "},{"t":"life","s":["H2416"],"a":[7]},{"t":" shall be "},{"t":"increased","s":["H3254"],"a":[4]},{"t":"."}]},{"n":12,"text":"If thou be wise, thou shalt be wise for thyself: but if thou scornest, thou alone shalt bear it.","tok":[{"t":"If thou be "},{"t":"wise","s":["H2449"],"a":[1]},{"t":", thou shalt be "},{"t":"wise","s":["H2449"],"a":[2]},{"t":" for thyself: but if thou "},{"t":"scornest","s":["H3887"],"a":[4]},{"t":", thou alone shalt "},{"t":"bear","s":["H5375"],"a":[6]},{"t":" it."}]},{"n":13,"text":"¶ A foolish woman is clamorous: she is simple, and knoweth nothing.","tok":[{"t":"¶ A "},{"t":"foolish","s":["H3687"],"a":[1]},{"t":" "},{"t":"woman","s":["H0802"],"a":[0]},{"t":" is "},{"t":"clamorous","s":["H1993"],"a":[2]},{"t":": she is "},{"t":"simple","s":["H6615"],"a":[3]},{"t":", "},{"t":"and","s":["H1077"],"a":[4]},{"t":" "},{"t":"knoweth","s":["H3045"],"a":[5]},{"t":" "},{"t":"nothing","s":["H4100"],"a":[6]},{"t":"."}]},{"n":14,"text":"For she sitteth at the door of her house, on a seat in the high places of the city,","tok":[{"t":"For she "},{"t":"sitteth","s":["H3427"],"a":[0]},{"t":" at the "},{"t":"door","s":["H6607"],"a":[1]},{"t":