:["H8394"],"a":[6]},{"t":" hath he "},{"t":"established","s":["H3559"],"a":[4]},{"t":" the "},{"t":"heavens","s":["H8064"],"a":[5]},{"t":"."}]},{"n":20,"text":"By his knowledge the depths are broken up, and the clouds drop down the dew.","tok":[{"t":"By his "},{"t":"knowledge","s":["H1847"],"a":[0]},{"t":" the "},{"t":"depths","s":["H8415"],"a":[1]},{"t":" are broken "},{"t":"up","s":["H1234"],"a":[2]},{"t":", and the "},{"t":"clouds","s":["H7834"],"a":[3]},{"t":" drop "},{"t":"down","s":["H7491"],"a":[4]},{"t":" the "},{"t":"dew","s":["H2919"],"a":[5]},{"t":"."}]},{"n":21,"text":"¶ My son, let not them depart from thine eyes: keep sound wisdom and discretion:","tok":[{"t":"¶ My "},{"t":"son","s":["H1121"],"a":[0]},{"t":", let not them "},{"t":"depart","s":["H3868"],"a":[2]},{"t":" from thine "},{"t":"eyes","s":["H5869"],"a":[3]},{"t":": "},{"t":"keep","s":["H5341"],"a":[4]},{"t":" sound "},{"t":"wisdom","s":["H8454"],"a":[5]},{"t":" and "},{"t":"discretion","s":["H4209"],"a":[6]},{"t":":"}]},{"n":22,"text":"So shall they be life unto thy soul, and grace to thy neck.","tok":[{"t":"So shall they be "},{"t":"life","s":["H2416"],"a":[1]},{"t":" unto thy "},{"t":"soul","s":["H5315"],"a":[2]},{"t":", and "},{"t":"grace","s":["H2580"],"a":[3]},{"t":" to thy "},{"t":"neck","s":["H1621"],"a":[4]},{"t":"."}]},{"n":23,"text":"Then shalt thou walk in thy way safely, and thy foot shall not stumble.","tok":[{"t":"Then shalt thou "},{"t":"walk","s":["H3212"]},{"t":" in thy "},{"t":"way","s":["H1870"],"a":[3]},{"t":" "},{"t":"safely","s":["H0983"],"a":[2]},{"t":", and thy "},{"t":"foot","s":["H7272"],"a":[4]},{"t":" shall not "},{"t":"stumble","s":["H5062"],"a":[6]},{"t":"."}]},{"n":24,"text":"When thou liest down, thou shalt not be afraid: yea, thou shalt lie down, and thy sleep shall be sweet.","tok":[{"t":"When thou liest "},{"t":"down","s":["H7901"],"a":[1]},{"t":", thou shalt not be "},{"t":"afraid","s":["H6342"],"a":[3]},{"t":": yea, thou shalt lie "},{"t":"down","s":["H7901