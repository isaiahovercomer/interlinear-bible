seeing he dwelleth securely by thee.","tok":[{"t":"Devise","s":["H2790"],"a":[1]},{"t":" not "},{"t":"evil","s":["H7451"],"a":[4]},{"t":" against thy "},{"t":"neighbour","s":["H7453"],"a":[3]},{"t":", seeing he "},{"t":"dwelleth","s":["H3427"],"a":[6]},{"t":" "},{"t":"securely","s":["H0983"],"a":[7]},{"t":" by thee."}]},{"n":30,"text":"¶ Strive not with a man without cause, if he have done thee no harm.","tok":[{"t":"¶ "},{"t":"Strive","s":["H7378"],"a":[1]},{"t":" not with a "},{"t":"man","s":["H0120"],"a":[3]},{"t":" without "},{"t":"cause","s":["H2600"],"a":[4]},{"t":", if he have "},{"t":"done","s":["H1580"],"a":[7]},{"t":" thee no "},{"t":"harm","s":["H7451"],"a":[8]},{"t":"."}]},{"n":31,"text":"¶ Envy thou not the oppressor, and choose none of his ways.","tok":[{"t":"¶ "},{"t":"Envy","s":["H7065"],"a":[1]},{"t":" thou not the "},{"t":"oppressor","s":["H0376"],"a":[2]},{"t":", and "},{"t":"choose","s":["H0977"],"a":[5]},{"t":" none of his "},{"t":"ways","s":["H1870"],"a":[7]},{"t":"."}]},{"n":32,"text":"For the froward is abomination to the LORD: but his secret is with the righteous.","tok":[{"t":"For the "},{"t":"froward","s":["H3868"],"a":[3]},{"t":" is "},{"t":"abomination","s":["H8441"],"a":[1]},{"t":" to the "},{"t":"LORD","s":["H3068"],"a":[2]},{"t":": but his "},{"t":"secret","s":["H5475"],"a":[6]},{"t":" is with the "},{"t":"righteous","s":["H3477"],"a":[5]},{"t":"."}]},{"n":33,"text":"¶ The curse of the LORD is in the house of the wicked: but he blesseth the habitation of the just.","tok":[{"t":"¶ The "},{"t":"curse","s":["H3994"],"a":[0]},{"t":" of the "},{"t":"LORD","s":["H3068"],"a":[1]},{"t":" is in the "},{"t":"house","s":["H1004"],"a":[2]},{"t":" of the "},{"t":"wicked","s":["H7563"],"a":[3]},{"t":": but he "},{"t":"blesseth","s":["H1288"],"a":[6]},{"t":" the "},{"t":"habitation","s":["H5116"],"a":[4]},{"t":" of the "},{"t":"just","s":["H6662"],"a":[5]},{"t":"."}]},{"n":34,"text":"Surely he scorneth the scorners: but he giveth grace unto the lowl