":" the "},{"t":"passover","s":["H6453"],"a":[9]},{"t":", that person shall be cut "},{"t":"off","s":["H3772"],"a":[10]},{"t":" from his "},{"t":"people","s":["H5971"],"a":[13]},{"t":", because he did not present Jehovah’s "},{"t":"offering","s":["H7133"],"a":[15]},{"t":" at its appointed time; that "},{"t":"man","s":["H0376"],"a":[22]},{"t":" shall "},{"t":"bear","s":["H5375"],"a":[21]},{"t":" his "},{"t":"sin","s":["H2399"],"a":[20]},{"t":"."}]},{"n":14,"text":"And if a stranger sojourns with you and keeps the passover to Jehovah, according to the statute of the passover and according to its ordinance so shall he do. You shall have one statute, both for the sojourner and for the native born in the land.","tok":[{"t":"And if a "},{"t":"stranger","s":["H1616"],"a":[3]},{"t":" "},{"t":"sojourns","s":["H1481"],"a":[1]},{"t":" with you and "},{"t":"keeps","s":["H6213"],"a":[4]},{"t":" the "},{"t":"passover","s":["H6453"],"a":[5]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":", according to the statute of the "},{"t":"passover","s":["H6453"],"a":[8]},{"t":" and according to its "},{"t":"ordinance","s":["H2708"],"a":[7]},{"t":" so shall he "},{"t":"do","s":["H6213"],"a":[11]},{"t":". You shall have "},{"t":"one","s":["H0259"],"a":[13]},{"t":" statute, both for the sojourner and for the native "},{"t":"born","s":["H0249"],"a":[17]},{"t":" in the "},{"t":"land","s":["H0776"],"a":[18]},{"t":"."}]},{"n":15,"text":"And on the day that the tabernacle was set up, the cloud covered the tabernacle, the Tent of the Testimony; and in the evening it was like the appearance of fire over the tabernacle until morning.","tok":[{"t":"And on the "},{"t":"day","s":["H3117"],"a":[0]},{"t":" that the "},{"t":"tabernacle","s":["H4908"],"a":[3]},{"t":" was set "},{"t":"up","s":["H6965"],"a":[1]},{"t":", the "},{"t":"cloud","s":["H6051"],"a":[5]},{"t":" "},{"t":"covered","s":["H3680"],"a":[4]},{"t":" the "},{"t":"tabernacle","s":["H4908"],"a":[7]},{"t":", the "},{"t":"Tent","s":["H0168"],"a":[8]},{"t":" of the "},{"t":"Testimony","s":["H5715"],"a":[9]},{"t":"; and in the "},{"t":"evening","s":["H6153"],"a":[10]},{"t":" it was "},{"t":"like","s":["H4908"],"a":[13]},{"t":" the "},{"t":"appearance","s":["H4758"],"a":[14]},{"t":" of "},{"t":"fire","s":["H0784"],"a":[15]},{"t":" over the "},{"t":"tabernacle","s":["H4908"],"a":[13]},{"t":" until "},{"t":"morning","s":["H1242"],"a":[17]},{"t":"."}]},{"n":16,"text":"So it was always; the cloud covered it by day, and the appearance of fire by night.","tok":[{"t":"So it was "},{"t":"always","s":["H8548"],"a":[2]},{"t":"; the "},{"t":"cloud","s":["H6051"],"a":[3]},{"t":" "},{"t":"covered","s":["H3680"],"a":[4]},{"t":" it by day, and the "},{"t":"appearance","s":["H4758"],"a":[5]},{"t":" of "},{"t":"fire","s":["H0784"],"a":[6]},{"t":" by "},{"t":"night","s":["H3915"],"a":[7]},{"t":"."}]},{"n":17,"text":"And whenever the cloud was taken up from over the tent, then after that the children of Israel set out; and in the place where the cloud settled, there the children of Israel encamped.","tok":[{"t":"And "},{"t":"whenever","s":["H6310"],"a":[0]},{"t":" the "},{"t":"cloud","s":["H6051"],"a":[2]},{"t":" was taken "},{"t":"up","s":["H5927"],"a":[1]},{"t":" from over the tent, then "},{"t":"after","s":["H0310"],"a":[5]},{"t":" that the "},{"t":"children","s":["H1121"],"a":[8]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[9]},{"t":" set out; and in the "},{"t":"place","s":["H4725"],"a":[10]},{"t":" where the "},{"t":"cloud","s":["H6051"],"a":[14]},{"t":" settled, there the "},{"t":"children","s":["H1121"],"a":[17]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[18]},{"t":" "},{"t":"encamped","s":["H2583"],"a":[16]},{"t":"."}]},{"n":18,"text":"At the commandment of Jehovah the children of Israel set out, and at the commandment of Jehovah they encamped; as long as the cloud settled upon the tabernacle, they remained encamped.","tok":[{"t":"At the "},{"t":"commandment","s":["H6310"],"a":[1]},{"t":" of "},{"t":"Jehov