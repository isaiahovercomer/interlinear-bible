{"v":1,"book":"Num","ch":17,"verses":[{"n":1,"text":"Then Jehovah spoke to Moses, saying,","tok":[{"t":"Then "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"spoke","s":["H1696"],"a":[0]},{"t":" to "},{"t":"Moses","s":["H4872"],"a":[3]},{"t":", "},{"t":"saying","s":["H0559"],"a":[4]},{"t":","}]},{"n":2,"text":"Speak to the children of Israel, and take from them rods, one for each father’s house, twelve rods from all their leaders according to their fathers’ houses; you shall write everyone’s name upon his rod.","tok":[{"t":"Speak","s":["H1696"],"a":[0]},{"t":" to the "},{"t":"children","s":["H1121"],"a":[2]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":", and "},{"t":"take","s":["H3947"],"a":[4]},{"t":" from them "},{"t":"rods","s":["H4294"],"a":[6]},{"t":", one for each father’s "},{"t":"house","s":["H1004"],"a":[8]},{"t":", "},{"t":"twelve","s":["H8147"],"a":[15]},{"t":" "},{"t":"rods","s":["H4294"],"a":[7]},{"t":" from all their leaders according to their "},{"t":"fathers","s":["H0001"],"a":[14]},{"t":"’ "},{"t":"houses","s":["H1004"],"a":[13]},{"t":"; you shall "},{"t":"write","s":["H3789"],"a":[21]},{"t":" "},{"t":"everyone’s","s":["H0376"],"a":[18]},{"t":" "},{"t":"name","s":["H8034"],"a":[20]},{"t":" upon his "},{"t":"rod","s":["H4294"],"a":[17]},{"t":"."}]},{"n":3,"text":"And you shall write Aaron’s name upon the rod of Levi, for there shall be one rod for the head of each of their fathers’ houses.","tok":[{"t":"And you shall "},{"t":"write","s":["H3789"],"a":[3]},{"t":" "},{"t":"Aaron’s","s":["H0175"],"a":[2]},{"t":" "},{"t":"name","s":["H8034"],"a":[1]},{"t":" upon the "},{"t":"rod","s":["H4294"],"a":[5]},{"t":" of "},{"t":"Levi","s":["H3878"],"a":[6]},{"t":", for there shall be "},{"t":"one","s":["H0259"],"a":[9]},{"t":" "},{"t":"rod","s":["H4294"],"a":[8]},{"t":" for the "},{"t":"head","s":["H7218"],"a":[10]},{"t":" of each of their "},{"t":"fathers","s":["H0001"],"a":[12]},{"t":"’ "},{"t":"houses","s":["H1004"],"a":[11]},{"t":"."}]},{"n":4,"text":"And you shall place them in the Tent of Meeting before the Testimony, where I meet with you.","tok":[{"t":"And you shall place them in the Tent of Meeting "},{"t":"before","s":["H6440"],"a":[3]},{"t":" the "},{"t":"Testimony","s":["H5715"],"a":[4]},{"t":", where I "},{"t":"meet","s":["H3259"],"a":[6]},{"t":" with you."}]},{"n":5,"text":"And the rod of the man whom I choose shall bud, and I will put a stop to the murmurings of the children of Israel against Me, which they murmur against you.","tok":[{"t":"And the "},{"t":"rod","s":["H4294"],"a":[5]},{"t":" of the man whom I "},{"t":"choose","s":["H0977"],"a":[3]},{"t":" shall bud, and I will put a stop to the "},{"t":"murmurings","s":["H8519"],"a":[10]},{"t":" of the "},{"t":"children","s":["H1121"],"a":[11]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[12]},{"t":" against Me, which they "},{"t":"murmur","s":["H3885"],"a":[15]},{"t":" against you."}]},{"n":6,"text":"So Moses spoke to the children of Israel. And every one of their leaders gave him a rod, one rod for each leader according to their fathers’ houses, twelve rods, with the rod of Aaron among their rods.","tok":[{"t":"So "},{"t":"Moses","s":["H4872"],"a":[1]},{"t":" "},{"t":"spoke","s":["H1696"],"a":[0]},{"t":" to the "},{"t":"children","s":["H1121"],"a":[3]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[4]},{"t":". And every one of their leaders "},{"t":"gave","s":["H5414"],"a":[5]},{"t":" him a "},{"t":"rod","s":["H4294"],"a":[9]},{"t":", "},{"t":"one","s":["H0259"],"a":[11]},{"t":" rod for each leader according to their "},{"t":"fathers","s":["H0001"],"a":[16]},{"t":"’ "},{"t":"houses","s":["H1004"],"a":[15]},{"t":", "},{"t":"twelve","s":["H6240"],"a":[18]},{"t":" "},{"t":"rods","s":["H4294"],"a":[12]},{"t":", with the "},{"t":"rod","s":["H4294"],"a":[19]},{"t":" of "},{"t":"Aaron","s":["H0175"],"a":[21]},{"t":" "},{"t":"among","s":["H8432"],"a":[22]},{"t":" their "},{"t":"rods","s":["H4294"],"a":[20]},{"t":"."}]},{"n":7,"text":"And Moses placed the rods before Jehovah in the Tent of the Testimony.","tok":[{"t":"And "},{"t":"Moses","s":["H4872"],"a":[1]},{"t":" "},{"t":"placed","s":["H3240"]},{"t":" the "},{"t":"rods","s":["H4294"],"a":[3]},{"t":" "},{"t":"before","s":["H6440"],"a":[4]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":" in the Tent of the Testimony."}]},{"n":8,"text":"And on the next day Moses went into the Tent of the Testimony, and there was the rod of Aaron for the house of Levi: it had budded; it even put forth buds and produced blossoms and bore ripe almonds.","tok":[{"t":"And on the next day "},{"t":"Moses","s":["H4872"],"a":[3]},{"t":" "},{"t":"went","s":["H0935"],"a":[2]},{"t":" into the Tent of the Testimony, and there was the "},{"t":"rod","s":["H4294"],"a":[9]},{"t":" of "},{"t":"Aaron","s":["H0175"],"a":[10]},{"t":" for the "},{"t":"house","s":["H1004"],"a":[11]},{"t":" of "},{"t":"Levi","s":["H3878"],"a":[12]},{"t":": it had "},{"t":"budded","s":["H6524"],"a":[8]},{"t":"; it even put "},{"t":"forth","s":["H3318"],"a":[13]},{"t":" "},{"t":"buds","s":["H6525"],"a":[14]},{"t":" and "},{"t":"produced","s":["H6692"],"a":[15]},{"t":" "},{"t":"blossoms","s":["H6731"],"a":[16]},{"t":" and bore ripe "},{"t":"almonds","s":["H8247"],"a":[18]},{"t":"."}]},{"n":9,"text":"And Moses brought out all the rods from before Jehovah to all the children of Israel, and they looked; and each one took his rod.","tok":[{"t":"And "},{"t":"Moses","s":["H4872"],"a":[1]},{"t":" brought "},{"t":"out","s":["H3318"],"a":[0]},{"t":" all the "},{"t":"rods","s":["H4294"],"a":[4]},{"t":" from "},{"t":"before","s":["H6440"],"a":[5]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" to all the "},{"t":"children","s":["H1121"],"a":[9]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[10]},{"t":", and they "},{"t":"looked","s":["H7200"],"a":[11]},{"t":"; and each one "},{"t":"took","s":["H3947"],"a":[12]},{"t":" "},{"t":"his","s":["H0376"],"a":[13]},{"t":" "},{"t":"rod","s":["H4294"],"a":[14]},{"t":"."}]},