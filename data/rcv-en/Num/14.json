7462"],"a":[2]},{"t":" in the "},{"t":"wilderness","s":["H4057"],"a":[3]},{"t":" "},{"t":"forty","s":["H0705"],"a":[4]},{"t":" "},{"t":"years","s":["H8141"],"a":[5]},{"t":", and they shall suffer for your unfaithfulness until your corpses have been consumed in the "},{"t":"wilderness","s":["H4057"],"a":[12]},{"t":"."}]},{"n":34,"text":"According to the number of the days which you spied out the land, forty days, a year for every day, you shall bear your iniquities, forty years; and you shall know My displeasure.","tok":[{"t":"According to the "},{"t":"number","s":["H4557"],"a":[0]},{"t":" of the "},{"t":"days","s":["H3117"],"a":[1]},{"t":" which you spied out the "},{"t":"land","s":["H0776"],"a":[5]},{"t":", "},{"t":"forty","s":["H0705"],"a":[6]},{"t":" "},{"t":"days","s":["H3117"],"a":[7]},{"t":", a "},{"t":"year","s":["H8141"],"a":[9]},{"t":" for every "},{"t":"day","s":["H3117"],"a":[8]},{"t":", you shall "},{"t":"bear","s":["H5375"],"a":[12]},{"t":" your "},{"t":"iniquities","s":["H5771"],"a":[14]},{"t":", "},{"t":"forty","s":["H0705"],"a":[15]},{"t":" "},{"t":"years","s":["H8141"],"a":[11]},{"t":"; and you shall "},{"t":"know","s":["H3045"],"a":[17]},{"t":" My displeasure."}]},{"n":35,"text":"I, Jehovah, have spoken; surely I will do this to all this evil assembly who are gathered together against Me. In this wilderness they shall be consumed, and there they shall die.","tok":[{"t":"I, "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", have spoken; "},{"t":"surely","s":["H0518"],"a":[3]},{"t":" I will "},{"t":"do","s":["H6213"],"a":[6]},{"t":" this to all this "},{"t":"evil","s":["H7451"],"a":[9]},{"t":" assembly who are gathered "},{"t":"together","s":["H3259"],"a":[11]},{"t":" against Me. In this "},{"t":"wilderness","s":["H4057"],"a":[13]},{"t":" they shall be "},{"t":"consumed","s":["H8552"],"a":[15]},{"t":", and there they shall "},{"t":"die","s":["H4191"],"a":[17]},{"t":"."}]},{"n":36,"text":"And the men whom Moses sent to spy out the land, who returned and made the whole assembly to murmur against him by bringing up an evil report against the land,","tok":[{"t":"And the "},{"t":"men","s":["H0582"],"a":[0]},{"t":" whom "},{"t":"Moses","s":["H4872"],"a":[3]},{"t":" "},{"t":"sent","s":["H7971"],"a":[2]},{"t":" to spy out the "},{"t":"land","s":["H0776"],"a":[6]},{"t":", who "},{"t":"returned","s":["H7725"],"a":[7]},{"t":" and made the whole assembly to "},{"t":"murmur","s":["H3885"],"a":[8]},{"t":" against him by bringing "},{"t":"up","s":["H3318"],"a":[13]},{"t":" an evil report against the "},{"t":"land","s":["H0776"],"a":[16]},{"t":","}]},{"n":37,"text":"That is, those men who brought up an evil report of the land, died by the plague before Jehovah.","tok":[{"t":"That is, "},{"t":"those","s":["H0582"],"a":[1]},{"t":" "},{"t":"men","s":["H0582"],"a":[1]},{"t":" who brought "},{"t":"up","s":["H3318"],"a":[2]},{"t":" an "},{"t":"evil","s":["H7451"],"a":[5]},{"t":" "},{"t":"report","s":["H1681"],"a":[3]},{"t":" of the "},{"t":"land","s":["H0776"],"a":[4]},{"t":", "},{"t":"died","s":["H4191"],"a":[0]},{"t":" by the "},{"t":"plague","s":["H4046"],"a":[6]},{"t":" "},{"t":"before","s":["H6440"],"a":[7]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[8]},{"t":"."}]},{"n":38,"text":"Only Joshua the son of Nun and Caleb the son of Jephunneh remained alive out of those men who went to spy out the land.","tok":[{"t":"Only "},{"t":"Joshua","s":["H3091"],"a":[0]},{"t":" the "},{"t":"son","s":["H1121"],"a":[1]},{"t":" of "},{"t":"Nun","s":["H5126"],"a":[2]},{"t":" and "},{"t":"Caleb","s":["H3612"],"a":[3]},{"t":" the "},{"t":"son","s":["H1121"],"a":[4]},{"t":" of "},{"t":"Jephunneh","s":["H3312"],"a":[5]},{"t":" remained alive out of those "},{"t":"men","s":["H1992"],"a":[9]},{"t":" who "},{"t":"went","s":["H1980"],"a":[10]},{"t":" to spy out the "},{"t":"land","s":["H0776"],"a":[13]},{"t":"."}]},{"n":39,"text":"And when Moses spoke these words to all the children of Israel, the people mourned greatly.","tok":[{"t":"And when "},{"t":"Moses","s":["H4872"],"a":[1]},{"t":" spoke these words to all the "},{"t":"children","s":["H1121"],"a":[7]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[8]},{"t":", the "},{"t":"people","s":["H5971"],"a":[10]},{"t":" "},{"t":"mourned","s":["H0056"],"a":[9]},{"t":" "},{"t":"greatly","s":["H3966"],"a":[11]},{"t":"."}]},{"n":40,"text":"And they rose up early in the morning to go up to the top of the mountain, saying, Here we are; now we will go up to the place which Jehovah has spoken of, for we have sinned.","tok":[{"t":"And they rose up "},{"t":"early","s":["H7925"],"a":[0]},{"t":" in the "},{"t":"morning","s":["H1242"],"a":[1]},{"t":" to go "},{"t":"up","s":["H5927"],"a":[2]},{"t":" to the "},{"t":"top","s":["H7218"],"a":[4]},{"t":" of the "},{"t":"mountain","s":["H2022"],"a":[5]},{"t":", "},{"t":"saying","s":["H0559"],"a":[6]},{"t":", Here we are; now we will go "},{"t":"up","s":["H5927"],"a":[8]},{"t":" to the "},{"t":"place","s":["H4725"],"a":[10]},{"t":" which "},{"t":"Jehovah","s":["H3068"],"a":[13]},{"t":" has spoken of, for we have "},{"t":"sinned","s":["H2398"],"a":[15]},{"t":"."}]},{"n":41,"text":"But Moses said, Why do you again transgress the commandment of Jehovah? This will not succeed.","tok":[{"t":"But "},{"t":"Moses","s":["H4872"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":", Why do you again "},{"t":"transgress","s":["H5674"],"a":[5]},{"t":" the "},{"t":"commandment","s":["H6310"],"a":[7]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[8]},{"t":"? This will not succeed."}]},{"n":42,"text":"Do not go up — for Jehovah is not among you — so that you are not struck down before your enemies.","tok":[{"t":"Do not go "},{"t":"up","s":["H5927"],"a":[1]},{"t":" — for "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" is not "},{"t":"among","s":["H7130"],"a":[5]},{"t":" you — so that you are not struck down "},{"t":"before","s":["H6440"],"a":[8]},{"t":" your "},{"t":"enemies","s":["H0341"],"a":[9]},{"t":"."}]},{"n":43,"text":"For the Amalekites and the Canaanites are there before you, and you shall fall by the sword. Because you have turned back from following Jehovah, therefore Jehovah will not be with you.","tok":[{"t":"For the "},{"t":"Amalekites","s":["H6003"],"a":[1]},{"t":" and the "},{"t":"Canaanites","s":["H3669"],"a":[2]},{"t":" are there "},{"t":"before","s":["H6440"],"a":[4]},{"t":" you, and you shall "},{"t":"fall","s":["H5307"],"a":[5]},{"t":" by the "},{"t":"sword","s":["H2719"],"a":[6]},{"t":". Because you have "},{"t":"turned","s":["H7725"],"a":[10]},{"t":" back from following "},{"t":"Jehovah","s":["H3068"],"a":[12]},{"t":", therefore "},{"t":"Jehovah","s":["H3068"],"a":[15]},{"t":" will not be with you."}]},{"n":44,"text":"But they presumed to go up to the top of the mountain, even though neither the Ark of the Covenant of Jehovah nor Moses had departed out of the midst of the camp.","tok":[{"t":"But they "},{"t":"presumed","s":["H6075"],"a":[0]},{"t":" to go "},{"t":"up","s":["H5927"],"a":[1]},{"t":" to the "},{"t":"top","s":["H7218"],"a":[3]},{"t":" of the mountain, even though neither the "},{"t":"Ark","s":["H0727"],"a":[5]},{"t":" of the "},{"t":"Covenant","s":["H1285"],"a":[6]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[7]},{"t":" nor "},{"t":"Moses","s":["H4872"],"a":[8]},{"t":" had "},{"t":"departed","s":["H4185"],"a":[10]},{"t":" "},{"t":"out","s":["H7130"],"a":[11]},{"t":" of the midst of the "},{"t":"camp","s":["H4264"],"a":[12]},{"t":"."}]},{"n":45,"text":"Then the Amalekites and the Canaanites who dwelt in that hill country came down and struck them and beat them back as far as Hormah.","tok":[{"t":"Then the "},{"t":"Amalekites","s":["H6003"],"a":[1]},{"t":" and the "},{"t":"Canaanites","s":["H3669"],"a":[2]},{"t":" who "},{"t":"dwelt","s":["H3427"],"a":[3]},{"t":" in that "},{"t":"hill","s":["H2022"],"a":[4]},{"t":" country came "},{"t":"down","s":["H3381"],"a":[0]},{"t":" and struck them and beat them back as far as "},{"t":"Hormah","s":["H2767"],"a":[9]},{"t":"."}]}]}
