a","s":["H3220"],"a":[10]},{"t":"."}]},{"n":26,"text":"Then Jehovah spoke to Moses and to Aaron, saying,","tok":[{"t":"Then "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"spoke","s":["H1696"],"a":[0]},{"t":" to "},{"t":"Moses","s":["H4872"],"a":[3]},{"t":" and to "},{"t":"Aaron","s":["H0175"],"a":[5]},{"t":", "},{"t":"saying","s":["H0559"],"a":[6]},{"t":","}]},{"n":27,"text":"How long shall I bear with this evil assembly, which murmurs against Me? I have heard the murmurings of the children of Israel, which they are making against Me.","tok":[{"t":"How long shall I bear with this "},{"t":"evil","s":["H7451"],"a":[3]},{"t":" "},{"t":"assembly","s":["H5712"],"a":[2]},{"t":", which "},{"t":"murmurs","s":["H3885"],"a":[7]},{"t":" against Me? I have "},{"t":"heard","s":["H8085"],"a":[17]},{"t":" the "},{"t":"murmurings","s":["H8519"],"a":[10]},{"t":" of the "},{"t":"children","s":["H1121"],"a":[11]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[12]},{"t":", which they are making against Me."}]},{"n":28,"text":"Say to them, As I live, declares Jehovah, just as you have spoken in My ears, so will I do to you.","tok":[{"t":"Say","s":["H0559"],"a":[0]},{"t":" to them, "},{"t":"As","s":["H3808"],"a":[7]},{"t":" "},{"t":"I","s":["H3808"],"a":[7]},{"t":" "},{"t":"live","s":["H2416"],"a":[2]},{"t":", "},{"t":"declares","s":["H5002"],"a":[4]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":", just as you have "},{"t":"spoken","s":["H1696"],"a":[9]},{"t":" in My "},{"t":"ears","s":["H0241"],"a":[10]},{"t":", so will I "},{"t":"do","s":["H6213"],"a":[12]},{"t":" to you."}]},{"n":29,"text":"Your corpses shall fall in this wilderness, and none of you who were numbered, according to the number you counted from twenty years old and upward, who have murmured against Me,","tok":[{"t":"Your corpses shall "},{"t":"fall","s":["H5307"],"a":[2]},{"t":" in this "},{"t":"wilderness","s":["H4057"],"a":[0]},{"t":", and none of you who were "},{"t":"numbered","s":["H6485"],"a":[5]},