:["H6440"],"a":[3]},{"t":" a "},{"t":"fall","s":["H3783"],"a":[4]},{"t":"."}]},{"n":19,"text":"It is better to be of a lowly spirit with the poor, Than to divide the spoil with the proud.","tok":[{"t":"It is "},{"t":"better","s":["H2896"],"a":[0]},{"t":" to be of a "},{"t":"lowly","s":["H6035"],"a":[4]},{"t":" "},{"t":"spirit","s":["H7307"],"a":[2]},{"t":" with the poor, Than to "},{"t":"divide","s":["H2505"],"a":[5]},{"t":" the "},{"t":"spoil","s":["H7998"],"a":[6]},{"t":" with the "},{"t":"proud","s":["H1343"],"a":[8]},{"t":"."}]},{"n":20,"text":"He who gives heed to the word will find good, And blessed is he who trusts in Jehovah.","tok":[{"t":"He who gives heed to the word will "},{"t":"find","s":["H4672"],"a":[3]},{"t":" "},{"t":"good","s":["H2896"],"a":[4]},{"t":", And blessed is he who "},{"t":"trusts","s":["H0982"],"a":[5]},{"t":" in "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":"."}]},{"n":21,"text":"The wise in heart will be called discerning, And the sweetness of speech increases persuasiveness.","tok":[{"t":"The "},{"t":"wise","s":["H2450"],"a":[0]},{"t":" in "},{"t":"heart","s":["H3820"],"a":[1]},{"t":" will be "},{"t":"called","s":["H7121"],"a":[2]},{"t":" "},{"t":"discerning","s":["H0995"],"a":[3]},{"t":", And the "},{"t":"sweetness","s":["H4986"],"a":[4]},{"t":" of "},{"t":"speech","s":["H8193"],"a":[5]},{"t":" "},{"t":"increases","s":["H3254"],"a":[6]},{"t":" "},{"t":"persuasiveness","s":["H3948"],"a":[7]},{"t":"."}]},{"n":22,"text":"Insight is a fountain of life to him who has it, But the correction of fools is folly.","tok":[{"t":"Insight is a fountain of "},{"t":"life","s":["H2416"],"a":[1]},{"t":" to him who "},{"t":"has","s":["H1167"],"a":[3]},{"t":" it, But the "},{"t":"correction","s":["H4148"],"a":[4]},{"t":" of "},{"t":"fools","s":["H0191"],"a":[5]},{"t":" is "},{"t":"folly","s":["H0200"],"a":[6]},{"t":"."}]},{"n":23,"text":"The heart of the wise man instructs his mouth And adds persuasiveness to his lips.","tok":[{"t":"The "},{"t":"heart",