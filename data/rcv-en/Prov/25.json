 your case with your neighbor himself, And do not reveal the "},{"t":"secret","s":["H5475"],"a":[4]},{"t":" of "},{"t":"another","s":["H0312"],"a":[5]},{"t":";"}]},{"n":10,"text":"Lest he who hears it revile you, And the evil report of you does not go away.","tok":[{"t":"Lest he who "},{"t":"hears","s":["H8085"],"a":[2]},{"t":" it revile you, And the evil report of you does not go "},{"t":"away","s":["H7725"],"a":[5]},{"t":"."}]},{"n":11,"text":"A word fitly spoken Is like apples of gold in settings of silver.","tok":[{"t":"A "},{"t":"word","s":["H1697"],"a":[4]},{"t":" "},{"t":"fitly","s":["H0212"]},{"t":" "},{"t":"spoken","s":["H1696"],"a":[5]},{"t":" Is like "},{"t":"apples","s":["H8598"],"a":[0]},{"t":" of "},{"t":"gold","s":["H2091"],"a":[1]},{"t":" in "},{"t":"settings","s":["H4906"],"a":[2]},{"t":" of "},{"t":"silver","s":["H3701"],"a":[3]},{"t":"."}]},{"n":12,"text":"Like an earring of gold and an ornament of fine gold Is a wise reprover to a listening ear.","tok":[{"t":"Like an "},{"t":"earring","s":["H5141"],"a":[0]},{"t":" of "},{"t":"gold","s":["H2091"],"a":[1]},{"t":" and an "},{"t":"ornament","s":["H2481"],"a":[2]},{"t":" of fine "},{"t":"gold","s":["H3800"],"a":[3]},{"t":" Is a "},{"t":"wise","s":["H2450"],"a":[5]},{"t":" "},{"t":"reprover","s":["H3198"],"a":[4]},{"t":" to a "},{"t":"listening","s":["H8085"],"a":[8]},{"t":" "},{"t":"ear","s":["H0241"],"a":[7]},{"t":"."}]},{"n":13,"text":"Like the cold of snow in the time of harvest Is a faithful messenger to those who send him, For he refreshes the soul of his masters.","tok":[{"t":"Like the "},{"t":"cold","s":["H6793"],"a":[0]},{"t":" of "},{"t":"snow","s":["H7950"],"a":[1]},{"t":" in the "},{"t":"time","s":["H3117"],"a":[2]},{"t":" of "},{"t":"harvest","s":["H7105"],"a":[3]},{"t":" Is a "},{"t":"faithful","s":["H0539"],"a":[5]},{"t":" "},{"t":"messenger","s":["H6735"],"a":[4]},{"t":" to those who "},{"t":"send","s":["H7971"],"a":[6]},{"t":" him, For he "},{"t":"refreshes","s":["H7725"],"a":[9]},{"t"