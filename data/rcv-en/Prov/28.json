"t":" and "},{"t":"forsakes","s":["H5800"],"a":[5]},{"t":" them will obtain "},{"t":"mercy","s":["H7355"],"a":[6]},{"t":"."}]},{"n":14,"text":"Blessed is the man who always fears, But he who hardens his heart will fall into calamity.","tok":[{"t":"Blessed","s":["H0835"],"a":[0]},{"t":" is the "},{"t":"man","s":["H0120"],"a":[1]},{"t":" who "},{"t":"always","s":["H8548"],"a":[3]},{"t":" "},{"t":"fears","s":["H6342"],"a":[2]},{"t":", But "},{"t":"he","s":["H8548"],"a":[3]},{"t":" who "},{"t":"hardens","s":["H7185"],"a":[4]},{"t":" his "},{"t":"heart","s":["H3820"],"a":[5]},{"t":" will "},{"t":"fall","s":["H5307"],"a":[6]},{"t":" into "},{"t":"calamity","s":["H7451"],"a":[7]},{"t":"."}]},{"n":15,"text":"Like a roaring lion and a roving bear Is a wicked ruler over a poor people.","tok":[{"t":"Like a "},{"t":"roaring","s":["H5098"],"a":[1]},{"t":" "},{"t":"lion","s":["H0738"],"a":[0]},{"t":" and a "},{"t":"roving","s":["H8264"],"a":[3]},{"t":" "},{"t":"bear","s":["H1677"],"a":[2]},{"t":" Is a "},{"t":"wicked","s":["H7563"],"a":[5]},{"t":" "},{"t":"ruler","s":["H4910"],"a":[4]},{"t":" over a "},{"t":"poor","s":["H1800"],"a":[8]},{"t":" "},{"t":"people","s":["H5971"],"a":[7]},{"t":"."}]},{"n":16,"text":"The ruler who lacks understanding is also a great oppressor, But he who hates unjust gain will prolong his days.","tok":[{"t":"The ruler who lacks "},{"t":"understanding","s":["H8394"],"a":[2]},{"t":" is also a "},{"t":"great","s":["H7227"],"a":[3]},{"t":" "},{"t":"oppressor","s":["H4642"],"a":[4]},{"t":", But he who "},{"t":"hates","s":["H8130"],"a":[5]},{"t":" unjust gain will "},{"t":"prolong","s":["H0748"],"a":[7]},{"t":" his "},{"t":"days","s":["H3117"],"a":[8]},{"t":"."}]},{"n":17,"text":"A man who is burdened with a person’s blood Will be a fugitive until death; Let no man support him.","tok":[{"t":"A "},{"t":"man","s":["H0120"],"a":[0]},{"t":" who is burdened with a person’s "},{"t":"blood","s":["H1818"],"a":[2]},{"t":" Will be a fugitive until death; Let no man sup