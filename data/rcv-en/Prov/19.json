4"],"a":[1]},{"t":" will bear the penalty; For if you "},{"t":"deliver","s":["H5337"],"a":[6]},{"t":" him, you will only have to do it "},{"t":"again","s":["H3254"],"a":[8]},{"t":"."}]},{"n":20,"text":"Listen to counsel, and receive instruction, That you may be wise at the end of your days.","tok":[{"t":"Listen","s":["H8085"],"a":[0]},{"t":" to "},{"t":"counsel","s":["H6098"],"a":[1]},{"t":", and "},{"t":"receive","s":["H6901"],"a":[2]},{"t":" "},{"t":"instruction","s":["H4148"],"a":[3]},{"t":", That you may be "},{"t":"wise","s":["H2449"],"a":[5]},{"t":" at the "},{"t":"end","s":["H0319"],"a":[6]},{"t":" of your days."}]},{"n":21,"text":"There are many devices in a man’s heart, But it is the counsel of Jehovah that will stand.","tok":[{"t":"There are "},{"t":"many","s":["H7227"],"a":[0]},{"t":" "},{"t":"devices","s":["H4284"],"a":[1]},{"t":" in a "},{"t":"man’s","s":["H0376"],"a":[3]},{"t":" "},{"t":"heart","s":["H3820"],"a":[2]},{"t":", But it is the "},{"t":"counsel","s":["H6098"],"a":[4]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":" that will "},{"t":"stand","s":["H6965"],"a":[7]},{"t":"."}]},{"n":22,"text":"What is desirable in a man is his kindness, And a poor man is better than a liar.","tok":[{"t":"What is desirable in a "},{"t":"man","s":["H0120"],"a":[1]},{"t":" is his "},{"t":"kindness","s":["H2617"],"a":[2]},{"t":", And a poor "},{"t":"man","s":["H7326"],"a":[4]},{"t":" is "},{"t":"better","s":["H2896"],"a":[3]},{"t":" "},{"t":"than","s":["H0376"],"a":[5]},{"t":" a "},{"t":"liar","s":["H3577"],"a":[6]},{"t":"."}]},{"n":23,"text":"The fear of Jehovah leads to life, And he who has it will lodge in contentment; He will not be visited with evil.","tok":[{"t":"The "},{"t":"fear","s":["H3374"],"a":[0]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" leads to "},{"t":"life","s":["H2416"],"a":[2]},{"t":", And he who has it will lodge in contentment; He will not be "},{"t":"visited","s":["H6485"],"a":[6]},{"t":" with "},{"t":"evil","s":["H7451"],"a":[7]},{"t":"."}]},{"n":24,"text":"The sluggard buries his hand in the dish, And will not even bring it back to his mouth.","tok":[{"t":"The sluggard buries his "},{"t":"hand","s":["H3027"],"a":[2]},{"t":" in the dish, And will not even "},{"t":"bring","s":["H7725"],"a":[8]},{"t":" it back to his "},{"t":"mouth","s":["H6310"],"a":[6]},{"t":"."}]},{"n":25,"text":"Strike a scorner, and the simple will learn prudence; And reprove one who has understanding, and he will understand knowledge.","tok":[{"t":"Strike","s":["H5221"],"a":[1]},{"t":" a "},{"t":"scorner","s":["H3887"],"a":[0]},{"t":", and the "},{"t":"simple","s":["H6612"],"a":[2]},{"t":" will learn prudence; And "},{"t":"reprove","s":["H3198"],"a":[4]},{"t":" one who has "},{"t":"understanding","s":["H0995"],"a":[5]},{"t":", and he will "},{"t":"understand","s":["H0995"],"a":[6]},{"t":" "},{"t":"knowledge","s":["H1847"],"a":[7]},{"t":"."}]},{"n":26,"text":"He who does violence to his father and chases away his mother Is a son that causes shame and brings reproach.","tok":[{"t":"He who does violence to his "},{"t":"father","s":["H0001"],"a":[1]},{"t":" and chases "},{"t":"away","s":["H1272"],"a":[2]},{"t":" his "},{"t":"mother","s":["H0517"],"a":[3]},{"t":" Is a "},{"t":"son","s":["H1121"],"a":[4]},{"t":" that causes "},{"t":"shame","s":["H0954"],"a":[5]},{"t":" and brings "},{"t":"reproach","s":["H2659"],"a":[6]},{"t":"."}]},{"n":27,"text":"Cease listening, my son, to instruction, And you will stray from the words of knowledge.","tok":[{"t":"Cease","s":["H2308"],"a":[0]},{"t":" listening, my "},{"t":"son","s":["H1121"],"a":[1]},{"t":", to "},{"t":"instruction","s":["H4148"],"a":[3]},{"t":", And you will stray from the "},{"t":"words","s":["H0561"],"a":[5]},{"t":" of "},{"t":"knowledge","s":["H1847"],"a":[6]},{"t":"."}]},{"n":28,"text":"A worthless witness mocks justice, And the mouth of the wicked swallows up iniquity.","tok":[{"t":"A "},{"t":"worthless","s":["H1100"],"a":[1]},{"t":" "},{"t":"witness","s