{"v":1,"book":"Prov","ch":24,"verses":[{"n":1,"text":"Do not be envious of evil men, Nor desire to be with them;","tok":[{"t":"Do not be "},{"t":"envious","s":["H7065"],"a":[1]},{"t":" of "},{"t":"evil","s":["H7451"],"a":[3]},{"t":" "},{"t":"men","s":["H0582"],"a":[2]},{"t":", Nor "},{"t":"desire","s":["H0183"],"a":[5]},{"t":" to be with them;"}]},{"n":2,"text":"For their heart meditates violence, And their lips talk of mischief.","tok":[{"t":"For their "},{"t":"heart","s":["H3820"],"a":[3]},{"t":" meditates violence, And their "},{"t":"lips","s":["H8193"],"a":[5]},{"t":" "},{"t":"talk","s":["H1696"],"a":[6]},{"t":" of "},{"t":"mischief","s":["H5999"],"a":[4]},{"t":"."}]},{"n":3,"text":"Through wisdom a house is built, And by understanding it is established,","tok":[{"t":"Through "},{"t":"wisdom","s":["H2451"],"a":[0]},{"t":" a "},{"t":"house","s":["H1004"],"a":[2]},{"t":" is "},{"t":"built","s":["H1129"],"a":[1]},{"t":", And by "},{"t":"understanding","s":["H8394"],"a":[3]},{"t":" it is "},{"t":"established","s":["H3559"],"a":[4]},{"t":","}]},{"n":4,"text":"And by knowledge the rooms are filled With all precious and pleasant riches.","tok":[{"t":"And by "},{"t":"knowledge","s":["H1847"],"a":[0]},{"t":" the rooms are "},{"t":"filled","s":["H4390"],"a":[2]},{"t":" With all "},{"t":"precious","s":["H3368"],"a":[5]},{"t":" and "},{"t":"pleasant","s":["H5273"],"a":[6]},{"t":" "},{"t":"riches","s":["H1952"],"a":[4]},{"t":"."}]},{"n":5,"text":"A wise man is strong, And a man of knowledge increases power.","tok":[{"t":"A "},{"t":"wise","s":["H2450"],"a":[1]},{"t":" "},{"t":"man","s":["H1397"],"a":[0]},{"t":" is "},{"t":"strong","s":["H5797"],"a":[2]},{"t":", And a "},{"t":"man","s":["H0376"],"a":[3]},{"t":" of "},{"t":"knowledge","s":["H1847"],"a":[4]},{"t":" "},{"t":"increases","s":["H0553"],"a":[5]},{"t":" "},{"t":"power","s":["H3581"],"a":[6]},{"t":"."}]},{"n":6,"text":"For by sound counsel you can wage your war, And in the multitude of counselors there is victory.","tok":[{"t":"For by sound "},{"t":"counsel","s":["H8458"],"a":[1]},{"t":" you can wage your "},{"t":"war","s":["H4421"],"a":[4]},{"t":", And in the "},{"t":"multitude","s":["H7230"],"a":[6]},{"t":" of counselors there is victory."}]},{"n":7,"text":"Wisdom is too high for a fool; He does not open his mouth in the gate.","tok":[{"t":"Wisdom","s":["H2454"]},{"t":" is too "},{"t":"high","s":["H7311"],"a":[0]},{"t":" for a "},{"t":"fool","s":["H0191"],"a":[1]},{"t":"; He does not "},{"t":"open","s":["H6605"],"a":[5]},{"t":" his "},{"t":"mouth","s":["H6310"],"a":[6]},{"t":" in the "},{"t":"gate","s":["H8179"],"a":[3]},{"t":"."}]},{"n":8,"text":"He who devises to do evil, Men will call him a mischief-maker.","tok":[{"t":"He who "},{"t":"devises","s":["H2803"],"a":[0]},{"t":" to do "},{"t":"evil","s":["H7489"],"a":[1]},{"t":", Men will "},{"t":"call","s":["H7121"],"a":[5]},{"t":" him a mischief-maker."}]},{"n":9,"text":"The devising of folly is sin, And the scorner is an abomination to men.","tok":[{"t":"The devising of folly is "},{"t":"sin","s":["H2403"],"a":[2]},{"t":", And the "},{"t":"scorner","s":["H3887"],"a":[5]},{"t":" is an "},{"t":"abomination","s":["H8441"],"a":[3]},{"t":" to "},{"t":"men","s":["H0120"],"a":[4]},{"t":"."}]},{"n":10,"text":"If you faint in the day of adversity, Your strength is limited.","tok":[{"t":"If you "},{"t":"faint","s":["H7503"],"a":[0]},{"t":" in the "},{"t":"day","s":["H3117"],"a":[1]},{"t":" of "},{"t":"adversity","s":["H6869"],"a":[2]},{"t":", Your "},{"t":"strength","s":["H3581"],"a":[4]},{"t":" is "},{"t":"limited","s":["H6862"],"a":[3]},{"t":"."}]},{"n":11,"text":"Deliver those who are being taken away to death, And those who are staggering to be slain, oh, hold back!","tok":[{"t":"Deliver","s":["H5337"],"a":[0]},{"t":" those who are being taken away to "},{"t":"death","s":["H4194"],"a":[2]},{"t":", And those who are staggering to be "},{"t":"slain","s":["H2027"],"a":[4]},{"t":", oh, hold back!"}]},{"n":12,"text":"If you say, Look, we did not know this — Does not He who weighs the hearts consider it? And He who keeps your soul, does He not know it? And will He not render to every man according to his work?","tok":[{"t":"If you "},{"t":"say","s":["H0559"],"a":[1]},{"t":", Look, we did not know this — Does not He who weighs the "},{"t":"hearts","s":["H3826"],"a":[8]},{"t":" "},{"t":"consider","s":["H0995"],"a":[10]},{"t":" it? And He who "},{"t":"keeps","s":["H5341"],"a":[11]},{"t":" your "},{"t":"soul","s":["H5315"],"a":[12]},{"t":", does He not "},{"t":"know","s":["H3045"],"a":[14]},{"t":" it? And will He not "},{"t":"render","s":["H7725"],"a":[15]},{"t":" to every "},{"t":"man","s":["H0120"],"a":[16]},{"t":" according to his "},{"t":"work","s":["H6467"],"a":[17]},{"t":"?"}]},{"n":13,"text":"My son, eat honey, for it is good, And the drippings from the honeycomb, which are sweet to your taste:","tok":[{"t":"My "},{"t":"son","s":["H1121"],"a":[1]},{"t":", "},{"t":"eat","s":["H0398"],"a":[0]},{"t":" "},{"t":"honey","s":["H1706"],"a":[2]},{"t":", for it is "},{"t":"good","s":["H2896"],"a":[4]},{"t":", And the drippings from the "},{"t":"honeycomb","s":["H5317"],"a":[5]},{"t":", which are "},{"t":"sweet","s":["H4966"],"a":[6]},{"t":" to your "},{"t":"taste","s":["H2441"],"a":[8]},{"t":":"}]},{"n":14,"text":"Know that wisdom is such for your soul; If you find it, then there will be a latter end, And your hope will not be cut off.","tok":[{"t":"Know","s":["H3045"],"a":[1]},{"t":" that "},{"t":"wisdom","s":["H2451"],"a":[2]},{"t":" is such for your "},{"t":"soul","s":["H5315"],"a":[3]},{"t":"; If you find it, then there will "},{"t":"be","s":["H3426"],"a":[6]},{"t":" a latter end, And your hope will not be cut "},{"t":"off","s":["H3772"],"a":[10]},{"t":"."}]},{"n":15,"text":"Do not lie in wait, O wicked man, against the dwelling of the righteous man; Do not destroy his resting place;","tok":[{"t":"Do not lie in "},{"t":"wait","s":["H0693"],"a":[1]},{"t":", O "},{"t":"wicked","s":["H7563"],"a":[2]},{"t":" man, against the "},{"t":"dwelling","s":["H5116"],"a":[3]},{"t":" of the "},{"t":"righteous","s":["H6662"],"a":[4]},{"t":" man; Do not destroy his resting "},{"t":"place","s":["H7258"],"a":[7]},{"t":";"}]},{"n":16,"text":"For a righteous man falls seven times and rises up again, But the wicked are overthrown by calamity.","tok":[{"t":"For a righteous man "},{"t":"falls","s":["H5307"],"a":[2]},{"t":" seven "},{"t":"times","s":["H7651"],"a":[1]},{"t":" and rises up "},{"t":"again","s":["H6965"],"a":[4]},{"t":", But the "},{"t":"wicked","s":["H7563"],"a":[5]},{"t":" are overthrown by calamity."}]},{"n":17,"text":"Do not rejoice when your enemy falls, And do not let your heart exult when he is overthrown;","tok":[{"t":"Do not "},{"t":"rejoice","s":["H8055"],"a":[3]},{"t":" when your "},{"t":"enemy","s":["H0341"],"a":[1]},{"t":" "},{"t":"falls","s":["H5307"],"a":[0]},{"t":", And do not let your "},{"t":"heart","s":["H3820"],"a":[7]},{"t":" exult when he is overthrown;"}]},{"n":18,"text":"Lest Jehovah see it, and it displease Him, And He turn away His anger from him.","tok":[{"t":"Lest "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" "},{"t":"see","s":["H7200"],"a":[1]},{"t":" it, and it "},{"t":"displease","s":["H7489"],"a":[3]},{"t":" Him, And He turn "},{"t":"away","s":["H7725"],"a":[5]},{"t":" His anger from him."}]},{"n":19,"text":"Do not be incensed because of evildoers; Do not be envious of the wicked;","tok":[{"t":"Do not be incensed because of evildoers; Do not be "},{"t":"envious","s":["H7065"],"a":[4]},{"t":" of the "},{"t":"wicked","s":["H7563"],"a":[5]},{"t":";"}]},{"n":20,"text":"For there will be no future for the evil man; The lamp of the wicked will be put out.","tok":[{"t":"For there will be no future for the "},{"t":"evil","s":["H7451"],"a":[4]},{"t":" man; The lamp of the "},{"t":"wicked","s":["H7563"],"a":[6]},{"t":" will be put "},{"t":"out","s":["H1846"],"a":[7]},{"t":"."}]},{"n":21,"text":"My son, fear Jehovah and the king, And do not associate with those who are given to change;","tok":[{"t":"My "},{"t":"son","s":["H1121"],"a":[3]},{"t":", "},{"t":"fear","s":["H3372"],"a":[0]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" and the "},{"t":"king","s":["H4428"],"a":[4]},{"t":", And do not associate with those who are given to "},{"t":"change","s":["H8138"],"a":[6]},{"t":";"}]},{"n":22,"text":"For their calamity will rise suddenly, And who knows the misfortune of both of them?","tok":[{"t":"For their "},{"t":"calamity","s":["H0343"],"a":[3]},{"t":" will "},{"t":"rise","s":["H6965"],"a":[2]},{"t":" "},{"t":"suddenly","s":["H6597"],"a":[1]},{"t":", And who "},{"t":"knows","s":["H3045"],"a":[7]},{"t":" the "},{"t":"misfortune","s":["H6365"],"a":[4]},{"t":" of "},{"t":"both","s":["H8147"],"a":[5]},{"t":" of them?"}]},{"n":23,"text":"These also are sayings of the wise: It is not good to have respect of persons in judgment.","tok":[{"t":"These also are sayings of the "},{"t":"wise","s":["H2450"],"a":[2]},{"t":": It is not "},{"t":"good","s":["H2896"],"a":[7]},{"t":" to have "},{"t":"respect","s":["H5234"],"a":[3]},{"t":" of "},{"t":"persons","s":["H6440"],"a":[4]},{"t":" in "},{"t":"judgment","s":["H4941"],"a":[5]},{"t":"."}]},{"n":24,"text":"He who says to the wicked man, You are righteous, Peoples will curse him; nations will abhor him.","tok":[{"t":"He who "},{"t":"says","s":["H0559"],"a":[0]},{"t":" to the "},{"t":"wicked","s":["H7563"],"a":[1]},{"t":" man, You are "},{"t":"righteous","s":["H6662"],"a":[2]},{"t":", "},{"t":"Peoples","s":["H5971"],"a":[5]},{"t":" will "},{"t":"curse","s":["H5344"]},{"t":" him; "},{"t":"nations","s":["H3816"],"a":[7]},{"t":" will "},{"t":"abhor","s":["H2194"],"a":[6]},{"t":" him."}]},{"n":25,"text":"But those who rebuke the wicked man will have delight, And a good blessing will come upon them.","tok":[{"t":"But those who "},{"t":"rebuke","s":["H3198"],"a":[0]},{"t":" the wicked man will have "},{"t":"delight","s":["H5276"],"a":[1]},{"t":", And a "},{"t":"good","s":["H2896"],"a":[5]},{"t":" "},{"t":"blessing","s":["H1293"],"a":[4]},{"t":" will "},{"t":"come","s":["H0935"],"a":[3]},{"t":" upon them."}]},{"n":26,"text":"He who gives an honest answer Kisses the lips.","tok":[{"t":"He who "},{"t":"gives","s":["H7725"],"a":[2]},{"t":" an "},{"t":"honest","s":["H5228"],"a":[4]},{"t":" "},{"t":"answer","s":["H1697"],"a":[3]},{"t":" Kisses the "},{"t":"lips","s":["H8193"],"a":[0]},{"t":"."}]},{"n":27,"text":"Prepare your work outside, And make it ready for yourself in the field, And afterward build your house.","tok":[{"t":"Prepare","s":["H3559"],"a":[0]},{"t":" your "},{"t":"work","s":["H4399"],"a":[2]},{"t":" outside, And make it ready for yourself in the "},{"t":"field","s":["H7704"],"a":[4]},{"t":", And "},{"t":"afterward","s":["H0310"],"a":[6]},{"t":" "},{"t":"build","s":["H1129"],"a":[7]},{"t":" your "},{"t":"house","s":["H1004"],"a":[8]},{"t":"."}]},{"n":28,"text":"Do not be a witness against your neighbor without cause, And do not deceive with your lips.","tok":[{"t":"Do not be a "},{"t":"witness","s":["H5707"],"a":[2]},{"t":" against your neighbor without "},{"t":"cause","s":["H2600"],"a":[3]},{"t":", And do not "},{"t":"deceive","s":["H6601"],"a":[5]},{"t":" with your "},{"t":"lips","s":["H8193"],"a":[6]},{"t":"."}]},{"n":29,"text":"Do not say, I will do to him as he has done to me; I will render to the man according to his work.","tok":[{"t":"Do not "},{"t":"say","s":["H0559"],"a":[1]},{"t":", I will "},{"t":"do","s":["H6213"],"a":[3]},{"t":" to him as he has "},{"t":"done","s":["H6213"],"a":[6]},{"t":" to me; I will "},{"t":"render","s":["H7725"],"a":[8]},{"t":" to the "},{"t":"man","s":["H0376"],"a":[9]},{"t":" according to his "},{"t":"work","s":["H6467"],"a":[10]},{"t":"."}]},{"n":30,"text":"I passed by the field of the sluggard, And by the vineyard of the man lacking sense;","tok":[{"t":"I passed by the "},{"t":"field","s":["H7704"],"a":[1]},{"t":" of the "},{"t":"sluggard","s":["H0376"],"a":[2]},{"t":", And by the "},{"t":"vineyard","s":["H3754"],"a":[6]},{"t":" of the "},{"t":"man","s":["H0120"],"a":[7]},{"t":" lacking sense;"}]},{"n":31,"text":"And there it was, all overgrown with thorns; Its surface was covered with nettles, And its stone wall was broken down.","tok":[{"t":"And there it was, all overgrown with "},{"t":"thorns","s":["H7063"],"a":[3]},{"t":"; Its surface was "},{"t":"covered","s":["H3680"],"a":[4]},{"t":" with "},{"t":"nettles","s":["H2738"],"a":[6]},{"t":", And its "},{"t":"stone","s":["H0068"],"a":[8]},{"t":" "},{"t":"wall","s":["H1444"],"a":[7]},{"t":" was broken "},{"t":"down","s":["H2040"],"a":[9]},{"t":"."}]},{"n":32,"text":"When I looked, I considered it; I saw it and received instruction:","tok":[{"t":"When I "},{"t":"looked","s":["H7200"],"a":[4]},{"t":", I considered it; I "},{"t":"saw","s":["H2372"],"a":[0]},{"t":" it and "},{"t":"received","s":["H3947"],"a":[5]},{"t":" "},{"t":"instruction","s":["H4148"],"a":[6]},{"t":":"}]},{"n":33,"text":"A little sleep, a little slumber, A little folding of the hands to rest,","tok":[{"t":"A "},{"t":"little","s":["H4592"],"a":[0]},{"t":" "},{"t":"sleep","s":["H8142"],"a":[1]},{"t":", a "},{"t":"little","s":["H4592"],"a":[2]},{"t":" "},{"t":"slumber","s":["H8572"],"a":[3]},{"t":", A "},{"t":"little","s":["H4592"],"a":[4]},{"t":" "},{"t":"folding","s":["H2264"],"a":[5]},{"t":" of the "},{"t":"hands","s":["H3027"],"a":[6]},{"t":" to "},{"t":"rest","s":["H7901"],"a":[7]},{"t":","}]},{"n":34,"text":"And your poverty will come upon you like a robber, And your want, like an armed man.","tok":[{"t":"And your "},{"t":"poverty","s":["H7389"],"a":[2]},{"t":" will "},{"t":"come","s":["H0935"],"a":[0]},{"t":" upon you like a robber, And your "},{"t":"want","s":["H4270"],"a":[3]},{"t":", like an "},{"t":"armed","s":["H4043"],"a":[5]},{"t":" "},{"t":"man","s":["H0376"],"a":[4]},{"t":"."}]}]}
