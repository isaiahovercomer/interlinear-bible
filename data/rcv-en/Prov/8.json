{"v":1,"book":"Prov","ch":8,"verses":[{"n":1,"text":"Does not wisdom call, And understanding lift up her voice?","tok":[{"t":"Does not "},{"t":"wisdom","s":["H2451"],"a":[1]},{"t":" "},{"t":"call","s":["H7121"],"a":[2]},{"t":", And "},{"t":"understanding","s":["H8394"],"a":[3]},{"t":" lift up her "},{"t":"voice","s":["H6963"],"a":[5]},{"t":"?"}]},{"n":2,"text":"On the top of the heights, by the way, Where the paths meet, she takes her stand;","tok":[{"t":"On the "},{"t":"top","s":["H7218"],"a":[0]},{"t":" of the "},{"t":"heights","s":["H4791"],"a":[1]},{"t":", by the "},{"t":"way","s":["H1870"],"a":[3]},{"t":", "},{"t":"Where","s":["H1004"],"a":[4]},{"t":" the "},{"t":"paths","s":["H5410"],"a":[5]},{"t":" meet, she takes her stand;"}]},{"n":3,"text":"Beside the gates, at the entry of the city, At the entrance of the doors, she cries aloud:","tok":[{"t":"Beside","s":["H7442"],"a":[6]},{"t":" the "},{"t":"gates","s":["H8179"],"a":[1]},{"t":", "},{"t":"at","s":["H3027"],"a":[0]},{"t":" the "},{"t":"entry","s":["H6310"],"a":[2]},{"t":" of the "},{"t":"city","s":["H7176"],"a":[3]},{"t":", At the "},{"t":"entrance","s":["H3996"],"a":[4]},{"t":" of the "},{"t":"doors","s":["H6607"],"a":[5]},{"t":", she cries aloud:"}]},{"n":4,"text":"To you, O men, I call; And my voice is to the sons of men.","tok":[{"t":"To you, O "},{"t":"men","s":["H0376"],"a":[1]},{"t":", I "},{"t":"call","s":["H7121"],"a":[2]},{"t":"; And my "},{"t":"voice","s":["H6963"],"a":[3]},{"t":" is to the "},{"t":"sons","s":["H1121"],"a":[5]},{"t":" of "},{"t":"men","s":["H0120"],"a":[6]},{"t":"."}]},{"n":5,"text":"O simple ones, understand prudence; And, O fools, be of an understanding heart.","tok":[{"t":"O "},{"t":"simple","s":["H6612"],"a":[1]},{"t":" ones, "},{"t":"understand","s":["H0995"],"a":[0]},{"t":" prudence; And, O "},{"t":"fools","s":["H3684"],"a":[3]},{"t":", be of an "},{"t":"understanding","s":["H0995"],"a":[4]},{"t":" "},{"t":"heart","s":["H3820"],"a":[5]},{"t":"."}]},{"n":6,"text":"Hear, for I will speak noble things; And the opening of my lips will yield right things.","tok":[{"t":"Hear","s":["H8085"],"a":[0]},{"t":", for I will "},{"t":"speak","s":["H1696"],"a":[3]},{"t":" noble "},{"t":"things","s":["H5057"],"a":[2]},{"t":"; And the "},{"t":"opening","s":["H4669"],"a":[4]},{"t":" of my "},{"t":"lips","s":["H8193"],"a":[5]},{"t":" will yield right "},{"t":"things","s":["H4339"],"a":[6]},{"t":"."}]},{"n":7,"text":"For my mouth will utter truth, And wickedness is an abomination to my lips.","tok":[{"t":"For my "},{"t":"mouth","s":["H2441"],"a":[3]},{"t":" will utter "},{"t":"truth","s":["H0571"],"a":[1]},{"t":", And "},{"t":"wickedness","s":["H7562"],"a":[6]},{"t":" is an "},{"t":"abomination","s":["H8441"],"a":[4]},{"t":" to my "},{"t":"lips","s":["H8193"],"a":[5]},{"t":"."}]},{"n":8,"text":"All the words of my mouth are in righteousness; There is nothing twisted or crooked in them.","tok":[{"t":"All the "},{"t":"words","s":["H0561"],"a":[2]},{"t":" of my "},{"t":"mouth","s":["H6310"],"a":[3]},{"t":" are in "},{"t":"righteousness","s":["H6664"],"a":[0]},{"t":"; There is nothing twisted or crooked in them."}]},{"n":9,"text":"They are all straight to him who understands, And right to those who find knowledge.","tok":[{"t":"They are all straight to him who "},{"t":"understands","s":["H0995"],"a":[2]},{"t":", And "},{"t":"right","s":["H3477"],"a":[3]},{"t":" to those who "},{"t":"find","s":["H4672"],"a":[4]},{"t":" "},{"t":"knowledge","s":["H1847"],"a":[5]},{"t":"."}]},{"n":10,"text":"Receive my instruction, and not silver; And knowledge rather than choice gold.","tok":[{"t":"Receive","s":["H3947"],"a":[0]},{"t":" my "},{"t":"instruction","s":["H4148"],"a":[1]},{"t":", and not "},{"t":"silver","s":["H3701"],"a":[3]},{"t":"; And "},{"t":"knowledge","s":["H1847"],"a":[4]},{"t":" rather than "},{"t":"choice","s":["H0977"],"a":[6]},{"t":" "},{"t":"gold","s":["H2742"],"a":[5]},{"t":"."}]},{"n":11,"text":"For wisdom is better than corals, And nothing that you desire compares with her.","tok":[{"t":"For "},{"t":"wisdom","s":["H2451"],"a":[2]},{"t":" is "},{"t":"better","s":["H2896"],"a":[1]},{"t":" than corals, And nothing that you "},{"t":"desire","s":["H2656"],"a":[5]},{"t":" "},{"t":"compares","s":["H7737"],"a":[7]},{"t":" with her."}]},{"n":12,"text":"I, wisdom, dwell with prudence, And I find knowledge and discretion.","tok":[{"t":"I, "},{"t":"wisdom","s":["H2451"],"a":[1]},{"t":", "},{"t":"dwell","s":["H7931"],"a":[2]},{"t":" with "},{"t":"prudence","s":["H6195"],"a":[3]},{"t":", And I find "},{"t":"knowledge","s":["H1847"],"a":[4]},{"t":" and "},{"t":"discretion","s":["H4209"],"a":[5]},{"t":"."}]},{"n":13,"text":"The fear of Jehovah is to hate evil; Pride and arrogance and the evil way And the perverse mouth, I hate.","tok":[{"t":"The "},{"t":"fear","s":["H3374"],"a":[0]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" is to "},{"t":"hate","s":["H8130"],"a":[2]},{"t":" "},{"t":"evil","s":["H7451"],"a":[3]},{"t":"; "},{"t":"Pride","s":["H1344"],"a":[4]},{"t":" and "},{"t":"arrogance","s":["H1347"],"a":[5]},{"t":" and the "},{"t":"evil","s":["H7451"],"a":[7]},{"t":" "},{"t":"way","s":["H1870"],"a":[6]},{"t":" And the "},{"t":"perverse","s":["H8419"],"a":[9]},{"t":" "},{"t":"mouth","s":["H6310"],"a":[8]},{"t":", I "},{"t":"hate","s":["H8130"],"a":[10]},{"t":"."}]},{"n":14,"text":"Counsel is mine and sound wisdom; I am understanding; I have might.","tok":[{"t":"Counsel","s":["H6098"],"a":[1]},{"t":" is mine and sound "},{"t":"wisdom","s":["H8454"],"a":[2]},{"t":"; I am "},{"t":"understanding","s":["H0998"],"a":[4]},{"t":"; I have might."}]},{"n":15,"text":"By me kings reign, And rulers decree justice.","tok":[{"t":"By me "},{"t":"kings","s":["H4428"],"a":[1]},{"t":" "},{"t":"reign","s":["H4427"],"a":[2]},{"t":", And "},{"t":"rulers","s":["H7336"],"a":[3]},{"t":" "},{"t":"decree","s":["H2710"],"a":[4]},{"t":" "},{"t":"justice","s":["H6664"],"a":[5]},{"t":"."}]},{"n":16,"text":"By me princes rule, And nobles — all who judge righteously.","tok":[{"t":"By me "},{"t":"princes","s":["H8269"],"a":[1]},{"t":" "},{"t":"rule","s":["H8323"],"a":[2]},{"t":", And "},{"t":"nobles","s":["H5081"],"a":[3]},{"t":" — all who "},{"t":"judge","s":["H8199"],"a":[5]},{"t":" "},{"t":"righteously","s":["H0776"]},{"t":"."}]},{"n":17,"text":"I love those who love me, And those who seek me diligently will find me.","tok":[{"t":"I "},{"t":"love","s":["H0157"],"a":[1]},{"t":" those who "},{"t":"love","s":["H0157"],"a":[2]},{"t":" me, And those who seek me diligently will "},{"t":"find","s":["H4672"],"a":[4]},{"t":" me."}]},{"n":18,"text":"Riches and honor are with me, Enduring wealth and righteousness.","tok":[{"t":"Riches","s":["H6239"],"a":[0]},{"t":" and honor are with me, Enduring wealth and "},{"t":"righteousness","s":["H6666"],"a":[5]},{"t":"."}]},{"n":19,"text":"My fruit is better than gold, even fine gold; And my yield than choice silver.","tok":[{"t":"My "},{"t":"fruit","s":["H6529"],"a":[1]},{"t":" is "},{"t":"better","s":["H2896"],"a":[0]},{"t":" than "},{"t":"gold","s":["H2742"],"a":[2]},{"t":", even fine "},{"t":"gold","s":["H6337"],"a":[3]},{"t":"; And my yield than "},{"t":"choice","s":["H0977"],"a":[6]},{"t":" "},{"t":"silver","s":["H3701"],"a":[5]},{"t":"."}]},{"n":20,"text":"I walk in the way of righteousness, In the midst of the paths of justice,","tok":[{"t":"I walk in the "},{"t":"way","s":["H0734"],"a":[0]},{"t":" of "},{"t":"righteousness","s":["H6666"],"a":[1]},{"t":", In the "},{"t":"midst","s":["H8432"],"a":[3]},{"t":" of the "},{"t":"paths","s":["H5410"],"a":[4]},{"t":" of "},{"t":"justice","s":["H4941"],"a":[5]},{"t":","}]},{"n":21,"text":"That I may cause those who love me to inherit substance And that I may fill their treasuries.","tok":[{"t":"That I may cause those who "},{"t":"love","s":["H0157"],"a":[1]},{"t":" me to "},{"t":"inherit","s":["H5157"],"a":[0]},{"t":" "},{"t":"substance","s":["H3426"],"a":[2]},{"t":" And that I may "},{"t":"fill","s":["H4390"],"a":[4]},{"t":" their "},{"t":"treasuries","s":["H0214"],"a":[3]},{"t":"."}]},{"n":22,"text":"Jehovah possessed me in the beginning of His way, Before His works of old.","tok":[{"t":"Jehovah","s":["H3068"],"a":[0]},{"t":" "},{"t":"possessed","s":["H7069"],"a":[1]},{"t":" me in the "},{"t":"beginning","s":["H7225"],"a":[2]},{"t":" of His "},{"t":"way","s":["H1870"],"a":[3]},{"t":", "},{"t":"Before","s":["H6924"],"a":[4]},{"t":" His "},{"t":"works","s":["H4659"],"a":[5]},{"t":" of old."}]},{"n":23,"text":"I was set up from eternity, From the beginning, before the earth was.","tok":[{"t":"I was set "},{"t":"up","s":["H5258"],"a":[1]},{"t":" from "},{"t":"eternity","s":["H5769"],"a":[0]},{"t":", From the "},{"t":"beginning","s":["H7218"],"a":[2]},{"t":", "},{"t":"before","s":["H6924"],"a":[3]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[4]},{"t":" was."}]},{"n":24,"text":"When there were no depths, I was brought forth, When there were no fountains abounding with water.","tok":[{"t":"When there were no "},{"t":"depths","s":["H8415"],"a":[1]},{"t":", I was brought "},{"t":"forth","s":["H2342"],"a":[2]},{"t":", When there were no "},{"t":"fountains","s":["H4599"],"a":[4]},{"t":" "},{"t":"abounding","s":["H3513"],"a":[5]},{"t":" with "},{"t":"water","s":["H4325"],"a":[6]},{"t":"."}]},{"n":25,"text":"Before the mountains were settled, Before the hills, I was brought forth;","tok":[{"t":"Before the "},{"t":"mountains","s":["H2022"],"a":[1]},{"t":" were "},{"t":"settled","s":["H2883"],"a":[2]},{"t":", "},{"t":"Before","s":["H6440"],"a":[3]},{"t":" the "},{"t":"hills","s":["H1389"],"a":[4]},{"t":", I was brought "},{"t":"forth","s":["H2342"],"a":[5]},{"t":";"}]},{"n":26,"text":"When He had not yet made the earth and the fields, Nor the first dust of the world.","tok":[{"t":"When He had not yet "},{"t":"made","s":["H6213"],"a":[2]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[3]},{"t":" and the "},{"t":"fields","s":["H2351"],"a":[4]},{"t":", Nor the first "},{"t":"dust","s":["H6083"],"a":[6]},{"t":" of the "},{"t":"world","s":["H8398"],"a":[7]},{"t":"."}]},{"n":27,"text":"When He established the heavens, I was there; When He inscribed a circle upon the surface of the deep,","tok":[{"t":"When He established the "},{"t":"heavens","s":["H8064"],"a":[1]},{"t":", I was there; When He inscribed a circle upon the surface of the deep,"}]},{"n":28,"text":"When He made firm the skies above, When the fountains of the deep became strong,","tok":[{"t":"When He made firm the skies "},{"t":"above","s":["H4605"],"a":[2]},{"t":", "},{"t":"When","s":["H5810"],"a":[3]},{"t":" the "},{"t":"fountains","s":["H5869"],"a":[4]},{"t":" of the "},{"t":"deep","s":["H8415"],"a":[5]},{"t":" became strong,"}]},{"n":29,"text":"When He set for the sea its boundary, That the waters should not transgress His commandment, When He marked out the foundations of the earth;","tok":[{"t":"When He set for the "},{"t":"sea","s":["H3220"],"a":[1]},{"t":" its boundary, That the "},{"t":"waters","s":["H4325"],"a":[3]},{"t":" should not transgress His "},{"t":"commandment","s":["H6310"],"a":[6]},{"t":", When He marked out the "},{"t":"foundations","s":["H4144"],"a":[8]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[9]},{"t":";"}]},{"n":30,"text":"Then I was by Him, as a master workman; And I was daily His delight, Rejoicing always before Him,","tok":[{"t":"Then I was by "},{"t":"Him","s":["H0681"],"a":[1]},{"t":", as a master workman; And I was "},{"t":"daily","s":["H3117"],"a":[5]},{"t":" His "},{"t":"delight","s":["H8191"],"a":[4]},{"t":", "},{"t":"Rejoicing","s":["H7832"],"a":[7]},{"t":" "},{"t":"always","s":["H6256"],"a":[10]},{"t":" "},{"t":"before","s":["H6440"],"a":[8]},{"t":" Him,"}]},{"n":31,"text":"Rejoicing in His habitable earth; And my delight was in the sons of men.","tok":[{"t":"Rejoicing","s":["H7832"],"a":[0]},{"t":" in His habitable "},{"t":"earth","s":["H0776"],"a":[2]},{"t":"; And my "},{"t":"delight","s":["H8191"],"a":[3]},{"t":" was in the "},{"t":"sons","s":["H1121"],"a":[5]},{"t":" of "},{"t":"men","s":["H0120"],"a":[6]},{"t":"."}]},{"n":32,"text":"Now therefore, my sons, listen to me; For blessed are they who keep my ways.","tok":[{"t":"Now therefore, my sons, "},{"t":"listen","s":["H8085"],"a":[2]},{"t":" to "},{"t":"me","s":["H1121"],"a":[1]},{"t":"; For "},{"t":"blessed","s":["H0835"],"a":[4]},{"t":" are they who "},{"t":"keep","s":["H8104"],"a":[6]},{"t":" my "},{"t":"ways","s":["H1870"],"a":[5]},{"t":"."}]},{"n":33,"text":"Hear instruction, and be wise; And do not neglect it.","tok":[{"t":"Hear","s":["H8085"],"a":[0]},{"t":" "},{"t":"instruction","s":["H4148"],"a":[1]},{"t":", and be "},{"t":"wise","s":["H2449"],"a":[2]},{"t":"; And do not neglect it."}]},{"n":34,"text":"Blessed is the man who listens to me, Watching daily at my doors, Waiting at my doorposts.","tok":[{"t":"Blessed","s":["H0835"],"a":[0]},{"t":" is the "},{"t":"man","s":["H0120"],"a":[1]},{"t":" who listens to me, "},{"t":"Watching","s":["H8245"],"a":[4]},{"t":" "},{"t":"daily","s":["H3117"],"a":[7]},{"t":" at my "},{"t":"doors","s":["H6607"],"a":[11]},{"t":", "},{"t":"Waiting","s":["H8104"],"a":[9]},{"t":" at my doorposts."}]},{"n":35,"text":"For whoever finds me finds life, And will obtain favor from Jehovah.","tok":[{"t":"For whoever "},{"t":"finds","s":["H4672"],"a":[1]},{"t":" me "},{"t":"finds","s":["H4672"],"a":[2]},{"t":" "},{"t":"life","s":["H2416"],"a":[3]},{"t":", And will "},{"t":"obtain","s":["H6329"],"a":[4]},{"t":" "},{"t":"favor","s":["H7522"],"a":[5]},{"t":" from "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":"."}]},{"n":36,"text":"But he who sins against me wrongs his own soul; All who hate me love death.","tok":[{"t":"But he who sins against me "},{"t":"wrongs","s":["H2554"],"a":[1]},{"t":" his own "},{"t":"soul","s":["H5315"],"a":[2]},{"t":"; All who "},{"t":"hate","s":["H8130"],"a":[4]},{"t":" me "},{"t":"love","s":["H0157"],"a":[5]},{"t":" "},{"t":"death","s":["H4194"],"a":[6]},{"t":"."}]}]}
