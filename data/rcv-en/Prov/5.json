{"v":1,"book":"Prov","ch":5,"verses":[{"n":1,"text":"My son, be attentive to my wisdom; Incline your ear to my understanding,","tok":[{"t":"My "},{"t":"son","s":["H1121"],"a":[0]},{"t":", be attentive to my "},{"t":"wisdom","s":["H2451"],"a":[1]},{"t":"; Incline your "},{"t":"ear","s":["H0241"],"a":[5]},{"t":" to my "},{"t":"understanding","s":["H8394"],"a":[3]},{"t":","}]},{"n":2,"text":"That you may keep discretion, And your lips may guard knowledge.","tok":[{"t":"That you may "},{"t":"keep","s":["H5341"],"a":[4]},{"t":" "},{"t":"discretion","s":["H4209"],"a":[1]},{"t":", And your "},{"t":"lips","s":["H8193"],"a":[3]},{"t":" may guard "},{"t":"knowledge","s":["H1847"],"a":[2]},{"t":"."}]},{"n":3,"text":"For the lips of a strange woman drip honey, And her mouth is smoother than oil;","tok":[{"t":"For the "},{"t":"lips","s":["H8193"],"a":[3]},{"t":" of a strange "},{"t":"woman","s":["H2114"],"a":[4]},{"t":" drip honey, And her "},{"t":"mouth","s":["H2441"],"a":[7]},{"t":" is "},{"t":"smoother","s":["H2509"],"a":[5]},{"t":" than "},{"t":"oil","s":["H8081"],"a":[6]},{"t":";"}]},{"n":4,"text":"But in the end she is bitter as wormwood, Sharp as a two-edged sword.","tok":[{"t":"But in the "},{"t":"end","s":["H0319"],"a":[0]},{"t":" she is "},{"t":"bitter","s":["H4751"],"a":[1]},{"t":" as "},{"t":"wormwood","s":["H3939"],"a":[2]},{"t":", "},{"t":"Sharp","s":["H2299"],"a":[3]},{"t":" as a two-edged "},{"t":"sword","s":["H2719"],"a":[4]},{"t":"."}]},{"n":5,"text":"Her feet go down to death; Her steps hold fast to Sheol.","tok":[{"t":"Her "},{"t":"feet","s":["H7272"],"a":[0]},{"t":" go "},{"t":"down","s":["H3381"],"a":[1]},{"t":" to "},{"t":"death","s":["H4194"],"a":[2]},{"t":"; Her "},{"t":"steps","s":["H6806"],"a":[4]},{"t":" "},{"t":"hold","s":["H8551"],"a":[5]},{"t":" fast to Sheol."}]},{"n":6,"text":"She does not make straight the path of life: Her ways wander, and she does not know it.","tok":[{"t":"She does not make straight the "},{"t":"path","s":["H0734"],"a":[0]},{"t":" of "},{"t":"life","s":["H2416"],"a":[1]},{"t":": Her "},{"t":"ways","s":["H4570"],"a":[5]},{"t":" wander, and she does not "},{"t":"know","s":["H3045"],"a":[7]},{"t":" it."}]},{"n":7,"text":"And now, my sons, listen to me, And do not depart from the words of my mouth.","tok":[{"t":"And now, my sons, listen to me, And do not "},{"t":"depart","s":["H5493"],"a":[5]},{"t":" from the "},{"t":"words","s":["H0561"],"a":[6]},{"t":" of my "},{"t":"mouth","s":["H6310"],"a":[7]},{"t":"."}]},{"n":8,"text":"Keep your way far from her, And do not go near the door of her house;","tok":[{"t":"Keep your "},{"t":"way","s":["H1870"],"a":[2]},{"t":" "},{"t":"far","s":["H7368"]},{"t":" from her, And do not go "},{"t":"near","s":["H7126"],"a":[4]},{"t":" the "},{"t":"door","s":["H6607"],"a":[6]},{"t":" of her "},{"t":"house","s":["H1004"],"a":[7]},{"t":";"}]},{"n":9,"text":"Lest you give your honor to others, And your years to the cruel;","tok":[{"t":"Lest you "},{"t":"give","s":["H5414"],"a":[1]},{"t":" your honor to "},{"t":"others","s":["H0312"],"a":[2]},{"t":", And your "},{"t":"years","s":["H8141"],"a":[4]},{"t":" to the "},{"t":"cruel","s":["H0394"],"a":[5]},{"t":";"}]},{"n":10,"text":"Lest strangers be filled with your wealth, And your labors go to the house of a foreigner,","tok":[{"t":"Lest "},{"t":"strangers","s":["H2114"],"a":[2]},{"t":" be "},{"t":"filled","s":["H7646"],"a":[1]},{"t":" with your "},{"t":"wealth","s":["H3581"],"a":[3]},{"t":", And your labors go to the "},{"t":"house","s":["H1004"],"a":[5]},{"t":" of a "},{"t":"foreigner","s":["H5237"],"a":[6]},{"t":","}]},{"n":11,"text":"And you mourn at your end, When your flesh and your body are consumed,","tok":[{"t":"And you "},{"t":"mourn","s":["H5098"],"a":[0]},{"t":" at your end, When your "},{"t":"flesh","s":["H1320"],"a":[3]},{"t":" and your "},{"t":"body","s":["H7607"],"a":[4]},{"t":" are "},{"t":"consumed","s":["H3615"],"a":[2]},{"t":","}]},{"n":12,"text":"And you say, How I have hated instruction, And my heart has despised reproof!","tok":[{"t":"And you "},{"t":"say","s":["H0559"],"a":[0]},{"t":", How I have "},{"t":"hated","s":["H8130"],"a":[2]},{"t":" "},{"t":"instruction","s":["H4148"],"a":[3]},{"t":", And my "},{"t":"heart","s":["H3820"],"a":[6]},{"t":" has "},{"t":"despised","s":["H5006"],"a":[5]},{"t":" "},{"t":"reproof","s":["H8433"],"a":[4]},{"t":"!"}]},{"n":13,"text":"And I have not listened to the voice of my teachers Nor inclined my ear to my instructors;","tok":[{"t":"And I have not listened to the "},{"t":"voice","s":["H6963"],"a":[2]},{"t":" of my "},{"t":"teachers","s":["H3384"]},{"t":" Nor "},{"t":"inclined","s":["H5186"],"a":[6]},{"t":" my "},{"t":"ear","s":["H0241"],"a":[7]},{"t":" to my instructors;"}]},{"n":14,"text":"I was almost into every evil In the midst of the congregation and assembly.","tok":[{"t":"I was "},{"t":"almost","s":["H4592"],"a":[0]},{"t":" into every "},{"t":"evil","s":["H7451"],"a":[3]},{"t":" In the "},{"t":"midst","s":["H8432"],"a":[4]},{"t":" of the "},{"t":"congregation","s":["H6951"],"a":[5]},{"t":" and "},{"t":"assembly","s":["H5712"],"a":[6]},{"t":"."}]},{"n":15,"text":"Drink waters out of your own cistern, And running water out of your own well.","tok":[{"t":"Drink","s":["H8354"],"a":[0]},{"t":" "},{"t":"waters","s":["H4325"],"a":[1]},{"t":" out of your own "},{"t":"cistern","s":["H0953"],"a":[2]},{"t":", And running "},{"t":"water","s":["H5140"],"a":[3]},{"t":" out "},{"t":"of","s":["H8432"],"a":[4]},{"t":" your own "},{"t":"well","s":["H0875"],"a":[5]},{"t":"."}]},{"n":16,"text":"Should your springs be shed forth, Like streams of water in the streets?","tok":[{"t":"Should your springs be shed forth, Like streams of "},{"t":"water","s":["H4325"],"a":[5]},{"t":" in the "},{"t":"streets","s":["H7339"],"a":[3]},{"t":"?"}]},{"n":17,"text":"Let them be yours alone, And not for strangers with you.","tok":[{"t":"Let them be yours alone, And not for "},{"t":"strangers","s":["H2114"],"a":[4]},{"t":" with you."}]},{"n":18,"text":"Let your fountain be blessed, And rejoice in the wife of your youth,","tok":[{"t":"Let your "},{"t":"fountain","s":["H4726"],"a":[1]},{"t":" be "},{"t":"blessed","s":["H1288"],"a":[2]},{"t":", And "},{"t":"rejoice","s":["H8055"],"a":[3]},{"t":" in the "},{"t":"wife","s":["H0802"],"a":[4]},{"t":" of your "},{"t":"youth","s":["H5271"],"a":[5]},{"t":","}]},{"n":19,"text":"A lovely hind and a graceful doe. Let her breasts satisfy you at all times. May you be ravished with her love always.","tok":[{"t":"A "},{"t":"lovely","s":["H0158"],"a":[1]},{"t":" "},{"t":"hind","s":["H0365"]},{"t":" and a graceful doe. Let her "},{"t":"breasts","s":["H1717"],"a":[4]},{"t":" "},{"t":"satisfy","s":["H7301"],"a":[5]},{"t":" you at all "},{"t":"times","s":["H6256"],"a":[7]},{"t":". May you be "},{"t":"ravished","s":["H7686"],"a":[9]},{"t":" with "},{"t":"her","s":["H8548"],"a":[10]},{"t":" "},{"t":"love","s":["H0160"],"a":[8]},{"t":" "},{"t":"always","s":["H8548"],"a":[10]},{"t":"."}]},{"n":20,"text":"For why should you be ravished, my son, with a strange woman And embrace the bosom of an adulteress?","tok":[{"t":"For why should you be "},{"t":"ravished","s":["H7686"],"a":[1]},{"t":", my "},{"t":"son","s":["H1121"],"a":[2]},{"t":", with a "},{"t":"strange","s":["H7686"],"a":[1]},{"t":" "},{"t":"woman","s":["H2114"],"a":[3]},{"t":" And "},{"t":"embrace","s":["H2263"],"a":[4]},{"t":" the "},{"t":"bosom","s":["H2436"],"a":[5]},{"t":" of an "},{"t":"adulteress","s":["H5237"],"a":[6]},{"t":"?"}]},{"n":21,"text":"For the ways of a man are before the eyes of Jehovah, And He ponders all his paths.","tok":[{"t":"For the "},{"t":"ways","s":["H1870"],"a":[4]},{"t":" of a "},{"t":"man","s":["H0376"],"a":[5]},{"t":" are "},{"t":"before","s":["H5227"],"a":[1]},{"t":" the "},{"t":"eyes","s":["H5869"],"a":[2]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", And He "},{"t":"ponders","s":["H6424"],"a":[8]},{"t":" all his paths."}]},{"n":22,"text":"The wicked man is taken by his own iniquities, And he is held fast by the cords of his own sin.","tok":[{"t":"The "},{"t":"wicked","s":["H7563"],"a":[3]},{"t":" man is taken by his own "},{"t":"iniquities","s":["H5771"],"a":[0]},{"t":", And he is held fast by the "},{"t":"cords","s":["H2256"],"a":[4]},{"t":" of his own "},{"t":"sin","s":["H2403"],"a":[5]},{"t":"."}]},{"n":23,"text":"He will die for lack of instruction, And in the greatness of his folly he will go astray.","tok":[{"t":"He will "},{"t":"die","s":["H4191"],"a":[1]},{"t":" for lack of "},{"t":"instruction","s":["H4148"],"a":[3]},{"t":", And in the "},{"t":"greatness","s":["H7230"],"a":[4]},{"t":" of his "},{"t":"folly","s":["H0200"],"a":[5]},{"t":" he will go "},{"t":"astray","s":["H7686"],"a":[6]},{"t":"."}]}]}
