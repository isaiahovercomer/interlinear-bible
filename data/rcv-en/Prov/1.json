{"v":1,"book":"Prov","ch":1,"verses":[{"n":1,"text":"The proverbs of Solomon the son of David, the king of Israel:","tok":[{"t":"The "},{"t":"proverbs","s":["H4912"],"a":[0]},{"t":" of "},{"t":"Solomon","s":["H8010"],"a":[1]},{"t":" the "},{"t":"son","s":["H1121"],"a":[2]},{"t":" of "},{"t":"David","s":["H1732"],"a":[3]},{"t":", the "},{"t":"king","s":["H4428"],"a":[4]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[5]},{"t":":"}]},{"n":2,"text":"For knowing wisdom and instruction; For discerning words of understanding;","tok":[{"t":"For "},{"t":"knowing","s":["H3045"],"a":[0]},{"t":" "},{"t":"wisdom","s":["H2451"],"a":[1]},{"t":" and "},{"t":"instruction","s":["H4148"],"a":[2]},{"t":"; For "},{"t":"discerning","s":["H0995"],"a":[3]},{"t":" "},{"t":"words","s":["H0561"],"a":[4]},{"t":" of "},{"t":"understanding","s":["H0998"],"a":[5]},{"t":";"}]},{"n":3,"text":"For receiving instruction in wise conduct, Righteousness, justice, and equity;","tok":[{"t":"For "},{"t":"receiving","s":["H3947"],"a":[0]},{"t":" "},{"t":"instruction","s":["H4148"],"a":[1]},{"t":" in wise conduct, Righteousness, "},{"t":"justice","s":["H6664"],"a":[3]},{"t":", and "},{"t":"equity","s":["H4339"],"a":[5]},{"t":";"}]},{"n":4,"text":"For giving prudence to the simple, Knowledge and discretion to the young man;","tok":[{"t":"For "},{"t":"giving","s":["H5414"],"a":[0]},{"t":" "},{"t":"prudence","s":["H6195"],"a":[2]},{"t":" to the "},{"t":"simple","s":["H6612"],"a":[1]},{"t":", "},{"t":"Knowledge","s":["H1847"],"a":[4]},{"t":" and "},{"t":"discretion","s":["H4209"],"a":[5]},{"t":" to the young "},{"t":"man","s":["H5288"],"a":[3]},{"t":";"}]},{"n":5,"text":"That the wise man may hear and increase in learning, And he who has understanding may acquire sound counsel;","tok":[{"t":"That the "},{"t":"wise","s":["H2450"],"a":[1]},{"t":" man may "},{"t":"hear","s":["H8085"],"a":[0]},{"t":" and "},{"t":"increase","s":["H3254"],"a":[2]},{"t":" in "},{"t":"learning","s":["H3948"],"a":[3]},{"t":", And he who has "},{"t":"understanding","s":["H0995"],"a":[4]},{"t":" may acquire sound "},{"t":"counsel","s":["H8458"],"a":[5]},{"t":";"}]},{"n":6,"text":"For understanding proverb and figure, The words of the wise and their difficult sayings.","tok":[{"t":"For "},{"t":"understanding","s":["H0995"],"a":[0]},{"t":" "},{"t":"proverb","s":["H4912"],"a":[1]},{"t":" and "},{"t":"figure","s":["H4426"],"a":[2]},{"t":", The "},{"t":"words","s":["H1697"],"a":[3]},{"t":" of the "},{"t":"wise","s":["H2450"],"a":[4]},{"t":" and their difficult "},{"t":"sayings","s":["H2420"],"a":[5]},{"t":"."}]},{"n":7,"text":"The fear of Jehovah is the beginning of knowledge; Fools despise wisdom and instruction.","tok":[{"t":"The "},{"t":"fear","s":["H3374"],"a":[0]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" is the "},{"t":"beginning","s":["H7225"],"a":[2]},{"t":" of "},{"t":"knowledge","s":["H1847"],"a":[3]},{"t":"; "},{"t":"Fools","s":["H0191"],"a":[6]},{"t":" "},{"t":"despise","s":["H0936"],"a":[7]},{"t":" "},{"t":"wisdom","s":["H2451"],"a":[4]},{"t":" and "},{"t":"instruction","s":["H4148"],"a":[5]},{"t":"."}]},{"n":8,"text":"Hear, my son, the instruction of your father, And do not reject the teaching of your mother;","tok":[{"t":"Hear","s":["H8085"],"a":[0]},{"t":", my "},{"t":"son","s":["H1121"],"a":[1]},{"t":", the "},{"t":"instruction","s":["H4148"],"a":[2]},{"t":" of your "},{"t":"father","s":["H0001"],"a":[3]},{"t":", And do not reject the teaching of your "},{"t":"mother","s":["H0517"],"a":[7]},{"t":";"}]},{"n":9,"text":"For they will be a wreath of grace for your head And ornaments for your neck.","tok":[{"t":"For they will be a wreath of "},{"t":"grace","s":["H2580"],"a":[2]},{"t":" for your "},{"t":"head","s":["H7218"],"a":[4]},{"t":" And "},{"t":"ornaments","s":["H3880"],"a":[1]},{"t":" for your "},{"t":"neck","s":["H1621"],"a":[6]},{"t":"."}]},{"n":10,"text":"My son, if sinners entice you, Do not consent.","tok":[{"t":"My "},{"t":"son","s":["H1121"],"a":[0]},{"t":", if "},{"t":"sinners","s":["H2400"],"a":[3]},{"t":" "},{"t":"entice","s":["H6601"],"a":[2]},{"t":" you, Do not "},{"t":"consent","s":["H0014"],"a":[5]},{"t":"."}]},{"n":11,"text":"If they say, Come with us; let us lie in wait for blood; Let us ambush the innocent without cause;","tok":[{"t":"If they "},{"t":"say","s":["H0559"],"a":[1]},{"t":", "},{"t":"Come","s":["H3212"]},{"t":" with us; let us lie in "},{"t":"wait","s":["H0693"],"a":[4]},{"t":" for "},{"t":"blood","s":["H1818"],"a":[5]},{"t":"; Let us ambush the "},{"t":"innocent","s":["H5355"],"a":[7]},{"t":" without "},{"t":"cause","s":["H2600"],"a":[8]},{"t":";"}]},{"n":12,"text":"Let us swallow them alive like Sheol, And whole, like those who go down into the pit.","tok":[{"t":"Let us swallow them "},{"t":"alive","s":["H2416"],"a":[2]},{"t":" like Sheol, And "},{"t":"whole","s":["H8549"],"a":[3]},{"t":", like those who go "},{"t":"down","s":["H3381"],"a":[4]},{"t":" into the "},{"t":"pit","s":["H0953"],"a":[5]},{"t":"."}]},{"n":13,"text":"We will find all manner of precious goods; We will fill our houses with booty;","tok":[{"t":"We will "},{"t":"find","s":["H4672"],"a":[3]},{"t":" all manner of "},{"t":"precious","s":["H3368"],"a":[2]},{"t":" goods; We will "},{"t":"fill","s":["H4390"],"a":[4]},{"t":" our "},{"t":"houses","s":["H1004"],"a":[5]},{"t":" with "},{"t":"booty","s":["H7998"],"a":[6]},{"t":";"}]},{"n":14,"text":"Throw in your lot with us; We will all have one purse —","tok":[{"t":"Throw in your "},{"t":"lot","s":["H1486"],"a":[0]},{"t":" with us; We will all have "},{"t":"one","s":["H0259"],"a":[4]},{"t":" "},{"t":"purse","s":["H3599"],"a":[3]},{"t":" —"}]},{"n":15,"text":"My son, do not walk with them on this way; Keep your foot from their path.","tok":[{"t":"My "},{"t":"son","s":["H1121"],"a":[0]},{"t":", do not "},{"t":"walk","s":["H3212"]},{"t":" with them on this "},{"t":"way","s":["H1870"],"a":[3]},{"t":"; Keep your "},{"t":"foot","s":["H7272"],"a":[6]},{"t":" from their "},{"t":"path","s":["H5410"],"a":[7]},{"t":"."}]},{"n":16,"text":"For their feet run toward evil, And they hasten to shed blood.","tok":[{"t":"For their "},{"t":"feet","s":["H7272"],"a":[1]},{"t":" "},{"t":"run","s":["H7323"],"a":[3]},{"t":" toward "},{"t":"evil","s":["H7451"],"a":[2]},{"t":", And they hasten to "},{"t":"shed","s":["H8210"],"a":[5]},{"t":" "},{"t":"blood","s":["H1818"],"a":[6]},{"t":"."}]},{"n":17,"text":"For in vain is the net spread In the eyes of any bird;","tok":[{"t":"For in "},{"t":"vain","s":["H2600"],"a":[1]},{"t":" is the "},{"t":"net","s":["H7568"],"a":[3]},{"t":" "},{"t":"spread","s":["H2219"],"a":[2]},{"t":" In the eyes of any "},{"t":"bird","s":["H1167"],"a":[6]},{"t":";"}]},{"n":18,"text":"Yet they lie in wait for their own blood; They ambush their own lives!","tok":[{"t":"Yet they lie in "},{"t":"wait","s":["H0693"],"a":[2]},{"t":" for their own "},{"t":"blood","s":["H1818"],"a":[1]},{"t":"; They ambush their own "},{"t":"lives","s":["H5315"],"a":[4]},{"t":"!"}]},{"n":19,"text":"Such are the ways of everyone greedy for gain; It takes away the life of its owners.","tok":[{"t":"Such are the "},{"t":"ways","s":["H0734"],"a":[1]},{"t":" of everyone "},{"t":"greedy","s":["H1214"],"a":[3]},{"t":" for "},{"t":"gain","s":["H1215"],"a":[4]},{"t":"; It takes "},{"t":"away","s":["H3947"],"a":[8]},{"t":" the "},{"t":"life","s":["H5315"],"a":[6]},{"t":" of its "},{"t":"owners","s":["H1167"],"a":[7]},{"t":"."}]},{"n":20,"text":"Wisdom cries out in the street; She utters her voice in the open squares.","tok":[{"t":"Wisdom","s":["H2454"]},{"t":" "},{"t":"cries","s":["H7442"],"a":[2]},{"t":" out in the "},{"t":"street","s":["H7339"],"a":[3]},{"t":"; She "},{"t":"utters","s":["H5414"],"a":[4]},{"t":" her "},{"t":"voice","s":["H6963"],"a":[5]},{"t":" in the open squares."}]},{"n":21,"text":"At the head of the tumultuous street she cries; At the entrance of the gates in the city she utters her sayings:","tok":[{"t":"At the head of the tumultuous street she "},{"t":"cries","s":["H7121"],"a":[2]},{"t":"; At the entrance of the "},{"t":"gates","s":["H8179"],"a":[4]},{"t":" in the "},{"t":"city","s":["H5892"],"a":[5]},{"t":" she "},{"t":"utters","s":["H0559"],"a":[7]},{"t":" her sayings:"}]},{"n":22,"text":"How long, O simple ones, will you love simpleness, And will scoffers delight themselves in scoffing, And will fools hate knowledge?","tok":[{"t":"How long, O simple "},{"t":"ones","s":["H6612"],"a":[2]},{"t":", will you "},{"t":"love","s":["H0157"],"a":[3]},{"t":" simpleness, And will scoffers "},{"t":"delight","s":["H2530"],"a":[7]},{"t":" themselves in scoffing, And will "},{"t":"fools","s":["H3684"],"a":[9]},{"t":" "},{"t":"hate","s":["H8130"],"a":[10]},{"t":" "},{"t":"knowledge","s":["H1847"],"a":[11]},{"t":"?"}]},{"n":23,"text":"Turn yourselves at my reproof — Immediately I will pour out my spirit on you; I will make my words known to you.","tok":[{"t":"Turn","s":["H7725"],"a":[0]},{"t":" yourselves at my "},{"t":"reproof","s":["H8433"],"a":[1]},{"t":" — Immediately I will pour "},{"t":"out","s":["H5042"],"a":[3]},{"t":" my "},{"t":"spirit","s":["H7307"],"a":[5]},{"t":" on you; I will make my "},{"t":"words","s":["H1697"],"a":[7]},{"t":" "},{"t":"known","s":["H3045"],"a":[6]},{"t":" to "},{"t":"you","s":["H1697"],"a":[7]},{"t":"."}]},{"n":24,"text":"Because I called and you refused; I stretched out my hand and no one heeded,","tok":[{"t":"Because I "},{"t":"called","s":["H7121"],"a":[1]},{"t":" and you "},{"t":"refused","s":["H3985"],"a":[2]},{"t":"; I stretched "},{"t":"out","s":["H5186"],"a":[3]},{"t":" my "},{"t":"hand","s":["H3027"],"a":[4]},{"t":" and no one heeded,"}]},{"n":25,"text":"And you neglected all my counsel And would have none of my reproof;","tok":[{"t":"And you neglected all my "},{"t":"counsel","s":["H6098"],"a":[2]},{"t":" And "},{"t":"would","s":["H0014"],"a":[5]},{"t":" have none of my "},{"t":"reproof","s":["H8433"],"a":[3]},{"t":";"}]},{"n":26,"text":"I also will laugh at your calamity; I will mock when what you dread comes,","tok":[{"t":"I also will "},{"t":"laugh","s":["H7832"],"a":[3]},{"t":" at your "},{"t":"calamity","s":["H0343"],"a":[2]},{"t":"; I will "},{"t":"mock","s":["H3932"],"a":[4]},{"t":" when what you dread "},{"t":"comes","s":["H0935"],"a":[5]},{"t":","}]},{"n":27,"text":"When what you dread comes like a storm, And your calamity comes like a whirlwind, When distress and anguish come upon you.","tok":[{"t":"When what you dread "},{"t":"comes","s":["H0935"],"a":[0]},{"t":" like a storm, And your calamity "},{"t":"comes","s":["H0857"],"a":[5]},{"t":" like a "},{"t":"whirlwind","s":["H5492"],"a":[4]},{"t":", When "},{"t":"distress","s":["H6869"],"a":[8]},{"t":" and "},{"t":"anguish","s":["H6695"],"a":[9]},{"t":" "},{"t":"come","s":["H0935"],"a":[6]},{"t":" upon you."}]},{"n":28,"text":"Then they will call on me, but I will not answer; They will seek me diligently, but they will not find me.","tok":[{"t":"Then they will "},{"t":"call","s":["H7121"],"a":[1]},{"t":" on me, but I will not "},{"t":"answer","s":["H6030"],"a":[3]},{"t":"; They will seek me diligently, but they will not "},{"t":"find","s":["H4672"],"a":[6]},{"t":" me."}]},{"n":29,"text":"Because they hated knowledge And did not choose the fear of Jehovah,","tok":[{"t":"Because they "},{"t":"hated","s":["H8130"],"a":[2]},{"t":" "},{"t":"knowledge","s":["H1847"],"a":[3]},{"t":" And did not "},{"t":"choose","s":["H0977"],"a":[7]},{"t":" the "},{"t":"fear","s":["H3374"],"a":[4]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":","}]},{"n":30,"text":"And would have none of my counsel And despised all my reproof;","tok":[{"t":"And "},{"t":"would","s":["H0014"],"a":[1]},{"t":" have none of my "},{"t":"counsel","s":["H6098"],"a":[2]},{"t":" And "},{"t":"despised","s":["H5006"],"a":[3]},{"t":" all my "},{"t":"reproof","s":["H8433"],"a":[5]},{"t":";"}]},{"n":31,"text":"They shall eat of the fruit of their own way And be filled with their own devices.","tok":[{"t":"They shall "},{"t":"eat","s":["H0398"],"a":[0]},{"t":" of the "},{"t":"fruit","s":["H6529"],"a":[1]},{"t":" of their own "},{"t":"way","s":["H1870"],"a":[2]},{"t":" And be "},{"t":"filled","s":["H7646"],"a":[4]},{"t":" with their own "},{"t":"devices","s":["H4156"],"a":[3]},{"t":"."}]},{"n":32,"text":"For the turning away of the simple will kill them, And the prosperity of the foolish will cause them to perish;","tok":[{"t":"For the turning "},{"t":"away","s":["H4878"],"a":[1]},{"t":" of the "},{"t":"simple","s":["H6612"],"a":[2]},{"t":" will kill them, And the "},{"t":"prosperity","s":["H7962"],"a":[4]},{"t":" of the foolish will cause them to perish;"}]},{"n":33,"text":"But he who listens to me will dwell securely And will live at ease, without the dread of evil.","tok":[{"t":"But he who listens to me will "},{"t":"dwell","s":["H7931"],"a":[2]},{"t":" securely And will live at ease, without the dread of "},{"t":"evil","s":["H7451"],"a":[6]},{"t":"."}]}]}
