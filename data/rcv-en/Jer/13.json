0]},{"t":" and the "},{"t":"kings","s":["H4428"],"a":[13]},{"t":" who "},{"t":"sit","s":["H3427"],"a":[14]},{"t":" in "},{"t":"David’s","s":["H1732"],"a":[15]},{"t":" place on his "},{"t":"throne","s":["H3678"],"a":[17]},{"t":" and the "},{"t":"priests","s":["H3548"],"a":[19]},{"t":" and the "},{"t":"prophets","s":["H5030"],"a":[21]},{"t":" and all the "},{"t":"inhabitants","s":["H3427"],"a":[24]},{"t":" of "},{"t":"Jerusalem","s":["H3389"],"a":[25]},{"t":" with "},{"t":"drunkenness","s":["H7943"],"a":[26]},{"t":","}]},{"n":14,"text":"And I will dash them one against the other, both the fathers and the sons together, declares Jehovah; I will not spare or pity or have compassion so as not to destroy them.","tok":[{"t":"And I will "},{"t":"dash","s":["H5310"],"a":[0]},{"t":" them "},{"t":"one","s":["H0376"],"a":[1]},{"t":" against the other, both the "},{"t":"fathers","s":["H0001"],"a":[4]},{"t":" and the "},{"t":"sons","s":["H1121"],"a":[5]},{"t":" "},{"t":"together","s":["H3162"],"a":[6]},{"t":", "},{"t":"declares","s":["H5002"],"a":[7]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[8]},{"t":"; I will not "},{"t":"spare","s":["H2347"],"a":[12]},{"t":" or "},{"t":"pity","s":["H2550"],"a":[10]},{"t":" or have compassion so as not to "},{"t":"destroy","s":["H7843"],"a":[15]},{"t":" them."}]},{"n":15,"text":"Hear and give ear and do not be proud, For Jehovah has spoken.","tok":[{"t":"Hear","s":["H8085"],"a":[0]},{"t":" and give "},{"t":"ear","s":["H0238"],"a":[1]},{"t":" and do not be "},{"t":"proud","s":["H1361"],"a":[3]},{"t":", For "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":" has "},{"t":"spoken","s":["H1696"],"a":[6]},{"t":"."}]},{"n":16,"text":"Give glory to Jehovah your God, Before He brings darkness, And before your feet stumble on the twilight mountains; And you will look for light, But He will turn it into a shadow of death And make it deep darkness.","tok":[{"t":"Give","s":["H5414"],"a":[0]},{"t":" "},{"t":"glory","s":["H3519"],"a":[3]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" your "},{"t":"God","s":["H0430"],"a":[2]},{"t":", Before He brings "},{"t":"darkness","s":["H2821"],"a":[5]},{"t":", And before your "},{"t":"feet","s":["H7272"],"a":[8]},{"t":" "},{"t":"stumble","s":["H5062"],"a":[7]},{"t":" on the "},{"t":"twilight","s":["H5399"],"a":[11]},{"t":" "},{"t":"mountains","s":["H2022"],"a":[10]},{"t":"; And you will "},{"t":"look","s":["H6960"],"a":[12]},{"t":" for "},{"t":"light","s":["H0216"],"a":[13]},{"t":", But He will "},{"t":"turn","s":["H7760"],"a":[14]},{"t":" it into a shadow of "},{"t":"death","s":["H6757"],"a":[15]},{"t":" And "},{"t":"make","s":["H7896"],"a":[16]},{"t":" it deep "},{"t":"darkness","s":["H6205"],"a":[17]},{"t":"."}]},{"n":17,"text":"And if you will not hear it, My soul will weep in secret places for your pride; And my eye will weep bitterly and shed tears, Because the flock of Jehovah has been taken captive.","tok":[{"t":"And if you will not "},{"t":"hear","s":["H8085"],"a":[2]},{"t":" it, My "},{"t":"soul","s":["H5315"],"a":[5]},{"t":" will "},{"t":"weep","s":["H1058"],"a":[4]},{"t":" in secret "},{"t":"places","s":["H4565"],"a":[3]},{"t":" "},{"t":"for","s":["H6440"],"a":[6]},{"t":" your "},{"t":"pride","s":["H1466"],"a":[7]},{"t":"; And my "},{"t":"eye","s":["H5869"],"a":[11]},{"t":" will "},{"t":"weep","s":["H1830"],"a":[8]},{"t":" bitterly and shed "},{"t":"tears","s":["H1832"],"a":[12]},{"t":", "},{"t":"Because","s":["H3068"],"a":[16]},{"t":" the "},{"t":"flock","s":["H5739"],"a":[15]},{"t":" of Jehovah has been taken "},{"t":"captive","s":["H7617"],"a":[14]},{"t":"."}]},{"n":18,"text":"Say to the king and to the queen mother, Humble yourselves and sit down, For your beautiful crown Has come down from your heads.","tok":[{"t":"Say","s":["H0559"],"a":[0]},{"t":" to the "},{"t":"king","s":["H4428"],"a":[1]},{"t":" and to the "},{"t":"queen","s":["H1377"],"a":[2]},{"t":" mother, "},{"t":"Humble","s":["H8213"],"a":[3]},{"t":" yourselves and sit "},{"t":"down","s":["H3427"],"a":[4]},{"t":", For your beautiful "},{"t":"crown","s":["H5850"],"a":[8]},{"t":" Has come "},{"t":"down","s":["H3381"],"a":[6]},{"t":" from your heads."}]},{"n":19,"text":"The cities of the south have been shut up, And there is no one to open them; All Judah has been taken into exile, Wholly taken into exile.","tok":[{"t":"The "},{"t":"cities","s":["H5892"],"a":[0]},{"t":" of the "},{"t":"south","s":["H5045"],"a":[1]},{"t":" have been shut "},{"t":"up","s":["H5462"],"a":[2]},{"t":", And there is no one to "},{"t":"open","s":["H6605"],"a":[4]},{"t":" them; All "},{"t":"Judah","s":["H3063"],"a":[6]},{"t":" has been taken into exile, "},{"t":"Wholly","s":["H7965"],"a":[9]},{"t":" taken into exile."}]},{"n":20,"text":"Lift up your eyes, And see those who come from the north. Where is the flock that was given to you, Your beautiful sheep?","tok":[{"t":"Lift "},{"t":"up","s":["H5375"],"a":[0]},{"t":" your "},{"t":"eyes","s":["H5869"],"a":[1]},{"t":", And see those who "},{"t":"come","s":["H0935"],"a":[3]},{"t":" from the "},{"t":"north","s":["H6828"],"a":[4]},{"t":". Where is the "},{"t":"flock","s":["H5739"],"a":[6]},{"t":" that was "},{"t":"given","s":["H5414"],"a":[7]},{"t":" to you, Your "},{"t":"beautiful","s":["H8597"],"a":[10]},{"t":" "},{"t":"sheep","s":["H6629"],"a":[9]},{"t":"?"}]},{"n":21,"text":"What will you say when He appoints over you as head Those whom you yourself have trained to be your friends? Will not pains take hold of you, Like those of a woman in travail?","tok":[{"t":"What will you "},{"t":"say","s":["H0559"],"a":[1]},{"t":" when He appoints over you as head Those whom you yourself have trained to be your friends? Will not pains "},{"t":"take","s":["H0270"],"a":[13]},{"t":" hold of you, Like those of a "},{"t":"woman","s":["H0802"],"a":[15]},{"t":" in "},{"t":"travail","s":["H3205"],"a":[16]},{"t":"?"}]},{"n":22,"text":"And if you say in your heart, Why have these things happened to me? It is because of the greatness of your iniquity that your skirts are uncovered, That your heels suffer violence.","tok":[{"t":"And if you "},{"t":"say","s":["H0559"],"a":[1]},{"t":" in your "},{"t":"heart","s":["H3824"],"a":[2]},{"t":", Why have these things happened to me? It is because of the "},{"t":"greatness","s":["H7230"],"a":[6]},{"t":" of your "},{"t":"iniquity","s":["H5771"],"a":[7]},{"t":" that your "},{"t":"skirts","s":["H7757"],"a":[9]},{"t":" are uncovered, That your "},{"t":"heels","s":["H6119"],"a":[11]},{"t":" suffer violence."}]},{"n":23,"text":"Can the Cushite change his skin, Or the leopard his spots? Then you also may be able to do good, Who are accustomed to do evil.","tok":[{"t":"Can the Cushite "},{"t":"change","s":["H2015"],"a":[0]},{"t":" his "},{"t":"skin","s":["H5785"],"a":[2]},{"t":", Or the "},{"t":"leopard","s":["H5246"],"a":[3]},{"t":" his "},{"t":"spots","s":["H2272"],"a":[4]},{"t":"? Then you also "},{"t":"may","s":["H3201"],"a":[7]},{"t":" be able to do "},{"t":"good","s":["H3190"],"a":[8]},{"t":", Who are "},{"t":"accustomed","s":["H3928"],"a":[9]},{"t":" to do "},{"t":"evil","s":["H7489"],"a":[10]},{"t":"."}]},{"n":24,"text":"Therefore I will scatter them like chaff driven By the wind of the wilderness.","tok":[{"t":"Therefore I will "},{"t":"scatter","s":["H6327"],"a":[0]},{"t":" them like chaff driven By the "},{"t":"wind","s":["H7307"],"a":[3]},{"t":" of the "},{"t":"wilderness","s":["H4057"],"a":[4]},{"t":"."}]},{"n":25,"text":"This is your lot, The portion measured out to you from Me, Declares Jehovah, Because you have forgotten Me And have trusted in falsehood.","tok":[{"t":"This is your "},{"t":"lot","s":["H1486"],"a":[1]},{"t":", The "},{"t":"portion","s":["H4490"]},{"t":" "},{"t":"measured","s":["H4055"],"a":[3]},{"t":" out to you from Me, Declares "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":", Because you have "},{"t":"forgotten","s":["H7911"],"a":[8]},{"t":" Me And have "},{"t":"trusted","s":["H0982"],"a":[10]},{"t":" in "},{"t":"falsehood","s":["H8267"],"a":[11]},{"t":"."}]},{"n":26,"text":"I will also strip your skirts off over your head, And your shame will be seen.","tok":[{"t":"I will also strip your "},{"t":"skirts","s":["H7757"],"a":[3]},{"t":" off over your head, And your "},{"t":"shame","s":["H7036"],"a":[7]},{"t":" will be seen."}]},{"n":27,"text":"Your adulteries and your neighings, The lewdness of your fornication Upon the hills, in the field, Your detestable things — I have seen. Woe to you, O Jerusalem! How long a time will you still not be clean?","tok":[{"t":"Your","s":["H7200"],"a":[7]},{"t":" "},{"t":"adulteries","s":["H5004"],"a":[0]},{"t":" and your "},{"t":"neighings","s":["H4684"],"a":[1]},{"t":", The "},{"t":"lewdness","s":["H2154"],"a":[2]},{"t":" of your fornication Upon the "},{"t":"hills","s":["H1389"],"a":[5]},{"t":", in the "},{"t":"field","s":["H7704"],"a":[6]},{"t":", Your detestable things — I have "},{"t":"seen","s":["H7200"],"a":[7]},{"t":". "},{"t":"Woe","s":["H0188"],"a":[9]},{"t":" to you, O "},{"t":"Jerusalem","s":["H3389"],"a":[11]},{"t":"! How long a time will you still not be "},{"t":"clean","s":["H2891"],"a":[13]},{"t":"?"}]}]}
