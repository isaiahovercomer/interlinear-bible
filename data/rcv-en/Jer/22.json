},{"t":" the "},{"t":"son","s":["H1121"],"a":[6]},{"t":" of "},{"t":"Josiah","s":["H2977"],"a":[7]},{"t":", the "},{"t":"king","s":["H4428"],"a":[8]},{"t":" of "},{"t":"Judah","s":["H3063"],"a":[9]},{"t":", They will not wail for him, saying, Alas, my "},{"t":"brother","s":["H0251"],"a":[14]},{"t":"! or, "},{"t":"Alas","s":["H1945"],"a":[15]},{"t":", "},{"t":"sister","s":["H0269"],"a":[16]},{"t":"! They will not wail for him, saying, Alas, "},{"t":"lord","s":["H0113"],"a":[21]},{"t":"! or, Alas, his majesty!"}]},{"n":19,"text":"He will be buried with the burial of a donkey — Dragged and cast out Beyond the gates of Jerusalem.","tok":[{"t":"He will be "},{"t":"buried","s":["H6912"],"a":[2]},{"t":" with the "},{"t":"burial","s":["H6900"],"a":[0]},{"t":" of a donkey — Dragged and cast out "},{"t":"Beyond","s":["H1973"],"a":[5]},{"t":" the "},{"t":"gates","s":["H8179"],"a":[6]},{"t":" of "},{"t":"Jerusalem","s":["H3389"],"a":[7]},{"t":"."}]},{"n":20,"text":"Go up to Lebanon and cry out; And lift up your voice in Bashan, And cry out from Abarim, For all your lovers have been shattered.","tok":[{"t":"Go "},{"t":"up","s":["H5927"],"a":[0]},{"t":" to "},{"t":"Lebanon","s":["H3844"],"a":[1]},{"t":" and "},{"t":"cry","s":["H6817"],"a":[2]},{"t":" out; And lift "},{"t":"up","s":["H5414"],"a":[4]},{"t":" your "},{"t":"voice","s":["H6963"],"a":[5]},{"t":" in "},{"t":"Bashan","s":["H1316"],"a":[3]},{"t":", And "},{"t":"cry","s":["H6817"],"a":[6]},{"t":" out from Abarim, For all your "},{"t":"lovers","s":["H0157"],"a":[11]},{"t":" have been shattered."}]},{"n":21,"text":"I spoke to you in your prosperity; But you said, I will not listen. This has been your way from your youth, That you have not listened to My voice.","tok":[{"t":"I "},{"t":"spoke","s":["H1696"],"a":[0]},{"t":" to you in your "},{"t":"prosperity","s":["H7962"],"a":[2]},{"t":"; But you said, I will not listen. This has been your way from your "},{"t":"youth","s":["H5271"],"a":[8]},{"t":", That you have not listened to My "},{"t":"voice","s":["H6963"],"a":[12]},{"t":"."}]},{"n":22,"text":"The wind will shepherd all your shepherds, And your lovers will go into captivity; Then you will be ashamed and confounded Because of all your wickedness.","tok":[{"t":"The "},{"t":"wind","s":["H7307"],"a":[3]},{"t":" will shepherd all your shepherds, And your "},{"t":"lovers","s":["H0157"],"a":[4]},{"t":" will "},{"t":"go","s":["H3212"]},{"t":" into "},{"t":"captivity","s":["H7628"],"a":[5]},{"t":"; Then you will be "},{"t":"ashamed","s":["H0954"],"a":[9]},{"t":" and "},{"t":"confounded","s":["H3637"],"a":[10]},{"t":" Because of all your "},{"t":"wickedness","s":["H7451"],"a":[12]},{"t":"."}]},{"n":23,"text":"O inhabitant of Lebanon, Nested among the cedars, How you will be pitied when pains come to you, Anguish like that of a woman giving birth.","tok":[{"t":"O "},{"t":"inhabitant","s":["H3427"],"a":[0]},{"t":" of "},{"t":"Lebanon","s":["H3844"],"a":[1]},{"t":", "},{"t":"Nested","s":["H7077"],"a":[2]},{"t":" among the "},{"t":"cedars","s":["H0730"],"a":[3]},{"t":", How you will be pitied when "},{"t":"pains","s":["H2427"],"a":[9]},{"t":" "},{"t":"come","s":["H0935"],"a":[6]},{"t":" to you, Anguish like that of a woman giving birth."}]},{"n":24,"text":"As I live, declares Jehovah, Even though Coniah the son of Jehoiakim, the king of Judah, were a signet ring on My right hand, yet I would tear you off,","tok":[{"t":"As I "},{"t":"live","s":["H2416"],"a":[0]},{"t":", "},{"t":"declares","s":["H5002"],"a":[2]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", Even though "},{"t":"Coniah","s":["H3659"],"a":[7]},{"t":" the "},{"t":"son","s":["H1121"],"a":[8]},{"t":" of "},{"t":"Jehoiakim","s":["H3079"],"a":[9]},{"t":", the "},{"t":"king","s":["H4428"],"a":[10]},{"t":" of "},{"t":"Judah","s":["H3063"],"a":[11]},{"t":", were a "},{"t":"signet","s":["H2368"],"a":[12]},{"t":" ring on My "},{"t":"right","s":["H3225"],"a":[15]},{"t":" "},{"t":"hand","s":["H3027"],"a":[14]},{"t":", yet I would tear you off,"}]},{"n":25,"text":"And I would give you into the hand of those who seek your life and into the hand of those whom you fear, even into the hand of Nebuchadrezzar the king of Babylon, and into the hand of the Chaldeans.","tok":[{"t":"And I would "},{"t":"give","s":["H5414"],"a":[0]},{"t":" you into the "},{"t":"hand","s":["H3027"],"a":[1]},{"t":" of those who "},{"t":"seek","s":["H1245"],"a":[2]},{"t":" your "},{"t":"life","s":["H5315"],"a":[3]},{"t":" and into the "},{"t":"hand","s":["H3027"],"a":[4]},{"t":" of those whom you "},{"t":"fear","s":["H3016"],"a":[7]},{"t":", even into the "},{"t":"hand","s":["H3027"],"a":[9]},{"t":" of "},{"t":"Nebuchadrezzar","s":["H5019"],"a":[10]},{"t":" the "},{"t":"king","s":["H4428"],"a":[11]},{"t":" of "},{"t":"Babylon","s":["H0894"],"a":[12]},{"t":", and into the "},{"t":"hand","s":["H3027"],"a":[13]},{"t":" of the "},{"t":"Chaldeans","s":["H3778"],"a":[14]},{"t":"."}]},{"n":26,"text":"I will cast you and your mother who bore you far away into another land where you were not born, and there you will die.","tok":[{"t":"I will cast you and your "},{"t":"mother","s":["H0517"],"a":[3]},{"t":" who bore you far away into "},{"t":"another","s":["H0312"],"a":[8]},{"t":" land where you were not "},{"t":"born","s":["H3205"],"a":[11]},{"t":", and there you will "},{"t":"die","s":["H4191"],"a":[14]},{"t":"."}]},{"n":27,"text":"But to the land to which they desire to return, they will not return.","tok":[{"t":"But to the "},{"t":"land","s":["H0776"],"a":[1]},{"t":" to which they "},{"t":"desire","s":["H5375"],"a":[4]},{"t":" to "},{"t":"return","s":["H7725"],"a":[7]},{"t":", they will not "},{"t":"return","s":["H7725"],"a":[11]},{"t":"."}]},{"n":28,"text":"Is this man Coniah a despised, shattered container? Or is he a vessel no one delights in? Why are he and his seed thrown away And cast into a land which they do not know?","tok":[{"t":"Is this "},{"t":"man","s":["H0376"],"a":[3]},{"t":" "},{"t":"Coniah","s":["H3659"],"a":[5]},{"t":" a "},{"t":"despised","s":["H0959"],"a":[1]},{"t":", shattered container? Or is he a "},{"t":"vessel","s":["H3627"],"a":[7]},{"t":" no one delights in? Why are he and his "},{"t":"seed","s":["H2233"],"a":[14]},{"t":" thrown away And "},{"t":"cast","s":["H2904"],"a":[12]},{"t":" into a "},{"t":"land","s":["H0776"],"a":[17]},{"t":" which they do not "},{"t":"know","s":["H3045"],"a":[20]},{"t":"?"}]},{"n":29,"text":"O land, land, land, Hear the word of Jehovah:","tok":[{"t":"O land, land, land, "},{"t":"Hear","s":["H8085"],"a":[3]},{"t":" the "},{"t":"word","s":["H1697"],"a":[4]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":":"}]},{"n":30,"text":"Thus says Jehovah, Write down this man as childless, A man who will not prosper in his days; For none of his seed will prosper By sitting on the throne of David Or by ruling again in Judah.","tok":[{"t":"Thus "},{"t":"says","s":["H0559"],"a":[1]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":", "},{"t":"Write","s":["H3789"],"a":[3]},{"t":" down this "},{"t":"man","s":["H0376"],"a":[5]},{"t":" as "},{"t":"childless","s":["H6185"],"a":[7]},{"t":", A "},{"t":"man","s":["H1397"],"a":[8]},{"t":" who will not "},{"t":"prosper","s":["H6743"],"a":[10]},{"t":" in his "},{"t":"days","s":["H3117"],"a":[11]},{"t":"; For none of his "},{"t":"seed","s":["H2233"],"a":[15]},{"t":" will "},{"t":"prosper","s":["H6743"],"a":[14]},{"t":" By "},{"t":"sitting","s":["H3427"],"a":[17]},{"t":" on the "},{"t":"throne","s":["H3678"],"a":[19]},{"t":" of "},{"t":"David","s":["H1732"],"a":[20]},{"t":" Or by "},{"t":"ruling","s":["H4910"],"a":[21]},{"t":" again in "},{"t":"Judah","s":["H3063"],"a":[23]},{"t":"."}]}]}
