{"v":1,"book":"Jer","ch":22,"verses":[{"n":1,"text":"Thus says Jehovah, Go down to the house of the king of Judah, and speak this word there,","tok":[{"t":"Thus "},{"t":"says","s":["H0559"],"a":[1]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":", Go "},{"t":"down","s":["H3381"],"a":[3]},{"t":" to the "},{"t":"house","s":["H1004"],"a":[4]},{"t":" of the "},{"t":"king","s":["H4428"],"a":[5]},{"t":" of "},{"t":"Judah","s":["H3063"],"a":[6]},{"t":", and "},{"t":"speak","s":["H1696"],"a":[7]},{"t":" this "},{"t":"word","s":["H1697"],"a":[10]},{"t":" there,"}]},{"n":2,"text":"And say, Hear the word of Jehovah, O king of Judah, who sits on the throne of David, you and your servants and your people, who enter through these gates:","tok":[{"t":"And "},{"t":"say","s":["H0559"],"a":[0]},{"t":", "},{"t":"Hear","s":["H8085"],"a":[1]},{"t":" the "},{"t":"word","s":["H1697"],"a":[2]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", O "},{"t":"king","s":["H4428"],"a":[4]},{"t":" of "},{"t":"Judah","s":["H3063"],"a":[5]},{"t":", who "},{"t":"sits","s":["H3427"],"a":[6]},{"t":" on the "},{"t":"throne","s":["H3678"],"a":[8]},{"t":" of "},{"t":"David","s":["H1732"],"a":[9]},{"t":", you and your "},{"t":"servants","s":["H5650"],"a":[11]},{"t":" and your "},{"t":"people","s":["H5971"],"a":[12]},{"t":", who "},{"t":"enter","s":["H0935"],"a":[13]},{"t":" through these "},{"t":"gates","s":["H8179"],"a":[14]},{"t":":"}]},{"n":3,"text":"Thus says Jehovah, Execute judgment and righteousness, and deliver him who has been robbed from the hand of the oppressor, and do no wrong, do no violence, to the sojourner, the orphan, or the widow; nor shed innocent blood in this place.","tok":[{"t":"Thus "},{"t":"says","s":["H0559"],"a":[1]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":", "},{"t":"Execute","s":["H6213"],"a":[3]},{"t":" "},{"t":"judgment","s":["H4941"],"a":[4]},{"t":" and "},{"t":"righteousness","s":["H6666"],"a":[5]},{"t":", and "},{"t":"deliver","s":["H5337"],"a":[6]},{"t":" him who has been robbed from the "},{"t":"hand","s":["H3027"],"a":[8]},{"t":" of the "},{"t":"oppressor","s":["H6216"],"a":[9]},{"t":", and do no "},{"t":"wrong","s":["H3238"],"a":[14]},{"t":", do no "},{"t":"violence","s":["H2554"],"a":[16]},{"t":", to the sojourner, the orphan, or the "},{"t":"widow","s":["H0490"],"a":[12]},{"t":"; nor "},{"t":"shed","s":["H8210"],"a":[20]},{"t":" "},{"t":"innocent","s":["H5355"],"a":[18]},{"t":" "},{"t":"blood","s":["H1818"],"a":[17]},{"t":" in this "},{"t":"place","s":["H4725"],"a":[21]},{"t":"."}]},{"n":4,"text":"For if you indeed do this thing, then kings sitting in David’s place on his throne, riding in chariots and on horses — the king and his servants and his people will come through the gates of this house;","tok":[{"t":"For if you "},{"t":"indeed","s":["H6213"],"a":[3]},{"t":" "},{"t":"do","s":["H6213"],"a":[2]},{"t":" this "},{"t":"thing","s":["H1697"],"a":[5]},{"t":", then "},{"t":"kings","s":["H4428"],"a":[11]},{"t":" "},{"t":"sitting","s":["H3427"],"a":[12]},{"t":" "},{"t":"in","s":["H0935"],"a":[7]},{"t":" David’s place on his "},{"t":"throne","s":["H3678"],"a":[15]},{"t":", "},{"t":"riding","s":["H7392"],"a":[16]},{"t":" in "},{"t":"chariots","s":["H7393"],"a":[17]},{"t":" and on "},{"t":"horses","s":["H5483"],"a":[18]},{"t":" — the king and his "},{"t":"servants","s":["H5650"],"a":[20]},{"t":" and his "},{"t":"people","s":["H5971"],"a":[21]},{"t":" will come through the "},{"t":"gates","s":["H8179"],"a":[8]},{"t":" of this "},{"t":"house","s":["H1004"],"a":[9]},{"t":";"}]},{"n":5,"text":"But if you do not listen to these things, I swear by Myself, declares Jehovah, that this house will become a ruin.","tok":[{"t":"But if you do not listen to these things, I "},{"t":"swear","s":["H7650"],"a":[7]},{"t":" by Myself, declares "},{"t":"Jehovah","s":["H3068"],"a":[9]},{"t":", that this "},{"t":"house","s":["H1004"],"a":[13]},{"t":" will become a ruin."}]},{"n":6,"text":"For thus says Jehovah concerning the ho