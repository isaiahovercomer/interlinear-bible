"t":"judgment","s":["H4941"],"a":[7]},{"t":" every "},{"t":"morning","s":["H1242"],"a":[6]},{"t":", And "},{"t":"deliver","s":["H5337"],"a":[8]},{"t":" him who has been robbed from the "},{"t":"hand","s":["H3027"],"a":[10]},{"t":" of the "},{"t":"oppressor","s":["H6231"],"a":[11]},{"t":", Lest My wrath go forth like "},{"t":"fire","s":["H0784"],"a":[14]},{"t":" And "},{"t":"burn","s":["H1197"],"a":[16]},{"t":", and there be no one to extinguish it, "},{"t":"Because","s":["H6440"],"a":[19]},{"t":" of the "},{"t":"evil","s":["H7455"],"a":[20]},{"t":" of your deeds."}]},{"n":13,"text":"Indeed, I am against you, O inhabitant of the valley, O rock of the plateau, declares Jehovah, Those who say, Who will come down against us, And who will enter into our habitations?","tok":[{"t":"Indeed, I am against you, O "},{"t":"inhabitant","s":["H3427"],"a":[2]},{"t":" of the "},{"t":"valley","s":["H6010"],"a":[3]},{"t":", O "},{"t":"rock","s":["H6697"],"a":[4]},{"t":" of the plateau, declares "},{"t":"Jehovah","s":["H3068"],"a":[7]},{"t":", Those who "},{"t":"say","s":["H0559"],"a":[8]},{"t":", Who will come "},{"t":"down","s":["H5181"],"a":[10]},{"t":" against us, And who will "},{"t":"enter","s":["H0935"],"a":[13]},{"t":" into our "},{"t":"habitations","s":["H4585"],"a":[14]},{"t":"?"}]},{"n":14,"text":"But I will punish you according to the fruit of your deeds, Declares Jehovah, And I will kindle a fire in her forest, And it will devour all that is around her.","tok":[{"t":"But I will "},{"t":"punish","s":["H6485"],"a":[0]},{"t":" you according to the "},{"t":"fruit","s":["H6529"],"a":[2]},{"t":" of your deeds, Declares "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":", And I will "},{"t":"kindle","s":["H3341"],"a":[6]},{"t":" a "},{"t":"fire","s":["H0784"],"a":[7]},{"t":" in her "},{"t":"forest","s":["H3293"],"a":[8]},{"t":", And it will "},{"t":"devour","s":["H0398"],"a":[9]},{"t":" all that is around her."}]}]}
