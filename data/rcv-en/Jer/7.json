{"v":1,"book":"Jer","ch":7,"verses":[{"n":1,"text":"The word that came to Jeremiah from Jehovah, saying,","tok":[{"t":"The "},{"t":"word","s":["H1697"],"a":[0]},{"t":" that came to "},{"t":"Jeremiah","s":["H3414"],"a":[4]},{"t":" from "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":", "},{"t":"saying","s":["H0559"],"a":[7]},{"t":","}]},{"n":2,"text":"Stand in the gate of the house of Jehovah, and proclaim this word there and say, Hear the word of Jehovah, all Judah, who enter through these gates to worship Jehovah.","tok":[{"t":"Stand","s":["H5975"],"a":[0]},{"t":" in the "},{"t":"gate","s":["H8179"],"a":[1]},{"t":" of the "},{"t":"house","s":["H1004"],"a":[2]},{"t":" of Jehovah, and "},{"t":"proclaim","s":["H7121"],"a":[4]},{"t":" this "},{"t":"word","s":["H1697"],"a":[7]},{"t":" there and "},{"t":"say","s":["H0559"],"a":[9]},{"t":", "},{"t":"Hear","s":["H8085"],"a":[10]},{"t":" the "},{"t":"word","s":["H1697"],"a":[11]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[12]},{"t":", all "},{"t":"Judah","s":["H3063"],"a":[14]},{"t":", who enter through these "},{"t":"gates","s":["H8179"],"a":[16]},{"t":" to "},{"t":"worship","s":["H7812"],"a":[18]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[19]},{"t":"."}]},{"n":3,"text":"Thus says Jehovah of hosts, the God of Israel, Amend your ways and your deeds, and I will cause you to dwell in this place.","tok":[{"t":"Thus "},{"t":"says","s":["H0559"],"a":[1]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[3]},{"t":", the "},{"t":"God","s":["H0430"],"a":[4]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[5]},{"t":", "},{"t":"Amend","s":["H3190"],"a":[6]},{"t":" your "},{"t":"ways","s":["H1870"],"a":[7]},{"t":" and your deeds, and I will cause you to "},{"t":"dwell","s":["H7931"],"a":[9]},{"t":" in this "},{"t":"place","s":["H4725"],"a":[11]},{"t":"."}]},{"n":4,"text":"Do not trust in the words of falsehood that say, The temple of Jehovah, the temple of Jehovah, these buildings are the temple of Jehovah.","tok":[{"t":"Do not "},{"t":"trust","s":["H0982"],"a":[1]},{"t":" in the "},{"t":"words","s":["H1697"],"a":[4]},{"t":" of falsehood that "},{"t":"say","s":["H0559"],"a":[6]},{"t":", The "},{"t":"temple","s":["H1964"],"a":[7]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[8]},{"t":", the "},{"t":"temple","s":["H1964"],"a":[9]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":", these buildings are the "},{"t":"temple","s":["H1964"],"a":[11]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[12]},{"t":"."}]},{"n":5,"text":"But if you truly amend your ways and your deeds, if you truly execute justice between a man and his neighbor,","tok":[{"t":"But if you truly "},{"t":"amend","s":["H3190"],"a":[3]},{"t":" your "},{"t":"ways","s":["H1870"],"a":[5]},{"t":" and your deeds, if you truly "},{"t":"execute","s":["H6213"],"a":[10]},{"t":" justice between a "},{"t":"man","s":["H0376"],"a":[13]},{"t":" and his neighbor,"}]},{"n":6,"text":"If you do not oppress the sojourner, the orphan, and the widow, and do not shed innocent blood in this place, nor go after other gods to your own ruin;","tok":[{"t":"If you do not "},{"t":"oppress","s":["H6231"],"a":[4]},{"t":" the sojourner, the orphan, and the "},{"t":"widow","s":["H0490"],"a":[2]},{"t":", and do not "},{"t":"shed","s":["H8210"],"a":[8]},{"t":" "},{"t":"innocent","s":["H5355"],"a":[6]},{"t":" "},{"t":"blood","s":["H1818"],"a":[5]},{"t":" in this "},{"t":"place","s":["H4725"],"a":[9]},{"t":", nor go "},{"t":"after","s":["H0310"],"a":[11]},{"t":" "},{"t":"other","s":["H0312"],"a":[13]},{"t":" "},{"t":"gods","s":["H0430"],"a":[12]},{"t":" to your own ruin;"}]},{"n":7,"text":"Then I will cause you to dwell in this place, in the land which I gave to your fathers from eternity to eternity.","tok":[{"t":"Then I will cause you to "},{"t":"dwell","s":["H7931"],"a":[0]},{"t":" in this "},{"t":"place","s":["H4725"],"a":[2]},{"t":", in the "},{"t":"land","s":["H0776"],"a":[4]},{"t":" which I "},{"t":"gave","s":["H5414"],"a":[6]},{"t":" to your "},{"t":"fathers","s":["H0001"],"a":[7]},{"t":" from eternity to eternity."}]},{"n":8,"text":"See, you are trusting in words of falsehood that do not benefit you.","tok":[{"t":"See, you are "},{"t":"trusting","s":["H0982"],"a":[2]},{"t":" in "},{"t":"words","s":["H1697"],"a":[5]},{"t":" of falsehood that do not benefit you."}]},{"n":9,"text":"Will you steal, murder, and commit adultery, and swear falsely, and burn incense to Baal and go after other gods which you have not known,","tok":[{"t":"Will you "},{"t":"steal","s":["H1589"],"a":[0]},{"t":", "},{"t":"murder","s":["H7523"],"a":[1]},{"t":", and commit "},{"t":"adultery","s":["H5003"],"a":[2]},{"t":", and "},{"t":"swear","s":["H7650"],"a":[3]},{"t":" "},{"t":"falsely","s":["H8267"],"a":[4]},{"t":", and burn "},{"t":"incense","s":["H6999"],"a":[5]},{"t":" to "},{"t":"Baal","s":["H1168"],"a":[6]},{"t":" and "},{"t":"go","s":["H1980"],"a":[7]},{"t":" "},{"t":"after","s":["H0310"],"a":[8]},{"t":" "},{"t":"other","s":["H0312"],"a":[10]},{"t":" "},{"t":"gods","s":["H0430"],"a":[9]},{"t":" which you have not known,"}]},{"n":10,"text":"Then come and stand before Me in this house, which is called by My name, and say, We are delivered! — that you may do all these abominations?","tok":[{"t":"Then "},{"t":"come","s":["H0935"],"a":[0]},{"t":" and "},{"t":"stand","s":["H5975"],"a":[1]},{"t":" "},{"t":"before","s":["H6440"],"a":[2]},{"t":" Me in this "},{"t":"house","s":["H1004"],"a":[3]},{"t":", which is "},{"t":"called","s":["H7121"],"a":[6]},{"t":" by My "},{"t":"name","s":["H8034"],"a":[7]},{"t":", and "},{"t":"say","s":["H0559"],"a":[9]},{"t":", We are "},{"t":"delivered","s":["H5337"],"a":[10]},{"t":"! — that you may "},{"t":"do","s":["H6213"],"a":[12]},{"t":" all these "},{"t":"abominations","s":["H8441"],"a":[15]},{"t":"?"}]},{"n":11,"text":"Has this house which is called by My name become a den of robbers in your eyes? Yet I, even I, have seen it, declares Jehovah.","tok":[{"t":"Has th