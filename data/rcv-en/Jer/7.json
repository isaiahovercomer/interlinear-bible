rings","s":["H5930"],"a":[14]},{"t":" and "},{"t":"sacrifices","s":["H2077"],"a":[15]},{"t":"."}]},{"n":23,"text":"But this is what I commanded them, saying, Hear My voice, and I will be your God, and you will be My people; and walk in all the way which I command you, that it may go well with you.","tok":[{"t":"But this is what I "},{"t":"commanded","s":["H6680"],"a":[5]},{"t":" them, "},{"t":"saying","s":["H0559"],"a":[7]},{"t":", Hear My "},{"t":"voice","s":["H6963"],"a":[9]},{"t":", and I will be your "},{"t":"God","s":["H0430"],"a":[12]},{"t":", and you will be My "},{"t":"people","s":["H5971"],"a":[16]},{"t":"; and "},{"t":"walk","s":["H1980"],"a":[17]},{"t":" in all the "},{"t":"way","s":["H1870"],"a":[19]},{"t":" which I "},{"t":"command","s":["H6680"],"a":[21]},{"t":" you, that it may go "},{"t":"well","s":["H3190"],"a":[24]},{"t":" with you."}]},{"n":24,"text":"But they did not listen or incline their ear, but walked in the counsels and the stubbornness of their evil hearts and went backward and not forward.","tok":[{"t":"But they did not listen or "},{"t":"incline","s":["H5186"],"a":[3]},{"t":" their "},{"t":"ear","s":["H0241"],"a":[5]},{"t":", but "},{"t":"walked","s":["H3212"]},{"t":" in the "},{"t":"counsels","s":["H4156"],"a":[7]},{"t":" and the stubbornness of their "},{"t":"evil","s":["H7451"],"a":[10]},{"t":" "},{"t":"hearts","s":["H3820"],"a":[9]},{"t":" and went "},{"t":"backward","s":["H0268"],"a":[12]},{"t":" and not "},{"t":"forward","s":["H6440"],"a":[14]},{"t":"."}]},{"n":25,"text":"From the day that your fathers came out from the land of Egypt unto this day I have sent to you all My servants the prophets, daily rising up early and sending them.","tok":[{"t":"From the "},{"t":"day","s":["H3117"],"a":[1]},{"t":" that your "},{"t":"fathers","s":["H0001"],"a":[4]},{"t":" came "},{"t":"out","s":["H3318"],"a":[3]},{"t":" from the "},{"t":"land","s":["H0776"],"a":[5]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[6]},{"t":" unto this "},{"t":"day","