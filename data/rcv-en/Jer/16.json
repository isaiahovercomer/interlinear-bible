{"v":1,"book":"Jer","ch":16,"verses":[{"n":1,"text":"The word of Jehovah also came to me, saying,","tok":[{"t":"The "},{"t":"word","s":["H1697"],"a":[1]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" also came to me, "},{"t":"saying","s":["H0559"],"a":[4]},{"t":","}]},{"n":2,"text":"You shall not take a wife for yourself nor have sons or daughters in this place.","tok":[{"t":"You shall not "},{"t":"take","s":["H3947"],"a":[1]},{"t":" a "},{"t":"wife","s":["H0802"],"a":[3]},{"t":" for yourself nor have "},{"t":"sons","s":["H1121"],"a":[7]},{"t":" or "},{"t":"daughters","s":["H1323"],"a":[8]},{"t":" in this "},{"t":"place","s":["H4725"],"a":[9]},{"t":"."}]},{"n":3,"text":"For thus says Jehovah concerning the sons and daughters who are born in this place and concerning their mothers who bear them and concerning their fathers who beget them in this land:","tok":[{"t":"For thus "},{"t":"says","s":["H0559"],"a":[2]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" concerning the "},{"t":"sons","s":["H1121"],"a":[5]},{"t":" and "},{"t":"daughters","s":["H1323"],"a":[7]},{"t":" who are "},{"t":"born","s":["H3205"],"a":[13]},{"t":" in this "},{"t":"place","s":["H4725"],"a":[9]},{"t":" and concerning their "},{"t":"mothers","s":["H0517"],"a":[12]},{"t":" who bear them and concerning their "},{"t":"fathers","s":["H0001"],"a":[16]},{"t":" who "},{"t":"beget","s":["H3209"],"a":[8]},{"t":" them in this "},{"t":"land","s":["H0776"],"a":[19]},{"t":":"}]},{"n":4,"text":"They will die grievous deaths and will not be mourned or buried; they will be as dung on the surface of the ground and will be consumed by sword and by famine, and their corpses will become food for the birds of the sky and the beasts of the earth.","tok":[{"t":"They will "},{"t":"die","s":["H4191"],"a":[2]},{"t":" "},{"t":"grievous","s":["H8463"],"a":[1]},{"t":" "},{"t":"deaths","s":["H4463"],"a":[0]},{"t":" and will not be mourned or "},{"t":"buried","s":["H6912"],"a":[6]},{"t":"; they will be as "},{"t":"dung","s":["H1828"],"a":[7]},{"t":" on the surface of the ground and will be "},{"t":"consumed","s":["H3615"],"a":[14]},{"t":" by "},{"t":"sword","s":["H2719"],"a":[12]},{"t":" and by "},{"t":"famine","s":["H7458"],"a":[13]},{"t":", and their corpses will become food for the birds of the sky and the "},{"t":"beasts","s":["H0929"],"a":[20]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[21]},{"t":"."}]},{"n":5,"text":"For thus says Jehovah, Do not enter the house of mourning, and do not go to mourn, and do not lament for them, for I have taken away My peace from this people, declares Jehovah, My lovingkindness and compassions.","tok":[{"t":"For thus "},{"t":"says","s":["H0559"],"a":[2]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", Do not "},{"t":"enter","s":["H0935"],"a":[5]},{"t":" the "},{"t":"house","s":["H1004"],"a":[6]},{"t":" of "},{"t":"mourning","s":["H4798"],"a":[7]},{"t":", and do not "},{"t":"go","s":["H3212"]},{"t":" to mourn, and do not "},{"t":"lament","s":["H5594"],"a":[10]},{"t":" for them, for I have taken "},{"t":"away","s":["H0622"],"a":[15]},{"t":" My "},{"t":"peace","s":["H7965"],"a":[17]},{"t":" from this "},{"t":"people","s":["H5971"],"a":[19]},{"t":", "},{"t":"declares","s":["H5002"],"a":[21]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[22]},{"t":", My "},{"t":"lovingkindness","s":["H2617"],"a":[24]},{"t":" and "},{"t":"compassions","s":["H7356"],"a":[26]},{"t":"."}]},{"n":6,"text":"Both the great and the small will die in this land; they will not be buried, nor will they be mourned; and no one will cut himself or make himself bald for them.","tok":[{"t":"Both the "},{"t":"great","s":["H1419"],"a":[1]},{"t":" and the "},{"t":"small","s":["H6996"],"a":[2]},{"t":" will "},{"t":"die","s":["H4191"],"a":[0]},{"t":" in this "},{"t":"land","s":["H0776"],"a":[3]},{"t":"; they will not be "},{"t":"buried","s":["H6912"],"a":[6]},{"t":", nor will they be mourned; and no one will "},{"t":"cut","s":["H1413"],"a":[11]},{"t":" himself or make himself "},{"t":"bald","s":["H7139"],"a":[13]},{"t":" for them."}]},{"n":7,"text":"Nor will they break bread for them in mourning to comfort anyone for the dead or give them a cup of consolation to drink for his father or for his mother.","tok":[{"t":"Nor will they break bread for them in "},{"t":"mourning","s":["H0060"],"a":[4]},{"t":" to "},{"t":"comfort","s":["H5162"],"a":[5]},{"t":" anyone for the "},{"t":"dead","s":["H4191"],"a":[7]},{"t":" or give them a "},{"t":"cup","s":["H3563"],"a":[11]},{"t":" of "},{"t":"consolation","s":["H8575"],"a":[12]},{"t":" to "},{"t":"drink","s":["H8248"],"a":[9]},{"t":" for his "},{"t":"father","s":["H0001"],"a":[14]},{"t":" or for his "},{"t":"mother","s":["H0517"],"a":[16]},{"t":"."}]},{"n":8,"text":"And you shall not enter the house of feasting to sit with them and eat and drink.","tok":[{"t":"And you shall not enter the "},{"t":"house","s":["H1004"],"a":[0]},{"t":" of "},{"t":"feasting","s":["H4960"],"a":[1]},{"t":" to "},{"t":"sit","s":["H3427"],"a":[4]},{"t":" with them and "},{"t":"eat","s":["H0398"],"a":[6]},{"t":" and "},{"t":"drink","s":["H8354"],"a":[7]},{"t":"."}]},{"n":9,"text":"For thus says Jehovah of hosts, the God of Israel, I will cause to cease from this place, before your eyes and in your days, the voice of gladness and the voice of joy, the voice of the bridegroom and the voice of the bride.","tok":[{"t":"For thus "},{"t":"says","s":["H0559"],"a":[2]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[4]},{"t":", the "},{"t":"God","s":["H0430"],"a":[5]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[6]},{"t":", I will cause to "},{"t":"cease","s":["H7673"],"a":[8]},{"t":" from this "},{"t":"place","s":["H4725"],"a":[10]},{"t":", before your "},{"t":"eyes","s":["H5869"],"a":[12]},{"t":" and in your "},{"t":"days","s":["H3117"],"a":[13]},{"t":", the "},{"t":"voice","s":["H6963"],"a":[14]},{"t":" of "},{"t":"gladness","s":["H8057"],"a":[17]},{"t":" and the "},{"t":"voice","s":["H6963"],"a":[16]},{"t":" of "},{"t":"joy","s":["H8057"],"a":[17]},{"t":", the "},{"t":"voice","s":["H6963"],"a":[18]},{"t":" of the "},{"t":"bridegroom","s":["H2860"],"a":[19]},{"t":" and the "},{"t":"voice","s":["H6963"],"a":[20]},{"t":" of the "},{"t":"bride","s":["H3618"],"a":[21]},{"t":"."}]},{"n":10,"text":"And when you tell this people all these words and they say to you, Why has Jehovah pronounced all this great evil against us? And what is our iniquity? And what is our sin which we have sinned against Jehovah our God?","tok":[{"t":"And when you tell this "},{"t":"people","s":["H5971"],"a":[3]},{"t":" all these "},{"t":"words","s":["H1697"],"a":[7]},{"t":" and they "},{"t":"say","s":["H0559"],"a":[9]},{"t":" to you, Why has "},{"t":"Jehovah","s":["H3068"],"a":[14]},{"t":" "},{"t":"pronounced","s":["H1696"],"a":[13]},{"t":" all this "},{"t":"great","s":["H1419"],"a":[19]},{"t":" "},{"t":"evil","s":["H7451"],"a":[18]},{"t":" against us? And what is our "},{"t":"iniquity","s":["H5771"],"a":[22]},{"t":"? And what is our "},{"t":"sin","s":["H2403"],"a":[24]},{"t":" which we have sinned against "},{"t":"Jehovah","s":["H3068"],"a":[27]},{"t":" our "},{"t":"God","s":["H0430"],"a":[28]},{"t":"?"}]},{"n":11,"text":"Then you shall say to them, Because your fathers have forsaken Me, declares Jehovah, and they have gone after other gods to serve them and to worship them; but Me they have forsaken, and My law they have not kept.","tok":[{"t":"Then you shall "},{"t":"say","s":["H0559"],"a":[0]},{"t":" to them, Because your "},{"t":"fathers","s":["H0001"],"a":[5]},{"t":" have "},{"t":"forsaken","s":["H5800"],"a":[4]},{"t":" Me, declares "},{"t":"Jehovah","s":["H3068"],"a":[8]},{"t":", and they have gone "},{"t":"after","s":["H0310"],"a":[10]},{"t":" "},{"t":"other","s":["H0312"],"a":[12]},{"t":" "},{"t":"gods","s":["H0430"],"a":[11]},{"t":" to "},{"t":"serve","s":["H5647"],"a":[13]},{"t":" them and to worship them; but Me they have "},{"t":"forsaken","s":["H5800"],"a":[17]},{"t":", and "},{"t":"My","s":["H8104"],"a":[21]},{"t":" "},{"t":"law","s":["H8451"],"a":[19]},{"t":" they have not "},{"t":"kept","s":["H8104"],"a":[21]},{"t":"."}]},{"n":12,"text":"And you have done more evil than your fathers; for indeed, you go about, each one after the stubbornness of his evil heart, without listening to Me.","tok":[{"t":"And you have "},{"t":"done","s":["H6213"],"a":[2]},{"t":" more evil than your "},{"t":"fathers","s":["H0001"],"a":[3]},{"t":"; for indeed, you go about, each "},{"t":"one","s":["H0376"],"a":[6]},{"t":" "},{"t":"after","s":["H0310"],"a":[7]},{"t":" the stubbornness of his "},{"t":"evil","s":["H7451"],"a":[10]},{"t":" "},{"t":"heart","s":["H3820"],"a":[9]},{"t":", without "},{"t":"listening","s":["H8085"],"a":[12]},{"t":" to Me."}]},{"n":13,"text":"And I will cast you far away from this land into a land which you have not known, neither you nor your fathers; and there you will serve other gods day and night, for I will not show favor to you.","tok":[{"t":"And I will "},{"t":"cast","s":["H2904"],"a":[0]},{"t":" you far away from this "},{"t":"land","s":["H0776"],"a":[3]},{"t":" into a "},{"t":"land","s":["H0776"],"a":[6]},{"t":" which you have not known, neither you nor your "},{"t":"fathers","s":["H0001"],"a":[11]},{"t":"; and there you will "},{"t":"serve","s":["H5647"],"a":[12]},{"t":" "},{"t":"other","s":["H0312"],"a":[16]},{"t":" "},{"t":"gods","s":["H0430"],"a":[15]},{"t":" "},{"t":"day","s":["H3119"],"a":[17]},{"t":" and "},{"t":"night","s":["H3915"],"a":[18]},{"t":", for I will not show favor to you."}]},{"n":14,"text":"Therefore indeed, days are coming, declares Jehovah, when it will no longer be said, As Jehovah lives, who brought up the children of Israel out of the land of Egypt,","tok":[{"t":"Therefore indeed, "},{"t":"days","s":["H3117"],"a":[2]},{"t":" are "},{"t":"coming","s":["H0935"],"a":[3]},{"t":", "},{"t":"declares","s":["H5002"],"a":[4]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":", when it will no longer be "},{"t":"said","s":["H0559"],"a":[7]},{"t":", As "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":" "},{"t":"lives","s":["H2416"],"a":[9]},{"t":", who brought "},{"t":"up","s":["H5927"],"a":[12]},{"t":" the "},{"t":"children","s":["H1121"],"a":[14]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[15]},{"t":" out of the "},{"t":"land","s":["H0776"],"a":[16]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[17]},{"t":","}]},{"n":15,"text":"But, As Jehovah lives, who brought up the children of Israel out of the land of the north and out of all the lands where He had driven them; for I will bring them back to their own land, which I gave to their fathers.","tok":[{"t":"But, As "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" "},{"t":"lives","s":["H2416"],"a":[2]},{"t":", who brought "},{"t":"up","s":["H5927"],"a":[5]},{"t":" the "},{"t":"children","s":["H1121"],"a":[7]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[8]},{"t":" out of the "},{"t":"land","s":["H0776"],"a":[9]},{"t":" of the "},{"t":"north","s":["H6828"],"a":[10]},{"t":" and out of all the "},{"t":"lands","s":["H0776"],"a":[12]},{"t":" where He had "},{"t":"driven","s":["H5080"],"a":[14]},{"t":" them; for I will bring them back to their own "},{"t":"land","s":["H0127"],"a":[18]},{"t":", which I "},{"t":"gave","s":["H5414"],"a":[20]},{"t":" to their "},{"t":"fathers","s":["H0001"],"a":[21]},{"t":"."}]},{"n":16,"text":"I am soon sending many fishermen, declares Jehovah, and they will catch them; and afterward I will send many hunters, and they will hunt for them from every mountain and from every hill and from the clefts of the rocks.","tok":[{"t":"I am soon "},{"t":"sending","s":["H7971"],"a":[1]},{"t":" "},{"t":"many","s":["H7227"],"a":[3]},{"t":" fishermen, declares "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":", and they will catch them; and afterward I will "},{"t":"send","s":["H7971"],"a":[9]},{"t":" "},{"t":"many","s":["H7227"],"a":[10]},{"t":" "},{"t":"hunters","s":["H6719"],"a":[11]},{"t":", and they will "},{"t":"hunt","s":["H6679"],"a":[12]},{"t":" for them from every "},{"t":"mountain","s":["H2022"],"a":[15]},{"t":" and from every "},{"t":"hill","s":["H1389"],"a":[18]},{"t":" and from the "},{"t":"clefts","s":["H5357"],"a":[19]},{"t":" of the "},{"t":"rocks","s":["H5553"],"a":[20]},{"t":"."}]},{"n":17,"text":"For My eyes are upon all their ways; they are not concealed from My face, neither is their iniquity hidden from My eyes.","tok":[{"t":"For My "},{"t":"eyes","s":["H5869"],"a":[1]},{"t":" are upon all their "},{"t":"ways","s":["H1870"],"a":[4]},{"t":"; they are not concealed from My "},{"t":"face","s":["H6440"],"a":[7]},{"t":", neither is their "},{"t":"iniquity","s":["H5771"],"a":[10]},{"t":" "},{"t":"hidden","s":["H6845"],"a":[9]},{"t":" "},{"t":"from","s":["H5048"],"a":[11]},{"t":" My "},{"t":"eyes","s":["H5869"],"a":[12]},{"t":"."}]},{"n":18,"text":"But first I will recompense double for their iniquity and their sin, because they have profaned My land with the corpses of their detestable things, and their abominations have filled My inheritance.","tok":[{"t":"But "},{"t":"first","s":["H7223"],"a":[1]},{"t":" I will "},{"t":"recompense","s":["H7999"],"a":[0]},{"t":" "},{"t":"double","s":["H4932"],"a":[2]},{"t":" for their "},{"t":"iniquity","s":["H5771"],"a":[3]},{"t":" and their "},{"t":"sin","s":["H2403"],"a":[4]},{"t":", because they have profaned My "},{"t":"land","s":["H0776"],"a":[8]},{"t":" with the corpses of their "},{"t":"detestable","s":["H8251"],"a":[10]},{"t":" "},{"t":"things","s":["H8441"],"a":[11]},{"t":", and their abominations have "},{"t":"filled","s":["H4390"],"a":[12]},{"t":" My "},{"t":"inheritance","s":["H5159"],"a":[14]},{"t":"."}]},{"n":19,"text":"O Jehovah, my strength and my stronghold, My refuge in the day of distress; To You the nations come From the ends of the earth and say, Surely our fathers inherited falsehood And vanity, in which there is no profit.","tok":[{"t":"O "},{"t":"Jehovah","s":["H3068"],"a":[0]},{"t":", my "},{"t":"strength","s":["H5797"],"a":[1]},{"t":" and my stronghold, My "},{"t":"refuge","s":["H4498"],"a":[3]},{"t":" in the "},{"t":"day","s":["H3117"],"a":[4]},{"t":" of distress; To You the nations "},{"t":"come","s":["H0935"],"a":[8]},{"t":" From the "},{"t":"ends","s":["H0657"],"a":[9]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[10]},{"t":" and "},{"t":"say","s":["H0559"],"a":[11]},{"t":", Surely our "},{"t":"fathers","s":["H0001"],"a":[15]},{"t":" "},{"t":"inherited","s":["H5157"],"a":[14]},{"t":" "},{"t":"falsehood","s":["H8267"],"a":[13]},{"t":" And "},{"t":"vanity","s":["H1892"],"a":[16]},{"t":", in which there is no "},{"t":"profit","s":["H3276"],"a":[19]},{"t":"."}]},{"n":20,"text":"Shall a man make gods for himself, Though they are no gods?","tok":[{"t":"Shall a "},{"t":"man","s":["H0120"],"a":[2]},{"t":" "},{"t":"make","s":["H6213"],"a":[0]},{"t":" "},{"t":"gods","s":["H0430"],"a":[3]},{"t":" for himself, Though they are no "},{"t":"gods","s":["H0430"],"a":[6]},{"t":"?"}]},{"n":21,"text":"Therefore now, I am causing them to know; At this time I will cause them to know My hand and My might, And they will know that My name is Jehovah.","tok":[{"t":"Therefore now, I am causing them to "},{"t":"know","s":["H3045"],"a":[2]},{"t":"; At this time I will cause them to "},{"t":"know","s":["H3045"],"a":[5]},{"t":" My "},{"t":"hand","s":["H3027"],"a":[7]},{"t":" and My "},{"t":"might","s":["H1369"],"a":[9]},{"t":", And they will "},{"t":"know","s":["H3045"],"a":[10]},{"t":" that My "},{"t":"name","s":["H8034"],"a":[12]},{"t":" is "},{"t":"Jehovah","s":["H3068"],"a":[13]},{"t":"."}]}]}
