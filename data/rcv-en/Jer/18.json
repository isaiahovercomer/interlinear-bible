s":["H7745"],"a":[10]},{"t":" to capture me And have hidden "},{"t":"snares","s":["H6341"],"a":[12]},{"t":" for my "},{"t":"feet","s":["H7272"],"a":[14]},{"t":"."}]},{"n":23,"text":"Yet You, O Jehovah, know All their counsel against me for my death. Do not be propitious to their iniquity, And do not blot out their sin from before You; But let them be overthrown before You; Deal with them in the time of Your anger.","tok":[{"t":"Yet You, O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", "},{"t":"know","s":["H3045"],"a":[2]},{"t":" All their "},{"t":"counsel","s":["H6098"],"a":[5]},{"t":" against me for my death. Do not be propitious to their "},{"t":"iniquity","s":["H5771"],"a":[11]},{"t":", And do not blot "},{"t":"out","s":["H4229"],"a":[15]},{"t":" their "},{"t":"sin","s":["H2403"],"a":[12]},{"t":" from before You; But let them be "},{"t":"overthrown","s":["H3782"],"a":[17]},{"t":" "},{"t":"before","s":["H6440"],"a":[18]},{"t":" You; "},{"t":"Deal","s":["H6213"],"a":[21]},{"t":" with them in the "},{"t":"time","s":["H6256"],"a":[19]},{"t":" of Your "},{"t":"anger","s":["H0639"],"a":[20]},{"t":"."}]}]}
