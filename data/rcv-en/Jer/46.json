H8085"],"a":[0]},{"t":" of your disgrace, And your "},{"t":"cry","s":["H6682"],"a":[3]},{"t":" has "},{"t":"filled","s":["H4390"],"a":[4]},{"t":" the earth; For mighty "},{"t":"man","s":["H1368"],"a":[7]},{"t":" has "},{"t":"stumbled","s":["H3782"],"a":[9]},{"t":" against "},{"t":"mighty","s":["H1368"],"a":[8]},{"t":" "},{"t":"man","s":["H5307"],"a":[11]},{"t":"; "},{"t":"Both","s":["H8147"],"a":[12]},{"t":" of them have "},{"t":"fallen","s":["H5307"],"a":[11]},{"t":" "},{"t":"together","s":["H3162"],"a":[10]},{"t":"."}]},{"n":13,"text":"The word which Jehovah spoke to Jeremiah the prophet about the coming of Nebuchadrezzar the king of Babylon to strike the land of Egypt:","tok":[{"t":"The "},{"t":"word","s":["H1697"],"a":[0]},{"t":" which "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" "},{"t":"spoke","s":["H1696"],"a":[2]},{"t":" to "},{"t":"Jeremiah","s":["H3414"],"a":[5]},{"t":" the "},{"t":"prophet","s":["H5030"],"a":[6]},{"t":" about the "},{"t":"coming","s":["H0935"],"a":[7]},{"t":" of "},{"t":"Nebuchadrezzar","s":["H5019"],"a":[8]},{"t":" the "},{"t":"king","s":["H4428"],"a":[9]},{"t":" of "},{"t":"Babylon","s":["H0894"],"a":[10]},{"t":" to "},{"t":"strike","s":["H5221"],"a":[11]},{"t":" the "},{"t":"land","s":["H0776"],"a":[13]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[14]},{"t":":"}]},{"n":14,"text":"Declare in Egypt, and proclaim in Migdol; Proclaim also in Memphis and in Tahpanhes. Say, Take your stand, and prepare yourself; For the sword has devoured all around you.","tok":[{"t":"Declare","s":["H5046"],"a":[0]},{"t":" in "},{"t":"Egypt","s":["H4714"],"a":[1]},{"t":", and "},{"t":"proclaim","s":["H8085"],"a":[2]},{"t":" in "},{"t":"Migdol","s":["H4024"],"a":[3]},{"t":"; Proclaim also in Memphis and in "},{"t":"Tahpanhes","s":["H8471"],"a":[6]},{"t":". "},{"t":"Say","s":["H0559"],"a":[7]},{"t":", Take your stand, and "},{"t":"prepare","s":["H3559"],"a":[9]},{"t":" yourself; For the "},{"t":"sword","s":["H2719"],"a":[13]},{"t":" has "},{"t":"devoured","s":["H0398"],"a":[12]},{"t":" all around you."}]},{"n":15,"text":"Why are your mighty men prostrate? He does not stand, because Jehovah has cast him down.","tok":[{"t":"Why are your mighty men prostrate? He does not stand, because "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" has cast him down."}]},{"n":16,"text":"He made many stumble; A man even fell against his neighbor; And they said, Arise and let us return To our own people and to the land of our birth, Away from the sword of the oppressor.","tok":[{"t":"He made "},{"t":"many","s":["H7235"],"a":[0]},{"t":" stumble; A man even "},{"t":"fell","s":["H5307"],"a":[3]},{"t":" against his neighbor; And they "},{"t":"said","s":["H0559"],"a":[7]},{"t":", "},{"t":"Arise","s":["H6965"],"a":[8]},{"t":" and let us return To our own "},{"t":"people","s":["H5971"],"a":[11]},{"t":" and to the "},{"t":"land","s":["H0776"],"a":[13]},{"t":" of our birth, Away "},{"t":"from","s":["H6440"],"a":[15]},{"t":" the "},{"t":"sword","s":["H2719"],"a":[16]},{"t":" of the oppressor."}]},{"n":17,"text":"There they cried, Pharaoh, the king of Egypt, is but a noise; He has let the appointed time pass by.","tok":[{"t":"There they cried, "},{"t":"Pharaoh","s":["H6547"],"a":[2]},{"t":", the "},{"t":"king","s":["H4428"],"a":[3]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[4]},{"t":", is but a "},{"t":"noise","s":["H7588"],"a":[5]},{"t":"; He has let the "},{"t":"appointed","s":["H4150"],"a":[7]},{"t":" time pass by."}]},{"n":18,"text":"As I live, says the King, Whose name is Jehovah of hosts, Surely as Tabor is among the mountains, And Carmel is by the sea, so he will come.","tok":[{"t":"As I "},{"t":"live","s":["H2416"],"a":[0]},{"t":", "},{"t":"says","s":["H5002"],"a":[2]},{"t":" the "},{"t":"King","s":["H4428"],"a":[3]},{"t":", Whose "},{"t":"name","s":["H8034"],"a":[6]},{"t":" is "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[5]},{"t":", Surely as "},{"t":"Tabor","s":["H8396"],"a":[8]},{"t":" is among the "},{"t":"mountains","s":["H2022"],"a":[9]},{"t":", And "},{"t":"Carmel","s":["H3760"],"a":[10]},{"t":" is by the "},{"t":"sea","s":["H3220"],"a":[11]},{"t":", so he will "},{"t":"come","s":["H0935"],"a":[12]},{"t":"."}]},{"n":19,"text":"Prepare for yourself baggage for captivity, O inhabitant, O daughter of Egypt; For Memphis will become a waste, And it will be burned, without inhabitant.","tok":[{"t":"Prepare for yourself baggage for "},{"t":"captivity","s":["H3627"],"a":[0]},{"t":", O inhabitant, O "},{"t":"daughter","s":["H1323"],"a":[5]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[6]},{"t":"; For Memphis will become a "},{"t":"waste","s":["H8047"],"a":[9]},{"t":", And it will be burned, without "},{"t":"inhabitant","s":["H3427"],"a":[13]},{"t":"."}]},{"n":20,"text":"Egypt is a beautiful heifer; A gadfly from the north has come on her.","tok":[{"t":"Egypt","s":["H4714"],"a":[3]},{"t":" is a "},{"t":"beautiful","s":["H3304"],"a":[1]},{"t":" "},{"t":"heifer","s":["H5697"],"a":[0]},{"t":"; A gadfly from the "},{"t":"north","s":["H6828"],"a":[5]},{"t":" has "},{"t":"come","s":["H0935"],"a":[6]},{"t":" on her."}]},{"n":21,"text":"Also her hired men in her midst Are like fattened calves. But they have also turned back; They have fled together; they did not stand. For the day of their calamity has come on them, The time of their punishment.","tok":[{"t":"Also her hired "},{"t":"men","s":["H7916"],"a":[1]},{"t":" in her "},{"t":"midst","s":["H7130"],"a":[2]},{"t":" Are like fattened calves. But they have also turned "},{"t":"back","s":["H6437"],"a":[8]},{"t":"; They have fled "},{"t":"together","s":["H3162"],"a":[10]},{"t":"; they did not "},{"t":"stand","s":["H5975"],"a":[12]},{"t":". For the "},{"t":"day","s":["H3117"],"a":[14]},{"t":" of their "},{"t":"calamity","s":["H0343"],"a":[15]},{"t":" has "},{"t":"come","s":["H0935"],"a":[16]},{"t":" on them, The "},{"t":"time","s":["H6256"],"a":[18]},{"t":" of their punishment."}]},{"n":22,"text":"Her sound is like that of a serpent going away; For they go forth in force, And with axes they come against her, Like those who fell trees.","tok":[{"t":"Her sound is like that of a "},{"t":"serpent","s":["H5175"],"a":[1]},{"t":" going away; For they "},{"t":"go","s":["H3212"]},{"t":" forth in force, And with "},{"t":"axes","s":["H7134"],"a":[6]},{"t":" they "},{"t":"come","s":["H0935"],"a":[7]},{"t":" against her, Like those who fell trees."}]},{"n":23,"text":"They will cut down her forest, declares Jehovah, Although it is impenetrable; For they are more numerous than locusts And are without number.","tok":[{"t":"They will cut "},{"t":"down","s":["H3772"],"a":[0]},{"t":" her "},{"t":"forest","s":["H3293"],"a":[1]},{"t":", "},{"t":"declares","s":["H5002"],"a":[2]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", Although it is impenetrable; For they are "},{"t":"more","s":["H7231"],"a":[8]},{"t":" numerous than locusts And are without number."}]},{"n":24,"text":"The daughter of Egypt is put to shame; She is given into the hand of a people from the north.","tok":[{"t":"The "},{"t":"daughter","s":["H1323"],"a":[1]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[2]},{"t":" is put to shame; She is given into the "},{"t":"hand","s":["H3027"],"a":[4]},{"t":" of a "},{"t":"people","s":["H5971"],"a":[5]},{"t":" from the "},{"t":"north","s":["H6828"],"a":[6]},{"t":"."}]},{"n":25,"text":"Jehovah of hosts, the God of Israel, says, I will punish Amon of No and Pharaoh and Egypt and her gods and her kings, even Pharaoh and those who trust in him.","tok":[{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[2]},{"t":", the "},{"t":"God","s":["H0430"],"a":[3]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[4]},{"t":", "},{"t":"says","s":["H0559"],"a":[0]},{"t":", I will "},{"t":"punish","s":["H6485"],"a":[6]},{"t":" "},{"t":"Amon","s":["H0527"]},{"t":" of "},{"t":"No","s":["H4996"],"a":[9]},{"t":" and "},{"t":"Pharaoh","s":["H6547"],"a":[11]},{"t":" and "},{"t":"Egypt","s":["H4714"],"a":[13]},{"t":" and her "},{"t":"gods","s":["H0430"],"a":[15]},{"t":" and her "},{"t":"kings","s":["H4428"],"a":[17]},{"t":", even "},{"t":"Pharaoh","s":["H6547"],"a":[19]},{"t":" and those who "},{"t":"trust","s":["H0982"],"a":[21]},{"t":" in him."}]},{"n":26,"text":"And I will give them into the hand of those who seek their life, even into the hand of Nebuchadrezzar the king of Babylon and into the hand of his servants; and afterward she will be inhabited as in the days of old, declares Jehovah.","tok":[{"t":"And I will give them into the "},{"t":"hand","s":["H3027"],"a":[1]},{"t":" of those who "},{"t":"seek","s":["H1245"],"a":[2]},{"t":" their life, even into the "},{"t":"hand","s":["H3027"],"a":[4]},{"t":" of "},{"t":"Nebuchadrezzar","s":["H5019"],"a":[5]},{"t":" the "},{"t":"king","s":["H4428"],"a":[6]},{"t":" of "},{"t":"Babylon","s":["H0894"],"a":[7]},{"t":" and into the "},{"t":"hand","s":["H3027"],"a":[8]},{"t":" of his "},{"t":"servants","s":["H5650"],"a":[9]},{"t":"; and "},{"t":"afterward","s":["H0310"],"a":[10]},{"t":" she will be "},{"t":"inhabited","s":["H7931"],"a":[12]},{"t":" as in the "},{"t":"days","s":["H3117"],"a":[13]},{"t":" of "},{"t":"old","s":["H6924"],"a":[14]},{"t":", "},{"t":"declares","s":["H5002"],"a":[15]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[16]},{"t":"."}]},{"n":27,"text":"But as for you, O Jacob My servant, do not fear; And do not be dismayed, O Israel. For indeed I will save you from afar And your seed from the land of their captivity; And Jacob will return and be undisturbed And at ease, and no one will frighten him.","tok":[{"t":"But as for you, O "},{"t":"Jacob","s":["H3290"],"a":[4]},{"t":" My "},{"t":"servant","s":["H5650"],"a":[3]},{"t":", do not "},{"t":"fear","s":["H3372"],"a":[2]},{"t":"; And do not be "},{"t":"dismayed","s":["H2865"],"a":[6]},{"t":", O "},{"t":"Israel","s":["H3478"],"a":[7]},{"t":". For indeed I will "},{"t":"save","s":["H3467"],"a":[10]},{"t":" you from afar And your "},{"t":"seed","s":["H2233"],"a":[13]},{"t":" from the "},{"t":"land","s":["H0776"],"a":[14]},{"t":" of their "},{"t":"captivity","s":["H7628"],"a":[15]},{"t":"; And "},{"t":"Jacob","s":["H3290"],"a":[17]},{"t":" will "},{"t":"return","s":["H7725"],"a":[16]},{"t":" and be "},{"t":"undisturbed","s":["H8252"],"a":[18]},{"t":" And at "},{"t":"ease","s":["H7599"],"a":[19]},{"t":", and no one will frighten him."}]},{"n":28,"text":"As for you, O Jacob My servant, do not fear, declares Jehovah, For I am with you; For I will make a full end of all the nations To which I have driven you; Yet I will not make a full end of you, But will correct you in measure And will by no means leave you unpunished.","tok":[{"t":"As for you, O "},{"t":"Jacob","s":["H3290"],"a":[4]},{"t":" My "},{"t":"servant","s":["H5650"],"a":[3]},{"t":", do not "},{"t":"fear","s":["H3372"],"a":[2]},{"t":", declares "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":", For I am with you; For I will "},{"t":"make","s":["H6213"],"a":[11]},{"t":" a full "},{"t":"end","s":["H3617"],"a":[12]},{"t":" of all the "},{"t":"nations","s":["H1471"],"a":[14]},{"t":" To which I have "},{"t":"driven","s":["H5080"],"a":[16]},{"t":" you; Yet I will not "},{"t":"make","s":["H6213"],"a":[20]},{"t":" a full "},{"t":"end","s":["H3617"],"a":[21]},{"t":" of you, But will "},{"t":"correct","s":["H3256"],"a":[22]},{"t":" you in "},{"t":"measure","s":["H4941"],"a":[23]},{"t":" And will by no means leave you "},{"t":"unpunished","s":["H5352"],"a":[26]},{"t":"."}]}]}
