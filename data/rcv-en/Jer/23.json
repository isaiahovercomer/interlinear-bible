{"v":1,"book":"Jer","ch":23,"verses":[{"n":1,"text":"Woe to the shepherds who destroy and scatter the sheep of My pasture, declares Jehovah.","tok":[{"t":"Woe","s":["H1945"],"a":[0]},{"t":" to the "},{"t":"shepherds","s":["H7462"],"a":[1]},{"t":" who "},{"t":"destroy","s":["H0006"],"a":[2]},{"t":" and "},{"t":"scatter","s":["H6327"],"a":[3]},{"t":" the "},{"t":"sheep","s":["H6629"],"a":[5]},{"t":" of My "},{"t":"pasture","s":["H4830"],"a":[6]},{"t":", "},{"t":"declares","s":["H5002"],"a":[7]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[8]},{"t":"."}]},{"n":2,"text":"Therefore thus says Jehovah the God of Israel concerning the shepherds who shepherd My people, You have scattered My flock and driven them away and have not visited them; I will visit upon you the evil of your deeds, declares Jehovah.","tok":[{"t":"Therefore thus "},{"t":"says","s":["H0559"],"a":[2]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" the "},{"t":"God","s":["H0430"],"a":[4]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[5]},{"t":" concerning the shepherds who shepherd My "},{"t":"people","s":["H5971"],"a":[10]},{"t":", You have "},{"t":"scattered","s":["H6327"],"a":[12]},{"t":" My "},{"t":"flock","s":["H6629"],"a":[14]},{"t":" and driven them "},{"t":"away","s":["H5080"],"a":[15]},{"t":" and have not "},{"t":"visited","s":["H6485"],"a":[17]},{"t":" them; I will "},{"t":"visit","s":["H6485"],"a":[20]},{"t":" upon you the "},{"t":"evil","s":["H7455"],"a":[23]},{"t":" of your deeds, declares "},{"t":"Jehovah","s":["H3068"],"a":[26]},{"t":"."}]},{"n":3,"text":"Then I will gather the remnant of My flock out of all the lands where I have driven them, and I will bring them back to their pasture; and they will be fruitful and multiply.","tok":[{"t":"Then I will "},{"t":"gather","s":["H6908"],"a":[1]},{"t":" the "},{"t":"remnant","s":["H7611"],"a":[3]},{"t":" of My "},{"t":"flock","s":["H6629"],"a":[4]},{"t":" out of all the lands where I have "},{"t":"driven","s":["H5080"],"a":[8]},{"t":" the