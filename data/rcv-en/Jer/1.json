 upon all the inhabitants of the land.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to me, Out of the "},{"t":"north","s":["H6828"],"a":[3]},{"t":" "},{"t":"evil","s":["H7451"],"a":[5]},{"t":" will be let loose upon all the "},{"t":"inhabitants","s":["H3427"],"a":[8]},{"t":" of the "},{"t":"land","s":["H0776"],"a":[9]},{"t":"."}]},{"n":15,"text":"For I am now calling all the families from the kingdoms of the north, declares Jehovah, and they will come and set each one his throne at the entrance of the gates of Jerusalem and against all its walls all around and against all the cities of Judah.","tok":[{"t":"For I am now "},{"t":"calling","s":["H7121"],"a":[2]},{"t":" all the "},{"t":"families","s":["H4940"],"a":[4]},{"t":" from the "},{"t":"kingdoms","s":["H4467"],"a":[5]},{"t":" of the "},{"t":"north","s":["H6828"],"a":[6]},{"t":", "},{"t":"declares","s":["H5002"],"a":[7]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[8]},{"t":", and they will "},{"t":"come","s":["H0935"],"a":[9]},{"t":" and "},{"t":"set","s":["H5414"],"a":[10]},{"t":" each "},{"t":"one","s":["H0376"],"a":[11]},{"t":" his "},{"t":"throne","s":["H3678"],"a":[12]},{"t":" at the "},{"t":"entrance","s":["H6607"],"a":[13]},{"t":" of the "},{"t":"gates","s":["H8179"],"a":[14]},{"t":" of "},{"t":"Jerusalem","s":["H3389"],"a":[15]},{"t":" and against all its "},{"t":"walls","s":["H2346"],"a":[18]},{"t":" all around and against all the "},{"t":"cities","s":["H5892"],"a":[22]},{"t":" of "},{"t":"Judah","s":["H3063"],"a":[23]},{"t":"."}]},{"n":16,"text":"And I will utter My judgment on them concerning all their wickedness by which they have forsaken Me and have burned incense to other gods and have worshipped the works of their own hands.","tok":[{"t":"And I will "},{"t":"utter","s":["H1696"],"a":[0]},{"t":" My "},{"t":"judgment","s":["H4941"],"a":[1]},{"t":" on them concerning all their "},{"t":"wickedness","s":["H7451"],"a":[5]},{"t":" by which 