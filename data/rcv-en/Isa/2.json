{"v":1,"book":"Isa","ch":2,"verses":[{"n":1,"text":"The word which Isaiah the son of Amoz saw concerning Judah and Jerusalem:","tok":[{"t":"The "},{"t":"word","s":["H1697"],"a":[0]},{"t":" which "},{"t":"Isaiah","s":["H3470"],"a":[3]},{"t":" the "},{"t":"son","s":["H1121"],"a":[4]},{"t":" of "},{"t":"Amoz","s":["H0531"],"a":[5]},{"t":" "},{"t":"saw","s":["H2372"],"a":[2]},{"t":" concerning "},{"t":"Judah","s":["H3063"],"a":[7]},{"t":" and "},{"t":"Jerusalem","s":["H3389"],"a":[8]},{"t":":"}]},{"n":2,"text":"But in the last days The mountain of the house of Jehovah will be established On the top of the mountains; And it will be lifted up above the hills; And all the nations will stream to it,","tok":[{"t":"But in the "},{"t":"last","s":["H0319"],"a":[1]},{"t":" "},{"t":"days","s":["H3117"],"a":[2]},{"t":" The "},{"t":"mountain","s":["H2022"],"a":[5]},{"t":" of the "},{"t":"house","s":["H1004"],"a":[6]},{"t":" of Jehovah will be "},{"t":"established","s":["H3559"],"a":[3]},{"t":" On the "},{"t":"top","s":["H7218"],"a":[8]},{"t":" of the "},{"t":"mountains","s":["H2022"],"a":[9]},{"t":"; And it will be lifted up above the "},{"t":"hills","s":["H1389"],"a":[11]},{"t":"; And all the "},{"t":"nations","s":["H1471"],"a":[15]},{"t":" will stream to it,"}]},{"n":3,"text":"And many peoples will come and say, Come and let us go up to the mountain of Jehovah, To the house of the God of Jacob, That He may instruct us in His ways, And that we may walk in His paths. For from Zion will go forth instruction, And the word of Jehovah from Jerusalem;","tok":[{"t":"And "},{"t":"many","s":["H7227"],"a":[2]},{"t":" "},{"t":"peoples","s":["H5971"],"a":[1]},{"t":" will come and "},{"t":"say","s":["H0559"],"a":[3]},{"t":", "},{"t":"Come","s":["H3212"]},{"t":" and let us "},{"t":"go","s":["H1980"],"a":[0]},{"t":" "},{"t":"up","s":["H5927"],"a":[5]},{"t":" to the "},{"t":"mountain","s":["H2022"],"a":[7]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[8]},{"t":", To the "},{"t":"house","s":["H1004"],"a":[10]},{"t":" of the "},{"t":"God","s":["H0430"],"a":[11]},{"t":" of "},{"t":"Jacob","s":["H3290"],"a":[12]},{"t":", That He may instruct us in His "},{"t":"ways","s":["H1870"],"a":[14]},{"t":", And that we may "},{"t":"walk","s":["H3212"]},{"t":" in His "},{"t":"paths","s":["H0734"],"a":[16]},{"t":". For from "},{"t":"Zion","s":["H6726"],"a":[18]},{"t":" will go "},{"t":"forth","s":["H3318"],"a":[19]},{"t":" "},{"t":"instruction","s":["H8451"],"a":[20]},{"t":", And the "},{"t":"word","s":["H1697"],"a":[21]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[22]},{"t":" from "},{"t":"Jerusalem","s":["H3389"],"a":[23]},{"t":";"}]},{"n":4,"text":"And He will judge between the nations, And will decide matters for many peoples. And they will beat their swords into plowshares, And their spears into pruning knives; Nation will not lift up sword against nation, Nor will they learn war anymore.","tok":[{"t":"And He will "},{"t":"judge","s":["H8199"],"a":[0]},{"t":" between the "},{"t":"nations","s":["H1471"],"a":[2]},{"t":", And will decide matters for "},{"t":"many","s":["H7227"],"a":[5]},{"t":" "},{"t":"peoples","s":["H5971"],"a":[4]},{"t":". And they will "},{"t":"beat","s":["H3807"],"a":[6]},{"t":" their "},{"t":"swords","s":["H2719"],"a":[7]},{"t":" into "},{"t":"plowshares","s":["H0855"],"a":[8]},{"t":", And their "},{"t":"spears","s":["H2595"],"a":[9]},{"t":" into pruning knives; "},{"t":"Nation","s":["H1471"],"a":[13]},{"t":" will not lift "},{"t":"up","s":["H5375"],"a":[12]},{"t":" "},{"t":"sword","s":["H2719"],"a":[16]},{"t":" against "},{"t":"nation","s":["H1471"],"a":[15]},{"t":", Nor will they "},{"t":"learn","s":["H3925"],"a":[18]},{"t":" "},{"t":"war","s":["H4421"],"a":[20]},{"t":" anymore."}]},{"n":5,"text":"House of Jacob, come and let us walk in the light of Jehovah.","tok":[{"t":"House","s":["H1004"],"a":[0]},{"t":" of "},{"t":"Jacob","s":["H3290"],"a":[1]},{"t":", "},{"t":"come","s":["H3212"]},{"t":" and let us "},{"t":"walk","s":["H3212"]},{"t":" in the "},{"t":"light","s":["H0216"],"a":[4]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":"."}]},{"n":6,"text":"For You have abandoned Your people, The house of Jacob; Because they are full of customs from the east, And they are soothsayers like the Philistines, And they clasp hands with the children of foreigners.","tok":[{"t":"For You have abandoned Your "},{"t":"people","s":["H5971"],"a":[2]},{"t":", The "},{"t":"house","s":["H1004"],"a":[3]},{"t":" of "},{"t":"Jacob","s":["H3290"],"a":[4]},{"t":"; Because they are full of customs from the "},{"t":"east","s":["H6924"],"a":[7]},{"t":", And they are "},{"t":"soothsayers","s":["H6049"],"a":[8]},{"t":" like the "},{"t":"Philistines","s":["H6430"],"a":[9]},{"t":", And they clasp hands with the "},{"t":"children","s":["H3206"],"a":[10]},{"t":" of "},{"t":"foreigners","s":["H5237"],"a":[11]},{"t":"."}]},{"n":7,"text":"Their land is full of silver and gold, And their treasures are limitless; Their land is also full of horses, And their chariots are limitless.","tok":[{"t":"Their "},{"t":"land","s":["H0776"],"a":[1]},{"t":" is "},{"t":"full","s":["H4390"],"a":[0]},{"t":" of "},{"t":"silver","s":["H3701"],"a":[2]},{"t":" and "},{"t":"gold","s":["H2091"],"a":[3]},{"t":", And "},{"t":"their","s":["H7097"],"a":[5]},{"t":" "},{"t":"treasures","s":["H0214"],"a":[6]},{"t":" are limitless; Their "},{"t":"land","s":["H0776"],"a":[8]},{"t":" is also "},{"t":"full","s":["H4390"],"a":[7]},{"t":" of "},{"t":"horses","s":["H5483"],"a":[9]},{"t":", And "},{"t":"their","s":["H7097"],"a":[11]},{"t":" "},{"t":"chariots","s":["H4818"],"a":[12]},{"t":" are limitless."}]},{"n":8,"text":"And their land is full of idols; They bow down to the work of their hands, To that which their fingers have made.","tok":[{"t":"And their "},{"t":"land","s":["H0776"],"a":[1]},{"t":" is "},{"t":"full","s":["H4390"],"a":[0]},{"t":" of "},{"t":"idols","s":["H0457"],"a":[2]},{"t":"; They bow down to the "},{"t":"work","s":["H4639"],"a":[3]},{"t":" of their "},{"t":"hands","s":["H3027"],"a":[4]},{"t":", To that which their "},{"t":"fingers","s":["H0676"],"a":[8]},{"t":" have "},{"t":"made","s":["H6213"],"a":[7]},{"t":"."}]},{"n":9,"text":"Thus the ordinary man is humbled, and the man of distinction is abased — But do not forgive them.","tok":[{"t":"Thus the ordinary "},{"t":"man","s":["H0120"],"a":[1]},{"t":" is "},{"t":"humbled","s":["H8213"],"a":[2]},{"t":", and the "},{"t":"man","s":["H0376"],"a":[3]},{"t":" of distinction is abased — But do not "},{"t":"forgive","s":["H5375"],"a":[5]},{"t":" them."}]},{"n":10,"text":"Enter into the rock, And hide in the dust, From the dread of Jehovah, And from the splendor of His majesty.","tok":[{"t":"Enter","s":["H0935"],"a":[0]},{"t":" into the "},{"t":"rock","s":["H6697"],"a":[1]},{"t":", And "},{"t":"hide","s":["H2934"],"a":[2]},{"t":" in the "},{"t":"dust","s":["H6083"],"a":[3]},{"t":", From the "},{"t":"dread","s":["H6343"],"a":[5]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":", And from the splendor of His "},{"t":"majesty","s":["H1347"],"a":[8]},{"t":"."}]},{"n":11,"text":"Man’s haughty look will be abased, And the loftiness of men will be humbled; But Jehovah alone will be exalted In that day.","tok":[{"t":"Man’s haughty "},{"t":"look","s":["H5869"],"a":[0]},{"t":" will be abased, And the loftiness of "},{"t":"men","s":["H0582"],"a":[6]},{"t":" will be "},{"t":"humbled","s":["H8213"],"a":[3]},{"t":"; But "},{"t":"Jehovah","s":["H3068"],"a":[8]},{"t":" alone will be "},{"t":"exalted","s":["H7682"],"a":[7]},{"t":" In that "},{"t":"day","s":["H3117"],"a":[10]},{"t":"."}]},{"n":12,"text":"For Jehovah of hosts will have a day Over everything proud and lofty, And over everything lifted up that it may be abased;","tok":[{"t":"For "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[3]},{"t":" will have a "},{"t":"day","s":["H3117"],"a":[1]},{"t":" Over everything "},{"t":"proud","s":["H1343"],"a":[6]},{"t":" and "},{"t":"lofty","s":["H7311"],"a":[7]},{"t":", And over everything lifted "},{"t":"up","s":["H5375"],"a":[10]},{"t":" that it may be abased;"}]},{"n":13,"text":"Over all the cedars of Lebanon, Which are lofty and lifted up, And over all the oaks of Bashan;","tok":[{"t":"Over all the "},{"t":"cedars","s":["H0730"],"a":[2]},{"t":" of "},{"t":"Lebanon","s":["H3844"],"a":[3]},{"t":", Which are lofty and lifted "},{"t":"up","s":["H5375"],"a":[5]},{"t":", And over all the "},{"t":"oaks","s":["H0437"],"a":[8]},{"t":" of "},{"t":"Bashan","s":["H1316"],"a":[9]},{"t":";"}]},{"n":14,"text":"Over all the lofty mountains, And over all the hills that are lifted up;","tok":[{"t":"Over all the lofty "},{"t":"mountains","s":["H2022"],"a":[2]},{"t":", And over all the "},{"t":"hills","s":["H1389"],"a":[6]},{"t":" that are lifted "},{"t":"up","s":["H5375"],"a":[7]},{"t":";"}]},{"n":15,"text":"Over every high tower, And over every fortified wall;","tok":[{"t":"Over every "},{"t":"high","s":["H1364"],"a":[3]},{"t":" "},{"t":"tower","s":["H4026"],"a":[2]},{"t":", And over every fortified "},{"t":"wall","s":["H2346"],"a":[6]},{"t":";"}]},{"n":16,"text":"Over all the ships of Tarshish, And over all their pleasant artifacts.","tok":[{"t":"Over all the "},{"t":"ships","s":["H0591"],"a":[2]},{"t":" of "},{"t":"Tarshish","s":["H8659"],"a":[3]},{"t":", And over all their "},{"t":"pleasant","s":["H2532"],"a":[7]},{"t":" "},{"t":"artifacts","s":["H7914"],"a":[6]},{"t":"."}]},{"n":17,"text":"And the haughtiness of the ordinary man will be humbled, And the loftiness of the men of distinction will be abased; But Jehovah alone will be exalted In that day.","tok":[{"t":"And the "},{"t":"haughtiness","s":["H7312"],"a":[4]},{"t":" of the ordinary "},{"t":"man","s":["H0120"],"a":[2]},{"t":" will be humbled, And the "},{"t":"loftiness","s":["H1365"],"a":[1]},{"t":" of the "},{"t":"men","s":["H0582"],"a":[5]},{"t":" of distinction will be abased; But "},{"t":"Jehovah","s":["H3068"],"a":[7]},{"t":" alone will be "},{"t":"exalted","s":["H7682"],"a":[6]},{"t":" In that "},{"t":"day","s":["H3117"],"a":[9]},{"t":"."}]},{"n":18,"text":"And the idols will vanish completely.","tok":[{"t":"And the "},{"t":"idols","s":["H0457"],"a":[0]},{"t":" will vanish completely."}]},{"n":19,"text":"And men will go into caves in the rocks And into holes in the dust, From the dread of Jehovah, And from the splendor of His majesty, When He arises to make the earth tremble.","tok":[{"t":"And men will "},{"t":"go","s":["H0935"],"a":[0]},{"t":" into "},{"t":"caves","s":["H4247"],"a":[3]},{"t":" in the "},{"t":"rocks","s":["H6697"],"a":[2]},{"t":" And into "},{"t":"holes","s":["H4631"],"a":[1]},{"t":" in the dust, From the dread of "},{"t":"Jehovah","s":["H3068"],"a":[7]},{"t":", And from the splendor of His "},{"t":"majesty","s":["H1347"],"a":[9]},{"t":", When He "},{"t":"arises","s":["H6965"],"a":[10]},{"t":" to "},{"t":"make","s":["H6206"],"a":[11]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[12]},{"t":" tremble."}]},{"n":20,"text":"In that day a man will cast His idols of silver and his idols of gold, Which they made for themselves to bow down to, To the moles and to the bats,","tok":[{"t":"In that "},{"t":"day","s":["H3117"],"a":[0]},{"t":" a "},{"t":"man","s":["H0120"],"a":[3]},{"t":" will "},{"t":"cast","s":["H7993"],"a":[2]},{"t":" His "},{"t":"idols","s":["H0457"],"a":[5]},{"t":" of "},{"t":"silver","s":["H3701"],"a":[6]},{"t":" and his "},{"t":"idols","s":["H0457"],"a":[8]},{"t":" of "},{"t":"gold","s":["H2091"],"a":[9]},{"t":", Which they made for themselves to bow down to, To the "},{"t":"moles","s":["H2661"],"a":[14]},{"t":" and to the "},{"t":"bats","s":["H5847"],"a":[16]},{"t":","}]},{"n":21,"text":"So that they may go into the crevices of the rocks And into the clefts of the cliffs, From the dread of Jehovah, And from the splendor of His majesty, When He arises to make the earth tremble.","tok":[{"t":"So that they may "},{"t":"go","s":["H0935"],"a":[0]},{"t":" into the "},{"t":"crevices","s":["H5366"],"a":[1]},{"t":" of the "},{"t":"rocks","s":["H6697"],"a":[2]},{"t":" And into the "},{"t":"clefts","s":["H5366"],"a":[1]},{"t":" of the cliffs, From the dread of "},{"t":"Jehovah","s":["H3068"],"a":[7]},{"t":", And from the splendor of His "},{"t":"majesty","s":["H1347"],"a":[9]},{"t":", When He "},{"t":"arises","s":["H6965"],"a":[10]},{"t":" to "},{"t":"make","s":["H6206"],"a":[11]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[12]},{"t":" tremble."}]},{"n":22,"text":"Stop regarding man, Whose life breath is in his nostrils. For of what value is he considered to be?","tok":[{"t":"Stop regarding "},{"t":"man","s":["H0120"],"a":[3]},{"t":", Whose life "},{"t":"breath","s":["H5397"],"a":[5]},{"t":" is in his "},{"t":"nostrils","s":["H0639"],"a":[6]},{"t":". For of what value is he considered to be?"}]}]}
