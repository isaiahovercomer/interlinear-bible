,{"t":"days","s":["H3117"],"a":[14]},{"t":" of your "},{"t":"mourning","s":["H0060"],"a":[15]},{"t":" will be "},{"t":"ended","s":["H7999"],"a":[13]},{"t":"."}]},{"n":21,"text":"Then all your people will be righteous; They will possess the land forever, The branch of My planting, The work of My hands, That I may be beautified.","tok":[{"t":"Then all your "},{"t":"people","s":["H5971"],"a":[0]},{"t":" will be "},{"t":"righteous","s":["H6662"],"a":[2]},{"t":"; They will possess the "},{"t":"land","s":["H0776"],"a":[5]},{"t":" "},{"t":"forever","s":["H5769"],"a":[3]},{"t":", The "},{"t":"branch","s":["H5342"],"a":[6]},{"t":" of My "},{"t":"planting","s":["H4302"],"a":[7]},{"t":", The "},{"t":"work","s":["H4639"],"a":[8]},{"t":" of My "},{"t":"hands","s":["H3027"],"a":[9]},{"t":", That I may be beautified."}]},{"n":22,"text":"The least one will become a thousand, And the smallest a strong nation. I, Jehovah, will hasten it in its time.","tok":[{"t":"The least "},{"t":"one","s":["H6996"],"a":[0]},{"t":" will become a "},{"t":"thousand","s":["H0505"],"a":[2]},{"t":", And the "},{"t":"smallest","s":["H6810"],"a":[3]},{"t":" a "},{"t":"strong","s":["H6099"],"a":[5]},{"t":" "},{"t":"nation","s":["H1471"],"a":[4]},{"t":". I, "},{"t":"Jehovah","s":["H3068"],"a":[7]},{"t":", will "},{"t":"hasten","s":["H2363"],"a":[9]},{"t":" it in its "},{"t":"time","s":["H6256"],"a":[8]},{"t":"."}]}]}
