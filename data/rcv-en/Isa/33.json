ighways","s":["H4546"],"a":[1]},{"t":" are desolate; The traveler "},{"t":"ceases","s":["H7673"],"a":[2]},{"t":" to travel. He has "},{"t":"broken","s":["H6565"],"a":[5]},{"t":" the "},{"t":"covenant","s":["H1285"],"a":[6]},{"t":"; he "},{"t":"despises","s":["H3988"],"a":[7]},{"t":" the "},{"t":"cities","s":["H5892"],"a":[8]},{"t":"; He does not "},{"t":"regard","s":["H2803"],"a":[10]},{"t":" "},{"t":"man","s":["H0582"],"a":[11]},{"t":"."}]},{"n":9,"text":"The land mourns and languishes; Lebanon is ashamed and withers away; Sharon is like a desert, And Bashan and Carmel shake off their leaves.","tok":[{"t":"The "},{"t":"land","s":["H0776"],"a":[2]},{"t":" "},{"t":"mourns","s":["H0056"],"a":[0]},{"t":" and "},{"t":"languishes","s":["H0535"],"a":[1]},{"t":"; "},{"t":"Lebanon","s":["H3844"],"a":[4]},{"t":" is "},{"t":"ashamed","s":["H2659"],"a":[3]},{"t":" and withers away; "},{"t":"Sharon","s":["H8289"],"a":[7]},{"t":" is like a desert, And "},{"t":"Bashan","s":["H1316"],"a":[10]},{"t":" and "},{"t":"Carmel","s":["H3760"],"a":[11]},{"t":" shake "},{"t":"off","s":["H5287"],"a":[9]},{"t":" their leaves."}]},{"n":10,"text":"Now I will arise, says Jehovah, Now I will be exalted; now I will be lifted up.","tok":[{"t":"Now I will arise, "},{"t":"says","s":["H0559"],"a":[2]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", Now I will be "},{"t":"exalted","s":["H7426"]},{"t":"; now I will be lifted "},{"t":"up","s":["H5375"],"a":[7]},{"t":"."}]},{"n":11,"text":"You will conceive chaff; you will give birth to stubble; Your own breath, like fire, will devour you;","tok":[{"t":"You will "},{"t":"conceive","s":["H2029"],"a":[0]},{"t":" "},{"t":"chaff","s":["H2842"],"a":[1]},{"t":"; you will give birth to "},{"t":"stubble","s":["H7179"],"a":[3]},{"t":"; Your own "},{"t":"breath","s":["H7307"],"a":[4]},{"t":", like "},{"t":"fire","s":["H0784"],"a":[5]},{"t":", will "},{"t":"devour","s":["H0398"],"a":[6]},{"t":" you;"}]},{"n":12,"text":"And the peoples will be like the burning of lime, Like cut down thorns that are burned in the fire.","tok":[{"t":"And the "},{"t":"peoples","s":["H5971"],"a":[1]},{"t":" will be like the burning of "},{"t":"lime","s":["H7875"],"a":[3]},{"t":", Like cut down "},{"t":"thorns","s":["H6975"],"a":[4]},{"t":" that "},{"t":"are","s":["H3683"],"a":[5]},{"t":" "},{"t":"burned","s":["H3341"],"a":[7]},{"t":" in the "},{"t":"fire","s":["H0784"],"a":[6]},{"t":"."}]},{"n":13,"text":"Hear, you who are far off, what I have done; And know, you who are near, My might.","tok":[{"t":"Hear","s":["H8085"],"a":[0]},{"t":", you who are far "},{"t":"off","s":["H7350"],"a":[1]},{"t":", what I have "},{"t":"done","s":["H6213"],"a":[3]},{"t":"; And know, you who are "},{"t":"near","s":["H7138"],"a":[5]},{"t":", "},{"t":"My","s":["H3045"],"a":[4]},{"t":" "},{"t":"might","s":["H1369"],"a":[6]},{"t":"."}]},{"n":14,"text":"The sinners in Zion are terrified; Trembling has seized the profane: Who among us can dwell with consuming fire? Who among us can dwell with everlasting burning?","tok":[{"t":"The "},{"t":"sinners","s":["H2400"],"a":[2]},{"t":" in "},{"t":"Zion","s":["H6726"],"a":[1]},{"t":" are terrified; Trembling has seized the profane: Who among us can "},{"t":"dwell","s":["H1481"],"a":[7]},{"t":" with "},{"t":"consuming","s":["H0398"],"a":[10]},{"t":" "},{"t":"fire","s":["H0784"],"a":[9]},{"t":"? Who among us can "},{"t":"dwell","s":["H1481"],"a":[12]},{"t":" with "},{"t":"everlasting","s":["H5769"],"a":[15]},{"t":" "},{"t":"burning","s":["H4168"],"a":[14]},{"t":"?"}]},{"n":15,"text":"He who walks in righteousness and speaks uprightness; He who rejects gains seized by extortion; He who shakes his hands lest they hold on to a bribe, Who stops his ears so as not to hear of bloodshed And shuts his eyes so as not to look at evil.","tok":[{"t":"He who "},{"t":"walks","s":["H1980"],"a":[0]},{"t":" in "},{"t":"righteousness","s":["H6666"],"a":[1]},{"t":" and "},{"t":"speaks","s":["H1696"],"a":[2]},{"t":" uprightness; He who rejects "},