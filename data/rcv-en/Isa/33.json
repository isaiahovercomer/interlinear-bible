26"],"a":[10]},{"t":"?"}]},{"n":19,"text":"You will not see a fierce people, A people of unintelligible speech, hardly audible, Of a stammering tongue which cannot be understood.","tok":[{"t":"You will not "},{"t":"see","s":["H7200"],"a":[4]},{"t":" a "},{"t":"fierce","s":["H3267"],"a":[2]},{"t":" "},{"t":"people","s":["H5971"],"a":[5]},{"t":", A "},{"t":"people","s":["H5971"],"a":[1]},{"t":" of unintelligible "},{"t":"speech","s":["H8193"],"a":[7]},{"t":", hardly audible, Of a "},{"t":"stammering","s":["H3932"],"a":[9]},{"t":" "},{"t":"tongue","s":["H3956"],"a":[10]},{"t":" which cannot be understood."}]},{"n":20,"text":"Look upon Zion, the city of our appointed feasts; Your eyes will see Jerusalem, A secure habitation, a tent that will not be removed; Its stakes will never be pulled up, And none of its cords will be torn apart.","tok":[{"t":"Look","s":["H2372"],"a":[0]},{"t":" upon "},{"t":"Zion","s":["H6726"],"a":[1]},{"t":", the "},{"t":"city","s":["H7151"],"a":[2]},{"t":" of our appointed feasts; Your "},{"t":"eyes","s":["H5869"],"a":[4]},{"t":" will "},{"t":"see","s":["H7200"],"a":[5]},{"t":" "},{"t":"Jerusalem","s":["H3389"],"a":[6]},{"t":", A "},{"t":"secure","s":["H7600"],"a":[8]},{"t":" "},{"t":"habitation","s":["H5116"],"a":[7]},{"t":", a tent that will not be "},{"t":"removed","s":["H5265"],"a":[13]},{"t":"; Its "},{"t":"stakes","s":["H3489"],"a":[14]},{"t":" will never be pulled up, And none of its "},{"t":"cords","s":["H2256"],"a":[17]},{"t":" will be torn apart."}]},{"n":21,"text":"But there the Majestic, Jehovah, will be for us A place of rivers and broad streams, On which no boat with oars will go And no majestic ship will pass.","tok":[{"t":"But there the Majestic, "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":", will be for us A "},{"t":"place","s":["H4725"],"a":[6]},{"t":" of "},{"t":"rivers","s":["H5104"],"a":[7]},{"t":" and "},{"t":"broad","s":["H7342"],"a":[9]},{"t":" "},{"t":"streams","s":["H2975"],"a":[8]},{"t":", On which "},{"t":"no","s":[