es","s":["H5971"],"a":[14]},{"t":" of the "},{"t":"land","s":["H0776"],"a":[15]},{"t":", yet now there "},{"t":"is","s":["H3426"],"a":[17]},{"t":" "},{"t":"hope","s":["H4723"],"a":[18]},{"t":" for "},{"t":"Israel","s":["H3478"],"a":[19]},{"t":" concerning this."}]},{"n":3,"text":"Now therefore let us make a covenant with our God to put away all the wives and those born of them according to the counsel of my lord and of those who tremble at the commandment of our God, and let it be done according to the law.","tok":[{"t":"Now therefore let us "},{"t":"make","s":["H3772"],"a":[1]},{"t":" a "},{"t":"covenant","s":["H1285"],"a":[2]},{"t":" with our "},{"t":"God","s":["H0430"],"a":[3]},{"t":" to put "},{"t":"away","s":["H3318"],"a":[4]},{"t":" all the "},{"t":"wives","s":["H0802"],"a":[6]},{"t":" and those "},{"t":"born","s":["H3205"],"a":[7]},{"t":" of them according to the "},{"t":"counsel","s":["H6098"],"a":[9]},{"t":" of my "},{"t":"lord","s":["H0136"],"a":[10]},{"t":" and of those who "},{"t":"tremble","s":["H2730"],"a":[11]},{"t":" at the "},{"t":"commandment","s":["H4687"],"a":[12]},{"t":" of our "},{"t":"God","s":["H0430"],"a":[13]},{"t":", and let it be "},{"t":"done","s":["H6213"],"a":[15]},{"t":" according to the "},{"t":"law","s":["H8451"],"a":[14]},{"t":"."}]},{"n":4,"text":"Arise, for the matter is your responsibility, but we are with you; be strong, and do it.","tok":[{"t":"Arise","s":["H6965"],"a":[0]},{"t":", for the "},{"t":"matter","s":["H1697"],"a":[3]},{"t":" is your responsibility, but we are with you; be strong, and "},{"t":"do","s":["H6213"],"a":[7]},{"t":" it."}]},{"n":5,"text":"Then Ezra arose and made the leaders of the priests, the Levites, and all Israel swear that they would do according to this word; so they swore.","tok":[{"t":"Then","s":["H6965"],"a":[0]},{"t":" "},{"t":"Ezra","s":["H5830"],"a":[1]},{"t":" "},{"t":"arose","s":["H6965"],"a":[0]},{"t":" and made the leaders of the "},{"t":"priests","s":["H3548"],"a":[5]},{"t":", the "},{"t"