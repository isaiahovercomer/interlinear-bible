H3117"],"a":[3]},{"t":", "},{"t":"removing","s":["H5493"],"a":[4]},{"t":" from there every "},{"t":"speckled","s":["H5348"],"a":[8]},{"t":" and "},{"t":"spotted","s":["H2921"],"a":[9]},{"t":" animal, that is, every black animal among the "},{"t":"sheep","s":["H3775"],"a":[13]},{"t":", and the "},{"t":"spotted","s":["H2921"],"a":[14]},{"t":" and "},{"t":"speckled","s":["H5348"],"a":[15]},{"t":" among the "},{"t":"goats","s":["H5795"],"a":[16]},{"t":"; and such will be my wages."}]},{"n":33,"text":"So my righteousness will testify for me later, when you come concerning my wages, by what is before you. Every one that is not speckled and spotted among the goats and black among the sheep, if found with me, will be counted stolen.","tok":[{"t":"So my "},{"t":"righteousness","s":["H6666"],"a":[2]},{"t":" will testify for me later, when you "},{"t":"come","s":["H4279"],"a":[4]},{"t":" concerning my wages, by what is before you. Every "},{"t":"one","s":["H3605"],"a":[10]},{"t":" that is not "},{"t":"speckled","s":["H5348"],"a":[13]},{"t":" and "},{"t":"spotted","s":["H2921"],"a":[14]},{"t":" among the "},{"t":"goats","s":["H5795"],"a":[15]},{"t":" and black among the "},{"t":"sheep","s":["H3775"],"a":[17]},{"t":", if found with me, will be counted "},{"t":"stolen","s":["H1589"],"a":[18]},{"t":"."}]},{"n":34,"text":"And Laban said, Fine; let it be according to your word.","tok":[{"t":"And "},{"t":"Laban","s":["H3837"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":", Fine; let it "},{"t":"be","s":["H3863"],"a":[3]},{"t":" according to your "},{"t":"word","s":["H1697"],"a":[5]},{"t":"."}]},{"n":35,"text":"But on that day Laban removed the male goats that were streaked and spotted, and all the female goats that were speckled and spotted, every one that had white in it, and all the black ones among the sheep, and gave them into the care of his sons.","tok":[{"t":"But on that "},{"t":"day","s":["H3117"],"a":[1]},{"t":" Laban "},{"t":"removed","s":["H5493"],"a":[0]},{"