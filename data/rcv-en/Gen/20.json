{"v":1,"book":"Gen","ch":20,"verses":[{"n":1,"text":"And Abraham journeyed from there toward the region of the Negev and dwelt between Kadesh and Shur; then he sojourned in Gerar.","tok":[{"t":"And "},{"t":"Abraham","s":["H0085"],"a":[2]},{"t":" "},{"t":"journeyed","s":["H5265"],"a":[0]},{"t":" from there toward the region of the Negev and dwelt between "},{"t":"Kadesh","s":["H6946"],"a":[7]},{"t":" and "},{"t":"Shur","s":["H7793"],"a":[9]},{"t":"; then he "},{"t":"sojourned","s":["H1481"],"a":[10]},{"t":" in "},{"t":"Gerar","s":["H1642"],"a":[11]},{"t":"."}]},{"n":2,"text":"And Abraham said of Sarah his wife, She is my sister. And Abimelech the king of Gerar sent and took Sarah.","tok":[{"t":"And "},{"t":"Abraham","s":["H0085"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" "},{"t":"of","s":["H0413"],"a":[2]},{"t":" "},{"t":"Sarah","s":["H8283"],"a":[3]},{"t":" his "},{"t":"wife","s":["H0802"],"a":[4]},{"t":", She is my "},{"t":"sister","s":["H0269"],"a":[5]},{"t":". And "},{"t":"Abimelech","s":["H0040"],"a":[8]},{"t":" the "},{"t":"king","s":["H4428"],"a":[9]},{"t":" of "},{"t":"Gerar","s":["H1642"],"a":[10]},{"t":" "},{"t":"sent","s":["H7971"],"a":[7]},{"t":" and "},{"t":"took","s":["H3947"],"a":[11]},{"t":" "},{"t":"Sarah","s":["H8283"],"a":[13]},{"t":"."}]},{"n":3,"text":"But God came to Abimelech in a dream by night and said to him, You are now about to die because of the woman whom you have taken, for she is a man’s wife.","tok":[{"t":"But "},{"t":"God","s":["H0430"],"a":[1]},{"t":" "},{"t":"came","s":["H0935"],"a":[0]},{"t":" to "},{"t":"Abimelech","s":["H0040"],"a":[3]},{"t":" in a "},{"t":"dream","s":["H2472"],"a":[4]},{"t":" by "},{"t":"night","s":["H3915"],"a":[5]},{"t":" and "},{"t":"said","s":["H0559"],"a":[6]},{"t":" to him, You are now about to die because of the "},{"t":"woman","s":["H0802"],"a":[11]},{"t":" whom you have "},{"t":"taken","s":["H3947"],"a":[13]},{"t":", for she is a "},{"t":"man’s","s":["H1167"],"a":[16]},{"t":" "},{"t"