because of this matter. And Asa oppressed some of the people at that time.","tok":[{"t":"Then "},{"t":"Asa","s":["H0609"],"a":[1]},{"t":" became angry with the "},{"t":"seer","s":["H7200"]},{"t":" and "},{"t":"put","s":["H5414"],"a":[4]},{"t":" him in "},{"t":"prison","s":["H4115"],"a":[6]},{"t":" in stocks, for he was in a "},{"t":"rage","s":["H2197"],"a":[8]},{"t":" against him because of this matter. And "},{"t":"Asa","s":["H0609"],"a":[13]},{"t":" "},{"t":"oppressed","s":["H7533"],"a":[12]},{"t":" some of the "},{"t":"people","s":["H5971"],"a":[15]},{"t":" at that "},{"t":"time","s":["H6256"],"a":[16]},{"t":"."}]},{"n":11,"text":"And the acts of Asa, the first and the last, are there written in the book of the kings of Judah and Israel.","tok":[{"t":"And the "},{"t":"acts","s":["H1697"],"a":[1]},{"t":" of "},{"t":"Asa","s":["H0609"],"a":[2]},{"t":", the "},{"t":"first","s":["H7223"],"a":[3]},{"t":" and the "},{"t":"last","s":["H0314"],"a":[4]},{"t":", are there "},{"t":"written","s":["H3789"],"a":[6]},{"t":" in the "},{"t":"book","s":["H5612"],"a":[8]},{"t":" of the "},{"t":"kings","s":["H4428"],"a":[9]},{"t":" of "},{"t":"Judah","s":["H3063"],"a":[10]},{"t":" and "},{"t":"Israel","s":["H3478"],"a":[11]},{"t":"."}]},{"n":12,"text":"And in the thirty-ninth year of his reign, Asa became diseased in his feet; his disease was very severe, yet even in his disease he pursued not Jehovah but the physicians.","tok":[{"t":"And in the "},{"t":"thirty","s":["H7970"],"a":[3]},{"t":"-"},{"t":"ninth","s":["H8672"],"a":[4]},{"t":" "},{"t":"year","s":["H8141"],"a":[2]},{"t":" of his "},{"t":"reign","s":["H4438"],"a":[5]},{"t":", "},{"t":"Asa","s":["H0609"],"a":[1]},{"t":" became "},{"t":"diseased","s":["H2456"],"a":[0]},{"t":" in his "},{"t":"feet","s":["H7272"],"a":[6]},{"t":"; his "},{"t":"disease","s":["H2483"],"a":[9]},{"t":" was very severe, yet even in his "},{"t":"disease","s":["H2483"],"a":[11]},{"t":" he pursued not "},{"t":"Jehovah","s":["H3068"],"a":[15]},{"t":" but the "},{"t":"physicians","s":["H7495"],"a":[17]},{"t":"."}]},{"n":13,"text":"And Asa slept with his fathers and died in the forty-first year of his reign.","tok":[{"t":"And "},{"t":"Asa","s":["H0609"],"a":[1]},{"t":" "},{"t":"slept","s":["H7901"],"a":[0]},{"t":" with his "},{"t":"fathers","s":["H0001"],"a":[3]},{"t":" and "},{"t":"died","s":["H4191"],"a":[4]},{"t":" in the forty-first "},{"t":"year","s":["H8141"],"a":[5]},{"t":" of his "},{"t":"reign","s":["H4427"],"a":[8]},{"t":"."}]},{"n":14,"text":"And they buried him in his own grave, which he had hewn out for himself in the city of David. And they laid him in the resting place, which he had filled with various kinds of spices blended in the perfumer’s art, and they made a very great burning for him.","tok":[{"t":"And they "},{"t":"buried","s":["H6912"],"a":[0]},{"t":" him in his own grave, which he had hewn out for himself in the "},{"t":"city","s":["H5892"],"a":[5]},{"t":" of "},{"t":"David","s":["H1732"],"a":[6]},{"t":". And they "},{"t":"laid","s":["H7901"],"a":[7]},{"t":" him in the resting place, which he had "},{"t":"filled","s":["H4390"],"a":[10]},{"t":" with "},{"t":"various","s":["H1314"],"a":[11]},{"t":" "},{"t":"kinds","s":["H2177"],"a":[12]},{"t":" of spices blended in the perfumer’s "},{"t":"art","s":["H4639"],"a":[15]},{"t":", and they "},{"t":"made","s":["H8313"],"a":[16]},{"t":" a "},{"t":"very","s":["H3966"],"a":[21]},{"t":" "},{"t":"great","s":["H1419"],"a":[19]},{"t":" "},{"t":"burning","s":["H8316"],"a":[18]},{"t":" for him."}]}]}
