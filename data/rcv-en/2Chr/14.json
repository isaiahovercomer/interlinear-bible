":"Judah","s":["H3063"],"a":[1]},{"t":", Let us "},{"t":"build","s":["H1129"],"a":[2]},{"t":" these "},{"t":"cities","s":["H5892"],"a":[4]},{"t":" and put around them "},{"t":"walls","s":["H2346"],"a":[7]},{"t":" with "},{"t":"towers","s":["H4026"],"a":[8]},{"t":", "},{"t":"gates","s":["H1817"],"a":[9]},{"t":", and "},{"t":"bars","s":["H1280"],"a":[10]},{"t":". The "},{"t":"land","s":["H0776"],"a":[12]},{"t":" is still "},{"t":"before","s":["H6440"],"a":[13]},{"t":" us because we have pursued "},{"t":"Jehovah","s":["H3068"],"a":[17]},{"t":" our "},{"t":"God","s":["H0430"],"a":[18]},{"t":"; we have pursued Him, and He has given us "},{"t":"rest","s":["H5117"],"a":[20]},{"t":" all around. So they "},{"t":"built","s":["H1129"],"a":[23]},{"t":" and "},{"t":"prospered","s":["H6743"],"a":[24]},{"t":"."}]},{"n":8,"text":"And Asa had an army of three hundred thousand from Judah who bore shields and spears and of two hundred eighty thousand from Benjamin who bore hand shields and drew bows; all these were mighty men of valor.","tok":[{"t":"And "},{"t":"Asa","s":["H0609"],"a":[1]},{"t":" had an "},{"t":"army","s":["H2428"],"a":[2]},{"t":" of "},{"t":"three","s":["H7969"],"a":[7]},{"t":" "},{"t":"hundred","s":["H3967"],"a":[15]},{"t":" "},{"t":"thousand","s":["H0505"],"a":[17]},{"t":" from "},{"t":"Judah","s":["H3063"],"a":[6]},{"t":" who bore shields and "},{"t":"spears","s":["H7420"],"a":[5]},{"t":" and of two "},{"t":"hundred","s":["H3967"],"a":[8]},{"t":" eighty "},{"t":"thousand","s":["H0505"],"a":[9]},{"t":" from "},{"t":"Benjamin","s":["H1144"],"a":[10]},{"t":" who bore hand "},{"t":"shields","s":["H4043"],"a":[12]},{"t":" and "},{"t":"drew","s":["H1869"],"a":[13]},{"t":" "},{"t":"bows","s":["H7198"],"a":[14]},{"t":"; all these were mighty "},{"t":"men","s":["H1368"],"a":[20]},{"t":" of "},{"t":"valor","s":["H2428"],"a":[21]},{"t":"."}]},{"n":9,"text":"And Zerah the Cushite went out to them with an army of one million men and three hundred chariots, and he came to Mareshah.","tok":[{"t":"And "},{"t":"Zerah","s":["H2226"],"a":[2]},{"t":" the Cushite went "},{"t":"out","s":["H3318"],"a":[0]},{"t":" to them with an army of one million men and "},{"t":"three","s":["H7969"],"a":[8]},{"t":" "},{"t":"hundred","s":["H3967"],"a":[9]},{"t":" "},{"t":"chariots","s":["H4818"],"a":[7]},{"t":", and he "},{"t":"came","s":["H0935"],"a":[10]},{"t":" to "},{"t":"Mareshah","s":["H4762"],"a":[12]},{"t":"."}]},{"n":10,"text":"And Asa went out before him, and they set the battle in array in the valley of Zephathah at Mareshah.","tok":[{"t":"And "},{"t":"Asa","s":["H0609"],"a":[1]},{"t":" went "},{"t":"out","s":["H3318"],"a":[0]},{"t":" before him, and they set the "},{"t":"battle","s":["H4421"],"a":[4]},{"t":" in "},{"t":"array","s":["H6186"],"a":[3]},{"t":" in the "},{"t":"valley","s":["H1516"],"a":[5]},{"t":" of "},{"t":"Zephathah","s":["H6859"],"a":[6]},{"t":" at "},{"t":"Mareshah","s":["H4762"],"a":[7]},{"t":"."}]},{"n":11,"text":"And Asa called out to Jehovah his God and said, O Jehovah, there is none besides You to help us, between the mighty and those without strength. Help us, O Jehovah our God, for we trust in You, and in Your name we have come against this multitude. O Jehovah, You are our God; do not let mortal man prevail against You.","tok":[{"t":"And "},{"t":"Asa","s":["H0609"],"a":[1]},{"t":" called out to "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" his "},{"t":"God","s":["H0430"],"a":[4]},{"t":" and "},{"t":"said","s":["H0559"],"a":[5]},{"t":", O "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":", there is none besides You to "},{"t":"help","s":["H5826"],"a":[9]},{"t":" us, between the mighty and those without strength. "},{"t":"Help","s":["H5826"],"a":[14]},{"t":" us, O "},{"t":"Jehovah","s":["H3068"],"a":[15]},{"t":" our "},{"t":"God","s":["H0430"],"a":[16]},{"t":", for we trust in You, and in Your "},{"t":"name","s":["H8034"],"a":[20]},{"t":" we have come against this "},{"t":"multitude","s":["H1995"],"a":[23]},{"t":". O "},{"t":"Jehovah","s":["H3068"],"a":[25]},{"t":", You are our "},{"t":"God","s":["H0430"],"a":[26]},{"t":"; do not let mortal "},{"t":"man","s":["H0582"],"a":[31]},{"t":" "},{"t":"prevail","s":["H6113"],"a":[29]},{"t":" against You."}]},{"n":12,"text":"And Jehovah struck the Cushites before Asa and before Judah, and the Cushites fled.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" struck the Cushites "},{"t":"before","s":["H6440"],"a":[4]},{"t":" "},{"t":"Asa","s":["H0609"],"a":[5]},{"t":" and "},{"t":"before","s":["H6440"],"a":[6]},{"t":" "},{"t":"Judah","s":["H3063"],"a":[7]},{"t":", and the "},{"t":"Cushites","s":["H3569"],"a":[9]},{"t":" "},{"t":"fled","s":["H5127"],"a":[8]},{"t":"."}]},{"n":13,"text":"And Asa and the people who were with him pursued them as far as Gerar; and so many of the Cushites fell that they could not recover, for they were shattered before Jehovah and before His army. And they carried away very much spoil.","tok":[{"t":"And "},{"t":"Asa","s":["H0609"],"a":[1]},{"t":" and the "},{"t":"people","s":["H5971"],"a":[2]},{"t":" who were with him "},{"t":"pursued","s":["H7291"],"a":[0]},{"t":" them as far as "},{"t":"Gerar","s":["H1642"],"a":[6]},{"t":"; and so many of the Cushites fell that they could not "},{"t":"recover","s":["H4241"],"a":[11]},{"t":", for they were shattered "},{"t":"before","s":["H6440"],"a":[14]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[15]},{"t":" and "},{"t":"before","s":["H6440"],"a":[16]},{"t":" His army. And they carried "},{"t":"away","s":["H5375"],"a":[18]},{"t":" "},{"t":"very","s":["H3966"],"a":[21]},{"t":" "},{"t":"much","s":["H7235"],"a":[20]},{"t":" "},{"t":"spoil","s":["H7998"],"a":[19]},{"t":"."}]},{"n":14,"text":"And they struck all the cities surrounding Gerar, for the fear of Jehovah was upon them. And they plundered all the cities, for there was much plunder in them.","tok":[{"t":"And they struck all the "},{"t":"cities","s":["H5892"],"a":[3]},{"t":" "},{"t":"surrounding","s":["H5439"],"a":[4]},{"t":" "},{"t":"Gerar","s":["H1642"],"a":[5]},{"t":", for the "},{"t":"fear","s":["H6343"],"a":[8]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[9]},{"t":" was upon them. And they plundered all the "},{"t":"cities","s":["H5892"],"a":[14]},{"t":", for there was "},{"t":"much","s":["H7227"],"a":[17]},{"t":" plunder in them."}]},{"n":15,"text":"And they also struck the cattle tents and carried away sheep in abundance and camels, and they returned to Jerusalem.","tok":[{"t":"And they also struck the "},{"t":"cattle","s":["H4735"],"a":[2]},{"t":" "},{"t":"tents","s":["H0168"],"a":[1]},{"t":" and "},{"t":"carried","s":["H4735"],"a":[2]},{"t":" "},{"t":"away","s":["H7617"],"a":[4]},{"t":" "},{"t":"sheep","s":["H6629"],"a":[5]},{"t":" in "},{"t":"abundance","s":["H7230"],"a":[6]},{"t":" and "},{"t":"camels","s":["H1581"],"a":[7]},{"t":", and "},{"t":"they","s":["H7230"],"a":[6]},{"t":" "},{"t":"returned","s":["H7725"],"a":[8]},{"t":" to "},{"t":"Jerusalem","s":["H3389"],"a":[9]},{"t":"."}]}]}
