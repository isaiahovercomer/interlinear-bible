t to You."}]},{"n":30,"text":"Rebuke the animals of the reeds, The herd of the bulls among the calves of the peoples, Trampling on those who lust after silver; Scatter the peoples who take delight in war.","tok":[{"t":"Rebuke","s":["H1605"],"a":[0]},{"t":" the animals of the reeds, The herd of the "},{"t":"bulls","s":["H0047"],"a":[4]},{"t":" among the "},{"t":"calves","s":["H5695"],"a":[5]},{"t":" of the "},{"t":"peoples","s":["H5971"],"a":[6]},{"t":", Trampling on those who lust after "},{"t":"silver","s":["H3701"],"a":[9]},{"t":"; "},{"t":"Scatter","s":["H0967"],"a":[10]},{"t":" the "},{"t":"peoples","s":["H5971"],"a":[11]},{"t":" who take "},{"t":"delight","s":["H2654"],"a":[13]},{"t":" in "},{"t":"war","s":["H7128"],"a":[12]},{"t":"."}]},{"n":31,"text":"Nobles will come out of Egypt; Cush will quickly stretch out its hands to God.","tok":[{"t":"Nobles will come "},{"t":"out","s":["H0857"],"a":[0]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[3]},{"t":"; Cush will quickly stretch "},{"t":"out","s":["H7323"],"a":[5]},{"t":" its "},{"t":"hands","s":["H3027"],"a":[6]},{"t":" to "},{"t":"God","s":["H0430"],"a":[7]},{"t":"."}]},{"n":32,"text":"O kingdoms of the earth, Sing to God, Sing psalms to the Lord, Selah","tok":[{"t":"O "},{"t":"kingdoms","s":["H4467"],"a":[0]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[1]},{"t":", "},{"t":"Sing","s":["H7891"],"a":[2]},{"t":" to "},{"t":"God","s":["H0430"],"a":[3]},{"t":", Sing psalms to the "},{"t":"Lord","s":["H0136"],"a":[5]},{"t":", "},{"t":"Selah","s":["H5542"],"a":[6]}]},{"n":33,"text":"To Him who rides upon the ancient heaven of heavens. Behold, He utters His voice, a mighty voice.","tok":[{"t":"To Him who "},{"t":"rides","s":["H7392"],"a":[0]},{"t":" upon the ancient "},{"t":"heaven","s":["H8064"],"a":[1]},{"t":" of "},{"t":"heavens","s":["H8064"],"a":[2]},{"t":". Behold, He utters His "},{"t":"voice","s":["H6963"],"a":[6]},{"t":", a "},{"t":"mighty","s":["H5797"],"a":[8]},{"t":" "},{"t":"voice","s":["H6963"],"a"