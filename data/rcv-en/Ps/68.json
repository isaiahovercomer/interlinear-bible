{"v":1,"book":"Ps","ch":68,"verses":[{"n":0,"text":"To the choir director. Of David. A Psalm; a Song","tok":[{"t":"To the choir director. Of "},{"t":"David","s":["H1732"],"a":[1]},{"t":". A "},{"t":"Psalm","s":["H4210"],"a":[2]},{"t":"; a "},{"t":"Song","s":["H7892"],"a":[3]}]},{"n":1,"text":"Let God arise; let His enemies be scattered; And let those who hate Him flee before Him.","tok":[{"t":"Let "},{"t":"God","s":["H0430"],"a":[1]},{"t":" "},{"t":"arise","s":["H6965"],"a":[0]},{"t":"; let His "},{"t":"enemies","s":["H0341"],"a":[3]},{"t":" be "},{"t":"scattered","s":["H6327"],"a":[2]},{"t":"; And let those who "},{"t":"hate","s":["H8130"],"a":[5]},{"t":" Him "},{"t":"flee","s":["H5127"],"a":[4]},{"t":" "},{"t":"before","s":["H6440"],"a":[6]},{"t":" Him."}]},{"n":2,"text":"As smoke is driven away, You will drive them away; As wax melts before fire, The wicked will perish before God.","tok":[{"t":"As "},{"t":"smoke","s":["H6227"],"a":[1]},{"t":" is driven "},{"t":"away","s":["H5086"],"a":[0]},{"t":", You will drive them "},{"t":"away","s":["H5086"],"a":[2]},{"t":"; As "},{"t":"wax","s":["H1749"],"a":[4]},{"t":" "},{"t":"melts","s":["H4549"],"a":[3]},{"t":" "},{"t":"before","s":["H6440"],"a":[5]},{"t":" "},{"t":"fire","s":["H0784"],"a":[6]},{"t":", The "},{"t":"wicked","s":["H7563"],"a":[8]},{"t":" will "},{"t":"perish","s":["H0006"],"a":[7]},{"t":" "},{"t":"before","s":["H6440"],"a":[9]},{"t":" "},{"t":"God","s":["H0430"],"a":[10]},{"t":"."}]},{"n":3,"text":"But the righteous will rejoice; they will exult before God And be glad with rejoicing.","tok":[{"t":"But the "},{"t":"righteous","s":["H6662"],"a":[0]},{"t":" "},{"t":"will","s":["H8055"],"a":[1]},{"t":" "},{"t":"rejoice","s":["H5970"],"a":[2]},{"t":"; they will exult "},{"t":"before","s":["H6440"],"a":[3]},{"t":" "},{"t":"God","s":["H0430"],"a":[4]},{"t":" And be "},{"t":"glad","s":["H8055"],"a":[1]},{"t":" with "},{"t":"rejoicing","s":["H7797"],"a":[5]},{"t":"."}]},{"n":4,"text":"Sing to God; sing psalms to Hi