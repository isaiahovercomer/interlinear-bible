{"v":1,"book":"Ps","ch":130,"verses":[{"n":0,"text":"A Song of Ascents","tok":[{"t":"A "},{"t":"Song","s":["H7892"],"a":[0]},{"t":" of "},{"t":"Ascents","s":["H4609"],"a":[1]}]},{"n":1,"text":"Out of the depths I have called upon You, O Jehovah.","tok":[{"t":"Out of the "},{"t":"depths","s":["H4615"],"a":[0]},{"t":" I have called upon You, O "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":"."}]},{"n":2,"text":"O Lord, hear my voice; Let Your ears be attentive To the voice of my supplications.","tok":[{"t":"O "},{"t":"Lord","s":["H0136"],"a":[0]},{"t":", "},{"t":"hear","s":["H8085"],"a":[1]},{"t":" my "},{"t":"voice","s":["H6963"],"a":[2]},{"t":"; Let Your "},{"t":"ears","s":["H0241"],"a":[4]},{"t":" be "},{"t":"attentive","s":["H7183"],"a":[5]},{"t":" To the "},{"t":"voice","s":["H6963"],"a":[6]},{"t":" of my "},{"t":"supplications","s":["H8469"],"a":[7]},{"t":"."}]},{"n":3,"text":"If You, O Jehovah, marked iniquities, Who, O Lord, would stand?","tok":[{"t":"If You, O "},{"t":"Jehovah","s":["H3050"],"a":[3]},{"t":", "},{"t":"marked","s":["H8104"],"a":[2]},{"t":" "},{"t":"iniquities","s":["H5771"],"a":[1]},{"t":", Who, O "},{"t":"Lord","s":["H0136"],"a":[4]},{"t":", would "},{"t":"stand","s":["H5975"],"a":[6]},{"t":"?"}]},{"n":4,"text":"But with You there is forgiveness, That You would be feared.","tok":[{"t":"But with You there is "},{"t":"forgiveness","s":["H5547"],"a":[2]},{"t":", That You would be "},{"t":"feared","s":["H3372"],"a":[4]},{"t":"."}]},{"n":5,"text":"I wait for Jehovah; my soul waits, And in His word I hope.","tok":[{"t":"I "},{"t":"wait","s":["H6960"],"a":[0]},{"t":" for "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":"; my "},{"t":"soul","s":["H5315"],"a":[3]},{"t":" "},{"t":"waits","s":["H6960"],"a":[2]},{"t":", And in His "},{"t":"word","s":["H1697"],"a":[4]},{"t":" I "},{"t":"hope","s":["H3176"],"a":[5]},{"t":"."}]},{"n":6,"text":"My soul waits for the Lord More than watchmen for the morning, Yes, watchmen for the morning.","tok":[{"t":"My "},{"t":"soul","s":["H5315"],"a":[0]},{"t":" waits for the "},{"t":"Lord","s":["H0136"],"a":[1]},{"t":" More than watchmen for the "},{"t":"morning","s":["H1242"],"a":[3]},{"t":", Yes, watchmen for the "},{"t":"morning","s":["H1242"],"a":[5]},{"t":"."}]},{"n":7,"text":"Hope in Jehovah, O Israel; For with Jehovah there is lovingkindness, And with Him abundantly there is redemption;","tok":[{"t":"Hope","s":["H3176"],"a":[0]},{"t":" in "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", O "},{"t":"Israel","s":["H3478"],"a":[1]},{"t":"; For with "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" there is lovingkindness, And with Him abundantly there is "},{"t":"redemption","s":["H6304"],"a":[10]},{"t":";"}]},{"n":8,"text":"And it is He who will redeem Israel From all its iniquities.","tok":[{"t":"And it is He who will "},{"t":"redeem","s":["H6299"],"a":[1]},{"t":" "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":" From all its "},{"t":"iniquities","s":["H5771"],"a":[5]},{"t":"."}]}]}
