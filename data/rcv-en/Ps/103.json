{"v":1,"book":"Ps","ch":103,"verses":[{"n":0,"text":"Of David","tok":[{"t":"Of "},{"t":"David","s":["H1732"],"a":[0]}]},{"n":1,"text":"Bless Jehovah, O my soul; And all that is within me, bless His holy name.","tok":[{"t":"Bless","s":["H1288"],"a":[0]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", O my "},{"t":"soul","s":["H5315"],"a":[1]},{"t":"; And all that is "},{"t":"within","s":["H7130"],"a":[5]},{"t":" me, bless His "},{"t":"holy","s":["H6944"],"a":[8]},{"t":" "},{"t":"name","s":["H8034"],"a":[7]},{"t":"."}]},{"n":2,"text":"Bless Jehovah, O my soul; And do not forget all His benefits:","tok":[{"t":"Bless","s":["H1288"],"a":[0]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", O my "},{"t":"soul","s":["H5315"],"a":[1]},{"t":"; And do not "},{"t":"forget","s":["H7911"],"a":[5]},{"t":" all His "},{"t":"benefits","s":["H1576"],"a":[7]},{"t":":"}]},{"n":3,"text":"He pardons all your iniquities; He heals all your diseases;","tok":[{"t":"He pardons all your "},{"t":"iniquities","s":["H5771"],"a":[2]},{"t":"; He "},{"t":"heals","s":["H7495"],"a":[3]},{"t":" all your "},{"t":"diseases","s":["H8463"],"a":[5]},{"t":";"}]},{"n":4,"text":"He redeems your life from the pit; He crowns you with lovingkindness and compassions;","tok":[{"t":"He "},{"t":"redeems","s":["H1350"],"a":[0]},{"t":" your "},{"t":"life","s":["H2416"],"a":[2]},{"t":" from the pit; He "},{"t":"crowns","s":["H5849"],"a":[3]},{"t":" you with "},{"t":"lovingkindness","s":["H2617"],"a":[4]},{"t":" and "},{"t":"compassions","s":["H7356"],"a":[5]},{"t":";"}]},{"n":5,"text":"He satisfies the prime of your life with good, So that your youth is renewed like the eagle.","tok":[{"t":"He satisfies the prime of your life with "},{"t":"good","s":["H2896"],"a":[1]},{"t":", So that your "},{"t":"youth","s":["H5271"],"a":[5]},{"t":" is "},{"t":"renewed","s":["H2318"],"a":[3]},{"t":" like the eagle."}]},{"n":6,"text":"Jehovah executes righteous acts, And judgments for all who are oppressed.","tok":[{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" "},{"t":"executes","s":["H6213"],"a":[0]},{"t":" righteous acts, And "},{"t":"judgments","s":["H4941"],"a":[3]},{"t":" for all who are "},{"t":"oppressed","s":["H6231"],"a":[5]},{"t":"."}]},{"n":7,"text":"He made His ways known to Moses; His acts, to the children of Israel.","tok":[{"t":"He made His "},{"t":"ways","s":["H1870"],"a":[1]},{"t":" "},{"t":"known","s":["H3045"],"a":[0]},{"t":" to "},{"t":"Moses","s":["H4872"],"a":[2]},{"t":"; His "},{"t":"acts","s":["H5949"],"a":[5]},{"t":", to the "},{"t":"children","s":["H1121"],"a":[3]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[4]},{"t":"."}]},{"n":8,"text":"Jehovah is compassionate and gracious, Long-suffering and abundant in lovingkindness.","tok":[{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" is "},{"t":"compassionate","s":["H7349"],"a":[0]},{"t":" and "},{"t":"gracious","s":["H2587"],"a":[1]},{"t":", Long-suffering and abundant in lovingkindness."}]},{"n":9,"text":"He will not always contend with us, Nor will He keep His anger forever.","tok":[{"t":"He will not "},{"t":"always","s":["H5331"],"a":[1]},{"t":" contend with us, Nor will He "},{"t":"keep","s":["H5201"],"a":[5]},{"t":" His anger forever."}]},{"n":10,"text":"He has not dealt with us according to our sins, Nor has He recompensed us according to our iniquities.","tok":[{"t":"He has not "},{"t":"dealt","s":["H6213"],"a":[2]},{"t":" with us according to our "},{"t":"sins","s":["H2399"],"a":[1]},{"t":", Nor has He recompensed us according to our "},{"t":"iniquities","s":["H5771"],"a":[5]},{"t":"."}]},{"n":11,"text":"For as high as the heavens are above the earth, So great is His lovingkindness upon those who fear Him.","tok":[{"t":"For as high as the "},{"t":"heavens","s":["H8064"],"a":[2]},{"t":" are "},{"t":"above","s":["H1361"],"a":[1]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[4]},{"t":", So "},{"t":"great","s":["H1396"],"a":[5]},{"t":" is His lovingkindness upon those who "},{"t":"fear","s":["H3373"],"a":[8]},{"t":" Him."}]},{"n":12,"text":"As far as the east is from the west, So far has He removed our transgressions from us.","tok":[{"t":"As far "},{"t":"as","s":["H7368"],"a":[0]},{"t":" the "},{"t":"east","s":["H4217"],"a":[1]},{"t":" is from the "},{"t":"west","s":["H4628"],"a":[2]},{"t":", So far has He "},{"t":"removed","s":["H7368"],"a":[3]},{"t":" our "},{"t":"transgressions","s":["H6588"],"a":[6]},{"t":" from us."}]},{"n":13,"text":"As compassionate as a father is toward his children, So compassionate is Jehovah toward those who fear Him.","tok":[{"t":"As compassionate as a "},{"t":"father","s":["H0001"],"a":[1]},{"t":" is toward his "},{"t":"children","s":["H1121"],"a":[3]},{"t":", So compassionate is "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":" toward those who "},{"t":"fear","s":["H3373"],"a":[7]},{"t":" Him."}]},{"n":14,"text":"For He knows our frame; He remembers that we are dust.","tok":[{"t":"For He "},{"t":"knows","s":["H3045"],"a":[2]},{"t":" our "},{"t":"frame","s":["H3336"],"a":[3]},{"t":"; He "},{"t":"remembers","s":["H2142"],"a":[4]},{"t":" that we are "},{"t":"dust","s":["H6083"],"a":[6]},{"t":"."}]},{"n":15,"text":"Man — his days are like grass; He flourishes like a field flower:","tok":[{"t":"Man","s":["H0582"],"a":[0]},{"t":" — his "},{"t":"days","s":["H3117"],"a":[2]},{"t":" are like "},{"t":"grass","s":["H2682"],"a":[1]},{"t":"; He "},{"t":"flourishes","s":["H6692"],"a":[6]},{"t":" like a "},{"t":"field","s":["H7704"],"a":[4]},{"t":" "},{"t":"flower","s":["H6731"],"a":[3]},{"t":":"}]},{"n":16,"text":"For the wind passes over it, and it is no more; And its own place knows of it no longer.","tok":[{"t":"For the "},{"t":"wind","s":["H7307"],"a":[1]},{"t":" passes "},{"t":"over","s":["H5674"],"a":[2]},{"t":" it, and it is no more; And its own "},{"t":"place","s":["H4725"],"a":[8]},{"t":" "},{"t":"knows","s":["H5234"],"a":[6]},{"t":" of it no longer."}]},{"n":17,"text":"But Jehovah’s lovingkindness is from eternity Unto eternity upon those who fear Him, And His righteousness is to the children’s children;","tok":[{"t":"But Jehovah’s lovingkindness is from eternity "},{"t":"Unto","s":["H5704"],"a":[3]},{"t":" eternity upon those who "},{"t":"fear","s":["H3373"],"a":[6]},{"t":" Him, And His "},{"t":"righteousness","s":["H6666"],"a":[7]},{"t":" is to the "},{"t":"children’s","s":["H1121"],"a":[8]},{"t":" "},{"t":"children","s":["H1121"],"a":[9]},{"t":";"}]},{"n":18,"text":"To those who keep His covenant And remember His precepts so as to do them.","tok":[{"t":"To those who "},{"t":"keep","s":["H8104"],"a":[0]},{"t":" His "},{"t":"covenant","s":["H1285"],"a":[1]},{"t":" And "},{"t":"remember","s":["H2142"],"a":[2]},{"t":" His precepts so as to "},{"t":"do","s":["H6213"],"a":[4]},{"t":" them."}]},{"n":19,"text":"Jehovah has established His throne in the heavens, And His kingdom rules over all.","tok":[{"t":"Jehovah","s":["H3068"],"a":[0]},{"t":" has established His "},{"t":"throne","s":["H3678"],"a":[3]},{"t":" in the "},{"t":"heavens","s":["H8064"],"a":[1]},{"t":", And His "},{"t":"kingdom","s":["H4438"],"a":[4]},{"t":" "},{"t":"rules","s":["H4910"],"a":[6]},{"t":" over all."}]},{"n":20,"text":"Bless Jehovah, you His angels, Who are mighty in strength to perform His word, By obeying the voice of His word.","tok":[{"t":"Bless","s":["H1288"],"a":[0]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", you His "},{"t":"angels","s":["H4397"],"a":[2]},{"t":", Who are mighty in "},{"t":"strength","s":["H3581"],"a":[4]},{"t":" to perform His word, By obeying the "},{"t":"voice","s":["H6963"],"a":[8]},{"t":" of His "},{"t":"word","s":["H1697"],"a":[9]},{"t":"."}]},{"n":21,"text":"Bless Jehovah, all you His hosts, You His ministers who execute His will.","tok":[{"t":"Bless","s":["H1288"],"a":[0]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", all you His "},{"t":"hosts","s":["H6635"],"a":[3]},{"t":", You His "},{"t":"ministers","s":["H8334"],"a":[4]},{"t":" who execute His will."}]},{"n":22,"text":"Bless Jehovah, all you His works, In all places of His dominion. Bless Jehovah, O my soul.","tok":[{"t":"Bless","s":["H1288"],"a":[0]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", all you His "},{"t":"works","s":["H4639"],"a":[3]},{"t":", In all "},{"t":"places","s":["H4725"],"a":[5]},{"t":" of His "},{"t":"dominion","s":["H4475"],"a":[6]},{"t":". "},{"t":"Bless","s":["H1288"],"a":[7]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":", O my "},{"t":"soul","s":["H5315"],"a":[8]},{"t":"."}]}]}
