{"v":1,"book":"Ps","ch":115,"verses":[{"n":1,"text":"Not to us, O Jehovah, not to us, But to Your name give glory, For the sake of Your lovingkindness and Your truth.","tok":[{"t":"Not to us, O "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":", not to us, But to Your "},{"t":"name","s":["H8034"],"a":[6]},{"t":" "},{"t":"give","s":["H5414"],"a":[7]},{"t":" "},{"t":"glory","s":["H3519"],"a":[8]},{"t":", For the sake of Your lovingkindness and Your truth."}]},{"n":2,"text":"Why should the nations say, Where then is their God?","tok":[{"t":"Why should the nations "},{"t":"say","s":["H0559"],"a":[1]},{"t":", Where then is their "},{"t":"God","s":["H0430"],"a":[5]},{"t":"?"}]},{"n":3,"text":"But our God is in the heavens; He does whatever He pleases.","tok":[{"t":"But our "},{"t":"God","s":["H0430"],"a":[0]},{"t":" is in the "},{"t":"heavens","s":["H8064"],"a":[1]},{"t":"; He does whatever He "},{"t":"pleases","s":["H2654"],"a":[4]},{"t":"."}]},{"n":4,"text":"Their idols are mere silver and gold, The work of human hands.","tok":[{"t":"Their "},{"t":"idols","s":["H6091"],"a":[0]},{"t":" are mere "},{"t":"silver","s":["H3701"],"a":[1]},{"t":" and "},{"t":"gold","s":["H2091"],"a":[2]},{"t":", The "},{"t":"work","s":["H4639"],"a":[3]},{"t":" of "},{"t":"human","s":["H0120"],"a":[5]},{"t":" "},{"t":"hands","s":["H3027"],"a":[4]},{"t":"."}]},{"n":5,"text":"They have mouths, but they do not speak; They have eyes, but they do not see.","tok":[{"t":"They have "},{"t":"mouths","s":["H6310"],"a":[0]},{"t":", but they do not "},{"t":"speak","s":["H1696"],"a":[3]},{"t":"; They have "},{"t":"eyes","s":["H5869"],"a":[4]},{"t":", but they do not "},{"t":"see","s":["H7200"],"a":[7]},{"t":"."}]},{"n":6,"text":"They have ears, but they do not hear; They have noses, but they do not smell.","tok":[{"t":"They have "},{"t":"ears","s":["H0241"],"a":[0]},{"t":", but they do not "},{"t":"hear","s":["H8085"],"a":[3]},{"t":"; They have "},{"t":"noses","s":["H0639"],"a":[4]},{"t":", but they do not "},{"t":"smell","s":["H7306"],"a":[7]},{"t":"."}]},{"n":7,"text":"They have hands, but they do not feel; They have feet, but they do not walk; They make no sound in their throat.","tok":[{"t":"They have "},{"t":"hands","s":["H3027"],"a":[0]},{"t":", but they do not feel; They have "},{"t":"feet","s":["H7272"],"a":[3]},{"t":", but they do not "},{"t":"walk","s":["H1980"],"a":[5]},{"t":"; They make no sound in their "},{"t":"throat","s":["H1627"],"a":[8]},{"t":"."}]},{"n":8,"text":"Those who make them, All who trust in them, Are like them.","tok":[{"t":"Those who "},{"t":"make","s":["H6213"],"a":[2]},{"t":" them, All who "},{"t":"trust","s":["H0982"],"a":[5]},{"t":" in them, Are like them."}]},{"n":9,"text":"O Israel, trust in Jehovah. He is their help and their shield.","tok":[{"t":"O "},{"t":"Israel","s":["H3478"],"a":[0]},{"t":", "},{"t":"trust","s":["H0982"],"a":[1]},{"t":" in "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":". He is their "},{"t":"help","s":["H5828"],"a":[3]},{"t":" and their "},{"t":"shield","s":["H4043"],"a":[4]},{"t":"."}]},{"n":10,"text":"O house of Aaron, trust in Jehovah. He is their help and their shield.","tok":[{"t":"O "},{"t":"house","s":["H1004"],"a":[0]},{"t":" of "},{"t":"Aaron","s":["H0175"],"a":[1]},{"t":", "},{"t":"trust","s":["H0982"],"a":[2]},{"t":" in "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":". He is their "},{"t":"help","s":["H5828"],"a":[4]},{"t":" and their "},{"t":"shield","s":["H4043"],"a":[5]},{"t":"."}]},{"n":11,"text":"O you who fear Jehovah, trust in Jehovah. He is their help and their shield.","tok":[{"t":"O you who "},{"t":"fear","s":["H3373"],"a":[0]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", "},{"t":"trust","s":["H0982"],"a":[2]},{"t":" in "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":". He is their "},{"t":"help","s":["H5828"],"a":[4]},{"t":" and their "},{"t":"shield","s":["H4043"],"a":[5]},{"t":"."}]},{"n":12,"text":"Jehovah has been mindful of us; He will bless us; He will bless the house of Israel; He will bless the house of Aaron;","tok":[{"t":"Jehovah","s":["H3068"],"a":[0]},{"t":" has been "},{"t":"mindful","s":["H2142"],"a":[1]},{"t":" of us; He will "},{"t":"bless","s":["H1288"],"a":[2]},{"t":" us; He will "},{"t":"bless","s":["H1288"],"a":[3]},{"t":" the "},{"t":"house","s":["H1004"],"a":[5]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[6]},{"t":"; He will "},{"t":"bless","s":["H1288"],"a":[7]},{"t":" the "},{"t":"house","s":["H1004"],"a":[9]},{"t":" of "},{"t":"Aaron","s":["H0175"],"a":[10]},{"t":";"}]},{"n":13,"text":"He will bless those who fear Jehovah, Both small and great.","tok":[{"t":"He will "},{"t":"bless","s":["H1288"],"a":[0]},{"t":" those who "},{"t":"fear","s":["H3373"],"a":[1]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":", Both "},{"t":"small","s":["H6996"],"a":[3]},{"t":" and "},{"t":"great","s":["H1419"],"a":[5]},{"t":"."}]},{"n":14,"text":"May Jehovah give you increase, Both you and your children.","tok":[{"t":"May "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" give you "},{"t":"increase","s":["H3254"],"a":[0]},{"t":", Both you and your "},{"t":"children","s":["H1121"],"a":[5]},{"t":"."}]},{"n":15,"text":"May you be blessed of Jehovah, Maker of heaven and earth.","tok":[{"t":"May you be "},{"t":"blessed","s":["H1288"],"a":[0]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":", "},{"t":"Maker","s":["H6213"],"a":[3]},{"t":" of "},{"t":"heaven","s":["H8064"],"a":[4]},{"t":" and "},{"t":"earth","s":["H0776"],"a":[5]},{"t":"."}]},{"n":16,"text":"The heavens are the heavens of Jehovah, But He has given the earth to the children of men.","tok":[{"t":"The "},{"t":"heavens","s":["H8064"],"a":[0]},{"t":" are the "},{"t":"heavens","s":["H8064"],"a":[1]},{"t":" of Jehovah, But He has "},{"t":"given","s":["H5414"],"a":[4]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[3]},{"t":" to the "},{"t":"children","s":["H1121"],"a":[5]},{"t":" of "},{"t":"men","s":["H0120"],"a":[6]},{"t":"."}]},{"n":17,"text":"The dead do not praise Jehovah, Nor do any that go down into silence.","tok":[{"t":"The "},{"t":"dead","s":["H4191"],"a":[1]},{"t":" do not "},{"t":"praise","s":["H1984"],"a":[2]},{"t":" "},{"t":"Jehovah","s":["H3050"],"a":[3]},{"t":", Nor do any that go "},{"t":"down","s":["H3381"],"a":[6]},{"t":" into "},{"t":"silence","s":["H1745"],"a":[7]},{"t":"."}]},{"n":18,"text":"But we will bless Jehovah From now and to eternity. Hallelujah.","tok":[{"t":"But we will "},{"t":"bless","s":["H1288"],"a":[1]},{"t":" "},{"t":"Jehovah","s":["H3050"],"a":[2]},{"t":" From now and to eternity. Hallelujah."}]}]}
