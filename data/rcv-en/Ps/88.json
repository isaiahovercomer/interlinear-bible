ide Your face from me?","tok":[{"t":"Why, O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", have You rejected my "},{"t":"soul","s":["H5315"],"a":[3]},{"t":"? Why do You "},{"t":"hide","s":["H5641"],"a":[4]},{"t":" Your "},{"t":"face","s":["H6440"],"a":[5]},{"t":" from me?"}]},{"n":15,"text":"I have been afflicted and about to die since my youth; I bear Your terrors; I am overwhelmed.","tok":[{"t":"I have been "},{"t":"afflicted","s":["H6041"],"a":[0]},{"t":" and about to "},{"t":"die","s":["H1478"],"a":[2]},{"t":" since my "},{"t":"youth","s":["H5290"],"a":[3]},{"t":"; I bear Your "},{"t":"terrors","s":["H0367"],"a":[5]},{"t":"; I am overwhelmed."}]},{"n":16,"text":"Your fierce wrath has gone over me; Your terrors have cut me off.","tok":[{"t":"Your fierce "},{"t":"wrath","s":["H2740"],"a":[2]},{"t":" has gone "},{"t":"over","s":["H5674"],"a":[1]},{"t":" me; Your "},{"t":"terrors","s":["H1161"],"a":[3]},{"t":" have cut me "},{"t":"off","s":["H6789"],"a":[4]},{"t":"."}]},{"n":17,"text":"They surrounded me like water all day long; They altogether encompassed me.","tok":[{"t":"They surrounded me like "},{"t":"water","s":["H4325"],"a":[1]},{"t":" all day long; They altogether encompassed me."}]},{"n":18,"text":"You have put far from me Lover and friend; My acquaintances are in darkness.","tok":[{"t":"You have put "},{"t":"far","s":["H7368"],"a":[0]},{"t":" from me "},{"t":"Lover","s":["H0157"],"a":[2]},{"t":" and "},{"t":"friend","s":["H7453"],"a":[3]},{"t":"; "},{"t":"My","s":["H7368"],"a":[0]},{"t":" "},{"t":"acquaintances","s":["H3045"],"a":[4]},{"t":" are in "},{"t":"darkness","s":["H4285"],"a":[5]},{"t":"."}]}]}
