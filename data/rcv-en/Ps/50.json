{"v":1,"book":"Ps","ch":50,"verses":[{"n":0,"text":"A Psalm of Asaph","tok":[{"t":"A "},{"t":"Psalm","s":["H4210"],"a":[0]},{"t":" of "},{"t":"Asaph","s":["H0623"],"a":[1]}]},{"n":1,"text":"The Mighty One, God Jehovah, Speaks and summons the earth From the rising of the sun to its setting.","tok":[{"t":"The "},{"t":"Mighty","s":["H0410"],"a":[0]},{"t":" One, "},{"t":"God","s":["H0430"],"a":[1]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":", Speaks and summons the "},{"t":"earth","s":["H0776"],"a":[5]},{"t":" From the "},{"t":"rising","s":["H4217"],"a":[6]},{"t":" of the "},{"t":"sun","s":["H8121"],"a":[7]},{"t":" to its setting."}]},{"n":2,"text":"Out of Zion, the perfection of beauty, God shines forth.","tok":[{"t":"Out of "},{"t":"Zion","s":["H6726"],"a":[0]},{"t":", the "},{"t":"perfection","s":["H4359"],"a":[1]},{"t":" of "},{"t":"beauty","s":["H3308"],"a":[2]},{"t":", "},{"t":"God","s":["H0430"],"a":[3]},{"t":" "},{"t":"shines","s":["H3313"],"a":[4]},{"t":" forth."}]},{"n":3,"text":"Our God has come and will not be silent; Fire devours before Him, And around Him it is exceedingly tempestuous.","tok":[{"t":"Our "},{"t":"God","s":["H0430"],"a":[1]},{"t":" has "},{"t":"come","s":["H0935"],"a":[0]},{"t":" and will not be silent; "},{"t":"Fire","s":["H0784"],"a":[4]},{"t":" "},{"t":"devours","s":["H0398"],"a":[6]},{"t":" "},{"t":"before","s":["H6440"],"a":[5]},{"t":" Him, And around Him it is exceedingly "},{"t":"tempestuous","s":["H8175"],"a":[8]},{"t":"."}]},{"n":4,"text":"He calls to the heavens above, And to the earth that He may judge His people:","tok":[{"t":"He "},{"t":"calls","s":["H7121"],"a":[0]},{"t":" to the "},{"t":"heavens","s":["H8064"],"a":[2]},{"t":" "},{"t":"above","s":["H5920"],"a":[3]},{"t":", And to the "},{"t":"earth","s":["H0776"],"a":[5]},{"t":" that He may "},{"t":"judge","s":["H1777"],"a":[6]},{"t":" His "},{"t":"people","s":["H5971"],"a":[7]},{"t":":"}]},{"n":5,"text":"Gather My saints to Me, Those who have made a covenant with Me by sacrifice.","tok":[{"t":"Gather","s":["H0622"],"a":[0]},{"t":" My "},{"t":"saints","s":["H2623"],"a":[2]},{"t":" to Me, Those who have "},{"t":"made","s":["H3772"],"a":[3]},{"t":" a "},{"t":"covenant","s":["H1285"],"a":[4]},{"t":" with Me by "},{"t":"sacrifice","s":["H2077"],"a":[6]},{"t":"."}]},{"n":6,"text":"Then the heavens declare His righteousness, For God Himself is Judge. Selah","tok":[{"t":"Then the "},{"t":"heavens","s":["H8064"],"a":[1]},{"t":" "},{"t":"declare","s":["H5046"],"a":[0]},{"t":" His "},{"t":"righteousness","s":["H6664"],"a":[2]},{"t":", For "},{"t":"God","s":["H0430"],"a":[4]},{"t":" Himself is "},{"t":"Judge","s":["H8199"],"a":[5]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[7]}]},{"n":7,"text":"Hear, O My people, and I will speak; O Israel, and I will testify against you: I am God, your God.","tok":[{"t":"Hear","s":["H8085"],"a":[0]},{"t":", O My "},{"t":"people","s":["H5971"],"a":[1]},{"t":", and I will "},{"t":"speak","s":["H1696"],"a":[2]},{"t":"; O "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":", and I will "},{"t":"testify","s":["H5749"],"a":[4]},{"t":" against you: I am "},{"t":"God","s":["H0430"],"a":[6]},{"t":", your "},{"t":"God","s":["H0430"],"a":[7]},{"t":"."}]},{"n":8,"text":"I will not reprove you because of your sacrifices, And your burnt offerings are before Me continually.","tok":[{"t":"I will not "},{"t":"reprove","s":["H3198"],"a":[3]},{"t":" you because of your "},{"t":"sacrifices","s":["H2077"],"a":[2]},{"t":", And your burnt "},{"t":"offerings","s":["H5930"],"a":[4]},{"t":" are before Me "},{"t":"continually","s":["H8548"],"a":[6]},{"t":"."}]},{"n":9,"text":"I will not take a bull from your house Nor goats from your folds,","tok":[{"t":"I will not "},{"t":"take","s":["H3947"],"a":[1]},{"t":" a bull from your "},{"t":"house","s":["H1004"],"a":[2]},{"t":" Nor "},{"t":"goats","s":["H6260"],"a":[5]},{"t":" from your "},{"t":"folds","s":["H4356"],"a":[4]},{"t":","}]},{"n":10,"text":"For every animal of the forest is Mine, The cattle upon a thousand hills.","tok":[{"t":"For every animal of the "},{"t":"forest","s":["H3293"],"a":[4]},{"t":" is Mine, The "},{"t":"cattle","s":["H0929"],"a":[5]},{"t":" upon a "},{"t":"thousand","s":["H0505"],"a":[7]},{"t":" "},{"t":"hills","s":["H2042"],"a":[6]},{"t":"."}]},{"n":11,"text":"I know every bird of the mountains, And I am aware of everything that moves in the field.","tok":[{"t":"I "},{"t":"know","s":["H3045"],"a":[0]},{"t":" every bird of the "},{"t":"mountains","s":["H2022"],"a":[3]},{"t":", And I am aware of everything that moves in the "},{"t":"field","s":["H7704"],"a":[5]},{"t":"."}]},{"n":12,"text":"If I were hungry, I would not tell you; For the world is Mine and the fullness thereof.","tok":[{"t":"If I were "},{"t":"hungry","s":["H7456"],"a":[1]},{"t":", I would not "},{"t":"tell","s":["H0559"],"a":[3]},{"t":" you; For the "},{"t":"world","s":["H8398"],"a":[7]},{"t":" is Mine and the fullness thereof."}]},{"n":13,"text":"Shall I eat the flesh of bulls Or drink the blood of goats?","tok":[{"t":"Shall I "},{"t":"eat","s":["H0398"],"a":[0]},{"t":" the "},{"t":"flesh","s":["H1320"],"a":[1]},{"t":" of "},{"t":"bulls","s":["H0047"],"a":[2]},{"t":" Or "},{"t":"drink","s":["H8354"],"a":[5]},{"t":" the "},{"t":"blood","s":["H1818"],"a":[3]},{"t":" of "},{"t":"goats","s":["H6260"],"a":[4]},{"t":"?"}]},{"n":14,"text":"Offer to God a sacrifice of thanksgiving, And repay your vows to the Most High;","tok":[{"t":"Offer","s":["H2076"],"a":[0]},{"t":" to "},{"t":"God","s":["H0430"],"a":[1]},{"t":" a sacrifice of "},{"t":"thanksgiving","s":["H8426"],"a":[2]},{"t":", And repay your "},{"t":"vows","s":["H5088"],"a":[5]},{"t":" to the Most "},{"t":"High","s":["H5945"],"a":[4]},{"t":";"}]},{"n":15,"text":"And call upon Me in the day of trouble: I will deliver you, and you will glorify Me.","tok":[{"t":"And "},{"t":"call","s":["H7121"],"a":[0]},{"t":" upon Me in the "},{"t":"day","s":["H3117"],"a":[1]},{"t":" of "},{"t":"trouble","s":["H6869"],"a":[2]},{"t":": I will "},{"t":"deliver","s":["H2502"],"a":[3]},{"t":" you, and you will "},{"t":"glorify","s":["H3513"],"a":[4]},{"t":" Me."}]},{"n":16,"text":"But to the wicked God says, What right do you have to declare My statutes And take up My covenant in your mouth,","tok":[{"t":"But to the "},{"t":"wicked","s":["H7563"],"a":[0]},{"t":" "},{"t":"God","s":["H0430"],"a":[2]},{"t":" "},{"t":"says","s":["H0559"],"a":[1]},{"t":", What right do you have to "},{"t":"declare","s":["H5608"],"a":[5]},{"t":" My "},{"t":"statutes","s":["H2706"],"a":[6]},{"t":" And "},{"t":"take","s":["H5375"],"a":[7]},{"t":" up My "},{"t":"covenant","s":["H1285"],"a":[8]},{"t":" in your "},{"t":"mouth","s":["H6310"],"a":[10]},{"t":","}]},{"n":17,"text":"Seeing that you hate correction And cast My words behind you?","tok":[{"t":"Seeing that you "},{"t":"hate","s":["H8130"],"a":[1]},{"t":" "},{"t":"correction","s":["H4148"],"a":[2]},{"t":" And "},{"t":"cast","s":["H7993"],"a":[3]},{"t":" My "},{"t":"words","s":["H1697"],"a":[4]},{"t":" "},{"t":"behind","s":["H0310"],"a":[5]},{"t":" you?"}]},{"n":18,"text":"When you see a thief, you take pleasure in him; And your portion is with adulterers.","tok":[{"t":"When you see a "},{"t":"thief","s":["H1590"],"a":[2]},{"t":", you take pleasure in him; And your portion is with "},{"t":"adulterers","s":["H5003"],"a":[6]},{"t":"."}]},{"n":19,"text":"You let your mouth loose for evil, And your tongue frames deceit.","tok":[{"t":"You let your "},{"t":"mouth","s":["H6310"],"a":[0]},{"t":" loose for "},{"t":"evil","s":["H7451"],"a":[2]},{"t":", And your "},{"t":"tongue","s":["H3956"],"a":[3]},{"t":" "},{"t":"frames","s":["H6775"],"a":[4]},{"t":" "},{"t":"deceit","s":["H4820"],"a":[5]},{"t":"."}]},{"n":20,"text":"You sit and speak against your brother; You defame the son of your mother.","tok":[{"t":"You sit and "},{"t":"speak","s":["H1696"],"a":[2]},{"t":" against your "},{"t":"brother","s":["H0251"],"a":[1]},{"t":"; "},{"t":"You","s":["H5414"],"a":[5]},{"t":" defame the "},{"t":"son","s":["H1121"],"a":[3]},{"t":" of your mother."}]},{"n":21,"text":"These things you do, and I keep silent; You think that I am altogether like you. I will rebuke you and set forth the matter in order before your eyes.","tok":[{"t":"These things you do, and I keep silent; You think that I am "},{"t":"altogether","s":["H1961"],"a":[4]},{"t":" like you. I will rebuke you and set forth the matter in "},{"t":"order","s":["H6186"],"a":[8]},{"t":" before your "},{"t":"eyes","s":["H5869"],"a":[9]},{"t":"."}]},{"n":22,"text":"Consider this then, you who forget God, Lest I tear you apart and there be none to deliver you.","tok":[{"t":"Consider","s":["H0995"],"a":[0]},{"t":" this then, you who "},{"t":"forget","s":["H7911"],"a":[3]},{"t":" "},{"t":"God","s":["H0433"],"a":[4]},{"t":", Lest I tear you apart and there be none to "},{"t":"deliver","s":["H5337"],"a":[8]},{"t":" you."}]},{"n":23,"text":"Whoever offers a sacrifice of thanksgiving glorifies Me; And to him who sets his way right I will show the salvation of God.","tok":[{"t":"Whoever "},{"t":"offers","s":["H2076"],"a":[0]},{"t":" a sacrifice of thanksgiving glorifies Me; And to him who sets his way right I will show the "},{"t":"salvation","s":["H3468"],"a":[6]},{"t":" of "},{"t":"God","s":["H0430"],"a":[7]},{"t":"."}]}]}
