{"v":1,"book":"Ps","ch":132,"verses":[{"n":0,"text":"A Song of Ascents","tok":[{"t":"A "},{"t":"Song","s":["H7892"],"a":[0]},{"t":" of "},{"t":"Ascents","s":["H4609"],"a":[1]}]},{"n":1,"text":"Remember, O Jehovah, for David’s sake All his afflictions;","tok":[{"t":"Remember","s":["H2142"],"a":[0]},{"t":", O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", for David’s sake All his "},{"t":"afflictions","s":["H6031"],"a":[5]},{"t":";"}]},{"n":2,"text":"How he swore to Jehovah And vowed to the Mighty One of Jacob:","tok":[{"t":"How he "},{"t":"swore","s":["H7650"],"a":[1]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" And "},{"t":"vowed","s":["H5087"],"a":[3]},{"t":" to the "},{"t":"Mighty","s":["H0046"],"a":[4]},{"t":" One of "},{"t":"Jacob","s":["H3290"],"a":[5]},{"t":":"}]},{"n":3,"text":"I shall not go into the tent of my house; I shall not go up onto the couch of my bed;","tok":[{"t":"I shall not go into the tent of my "},{"t":"house","s":["H1004"],"a":[3]},{"t":"; I shall not go "},{"t":"up","s":["H5927"],"a":[5]},{"t":" onto the couch of my "},{"t":"bed","s":["H6210"],"a":[7]},{"t":";"}]},{"n":4,"text":"I shall not give sleep to my eyes, Slumber to my eyelids;","tok":[{"t":"I shall not "},{"t":"give","s":["H5414"],"a":[1]},{"t":" "},{"t":"sleep","s":["H8153"],"a":[2]},{"t":" to my "},{"t":"eyes","s":["H5869"],"a":[3]},{"t":", "},{"t":"Slumber","s":["H8572"],"a":[5]},{"t":" to my "},{"t":"eyelids","s":["H6079"],"a":[4]},{"t":";"}]},{"n":5,"text":"Until I find a place for Jehovah, A tabernacle for the Mighty One of Jacob.","tok":[{"t":"Until I find a "},{"t":"place","s":["H4725"],"a":[2]},{"t":" for "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", A "},{"t":"tabernacle","s":["H4908"],"a":[4]},{"t":" for the "},{"t":"Mighty","s":["H0046"],"a":[5]},{"t":" One of "},{"t":"Jacob","s":["H3290"],"a":[6]},{"t":"."}]},{"n":6,"text":"Behold, we heard of it in Ephrathah; We found it in the fields of Jaar.","tok":[{"t":"Behold, we "},{"t":"heard","s":["H8085"],"a