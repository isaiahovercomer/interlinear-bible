{"v":1,"book":"Ps","ch":76,"verses":[{"n":0,"text":"To the choir director: on the stringed instruments. A Psalm of Asaph; a Song","tok":[{"t":"To the choir director: on the stringed instruments. A "},{"t":"Psalm","s":["H4210"],"a":[2]},{"t":" of "},{"t":"Asaph","s":["H0623"],"a":[3]},{"t":"; a "},{"t":"Song","s":["H7892"],"a":[4]}]},{"n":1,"text":"God is known in Judah; His name is great in Israel.","tok":[{"t":"God","s":["H0430"],"a":[2]},{"t":" is "},{"t":"known","s":["H3045"],"a":[0]},{"t":" in "},{"t":"Judah","s":["H3063"],"a":[1]},{"t":"; His "},{"t":"name","s":["H8034"],"a":[5]},{"t":" is "},{"t":"great","s":["H1419"],"a":[4]},{"t":" in "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":"."}]},{"n":2,"text":"And in Salem is His tabernacle, And His dwelling place, in Zion.","tok":[{"t":"And in "},{"t":"Salem","s":["H8004"],"a":[1]},{"t":" is His "},{"t":"tabernacle","s":["H5520"],"a":[2]},{"t":", And His dwelling "},{"t":"place","s":["H4585"],"a":[3]},{"t":", in "},{"t":"Zion","s":["H6726"],"a":[4]},{"t":"."}]},{"n":3,"text":"There He broke the flashing arrows of the bow, The shield and the sword and the battle. Selah","tok":[{"t":"There He broke the flashing "},{"t":"arrows","s":["H7565"],"a":[2]},{"t":" of the "},{"t":"bow","s":["H7198"],"a":[3]},{"t":", The "},{"t":"shield","s":["H4043"],"a":[4]},{"t":" and the "},{"t":"sword","s":["H2719"],"a":[5]},{"t":" and the "},{"t":"battle","s":["H4421"],"a":[6]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[7]}]},{"n":4,"text":"More glorious are You, More excellent than the mountains of prey.","tok":[{"t":"More "},{"t":"glorious","s":["H0215"],"a":[0]},{"t":" are You, More "},{"t":"excellent","s":["H0117"],"a":[2]},{"t":" than the "},{"t":"mountains","s":["H2042"],"a":[3]},{"t":" of "},{"t":"prey","s":["H2964"],"a":[4]},{"t":"."}]},{"n":5,"text":"The stouthearted are despoiled; They slept their sleep, And none of the men of strength Have found their hands.","tok":[{"t":"The "},{"t":"stouthearted","s":["H0047"],"a":[1]},{"t":" are despoiled; They "},{"t":"slept","s":["H5123"],"a":[3]},{"t":" their "},{"t":"sleep","s":["H8142"],"a":[4]},{"t":", And none of the "},{"t":"men","s":["H0582"],"a":[8]},{"t":" of strength Have "},{"t":"found","s":["H4672"],"a":[6]},{"t":" their "},{"t":"hands","s":["H3027"],"a":[10]},{"t":"."}]},{"n":6,"text":"At Your rebuke, O God of Jacob, Both chariot and horse fall into deep sleep.","tok":[{"t":"At Your "},{"t":"rebuke","s":["H1606"],"a":[0]},{"t":", O "},{"t":"God","s":["H0430"],"a":[1]},{"t":" of "},{"t":"Jacob","s":["H3290"],"a":[2]},{"t":", Both "},{"t":"chariot","s":["H7393"],"a":[4]},{"t":" and "},{"t":"horse","s":["H5483"],"a":[5]},{"t":" fall into deep "},{"t":"sleep","s":["H7290"],"a":[3]},{"t":"."}]},{"n":7,"text":"You, indeed You, are to be feared; And who may stand before You once You are angry?","tok":[{"t":"You, indeed You, are to be "},{"t":"feared","s":["H3372"],"a":[1]},{"t":"; And who may "},{"t":"stand","s":["H5975"],"a":[4]},{"t":" before You once You are "},{"t":"angry","s":["H0639"],"a":[7]},{"t":"?"}]},{"n":8,"text":"You caused judgment to be heard from the heavens; The earth feared and was still,","tok":[{"t":"You caused "},{"t":"judgment","s":["H1779"],"a":[2]},{"t":" to be "},{"t":"heard","s":["H8085"],"a":[1]},{"t":" from the "},{"t":"heavens","s":["H8064"],"a":[0]},{"t":"; The "},{"t":"earth","s":["H0776"],"a":[3]},{"t":" "},{"t":"feared","s":["H3372"],"a":[4]},{"t":" and was "},{"t":"still","s":["H8252"],"a":[5]},{"t":","}]},{"n":9,"text":"When God rose for judgment, To save all the meek of the earth. Selah","tok":[{"t":"When "},{"t":"God","s":["H0430"],"a":[2]},{"t":" "},{"t":"rose","s":["H6965"],"a":[0]},{"t":" for "},{"t":"judgment","s":["H4941"],"a":[1]},{"t":", To "},{"t":"save","s":["H3467"],"a":[3]},{"t":" all the "},{"t":"meek","s":["H6035"],"a":[5]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[6]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[7]}]},{"n":10,"text":"For the wrath of man will praise You; You will gird Yourself with the remainder of wrath.","tok":[{"t":"For the "},{"t":"wrath","s":["H2534"],"a":[1]},{"t":" of "},{"t":"man","s":["H0120"],"a":[2]},{"t":" will "},{"t":"praise","s":["H3034"],"a":[3]},{"t":" You; You will gird Yourself with the "},{"t":"remainder","s":["H7611"],"a":[4]},{"t":" of "},{"t":"wrath","s":["H2534"],"a":[5]},{"t":"."}]},{"n":11,"text":"Make vows and pay them to Jehovah your God; Let all who are around Him bring gifts to Him who is to be feared.","tok":[{"t":"Make "},{"t":"vows","s":["H5087"],"a":[0]},{"t":" and "},{"t":"pay","s":["H7999"],"a":[1]},{"t":" them to "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" your "},{"t":"God","s":["H0430"],"a":[3]},{"t":"; Let all who are around Him "},{"t":"bring","s":["H2986"],"a":[6]},{"t":" gifts to Him who is to be "},{"t":"feared","s":["H4172"],"a":[8]},{"t":"."}]},{"n":12,"text":"He will cut off the spirit of the princes; He is terrible to the kings of the earth.","tok":[{"t":"He will cut "},{"t":"off","s":["H1219"],"a":[0]},{"t":" the "},{"t":"spirit","s":["H7307"],"a":[1]},{"t":" of the "},{"t":"princes","s":["H5057"],"a":[2]},{"t":"; He is "},{"t":"terrible","s":["H3372"],"a":[3]},{"t":" to the "},{"t":"kings","s":["H4428"],"a":[4]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[5]},{"t":"."}]}]}
