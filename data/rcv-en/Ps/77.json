"},{"t":"years","s":["H8141"],"a":[3]},{"t":" of the right "},{"t":"hand","s":["H3225"],"a":[4]},{"t":" of the Most "},{"t":"High","s":["H5945"],"a":[5]},{"t":"."}]},{"n":11,"text":"I will bring to remembrance the deeds of Jehovah, For I will remember Your wonders from of old.","tok":[{"t":"I will bring to remembrance the deeds of "},{"t":"Jehovah","s":["H3050"],"a":[2]},{"t":", For I will "},{"t":"remember","s":["H2142"],"a":[4]},{"t":" Your "},{"t":"wonders","s":["H6382"],"a":[6]},{"t":" from of "},{"t":"old","s":["H6924"],"a":[5]},{"t":"."}]},{"n":12,"text":"And I will meditate on all that You have done And muse on Your doings.","tok":[{"t":"And I will "},{"t":"meditate","s":["H1897"],"a":[0]},{"t":" on all that You have done And muse on Your "},{"t":"doings","s":["H5949"],"a":[3]},{"t":"."}]},{"n":13,"text":"O God, Your way is in the sanctuary; Who is so great a god as God?","tok":[{"t":"O","s":["H1870"],"a":[2]},{"t":" "},{"t":"God","s":["H0430"],"a":[0]},{"t":", Your "},{"t":"way","s":["H1870"],"a":[2]},{"t":" is in the "},{"t":"sanctuary","s":["H6944"],"a":[1]},{"t":"; Who is so "},{"t":"great","s":["H1419"],"a":[5]},{"t":" a "},{"t":"god","s":["H0410"],"a":[4]},{"t":" as "},{"t":"God","s":["H0430"],"a":[6]},{"t":"?"}]},{"n":14,"text":"You are the God who does wonders; You have made known Your strength among the peoples.","tok":[{"t":"You are the "},{"t":"God","s":["H0410"],"a":[1]},{"t":" who "},{"t":"does","s":["H6213"],"a":[2]},{"t":" "},{"t":"wonders","s":["H6382"],"a":[3]},{"t":"; You have made known Your "},{"t":"strength","s":["H5797"],"a":[6]},{"t":" among the "},{"t":"peoples","s":["H5971"],"a":[5]},{"t":"."}]},{"n":15,"text":"You redeemed Your people with Your arm, The sons of Jacob and Joseph. Selah","tok":[{"t":"You","s":["H2220"],"a":[1]},{"t":" "},{"t":"redeemed","s":["H1350"],"a":[0]},{"t":" Your "},{"t":"people","s":["H5971"],"a":[2]},{"t":" with Your "},{"t":"arm","s":["H2220"],"a":[1]},{"t":", The "},{"t":"sons","s":["H1121"],"a":[3]},{"t":"