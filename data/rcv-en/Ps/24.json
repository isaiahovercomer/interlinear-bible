{"v":1,"book":"Ps","ch":24,"verses":[{"n":0,"text":"A Psalm of David","tok":[{"t":"A "},{"t":"Psalm","s":["H4210"],"a":[1]},{"t":" of "},{"t":"David","s":["H1732"],"a":[0]}]},{"n":1,"text":"The earth is Jehovah’s, and its fullness, The habitable land and those who dwell in it.","tok":[{"t":"The "},{"t":"earth","s":["H0776"],"a":[1]},{"t":" is Jehovah’s, and its fullness, The habitable land and those who "},{"t":"dwell","s":["H3427"],"a":[4]},{"t":" in it."}]},{"n":2,"text":"For it is He who founded it upon the seas And established it upon the streams.","tok":[{"t":"For it is He who "},{"t":"founded","s":["H3245"],"a":[4]},{"t":" it upon the "},{"t":"seas","s":["H3220"],"a":[3]},{"t":" And "},{"t":"established","s":["H3559"],"a":[7]},{"t":" it upon the "},{"t":"streams","s":["H5104"],"a":[6]},{"t":"."}]},{"n":3,"text":"Who may ascend the mountain of Jehovah, And who may stand in His holy place?","tok":[{"t":"Who may "},{"t":"ascend","s":["H5927"],"a":[1]},{"t":" the "},{"t":"mountain","s":["H2022"],"a":[2]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", And who may "},{"t":"stand","s":["H6965"],"a":[5]},{"t":" in His "},{"t":"holy","s":["H6944"],"a":[7]},{"t":" "},{"t":"place","s":["H4725"],"a":[6]},{"t":"?"}]},{"n":4,"text":"He who has clean hands and a pure heart, Who has not lifted up his soul to falsehood Or sworn deceitfully.","tok":[{"t":"He who has "},{"t":"clean","s":["H5355"],"a":[0]},{"t":" "},{"t":"hands","s":["H3709"],"a":[1]},{"t":" and a "},{"t":"pure","s":["H1249"],"a":[2]},{"t":" "},{"t":"heart","s":["H3824"],"a":[3]},{"t":", Who has not lifted "},{"t":"up","s":["H5375"],"a":[6]},{"t":" his "},{"t":"soul","s":["H5315"],"a":[8]},{"t":" to "},{"t":"falsehood","s":["H7723"],"a":[7]},{"t":" Or "},{"t":"sworn","s":["H7650"],"a":[10]},{"t":" "},{"t":"deceitfully","s":["H4820"],"a":[11]},{"t":"."}]},{"n":5,"text":"He will receive blessing from Jehovah, And righteousness from the God of his salvation.","tok":[{"t":"He will "},{"t":"receive","s":["