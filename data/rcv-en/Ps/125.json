{"v":1,"book":"Ps","ch":125,"verses":[{"n":0,"text":"A Song of Ascents","tok":[{"t":"A "},{"t":"Song","s":["H7892"],"a":[0]},{"t":" of "},{"t":"Ascents","s":["H4609"],"a":[1]}]},{"n":1,"text":"Those who trust in Jehovah are like Mount Zion, Which cannot be moved but abides forever.","tok":[{"t":"Those who "},{"t":"trust","s":["H0982"],"a":[0]},{"t":" in "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" are like "},{"t":"Mount","s":["H2022"],"a":[2]},{"t":" "},{"t":"Zion","s":["H6726"],"a":[3]},{"t":", Which cannot be moved but "},{"t":"abides","s":["H3427"],"a":[7]},{"t":" "},{"t":"forever","s":["H5769"],"a":[6]},{"t":"."}]},{"n":2,"text":"Jerusalem — mountains surround her; And Jehovah surrounds His people From now and to eternity.","tok":[{"t":"Jerusalem","s":["H3389"],"a":[0]},{"t":" — "},{"t":"mountains","s":["H2022"],"a":[1]},{"t":" surround her; And "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" surrounds His "},{"t":"people","s":["H5971"],"a":[6]},{"t":" From now and to eternity."}]},{"n":3,"text":"For the scepter of wickedness will not rest Upon the allotment of the righteous, That the righteous would not put forth Their hands to iniquity.","tok":[{"t":"For the scepter of wickedness will not "},{"t":"rest","s":["H5117"],"a":[2]},{"t":" Upon the allotment of the "},{"t":"righteous","s":["H6662"],"a":[11]},{"t":", That the "},{"t":"righteous","s":["H6662"],"a":[7]},{"t":" would not put "},{"t":"forth","s":["H7971"],"a":[10]},{"t":" Their "},{"t":"hands","s":["H3027"],"a":[13]},{"t":" to "},{"t":"iniquity","s":["H5766"],"a":[12]},{"t":"."}]},{"n":4,"text":"Do good, O Jehovah, to the good And to those upright in their hearts.","tok":[{"t":"Do "},{"t":"good","s":["H2895"]},{"t":", O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", to the "},{"t":"good","s":["H2896"],"a":[2]},{"t":" And to those "},{"t":"upright","s":["H3477"],"a":[3]},{"t":" in their "},{"t":"hearts","s":["H3826"],"a":[4]},{"t":"."}]},{"n":5,"text":"But as for those who turn aside to their crooked ways, Jehovah will lead them off with the workers of iniquity. Peace be upon Israel.","tok":[{"t":"But as for those who turn "},{"t":"aside","s":["H5186"],"a":[0]},{"t":" to their crooked "},{"t":"ways","s":["H6128"],"a":[1]},{"t":", "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" will lead them off with the "},{"t":"workers","s":["H6466"],"a":[5]},{"t":" of "},{"t":"iniquity","s":["H0205"],"a":[6]},{"t":". "},{"t":"Peace","s":["H7965"],"a":[7]},{"t":" be upon "},{"t":"Israel","s":["H3478"],"a":[9]},{"t":"."}]}]}
