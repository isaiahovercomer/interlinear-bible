{"v":1,"book":"Ps","ch":87,"verses":[{"n":0,"text":"Of the sons of Korah. A Psalm; a Song","tok":[{"t":"Of the "},{"t":"sons","s":["H1121"],"a":[0]},{"t":" of "},{"t":"Korah","s":["H7141"],"a":[1]},{"t":". A "},{"t":"Psalm","s":["H4210"],"a":[2]},{"t":"; a "},{"t":"Song","s":["H7892"],"a":[3]}]},{"n":1,"text":"His foundation is in the holy mountains.","tok":[{"t":"His "},{"t":"foundation","s":["H3248"],"a":[0]},{"t":" is in the "},{"t":"holy","s":["H6944"],"a":[2]},{"t":" "},{"t":"mountains","s":["H2042"],"a":[1]},{"t":"."}]},{"n":2,"text":"Jehovah loves the gates of Zion More than all the dwellings of Jacob.","tok":[{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"loves","s":["H0157"],"a":[0]},{"t":" the "},{"t":"gates","s":["H8179"],"a":[2]},{"t":" of "},{"t":"Zion","s":["H6726"],"a":[3]},{"t":" More than all the "},{"t":"dwellings","s":["H4908"],"a":[5]},{"t":" of "},{"t":"Jacob","s":["H3290"],"a":[6]},{"t":"."}]},{"n":3,"text":"Glorious things are spoken of you, O city of God. Selah","tok":[{"t":"Glorious "},{"t":"things","s":["H3513"],"a":[0]},{"t":" are "},{"t":"spoken","s":["H1696"],"a":[1]},{"t":" of you, O "},{"t":"city","s":["H5892"],"a":[3]},{"t":" of "},{"t":"God","s":["H0430"],"a":[4]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[5]}]},{"n":4,"text":"I will make mention of Rahab and Babylon as those who know Me; Behold, Philistia and Tyre along with Cush: This one was born there, they say.","tok":[{"t":"I will make "},{"t":"mention","s":["H2142"],"a":[0]},{"t":" of "},{"t":"Rahab","s":["H7294"]},{"t":" and "},{"t":"Babylon","s":["H0894"],"a":[2]},{"t":" as those who "},{"t":"know","s":["H3045"],"a":[3]},{"t":" Me; Behold, "},{"t":"Philistia","s":["H6429"],"a":[5]},{"t":" and "},{"t":"Tyre","s":["H6865"],"a":[6]},{"t":" along with Cush: This one was "},{"t":"born","s":["H3205"],"a":[10]},{"t":" there, they say."}]},{"n":5,"text":"But of Zion it will be said, This one and that one were born in her, And the Most High Himself will establish her.","tok":[{"t":"But of "},{"t":"Zion","s":["H6726"],"a":[0]},{"t":" it will be "},{"t":"said","s":["H0559"],"a":[1]},{"t":", This one and that one were "},{"t":"born","s":["H3205"],"a":[4]},{"t":" in her, And the Most "},{"t":"High","s":["H5945"],"a":[8]},{"t":" Himself will "},{"t":"establish","s":["H3559"],"a":[7]},{"t":" her."}]},{"n":6,"text":"Jehovah will count When He records the peoples: This One was born there. Selah","tok":[{"t":"Jehovah","s":["H3068"],"a":[0]},{"t":" will "},{"t":"count","s":["H5608"],"a":[1]},{"t":" When He records the "},{"t":"peoples","s":["H5971"],"a":[3]},{"t":": This One was "},{"t":"born","s":["H3205"],"a":[5]},{"t":" there. "},{"t":"Selah","s":["H5542"],"a":[7]}]},{"n":7,"text":"Then singing as well as dancing, they will say, All my springs are in you.","tok":[{"t":"Then singing as well as dancing, they will say, All my "},{"t":"springs","s":["H4599"],"a":[3]},{"t":" are in you."}]}]}
