t":"."}]},{"n":11,"text":"For the sake of Your name, O Jehovah, Pardon my iniquity, for it is great.","tok":[{"t":"For the sake of Your name, O "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":", "},{"t":"Pardon","s":["H5545"],"a":[3]},{"t":" my "},{"t":"iniquity","s":["H5771"],"a":[4]},{"t":", for it is "},{"t":"great","s":["H7227"],"a":[6]},{"t":"."}]},{"n":12,"text":"Who then is the man who fears Jehovah? Him will He instruct concerning the way that he should choose.","tok":[{"t":"Who then is the "},{"t":"man","s":["H0376"],"a":[2]},{"t":" who "},{"t":"fears","s":["H3373"],"a":[3]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":"? Him will He instruct concerning the "},{"t":"way","s":["H1870"],"a":[6]},{"t":" that he should "},{"t":"choose","s":["H0977"],"a":[7]},{"t":"."}]},{"n":13,"text":"His soul will dwell in prosperity, And his seed will possess the land.","tok":[{"t":"His "},{"t":"soul","s":["H5315"],"a":[0]},{"t":" will "},{"t":"dwell","s":["H3885"],"a":[2]},{"t":" in prosperity, And his "},{"t":"seed","s":["H2233"],"a":[3]},{"t":" will possess the land."}]},{"n":14,"text":"The intimate counsel of Jehovah is to those who fear Him, And His covenant will He make known to them.","tok":[{"t":"The intimate counsel of "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" is to those who "},{"t":"fear","s":["H3373"],"a":[2]},{"t":" Him, And His "},{"t":"covenant","s":["H1285"],"a":[3]},{"t":" will He make known to them."}]},{"n":15,"text":"My eyes are continually turned to Jehovah, For He will bring my feet out of the net.","tok":[{"t":"My "},{"t":"eyes","s":["H5869"],"a":[0]},{"t":" are continually turned to "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", For He will bring my "},{"t":"feet","s":["H7272"],"a":[8]},{"t":" out of the "},{"t":"net","s":["H7568"],"a":[7]},{"t":"."}]},{"n":16,"text":"Turn toward me, and be gracious to me, For I am alone and afflicted.","tok":[{"t":"Turn","s":["H6437"],"a":[0]},{"t":" toward me, and be gracious to me, For I am alone and "},{"t":"afflicted","s":["H6041"],"a":[5]},{"t":"."}]},{"n":17,"text":"Relieve the troubles of my heart, And bring me out of my distresses.","tok":[{"t":"Relieve the "},{"t":"troubles","s":["H6869"],"a":[0]},{"t":" of my "},{"t":"heart","s":["H3824"],"a":[1]},{"t":", And bring me "},{"t":"out","s":["H3318"],"a":[4]},{"t":" of my "},{"t":"distresses","s":["H4691"],"a":[3]},{"t":"."}]},{"n":18,"text":"Look on my affliction and my suffering, And forgive all my sins.","tok":[{"t":"Look","s":["H7200"],"a":[0]},{"t":" on my "},{"t":"affliction","s":["H6040"],"a":[1]},{"t":" and my suffering, And "},{"t":"forgive","s":["H5375"],"a":[3]},{"t":" all my "},{"t":"sins","s":["H2403"],"a":[5]},{"t":"."}]},{"n":19,"text":"Look on my enemies, for they are many; Indeed they hate me with a violent hatred.","tok":[{"t":"Look on my "},{"t":"enemies","s":["H0341"],"a":[1]},{"t":", for they are "},{"t":"many","s":["H7231"],"a":[3]},{"t":"; Indeed they "},{"t":"hate","s":["H8130"],"a":[6]},{"t":" me with a violent "},{"t":"hatred","s":["H8135"],"a":[4]},{"t":"."}]},{"n":20,"text":"Keep my soul, and deliver me; Do not let me be put to shame, For I take refuge in You.","tok":[{"t":"Keep","s":["H8104"],"a":[0]},{"t":" my "},{"t":"soul","s":["H5315"],"a":[1]},{"t":", and "},{"t":"deliver","s":["H5337"],"a":[2]},{"t":" me; Do not let me be put to shame, For I take refuge in You."}]},{"n":21,"text":"May integrity and uprightness preserve me, For I wait on You.","tok":[{"t":"May "},{"t":"integrity","s":["H8537"],"a":[0]},{"t":" and "},{"t":"uprightness","s":["H3476"],"a":[1]},{"t":" "},{"t":"preserve","s":["H5341"],"a":[2]},{"t":" me, For I "},{"t":"wait","s":["H6960"],"a":[4]},{"t":" on You."}]},{"n":22,"text":"Redeem Israel, O God, Out of all his troubles.","tok":[{"t":"Redeem","s":["H6299"],"a":[0]},{"t":" "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":", O "},{"t":"God","s":["H0430"],"a":[1]},{"t":", Out of all his "},{"t":"troubles","s":["H6869"],"a":[5]},{"t":"."}]}]}
