{"v":1,"book":"Ps","ch":25,"verses":[{"n":0,"text":"Of David","tok":[{"t":"Of "},{"t":"David","s":["H1732"],"a":[0]}]},{"n":1,"text":"To You, O Jehovah, I lift up my soul.","tok":[{"t":"To You, O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", I lift "},{"t":"up","s":["H5375"],"a":[3]},{"t":" my "},{"t":"soul","s":["H5315"],"a":[2]},{"t":"."}]},{"n":2,"text":"O my God, I trust in You; Do not let me be ashamed; Do not let my enemies exult over me.","tok":[{"t":"O my "},{"t":"God","s":["H0430"],"a":[0]},{"t":", I "},{"t":"trust","s":["H0982"],"a":[2]},{"t":" in You; Do not let me be "},{"t":"ashamed","s":["H0954"],"a":[4]},{"t":"; Do not let my "},{"t":"enemies","s":["H0341"],"a":[7]},{"t":" exult over me."}]},{"n":3,"text":"Indeed may all who wait on You not be ashamed; May those who deal treacherously without cause be ashamed.","tok":[{"t":"Indeed may all who "},{"t":"wait","s":["H6960"],"a":[2]},{"t":" on You not be "},{"t":"ashamed","s":["H0954"],"a":[4]},{"t":"; May those who deal treacherously without "},{"t":"cause","s":["H7387"],"a":[7]},{"t":" be "},{"t":"ashamed","s":["H0954"],"a":[5]},{"t":"."}]},{"n":4,"text":"Make Your ways known to me, O Jehovah; Teach me Your paths.","tok":[{"t":"Make Your "},{"t":"ways","s":["H1870"],"a":[0]},{"t":" known to me, O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":"; "},{"t":"Teach","s":["H3925"],"a":[4]},{"t":" me Your "},{"t":"paths","s":["H0734"],"a":[3]},{"t":"."}]},{"n":5,"text":"Guide me in Your truth, and teach me; For You are the God of my salvation; I wait on You all the day long.","tok":[{"t":"Guide me in Your "},{"t":"truth","s":["H0571"],"a":[1]},{"t":", and "},{"t":"teach","s":["H3925"],"a":[2]},{"t":" me; For You are the "},{"t":"God","s":["H0430"],"a":[5]},{"t":" of my "},{"t":"salvation","s":["H3468"],"a":[6]},{"t":"; I "},{"t":"wait","s":["H6960"],"a":[8]},{"t":" on You all the "},{"t":"day","s":["H3117"],"a":[10]},{"t":" long."}]},{"n":6,"text":"Remember Your compassions, O Jehovah, And Your acts of kindn