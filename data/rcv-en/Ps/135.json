},{"t":" is above all "},{"t":"gods","s":["H0430"],"a":[8]},{"t":"."}]},{"n":6,"text":"Whatever Jehovah pleases He does In heaven and on earth, In the seas and all the depths.","tok":[{"t":"Whatever "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" "},{"t":"pleases","s":["H2654"],"a":[2]},{"t":" He does In "},{"t":"heaven","s":["H8064"],"a":[5]},{"t":" and on "},{"t":"earth","s":["H0776"],"a":[6]},{"t":", In the "},{"t":"seas","s":["H3220"],"a":[7]},{"t":" and all the depths."}]},{"n":7,"text":"He causes the vapors to ascend from the ends of the earth; He makes lightning for the rain; He brings forth wind from His treasuries.","tok":[{"t":"He causes the vapors to "},{"t":"ascend","s":["H5927"],"a":[0]},{"t":" from the "},{"t":"ends","s":["H7097"],"a":[2]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[3]},{"t":"; He "},{"t":"makes","s":["H6213"],"a":[6]},{"t":" "},{"t":"lightning","s":["H1300"],"a":[4]},{"t":" for the "},{"t":"rain","s":["H4306"],"a":[5]},{"t":"; He "},{"t":"brings","s":["H3318"],"a":[7]},{"t":" forth "},{"t":"wind","s":["H7307"],"a":[8]},{"t":" from His "},{"t":"treasuries","s":["H0214"],"a":[9]},{"t":"."}]},{"n":8,"text":"He struck the firstborn of Egypt, Both of man and of beast.","tok":[{"t":"He struck the "},{"t":"firstborn","s":["H1060"],"a":[1]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[2]},{"t":", Both of "},{"t":"man","s":["H0120"],"a":[3]},{"t":" and of "},{"t":"beast","s":["H0929"],"a":[5]},{"t":"."}]},{"n":9,"text":"He sent signs and wonders into your midst, O Egypt, Upon Pharaoh and all his servants.","tok":[{"t":"He "},{"t":"sent","s":["H7971"],"a":[0]},{"t":" "},{"t":"signs","s":["H0226"],"a":[1]},{"t":" and "},{"t":"wonders","s":["H4159"],"a":[2]},{"t":" into your "},{"t":"midst","s":["H8432"],"a":[3]},{"t":", O "},{"t":"Egypt","s":["H4714"],"a":[4]},{"t":", Upon "},{"t":"Pharaoh","s":["H6547"],"a":[5]},{"t":" and all his "},{"t":"servants","s":["H5650"],"a":[7]},{"t":"."}]},{"n":10,"text":"He struck many nations And slew mighty k