ands.","tok":[{"t":"The "},{"t":"idols","s":["H6091"],"a":[0]},{"t":" of the nations are mere "},{"t":"silver","s":["H3701"],"a":[2]},{"t":" and "},{"t":"gold","s":["H2091"],"a":[3]},{"t":", The "},{"t":"work","s":["H4639"],"a":[4]},{"t":" of "},{"t":"human","s":["H0120"],"a":[6]},{"t":" "},{"t":"hands","s":["H3027"],"a":[5]},{"t":"."}]},{"n":16,"text":"They have mouths, but they do not speak; They have eyes, but they do not see.","tok":[{"t":"They have "},{"t":"mouths","s":["H6310"],"a":[0]},{"t":", but they do not "},{"t":"speak","s":["H1696"],"a":[3]},{"t":"; They have "},{"t":"eyes","s":["H5869"],"a":[4]},{"t":", but they do not "},{"t":"see","s":["H7200"],"a":[7]},{"t":"."}]},{"n":17,"text":"They have ears, but they do not give ear; And there is no breath in their mouths.","tok":[{"t":"They have "},{"t":"ears","s":["H0241"],"a":[0]},{"t":", but they do not give ear; And "},{"t":"there","s":["H3426"],"a":[6]},{"t":" is no "},{"t":"breath","s":["H7307"],"a":[7]},{"t":" in their "},{"t":"mouths","s":["H6310"],"a":[8]},{"t":"."}]},{"n":18,"text":"Those who make them, All who trust in them, Will be like them.","tok":[{"t":"Those who "},{"t":"make","s":["H6213"],"a":[2]},{"t":" them, All who "},{"t":"trust","s":["H0982"],"a":[5]},{"t":" in them, Will be like them."}]},{"n":19,"text":"O house of Israel, bless Jehovah. O house of Aaron, bless Jehovah.","tok":[{"t":"O "},{"t":"house","s":["H1004"],"a":[0]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[1]},{"t":", "},{"t":"bless","s":["H1288"],"a":[7]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[9]},{"t":". O "},{"t":"house","s":["H1004"],"a":[5]},{"t":" of "},{"t":"Aaron","s":["H0175"],"a":[6]},{"t":", bless Jehovah."}]},{"n":20,"text":"O house of Levi, bless Jehovah. O you who fear Jehovah, bless Jehovah.","tok":[{"t":"O "},{"t":"house","s":["H1004"],"a":[0]},{"t":" of "},{"t":"Levi","s":["H3878"],"a":[1]},{"t":", "},{"t":"bless","s":["H1288"],"a":[2]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":". O you who "