{"v":1,"book":"Ps","ch":66,"verses":[{"n":0,"text":"To the choir director. A Song; a Psalm","tok":[{"t":"To the choir director. A "},{"t":"Song","s":["H7892"],"a":[1]},{"t":"; a "},{"t":"Psalm","s":["H4210"],"a":[2]}]},{"n":1,"text":"Shout joyfully to God, all the earth;","tok":[{"t":"Shout joyfully to "},{"t":"God","s":["H0430"],"a":[1]},{"t":", all the earth;"}]},{"n":2,"text":"Sing forth the glory of His name; Make glorious His praise.","tok":[{"t":"Sing "},{"t":"forth","s":["H2167"],"a":[0]},{"t":" the glory of His "},{"t":"name","s":["H8034"],"a":[2]},{"t":"; "},{"t":"Make","s":["H7760"],"a":[3]},{"t":" "},{"t":"glorious","s":["H3519"],"a":[4]},{"t":" His "},{"t":"praise","s":["H8416"],"a":[5]},{"t":"."}]},{"n":3,"text":"Say to God, How awesome are Your deeds! Because of the greatness of Your strength, Your enemies come cringing to You.","tok":[{"t":"Say","s":["H0559"],"a":[0]},{"t":" to "},{"t":"God","s":["H0430"],"a":[1]},{"t":", How awesome are Your deeds! Because of the "},{"t":"greatness","s":["H7230"],"a":[5]},{"t":" of Your strength, Your "},{"t":"enemies","s":["H0341"],"a":[9]},{"t":" come cringing to You."}]},{"n":4,"text":"All the earth will worship You And sing psalms to You; They will sing psalms to Your name. Selah","tok":[{"t":"All the "},{"t":"earth","s":["H0776"],"a":[1]},{"t":" will "},{"t":"worship","s":["H7812"],"a":[2]},{"t":" You And "},{"t":"sing","s":["H2167"],"a":[4]},{"t":" psalms to You; They will "},{"t":"sing","s":["H2167"],"a":[6]},{"t":" psalms to Your "},{"t":"name","s":["H8034"],"a":[7]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[8]}]},{"n":5,"text":"Come and see the works of God; He is awesome in His deeds toward the sons of men.","tok":[{"t":"Come","s":["H3212"]},{"t":" and "},{"t":"see","s":["H7200"],"a":[1]},{"t":" the "},{"t":"works","s":["H4659"],"a":[2]},{"t":" of "},{"t":"God","s":["H0430"],"a":[3]},{"t":"; He is awesome in His deeds toward the sons of "},{"t":"men","s":["H0120"],"a":[8]},{"t":"."}]},{"n":6,"text":"He turned the sea into dry land; Through the river they crossed on foot. There we rejoiced in Him.","tok":[{"t":"He "},{"t":"turned","s":["H2015"],"a":[0]},{"t":" the "},{"t":"sea","s":["H3220"],"a":[1]},{"t":" into "},{"t":"dry","s":["H3004"],"a":[2]},{"t":" land; Through the river they crossed on "},{"t":"foot","s":["H7272"],"a":[5]},{"t":". There we "},{"t":"rejoiced","s":["H8055"],"a":[7]},{"t":" in Him."}]},{"n":7,"text":"He rules by His might forever; His eyes observe the nations: Let not the rebellious exalt themselves. Selah","tok":[{"t":"He "},{"t":"rules","s":["H4910"],"a":[0]},{"t":" by His might forever; His "},{"t":"eyes","s":["H5869"],"a":[3]},{"t":" "},{"t":"observe","s":["H6822"],"a":[5]},{"t":" the "},{"t":"nations","s":["H1471"],"a":[4]},{"t":": Let not the "},{"t":"rebellious","s":["H5637"],"a":[6]},{"t":" "},{"t":"exalt","s":["H7311"],"a":[8]},{"t":" themselves. "},{"t":"Selah","s":["H5542"],"a":[10]}]},{"n":8,"text":"Bless our God, O peoples; And make the voice of His praise heard,","tok":[{"t":"Bless","s":["H1288"],"a":[0]},{"t":" our "},{"t":"God","s":["H0430"],"a":[2]},{"t":", O "},{"t":"peoples","s":["H5971"],"a":[1]},{"t":"; And make the "},{"t":"voice","s":["H6963"],"a":[4]},{"t":" of His "},{"t":"praise","s":["H8416"],"a":[5]},{"t":" "},{"t":"heard","s":["H8085"],"a":[3]},{"t":","}]},{"n":9,"text":"Who has kept our soul in life And does not allow our feet to slip.","tok":[{"t":"Who has kept our "},{"t":"soul","s":["H5315"],"a":[1]},{"t":" in "},{"t":"life","s":["H2416"],"a":[2]},{"t":" And does not allow our "},{"t":"feet","s":["H7272"],"a":[6]},{"t":" to "},{"t":"slip","s":["H4132"],"a":[5]},{"t":"."}]},{"n":10,"text":"For You have tried us, O God; You have refined us as silver is refined.","tok":[{"t":"For You have "},{"t":"tried","s":["H6884"],"a":[3]},{"t":" us, O "},{"t":"God","s":["H0430"],"a":[2]},{"t":"; You have refined us as "},{"t":"silver","s":["H3701"],"a":[5]},{"t":" is "},{"t":"refined","s":["H6884"],"a":[4]},{"t":"."}]},{"n":11,"text":"You have brought us into the net; You have put a heavy burden on our loins.","tok":[{"t":"You have "},{"t":"brought","s":["H0935"],"a":[0]},{"t":" us into the "},{"t":"net","s":["H4686"],"a":[1]},{"t":"; You have put a heavy burden on our "},{"t":"loins","s":["H4975"],"a":[4]},{"t":"."}]},{"n":12,"text":"You have made men ride over our heads; We have gone through fire and water; But You have brought us forth into abundance.","tok":[{"t":"You have made "},{"t":"men","s":["H0582"],"a":[1]},{"t":" "},{"t":"ride","s":["H7392"],"a":[0]},{"t":" over our "},{"t":"heads","s":["H7218"],"a":[2]},{"t":"; We have gone through "},{"t":"fire","s":["H0784"],"a":[4]},{"t":" and "},{"t":"water","s":["H4325"],"a":[5]},{"t":"; But You have brought us forth into abundance."}]},{"n":13,"text":"I will come into Your house with burnt offerings; I will pay my vows to You,","tok":[{"t":"I will come into Your "},{"t":"house","s":["H1004"],"a":[1]},{"t":" with burnt "},{"t":"offerings","s":["H5930"],"a":[2]},{"t":"; I will "},{"t":"pay","s":["H7999"],"a":[3]},{"t":" my "},{"t":"vows","s":["H5088"],"a":[5]},{"t":" to You,"}]},{"n":14,"text":"Which my lips uttered And my mouth spoke when I was in distress.","tok":[{"t":"Which my "},{"t":"lips","s":["H8193"],"a":[2]},{"t":" "},{"t":"uttered","s":["H6475"],"a":[1]},{"t":" And my "},{"t":"mouth","s":["H6310"],"a":[4]},{"t":" spoke when I was in distress."}]},{"n":15,"text":"I will offer to You burnt offerings of fatlings With the smoke of rams; I will offer cattle with goats. Selah","tok":[{"t":"I will "},{"t":"offer","s":["H5927"],"a":[2]},{"t":" to You burnt offerings of "},{"t":"fatlings","s":["H4220"],"a":[1]},{"t":" With the "},{"t":"smoke","s":["H7004"],"a":[5]},{"t":" of "},{"t":"rams","s":["H0352"],"a":[6]},{"t":"; I will "},{"t":"offer","s":["H6213"],"a":[7]},{"t":" "},{"t":"cattle","s":["H1241"],"a":[8]},{"t":" with "},{"t":"goats","s":["H6260"],"a":[10]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[11]}]},{"n":16,"text":"Come, hea