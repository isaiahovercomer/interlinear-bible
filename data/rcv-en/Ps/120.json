{"v":1,"book":"Ps","ch":120,"verses":[{"n":0,"text":"A Song of Ascents","tok":[{"t":"A "},{"t":"Song","s":["H7892"],"a":[0]},{"t":" of "},{"t":"Ascents","s":["H4609"],"a":[1]}]},{"n":1,"text":"In my distress I called out to Jehovah, And He answered me.","tok":[{"t":"In my "},{"t":"distress","s":["H6869"],"a":[2]},{"t":" I "},{"t":"called","s":["H7121"],"a":[4]},{"t":" out to "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", And He "},{"t":"answered","s":["H6030"],"a":[5]},{"t":" me."}]},{"n":2,"text":"O Jehovah, deliver my soul from lying lips, From a tongue of deceit.","tok":[{"t":"O "},{"t":"Jehovah","s":["H3068"],"a":[0]},{"t":", "},{"t":"deliver","s":["H5337"],"a":[1]},{"t":" my "},{"t":"soul","s":["H5315"],"a":[2]},{"t":" from "},{"t":"lying","s":["H8267"],"a":[4]},{"t":" "},{"t":"lips","s":["H8193"],"a":[3]},{"t":", From a "},{"t":"tongue","s":["H3956"],"a":[5]},{"t":" of "},{"t":"deceit","s":["H7423"],"a":[6]},{"t":"."}]},{"n":3,"text":"What should be given to you, And what further shall be done to you, O tongue of deceit?","tok":[{"t":"What should be "},{"t":"given","s":["H5414"],"a":[1]},{"t":" to you, And what "},{"t":"further","s":["H3254"],"a":[4]},{"t":" shall be done to you, O "},{"t":"tongue","s":["H3956"],"a":[6]},{"t":" of "},{"t":"deceit","s":["H7423"],"a":[7]},{"t":"?"}]},{"n":4,"text":"The sharp arrows of a mighty man, With the burning coals of the broom tree!","tok":[{"t":"The "},{"t":"sharp","s":["H8150"],"a":[2]},{"t":" "},{"t":"arrows","s":["H2671"],"a":[0]},{"t":" of a "},{"t":"mighty","s":["H1368"],"a":[1]},{"t":" "},{"t":"man","s":["H1368"],"a":[1]},{"t":", With the "},{"t":"burning","s":["H1513"],"a":[4]},{"t":" "},{"t":"coals","s":["H1513"],"a":[4]},{"t":" of the "},{"t":"broom","s":["H7574"],"a":[5]},{"t":" "},{"t":"tree","s":["H7574"],"a":[5]},{"t":"!"}]},{"n":5,"text":"Woe is me, for I sojourn in Meshech, I dwell among the tents of Kedar.","tok":[{"t":"Woe","s":["H0190"],"a":[0]},{"t":" is me, for I "},{"t":"sojourn","s":["H1481"],"a":