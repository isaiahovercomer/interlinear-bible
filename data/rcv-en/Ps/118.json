{"v":1,"book":"Ps","ch":118,"verses":[{"n":1,"text":"Give thanks to Jehovah, for He is good, For His lovingkindness is forever.","tok":[{"t":"Give "},{"t":"thanks","s":["H3034"],"a":[0]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", for He is "},{"t":"good","s":["H2896"]},{"t":", For His lovingkindness is forever."}]},{"n":2,"text":"Let Israel say, His lovingkindness is forever.","tok":[{"t":"Let "},{"t":"Israel","s":["H3478"],"a":[2]},{"t":" "},{"t":"say","s":["H0559"],"a":[0]},{"t":", His lovingkindness is forever."}]},{"n":3,"text":"Let the house of Aaron say, His lovingkindness is forever.","tok":[{"t":"Let the "},{"t":"house","s":["H1004"],"a":[2]},{"t":" of "},{"t":"Aaron","s":["H0175"],"a":[3]},{"t":" "},{"t":"say","s":["H0559"],"a":[0]},{"t":", His lovingkindness is forever."}]},{"n":4,"text":"Let those who fear Jehovah say, His lovingkindness is forever.","tok":[{"t":"Let those who "},{"t":"fear","s":["H3373"],"a":[2]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" "},{"t":"say","s":["H0559"],"a":[0]},{"t":", His lovingkindness is forever."}]},{"n":5,"text":"Out of my distress I called upon Jehovah; Jehovah answered me and set me in a place broad and free.","tok":[{"t":"Out of my "},{"t":"distress","s":["H4712"],"a":[1]},{"t":" I "},{"t":"called","s":["H7121"],"a":[2]},{"t":" upon "},{"t":"Jehovah","s":["H3050"],"a":[3]},{"t":"; "},{"t":"Jehovah","s":["H3050"],"a":[6]},{"t":" "},{"t":"answered","s":["H6030"],"a":[4]},{"t":" me and set me in a "},{"t":"place","s":["H4800"],"a":[5]},{"t":" broad and free."}]},{"n":6,"text":"Jehovah is for me; I will not be afraid. What can man do to me?","tok":[{"t":"Jehovah","s":["H3068"],"a":[0]},{"t":" is for me; I will not be afraid. What "},{"t":"can","s":["H6213"],"a":[5]},{"t":" "},{"t":"man","s":["H0120"],"a":[7]},{"t":" "},{"t":"do","s":["H6213"]},{"t":" to me?"}]},{"n":7,"text":"Jehovah is for me as my Helper, And I will see what should happen to those who hate me.","tok":[{"t":"Jehovah","s":["H3068"],"a":[0]},{"t":" is for me as my Helper, And I will "},{"t":"see","s":["H7200"],"a":[4]},{"t":" what should happen to those who "},{"t":"hate","s":["H8130"],"a":[5]},{"t":" me."}]},{"n":8,"text":"It is better to take refuge in Jehovah Than to trust in man.","tok":[{"t":"It is "},{"t":"better","s":["H2896"],"a":[0]},{"t":" to take refuge in "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" Than to "},{"t":"trust","s":["H2620"],"a":[1]},{"t":" in "},{"t":"man","s":["H0120"],"a":[4]},{"t":"."}]},{"n":9,"text":"It is better to take refuge in Jehovah Than to trust in princes.","tok":[{"t":"It is "},{"t":"better","s":["H2896"],"a":[0]},{"t":" to take refuge in "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" Than to "},{"t":"trust","s":["H2620"],"a":[1]},{"t":" in "},{"t":"princes","s":["H5081"],"a":[4]},{"t":"."}]},{"n":10,"text":"All nations surrounded me; In the name of Jehovah I indeed cut them down!","tok":[{"t":"All "},{"t":"nations","s":["H1471"],"a":[1]},{"t":" surrounded me; In the "},{"t":"name","s":["H8034"],"a":[3]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" I indeed cut them down!"}]},{"n":11,"text":"They surrounded me; yes, they surrounded me; In the name of Jehovah I indeed cut them down!","tok":[{"t":"They surrounded me; yes, they surrounded me; In the "},{"t":"name","s":["H8034"],"a":[3]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" I indeed cut them down!"}]},{"n":12,"text":"They surrounded me like bees; They were extinguished like a fire of thorns; In the name of Jehovah I indeed cut them down!","tok":[{"t":"They surrounded me like "},{"t":"bees","s":["H1682"],"a":[1]},{"t":"; They were extinguished like a "},{"t":"fire","s":["H0784"],"a":[3]},{"t":" of "},{"t":"thorns","s":["H6975"],"a":[4]},{"t":"; In the "},{"t":"name","s":["H8034"],"a":[5]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" I indeed cut them down!"}]},{"n":13,"text":"I was pushed hard that I might fall; But Jehovah helped me.","tok":[{"t":"I was pushed hard that I might "},{"t":"fall","s":["H5307"],"a":[2]},{"t":"; But "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" "},{"t":"helped","s":["H5826"],"a":[4]},{"t":" me."}]},{"n":14,"text":"Jehovah is my strength and my song, And He has become my salvation.","tok":[{"t":"Jehovah","s":["H3050"],"a":[2]},{"t":" is my "},{"t":"strength","s":["H5797"],"a":[0]},{"t":" and my "},{"t":"song","s":["H2176"],"a":[1]},{"t":", And He has become my "},{"t":"salvation","s":["H3444"],"a":[5]},{"t":"."}]},{"n":15,"text":"The voice of rejoicing and salvation Is in the tents of the righteous. The right hand of Jehovah does valiantly;","tok":[{"t":"The "},{"t":"voice","s":["H6963"],"a":[0]},{"t":" of "},{"t":"rejoicing","s":["H7440"],"a":[1]},{"t":" and "},{"t":"salvation","s":["H3444"],"a":[2]},{"t":" Is in the "},{"t":"tents","s":["H0168"],"a":[3]},{"t":" of the "},{"t":"righteous","s":["H6662"],"a":[4]},{"t":". The right "},{"t":"hand","s":["H3225"],"a":[5]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" "},{"t":"does","s":["H6213"],"a":[7]},{"t":" "},{"t":"valiantly","s":["H2428"],"a":[8]},{"t":";"}]},{"n":16,"text":"The right hand of Jehovah is exalted; The right hand of Jehovah does valiantly.","tok":[{"t":"The right "},{"t":"hand","s":["H3225"],"a":[0]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" is "},{"t":"exalted","s":["H7426"],"a":[2]},{"t":"; The right "},{"t":"hand","s":["H3225"],"a":[3]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" "},{"t":"does","s":["H6213"],"a":[5]},{"t":" "},{"t":"valiantly","s":["H2428"],"a":[6]},{"t":"."}]},{"n":17,"text":"I will not die, but live, And declare the works of Jehovah.","tok":[{"t":"I will not "},{"t":"die","s":["H4191"],"a":[1]},{"t":", but "},{"t":"live","s":["H2421"],"a":[3]},{"t":", And "},{"t":"declare","s":["H5608"],"a":[4]},{"t":" the "},{"t":"works","s":["H4639"],"a":[5]},{"t":" of "},{"t":"Jehovah","s":["H3050"],"a":[6]},{"t":"."}]},{"n":18,"text":"Jehovah has severely chastened me, But He has not given me over to death.","tok":[{"t":"Jehovah","s":["H3050"],"a":[2]},{"t":" has severely "},{"t":"chastened","s":["H3256"],"a":[0]},{"t":" me, But He has not given me "},{"t":"over","s":["H5414"],"a":[5]},{"t":" to "},{"t":"death","s":["H4194"],"a":[3]},{"t":"."}]},{"n":19,"text":"Open to me the gates of righteousness: I will enter in through them; I will give thanks to Jehovah.","tok":[{"t":"Open","s":["H6605"],"a":[0]},{"t":" to me the "},{"t":"gates","s":["H8179"],"a":[2]},{"t":" of "},{"t":"righteousness","s":["H6664"],"a":[3]},{"t":": I will enter in through them; I will give thanks to "},{"t":"Jehovah","s":["H3050"],"a":[7]},{"t":"."}]},{"n":20,"text":"This is the gate of Jehovah; The righteous shall enter in through it.","tok":[{"t":"This is the "},{"t":"gate","s":["H8179"],"a":[1]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":"; The "},{"t":"righteous","s":["H6662"],"a":[3]},{"t":" shall "},{"t":"enter","s":["H0935"],"a":[4]},{"t":" in through it."}]},{"n":21,"text":"I will give thanks to You, for You have answered me And have become my salvation.","tok":[{"t":"I will give thanks to You, for You have answered me And have become my "},{"t":"salvation","s":["H3444"],"a":[5]},{"t":"."}]},{"n":22,"text":"The stone which the builders rejected Has become the head of the corner.","tok":[{"t":"The "},{"t":"stone","s":["H0068"],"a":[0]},{"t":" which the "},{"t":"builders","s":["H1129"],"a":[2]},{"t":" rejected Has become the "},{"t":"head","s":["H7218"],"a":[4]},{"t":" of the "},{"t":"corner","s":["H6438"],"a":[5]},{"t":"."}]},{"n":23,"text":"This is from Jehovah; It is wonderful in our sight."},{"n":24,"text":"This is the day that Jehovah has made; Let us exult and rejoice in it.","tok":[{"t":"This is the "},{"t":"day","s":["H3117"],"a":[1]},{"t":" that "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" has "},{"t":"made","s":["H6213"],"a":[2]},{"t":"; Let us exult and "},{"t":"rejoice","s":["H1523"],"a":[4]},{"t":" in it."}]},{"n":25,"text":"O Jehovah, do save, we pray! O Jehovah, do send prosperity, we pray!","tok":[{"t":"O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", do "},{"t":"save","s":["H3467"],"a":[2]},{"t":", we pray! O "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":", do send "},{"t":"prosperity","s":["H6743"],"a":[6]},{"t":", we pray!"}]},{"n":26,"text":"Blessed is He who comes in the name of Jehovah; We bless you from the house of Jehovah.","tok":[{"t":"Blessed","s":["H1288"],"a":[0]},{"t":" is He who "},{"t":"comes","s":["H0935"],"a":[1]},{"t":" in the "},{"t":"name","s":["H8034"],"a":[2]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":"; We bless you from the "},{"t":"house","s":["H1004"],"a":[5]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":"."}]},{"n":27,"text":"Jehovah is God, And He has given us light; Bind the sacrifice of the feast with cords To the horns of the altar.","tok":[{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" is "},{"t":"God","s":["H0410"],"a":[0]},{"t":", And He has given us "},{"t":"light","s":["H0215"],"a":[2]},{"t":"; "},{"t":"Bind","s":["H0631"],"a":[4]},{"t":" the "},{"t":"sacrifice","s":["H2282"],"a":[5]},{"t":" of the feast with "},{"t":"cords","s":["H5688"],"a":[6]},{"t":" To the "},{"t":"horns","s":["H7161"],"a":[8]},{"t":" of the "},{"t":"altar","s":["H4196"],"a":[9]},{"t":"."}]},{"n":28,"text":"You are my God, and I give thanks to You. You are my God; I will exalt You.","tok":[{"t":"You are my "},{"t":"God","s":["H0410"],"a":[0]},{"t":", and I give thanks to You. You are my "},{"t":"God","s":["H0430"],"a":[3]},{"t":"; I will "},{"t":"exalt","s":["H7311"],"a":[4]},{"t":" You."}]},{"n":29,"text":"Give thanks to Jehovah, for He is good, For His lovingkindness is forever.","tok":[{"t":"Give "},{"t":"thanks","s":["H3034"],"a":[0]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", for He is "},{"t":"good","s":["H2896"]},{"t":", For His lovingkindness is forever."}]}]}
