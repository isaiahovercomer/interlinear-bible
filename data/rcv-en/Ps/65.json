{"v":1,"book":"Ps","ch":65,"verses":[{"n":0,"text":"To the choir director. A Psalm of David; a Song","tok":[{"t":"To the choir director. A "},{"t":"Psalm","s":["H4210"],"a":[1]},{"t":" of "},{"t":"David","s":["H1732"],"a":[2]},{"t":"; a "},{"t":"Song","s":["H7892"],"a":[3]}]},{"n":1,"text":"Praise befits You, O God, in Zion; And to You is the vow paid.","tok":[{"t":"Praise","s":["H8416"],"a":[2]},{"t":" befits You, O "},{"t":"God","s":["H0430"],"a":[3]},{"t":", in Zion; And to You is the "},{"t":"vow","s":["H5088"],"a":[7]},{"t":" "},{"t":"paid","s":["H7999"],"a":[6]},{"t":"."}]},{"n":2,"text":"O You who hear prayer, To You all flesh comes.","tok":[{"t":"O You who "},{"t":"hear","s":["H8085"],"a":[0]},{"t":" "},{"t":"prayer","s":["H8605"],"a":[1]},{"t":", To You all "},{"t":"flesh","s":["H1320"],"a":[4]},{"t":" "},{"t":"comes","s":["H0935"],"a":[5]},{"t":"."}]},{"n":3,"text":"Iniquities prevail against me; As for our transgressions, You make propitiation for them.","tok":[{"t":"Iniquities","s":["H1697"],"a":[0]},{"t":" "},{"t":"prevail","s":["H1396"],"a":[2]},{"t":" against me; As for our "},{"t":"transgressions","s":["H6588"],"a":[4]},{"t":", You make propitiation for them."}]},{"n":4,"text":"Blessed is he whom You have chosen and bring near To dwell in Your courts. We will be satisfied with the goodness of Your house, Of Your holy temple.","tok":[{"t":"Blessed","s":["H0835"],"a":[0]},{"t":" is he whom You have chosen and bring near To "},{"t":"dwell","s":["H7931"],"a":[3]},{"t":" in Your "},{"t":"courts","s":["H2691"],"a":[4]},{"t":". We will be "},{"t":"satisfied","s":["H7646"],"a":[5]},{"t":" with the "},{"t":"goodness","s":["H2898"],"a":[6]},{"t":" of Your "},{"t":"house","s":["H1004"],"a":[7]},{"t":", Of Your "},{"t":"holy","s":["H6918"],"a":[8]},{"t":" "},{"t":"temple","s":["H1964"],"a":[9]},{"t":"."}]},{"n":5,"text":"By awesome deeds You answer us in righteousness, O God of our salvation, You who are the trust of all the ends of the earth And of the remotest sea;","tok":[{"t":"By awesome deeds You "},{"t":"answer","s":["H6030"],"a":[2]},{"t":" us in "},{"t":"righteousness","s":["H6664"],"a":[1]},{"t":", "},{"t":"O","s":["H6030"],"a":[2]},{"t":" "},{"t":"God","s":["H0430"],"a":[3]},{"t":" of our "},{"t":"salvation","s":["H3468"],"a":[4]},{"t":", You who are the trust of all the "},{"t":"ends","s":["H7099"],"a":[7]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[8]},{"t":" And of the "},{"t":"remotest","s":["H7350"],"a":[10]},{"t":" "},{"t":"sea","s":["H3220"],"a":[9]},{"t":";"}]},{"n":6,"text":"Who established the mountains in His strength, Girded with might;","tok":[{"t":"Who established the "},{"t":"mountains","s":["H2022"],"a":[1]},{"t":" in His "},{"t":"strength","s":["H3581"],"a":[2]},{"t":", "},{"t":"Girded","s":["H0247"],"a":[3]},{"t":" with "},{"t":"might","s":["H1369"],"a":[4]},{"t":";"}]},{"n":7,"text":"Who stilled the roaring of the seas, The roaring of their billows, And the tumult of the peoples.","tok":[{"t":"Who "},{"t":"stilled","s":["H7623"],"a":[0]},{"t":" the "},{"t":"roaring","s":["H7588"],"a":[1]},{"t":" of the "},{"t":"seas","s":["H3220"],"a":[2]},{"t":", The roaring of their billows, And the "},{"t":"tumult","s":["H1995"],"a":[5]},{"t":" of the "},{"t":"peoples","s":["H3816"],"a":[6]},{"t":"."}]},{"n":8,"text":"And they who dwell in the uttermost parts Are afraid of Your signs; You make the exitways of the morning and the evening Shout for joy.","tok":[{"t":"And they who "},{"t":"dwell","s":["H3427"],"a":[1]},{"t":" in the uttermost "},{"t":"parts","s":["H7099"]},{"t":" Are "},{"t":"afraid","s":["H3372"],"a":[0]},{"t":" of Your signs; You make the exitways of the "},{"t":"morning","s":["H1242"],"a":[5]},{"t":" and the "},{"t":"evening","s":["H6153"],"a":[6]},{"t":" Shout for joy."}]},{"n":9,"text":"You visit the earth and water it; You enrich it greatly: The river of God is full of water. You provide men grain, for so You have prepared the earth.","tok":[{"t":"You "},{"t":"visit","s":["H6485"],"a":[0]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[1]},{"t":" and "},{"t":"water","s":["H7783"],"a":[2]},{"t":" it; "},{"t":"You","s":["H7227"],"a":[3]},{"t":" "},{"t":"enrich","s":["H6238"],"a":[4]},{"t":" it "},{"t":"greatly","s":["H7227"],"a":[3]},{"t":": The "},{"t":"river","s":["H6388"],"a":[5]},{"t":" of "},{"t":"God","s":["H0430"],"a":[6]},{"t":" is "},{"t":"full","s":["H4390"],"a":[7]},{"t":" of "},{"t":"water","s":["H4325"],"a":[8]},{"t":". You "},{"t":"provide","s":["H3559"],"a":[13]},{"t":" men grain, for so You have "},{"t":"prepared","s":["H3559"],"a":[9]},{"t":" the earth."}]},{"n":10,"text":"Saturating its furrows, settling its ridges, You soften it with showers; You bless its sprouting forth.","tok":[{"t":"Saturating its "},{"t":"furrows","s":["H1417"],"a":[3]},{"t":", "},{"t":"settling","s":["H5181"],"a":[2]},{"t":" its "},{"t":"ridges","s":["H8525"],"a":[0]},{"t":", You soften it with "},{"t":"showers","s":["H7241"],"a":[4]},{"t":"; You bless its sprouting forth."}]},{"n":11,"text":"You place a crown on a year with Your goodness, And Your wagon tracks drop fatness;","tok":[{"t":"You place a "},{"t":"crown","s":["H5849"],"a":[0]},{"t":" on a "},{"t":"year","s":["H8141"],"a":[1]},{"t":" with Your "},{"t":"goodness","s":["H2896"],"a":[2]},{"t":", And Your wagon tracks "},{"t":"drop","s":["H7491"],"a":[4]},{"t":" "},{"t":"fatness","s":["H1880"],"a":[5]},{"t":";"}]},{"n":12,"text":"The wilderness pastures overflow, And the hills gird themselves with exultation.","tok":[{"t":"The "},{"t":"wilderness","s":["H4057"],"a":[2]},{"t":" "},{"t":"pastures","s":["H4999"],"a":[1]},{"t":" "},{"t":"overflow","s":["H4057"],"a":[2]},{"t":", And the "},{"t":"hills","s":["H1389"],"a":[4]},{"t":" gird themselves with exultation."}]},{"n":13,"text":"The meadows are clothed with the flock, And the valleys cover themselves in grain; They shout for joy; indeed they sing.","tok":[{"t":"The meadows are "},{"t":"clothed","s":["H3847"],"a":[0]},{"t":" with the "},{"t":"flock","s":["H6629"],"a":[2]},{"t":", And the "},{"t":"valleys","s":["H6010"],"a":[3]},{"t":" cover themselves in grain; They shout for "},{"t":"joy","s":["H7321"],"a":[6]},{"t":"; indeed they "},{"t":"sing","s":["H7891"],"a":[8]},{"t":"."}]}]}
