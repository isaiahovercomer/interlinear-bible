{"v":1,"book":"Ps","ch":19,"verses":[{"n":0,"text":"To the choir director. A Psalm of David","tok":[{"t":"To the choir director. A "},{"t":"Psalm","s":["H4210"],"a":[1]},{"t":" of "},{"t":"David","s":["H1732"],"a":[2]}]},{"n":1,"text":"The heavens declare the glory of God, And the expanse proclaims the work of His hands.","tok":[{"t":"The "},{"t":"heavens","s":["H8064"],"a":[0]},{"t":" "},{"t":"declare","s":["H5608"],"a":[1]},{"t":" the "},{"t":"glory","s":["H3519"],"a":[2]},{"t":" of "},{"t":"God","s":["H0410"],"a":[3]},{"t":", And the expanse proclaims the work of "},{"t":"His","s":["H5046"],"a":[6]},{"t":" "},{"t":"hands","s":["H4639"],"a":[4]},{"t":"."}]},{"n":2,"text":"Day to day pours forth speech, And night to night tells out knowledge.","tok":[{"t":"Day","s":["H3117"],"a":[0]},{"t":" to "},{"t":"day","s":["H3117"],"a":[1]},{"t":" pours forth "},{"t":"speech","s":["H0562"],"a":[3]},{"t":", And "},{"t":"night","s":["H3915"],"a":[4]},{"t":" to "},{"t":"night","s":["H3915"],"a":[5]},{"t":" tells out "},{"t":"knowledge","s":["H1847"],"a":[7]},{"t":"."}]},{"n":3,"text":"There is no speech and there are no words; Their voice is not heard.","tok":[{"t":"There is no "},{"t":"speech","s":["H0562"],"a":[1]},{"t":" and there are no words; Their "},{"t":"voice","s":["H6963"],"a":[6]},{"t":" is not "},{"t":"heard","s":["H8085"],"a":[5]},{"t":"."}]},{"n":4,"text":"In all the earth their line has gone forth, And their words to the end of the world. In the heavens He has made a tent for the sun,","tok":[{"t":"In all the "},{"t":"earth","s":["H0776"],"a":[1]},{"t":" their "},{"t":"line","s":["H6957"],"a":[3]},{"t":" has gone forth, And their "},{"t":"words","s":["H4405"],"a":[6]},{"t":" to the "},{"t":"end","s":["H7097"],"a":[4]},{"t":" of the "},{"t":"world","s":["H8398"],"a":[5]},{"t":". In the heavens He has made a tent for the "},{"t":"sun","s":["H8121"],"a":[7]},{"t":","}]},{"n":5,"text":"And he, like a bridegroom, goes forth from his canopy; He rejoices like a mighty man running the course.","tok":[{"t":"And he, like a "},{"t":"bridegroom","s":["H2860"],"a":[1]},{"t":", goes forth from his canopy; He "},{"t":"rejoices","s":["H7797"],"a":[4]},{"t":" like a mighty "},{"t":"man","s":["H1368"],"a":[5]},{"t":" running the course."}]},{"n":6,"text":"His going forth is from the end of the heavens, And his circuit is unto their ends; And there is nothing hidden from his heat.","tok":[{"t":"His going "},{"t":"forth","s":["H4161"],"a":[2]},{"t":" is from the "},{"t":"end","s":["H7097"],"a":[0]},{"t":" of the "},{"t":"heavens","s":["H8064"],"a":[1]},{"t":", And his "},{"t":"circuit","s":["H8622"],"a":[3]},{"t":" is unto their "},{"t":"ends","s":["H7098"],"a":[5]},{"t":"; And there is nothing hidden from his "},{"t":"heat","s":["H2535"],"a":[8]},{"t":"."}]},{"n":7,"text":"The law of Jehovah is perfect, Restoring the soul; The testimony of Jehovah is faithful, Making the simple wise;","tok":[{"t":"The "},{"t":"law","s":["H8451"],"a":[0]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" is "},{"t":"perfect","s":["H8549"],"a":[2]},{"t":", "},{"t":"Restoring","s":["H7725"],"a":[3]},{"t":" the "},{"t":"soul","s":["H5315"],"a":[4]},{"t":"; The "},{"t":"testimony","s":["H5715"],"a":[5]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" is faithful, Making the "},{"t":"simple","s":["H6612"],"a":[9]},{"t":" "},{"t":"wise","s":["H2449"],"a":[8]},{"t":";"}]},{"n":8,"text":"The precepts of Jehovah are right, Making the heart joyous; The commandment of Jehovah is clear, Enlightening the eyes;","tok":[{"t":"The "},{"t":"precepts","s":["H6490"],"a":[0]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" are "},{"t":"right","s":["H3477"],"a":[2]},{"t":", "},{"t":"Making","s":["H8055"],"a":[3]},{"t":" the "},{"t":"heart","s":["H3820"],"a":[4]},{"t":" joyous; The "},{"t":"commandment","s":["H4687"],"a":[5]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" is "},{"t":"clear","s":["H1249"],"a":[7]},{"t":", "},{"t":"Enlightening","s":["H0215"],"a":[8]},{"t":" the "},{"t":"eyes","s":["H5869"],"a":[9]},{"t":";"}]},{"n":9,"text":"The fear of Jehovah is pure, Enduring forever; The judgments of Jehovah are truth And altogether righteous.","tok":[{"t":"The "},{"t":"fear","s":["H3374"],"a":[0]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" is "},{"t":"pure","s":["H2889"],"a":[2]},{"t":", "},{"t":"Enduring","s":["H5975"],"a":[3]},{"t":" "},{"t":"forever","s":["H5703"],"a":[4]},{"t":"; The "},{"t":"judgments","s":["H4941"],"a":[5]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" are truth And "},{"t":"altogether","s":["H3162"],"a":[9]},{"t":" "},{"t":"righteous","s":["H6663"],"a":[8]},{"t":"."}]},{"n":10,"text":"More to be desired are they than gold, Even much refined gold; Sweeter also than honey And the drippings of the honeycomb.","tok":[{"t":"More to be "},{"t":"desired","s":["H2530"],"a":[0]},{"t":" are they than "},{"t":"gold","s":["H2091"],"a":[1]},{"t":", Even "},{"t":"much","s":["H7227"],"a":[3]},{"t":" refined "},{"t":"gold","s":["H6337"],"a":[2]},{"t":"; "},{"t":"Sweeter","s":["H4966"],"a":[4]},{"t":" also than "},{"t":"honey","s":["H1706"],"a":[5]},{"t":" And the drippings of the "},{"t":"honeycomb","s":["H5317"],"a":[6]},{"t":"."}]},{"n":11,"text":"Moreover by them Your servant is warned; In keeping them there is much reward.","tok":[{"t":"Moreover by them Your "},{"t":"servant","s":["H5650"],"a":[1]},{"t":" is "},{"t":"warned","s":["H2094"],"a":[2]},{"t":"; In "},{"t":"keeping","s":["H8104"],"a":[4]},{"t":" them there is much "},{"t":"reward","s":["H6118"],"a":[5]},{"t":"."}]},{"n":12,"text":"Who can discern his errors? Clear me of my secret faults.","tok":[{"t":"Who can discern his "},{"t":"errors","s":["H7691"],"a":[0]},{"t":"? Clear me of my "},{"t":"secret","s":["H5641"],"a":[3]},{"t":" faults."}]},{"n":13,"text":"Also keep back Your servant from presumptuous sins; Do not let them have dominion over me; Then I will be blameless and cleared Of great transgression.","tok":[{"t":"Also keep "},{"t":"back","s":["H2820"],"a":[2]},{"t":" Your "},{"t":"servant","s":["H5650"],"a":[3]},{"t":" from "},{"t":"presumptuous","s":["H2086"],"a":[1]},{"t":" sins; Do not let them have "},{"t":"dominion","s":["H4910"],"a":[5]},{"t":" over me; Then I will be blameless and cleared Of "},{"t":"great","s":["H7227"],"a":[11]},{"t":" "},{"t":"transgression","s":["H6588"],"a":[10]},{"t":"."}]},{"n":14,"text":"May the words of my mouth and the meditation of my heart Be acceptable before You, O Jehovah, my rock and my Redeemer.","tok":[{"t":"May the "},{"t":"words","s":["H0561"],"a":[2]},{"t":" of my "},{"t":"mouth","s":["H6310"],"a":[3]},{"t":" and the "},{"t":"meditation","s":["H1902"],"a":[4]},{"t":" of my "},{"t":"heart","s":["H3820"],"a":[5]},{"t":" Be "},{"t":"acceptable","s":["H7522"],"a":[1]},{"t":" before You, O "},{"t":"Jehovah","s":["H3068"],"a":[7]},{"t":", my rock and my "},{"t":"Redeemer","s":["H1350"],"a":[9]},{"t":"."}]}]}
