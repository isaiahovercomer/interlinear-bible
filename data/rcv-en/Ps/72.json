{"v":1,"book":"Ps","ch":72,"verses":[{"n":0,"text":"Of Solomon","tok":[{"t":"Of "},{"t":"Solomon","s":["H8010"],"a":[0]}]},{"n":1,"text":"O God, give Your judgments to the king, And Your righteousness to the son of the king.","tok":[{"t":"O "},{"t":"God","s":["H0430"],"a":[0]},{"t":", "},{"t":"give","s":["H5414"],"a":[3]},{"t":" "},{"t":"Your","s":["H4428"],"a":[2]},{"t":" "},{"t":"judgments","s":["H4941"],"a":[1]},{"t":" to the "},{"t":"king","s":["H4428"],"a":[2]},{"t":", And Your "},{"t":"righteousness","s":["H6666"],"a":[4]},{"t":" to the "},{"t":"son","s":["H1121"],"a":[5]},{"t":" of the king."}]},{"n":2,"text":"He will judge Your people in righteousness, And Your poor with justice.","tok":[{"t":"He will "},{"t":"judge","s":["H1777"],"a":[0]},{"t":" Your "},{"t":"people","s":["H5971"],"a":[1]},{"t":" in "},{"t":"righteousness","s":["H6664"],"a":[2]},{"t":", And Your "},{"t":"poor","s":["H6041"],"a":[3]},{"t":" with "},{"t":"justice","s":["H4941"],"a":[4]},{"t":"."}]},{"n":3,"text":"The mountains will bear peace to the people, And the hills, in righteousness.","tok":[{"t":"The "},{"t":"mountains","s":["H2022"],"a":[1]},{"t":" will bear "},{"t":"peace","s":["H7965"],"a":[2]},{"t":" to the "},{"t":"people","s":["H5971"],"a":[3]},{"t":", And the "},{"t":"hills","s":["H1389"],"a":[4]},{"t":", in "},{"t":"righteousness","s":["H6666"],"a":[5]},{"t":"."}]},{"n":4,"text":"He will judge the poor of the people; He will save the children of the needy And crush the oppressor.","tok":[{"t":"He will "},{"t":"judge","s":["H8199"],"a":[0]},{"t":" the "},{"t":"poor","s":["H6041"],"a":[1]},{"t":" of the "},{"t":"people","s":["H5971"],"a":[2]},{"t":"; He will "},{"t":"save","s":["H3467"],"a":[3]},{"t":" the "},{"t":"children","s":["H1121"],"a":[4]},{"t":" of the "},{"t":"needy","s":["H0034"],"a":[5]},{"t":" And "},{"t":"crush","s":["H1792"],"a":[6]},{"t":" the "},{"t":"oppressor","s":["H6231"],"a":[7]},{"t":"."}]},{"n":5,"text":"They will fear You as long as the sun endures And as long as the moon endures Throughout the generations.","tok":[{"t":"They will "},{"t":"fear","s":["H3372"],"a":[0]},{"t":" You as long "},{"t":"as","s":["H5973"],"a":[1]},{"t":" the "},{"t":"sun","s":["H8121"],"a":[2]},{"t":" endures And as long as the "},{"t":"moon","s":["H3394"],"a":[4]},{"t":" "},{"t":"endures","s":["H6440"],"a":[3]},{"t":" "},{"t":"Throughout","s":["H1755"],"a":[5]},{"t":" the "},{"t":"generations","s":["H1755"],"a":[6]},{"t":"."}]},{"n":6,"text":"He will drop like rain upon mown grass, Like abundant showers dripping on the earth.","tok":[{"t":"He will drop like "},{"t":"rain","s":["H4306"],"a":[1]},{"t":" upon "},{"t":"mown","s":["H1488"],"a":[3]},{"t":" grass, Like abundant "},{"t":"showers","s":["H7241"],"a":[4]},{"t":" "},{"t":"dripping","s":["H2222"],"a":[5]},{"t":" on the "},{"t":"earth","s":["H0776"],"a":[6]},{"t":"."}]},{"n":7,"text":"In His days the righteous will flourish, And there will be an abundance of peace Until the moon is no more.","tok":[{"t":"In His "},{"t":"days","s":["H3117"],"a":[1]},{"t":" the "},{"t":"righteous","s":["H6662"],"a":[2]},{"t":" will "},{"t":"flourish","s":["H6524"],"a":[0]},{"t":", And there will be an "},{"t":"abundance","s":["H7230"],"a":[3]},{"t":" of "},{"t":"peace","s":["H7965"],"a":[4]},{"t":" Until the "},{"t":"moon","s":["H3394"],"a":[7]},{"t":" is no more."}]},{"n":8,"text":"And He will have dominion from sea to sea And from the River unto the ends of the earth.","tok":[{"t":"And He will have "},{"t":"dominion","s":["H7287"],"a":[0]},{"t":" from "},{"t":"sea","s":["H3220"],"a":[1]},{"t":" to "},{"t":"sea","s":["H3220"],"a":[3]},{"t":" And from the "},{"t":"River","s":["H5104"],"a":[4]},{"t":" unto the "},{"t":"ends","s":["H0657"],"a":[6]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[7]},{"t":"."}]},{"n":9,"text":"The desert dwellers will bow down before Him, And His enemies will lick the dust.","tok":[{"t":"The desert dwellers will "},{"t":"bow","s":["H3766"],"a":[1]},{"t":" down "},{"t":"before","s":["H6440"],"a":[0]},{"t":" Him, And His "},{"t":"enemies","s":["H0341"],"a":[3]},{"t":" will "},{"t":"lick","s":["H3897"],"a":[5]},{"t":" the "},{"t":"dust","s":["H6083"],"a":[4]},{"t":"."}]},{"n":10,"text":"The kings of Tarshish and of the coastlands Will pay tribute; The kings of Sheba and Seba Will present gifts.","tok":[{"t":"The "},{"t":"kings","s":["H4428"],"a":[0]},{"t":" of "},{"t":"Tarshish","s":["H8659"],"a":[1]},{"t":" and of the coastlands Will pay tribute; The "},{"t":"kings","s":["H4428"],"a":[5]},{"t":" of "},{"t":"Sheba","s":["H7614"],"a":[6]},{"t":" and "},{"t":"Seba","s":["H5434"],"a":[7]},{"t":" Will "},{"t":"present","s":["H4503"],"a":[3]},{"t":" "},{"t":"gifts","s":["H0814"],"a":[8]},{"t":"."}]},{"n":11,"text":"And all the kings will bow down before Him; All the nations will serve Him.","tok":[{"t":"And all the "},{"t":"kings","s":["H4428"],"a":[3]},{"t":" will bow "},{"t":"down","s":["H7812"],"a":[0]},{"t":" before Him; All the "},{"t":"nations","s":["H1471"],"a":[5]},{"t":" will "},{"t":"serve","s":["H5647"],"a":[6]},{"t":" Him."}]},{"n":12,"text":"For He will deliver the needy man when he cries, And the poor man who has no one to help him.","tok":[{"t":"For He will "},{"t":"deliver","s":["H5337"],"a":[1]},{"t":" the "},{"t":"needy","s":["H0034"],"a":[2]},{"t":" man when he "},{"t":"cries","s":["H7768"],"a":[3]},{"t":", And the "},{"t":"poor","s":["H6041"],"a":[4]},{"t":" man who has no one to help him."}]},{"n":13,"text":"He will have pity on the weak and needy, And the souls of the needy He will save.","tok":[{"t":"He will have pity on the weak and "},{"t":"needy","s":["H0034"],"a":[3]},{"t":", And the "},{"t":"souls","s":["H5315"],"a":[4]},{"t":" of the "},{"t":"needy","s":["H0034"],"a":[5]},{"t":" He will "},{"t":"save","s":["H3467"],"a":[6]},{"t":"."}]},{"n":14,"text":"From oppression and violence He will redeem their soul, And their blood will be precious in His sight.","tok":[{"t":"From oppression and "},{"t":"violence","s":["H2555"],"a":[1]},{"t":" He will "},{"t":"redeem","s":["H1350"],"a":[2]},{"t":" their "},{"t":"soul","s":["H5315"],"a":[3]},{"t":", And their "},{"t":"blood","s":["H1818"],"a":[5]},{"t":" will be "},{"t":"precious","s":["H3365"],"a":[4]},{"t":" in "},{"t":"His","s":["H1818"],"a":[5]},{"t":" "},{"t":"sight","s":["H5869"],"a":[6]},{"t":"."}]},{"n":15,"text":"So He shall live and to Him shall be given The gold of Sheba; And prayer shall be made continually for Him; He shall be blessed all the day long.","tok":[{"t":"So He shall "},{"t":"live","s":["H2421"],"a":[0]},{"t":" and to Him shall be "},{"t":"given","s":["H5414"],"a":[1]},{"t":" The "},{"t":"gold","s":["H2091"],"a":[3]},{"t":" of "},{"t":"Sheba","s":["H7614"],"a":[4]},{"t":"; And prayer shall be "},{"t":"made","s":["H6419"],"a":[5]},{"t":" "},{"t":"continually","s":["H8548"],"a":[7]},{"t":" for Him; He shall be blessed all the day long."}]},{"n":16,"text":"There will be an abundance of grain on the earth, Even at the tops of the mountains. Its fruit will wave like the forests of Lebanon, And those of the city will blossom like the foliage of the earth.","tok":[{"t":"There will be an abundance of grain on the "},{"t":"earth","s":["H0776"],"a":[3]},{"t":", Even at the "},{"t":"tops","s":["H7218"],"a":[4]},{"t":" of the "},{"t":"mountains","s":["H2022"],"a":[5]},{"t":". Its "},{"t":"fruit","s":["H6529"],"a":[8]},{"t":" will wave like the forests of "},{"t":"Lebanon","s":["H3844"],"a":[7]},{"t":", And those of the "},{"t":"city","s":["H5892"],"a":[10]},{"t":" will blossom like the foliage of the "},{"t":"earth","s":["H0776"],"a":[12]},{"t":"."}]},{"n":17,"text":"His name will be forever; As long as the sun endures, His name will spread; And men will be blessed in Him; All the nations will call Him blessed.","tok":[{"t":"His "},{"t":"name","s":["H8034"],"a":[1]},{"t":" will be forever; As long as the "},{"t":"sun","s":["H8121"],"a":[4]},{"t":" endures, His "},{"t":"name","s":["H8034"],"a":[6]},{"t":" will spread; And men will be "},{"t":"blessed","s":["H1288"],"a":[7]},{"t":" in Him; All the "},{"t":"nations","s":["H1471"],"a":[10]},{"t":" will call Him "},{"t":"blessed","s":["H0833"],"a":[11]},{"t":"."}]},{"n":18,"text":"Blessed be Jehovah God, the God of Israel, Who alone does wondrous deeds;","tok":[{"t":"Blessed","s":["H1288"],"a":[0]},{"t":" be "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"God","s":["H0430"],"a":[2]},{"t":", the "},{"t":"God","s":["H0430"],"a":[3]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[4]},{"t":", Who alone does wondrous deeds;"}]},{"n":19,"text":"And blessed be His glorious name forever; And may His glory fill the whole earth. Amen and Amen.","tok":[{"t":"And "},{"t":"blessed","s":["H1288"],"a":[0]},{"t":" be His "},{"t":"glorious","s":["H3519"],"a":[2]},{"t":" "},{"t":"name","s":["H8034"],"a":[1]},{"t":" forever; And may His "},{"t":"glory","s":["H3519"],"a":[5]},{"t":" "},{"t":"fill","s":["H4390"],"a":[4]},{"t":" the whole "},{"t":"earth","s":["H0776"],"a":[8]},{"t":". "},{"t":"Amen","s":["H0543"],"a":[9]},{"t":" and "},{"t":"Amen","s":["H0543"],"a":[10]},{"t":"."}]},{"n":20,"text":"The prayers of David the son of Jesse are ended.","tok":[{"t":"The "},{"t":"prayers","s":["H8605"],"a":[1]},{"t":" of "},{"t":"David","s":["H1732"],"a":[2]},{"t":" the "},{"t":"son","s":["H1121"],"a":[3]},{"t":" of "},{"t":"Jesse","s":["H3448"],"a":[4]},{"t":" are "},{"t":"ended","s":["H3615"],"a":[0]},{"t":"."}]}]}
