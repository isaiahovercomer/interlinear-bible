{"v":1,"book":"Ps","ch":15,"verses":[{"n":0,"text":"A Psalm of David","tok":[{"t":"A "},{"t":"Psalm","s":["H4210"],"a":[0]},{"t":" of "},{"t":"David","s":["H1732"],"a":[1]}]},{"n":1,"text":"O Jehovah, who may sojourn in Your tent? Who may dwell on Your holy mountain?","tok":[{"t":"O "},{"t":"Jehovah","s":["H3068"],"a":[0]},{"t":", who may "},{"t":"sojourn","s":["H1481"],"a":[2]},{"t":" in Your "},{"t":"tent","s":["H0168"],"a":[3]},{"t":"? Who may "},{"t":"dwell","s":["H7931"],"a":[5]},{"t":" on Your "},{"t":"holy","s":["H6944"],"a":[7]},{"t":" "},{"t":"mountain","s":["H2022"],"a":[6]},{"t":"?"}]},{"n":2,"text":"He who walks in integrity And does righteousness And speaks truth from his heart.","tok":[{"t":"He who "},{"t":"walks","s":["H1980"],"a":[0]},{"t":" in "},{"t":"integrity","s":["H8549"],"a":[1]},{"t":" And does "},{"t":"righteousness","s":["H6664"],"a":[3]},{"t":" And "},{"t":"speaks","s":["H1696"],"a":[4]},{"t":" "},{"t":"truth","s":["H0571"],"a":[5]},{"t":" from his "},{"t":"heart","s":["H3824"],"a":[6]},{"t":"."}]},{"n":3,"text":"He does not slander with his tongue; He does not do evil to his friend, Nor does he take up a reproach against his neighbor.","tok":[{"t":"He does "},{"t":"not","s":["H3808"],"a":[0]},{"t":" "},{"t":"slander","s":["H7270"],"a":[1]},{"t":" with his "},{"t":"tongue","s":["H3956"],"a":[3]},{"t":"; He does "},{"t":"not","s":["H3808"],"a":[4]},{"t":" do "},{"t":"evil","s":["H7451"],"a":[7]},{"t":" to his friend, Nor does he "},{"t":"take","s":["H5375"],"a":[10]},{"t":" up a "},{"t":"reproach","s":["H2781"],"a":[8]},{"t":" against his "},{"t":"neighbor","s":["H7453"],"a":[6]},{"t":"."}]},{"n":4,"text":"In his eyes a reprobate is despised, But he honors those who fear Jehovah. Should he swear to his harm, He does not change.","tok":[{"t":"In his "},{"t":"eyes","s":["H5869"],"a":[1]},{"t":" a "},{"t":"reprobate","s":["H3988"],"a":[2]},{"t":" is "},{"t":"despised","s":["H0959"],"a":[0]},{"t":", But he "},{"t":"honors","s":["H3513"],"a":[6]