as "},{"t":"failed","s":["H0006"],"a":[6]},{"t":" me; No one "},{"t":"cares","s":["H1875"],"a":[10]},{"t":" for "},{"t":"me","s":["H5315"],"a":[11]},{"t":"."}]},{"n":5,"text":"I cried to You, O Jehovah; I said, You are my refuge, My portion in the land of the living.","tok":[{"t":"I "},{"t":"cried","s":["H2199"],"a":[0]},{"t":" to You, O "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":"; I "},{"t":"said","s":["H0559"],"a":[3]},{"t":", You are my "},{"t":"refuge","s":["H4268"],"a":[5]},{"t":", My "},{"t":"portion","s":["H2506"],"a":[6]},{"t":" in the "},{"t":"land","s":["H0776"],"a":[7]},{"t":" of the "},{"t":"living","s":["H2416"],"a":[8]},{"t":"."}]},{"n":6,"text":"Give heed to my cry, For I have been brought very low; Deliver me from those who persecute me, For they are stronger than I.","tok":[{"t":"Give heed to my "},{"t":"cry","s":["H7440"],"a":[2]},{"t":", For I have been "},{"t":"brought","s":["H1809"],"a":[4]},{"t":" "},{"t":"very","s":["H3966"],"a":[5]},{"t":" "},{"t":"low","s":["H1809"]},{"t":"; "},{"t":"Deliver","s":["H5337"],"a":[6]},{"t":" me from those who persecute me, For they are "},{"t":"stronger","s":["H0553"],"a":[9]},{"t":" than I."}]},{"n":7,"text":"Bring my soul out of prison, That I may give thanks to Your name. The righteous will surround me, For You will deal bountifully with me.","tok":[{"t":"Bring","s":["H3318"],"a":[0]},{"t":" my "},{"t":"soul","s":["H5315"],"a":[2]},{"t":" out of "},{"t":"prison","s":["H4525"],"a":[1]},{"t":", That I may give thanks to Your "},{"t":"name","s":["H8034"],"a":[5]},{"t":". The "},{"t":"righteous","s":["H6662"],"a":[8]},{"t":" will surround me, For You will deal "},{"t":"bountifully","s":["H1580"],"a":[10]},{"t":" with me."}]}]}
