in return for my love.","tok":[{"t":"And they have "},{"t":"set","s":["H7760"],"a":[0]},{"t":" against me "},{"t":"evil","s":["H7451"],"a":[2]},{"t":" in return for "},{"t":"good","s":["H2896"],"a":[4]},{"t":" And "},{"t":"hatred","s":["H8135"],"a":[5]},{"t":" in return for my "},{"t":"love","s":["H0160"],"a":[7]},{"t":"."}]},{"n":6,"text":"Appoint a wicked man over him, And let an adversary stand at his right hand.","tok":[{"t":"Appoint","s":["H6485"],"a":[0]},{"t":" a "},{"t":"wicked","s":["H7563"],"a":[2]},{"t":" "},{"t":"man","s":["H7563"],"a":[2]},{"t":" over him, And let an "},{"t":"adversary","s":["H7854"],"a":[3]},{"t":" "},{"t":"stand","s":["H5975"],"a":[4]},{"t":" at his "},{"t":"right","s":["H3225"],"a":[6]},{"t":" "},{"t":"hand","s":["H3225"],"a":[6]},{"t":"."}]},{"n":7,"text":"When he is judged, let him come forth wicked; And let his prayer be counted as sin.","tok":[{"t":"When he is "},{"t":"judged","s":["H8199"],"a":[0]},{"t":", let him "},{"t":"come","s":["H3318"],"a":[1]},{"t":" "},{"t":"forth","s":["H3318"],"a":[1]},{"t":" "},{"t":"wicked","s":["H7563"],"a":[2]},{"t":"; And let his "},{"t":"prayer","s":["H8605"],"a":[3]},{"t":" be "},{"t":"counted","s":["H2401"],"a":[5]},{"t":" as "},{"t":"sin","s":["H2401"],"a":[5]},{"t":"."}]},{"n":8,"text":"May his days be few; May another take his office.","tok":[{"t":"May his "},{"t":"days","s":["H3117"],"a":[1]},{"t":" be "},{"t":"few","s":["H4592"],"a":[2]},{"t":"; May "},{"t":"another","s":["H0312"],"a":[5]},{"t":" "},{"t":"take","s":["H3947"],"a":[4]},{"t":" his "},{"t":"office","s":["H6486"],"a":[3]},{"t":"."}]},{"n":9,"text":"May his children be orphans, And his wife a widow.","tok":[{"t":"May his "},{"t":"children","s":["H1121"],"a":[1]},{"t":" be "},{"t":"orphans","s":["H3490"],"a":[2]},{"t":", And his "},{"t":"wife","s":["H0802"],"a":[3]},{"t":" a "},{"t":"widow","s":["H0490"],"a":[4]},{"t":"."}]},{"n":10,"text":"And may his children wander all about and beg, And may they seek food far from their desolated ruins.","tok":[{"t":"And may his "},{"t":"children","s":["H1121"],"a":[2]},{"t":" "},{"t":"wander","s":["H5128"],"a":[1]},{"t":" all about and "},{"t":"beg","s":["H7592"],"a":[3]},{"t":", And may they "},{"t":"seek","s":["H1875"],"a":[4]},{"t":" food far from their "},{"t":"desolated","s":["H2723"],"a":[5]},{"t":" "},{"t":"ruins","s":["H2723"],"a":[5]},{"t":"."}]},{"n":11,"text":"May the creditor seize all that he has, And may strangers plunder the fruit of his labor.","tok":[{"t":"May the "},{"t":"creditor","s":["H5383"],"a":[1]},{"t":" seize "},{"t":"all","s":["H3605"],"a":[2]},{"t":" that he has, And may "},{"t":"strangers","s":["H2114"],"a":[6]},{"t":" "},{"t":"plunder","s":["H0962"],"a":[5]},{"t":" the fruit of his "},{"t":"labor","s":["H3018"],"a":[7]},{"t":"."}]},{"n":12,"text":"May there be no one to extend him mercy, Nor anyone to be kind to his orphans.","tok":[{"t":"May there be no one to "},{"t":"extend","s":["H4900"],"a":[3]},{"t":" him "},{"t":"mercy","s":["H2617"],"a":[4]},{"t":", Nor "},{"t":"anyone","s":["H1961"],"a":[6]},{"t":" to be kind to his "},{"t":"orphans","s":["H3490"],"a":[8]},{"t":"."}]},{"n":13,"text":"May his posterity be cut off; In the generation following may his name be blotted out.","tok":[{"t":"May his "},{"t":"posterity","s":["H0319"],"a":[1]},{"t":" be "},{"t":"cut","s":["H3772"],"a":[2]},{"t":" off; In the "},{"t":"generation","s":["H1755"],"a":[3]},{"t":" "},{"t":"following","s":["H0312"],"a":[4]},{"t":" may his "},{"t":"name","s":["H8034"],"a":[6]},{"t":" be "},{"t":"blotted","s":["H4229"],"a":[5]},{"t":" out."}]},{"n":14,"text":"May his fathers’ iniquity be remembered before Jehovah, And may his mother’s sin not be blotted out.","tok":[{"t":"May his "},{"t":"fathers","s":["H0001"],"a":[2]},{"t":"’ "},{"t":"iniquity","s":["H5771"],"a":[1]},{"t":" be "},{"t":"remembered","s":["H2142"],"a":[0]},{"t":" before "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":", And may his "},{"t":"mother’s","s":["H0517"],"a":[6]},{"t":" "},{"t":"sin","s":["H2403"],"a":[5]},{"t":" "},{"t":"not","s":["H0408"],"a":[7]},{"t":" be "},{"t":"blotted","s":["H4229"],"a":[8]},{"t":" out."}]},{"n":15,"text":"May they be before Jehovah continually, So that He may cut off the memory of them from the earth;","tok":[{"t":"May they be before "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" "},{"t":"continually","s":["H8548"],"a":[3]},{"t":", So that He may "},{"t":"cut","s":["H3772"],"a":[4]},{"t":" off the "},{"t":"memory","s":["H2143"],"a":[6]},{"t":" of them from the "},{"t":"earth","s":["H0776"],"a":[5]},{"t":";"}]},{"n":16,"text":"Because he did not remember to show lovingkindness, But persecuted the poor and needy and brokenhearted, To put them to death.","tok":[{"t":"Because he did "},{"t":"not","s":["H3808"],"a":[2]},{"t":" "},{"t":"remember","s":["H2142"],"a":[3]},{"t":" to "},{"t":"show","s":["H6213"],"a":[4]},{"t":" "},{"t":"lovingkindness","s":["H2617"],"a":[5]},{"t":", But "},{"t":"persecuted","s":["H7291"],"a":[6]},{"t":" the "},{"t":"poor","s":["H6041"],"a":[8]},{"t":" and "},{"t":"needy","s":["H0034"],"a":[9]},{"t":" and "},{"t":"brokenhearted","s":["H3512"],"a":[10]},{"t":", To put them to "},{"t":"death","s":["H4191"],"a":[12]},{"t":"."}]},{"n":17,"text":"Indeed he loved cursing, so it came on him; And he took no delight in blessing, so it was far from him.","tok":[{"t":"Indeed he "},{"t":"loved","s":["H0157"],"a":[0]},{"t":" "},{"t":"cursing","s":["H7045"],"a":[1]},{"t":", so it "},{"t":"came","s":["H0935"],"a":[2]},{"t":" on him; And he took "},{"t":"no","s":["H3808"],"a":[3]},{"t":" "},{"t":"delight","s":["H2654"],"a":[4]},{"t":" in "},{"t":"blessing","s":["H1293"],"a":[5]},{"t":", so it was "},{"t":"far","s":["H7368"],"a":[6]},{"t":" from him."}]},{"n":18,"text":"And he clothed himself with cursing like his garment, So it came into his inward parts like water And into his bones like oil.","tok":[{"t":"And he "},{"t":"clothed","s":["H3847"],"a":[0]},{"t":" himself with "},{"t":"cursing","s":["H7045"],"a":[1]},{"t":" like his "},{"t":"garment","s":["H4055"],"a":[2]},{"t":", So it "},{"t":"came","s":["H0935"],"a":[3]},{"t":" into his "},{"t":"inward","s":["H7130"],"a":[5]},{"t":" "},{"t":"parts","s":["H7130"],"a":[5]},{"t":" like "},{"t":"water","s":["H4325"],"a":[4]},{"t":" And into his "},{"t":"bones","s":["H6106"],"a":[7]},{"t":" like "},{"t":"oil","s":["H8081"],"a":[6]},{"t":"."}]},{"n":19,"text":"Let it be to him like the cloak that he wraps around himself, And as a belt with which he constantly girds himself.","tok":[{"t":"Let it be to him like the cloak that he "},{"t":"wraps","s":["H5844"],"a":[3]},{"t":" around himself, And as a belt with which he "},{"t":"constantly","s":["H4206"],"a":[4]},{"t":" "},{"t":"girds","s":["H2296"],"a":[6]},{"t":" himself."}]},{"n":20,"text":"This is the reward from Jehovah for my adversaries And for those who speak evil against my soul.","tok":[{"t":"This is the "},{"t":"reward","s":["H6468"],"a":[1]},{"t":" from "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" for my "},{"t":"adversaries","s":["H7853"],"a":[2]},{"t":" And for those who "},{"t":"speak","s":["H1696"],"a":[5]},{"t":" "},{"t":"evil","s":["H7451"],"a":[6]},{"t":" against my "},{"t":"soul","s":["H5315"],"a":[8]},{"t":"."}]},{"n":21,"text":"But You, O Jehovah Lord, deal with me, For Your name’s sake; Because Your lovingkindness is good, deliver me.","tok":[{"t":"But You, O "},{"t":"Jehovah","s":["H3069"],"a":[1]},{"t":" "},{"t":"Lord","s":["H0136"],"a":[2]},{"t":", "},{"t":"deal","s":["H6213"],"a":[3]},{"t":" with me, For Your "},{"t":"name’s","s":["H8034"],"a":[6]},{"t":" "},{"t":"sake","s":["H4616"],"a":[5]},{"t":"; Because Your "},{"t":"lovingkindness","s":["H2617"],"a":[9]},{"t":" is "},{"t":"good","s":["H2896"],"a":[8]},{"t":", "},{"t":"deliver","s":["H5337"],"a":[10]},{"t":" me."}]},{"n":22,"text":"For I am poor and needy, And my heart is wounded within me.","tok":[{"t":"For I am "},{"t":"poor","s":["H6041"],"a":[1]},{"t":" and "},{"t":"needy","s":["H0034"],"a":[2]},{"t":", And my "},{"t":"heart","s":["H3820"],"a":[4]},{"t":" is "},{"t":"wounded","s":["H2490"],"a":[5]},{"t":" within me."}]},{"n":23,"text":"I am gone like a shadow that declines; I am shaken off like the locust.","tok":[{"t":"I am "},{"t":"gone","s":["H1980"],"a":[2]},{"t":" like a "},{"t":"shadow","s":["H6738"],"a":[0]},{"t":" that "},{"t":"declines","s":["H5186"],"a":[1]},{"t":"; I am "},{"t":"shaken","s":["H5287"],"a":[3]},{"t":" off like the "},{"t":"locust","s":["H0697"],"a":[4]},{"t":"."}]},{"n":24,"text":"My knees wobble through fasting, And my flesh has become lean, without fatness.","tok":[{"t":"My "},{"t":"knees","s":["H1290"],"a":[0]},{"t":" "},{"t":"wobble","s":["H1290"],"a":[0]},{"t":" through "},{"t":"fasting","s":["H6685"],"a":[2]},{"t":", And my "},{"t":"flesh","s":["H1320"],"a":[3]},{"t":" has "},{"t":"become","s":["H3584"],"a":[4]},{"t":" "},{"t":"lean","s":["H3584"],"a":[4]},{"t":", without "},{"t":"fatness","s":["H8081"],"a":[5]},{"t":"."}]},{"n":25,"text":"I have also become a reproach to them: When they see me, they shake their heads.","tok":[{"t":"I have also "},{"t":"become","s":["H1961"],"a":[1]},{"t":" a "},{"t":"reproach","s":["H2781"],"a":[2]},{"t":" to them: When they "},{"t":"see","s":["H7200"],"a":[4]},{"t":" me, they "},{"t":"shake","s":["H5128"],"a":[5]},{"t":" their "},{"t":"heads","s":["H7218"],"a":[6]},{"t":"."}]},{"n":26,"text":"Help me, O Jehovah my God; Save me according to Your lovingkindness;","tok":[{"t":"Help","s":["H5826"],"a":[0]},{"t":" me, O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" my "},{"t":"God","s":["H0430"],"a":[2]},{"t":"; "},{"t":"Save","s":["H3467"],"a":[3]},{"t":" me according to Your "},{"t":"lovingkindness","s":["H2617"],"a":[4]},{"t":";"}]},{"n":27,"text":"And they will know that this is Your hand, That it is You, O Jehovah, who have done it.","tok":[{"t":"And they will "},{"t":"know","s":["H3045"],"a":[0]},{"t":" that this is Your "},{"t":"hand","s":["H3027"],"a":[2]},{"t":", That it is Y