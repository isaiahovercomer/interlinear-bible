,{"t":"burden","s":["H4853"],"a":[4]},{"t":", they are "},{"t":"too","s":["H4480"],"a":[7]},{"t":" "},{"t":"heavy","s":["H3513"],"a":[6]},{"t":" for me."}]},{"n":5,"text":"My wounds are odious and festering Due to my foolishness.","tok":[{"t":"My "},{"t":"wounds","s":["H2250"],"a":[2]},{"t":" are "},{"t":"odious","s":["H0887"],"a":[0]},{"t":" and "},{"t":"festering","s":["H4743"],"a":[1]},{"t":" Due to my "},{"t":"foolishness","s":["H0200"],"a":[4]},{"t":"."}]},{"n":6,"text":"I am bent down and bowed utterly; I go about all day long mourning.","tok":[{"t":"I am "},{"t":"bent","s":["H5753"],"a":[0]},{"t":" down and "},{"t":"bowed","s":["H7817"],"a":[1]},{"t":" "},{"t":"utterly","s":["H3966"],"a":[3]},{"t":"; I "},{"t":"go","s":["H1980"],"a":[7]},{"t":" about "},{"t":"all","s":["H3605"],"a":[4]},{"t":" "},{"t":"day","s":["H3117"],"a":[5]},{"t":" "},{"t":"long","s":["H5704"],"a":[2]},{"t":" "},{"t":"mourning","s":["H6937"],"a":[6]},{"t":"."}]},{"n":7,"text":"For my loins are filled with burning, And there is no soundness in my flesh.","tok":[{"t":"For my "},{"t":"loins","s":["H3689"],"a":[1]},{"t":" are "},{"t":"filled","s":["H4390"],"a":[2]},{"t":" with "},{"t":"burning","s":["H7033"],"a":[3]},{"t":", And there is "},{"t":"no","s":["H0369"],"a":[4]},{"t":" "},{"t":"soundness","s":["H4974"],"a":[5]},{"t":" in my "},{"t":"flesh","s":["H1320"],"a":[6]},{"t":"."}]},{"n":8,"text":"I am benumbed and crushed utterly; I cry out due to the groaning of my heart.","tok":[{"t":"I am "},{"t":"benumbed","s":["H6313"],"a":[0]},{"t":" and "},{"t":"crushed","s":["H1794"],"a":[1]},{"t":" "},{"t":"utterly","s":["H7580"],"a":[4]},{"t":"; I cry out due to the "},{"t":"groaning","s":["H5100"],"a":[5]},{"t":" of my "},{"t":"heart","s":["H3820"],"a":[6]},{"t":"."}]},{"n":9,"text":"O Lord, all my desire is before You, And my groaning is not hidden from You.","tok":[{"t":"O "},{"t":"Lord","s":["H0136"],"a":[0]},{"t":", "},{"t":"all","s":["H3605"],"a":[2]},{"t":" my "},{"t":"desire","s":["H8378