{"v":1,"book":"Ps","ch":85,"verses":[{"n":0,"text":"To the choir director. Of the sons of Korah. A Psalm","tok":[{"t":"To the choir director. Of the "},{"t":"sons","s":["H1121"],"a":[1]},{"t":" of "},{"t":"Korah","s":["H7141"],"a":[2]},{"t":". A "},{"t":"Psalm","s":["H4210"],"a":[3]}]},{"n":1,"text":"You have been pleased, O Jehovah, with Your land; You have turned the captivity of Jacob.","tok":[{"t":"You have been pleased, O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", with "},{"t":"Your","s":["H7521"],"a":[0]},{"t":" "},{"t":"land","s":["H0776"],"a":[2]},{"t":"; You have turned the "},{"t":"captivity","s":["H7622"],"a":[4]},{"t":" of "},{"t":"Jacob","s":["H3290"],"a":[5]},{"t":"."}]},{"n":2,"text":"You have forgiven the iniquity of Your people; You have covered all their sin. Selah","tok":[{"t":"You have "},{"t":"forgiven","s":["H5375"],"a":[0]},{"t":" the "},{"t":"iniquity","s":["H5771"],"a":[1]},{"t":" of Your "},{"t":"people","s":["H5971"],"a":[2]},{"t":"; You have "},{"t":"covered","s":["H3680"],"a":[3]},{"t":" all their "},{"t":"sin","s":["H2403"],"a":[5]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[6]}]},{"n":3,"text":"You have taken away all Your wrath; You have turned from the fierceness of Your anger.","tok":[{"t":"You have taken "},{"t":"away","s":["H0622"],"a":[0]},{"t":" all Your "},{"t":"wrath","s":["H5678"],"a":[2]},{"t":"; You have "},{"t":"turned","s":["H7725"],"a":[3]},{"t":" from the "},{"t":"fierceness","s":["H2740"],"a":[4]},{"t":" of Your "},{"t":"anger","s":["H0639"],"a":[5]},{"t":"."}]},{"n":4,"text":"Restore us, O God of our salvation, And cause Your indignation toward us to cease.","tok":[{"t":"Restore us, O "},{"t":"God","s":["H0430"],"a":[1]},{"t":" of our "},{"t":"salvation","s":["H3468"],"a":[2]},{"t":", And cause Your indignation toward us to "},{"t":"cease","s":["H6565"],"a":[3]},{"t":"."}]},{"n":5,"text":"Will You be angry with us forever? Will You extend Your anger from generation to generation?","tok":[{"t":"Will You be "},{"t":"angry","s":["H0599"],"a":[1]},{"t":" with us forever? Will You extend Your "},{"t":"anger","s":["H0639"],"a":[4]},{"t":" from "},{"t":"generation","s":["H1755"],"a":[5]},{"t":" to "},{"t":"generation","s":["H1755"],"a":[6]},{"t":"?"}]},{"n":6,"text":"Will You not again revive us, That Your people may rejoice in You?","tok":[{"t":"Will You not "},{"t":"again","s":["H7725"],"a":[2]},{"t":" "},{"t":"revive","s":["H2421"],"a":[3]},{"t":" us, That Your "},{"t":"people","s":["H5971"],"a":[4]},{"t":" may "},{"t":"rejoice","s":["H8055"],"a":[5]},{"t":" in You?"}]},{"n":7,"text":"Show us, O Jehovah, Your lovingkindness, And grant us Your salvation.","tok":[{"t":"Show us, O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", Your lovingkindness, And "},{"t":"grant","s":["H5414"],"a":[4]},{"t":" us Your "},{"t":"salvation","s":["H3468"],"a":[3]},{"t":"."}]},{"n":8,"text":"I will hear what God Jehovah will speak, For He will speak peace To His people and to His faithful ones; But let them not turn again unto folly.","tok":[{"t":"I will "},{"t":"hear","s":["H8085"],"a":[0]},{"t":" what "},{"t":"God","s":["H0410"],"a":[3]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" will "},{"t":"speak","s":["H1696"],"a":[2]},{"t":", For He will "},{"t":"speak","s":["H1696"],"a":[6]},{"t":" "},{"t":"peace","s":["H7965"],"a":[7]},{"t":" To His "},{"t":"people","s":["H5971"],"a":[9]},{"t":" and to His faithful ones; But let them not turn "},{"t":"again","s":["H7725"],"a":[13]},{"t":" unto "},{"t":"folly","s":["H3690"],"a":[14]},{"t":"."}]},{"n":9,"text":"Surely His salvation is near to those who fear Him, That glory may dwell in our land.","tok":[{"t":"Surely His "},{"t":"salvation","s":["H3468"],"a":[3]},{"t":" is "},{"t":"near","s":["H7138"],"a":[1]},{"t":" to those who "},{"t":"fear","s":["H3373"],"a":[2]},{"t":" Him, That "},{"t":"glory","s":["H3519"],"a":[5]},{"t":" may "},{"t":"dwell","s":["H7931"],"a":[4]},{"t":" in our "},{"t":"land","s":["H0776"],"a":[6]},{"t":"."}]},{"n":10,"text":"Lovingkindness and truth have met together; Righteousness and peace have kissed each other.","tok":[{"t":"Lovingkindness","s":["H2617"],"a":[0]},{"t":" and "},{"t":"truth","s":["H0571"],"a":[1]},{"t":" have met "},{"t":"together","s":["H6298"],"a":[2]},{"t":"; "},{"t":"Righteousness","s":["H6664"],"a":[3]},{"t":" and "},{"t":"peace","s":["H7965"],"a":[4]},{"t":" have "},{"t":"kissed","s":["H5401"],"a":[5]},{"t":" each other."}]},{"n":11,"text":"Truth has sprung forth from the earth, And righteousness has looked down from heaven.","tok":[{"t":"Truth","s":["H0571"],"a":[0]},{"t":" has sprung forth from the "},{"t":"earth","s":["H0776"],"a":[1]},{"t":", And "},{"t":"righteousness","s":["H6664"],"a":[3]},{"t":" has looked "},{"t":"down","s":["H8259"],"a":[5]},{"t":" from "},{"t":"heaven","s":["H8064"],"a":[4]},{"t":"."}]},{"n":12,"text":"Indeed Jehovah will give what is good, And our land will give its increase.","tok":[{"t":"Indeed "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" will "},{"t":"give","s":["H5414"],"a":[2]},{"t":" what is "},{"t":"good","s":["H2896"],"a":[3]},{"t":", And our "},{"t":"land","s":["H0776"],"a":[4]},{"t":" will give its "},{"t":"increase","s":["H2981"],"a":[6]},{"t":"."}]},{"n":13,"text":"Righteousness will go before Him And make His footsteps a way to walk in.","tok":[{"t":"Righteousness","s":["H6664"],"a":[0]},{"t":" will "},{"t":"go","s":["H1980"],"a":[2]},{"t":" "},{"t":"before","s":["H6440"],"a":[1]},{"t":" Him And make His footsteps a "},{"t":"way","s":["H1870"],"a":[4]},{"t":" to "},{"t":"walk","s":["H6471"],"a":[5]},{"t":" in."}]}]}
