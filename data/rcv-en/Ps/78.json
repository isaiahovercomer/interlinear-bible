ts."}]},{"n":49,"text":"He sent among them the burning fierceness of His anger, Overflowing wrath and indignation and trouble, A mission of angels of evils.","tok":[{"t":"He sent among them the burning "},{"t":"fierceness","s":["H2740"],"a":[2]},{"t":" of His "},{"t":"anger","s":["H0639"],"a":[3]},{"t":", Overflowing "},{"t":"wrath","s":["H5678"],"a":[4]},{"t":" and "},{"t":"indignation","s":["H2195"],"a":[5]},{"t":" and "},{"t":"trouble","s":["H6869"],"a":[6]},{"t":", A mission of "},{"t":"angels","s":["H4397"],"a":[8]},{"t":" of "},{"t":"evils","s":["H7451"],"a":[9]},{"t":"."}]},{"n":50,"text":"He leveled a path for His anger; He did not spare their soul from death, But gave their life over to the pestilence.","tok":[{"t":"He leveled a path for His "},{"t":"anger","s":["H0639"],"a":[2]},{"t":"; He did not "},{"t":"spare","s":["H2820"],"a":[4]},{"t":" their "},{"t":"soul","s":["H5315"],"a":[6]},{"t":" from "},{"t":"death","s":["H4194"],"a":[5]},{"t":", But "},{"t":"gave","s":["H5462"],"a":[9]},{"t":" their "},{"t":"life","s":["H2416"],"a":[7]},{"t":" "},{"t":"over","s":["H5462"]},{"t":" to the "},{"t":"pestilence","s":["H1698"],"a":[8]},{"t":"."}]},{"n":51,"text":"And He struck all the firstborn in Egypt, The firstfruits of their vigor in the tents of Ham.","tok":[{"t":"And He struck all the "},{"t":"firstborn","s":["H1060"],"a":[2]},{"t":" in "},{"t":"Egypt","s":["H4714"],"a":[3]},{"t":", The firstfruits of their vigor in the tents of "},{"t":"Ham","s":["H2526"],"a":[7]},{"t":"."}]},{"n":52,"text":"But He set forth His people like sheep And led them like a flock in the wilderness.","tok":[{"t":"But He set "},{"t":"forth","s":["H5265"],"a":[0]},{"t":" His "},{"t":"people","s":["H5971"],"a":[2]},{"t":" "},{"t":"like","s":["H5265"],"a":[0]},{"t":" "},{"t":"sheep","s":["H6629"],"a":[1]},{"t":" And led them like a "},{"t":"flock","s":["H5739"],"a":[4]},{"t":" in the "},{"t":"wilderness","s":["H4057"],"a":[5]},{"t":"."}]},{"n":53,"text":"And He led them to safety, so that they did not fear; But the sea covered their enemies.","tok":[{"t":"And He "},{"t":"led","s":["H5148"],"a":[0]},{"t":" them to safety, so that they did not "},{"t":"fear","s":["H6342"],"a":[3]},{"t":"; But the "},{"t":"sea","s":["H3220"],"a":[7]},{"t":" covered their "},{"t":"enemies","s":["H0341"],"a":[5]},{"t":"."}]},{"n":54,"text":"And He brought them forth to His holy border, The mountain, which His right hand had acquired.","tok":[{"t":"And He "},{"t":"brought","s":["H0935"],"a":[0]},{"t":" them forth to His holy "},{"t":"border","s":["H1366"],"a":[2]},{"t":", The "},{"t":"mountain","s":["H2022"],"a":[4]},{"t":", which His right "},{"t":"hand","s":["H3225"],"a":[7]},{"t":" had acquired."}]},{"n":55,"text":"And He drove out the nations before them And allotted them as an inheritance by line, And He made the tribes of Israel dwell there in their tents.","tok":[{"t":"And He drove "},{"t":"out","s":["H1644"],"a":[0]},{"t":" the "},{"t":"nations","s":["H1471"],"a":[2]},{"t":" "},{"t":"before","s":["H6440"],"a":[1]},{"t":" them And allotted them as an "},{"t":"inheritance","s":["H5159"],"a":[5]},{"t":" by "},{"t":"line","s":["H2256"],"a":[4]},{"t":", And He made the "},{"t":"tribes","s":["H7626"],"a":[8]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[9]},{"t":" "},{"t":"dwell","s":["H7931"],"a":[6]},{"t":" there in their "},{"t":"tents","s":["H0168"],"a":[7]},{"t":"."}]},{"n":56,"text":"Yet they put Him to the test and rebelled against God the Most High, And did not keep His testimonies.","tok":[{"t":"Yet they put Him to the test and rebelled against "},{"t":"God","s":["H0430"],"a":[3]},{"t":" the Most "},{"t":"High","s":["H5945"],"a":[4]},{"t":", And did not keep His "},{"t":"testimonies","s":["H5713"],"a":[5]},{"t":"."}]},{"n":57,"text":"And they turned back and dealt treacherously, as their fathers had done; They turned aside like a deceitful bow.","tok":[{"t":"And they turned "},{"t":"back","s":["H5472"],"a":[0]},{"t":" and dealt treacherously, as their "},{"t":"fathers","s":["H0001"],"a":[2]},{"t":" had done; They turned "},{"t":"aside","s":["H2015"],"a":[3]},{"t":" like a "},{"t":"deceitful","s":["H7423"],"a":[5]},{"t":" "},{"t":"bow","s":["H7198"],"a":[4]},{"t":"."}]},{"n":58,"text":"Indeed they provoked Him to anger with their high places And made Him jealous with their graven images.","tok":[{"t":"Indeed they provoked Him to "},{"t":"anger","s":["H3707"],"a":[0]},{"t":" with their high "},{"t":"places","s":["H1116"],"a":[1]},{"t":" And made Him jealous with their graven "},{"t":"images","s":["H6456"],"a":[2]},{"t":"."}]},{"n":59,"text":"God heard, and He was angered; And He greatly abhorred Israel.","tok":[{"t":"God","s":["H0430"],"a":[1]},{"t":" "},{"t":"heard","s":["H8085"],"a":[0]},{"t":", and He was angered; And He "},{"t":"greatly","s":["H3966"],"a":[4]},{"t":" "},{"t":"abhorred","s":["H3988"],"a":[3]},{"t":" "},{"t":"Israel","s":["H3478"],"a":[5]},{"t":"."}]},{"n":60,"text":"Thus He forsook the tabernacle in Shiloh, The tent in which He dwelt among men;","tok":[{"t":"Thus He "},{"t":"forsook","s":["H5203"],"a":[0]},{"t":" the "},{"t":"tabernacle","s":["H4908"],"a":[1]},{"t":" in "},{"t":"Shiloh","s":["H7887"],"a":[2]},{"t":", The "},{"t":"tent","s":["H0168"],"a":[3]},{"t":" in which He dwelt among "},{"t":"men","s":["H0120"],"a":[5]},{"t":";"}]},{"n":61,"text":"And He gave over His Ark into captivity, And His glory into the hand of the adversary.","tok":[{"t":"And He gave over His Ark into "},{"t":"captivity","s":["H7628"],"a":[1]},{"t":", And His "},{"t":"glory","s":["H8597"],"a":[3]},{"t":" into the "},{"t":"hand","s":["H3027"],"a":[4]},{"t":" of the adversary."}]},{"n":62,"text":"He also delivered His people to the sword And was angry with His inheritance.","tok":[{"t":"He also delivered His "},{"t":"people","s":["H5971"],"a":[2]},{"t":" to the "},{"t":"sword","s":["H2719"],"a":[1]},{"t":" And was angry with His "},{"t":"inheritance","s":["H5159"],"a":[3]},{"t":"."}]},{"n":63,"text":"Fire devoured their young men, And their virgins had no marriage song.","tok":[{"t":"Fire","s":["H0784"],"a":[2]},{"t":" devoured their young "},{"t":"men","s":["H0970"],"a":[0]},{"t":", And their virgins had no "},{"t":"marriage","s":["H1984"],"a":[5]},{"t":" song."}]},{"n":64,"text":"Their priests fell by the sword, And their widows did not lament.","tok":[{"t":"Their "},{"t":"priests","s":["H3548"],"a":[0]},{"t":" "},{"t":"fell","s":["H5307"],"a":[2]},{"t":" by the "},{"t":"sword","s":["H2719"],"a":[1]},{"t":", And their "},{"t":"widows","s":["H0490"],"a":[3]},{"t":" did not lament."}]},{"n":65,"text":"Then the Lord awoke as if from sleep, Like a mighty man who shouts because of wine.","tok":[{"t":"Then the "},{"t":"Lord","s":["H0136"],"a":[2]},{"t":" awoke as if from "},{"t":"sleep","s":["H3463"],"a":[1]},{"t":", Like a mighty "},{"t":"man","s":["H1368"],"a":[3]},{"t":" who "},{"t":"shouts","s":["H7442"],"a":[4]},{"t":" because of "},{"t":"wine","s":["H3196"],"a":[5]},{"t":"."}]},{"n":66,"text":"And He struck His adversaries and sent them back; He put an everlasting reproach upon them.","tok":[{"t":"And He struck His adversaries and sent them back; He "},{"t":"put","s":["H5414"],"a":[5]},{"t":" an "},{"t":"everlasting","s":["H5769"],"a":[4]},{"t":" "},{"t":"reproach","s":["H2781"],"a":[3]},{"t":" upon them."}]},{"n":67,"text":"And He rejected the tent of Joseph, And the tribe of Ephraim He did not choose.","tok":[{"t":"And He rejected the tent of "},{"t":"Joseph","s":["H3130"],"a":[2]},{"t":", And the "},{"t":"tribe","s":["H7626"],"a":[3]},{"t":" of "},{"t":"Ephraim","s":["H0669"],"a":[4]},{"t":" He did not choose."}]},{"n":68,"text":"Rather He chose the tribe of Judah, Mount Zion, which He loved.","tok":[{"t":"Rather He "},{"t":"chose","s":["H0977"],"a":[0]},{"t":" the "},{"t":"tribe","s":["H7626"],"a":[2]},{"t":" of "},{"t":"Judah","s":["H3063"],"a":[3]},{"t":", "},{"t":"Mount","s":["H2022"],"a":[5]},{"t":" "},{"t":"Zion","s":["H6726"],"a":[6]},{"t":", which He "},{"t":"loved","s":["H0157"],"a":[8]},{"t":"."}]},{"n":69,"text":"And He built His sanctuary like the heights, Like the earth that He has founded forever.","tok":[{"t":"And He "},{"t":"built","s":["H1129"],"a":[0]},{"t":" His "},{"t":"sanctuary","s":["H4720"],"a":[3]},{"t":" like the heights, Like the "},{"t":"earth","s":["H0776"],"a":[4]},{"t":" that He has founded forever."}]},{"n":70,"text":"Moreover He chose David His servant And took him from the sheepfolds;","tok":[{"t":"Moreover He "},{"t":"chose","s":["H0977"],"a":[0]},{"t":" "},{"t":"David","s":["H1732"],"a":[1]},{"t":" His "},{"t":"servant","s":["H5650"],"a":[2]},{"t":" And "},{"t":"took","s":["H3947"],"a":[3]},{"t":" him from the "},{"t":"sheepfolds","s":["H4356"],"a":[4]},{"t":";"}]},{"n":71,"text":"From following after the ewes He brought him To shepherd Jacob His people And Israel His inheritance.","tok":[{"t":"From "},{"t":"following","s":["H0310"],"a":[0]},{"t":" after the ewes He "},{"t":"brought","s":["H0935"],"a":[2]},{"t":" him To shepherd "},{"t":"Jacob","s":["H3290"],"a":[4]},{"t":" His "},{"t":"people","s":["H5971"],"a":[5]},{"t":" And "},{"t":"Israel","s":["H3478"],"a":[6]},{"t":" His "},{"t":"inheritance","s":["H5159"],"a":[7]},{"t":"."}]},{"n":72,"text":"And he shepherded them according to the integrity of his heart, And guided them by the skillfulness of his hands.","tok":[{"t":"And he shepherded them according to the "},{"t":"integrity","s":["H8537"],"a":[1]},{"t":" of his "},{"t":"heart","s":["H3824"],"a":[2]},{"t":", And "},{"t":"guided","s":["H5148"],"a":[5]},{"t":" them by the skillfulness of his "},{"t":"hands","s":["H3709"],"a":[4]},{"t":"."}]}]}
