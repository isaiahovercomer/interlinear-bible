engthened for Yourself;","tok":[{"t":"Let Your "},{"t":"hand","s":["H3027"],"a":[1]},{"t":" be upon the "},{"t":"man","s":["H0376"],"a":[3]},{"t":" of Your "},{"t":"right","s":["H3225"],"a":[4]},{"t":" "},{"t":"hand","s":["H3225"],"a":[4]},{"t":", Upon the "},{"t":"son","s":["H1121"],"a":[6]},{"t":" of "},{"t":"man","s":["H0120"],"a":[7]},{"t":" whom You have "},{"t":"strengthened","s":["H0553"],"a":[8]},{"t":" for Yourself;"}]},{"n":18,"text":"Then we will not turn back from You. Revive us, and we will call upon Your name.","tok":[{"t":"Then we will "},{"t":"not","s":["H3808"],"a":[0]},{"t":" "},{"t":"turn","s":["H5472"],"a":[1]},{"t":" "},{"t":"back","s":["H5472"],"a":[1]},{"t":" from You. "},{"t":"Revive","s":["H2421"],"a":[3]},{"t":" us, and we will "},{"t":"call","s":["H7121"],"a":[5]},{"t":" upon Your "},{"t":"name","s":["H8034"],"a":[4]},{"t":"."}]},{"n":19,"text":"O Jehovah God of hosts, restore us; Cause Your face to shine, and we will be saved.","tok":[{"t":"O "},{"t":"Jehovah","s":["H3068"],"a":[0]},{"t":" "},{"t":"God","s":["H0430"],"a":[1]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[2]},{"t":", "},{"t":"restore","s":["H7725"],"a":[3]},{"t":" us; Cause Your "},{"t":"face","s":["H6440"],"a":[5]},{"t":" to "},{"t":"shine","s":["H0215"],"a":[4]},{"t":", and we will be "},{"t":"saved","s":["H3467"],"a":[6]},{"t":"."}]}]}
