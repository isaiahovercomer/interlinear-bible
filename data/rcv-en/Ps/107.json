"],"a":[1]},{"t":" against the "},{"t":"words","s":["H0561"],"a":[2]},{"t":" of "},{"t":"God","s":["H0410"],"a":[3]},{"t":" And "},{"t":"spurned","s":["H5006"],"a":[6]},{"t":" the "},{"t":"counsel","s":["H6098"],"a":[4]},{"t":" of the Most "},{"t":"High","s":["H5945"],"a":[5]},{"t":";"}]},{"n":12,"text":"Therefore He brought down their heart with labor; They stumbled, and there was no one to help them.","tok":[{"t":"Therefore He brought "},{"t":"down","s":["H3665"],"a":[0]},{"t":" their "},{"t":"heart","s":["H3820"],"a":[2]},{"t":" with labor; They stumbled, and there was no one to "},{"t":"help","s":["H5826"],"a":[5]},{"t":" them."}]},{"n":13,"text":"Then they cried out to Jehovah in their trouble, And He saved them from their distresses.","tok":[{"t":"Then they "},{"t":"cried","s":["H2199"],"a":[0]},{"t":" out to "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" in their "},{"t":"trouble","s":["H6862"],"a":[3]},{"t":", And He "},{"t":"saved","s":["H3467"],"a":[6]},{"t":" them from their "},{"t":"distresses","s":["H4691"],"a":[5]},{"t":"."}]},{"n":14,"text":"He brought them out of darkness and the shadow of death, And He broke apart their bonds.","tok":[{"t":"He brought them "},{"t":"out","s":["H3318"],"a":[0]},{"t":" of "},{"t":"darkness","s":["H2822"],"a":[1]},{"t":" and the shadow of "},{"t":"death","s":["H6757"],"a":[2]},{"t":", And He broke apart their bonds."}]},{"n":15,"text":"Let them give thanks to Jehovah for His lovingkindness And for His wondrous deeds to the children of men.","tok":[{"t":"Let them give thanks to "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" for His lovingkindness And for His wondrous deeds to the "},{"t":"children","s":["H1121"],"a":[4]},{"t":" of "},{"t":"men","s":["H0120"],"a":[5]},{"t":"."}]},{"n":16,"text":"For He breaks down the doors of bronze And cuts down the bars of iron.","tok":[{"t":"For He breaks down the doors of bronze And "},{"t":"cuts","s":["H1438"],"a":[6]},{"t":" down the "},{"t":"bars","s":["H1280"],"a":[4]},{"t":" of "},{"t":"iron","s":["H1270"],"a":[5]},{"t":"."}]},{"n":17,"text":"Some were fools, because of their way of transgression; And because of their iniquities, they were afflicted.","tok":[{"t":"Some were "},{"t":"fools","s":["H0191"],"a":[0]},{"t":", "},{"t":"because","s":["H1870"],"a":[1]},{"t":" of their way of "},{"t":"transgression","s":["H6588"],"a":[2]},{"t":"; And because of their "},{"t":"iniquities","s":["H5771"],"a":[3]},{"t":", they were "},{"t":"afflicted","s":["H6031"],"a":[4]},{"t":"."}]},{"n":18,"text":"Their soul loathed all food, And they drew near to the gates of death.","tok":[{"t":"Their "},{"t":"soul","s":["H5315"],"a":[3]},{"t":" loathed all food, And they drew "},{"t":"near","s":["H5060"],"a":[4]},{"t":" to the "},{"t":"gates","s":["H8179"],"a":[6]},{"t":" of "},{"t":"death","s":["H4194"],"a":[7]},{"t":"."}]},{"n":19,"text":"Then they cried out to Jehovah in their trouble, And He saved them out of their distresses.","tok":[{"t":"Then they cried out to "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" in their "},{"t":"trouble","s":["H6862"],"a":[3]},{"t":", And He "},{"t":"saved","s":["H3467"],"a":[6]},{"t":" them out of their "},{"t":"distresses","s":["H4691"],"a":[5]},{"t":"."}]},{"n":20,"text":"He sent forth His word and healed them, And He delivered them from the pits of destruction.","tok":[{"t":"He "},{"t":"sent","s":["H7971"],"a":[0]},{"t":" forth His "},{"t":"word","s":["H1697"],"a":[1]},{"t":" and "},{"t":"healed","s":["H7495"],"a":[2]},{"t":" them, And He "},{"t":"delivered","s":["H4422"],"a":[3]},{"t":" them from the pits of "},{"t":"destruction","s":["H7825"],"a":[4]},{"t":"."}]},{"n":21,"text":"Let them give thanks to Jehovah for His lovingkindness And for His wondrous deeds to the children of men.","tok":[{"t":"Let them give thanks to "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" for His lovingkindness And for His wondrous deeds to the "},{"t":"children","s":["H1121"],"a":[4]},{"t":" of "},{"t":"men","s":["H0120"],"a":[5]},{"t":"."