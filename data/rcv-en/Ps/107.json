{"v":1,"book":"Ps","ch":107,"verses":[{"n":1,"text":"Give thanks to Jehovah, for He is good, For His lovingkindness is forever.","tok":[{"t":"Give "},{"t":"thanks","s":["H3034"],"a":[0]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", for He is "},{"t":"good","s":["H2896"]},{"t":", For His lovingkindness is forever."}]},{"n":2,"text":"Let the redeemed of Jehovah say so, Whom He redeemed from the hand of the adversary,","tok":[{"t":"Let the "},{"t":"redeemed","s":["H1350"],"a":[1]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" "},{"t":"say","s":["H0559"],"a":[0]},{"t":" so, Whom He "},{"t":"redeemed","s":["H1350"],"a":[4]},{"t":" from the "},{"t":"hand","s":["H3027"],"a":[5]},{"t":" of the "},{"t":"adversary","s":["H6862"],"a":[6]},{"t":","}]},{"n":3,"text":"And gathered out of the lands, From the east and from the west, From the north and from the south.","tok":[{"t":"And "},{"t":"gathered","s":["H6908"],"a":[1]},{"t":" out of the "},{"t":"lands","s":["H0776"],"a":[0]},{"t":", From the "},{"t":"east","s":["H4217"],"a":[2]},{"t":" and from the "},{"t":"west","s":["H4628"],"a":[3]},{"t":", From the "},{"t":"north","s":["H6828"],"a":[4]},{"t":" and from the "},{"t":"south","s":["H3220"],"a":[5]},{"t":"."}]},{"n":4,"text":"They wandered in the wilderness, on the desert way; They found no city of habitation.","tok":[{"t":"They "},{"t":"wandered","s":["H8582"],"a":[0]},{"t":" in the "},{"t":"wilderness","s":["H4057"],"a":[1]},{"t":", on the "},{"t":"desert","s":["H3452"],"a":[2]},{"t":" "},{"t":"way","s":["H1870"],"a":[3]},{"t":"; They "},{"t":"found","s":["H4672"],"a":[7]},{"t":" no "},{"t":"city","s":["H5892"],"a":[4]},{"t":" of "},{"t":"habitation","s":["H4186"],"a":[5]},{"t":"."}]},{"n":5,"text":"Hungry and thirsty, Their soul fainted within them.","tok":[{"t":"Hungry","s":["H7457"],"a":[0]},{"t":" and "},{"t":"thirsty","s":["H6771"],"a":[2]},{"t":", Their "},{"t":"soul","s":["H5315"],"a":[3]},{"t":" "},{"t":"fainted","s":["H5848"],"a":[5]},{"t"