 a drunken man, And all their skill was swallowed up.","tok":[{"t":"They reeled and "},{"t":"staggered","s":["H5128"],"a":[1]},{"t":" like a drunken "},{"t":"man","s":["H7910"],"a":[2]},{"t":", And all their skill was swallowed up."}]},{"n":28,"text":"Then they cried out to Jehovah in their trouble, And He brought them out of their distresses.","tok":[{"t":"Then they cried out to "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" in their "},{"t":"trouble","s":["H6862"],"a":[3]},{"t":", And He brought them "},{"t":"out","s":["H3318"],"a":[6]},{"t":" of their "},{"t":"distresses","s":["H4691"],"a":[5]},{"t":"."}]},{"n":29,"text":"He made the storm be still, And the waves of the sea were calm;","tok":[{"t":"He made the "},{"t":"storm","s":["H5591"],"a":[1]},{"t":" be "},{"t":"still","s":["H2814"],"a":[3]},{"t":", And the "},{"t":"waves","s":["H1530"],"a":[4]},{"t":" of the sea were "},{"t":"calm","s":["H1827"],"a":[2]},{"t":";"}]},{"n":30,"text":"And they rejoiced that they were quiet, And He brought them to the haven they desired.","tok":[{"t":"And they rejoiced that they were "},{"t":"quiet","s":["H8367"],"a":[2]},{"t":", And He brought them to the "},{"t":"haven","s":["H4231"],"a":[5]},{"t":" they "},{"t":"desired","s":["H2656"],"a":[6]},{"t":"."}]},{"n":31,"text":"Let them give thanks to Jehovah for His lovingkindness And for His wondrous deeds to the children of men.","tok":[{"t":"Let them give thanks to "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" for His lovingkindness And for His wondrous deeds to the "},{"t":"children","s":["H1121"],"a":[4]},{"t":" of "},{"t":"men","s":["H0120"],"a":[5]},{"t":"."}]},{"n":32,"text":"And let them exalt Him in the congregation of the people And praise Him in the assembly of the elders.","tok":[{"t":"And let them "},{"t":"exalt","s":["H7311"],"a":[0]},{"t":" Him in the "},{"t":"congregation","s":["H6951"],"a":[1]},{"t":" of the "},{"t":"people","s":["H5971"],"a":[2]},{"t":" And "},{"t":"praise","s":["H1984"],"a":[5]},{"t":" Him in the "},{"t":"assembly","s":["H4186"],"a":[3]},{"t":" of the "},{"t":"elders","s":["H2205"],"a":[4]},{"t":"."}]},{"n":33,"text":"He turns rivers into a wilderness, And springs of water into thirsty ground;","tok":[{"t":"He "},{"t":"turns","s":["H7760"],"a":[0]},{"t":" "},{"t":"rivers","s":["H5104"],"a":[1]},{"t":" into a "},{"t":"wilderness","s":["H4057"],"a":[2]},{"t":", And springs of water into thirsty "},{"t":"ground","s":["H6774"],"a":[5]},{"t":";"}]},{"n":34,"text":"Fruitful land into a salt flat, Because of the wickedness of those who dwell in it.","tok":[{"t":"Fruitful","s":["H6529"],"a":[1]},{"t":" "},{"t":"land","s":["H0776"],"a":[0]},{"t":" into a salt flat, Because of the "},{"t":"wickedness","s":["H7451"],"a":[3]},{"t":" of those who "},{"t":"dwell","s":["H3427"],"a":[4]},{"t":" in it."}]},{"n":35,"text":"He turns a wilderness into a pool of water, And a dry land into springs of water.","tok":[{"t":"He "},{"t":"turns","s":["H7760"],"a":[0]},{"t":" a "},{"t":"wilderness","s":["H4057"],"a":[1]},{"t":" into a "},{"t":"pool","s":["H0098"],"a":[2]},{"t":" of "},{"t":"water","s":["H4325"],"a":[3]},{"t":", And a "},{"t":"dry","s":["H6723"],"a":[5]},{"t":" land into springs of water."}]},{"n":36,"text":"And He makes the hungry dwell there, That they may prepare a city of habitation","tok":[{"t":"And He makes the "},{"t":"hungry","s":["H7457"],"a":[2]},{"t":" "},{"t":"dwell","s":["H3427"],"a":[0]},{"t":" there, That they may "},{"t":"prepare","s":["H3559"],"a":[3]},{"t":" a "},{"t":"city","s":["H5892"],"a":[4]},{"t":" of "},{"t":"habitation","s":["H4186"],"a":[5]}]},{"n":37,"text":"And sow fields and plant vineyards And get a fruitful yield.","tok":[{"t":"And "},{"t":"sow","s":["H2232"],"a":[0]},{"t":" "},{"t":"fields","s":["H7704"],"a":[1]},{"t":" and "},{"t":"plant","s":["H5193"],"a":[2]},{"t":" "},{"t":"vineyards","s":["H3754"],"a":[3]},{"t":" And get a fruitful "},{"t":"yield","s":["H6213"],"a":[4]},{"t":"."}]},{"n":38,"text":"He also blesses them, and they are multiplied greatly; And He does not let their cattle decrease.","tok":[{"t":"He also "},{"t":"blesses","s":["H1288"],"a":[0]},{"t":" them, and they are "},{"t":"multiplied","s":["H7235"],"a":[1]},{"t":" "},{"t":"greatly","s":["H3966"],"a":[2]},{"t":"; And He does not let their "},{"t":"cattle","s":["H0929"],"a":[3]},{"t":" "},{"t":"decrease","s":["H4591"]},{"t":"."}]},{"n":39,"text":"When they are diminished and bowed down Through oppression, trouble, and sorrow,","tok":[{"t":"When they are diminished and bowed down Through "},{"t":"oppression","s":["H6115"],"a":[2]},{"t":", "},{"t":"trouble","s":["H7451"],"a":[3]},{"t":", and "},{"t":"sorrow","s":["H3015"],"a":[4]},{"t":","}]},{"n":40,"text":"He pours contempt on princes, And makes them wander in a pathless waste.","tok":[{"t":"He "},{"t":"pours","s":["H8210"],"a":[0]},{"t":" "},{"t":"contempt","s":["H0937"],"a":[1]},{"t":" on "},{"t":"princes","s":["H5081"],"a":[3]},{"t":", And makes them "},{"t":"wander","s":["H8582"],"a":[4]},{"t":" in a pathless waste."}]},{"n":41,"text":"But He raises the needy man high above affliction And makes his families like flocks.","tok":[{"t":"But He raises the needy man "},{"t":"high","s":["H7682"],"a":[0]},{"t":" above "},{"t":"affliction","s":["H6040"],"a":[2]},{"t":" And "},{"t":"makes","s":["H7760"],"a":[3]},{"t":" his "},{"t":"families","s":["H4940"],"a":[5]},{"t":" like "},{"t":"flocks","s":["H6629"],"a":[4]},{"t":"."}]},{"n":42,"text":"The upright see it and rejoice; And all iniquity stops its mouth.","tok":[{"t":"The "},{"t":"upright","s":["H3477"],"a":[1]},{"t":" "},{"t":"see","s":["H7200"],"a":[0]},{"t":" it and "},{"t":"rejoice","s":["H8055"],"a":[2]},{"t":"; And all "},{"t":"iniquity","s":["H5766"],"a":[4]},{"t":" "},{"t":"stops","s":["H7092"],"a":[5]},{"t":" its "},{"t":"mouth","s":["H6310"],"a":[6]},{"t":"."}]},{"n":43,"text":"Who is wise? Then let him observe these things And consider the lovingkindness of Jehovah.","tok":[{"t":"Who is "},{"t":"wise","s":["H2450"]