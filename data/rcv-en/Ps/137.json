{"v":1,"book":"Ps","ch":137,"verses":[{"n":1,"text":"By the rivers of Babylon, There we sat down; indeed, we wept When we remembered Zion.","tok":[{"t":"By the "},{"t":"rivers","s":["H5104"],"a":[1]},{"t":" of "},{"t":"Babylon","s":["H0894"],"a":[2]},{"t":", There we "},{"t":"sat","s":["H3427"],"a":[4]},{"t":" down; "},{"t":"indeed","s":["H1571"],"a":[5]},{"t":", we "},{"t":"wept","s":["H1058"],"a":[6]},{"t":" When we "},{"t":"remembered","s":["H2142"],"a":[7]},{"t":" "},{"t":"Zion","s":["H6726"],"a":[9]},{"t":"."}]},{"n":2,"text":"On the willows in the midst of it We hung up our lyres,","tok":[{"t":"On the "},{"t":"willows","s":["H6155"],"a":[1]},{"t":" in the "},{"t":"midst","s":["H8432"],"a":[2]},{"t":" of it We "},{"t":"hung","s":["H8518"],"a":[3]},{"t":" up our "},{"t":"lyres","s":["H3658"],"a":[4]},{"t":","}]},{"n":3,"text":"For there our captors required of us songs, And those who tormented us required of us mirth, saying, Sing for us One of the songs of Zion.","tok":[{"t":"For there our "},{"t":"captors","s":["H7617"],"a":[3]},{"t":" "},{"t":"required","s":["H7592"],"a":[2]},{"t":" of us "},{"t":"songs","s":["H7892"],"a":[5]},{"t":", And those who "},{"t":"tormented","s":["H8437"],"a":[6]},{"t":" us "},{"t":"required","s":["H8437"],"a":[6]},{"t":" of us "},{"t":"mirth","s":["H8057"],"a":[7]},{"t":", saying, "},{"t":"Sing","s":["H7891"],"a":[8]},{"t":" for us One of the "},{"t":"songs","s":["H7892"],"a":[10]},{"t":" of "},{"t":"Zion","s":["H6726"],"a":[11]},{"t":"."}]},{"n":4,"text":"How can we sing the song of Jehovah In a foreign land?","tok":[{"t":"How","s":["H0349"],"a":[0]},{"t":" can we "},{"t":"sing","s":["H7891"],"a":[1]},{"t":" the "},{"t":"song","s":["H7892"],"a":[3]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" In a "},{"t":"foreign","s":["H5236"],"a":[7]},{"t":" "},{"t":"land","s":["H0127"],"a":[6]},{"t":"?"}]},{"n":5,"text":"If I forget you, O Jerusalem, Let my right hand forget its skill.","tok":[{"t":"If I "},{"t":"forget","s":["H7911"],"a":[1]},{"t":" you, O "},{"t":"Jerusalem","s":["H3389"],"a":[2]},{"t":", Let my "},{"t":"right","s":["H3225"],"a":[4]},{"t":" "},{"t":"hand","s":["H3225"],"a":[4]},{"t":" "},{"t":"forget","s":["H7911"],"a":[3]},{"t":" its skill."}]},{"n":6,"text":"Let my tongue cling to the roof of my mouth, If I do not remember you, If I do not prefer Jerusalem Above my chief joy.","tok":[{"t":"Let my "},{"t":"tongue","s":["H3956"],"a":[1]},{"t":" "},{"t":"cling","s":["H1692"],"a":[0]},{"t":" to the roof of my "},{"t":"mouth","s":["H2441"],"a":[2]},{"t":", If I do not "},{"t":"remember","s":["H2142"],"a":[5]},{"t":" you, If I do "},{"t":"not","s":["H3808"],"a":[7]},{"t":" prefer "},{"t":"Jerusalem","s":["H3389"],"a":[10]},{"t":" Above my "},{"t":"chief","s":["H7218"],"a":[12]},{"t":" "},{"t":"joy","s":["H8057"],"a":[13]},{"t":"."}]},{"n":7,"text":"Remember, O Jehovah, Against the children of Edom, The day of Jerusalem, Who said, Lay it bare! Lay it bare, Down to its foundation!","tok":[{"t":"Remember","s":["H2142"],"a":[0]},{"t":", O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", Against the "},{"t":"children","s":["H1121"],"a":[2]},{"t":" of "},{"t":"Edom","s":["H0123"],"a":[3]},{"t":", The "},{"t":"day","s":["H3117"],"a":[5]},{"t":" of "},{"t":"Jerusalem","s":["H3389"],"a":[6]},{"t":", Who "},{"t":"said","s":["H0559"],"a":[7]},{"t":", "},{"t":"Lay","s":["H6168"],"a":[8]},{"t":" it "},{"t":"bare","s":["H6168"],"a":[8]},{"t":"! "},{"t":"Lay","s":["H6168"],"a":[9]},{"t":" it "},{"t":"bare","s":["H6168"],"a":[9]},{"t":", Down to its "},{"t":"foundation","s":["H3247"],"a":[11]},{"t":"!"}]},{"n":8,"text":"O daughter of Babylon, who are to be devastated, Happy will he be who repays you The recompense of what you have rendered to us.","tok":[{"t":"O "},{"t":"daughter","s":["H1323"],"a":[0]},{"t":" of "},{"t":"Babylon","s":["H0894"],"a":[1]},{"t":", who are to be "},{"t":"devastated","s":["H7703"],"a":[2]},{"t":", "},{"t":"Happy","s":["H0835"],"a":[3]},{"t":" will he be who "},{"t":"repays","s":["H7999"],"a":[4]},{"t":" you The "},{"t":"recompense","s":["H1576"],"a":[7]},{"t":" of what you have rendered to us."}]},{"n":9,"text":"Happy will he be who seizes your little ones And dashes them against the rock.","tok":[{"t":"Happy","s":["H0835"],"a":[0]},{"t":" will he be who "},{"t":"seizes","s":["H0270"],"a":[1]},{"t":" your "},{"t":"little","s":["H5768"],"a":[4]},{"t":" ones And "},{"t":"dashes","s":["H5310"],"a":[2]},{"t":" them against the "},{"t":"rock","s":["H5553"],"a":[6]},{"t":"."}]}]}
