{"v":1,"book":"Ps","ch":3,"verses":[{"n":0,"text":"A Psalm of David, when he fled from Absalom his son","tok":[{"t":"A "},{"t":"Psalm","s":["H4210"],"a":[0]},{"t":" of "},{"t":"David","s":["H1732"],"a":[1]},{"t":", when he "},{"t":"fled","s":["H1272"],"a":[2]},{"t":" "},{"t":"from","s":["H6440"],"a":[3]},{"t":" "},{"t":"Absalom","s":["H0053"],"a":[4]},{"t":" his "},{"t":"son","s":["H1121"],"a":[5]}]},{"n":1,"text":"Jehovah, how many are my adversaries! Many are those who rise up against me!","tok":[{"t":"Jehovah","s":["H3068"],"a":[0]},{"t":", how many are my adversaries! "},{"t":"Many","s":["H7227"],"a":[4]},{"t":" are those who rise "},{"t":"up","s":["H6965"],"a":[5]},{"t":" against me!"}]},{"n":2,"text":"Many are those who say of my soul, There is no salvation for him in God! Selah","tok":[{"t":"Many","s":["H7227"],"a":[0]},{"t":" are those who "},{"t":"say","s":["H0559"],"a":[1]},{"t":" of my "},{"t":"soul","s":["H5315"],"a":[2]},{"t":", There is no salvation for him in "},{"t":"God","s":["H0430"],"a":[6]},{"t":"! "},{"t":"Selah","s":["H5542"],"a":[7]}]},{"n":3,"text":"But You, O Jehovah, are a shield around me, My glory and the One who lifts up my head.","tok":[{"t":"But You, O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", are a "},{"t":"shield","s":["H4043"],"a":[2]},{"t":" around me, My "},{"t":"glory","s":["H3519"],"a":[4]},{"t":" and the One who lifts "},{"t":"up","s":["H7311"],"a":[5]},{"t":" my "},{"t":"head","s":["H7218"],"a":[6]},{"t":"."}]},{"n":4,"text":"With my voice I call out to Jehovah, And He answers me from His holy mountain. Selah","tok":[{"t":"With my "},{"t":"voice","s":["H6963"],"a":[0]},{"t":" I call out to "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":", And He answers me from His "},{"t":"holy","s":["H6944"],"a":[6]},{"t":" "},{"t":"mountain","s":["H2022"],"a":[5]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[7]}]},{"n":5,"text":"I lay down and slept; I awoke, for Jehovah sustains me.","tok":[{"t":"I lay "},{"t":"down","s":["H7901"],"a":[1]},{"t":" and "},{"t":"slept","s":["H3462"],"a":[2]},{"t":"; I awoke, for "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":" "},{"t":"sustains","s":["H5564"],"a":[6]},{"t":" me."}]},{"n":6,"text":"I will not fear the myriads of the people Who have set themselves against me all around.","tok":[{"t":"I will not fear the myriads of the "},{"t":"people","s":["H5971"],"a":[3]},{"t":" Who have "},{"t":"set","s":["H7896"],"a":[6]},{"t":" themselves against me all around."}]},{"n":7,"text":"Arise, O Jehovah; Save me, O my God! Oh that You would strike all my enemies on the cheek; And break the teeth of the wicked.","tok":[{"t":"Arise","s":["H6965"],"a":[0]},{"t":", O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":"; "},{"t":"Save","s":["H3467"],"a":[2]},{"t":" me, O my "},{"t":"God","s":["H0430"],"a":[3]},{"t":"! Oh that You would strike all my "},{"t":"enemies","s":["H0341"],"a":[8]},{"t":" on the cheek; And break the "},{"t":"teeth","s":["H8127"],"a":[10]},{"t":" of the "},{"t":"wicked","s":["H7563"],"a":[11]},{"t":"."}]},{"n":8,"text":"Salvation is of Jehovah: Your blessing be upon Your people. Selah","tok":[{"t":"Salvation","s":["H3444"],"a":[1]},{"t":" is of "},{"t":"Jehovah","s":["H3068"],"a":[0]},{"t":": Your "},{"t":"blessing","s":["H1293"],"a":[4]},{"t":" be upon Your "},{"t":"people","s":["H5971"],"a":[3]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[5]}]}]}
