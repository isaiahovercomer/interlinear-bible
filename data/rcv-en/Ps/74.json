760"],"a":[4]},{"t":" their symbols as "},{"t":"signs","s":["H0226"],"a":[6]},{"t":"."}]},{"n":5,"text":"It looked like when men bring up axes On the thicket of the trees.","tok":[{"t":"It looked like when men bring "},{"t":"up","s":["H0935"],"a":[1]},{"t":" "},{"t":"axes","s":["H7134"],"a":[5]},{"t":" On the "},{"t":"thicket","s":["H5442"],"a":[3]},{"t":" of the "},{"t":"trees","s":["H6086"],"a":[4]},{"t":"."}]},{"n":6,"text":"And now they have struck down with hatchet and hammer Its carved work altogether.","tok":[{"t":"And now they have struck "},{"t":"down","s":["H1986"],"a":[5]},{"t":" with hatchet and "},{"t":"hammer","s":["H3597"],"a":[4]},{"t":" Its carved "},{"t":"work","s":["H6603"],"a":[1]},{"t":" altogether."}]},{"n":7,"text":"They have set fire to Your sanctuary; They have defiled the dwelling place of Your name to the ground.","tok":[{"t":"They have set "},{"t":"fire","s":["H0784"],"a":[1]},{"t":" to Your "},{"t":"sanctuary","s":["H4720"],"a":[2]},{"t":"; They have "},{"t":"defiled","s":["H2490"],"a":[4]},{"t":" the dwelling "},{"t":"place","s":["H4908"],"a":[5]},{"t":" of Your "},{"t":"name","s":["H8034"],"a":[6]},{"t":" to the "},{"t":"ground","s":["H0776"],"a":[3]},{"t":"."}]},{"n":8,"text":"They said in their heart, Let us oppress them completely. They have burned down all God’s assembly places in the land.","tok":[{"t":"They "},{"t":"said","s":["H0559"],"a":[0]},{"t":" in their "},{"t":"heart","s":["H3820"],"a":[1]},{"t":", Let us oppress them completely. They have burned down all God’s assembly places in the "},{"t":"land","s":["H0776"],"a":[8]},{"t":"."}]},{"n":9,"text":"We do not see our signs; there is no longer a prophet, Nor is there anyone among us who knows how long.","tok":[{"t":"We do not "},{"t":"see","s":["H7200"],"a":[2]},{"t":" our "},{"t":"signs","s":["H0226"],"a":[0]},{"t":"; there is no longer a "},{"t":"prophet","s":["H5030"],"a":[5]},{"t":", Nor is there anyone among us who "},{"t":"knows","s":["H3045"],"a":[8]},{"t":" how "},{"