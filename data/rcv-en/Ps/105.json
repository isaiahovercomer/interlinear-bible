:[1]},{"t":" at will, And to teach his elders "},{"t":"wisdom","s":["H2449"],"a":[4]},{"t":"."}]},{"n":23,"text":"Then Israel came into Egypt, And Jacob sojourned in the land of Ham.","tok":[{"t":"Then "},{"t":"Israel","s":["H3478"],"a":[1]},{"t":" "},{"t":"came","s":["H0935"],"a":[0]},{"t":" into "},{"t":"Egypt","s":["H4714"],"a":[2]},{"t":", And "},{"t":"Jacob","s":["H3290"],"a":[3]},{"t":" "},{"t":"sojourned","s":["H1481"],"a":[4]},{"t":" in the "},{"t":"land","s":["H0776"],"a":[5]},{"t":" of "},{"t":"Ham","s":["H2526"],"a":[6]},{"t":"."}]},{"n":24,"text":"And He made His people very fruitful, And caused them to be mightier than their adversaries.","tok":[{"t":"And He made His "},{"t":"people","s":["H5971"],"a":[2]},{"t":" very fruitful, And caused them to be mightier than their adversaries."}]},{"n":25,"text":"He turned their heart to hate His people, To deal craftily with His servants.","tok":[{"t":"He "},{"t":"turned","s":["H2015"],"a":[0]},{"t":" their "},{"t":"heart","s":["H3820"],"a":[1]},{"t":" to "},{"t":"hate","s":["H8130"],"a":[2]},{"t":" His "},{"t":"people","s":["H5971"],"a":[3]},{"t":", To deal craftily with His "},{"t":"servants","s":["H5650"],"a":[5]},{"t":"."}]},{"n":26,"text":"He sent Moses His servant, And Aaron, whom He had chosen.","tok":[{"t":"He "},{"t":"sent","s":["H7971"],"a":[0]},{"t":" "},{"t":"Moses","s":["H4872"],"a":[1]},{"t":" His "},{"t":"servant","s":["H5650"],"a":[2]},{"t":", And "},{"t":"Aaron","s":["H0175"],"a":[3]},{"t":", whom He had "},{"t":"chosen","s":["H0977"],"a":[5]},{"t":"."}]},{"n":27,"text":"They set His signs among them, And wonders in the land of Ham.","tok":[{"t":"They set His "},{"t":"signs","s":["H0226"],"a":[3]},{"t":" among them, And "},{"t":"wonders","s":["H4159"],"a":[4]},{"t":" in the "},{"t":"land","s":["H0776"],"a":[5]},{"t":" of "},{"t":"Ham","s":["H2526"],"a":[6]},{"t":"."}]},{"n":28,"text":"He sent darkness and made it dark; And they did not rebel against His words.","tok":[{"t":"He "},{"t":"sent","s":["H7971"],"a":[0]},{"t":" "},{"t":"darkness","s":["H2822"],"a":[1]},{"t":" and made it "},{"t":"dark","s":["H2821"],"a":[2]},{"t":"; And they did not rebel against His "},{"t":"words","s":["H1697"],"a":[6]},{"t":"."}]},{"n":29,"text":"He turned their waters into blood, And killed their fish.","tok":[{"t":"He "},{"t":"turned","s":["H2015"],"a":[0]},{"t":" their "},{"t":"waters","s":["H4325"],"a":[2]},{"t":" into "},{"t":"blood","s":["H1818"],"a":[3]},{"t":", And killed their "},{"t":"fish","s":["H1710"],"a":[6]},{"t":"."}]},{"n":30,"text":"Their land teemed with frogs, Even in the chambers of their kings.","tok":[{"t":"Their "},{"t":"land","s":["H0776"],"a":[1]},{"t":" "},{"t":"teemed","s":["H8317"],"a":[0]},{"t":" with "},{"t":"frogs","s":["H6854"],"a":[2]},{"t":", "},{"t":"Even","s":["H8317"]},{"t":" in the "},{"t":"chambers","s":["H2315"],"a":[3]},{"t":" of their "},{"t":"kings","s":["H4428"],"a":[4]},{"t":"."}]},{"n":31,"text":"He spoke, and a swarm of flies came; There were lice within all their borders.","tok":[{"t":"He "},{"t":"spoke","s":["H0559"],"a":[0]},{"t":", and a "},{"t":"swarm","s":["H0935"],"a":[1]},{"t":" of "},{"t":"flies","s":["H6157"],"a":[2]},{"t":" "},{"t":"came","s":["H0935"],"a":[1]},{"t":"; There were "},{"t":"lice","s":["H3654"],"a":[3]},{"t":" within all their borders."}]},{"n":32,"text":"He gave them hail for rain, And flaming fire in their land.","tok":[{"t":"He "},{"t":"gave","s":["H5414"],"a":[0]},{"t":" them "},{"t":"hail","s":["H1259"],"a":[2]},{"t":" for "},{"t":"rain","s":["H1653"],"a":[1]},{"t":", And "},{"t":"flaming","s":["H3852"],"a":[4]},{"t":" "},{"t":"fire","s":["H0784"],"a":[3]},{"t":" in their "},{"t":"land","s":["H0776"],"a":[5]},{"t":"."}]},{"n":33,"text":"He struck their vines and their fig trees, And He broke the trees of their borders.","tok":[{"t":"He struck their "},{"t":"vines","s":["H1612"],"a":[1]},{"t":" and their fig "},{"t":"trees","s":["H8384"],"a":[2]},{"t":", And He broke the "},{"t":"trees","s":["H6086"],"a":[4]},{"t":" of their borders."}]},{"n":34,"text":"He spoke, and the swarming locusts came, And the licking locusts, even without number.","tok":[{"t":"He "},{"t":"spoke","s":["H0559"],"a":[0]},{"t":", and the swarming "},{"t":"locusts","s":["H0697"],"a":[2]},{"t":" "},{"t":"came","s":["H0935"],"a":[1]},{"t":", And the licking locusts, even without "},{"t":"number","s":["H4557"],"a":[5]},{"t":"."}]},{"n":35,"text":"And they ate every herb in their land, And they ate the fruit of their ground.","tok":[{"t":"And they ate every "},{"t":"herb","s":["H6212"],"a":[2]},{"t":" in their "},{"t":"land","s":["H0776"],"a":[3]},{"t":", And they ate the "},{"t":"fruit","s":["H6529"],"a":[5]},{"t":" of their "},{"t":"ground","s":["H0127"],"a":[6]},{"t":"."}]},{"n":36,"text":"He struck all the firstborn in their land, The firstfruits of all their vigor.","tok":[{"t":"He struck all the "},{"t":"firstborn","s":["H1060"],"a":[2]},{"t":" in their "},{"t":"land","s":["H0776"],"a":[3]},{"t":", The firstfruits of all their vigor."}]},{"n":37,"text":"And He brought them out with silver and gold, And there was none among His tribes who stumbled.","tok":[{"t":"And He brought them out with "},{"t":"silver","s":["H3701"],"a":[1]},{"t":" and "},{"t":"gold","s":["H2091"],"a":[2]},{"t":", And there was none among His "},{"t":"tribes","s":["H7626"],"a":[4]},{"t":" who stumbled."}]},{"n":38,"text":"Egypt rejoiced at their going forth, For a dread of them had fallen upon them.","tok":[{"t":"Egypt","s":["H4714"],"a":[1]},{"t":" rejoiced at their going forth, For a dread of them had fallen upon them."}]},{"n":39,"text":"He spread a cloud for a covering, And a fire to give light by night.","tok":[{"t":"He "},{"t":"spread","s":["H6566"],"a":[0]},{"t":" a "},{"t":"cloud","s":["H6051"],"a":[1]},{"t":" for a "},{"t":"covering","s":["H4539"],"a":[2]},{"t":", And a "},{"t":"fire","s":["H0784"],"a":[3]},{"t":" to give "},{"t":"light","s":["H0215"],"a":[4]},{"t":" by "},{"t":"night","s":["H3915"],"a":[5]},{"t":"."}]},{"n":40,"text":"They asked, and He brought quails; And He satisfied them with the bread of heaven.","tok":[{"t":"They "},{"t":"asked","s":["H7592"],"a":[0]},{"t":", and He "},{"t":"brought","s":["H0935"],"a":[1]},{"t":" "},{"t":"quails","s":["H7958"],"a":[2]},{"t":"; And He "},{"t":"satisfied","s":["H7646"],"a":[5]},{"t":" them with the "},{"t":"bread","s":["H3899"],"a":[3]},{"t":" of "},{"t":"heaven","s":["H8064"],"a":[4]},{"t":"."}]},{"n":41,"text":"He opened the rock, and water gushed forth; It ran in the dry places like a river.","tok":[{"t":"He "},{"t":"opened","s":["H6605"],"a":[0]},{"t":" the "},{"t":"rock","s":["H6697"],"a":[1]},{"t":", and "},{"t":"water","s":["H4325"],"a":[3]},{"t":" gushed forth; It "},{"t":"ran","s":["H1980"],"a":[4]},{"t":" in the dry "},{"t":"places","s":["H6723"],"a":[5]},{"t":" like a "},{"t":"river","s":["H5104"],"a":[6]},{"t":"."}]},{"n":42,"text":"For He remembered His holy word And Abraham His servant.","tok":[{"t":"For He "},{"t":"remembered","s":["H2142"],"a":[1]},{"t":" His "},{"t":"holy","s":["H6944"],"a":[4]},{"t":" "},{"t":"word","s":["H1697"],"a":[3]},{"t":" And "},{"t":"Abraham","s":["H0085"],"a":[6]},{"t":" His "},{"t":"servant","s":["H5650"],"a":[7]},{"t":"."}]},{"n":43,"text":"And He brought forth His people with gladness, His chosen ones with a ringing shout.","tok":[{"t":"And He brought "},{"t":"forth","s":["H3318"],"a":[0]},{"t":" His "},{"t":"people","s":["H5971"],"a":[1]},{"t":" with "},{"t":"gladness","s":["H7440"],"a":[3]},{"t":", His "},{"t":"chosen","s":["H0972"],"a":[5]},{"t":" ones with a ringing shout."}]},{"n":44,"text":"And He gave them the lands of the nations, And they took possession of the labor of the peoples,","tok":[{"t":"And He "},{"t":"gave","s":["H5414"],"a":[0]},{"t":" them the "},{"t":"lands","s":["H0776"],"a":[2]},{"t":" of the nations, And they took possession of the labor of the "},{"t":"peoples","s":["H3816"],"a":[5]},{"t":","}]},{"n":45,"text":"So that they might keep His statute