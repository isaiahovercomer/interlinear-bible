{"v":1,"book":"Ps","ch":83,"verses":[{"n":0,"text":"A Song; a Psalm of Asaph","tok":[{"t":"A "},{"t":"Song","s":["H7892"],"a":[0]},{"t":"; a "},{"t":"Psalm","s":["H4210"],"a":[1]},{"t":" of "},{"t":"Asaph","s":["H0623"],"a":[2]}]},{"n":1,"text":"O God, do not keep silent; Do not be quiet, and do not be still, O God.","tok":[{"t":"O","s":["H1824"],"a":[2]},{"t":" "},{"t":"God","s":["H0430"],"a":[0]},{"t":", do not keep silent; Do not be quiet, and do not be "},{"t":"still","s":["H8252"],"a":[7]},{"t":", O "},{"t":"God","s":["H0410"],"a":[8]},{"t":"."}]},{"n":2,"text":"For, behold, Your enemies are in tumult, And those who hate You lift up their heads.","tok":[{"t":"For, behold, Your "},{"t":"enemies","s":["H0341"],"a":[2]},{"t":" are in "},{"t":"tumult","s":["H1993"],"a":[3]},{"t":", And those who "},{"t":"hate","s":["H8130"],"a":[4]},{"t":" You lift "},{"t":"up","s":["H5375"],"a":[5]},{"t":" their "},{"t":"heads","s":["H7218"],"a":[6]},{"t":"."}]},{"n":3,"text":"They devise crafty counsel against Your people, And conspire against Your hidden ones.","tok":[{"t":"They devise "},{"t":"crafty","s":["H6191"],"a":[2]},{"t":" "},{"t":"counsel","s":["H5475"],"a":[3]},{"t":" against Your "},{"t":"people","s":["H5971"],"a":[1]},{"t":", And conspire against Your hidden "},{"t":"ones","s":["H6845"],"a":[6]},{"t":"."}]},{"n":4,"text":"They have said, Come and let us destroy them from being a nation, That the name of Israel may no longer be remembered.","tok":[{"t":"They have "},{"t":"said","s":["H0559"],"a":[0]},{"t":", "},{"t":"Come","s":["H3212"]},{"t":" and let us destroy them from being a "},{"t":"nation","s":["H1471"],"a":[3]},{"t":", That the "},{"t":"name","s":["H8034"],"a":[6]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[7]},{"t":" may no longer be remembered."}]},{"n":5,"text":"For they have conspired together with one heart; It is against You that they have made an alliance:","tok":[{"t":"For they have conspired "},{"t":"together","s":["H3162"],"a":[3]},{"t":" with one heart; It is against You that they have made an alliance:"}]},{"n":6,"text":"The tents of Edom and the Ishmaelites, Moab and the Hagarites,","tok":[{"t":"The "},{"t":"tents","s":["H0168"],"a":[0]},{"t":" of "},{"t":"Edom","s":["H0123"],"a":[1]},{"t":" and the "},{"t":"Ishmaelites","s":["H3459"],"a":[2]},{"t":", "},{"t":"Moab","s":["H4124"],"a":[3]},{"t":" and the "},{"t":"Hagarites","s":["H1905"],"a":[4]},{"t":","}]},{"n":7,"text":"Gebal and Ammon and Amalek, Philistia along with the inhabitants of Tyre;","tok":[{"t":"Gebal","s":["H1381"],"a":[0]},{"t":" and "},{"t":"Ammon","s":["H5983"],"a":[1]},{"t":" and "},{"t":"Amalek","s":["H6002"],"a":[2]},{"t":", Philistia along with the "},{"t":"inhabitants","s":["H3427"],"a":[5]},{"t":" of "},{"t":"Tyre","s":["H6865"],"a":[6]},{"t":";"}]},{"n":8,"text":"Assyria is also joined with them; They have been a help to the children of Lot. Selah","tok":[{"t":"Assyria is also "},{"t":"joined","s":["H3867"],"a":[2]},{"t":" with them; They have been a help to the "},{"t":"children","s":["H1121"],"a":[6]},{"t":" of "},{"t":"Lot","s":["H3876"],"a":[7]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[8]}]},{"n":9,"text":"Do with them as with Midian, As with Sisera and Jabin, at the brook Kishon:","tok":[{"t":"Do","s":["H6213"],"a":[0]},{"t":" with them as with Midian, As with "},{"t":"Sisera","s":["H5516"],"a":[3]},{"t":" and "},{"t":"Jabin","s":["H2985"],"a":[4]},{"t":", at the "},{"t":"brook","s":["H5158"],"a":[5]},{"t":" "},{"t":"Kishon","s":["H7028"],"a":[6]},{"t":":"}]},{"n":10,"text":"They were destroyed at Endor; They became dung for the earth.","tok":[{"t":"They were destroyed at "},{"t":"Endor","s":["H5874"],"a":[1]},{"t":"; They became "},{"t":"dung","s":["H1828"],"a":[4]},{"t":" for the "},{"t":"earth","s":["H0127"],"a":[5]},{"t":"."}]},{"n":11,"text":"Make their nobles like Oreb and Zeeb, And all their princes like Zebah and Zalmunna,","tok":[{"t":"Make","s":["H7896"],"a":[0]},{"t":" their "},{"t":"nobles","s":["H5081"],"a":[1]},{"t":" like "},{"t":"Oreb","s":["H6159"],"a":[2]},{"t":" and "},{"t":"Zeeb","s":["H2062"],"a":[3]},{"t":", And all their "},{"t":"princes","s":["H5257"],"a":[7]},{"t":" like "},{"t":"Zebah","s":["H2078"],"a":[4]},{"t":" and "},{"t":"Zalmunna","s":["H6759"],"a":[5]},{"t":","}]},{"n":12,"text":"Who said, Let us possess for ourselves The habitations of God.","tok":[{"t":"Who "},{"t":"said","s":["H0559"],"a":[1]},{"t":", Let us possess for ourselves The habitations of "},{"t":"God","s":["H0430"],"a":[6]},{"t":"."}]},{"n":13,"text":"O my God, make them like a tumbleweed, Like stubble before the wind.","tok":[{"t":"O my "},{"t":"God","s":["H0430"],"a":[0]},{"t":", "},{"t":"make","s":["H7896"],"a":[1]},{"t":" them like a tumbleweed, Like "},{"t":"stubble","s":["H7179"],"a":[3]},{"t":" "},{"t":"before","s":["H6440"],"a":[4]},{"t":" the "},{"t":"wind","s":["H7307"],"a":[5]},{"t":"."}]},{"n":14,"text":"Like fire that burns a forest And like a flame that sets mountains on fire,","tok":[{"t":"Like "},{"t":"fire","s":["H0784"],"a":[0]},{"t":" that "},{"t":"burns","s":["H1197"],"a":[1]},{"t":" a forest And like a "},{"t":"flame","s":["H3852"],"a":[3]},{"t":" that "},{"t":"sets","s":["H3857"],"a":[4]},{"t":" "},{"t":"mountains","s":["H2022"],"a":[5]},{"t":" on "},{"t":"fire","s":["H3857"]},{"t":","}]},{"n":15,"text":"So pursue them with Your tempest, And terrify them with Your storm.","tok":[{"t":"So pursue them with Your "},{"t":"tempest","s":["H5591"],"a":[2]},{"t":", And terrify them with Your "},{"t":"storm","s":["H5492"],"a":[3]},{"t":"."}]},{"n":16,"text":"Fill their faces with shame, That they may seek Your name, O Jehovah.","tok":[{"t":"Fill","s":["H4390"],"a":[0]},{"t":" their "},{"t":"faces","s":["H6440"],"a":[1]},{"t":" with "},{"t":"shame","s":["H7036"],"a":[2]},{"t":", That they may "},{"t":"seek","s":["H1245"],"a":[3]},{"t":" Your "},{"t":"name","s":["H8034"],"a":[4]},{"t":", O "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":"."}]},{"n":17,"text":"May they be ashamed and dismayed forever, And may they be confounded and perish;","tok":[{"t":"May they be ashamed and dismayed forever, And may they be "},{"t":"confounded","s":["H0954"],"a":[0]},{"t":" and "},{"t":"perish","s":["H0006"],"a":[5]},{"t":";"}]},{"n":18,"text":"That they may know that You alone, whose name is Jehovah, Are the Most High over all the earth.","tok":[{"t":"That they may "},{"t":"know","s":["H3045"],"a":[0]},{"t":" that You alone, whose "},{"t":"name","s":["H8034"],"a":[3]},{"t":" is "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":", Are the Most "},{"t":"High","s":["H5945"],"a":[6]},{"t":" over all the "},{"t":"earth","s":["H0776"],"a":[9]},{"t":"."}]}]}
