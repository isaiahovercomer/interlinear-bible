{"v":1,"book":"Mic","ch":3,"verses":[{"n":1,"text":"And I said, Hear now, you heads of Jacob And you rulers of the house of Israel: Is it not for you To know justice?","tok":[{"t":"And I "},{"t":"said","s":["H0559"],"a":[0]},{"t":", "},{"t":"Hear","s":["H8085"],"a":[1]},{"t":" now, you "},{"t":"heads","s":["H7218"],"a":[3]},{"t":" of "},{"t":"Jacob","s":["H3290"],"a":[4]},{"t":" And you rulers of the "},{"t":"house","s":["H1004"],"a":[6]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[7]},{"t":": Is it not for you To "},{"t":"know","s":["H3045"],"a":[10]},{"t":" "},{"t":"justice","s":["H4941"],"a":[12]},{"t":"?"}]},{"n":2,"text":"You who hate good And love evil, You who tear away their skin from off them And their flesh from off their bones,","tok":[{"t":"You who "},{"t":"hate","s":["H8130"],"a":[0]},{"t":" "},{"t":"good","s":["H2896"],"a":[1]},{"t":" And "},{"t":"love","s":["H0157"],"a":[2]},{"t":" "},{"t":"evil","s":["H7451"],"a":[3]},{"t":", You who tear away their "},{"t":"skin","s":["H5785"],"a":[5]},{"t":" from "},{"t":"off","s":["H1497"],"a":[4]},{"t":" them And their "},{"t":"flesh","s":["H7607"],"a":[7]},{"t":" from off their "},{"t":"bones","s":["H6106"],"a":[9]},{"t":","}]},{"n":3,"text":"And who devour the flesh of My people And strip off their skin from off them And break their bones in pieces And chop them as for the pot And like meat in a cauldron.","tok":[{"t":"And who "},{"t":"devour","s":["H0398"],"a":[1]},{"t":" the "},{"t":"flesh","s":["H7607"],"a":[2]},{"t":" of My "},{"t":"people","s":["H5971"],"a":[3]},{"t":" And strip off their "},{"t":"skin","s":["H5785"],"a":[4]},{"t":" from off them And "},{"t":"break","s":["H6476"],"a":[9]},{"t":" their "},{"t":"bones","s":["H6106"],"a":[8]},{"t":" in "},{"t":"pieces","s":["H6566"],"a":[10]},{"t":" And chop them as for the "},{"t":"pot","s":["H5518"],"a":[12]},{"t":" And like meat in a cauldron."}]},{"n":4,"text":"Then they will cry out to Jehovah, But He will not answer them; Indeed He will hide His face from them at that time, Just as they were evil in their doings.","tok":[{"t":"Then they will "},{"t":"cry","s":["H2199"],"a":[1]},{"t":" out to "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", But He will not answer them; Indeed He will "},{"t":"hide","s":["H5641"],"a":[7]},{"t":" His "},{"t":"face","s":["H6440"],"a":[8]},{"t":" from them at that "},{"t":"time","s":["H6256"],"a":[10]},{"t":", Just as they were evil in their "},{"t":"doings","s":["H4611"],"a":[14]},{"t":"."}]},{"n":5,"text":"Thus says Jehovah concerning the prophets Who cause My people to err, Who, when they have something to bite with their teeth, Cry, Peace, But if there is one who does not give something for their mouths, They prepare for war against him.","tok":[{"t":"Thus "},{"t":"says","s":["H0559"],"a":[1]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" concerning the "},{"t":"prophets","s":["H5030"],"a":[4]},{"t":" Who cause My "},{"t":"people","s":["H5971"],"a":[7]},{"t":" to "},{"t":"err","s":["H8582"],"a":[5]},{"t":", Who, when they have something to "},{"t":"bite","s":["H5391"],"a":[8]},{"t":" with their "},{"t":"teeth","s":["H8127"],"a":[9]},{"t":", "},{"t":"Cry","s":["H7121"],"a":[10]},{"t":", "},{"t":"Peace","s":["H7965"],"a":[11]},{"t":", But if there is one who does not give something for their "},{"t":"mouths","s":["H6310"],"a":[16]},{"t":", They "},{"t":"prepare","s":["H6942"],"a":[17]},{"t":" for "},{"t":"war","s":["H4421"],"a":[19]},{"t":" against him."}]},{"n":6,"text":"Therefore there will be night to you, without vision, And darkness to you, without divination. And the sun will go down on the prophets, And the day will be black over them.","tok":[{"t":"Therefore there will be "},{"t":"night","s":["H3915"],"a":[1]},{"t":" to you, without "},{"t":"vision","s":["H2377"],"a":[3]},{"t":", And darkness to you, without divination. And the "},{"t":"sun","s":["H8121"],"a":[8]},{"t":" will go "},{"t":"down","s":["H0935"],"a":[7]},{"t":" on the "},{"t":"prophets","s":["H5030"],"a":[10]},{"t":", And the "},{"t":"day","s":["H3117"],"a":[13]},{"t":" will be black over them."}]},{"n":7,"text":"And the seers will be put to shame, And the diviners will be ashamed; And they will all cover their mouths, For there will be no answer from God.","tok":[{"t":"And the "},{"t":"seers","s":["H2374"],"a":[1]},{"t":" will be put to shame, And the "},{"t":"diviners","s":["H7080"],"a":[3]},{"t":" will be "},{"t":"ashamed","s":["H0954"],"a":[0]},{"t":"; And they will all "},{"t":"cover","s":["H5844"],"a":[4]},{"t":" their mouths, For there will be no "},{"t":"answer","s":["H4617"],"a":[10]},{"t":" from "},{"t":"God","s":["H0430"],"a":[11]},{"t":"."}]},{"n":8,"text":"But as for me, I am full Of power, with the Spirit of Jehovah, and of justice and might, To declare to Jacob his transgression And to Israel his sin.","tok":[{"t":"But as for me, I am "},{"t":"full","s":["H4390"],"a":[2]},{"t":" Of "},{"t":"power","s":["H3581"],"a":[3]},{"t":", with the "},{"t":"Spirit","s":["H7307"],"a":[5]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":", and of "},{"t":"justice","s":["H4941"],"a":[7]},{"t":" and "},{"t":"might","s":["H1369"],"a":[8]},{"t":", To "},{"t":"declare","s":["H5046"],"a":[9]},{"t":" to "},{"t":"Jacob","s":["H3290"],"a":[10]},{"t":" his "},{"t":"transgression","s":["H6588"],"a":[11]},{"t":" And to "},{"t":"Israel","s":["H3478"],"a":[12]},{"t":" his "},{"t":"sin","s":["H2403"],"a":[13]},{"t":"."}]},{"n":9,"text":"Hear now this, you heads of the house of Jacob And you rulers of the house of Israel: You who abhor justice And pervert all uprightness,","tok":[{"t":"Hear","s":["H8085"],"a":[0]},{"t":" now this, you "},{"t":"heads","s":["H7218"],"a":[3]},{"t":" of the "},{"t":"house","s":["H1004"],"a":[4]},{"t":" of "},{"t":"Jacob","s":["H3290"],"a":[5]},{"t":" And you rulers of the "},{"t":"house","s":["H1004"],"a":[7]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[8]},{"t":": You who "},{"t":"abhor","s":["H8581"],"a":[9]},{"t":" "},{"t":"justice","s":["H4941"],"a":[10]},{"t":" And "},{"t":"pervert","s":["H6140"],"a":[14]},{"t":" all uprightness,"}]},{"n":10,"text":"Who build Zion by bloodshed And Jerusalem by iniquity.","tok":[{"t":"Who "},{"t":"build","s":["H1129"],"a":[0]},{"t":" "},{"t":"Zion","s":["H6726"],"a":[1]},{"t":" by "},{"t":"bloodshed","s":["H1818"],"a":[2]},{"t":" And "},{"t":"Jerusalem","s":["H3389"],"a":[3]},{"t":" by "},{"t":"iniquity","s":["H5766"],"a":[4]},{"t":"."}]},{"n":11,"text":"Her leaders judge for a bribe, And her priests teach for hire, And her prophets divine for money; But they lean on Jehovah, saying, Is not Jehovah in our midst? Evil will not come upon us.","tok":[{"t":"Her leaders "},{"t":"judge","s":["H8199"],"a":[2]},{"t":" for a bribe, And her "},{"t":"priests","s":["H3548"],"a":[3]},{"t":" "},{"t":"teach","s":["H3384"],"a":[5]},{"t":" for "},{"t":"hire","s":["H4242"],"a":[4]},{"t":", And her "},{"t":"prophets","s":["H5030"],"a":[6]},{"t":" "},{"t":"divine","s":["H7080"],"a":[8]},{"t":" for "},{"t":"money","s":["H3701"],"a":[7]},{"t":"; But they "},{"t":"lean","s":["H8172"],"a":[11]},{"t":" on "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":", "},{"t":"saying","s":["H0559"],"a":[12]},{"t":", Is not "},{"t":"Jehovah","s":["H3068"],"a":[14]},{"t":" in our midst? "},{"t":"Evil","s":["H7451"],"a":[19]},{"t":" will not "},{"t":"come","s":["H0935"],"a":[17]},{"t":" upon us."}]},{"n":12,"text":"Therefore on account of you Zion will be plowed as a field, And Jerusalem will become a heap of ruins, And the mountain of the house will become the high places of a forest.","tok":[{"t":"Therefore on account of you "},{"t":"Zion","s":["H6726"],"a":[2]},{"t":" "},{"t":"will","s":["H1558"],"a":[1]},{"t":" be "},{"t":"plowed","s":["H2790"],"a":[4]},{"t":" as a "},{"t":"field","s":["H7704"],"a":[3]},{"t":", And "},{"t":"Jerusalem","s":["H3389"],"a":[5]},{"t":" will become a "},{"t":"heap","s":["H5856"],"a":[6]},{"t":" of ruins, And the "},{"t":"mountain","s":["H2022"],"a":[8]},{"t":" of the "},{"t":"house","s":["H1004"],"a":[9]},{"t":" will become the high "},{"t":"places","s":["H1116"],"a":[10]},{"t":" of a "},{"t":"forest","s":["H3293"],"a":[11]},{"t":"."}]}]}
