:" And will throw "},{"t":"down","s":["H2040"],"a":[3]},{"t":" all your strongholds."}]},{"n":12,"text":"And I will cut off the sorceries from your hand, And you will not have soothsayers.","tok":[{"t":"And I will cut "},{"t":"off","s":["H3772"],"a":[0]},{"t":" the sorceries from your "},{"t":"hand","s":["H3027"],"a":[2]},{"t":", And you will not have "},{"t":"soothsayers","s":["H6049"],"a":[3]},{"t":"."}]},{"n":13,"text":"And I will cut off your idols And your pillars from your midst; And you will no longer worship The work of your hands.","tok":[{"t":"And I will cut "},{"t":"off","s":["H3772"],"a":[0]},{"t":" your idols And your pillars from your "},{"t":"midst","s":["H7130"],"a":[3]},{"t":"; And you will no longer "},{"t":"worship","s":["H7812"],"a":[5]},{"t":" The "},{"t":"work","s":["H4639"],"a":[7]},{"t":" of your "},{"t":"hands","s":["H3027"],"a":[8]},{"t":"."}]},{"n":14,"text":"And I will pluck up your Asherahs from your midst, And I will destroy your cities.","tok":[{"t":"And I will pluck "},{"t":"up","s":["H5428"],"a":[0]},{"t":" your Asherahs from your "},{"t":"midst","s":["H7130"],"a":[2]},{"t":", And I will "},{"t":"destroy","s":["H8045"],"a":[3]},{"t":" your "},{"t":"cities","s":["H6145"]},{"t":"."}]},{"n":15,"text":"And I will execute vengeance in anger and wrath Upon the nations that have not listened.","tok":[{"t":"And I will "},{"t":"execute","s":["H6213"],"a":[0]},{"t":" "},{"t":"vengeance","s":["H5359"],"a":[3]},{"t":" in "},{"t":"anger","s":["H0639"],"a":[1]},{"t":" and wrath Upon the nations that have not listened."}]}]}
