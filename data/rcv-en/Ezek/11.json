,"a":[0]},{"t":"; I will "},{"t":"judge","s":["H8199"],"a":[5]},{"t":" you in the "},{"t":"borders","s":["H1366"],"a":[3]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[4]},{"t":", and you will "},{"t":"know","s":["H3045"],"a":[7]},{"t":" that I am "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":"."}]},{"n":11,"text":"The city will not be a pot to you so that you will be in its midst as flesh; I will judge you in the borders of Israel.","tok":[{"t":"The city will not be a pot to you so that you will be in its "},{"t":"midst","s":["H8432"],"a":[7]},{"t":" as "},{"t":"flesh","s":["H1320"],"a":[8]},{"t":"; I will "},{"t":"judge","s":["H8199"],"a":[12]},{"t":" you in the "},{"t":"borders","s":["H1366"],"a":[10]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[11]},{"t":"."}]},{"n":12,"text":"And you will know that I am Jehovah; for you have not walked in My statutes, nor have you done My ordinances, but you have done according to the ordinances of the nations that surround you.","tok":[{"t":"And you will "},{"t":"know","s":["H3045"],"a":[0]},{"t":" that I am "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":"; for you have not "},{"t":"walked","s":["H1980"],"a":[7]},{"t":" in My "},{"t":"statutes","s":["H2706"],"a":[5]},{"t":", nor have you done My ordinances, but you have "},{"t":"done","s":["H6213"],"a":[15]},{"t":" according to the ordinances of the nations that surround you."}]},{"n":13,"text":"And when I prophesied, Pelatiah the son of Benaiah died; and I fell on my face and cried out with a loud voice, and I said, Ah, Lord Jehovah! Are You making a full end to the remnant of Israel?","tok":[{"t":"And when I "},{"t":"prophesied","s":["H5012"],"a":[1]},{"t":", "},{"t":"Pelatiah","s":["H6410"],"a":[2]},{"t":" the "},{"t":"son","s":["H1121"],"a":[3]},{"t":" of "},{"t":"Benaiah","s":["H1141"],"a":[4]},{"t":" "},{"t":"died","s":["H4191"],"a":[5]},{"t":"; and I fell on my "},{"t":"face","s":["H6440"],"a":[8]},{"t":" and "},{"t":"cried","s":["H2199"],"a":[9]},{"t":" out with a "},{"t":"loud","s":["H1419"],"a":[11]},{"t":" "},{"t":"voice","s":["H6963"],"a":[10]},{"t":", and I "},{"t":"said","s":["H0559"],"a":[12]},{"t":", "},{"t":"Ah","s":["H0162"],"a":[13]},{"t":", "},{"t":"Lord","s":["H0136"],"a":[14]},{"t":" Jehovah! Are You "},{"t":"making","s":["H6213"],"a":[18]},{"t":" a full "},{"t":"end","s":["H3617"],"a":[16]},{"t":" to the "},{"t":"remnant","s":["H7611"],"a":[20]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[21]},{"t":"?"}]},{"n":14,"text":"Then the word of Jehovah came to me, saying,","tok":[{"t":"Then the "},{"t":"word","s":["H1697"],"a":[1]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" came to me, "},{"t":"saying","s":["H0559"],"a":[4]},{"t":","}]},{"n":15,"text":"Son of man, your brothers, your brothers, your kinsmen and the whole house of Israel, all of them, are the ones to whom the inhabitants of Jerusalem have said, Stay far away from Jehovah; to us was this land given as an inheritance.","tok":[{"t":"Son","s":["H1121"],"a":[0]},{"t":" of "},{"t":"man","s":["H0120"],"a":[1]},{"t":", your "},{"t":"brothers","s":["H0251"],"a":[2]},{"t":", your "},{"t":"brothers","s":["H0251"],"a":[3]},{"t":", your kinsmen and the whole "},{"t":"house","s":["H1004"],"a":[7]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[8]},{"t":", all of them, are the ones to whom the "},{"t":"inhabitants","s":["H3427"],"a":[13]},{"t":" of "},{"t":"Jerusalem","s":["H3389"],"a":[14]},{"t":" have "},{"t":"said","s":["H0559"],"a":[11]},{"t":", Stay "},{"t":"far","s":["H7368"],"a":[15]},{"t":" away from "},{"t":"Jehovah","s":["H3068"],"a":[17]},{"t":"; to us was this "},{"t":"land","s":["H0776"],"a":[21]},{"t":" "},{"t":"given","s":["H5414"],"a":[20]},{"t":" as an "},{"t":"inheritance","s":["H4181"],"a":[22]},{"t":"."}]},{"n":16,"text":"Therefore say, Thus says the Lord Jehovah, Though I have sent them far away among the nations and though I have scattered them among the countries, I have been a sanctuary to them for a little while in the countries