5307"],"a":[6]},{"t":" in "},{"t":"Egypt","s":["H4714"],"a":[8]},{"t":"; And they will take "},{"t":"away","s":["H3947"],"a":[9]},{"t":" her "},{"t":"multitude","s":["H1995"],"a":[10]},{"t":", And her "},{"t":"foundations","s":["H3247"],"a":[12]},{"t":" will be broken "},{"t":"down","s":["H2040"],"a":[11]},{"t":"."}]},{"n":5,"text":"Ethiopia, Put, Lud, all Arabia, Libya, and the children of the land of the covenant will fall by the sword with them.","tok":[{"t":"Ethiopia","s":["H3568"],"a":[0]},{"t":", Put, Lud, all Arabia, "},{"t":"Libya","s":["H6316"],"a":[1]},{"t":", and the children of the "},{"t":"land","s":["H0776"],"a":[7]},{"t":" of the covenant will "},{"t":"fall","s":["H5307"],"a":[11]},{"t":" by the "},{"t":"sword","s":["H2719"],"a":[10]},{"t":" with them."}]},{"n":6,"text":"Thus says Jehovah, Those who support Egypt will fall, And the pride of her strength will come down; They will fall by the sword within her, From Migdol to Syene, Declares the Lord Jehovah.","tok":[{"t":"Thus "},{"t":"says","s":["H0559"],"a":[1]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":", Those who support "},{"t":"Egypt","s":["H4714"],"a":[5]},{"t":" will "},{"t":"fall","s":["H5307"],"a":[3]},{"t":", And the "},{"t":"pride","s":["H1347"],"a":[7]},{"t":" of her strength will come "},{"t":"down","s":["H3381"],"a":[6]},{"t":"; They will "},{"t":"fall","s":["H5307"],"a":[12]},{"t":" by the "},{"t":"sword","s":["H2719"],"a":[11]},{"t":" within her, From Migdol to "},{"t":"Syene","s":["H5482"],"a":[10]},{"t":", Declares the "},{"t":"Lord","s":["H0136"],"a":[15]},{"t":" "},{"t":"Jehovah","s":["H3069"],"a":[16]},{"t":"."}]},{"n":7,"text":"And they will be desolate in the midst of desolate countries, and her cities will be the most desolate among ruined cities.","tok":[{"t":"And they will be "},{"t":"desolate","s":["H8074"],"a":[0]},{"t":" in the "},{"t":"midst","s":["H8432"],"a":[1]},{"t":" of "},{"t":"desolate","s":["H8074"],"a":[3]},{"t":" "},{"t":"countries","s":["H0776"],"a":