r his "},{"t":"iniquity","s":["H5771"],"a":[10]},{"t":" and you have "},{"t":"delivered","s":["H5337"],"a":[15]},{"t":" your "},{"t":"soul","s":["H5315"],"a":[14]},{"t":"."}]},{"n":20,"text":"And when a righteous one turns from his righteousness and commits iniquity, and I put a stumbling block before him, he will die. Because you did not warn him, he will die in his sin, and his righteous actions, which he had done, will not be remembered; but his blood I will require at your hand.","tok":[{"t":"And "},{"t":"when","s":["H7725"],"a":[0]},{"t":" a "},{"t":"righteous","s":["H6662"],"a":[1]},{"t":" one "},{"t":"turns","s":["H7725"]},{"t":" from his "},{"t":"righteousness","s":["H6664"],"a":[2]},{"t":" and "},{"t":"commits","s":["H6213"],"a":[3]},{"t":" "},{"t":"iniquity","s":["H5766"],"a":[4]},{"t":", and I put a stumbling block "},{"t":"before","s":["H6440"],"a":[7]},{"t":" him, he will "},{"t":"die","s":["H4191"],"a":[9]},{"t":". Because you did not "},{"t":"warn","s":["H2094"],"a":[12]},{"t":" him, he will "},{"t":"die","s":["H4191"],"a":[14]},{"t":" in his "},{"t":"sin","s":["H2403"],"a":[13]},{"t":", and his righteous actions, which he had "},{"t":"done","s":["H6213"],"a":[19]},{"t":", will not be "},{"t":"remembered","s":["H2142"],"a":[16]},{"t":"; but his "},{"t":"blood","s":["H1818"],"a":[20]},{"t":" I will "},{"t":"require","s":["H1245"],"a":[22]},{"t":" at your "},{"t":"hand","s":["H3027"],"a":[21]},{"t":"."}]},{"n":21,"text":"And if you warn a righteous one so that the righteous one does not sin, and he does not sin, he shall surely live, because he was warned; and you have delivered your soul.","tok":[{"t":"And if you "},{"t":"warn","s":["H2094"],"a":[2]},{"t":" a "},{"t":"righteous","s":["H6662"],"a":[3]},{"t":" one so that the "},{"t":"righteous","s":["H6662"],"a":[6]},{"t":" one does not "},{"t":"sin","s":["H2398"],"a":[5]},{"t":", and he does not "},{"t":"sin","s":["H2398"],"a":[9]},{"t":", he shall "},{"t":"surely","s":["H2421"],"a":[10]},{"t":" "},{"t":"live","s":["H2421"],"a":[11]},{"t":", because he was "},{"t":"warned","s":["H2094"],"a":[13]},{"t":"; and you have "},{"t":"delivered","s":["H5337"],"a":[17]},{"t":" your "},{"t":"soul","s":["H5315"],"a":[16]},{"t":"."}]},{"n":22,"text":"And the hand of Jehovah was upon me there; and He said to me, Arise, go forth to the plain, and there I will speak with you.","tok":[{"t":"And the "},{"t":"hand","s":["H3027"],"a":[3]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" was upon me there; and He "},{"t":"said","s":["H0559"],"a":[5]},{"t":" to me, "},{"t":"Arise","s":["H6965"],"a":[7]},{"t":", go "},{"t":"forth","s":["H3318"],"a":[8]},{"t":" to the "},{"t":"plain","s":["H1237"],"a":[10]},{"t":", and there I will speak with you."}]},{"n":23,"text":"So I arose and went forth to the plain. And the glory of Jehovah stood there, like the glory that I had seen by the river Chebar; and I fell on my face.","tok":[{"t":"So I "},{"t":"arose","s":["H6965"],"a":[0]},{"t":" and went "},{"t":"forth","s":["H3318"],"a":[1]},{"t":" to the "},{"t":"plain","s":["H1237"],"a":[3]},{"t":". And the "},{"t":"glory","s":["H3519"],"a":[6]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[7]},{"t":" "},{"t":"stood","s":["H5975"],"a":[8]},{"t":" there, like the "},{"t":"glory","s":["H3519"],"a":[9]},{"t":" that I had seen by the "},{"t":"river","s":["H5104"],"a":[13]},{"t":" "},{"t":"Chebar","s":["H3529"],"a":[14]},{"t":"; and I "},{"t":"fell","s":["H5307"],"a":[15]},{"t":" on my "},{"t":"face","s":["H6440"],"a":[17]},{"t":"."}]},{"n":24,"text":"Then the Spirit entered into me and caused me to stand up on my feet; and He spoke with me and said to me, Go, shut yourself up within your house.","tok":[{"t":"Then the "},{"t":"Spirit","s":["H7307"],"a":[2]},{"t":" "},{"t":"entered","s":["H0935"],"a":[0]},{"t":" into me and caused me to stand up on my "},{"t":"feet","s":["H7272"],"a":[5]},{"t":"; and He "},{"t":"spoke","s":["H1696"],"a":[6]},{"t":" with me and "},{"t":"said","s":["H0559"],"a":[8]},{"t":" to me, "},{"t":"Go","s":["H0935"],"a":[10]},{"t":", "},{"t":"shut","s":["H5462"],"a":[11]},{"t":" yourself up "},{"t":"within","s":["H8432"],"a":[12]},{"t":" your "},{"t":"house","s":["H1004"],"a":[13]},{"t":"."}]},{"n":25,"text":"As for you, son of man, they will now put ropes on you and bind you with them so that you cannot go out among them.","tok":[{"t":"As for you, "},{"t":"son","s":["H1121"],"a":[1]},{"t":" of "},{"t":"man","s":["H0120"],"a":[2]},{"t":", they will now "},{"t":"put","s":["H5414"],"a":[4]},{"t":" ropes on you and "},{"t":"bind","s":["H0631"],"a":[7]},{"t":" you with them so that you cannot go "},{"t":"out","s":["H3318"],"a":[10]},{"t":" "},{"t":"among","s":["H8432"],"a":[11]},{"t":" them."}]},{"n":26,"text":"And I will make your tongue stick to the roof of your mouth so that you will be dumb and not one who reproves them, for they are a rebellious house.","tok":[{"t":"And I will make your "},{"t":"tongue","s":["H3956"],"a":[0]},{"t":" stick to the roof of your "},{"t":"mouth","s":["H2441"],"a":[3]},{"t":" so that you will be "},{"t":"dumb","s":["H0481"],"a":[4]},{"t":" and not one who reproves them, for they are a "},{"t":"rebellious","s":["H4805"],"a":[12]},{"t":" "},{"t":"house","s":["H1004"],"a":[11]},{"t":"."}]},{"n":27,"text":"But when I speak with you, I will open your mouth, and you will say to them, Thus says the Lord Jehovah, Let him who hears hear, and let him who refuses refuse; for they are a rebellious house.","tok":[{"t":"But when I "},{"t":"speak","s":["H1696"],"a":[0]},{"t":" "},{"t":"with","s":["H0854"],"a":[1]},{"t":" you, I will "},{"t":"open","s":["H6605"],"a":[2]},{"t":" your "},{"t":"mouth","s":["H6310"],"a":[4]},{"t":", and you will "},{"t":"say","s":["H0559"],"a":[5]},{"t":" to them, Thus "},{"t":"says","s":["H0559"],"a":[8]},{"t":" the "},{"t":"Lord","s":["H0136"],"a":[9]},{"t":" Jehovah, Let him who "},{"t":"hears","s":["H8085"],"a":[11]},{"t":" "},{"t":"hear","s":["H8085"],"a":[12]},{"t":", and let him who r