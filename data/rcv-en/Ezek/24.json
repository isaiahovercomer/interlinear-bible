you to "},{"t":"rest","s":["H5117"],"a":[11]},{"t":"."}]},{"n":14,"text":"I, Jehovah, have spoken. The time is coming, and I will do it; I will not refrain, nor will I spare, nor will I repent. According to your ways and according to your doings I will judge you, declares the Lord Jehovah.","tok":[{"t":"I, "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", have "},{"t":"spoken","s":["H1696"],"a":[2]},{"t":". The time is coming, and I will "},{"t":"do","s":["H6213"],"a":[4]},{"t":" it; I will not refrain, nor will I "},{"t":"spare","s":["H2347"],"a":[8]},{"t":", nor will I "},{"t":"repent","s":["H5162"],"a":[10]},{"t":". According to your "},{"t":"ways","s":["H1870"],"a":[11]},{"t":" and according to your "},{"t":"doings","s":["H5949"],"a":[12]},{"t":" I will "},{"t":"judge","s":["H8199"],"a":[13]},{"t":" you, declares the "},{"t":"Lord","s":["H0136"],"a":[15]},{"t":" "},{"t":"Jehovah","s":["H3069"],"a":[16]},{"t":"."}]},{"n":15,"text":"Then the word of Jehovah came to me, saying,","tok":[{"t":"Then the "},{"t":"word","s":["H1697"],"a":[1]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" came to me, "},{"t":"saying","s":["H0559"],"a":[4]},{"t":","}]},{"n":16,"text":"Son of man, I am about to take away the delight of your eyes from you with a blow. Yet you shall neither mourn nor weep, nor shall your tears come.","tok":[{"t":"Son","s":["H1121"],"a":[0]},{"t":" of "},{"t":"man","s":["H0120"],"a":[1]},{"t":", I am about to take "},{"t":"away","s":["H3947"],"a":[3]},{"t":" the delight of your "},{"t":"eyes","s":["H5869"],"a":[7]},{"t":" from you with a blow. Yet you shall neither "},{"t":"mourn","s":["H5594"],"a":[10]},{"t":" nor "},{"t":"weep","s":["H1058"],"a":[12]},{"t":", nor shall your "},{"t":"tears","s":["H1832"],"a":[15]},{"t":" "},{"t":"come","s":["H0935"],"a":[14]},{"t":"."}]},{"n":17,"text":"Groan silently; make no mourning for the dead; bind your turban upon you, and put your sandals upon your feet, and do not cover your lips, and do not eat the bread of men.","tok":[{"t":"Groan silently; "},{"t":"make","s":["H6213"],"a":[5]},{"t":" no "},{"t":"mourning","s":["H0060"],"a":[3]},{"t":" for the "},{"t":"dead","s":["H4191"],"a":[2]},{"t":"; "},{"t":"bind","s":["H2280"],"a":[7]},{"t":" your turban upon you, and put your sandals upon your "},{"t":"feet","s":["H7272"],"a":[11]},{"t":", and do not "},{"t":"cover","s":["H5844"],"a":[13]},{"t":" your "},{"t":"lips","s":["H8222"],"a":[15]},{"t":", and do not "},{"t":"eat","s":["H0398"],"a":[19]},{"t":" the "},{"t":"bread","s":["H3899"],"a":[16]},{"t":" of "},{"t":"men","s":["H0582"],"a":[17]},{"t":"."}]},{"n":18,"text":"So I spoke to the people in the morning, and in the evening my wife died. And in the morning I did as I was commanded.","tok":[{"t":"So I "},{"t":"spoke","s":["H1696"],"a":[0]},{"t":" to the "},{"t":"people","s":["H5971"],"a":[2]},{"t":" in the "},{"t":"morning","s":["H1242"],"a":[3]},{"t":", and in the "},{"t":"evening","s":["H6153"],"a":[6]},{"t":" my "},{"t":"wife","s":["H0802"],"a":[5]},{"t":" "},{"t":"died","s":["H4191"],"a":[4]},{"t":". And in the "},{"t":"morning","s":["H1242"],"a":[8]},{"t":" I "},{"t":"did","s":["H6213"],"a":[7]},{"t":" as "},{"t":"I","s":["H1242"],"a":[8]},{"t":" was "},{"t":"commanded","s":["H6680"],"a":[10]},{"t":"."}]},{"n":19,"text":"And the people said to me, Will you not tell us what these things you are doing signify to us?","tok":[{"t":"And the "},{"t":"people","s":["H5971"],"a":[2]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to me, Will you not "},{"t":"tell","s":["H5046"],"a":[4]},{"t":" us what these things you are doing signify to us?"}]},{"n":20,"text":"So I said to them, The word of Jehovah came to me, saying,","tok":[{"t":"So I said to them, The "},{"t":"word","s":["H1697"],"a":[2]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" came to me, "},{"t":"saying","s":["H0559"],"a":[6]},{"t":","}]},{"n":21,"text":"Speak to the house of Israel, Thus says the Lord Jehovah, I will profane My sanctuary, the pride of your strength, the delight of your eyes, and that which your soul longs after; and your sons and your daughters whom you have left behind will fall by the sword.","tok":[{"t":"Speak","s":["H0559"],"a":[0]},{"t":" to the "},{"t":"house","s":["H1004"],"a":[1]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[2]},{"t":", Thus "},{"t":"says","s":["H0559"],"a":[4]},{"t":" the "},{"t":"Lord","s":["H0136"],"a":[5]},{"t":" Jehovah, I will "},{"t":"profane","s":["H2490"],"a":[8]},{"t":" My "},{"t":"sanctuary","s":["H4720"],"a":[10]},{"t":", the pride of your "},{"t":"strength","s":["H5797"],"a":[12]},{"t":", the delight of your "},{"t":"eyes","s":["H5869"],"a":[14]},{"t":", and that which your "},{"t":"soul","s":["H5315"],"a":[16]},{"t":" longs after; and your "},{"t":"sons","s":["H1121"],"a":[17]},{"t":" and your "},{"t":"daughters","s":["H1323"],"a":[18]},{"t":" whom you have "},{"t":"left","s":["H5800"],"a":[20]},{"t":" behind will "},{"t":"fall","s":["H5307"],"a":[22]},{"t":" by the "},{"t":"sword","s":["H2719"],"a":[21]},{"t":"."}]},{"n":22,"text":"And you will do as I have done; you shall not cover your lips, nor shall you eat the bread of men.","tok":[{"t":"And you will "},{"t":"do","s":["H6213"],"a":[0]},{"t":" as I have "},{"t":"done","s":["H6213"],"a":[2]},{"t":"; you shall not "},{"t":"cover","s":["H5844"],"a":[6]},{"t":" your "},{"t":"lips","s":["H8222"],"a":[4]},{"t":", nor shall you "},{"t":"eat","s":["H0398"],"a":[10]},{"t":" the "},{"t":"bread","s":["H3899"],"a":[7]},{"t":" of "},{"t":"men","s":["H0582"],"a":[8]},{"t":"."}]},{"n":23,"text":"And your turbans shall be upon your heads, and your sandals, upon your feet; you shall not mourn nor weep, but you shall rot away in your iniquities and groan one to another.","tok":[{"t":"And your turbans shall be upon your "},{"t":"heads","s":["H7218"],"a":[2]},{"t":", and your sandals, upon your "},{"t":"feet","s":["H7272"],"a":[4]},{"t":"; you shall not "},{"t":"mourn","s":["H5594"],"a":[6]},{"t":" nor "},{"t":"