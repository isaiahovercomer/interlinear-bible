"},{"t":"seven","s":["H7651"],"a":[2]},{"t":" "},{"t":"days","s":["H3117"],"a":[3]},{"t":" for him."}]},{"n":27,"text":"And on the day he enters the sanctuary, into the inner court to minister in the sanctuary, he shall present his sin offering, declares the Lord Jehovah.","tok":[{"t":"And on the "},{"t":"day","s":["H3117"],"a":[0]},{"t":" he enters the "},{"t":"sanctuary","s":["H6944"],"a":[3]},{"t":", into the "},{"t":"inner","s":["H6442"],"a":[6]},{"t":" "},{"t":"court","s":["H2691"],"a":[5]},{"t":" to "},{"t":"minister","s":["H8334"],"a":[7]},{"t":" in the "},{"t":"sanctuary","s":["H6944"],"a":[8]},{"t":", he shall present his sin "},{"t":"offering","s":["H2403"],"a":[10]},{"t":", "},{"t":"declares","s":["H5002"],"a":[11]},{"t":" the "},{"t":"Lord","s":["H0136"],"a":[12]},{"t":" "},{"t":"Jehovah","s":["H3069"],"a":[13]},{"t":"."}]},{"n":28,"text":"And they shall have an inheritance: I am their inheritance. And you shall not give them a possession in Israel — I am their possession.","tok":[{"t":"And they shall have an "},{"t":"inheritance","s":["H5159"],"a":[4]},{"t":": I am their "},{"t":"inheritance","s":["H5159"],"a":[2]},{"t":". And you shall not "},{"t":"give","s":["H5414"],"a":[7]},{"t":" them a "},{"t":"possession","s":["H0272"],"a":[5]},{"t":" in "},{"t":"Israel","s":["H3478"],"a":[9]},{"t":" — I am their "},{"t":"possession","s":["H0272"],"a":[11]},{"t":"."}]},{"n":29,"text":"They shall eat the meal offering, the sin offering, and the trespass offering; and every devoted thing in Israel shall be theirs.","tok":[{"t":"They shall "},{"t":"eat","s":["H0398"],"a":[4]},{"t":" the meal "},{"t":"offering","s":["H4503"],"a":[0]},{"t":", the sin "},{"t":"offering","s":["H2403"],"a":[1]},{"t":", and the trespass "},{"t":"offering","s":["H0817"],"a":[2]},{"t":"; and every devoted "},{"t":"thing","s":["H2764"],"a":[6]},{"t":" in "},{"t":"Israel","s":["H3478"],"a":[7]},{"t":" shall be theirs."}]},{"n":30,"text":"And the first of all the firstfruits of everything, and