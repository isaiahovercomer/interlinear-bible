,"s":["H5731"],"a":[11]},{"t":" to the lowest "},{"t":"parts","s":["H8482"],"a":[14]},{"t":" of the "},{"t":"earth","s":["H0776"],"a":[13]},{"t":"; you will "},{"t":"lie","s":["H7901"],"a":[17]},{"t":" "},{"t":"among","s":["H8432"],"a":[15]},{"t":" the "},{"t":"uncircumcised","s":["H6189"],"a":[16]},{"t":", with those who were "},{"t":"slain","s":["H2491"],"a":[19]},{"t":" by the "},{"t":"sword","s":["H2719"],"a":[20]},{"t":". This is "},{"t":"Pharaoh","s":["H6547"],"a":[22]},{"t":" and all his "},{"t":"multitude","s":["H1995"],"a":[24]},{"t":", "},{"t":"declares","s":["H5002"],"a":[25]},{"t":" the "},{"t":"Lord","s":["H0136"],"a":[26]},{"t":" "},{"t":"Jehovah","s":["H3069"],"a":[27]},{"t":"."}]}]}
