 "},{"t":"pieces","s":["H2966"],"a":[9]},{"t":", nor has any "},{"t":"abominable","s":["H6292"],"a":[19]},{"t":" "},{"t":"flesh","s":["H1320"],"a":[18]},{"t":" entered into my "},{"t":"mouth","s":["H6310"],"a":[17]},{"t":"."}]},{"n":15,"text":"And He said to me, See, I give you cow’s dung instead of human excrement, and you will make your bread over it.","tok":[{"t":"And He "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to me, See, I give you "},{"t":"cow’s","s":["H1241"],"a":[7]},{"t":" "},{"t":"dung","s":["H6832"],"a":[6]},{"t":" instead of human excrement, and you will make your "},{"t":"bread","s":["H3899"],"a":[13]},{"t":" over it."}]},{"n":16,"text":"Then He said to me, Son of man, I am now breaking the staff of bread in Jerusalem; and they will eat bread by weight and in anxiety, and they will drink water by measure and in horror;","tok":[{"t":"Then He "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to me, "},{"t":"Son","s":["H1121"],"a":[2]},{"t":" of "},{"t":"man","s":["H0120"],"a":[3]},{"t":", I am now "},{"t":"breaking","s":["H7665"],"a":[5]},{"t":" the "},{"t":"staff","s":["H4294"],"a":[6]},{"t":" of "},{"t":"bread","s":["H3899"],"a":[7]},{"t":" in "},{"t":"Jerusalem","s":["H3389"],"a":[8]},{"t":"; and they will "},{"t":"eat","s":["H0398"],"a":[9]},{"t":" "},{"t":"bread","s":["H3899"],"a":[10]},{"t":" by "},{"t":"weight","s":["H4948"],"a":[11]},{"t":" and in anxiety, and they will "},{"t":"drink","s":["H8354"],"a":[16]},{"t":" "},{"t":"water","s":["H4325"],"a":[13]},{"t":" by "},{"t":"measure","s":["H4884"],"a":[14]},{"t":" and in "},{"t":"horror","s":["H8078"],"a":[15]},{"t":";"}]},{"n":17,"text":"Because they will lack bread and water, and they will be horrified at each other and will rot in their iniquity.","tok":[{"t":"Because they will lack "},{"t":"bread","s":["H3899"],"a":[2]},{"t":" and "},{"t":"water","s":["H4325"],"a":[3]},{"t":", and they will be horrified at each other and will rot in their "},{"t":"iniquity","s":["H5771"],"a":[8]},{"t":"."}]}]}
