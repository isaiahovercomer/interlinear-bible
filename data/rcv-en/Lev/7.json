use, but you shall by no means eat it.","tok":[{"t":"And the "},{"t":"fat","s":["H2459"],"a":[0]},{"t":" of an animal that dies and the "},{"t":"fat","s":["H2459"],"a":[2]},{"t":" of an animal which is torn by "},{"t":"beasts","s":["H2966"],"a":[3]},{"t":" may be put to any other "},{"t":"use","s":["H4399"],"a":[6]},{"t":", but you shall by no means "},{"t":"eat","s":["H0398"],"a":[9]},{"t":" it."}]},{"n":25,"text":"For whoever eats the fat of a beast from which someone presents an offering by fire to Jehovah, indeed the person who eats it shall be cut off from his people.","tok":[{"t":"For whoever "},{"t":"eats","s":["H0398"],"a":[2]},{"t":" the "},{"t":"fat","s":["H2459"],"a":[3]},{"t":" of a "},{"t":"beast","s":["H0929"],"a":[5]},{"t":" from which someone presents an "},{"t":"offering","s":["H7126"],"a":[7]},{"t":" by "},{"t":"fire","s":["H0801"],"a":[9]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":", indeed the person who "},{"t":"eats","s":["H0398"],"a":[13]},{"t":" it shall be cut "},{"t":"off","s":["H3772"],"a":[11]},{"t":" from his "},{"t":"people","s":["H5971"],"a":[14]},{"t":"."}]},{"n":26,"text":"And you shall not eat any blood, either of bird or of beast, in any of your dwelling places.","tok":[{"t":"And you shall not "},{"t":"eat","s":["H0398"],"a":[3]},{"t":" any "},{"t":"blood","s":["H1818"],"a":[1]},{"t":", either of bird or of "},{"t":"beast","s":["H0929"],"a":[7]},{"t":", in any of your dwelling places."}]},{"n":27,"text":"Any person who eats any blood, that person shall be cut off from his people.","tok":[{"t":"Any person who "},{"t":"eats","s":["H0398"],"a":[3]},{"t":" "},{"t":"any","s":["H3605"],"a":[0]},{"t":" "},{"t":"blood","s":["H1818"],"a":[5]},{"t":", that person shall be cut "},{"t":"off","s":["H3772"],"a":[6]},{"t":" from his "},{"t":"people","s":["H5971"],"a":[9]},{"t":"."}]},{"n":28,"text":"Then Jehovah spoke to Moses, saying,","tok":[{"t":"Then "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"spoke","s":["H1696"],