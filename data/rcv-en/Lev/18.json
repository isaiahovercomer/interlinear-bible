{"t":" her "},{"t":"nakedness","s":["H6172"],"a":[9]},{"t":"."}]},{"n":16,"text":"You shall not uncover the nakedness of your brother’s wife; it is your brother’s nakedness.","tok":[{"t":"You shall not "},{"t":"uncover","s":["H1540"],"a":[4]},{"t":" the "},{"t":"nakedness","s":["H6172"],"a":[0]},{"t":" of your "},{"t":"brother’s","s":["H0251"],"a":[2]},{"t":" "},{"t":"wife","s":["H0802"],"a":[1]},{"t":"; it is your "},{"t":"brother’s","s":["H0251"],"a":[6]},{"t":" "},{"t":"nakedness","s":["H6172"],"a":[5]},{"t":"."}]},{"n":17,"text":"You shall not uncover the nakedness of a woman and her daughter; you shall not take her son’s daughter or her daughter’s daughter to uncover her nakedness; they are her flesh; it is wickedness.","tok":[{"t":"You shall not "},{"t":"uncover","s":["H1540"],"a":[4]},{"t":" the "},{"t":"nakedness","s":["H6172"],"a":[0]},{"t":" of a "},{"t":"woman","s":["H0802"],"a":[1]},{"t":" and her "},{"t":"daughter","s":["H1323"],"a":[2]},{"t":"; you shall not "},{"t":"take","s":["H3947"],"a":[12]},{"t":" her "},{"t":"son’s","s":["H1121"],"a":[7]},{"t":" "},{"t":"daughter","s":["H1323"],"a":[6]},{"t":" or her "},{"t":"daughter’s","s":["H1323"],"a":[9]},{"t":" "},{"t":"daughter","s":["H1323"],"a":[10]},{"t":" to "},{"t":"uncover","s":["H1540"],"a":[13]},{"t":" her "},{"t":"nakedness","s":["H6172"],"a":[14]},{"t":"; they are her flesh; it is "},{"t":"wickedness","s":["H2154"],"a":[17]},{"t":"."}]},{"n":18,"text":"And you shall not take a woman as wife in addition to her sister, as a rival to uncover her nakedness while she is alive.","tok":[{"t":"And you shall not "},{"t":"take","s":["H3947"],"a":[4]},{"t":" a woman as "},{"t":"wife","s":["H0802"],"a":[0]},{"t":" in addition to her "},{"t":"sister","s":["H0269"],"a":[2]},{"t":", as a "},{"t":"rival","s":["H6887"],"a":[5]},{"t":" to "},{"t":"uncover","s":["H1540"],"a":[6]},{"t":" her "},{"t":"nakedness","s":["H6172"],"a":[7]},{"t":" while she is alive."}]},{"n":19,"text":"And you shall not approach a woman to uncover her nakedness while she is in her impurity of uncleanness.","tok":[{"t":"And you shall not "},{"t":"approach","s":["H7126"],"a":[5]},{"t":" a "},{"t":"woman","s":["H0802"],"a":[1]},{"t":" to "},{"t":"uncover","s":["H1540"],"a":[6]},{"t":" her "},{"t":"nakedness","s":["H6172"],"a":[7]},{"t":" while she is in her impurity of "},{"t":"uncleanness","s":["H2932"],"a":[3]},{"t":"."}]},{"n":20,"text":"And you shall not have sexual relations with the wife of your fellow countryman to become defiled with her.","tok":[{"t":"And you shall "},{"t":"not","s":["H5414"],"a":[4]},{"t":" have sexual relations with the "},{"t":"wife","s":["H0802"],"a":[1]},{"t":" of your fellow countryman to become "},{"t":"defiled","s":["H2930"],"a":[7]},{"t":" with her."}]},{"n":21,"text":"And you shall not give any of your offspring to pass through the fire to Molech, and so profane the name of your God; I am Jehovah.","tok":[{"t":"And you shall "},{"t":"not","s":["H5414"],"a":[2]},{"t":" give any of your offspring to "},{"t":"pass","s":["H5674"],"a":[3]},{"t":" through the fire to "},{"t":"Molech","s":["H4432"],"a":[4]},{"t":", and so "},{"t":"profane","s":["H2490"],"a":[6]},{"t":" the "},{"t":"name","s":["H8034"],"a":[8]},{"t":" of your "},{"t":"God","s":["H0430"],"a":[9]},{"t":"; I am "},{"t":"Jehovah","s":["H3068"],"a":[11]},{"t":"."}]},{"n":22,"text":"You shall not lie with a male as one lies with a woman; it is an abomination.","tok":[{"t":"You shall not "},{"t":"lie","s":["H7901"],"a":[3]},{"t":" with a male as one lies "},{"t":"with","s":["H4904"],"a":[4]},{"t":" a "},{"t":"woman","s":["H0802"],"a":[5]},{"t":"; it is an "},{"t":"abomination","s":["H8441"],"a":[6]},{"t":"."}]},{"n":23,"text":"And you shall not lie with any beast to defile yourself with it; neither shall any woman stand before a beast, to lie down with it; it is confusion.","tok":[{"t":"And "},{"t":"you","s":["H5414"],"a":[3]},{"t":" shall not "},{"t":"lie","s":["H7903"],"a":[4]},{"t":" with any "},{"t":"beast","s