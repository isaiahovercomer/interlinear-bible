{"v":1,"book":"Lev","ch":18,"verses":[{"n":1,"text":"Then Jehovah spoke to Moses, saying,","tok":[{"t":"Then "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"spoke","s":["H1696"],"a":[0]},{"t":" to "},{"t":"Moses","s":["H4872"],"a":[3]},{"t":", "},{"t":"saying","s":["H0559"],"a":[4]},{"t":","}]},{"n":2,"text":"Speak to the children of Israel, and say to them, I am Jehovah your God.","tok":[{"t":"Speak","s":["H1696"],"a":[0]},{"t":" to the "},{"t":"children","s":["H1121"],"a":[2]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":", and "},{"t":"say","s":["H0559"],"a":[4]},{"t":" to them, I am "},{"t":"Jehovah","s":["H3068"],"a":[7]},{"t":" your "},{"t":"God","s":["H0430"],"a":[8]},{"t":"."}]},{"n":3,"text":"You shall not do as they do in the land of Egypt, in which you dwelt; and you shall not do as they do in the land of Canaan, where I am bringing you, nor shall you walk in their statutes.","tok":[{"t":"You shall not do as they do in the "},{"t":"land","s":["H0776"],"a":[1]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[2]},{"t":", in which you "},{"t":"dwelt","s":["H3427"],"a":[4]},{"t":"; and you shall not "},{"t":"do","s":["H6213"],"a":[7]},{"t":" as they "},{"t":"do","s":["H6213"],"a":[17]},{"t":" in the "},{"t":"land","s":["H0776"],"a":[9]},{"t":" of "},{"t":"Canaan","s":["H3667"],"a":[10]},{"t":", where I am "},{"t":"bringing","s":["H0935"],"a":[13]},{"t":" you, nor shall you "},{"t":"walk","s":["H3212"]},{"t":" in their statutes."}]},{"n":4,"text":"You shall observe My ordinances, and you shall keep My statutes to walk in them; I am Jehovah your God.","tok":[{"t":"You shall observe My "},{"t":"ordinances","s":["H2708"],"a":[4]},{"t":", and you shall "},{"t":"keep","s":["H8104"],"a":[5]},{"t":" My statutes to "},{"t":"walk","s":["H3212"]},{"t":" in them; I am "},{"t":"Jehovah","s":["H3068"],"a":[9]},{"t":" your "},{"t":"God","s":["H0430"],"a":[10]},{"t":"."}]},{"n":5,"text":"So you shall keep My statutes and My ordinances, by which, if a man does