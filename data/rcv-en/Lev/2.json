"a":[22]},{"t":"."}]},{"n":3,"text":"And what is left of the meal offering shall be Aaron’s and his sons’; it is a thing most holy of Jehovah’s offerings by fire.","tok":[{"t":"And what is left of the meal "},{"t":"offering","s":["H4503"],"a":[2]},{"t":" shall be "},{"t":"Aaron’s","s":["H0175"],"a":[3]},{"t":" and his "},{"t":"sons","s":["H1121"],"a":[4]},{"t":"’; it is a thing "},{"t":"most","s":["H6944"],"a":[5]},{"t":" "},{"t":"holy","s":["H6944"],"a":[6]},{"t":" of Jehovah’s "},{"t":"offerings","s":["H0801"],"a":[7]},{"t":" by "},{"t":"fire","s":["H0801"]},{"t":"."}]},{"n":4,"text":"And when you present an offering of a meal offering baked in the oven, it shall be of fine flour, unleavened cakes mingled with oil or unleavened wafers anointed with oil.","tok":[{"t":"And when you present an offering of a meal "},{"t":"offering","s":["H4503"],"a":[3]},{"t":" "},{"t":"baked","s":["H3989"],"a":[4]},{"t":" in the "},{"t":"oven","s":["H8574"],"a":[5]},{"t":", it shall be of fine "},{"t":"flour","s":["H5560"],"a":[6]},{"t":", "},{"t":"unleavened","s":["H4682"],"a":[8]},{"t":" "},{"t":"cakes","s":["H2471"],"a":[7]},{"t":" "},{"t":"mingled","s":["H1101"],"a":[9]},{"t":" with "},{"t":"oil","s":["H8081"],"a":[10]},{"t":" or "},{"t":"unleavened","s":["H4682"],"a":[12]},{"t":" "},{"t":"wafers","s":["H7550"],"a":[11]},{"t":" "},{"t":"anointed","s":["H4886"],"a":[13]},{"t":" with "},{"t":"oil","s":["H8081"],"a":[14]},{"t":"."}]},{"n":5,"text":"And if your offering is a meal offering baked on a flat plate, it shall be of fine flour mingled with oil, unleavened.","tok":[{"t":"And if your offering is a meal "},{"t":"offering","s":["H4503"],"a":[1]},{"t":" baked on a flat plate, it shall be of fine "},{"t":"flour","s":["H5560"],"a":[5]},{"t":" "},{"t":"mingled","s":["H1101"],"a":[6]},{"t":" with "},{"t":"oil","s":["H8081"],"a":[7]},{"t":", "},{"t":"unleavened","s":["H4682"],"a":[8]},{"t":"."}]},{"n":6,"text":"You shall break it in pieces and pour oil on it; it is a meal offering.",