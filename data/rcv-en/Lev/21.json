0376"],"a":[7]},{"t":"; for the priest is "},{"t":"holy","s":["H6918"],"a":[11]},{"t":" to his "},{"t":"God","s":["H0430"],"a":[13]},{"t":"."}]},{"n":8,"text":"You shall sanctify him therefore, for he presents the food of your God. He shall be holy to you, for I Jehovah, who sanctifies you, am holy.","tok":[{"t":"You shall "},{"t":"sanctify","s":["H6942"],"a":[0]},{"t":" him therefore, for he presents the food of your "},{"t":"God","s":["H0430"],"a":[4]},{"t":". He shall be "},{"t":"holy","s":["H6918"],"a":[7]},{"t":" to you, for I "},{"t":"Jehovah","s":["H3068"],"a":[13]},{"t":", who sanctifies you, am "},{"t":"holy","s":["H6918"],"a":[11]},{"t":"."}]},{"n":9,"text":"And the daughter of any priest, if she profanes herself through prostitution, she profanes her father; she shall be burned with fire.","tok":[{"t":"And the "},{"t":"daughter","s":["H1323"],"a":[0]},{"t":" of "},{"t":"any","s":["H0376"],"a":[1]},{"t":" "},{"t":"priest","s":["H3548"],"a":[2]},{"t":", if she "},{"t":"profanes","s":["H2490"],"a":[4]},{"t":" herself through prostitution, she "},{"t":"profanes","s":["H2490"],"a":[9]},{"t":" her "},{"t":"father","s":["H0001"],"a":[7]},{"t":"; she shall be burned with "},{"t":"fire","s":["H0784"],"a":[10]},{"t":"."}]},{"n":10,"text":"And he who is the high priest among his brothers, on whose head the anointing oil has been poured and who has been consecrated to put on the garments, shall not let the hair of his head go loose nor tear his clothes.","tok":[{"t":"And he who is the "},{"t":"high","s":["H1419"],"a":[1]},{"t":" "},{"t":"priest","s":["H3548"],"a":[0]},{"t":" among his "},{"t":"brothers","s":["H0251"],"a":[2]},{"t":", on whose "},{"t":"head","s":["H7218"],"a":[6]},{"t":" the "},{"t":"anointing","s":["H4888"],"a":[8]},{"t":" "},{"t":"oil","s":["H8081"],"a":[7]},{"t":" has been "},{"t":"poured","s":["H3332"],"a":[4]},{"t":" and who has been "},{"t":"consecrated","s":["H4390"],"a":[9]},{"t":" to "},{"t":"put","s":["H3847"],"a":[12]},{"t":" on the "},{"t"