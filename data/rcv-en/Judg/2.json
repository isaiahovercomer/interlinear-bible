 country of "},{"t":"Ephraim","s":["H0669"],"a":[7]},{"t":", north of "},{"t":"Mount","s":["H2022"],"a":[6]},{"t":" "},{"t":"Gaash","s":["H1608"],"a":[10]},{"t":"."}]},{"n":10,"text":"And all that generation as well were gathered to their fathers; and another generation, who did not know Jehovah or the work that He had done for Israel, rose up after them.","tok":[{"t":"And all that "},{"t":"generation","s":["H1755"],"a":[2]},{"t":" as well were "},{"t":"gathered","s":["H0622"],"a":[4]},{"t":" to their "},{"t":"fathers","s":["H0001"],"a":[6]},{"t":"; and "},{"t":"another","s":["H0312"],"a":[9]},{"t":" "},{"t":"generation","s":["H1755"],"a":[8]},{"t":", who did not know "},{"t":"Jehovah","s":["H3068"],"a":[15]},{"t":" or the "},{"t":"work","s":["H4639"],"a":[18]},{"t":" that He had "},{"t":"done","s":["H6213"],"a":[20]},{"t":" for "},{"t":"Israel","s":["H3478"],"a":[21]},{"t":", rose up "},{"t":"after","s":["H0310"],"a":[10]},{"t":" them."}]},{"n":11,"text":"And the children of Israel did what was evil in the sight of Jehovah and served the Baals.","tok":[{"t":"And the "},{"t":"children","s":["H1121"],"a":[1]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[2]},{"t":" "},{"t":"did","s":["H6213"],"a":[0]},{"t":" what was "},{"t":"evil","s":["H7451"],"a":[4]},{"t":" in the "},{"t":"sight","s":["H5869"],"a":[5]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" and "},{"t":"served","s":["H5647"],"a":[7]},{"t":" the "},{"t":"Baals","s":["H1168"],"a":[9]},{"t":"."}]},{"n":12,"text":"And they forsook Jehovah, the God of their fathers, who brought them out from the land of Egypt; and they followed after other gods from among the gods of the peoples who surrounded them; and they worshipped them and provoked Jehovah to anger.","tok":[{"t":"And they "},{"t":"forsook","s":["H5800"],"a":[0]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":", the "},{"t":"God","s":["H0430"],"a":[3]},{"t":" of their "},{"t":"fathers","s":["H0001"],"a":[4]},{"t":", who brought them "},{"t":"out","s":["H3318"],"a":[5]},{"t":" from the "},{"t":"land","s":["H0776"],"a":[7]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[8]},{"t":"; and they "},{"t":"followed","s":["H3212"]},{"t":" after "},{"t":"other","s":["H0312"],"a":[12]},{"t":" "},{"t":"gods","s":["H0430"],"a":[13]},{"t":" from among the "},{"t":"gods","s":["H0430"],"a":[11]},{"t":" of the "},{"t":"peoples","s":["H5971"],"a":[14]},{"t":" who surrounded them; and they worshipped them and provoked "},{"t":"Jehovah","s":["H3068"],"a":[21]},{"t":" to "},{"t":"anger","s":["H3707"],"a":[19]},{"t":"."}]},{"n":13,"text":"And they forsook Jehovah and served Baal and the Ashtaroth.","tok":[{"t":"And they "},{"t":"forsook","s":["H5800"],"a":[0]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" and "},{"t":"served","s":["H5647"],"a":[3]},{"t":" "},{"t":"Baal","s":["H1168"],"a":[4]},{"t":" and the "},{"t":"Ashtaroth","s":["H6252"],"a":[5]},{"t":"."}]},{"n":14,"text":"Then the anger of Jehovah burned against Israel, and He delivered them into the hands of plunderers; and they plundered them. And He sold them into the hand of their enemies around them, and they were no longer able to stand before their enemies.","tok":[{"t":"Then the "},{"t":"anger","s":["H0639"],"a":[1]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" burned against "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":", and He "},{"t":"delivered","s":["H5414"],"a":[4]},{"t":" them into the "},{"t":"hands","s":["H3027"],"a":[5]},{"t":" of plunderers; and they plundered them. And He "},{"t":"sold","s":["H4376"],"a":[9]},{"t":" them into the "},{"t":"hand","s":["H3027"],"a":[10]},{"t":" of their "},{"t":"enemies","s":["H0341"],"a":[11]},{"t":" around them, and they were no "},{"t":"longer","s":["H5750"],"a":[15]},{"t":" able to "},{"t":"stand","s":["H5975"],"a":[16]},{"t":" "},{"t":"before","s":["H6440"],"a":[17]},{"t":" their "},{"t":"enemies","s":["H0341"],"a":[18]},{"t":"."}]},{"n":15,"text":"Whenever they went out, the hand of Jehovah was against them for evil, as Jehovah had spoken and as Jehovah had sworn to them; and they were greatly distressed.","tok":[{"t":"Whenever they went "},{"t":"out","s":["H3318"],"a":[2]},{"t":", the "},{"t":"hand","s":["H3027"],"a":[3]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" was against them for "},{"t":"evil","s":["H7451"],"a":[7]},{"t":", as "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":" had spoken and as "},{"t":"Jehovah","s":["H3068"],"a":[13]},{"t":" had "},{"t":"sworn","s":["H7650"],"a":[12]},{"t":" to them; and they were "},{"t":"greatly","s":["H3966"],"a":[17]},{"t":" "},{"t":"distressed","s":["H3334"],"a":[15]},{"t":"."}]},{"n":16,"text":"And Jehovah raised up judges, and they saved them out of the hands of those who plundered them.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" raised "},{"t":"up","s":["H6965"],"a":[0]},{"t":" "},{"t":"judges","s":["H8199"],"a":[2]},{"t":", and they saved them out of the "},{"t":"hands","s":["H3027"],"a":[4]},{"t":" of those who plundered them."}]},{"n":17,"text":"Yet they did not listen to their judges either, but they went about as harlots after other gods and worshipped them. They turned aside quickly from the way in which their fathers walked, the way of obeying the commandments of Jehovah; this they did not do.","tok":[{"t":"Yet they did not "},{"t":"listen","s":["H8085"],"a":[4]},{"t":" to their "},{"t":"judges","s":["H8199"],"a":[2]},{"t":" either, but they went about as harlots "},{"t":"after","s":["H0310"],"a":[7]},{"t":" "},{"t":"other","s":["H0312"],"a":[9]},{"t":" "},{"t":"gods","s":["H0430"],"a":[8]},{"t":" and worshipped them. They "},{"t":"turned","s":["H5493"],"a":[12]},{"t":" aside "},{"t":"quickly","s":["H4118"],"a":[13]},{"t":" from the "},{"t":"way","s":["H1870"],"a":[15]},{"t":" in which their "},{"t":"fathers","s":["H0001"],"a":[18]},{"t":" walked, the way of "},{"t":"obeying","s":["H8085"],"a":[19]},{"t":" the "},{"t":"commandments","s":["H4687"],"a":[20]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[21]},{"t":"; this they "},{"t":"did","s":["H6213"],"a":[23]},{"t":" not do."}]},{"n":18,"text":"And when Jehovah raised up judges for them, Jehovah was with the judge, and He saved them from the hand of their enemies throughout all the days of the judge; for Jehovah would be moved to pity by their groaning because of those who oppressed them and crushed them.","tok":[{"t":"And when "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" "},{"t":"raised","s":["H6965"],"a":[1]},{"t":" up "},{"t":"judges","s":["H8199"],"a":[4]},{"t":" for them, "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" was with the "},{"t":"judge","s":["H8199"],"a":[8]},{"t":", and He saved them from the "},{"t":"hand","s":["H3027"],"a":[10]},{"t":" of their "},{"t":"enemies","s":["H0341"],"a":[11]},{"t":" throughout all the "},{"t":"days","s":["H3117"],"a":[13]},{"t":" of the "},{"t":"judge","s":["H8199"],"a":[14]},{"t":"; for "},{"t":"Jehovah","s":["H3068"],"a":[17]},{"t":" would be moved to pity by their groaning "},{"t":"because","s":["H6440"],"a":[19]},{"t":" of "},{"t":"those","s":["H5009"],"a":[18]},{"t":" who "},{"t":"oppressed","s":["H3905"],"a":[20]},{"t":" them and crushed them."}]},{"n":19,"text":"But when the judge died, they turned and acted more corruptly than their fathers by following after other gods in order to serve them and worship them; they did not cease from any of their practices or from their stubborn way.","tok":[{"t":"But when the "},{"t":"judge","s":["H8199"],"a":[2]},{"t":" died, they turned and acted more "},{"t":"corruptly","s":["H7843"],"a":[4]},{"t":" than their "},{"t":"fathers","s":["H0001"],"a":[5]},{"t":" by "},{"t":"following","s":["H3212"]},{"t":" after "},{"t":"other","s":["H0312"],"a":[9]},{"t":" "},{"t":"gods","s":["H0430"],"a":[8]},{"t":" in order to "},{"t":"serve","s":["H5647"],"a":[10]},{"t":" them and worship them; they did not "},{"t":"cease","s":["H5307"],"a":[14]},{"t":" from any of their practices or from their "},{"t":"stubborn","s":["H7186"],"a":[17]},{"t":" "},{"t":"way","s":["H1870"],"a":[16]},{"t":"."}]},{"n":20,"text":"And the anger of Jehovah burned against Israel; and He said, Because this nation has transgressed My covenant which I commanded their fathers and they do not listen to My voice,","tok":[{"t":"And the "},{"t":"anger","s":["H0639"],"a":[1]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" burned against "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":"; and He "},{"t":"said","s":["H0559"],"a":[4]},{"t":", Because this nation has "},{"t":"transgressed","s":["H5674"],"a":[7]},{"t":" My "},{"t":"covenant","s":["H1285"],"a":[11]},{"t":" which I "},{"t":"commanded","s":["H6680"],"a":[13]},{"t":" their "},{"t":"fathers","s":["H0001"],"a":[15]},{"t":" and they do not listen to My "},{"t":"voice","s":["H6963"],"a":[18]},{"t":","}]},{"n":21,"text":"I for My part will no longer dispossess from before them any of the nations that Joshua left when he died,","tok":[{"t":"I for My part will no longer dispossess from "},{"t":"before","s":["H6440"],"a":[6]},{"t":" them "},{"t":"any","s":["H0376"],"a":[5]},{"t":" of the "},{"t":"nations","s":["H1471"],"a":[8]},{"t":" that "},{"t":"Joshua","s":["H3091"],"a":[11]},{"t":" "},{"t":"left","s":["H5800"],"a":[10]},{"t":" when he "},{"t":"died","s":["H4191"],"a":[12]},{"t":","}]},{"n":22,"text":"In order to test Israel through them as to whether or not they will keep the way of Jehovah by walking in it, as their fathers kept it.","tok":[{"t":"In order to test "},{"t":"Israel","s":["H3478"],"a":[4]},{"t":" through them as to whether or not they will "},{"t":"keep","s":["H8104"],"a":[5]},{"t":" the "},{"t":"way","s":["H1870"],"a":[8]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[9]},{"t":" by "},{"t":"walking","s":["H3212"]},{"t":" in it, as their "},{"t":"fathers","s":["H0001"],"a":[14]},{"t":" "},{"t":"kept","s":["H8104"],"a":[13]},{"t":" it."}]},{"n":23,"text":"So Jehovah left these nations, not dispossessing them quick