428"],"a":[2]},{"t":" of "},{"t":"Hamath","s":["H2574"],"a":[3]},{"t":" "},{"t":"heard","s":["H8085"],"a":[0]},{"t":" that "},{"t":"David","s":["H1732"],"a":[6]},{"t":" had struck down all the army of Hadadezer the "},{"t":"king","s":["H4428"],"a":[11]},{"t":" of "},{"t":"Zobah","s":["H6678"],"a":[12]},{"t":","}]},{"n":10,"text":"He sent Hadoram his son to King David to greet him and congratulate him for fighting against Hadadezer and striking him down, for Hadadezer had been at war with Tou. And Hadoram brought all kinds of articles of gold and of silver and of bronze.","tok":[{"t":"He "},{"t":"sent","s":["H7971"],"a":[0]},{"t":" "},{"t":"Hadoram","s":["H1913"],"a":[2]},{"t":" his "},{"t":"son","s":["H1121"],"a":[3]},{"t":" to "},{"t":"King","s":["H4428"],"a":[5]},{"t":" "},{"t":"David","s":["H1732"],"a":[6]},{"t":" to greet him and "},{"t":"congratulate","s":["H1288"],"a":[10]},{"t":" him for fighting against Hadadezer and striking him down, for Hadadezer had been at "},{"t":"war","s":["H0376"],"a":[17]},{"t":" with "},{"t":"Tou","s":["H8583"],"a":[19]},{"t":". And Hadoram brought all kinds of articles of "},{"t":"gold","s":["H2091"],"a":[24]},{"t":" and of "},{"t":"silver","s":["H3701"],"a":[25]},{"t":" and of "},{"t":"bronze","s":["H5178"],"a":[26]},{"t":"."}]},{"n":11,"text":"King David consecrated these also to Jehovah along with the silver and gold that he had carried from all the nations: from the Edomites and from the Moabites and from the children of Ammon and from the Philistines and from the Amalekites.","tok":[{"t":"King","s":["H4428"],"a":[3]},{"t":" "},{"t":"David","s":["H1732"],"a":[4]},{"t":" consecrated these also to "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":" along with the "},{"t":"silver","s":["H3701"],"a":[7]},{"t":" and "},{"t":"gold","s":["H2091"],"a":[8]},{"t":" that he had carried from all the "},{"t":"nations","s":["H1471"],"a":[12]},{"t":": from the Edomites and from the Moabites and from the "},{"t":"children","s":["H1121"],"a":[15]},{"t":" of "},{"t":"Ammon","s":["H5983"],"a":[16]},{"t":" and from the "},{"t":"Philistines","s":["H6430"],"a":[17]},{"t":" and from the "},{"t":"Amalekites","s":["H6002"],"a":[18]},{"t":"."}]},{"n":12,"text":"Moreover Abishai the son of Zeruiah struck down the Edomites in the Valley of Salt, that is, eighteen thousand men.","tok":[{"t":"Moreover "},{"t":"Abishai","s":["H0052"],"a":[0]},{"t":" the "},{"t":"son","s":["H1121"],"a":[1]},{"t":" of "},{"t":"Zeruiah","s":["H6870"],"a":[2]},{"t":" struck down the "},{"t":"Edomites","s":["H0123"],"a":[5]},{"t":" in the "},{"t":"Valley","s":["H1516"],"a":[6]},{"t":" of "},{"t":"Salt","s":["H4417"],"a":[7]},{"t":", that is, "},{"t":"eighteen","s":["H8083"],"a":[8]},{"t":" "},{"t":"thousand","s":["H0505"],"a":[10]},{"t":" men."}]},{"n":13,"text":"And he put garrisons in Edom, and all the Edomites became servants to David. And Jehovah preserved David wherever he went.","tok":[{"t":"And he "},{"t":"put","s":["H7760"],"a":[0]},{"t":" "},{"t":"garrisons","s":["H5333"],"a":[2]},{"t":" in "},{"t":"Edom","s":["H0123"],"a":[1]},{"t":", and all the "},{"t":"Edomites","s":["H0123"],"a":[5]},{"t":" "},{"t":"became","s":["H1732"],"a":[7]},{"t":" "},{"t":"servants","s":["H5650"],"a":[6]},{"t":" to David. And "},{"t":"Jehovah","s":["H3068"],"a":[9]},{"t":" "},{"t":"preserved","s":["H3467"],"a":[8]},{"t":" "},{"t":"David","s":["H1732"],"a":[11]},{"t":" wherever he "},{"t":"went","s":["H1980"],"a":[14]},{"t":"."}]},{"n":14,"text":"So David reigned over all Israel and executed justice and righteousness for all his people.","tok":[{"t":"So "},{"t":"David","s":["H1732"],"a":[1]},{"t":" "},{"t":"reigned","s":["H4427"],"a":[0]},{"t":" over all "},{"t":"Israel","s":["H3478"],"a":[4]},{"t":" and "},{"t":"executed","s":["H6213"],"a":[6]},{"t":" "},{"t":"justice","s":["H6666"],"a":[8]},{"t":" and righteousness for all his "},{"t":"people","s":["H5971"],"a":[10]},{"t":"."}]},{"n":15,"text":"And Joab the son of Zeruiah was over the army, and Jehoshaphat the son of Ahilud was recorder.","tok":[{"t":"And "},{"t":"Joab","s":["H3097"],"a":[0]},{"t":" the "},{"t":"son","s":["H1121"],"a":[1]},{"t":" of "},{"t":"Zeruiah","s":["H6870"],"a":[2]},{"t":" was over the army, and "},{"t":"Jehoshaphat","s":["H3092"],"a":[5]},{"t":" the "},{"t":"son","s":["H1121"],"a":[6]},{"t":" of "},{"t":"Ahilud","s":["H0286"],"a":[7]},{"t":" was "},{"t":"recorder","s":["H2142"],"a":[8]},{"t":"."}]},{"n":16,"text":"And Zadok the son of Ahitub and Abimelech the son of Abiathar were priests, and Shavsha was scribe.","tok":[{"t":"And "},{"t":"Zadok","s":["H6659"],"a":[0]},{"t":" the "},{"t":"son","s":["H1121"],"a":[1]},{"t":" of "},{"t":"Ahitub","s":["H0285"],"a":[2]},{"t":" and "},{"t":"Abimelech","s":["H0040"],"a":[3]},{"t":" the "},{"t":"son","s":["H1121"],"a":[4]},{"t":" of "},{"t":"Abiathar","s":["H0054"],"a":[5]},{"t":" were "},{"t":"priests","s":["H3548"],"a":[6]},{"t":", and "},{"t":"Shavsha","s":["H7798"],"a":[7]},{"t":" was "},{"t":"scribe","s":["H5608"],"a":[8]},{"t":"."}]},{"n":17,"text":"And Benaiah the son of Jehoiada was over the Cherethites and the Pelethites, and David’s sons were chief at the king’s side.","tok":[{"t":"And "},{"t":"Benaiah","s":["H1141"],"a":[0]},{"t":" the "},{"t":"son","s":["H1121"],"a":[1]},{"t":" of "},{"t":"Jehoiada","s":["H3077"],"a":[2]},{"t":" was over the "},{"t":"Cherethites","s":["H3774"],"a":[4]},{"t":" and the "},{"t":"Pelethites","s":["H6432"],"a":[5]},{"t":", and David’s "},{"t":"sons","s":["H1121"],"a":[6]},{"t":" "},{"t":"were","s":["H1732"],"a":[7]},{"t":" "},{"t":"chief","s":["H7223"],"a":[8]},{"t":" at the king’s side."}]}]}
