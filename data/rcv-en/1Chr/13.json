{"v":1,"book":"1Chr","ch":13,"verses":[{"n":1,"text":"And David took counsel with the captains of the thousands and of the hundreds, with every leader.","tok":[{"t":"And "},{"t":"David","s":["H1732"],"a":[1]},{"t":" took counsel with the "},{"t":"captains","s":["H8269"],"a":[3]},{"t":" of the "},{"t":"thousands","s":["H0505"],"a":[4]},{"t":" and of the "},{"t":"hundreds","s":["H3967"],"a":[5]},{"t":", with every "},{"t":"leader","s":["H5057"],"a":[7]},{"t":"."}]},{"n":2,"text":"And David said to all the congregation of Israel, If it seems good to you, and it is from Jehovah our God, let us send far and wide to our brothers who remain in all the land of Israel and to the priests and the Levites who are with them in their cities with pasture lands, that they may gather themselves to us.","tok":[{"t":"And "},{"t":"David","s":["H1732"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to all the "},{"t":"congregation","s":["H6951"],"a":[3]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[4]},{"t":", If it seems "},{"t":"good","s":["H2895"]},{"t":" to you, and it is from "},{"t":"Jehovah","s":["H3068"],"a":[9]},{"t":" our "},{"t":"God","s":["H0430"],"a":[10]},{"t":", let us "},{"t":"send","s":["H7971"],"a":[12]},{"t":" far and wide to our "},{"t":"brothers","s":["H0251"],"a":[14]},{"t":" who remain in all the "},{"t":"land","s":["H0776"],"a":[17]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[18]},{"t":" and to the "},{"t":"priests","s":["H3548"],"a":[20]},{"t":" and the "},{"t":"Levites","s":["H3881"],"a":[21]},{"t":" who are with them in their "},{"t":"cities","s":["H5892"],"a":[22]},{"t":" with pasture lands, that they may "},{"t":"gather","s":["H6908"],"a":[24]},{"t":" themselves to us."}]},{"n":3,"text":"And let us bring back the Ark of our God to ourselves, for we did not inquire of it in the days of Saul.","tok":[{"t":"And let us bring back the "},{"t":"Ark","s":["H0727"],"a":[2]},{"t":" of our "},{"t":"God","s":["H0430"],"a":[3]},{"t":" to ourselves, for we did not inquire of it in the "},{"t":"days","s":["H3117"],"a":[8]},{"t":" of "},{"t":"Saul","s":["H7586"],"a":[9]},{"t":"."}]},{"n":4,"text":"And all the congregation said that they would do so, for the matter was right in the sight of all the people.","tok":[{"t":"And all the "},{"t":"congregation","s":["H6951"],"a":[2]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" that they would do "},{"t":"so","s":["H6213"],"a":[3]},{"t":", for the "},{"t":"matter","s":["H1697"],"a":[7]},{"t":" was "},{"t":"right","s":["H3474"],"a":[6]},{"t":" in the sight of all the "},{"t":"people","s":["H5971"],"a":[10]},{"t":"."}]},{"n":5,"text":"And David gathered all Israel together from the Shihor of Egypt even to the entrance of Hamath to bring the Ark of God from Kiriath-jearim.","tok":[{"t":"And "},{"t":"David","s":["H1732"],"a":[1]},{"t":" "},{"t":"gathered","s":["H6950"],"a":[0]},{"t":" all "},{"t":"Israel","s":["H3478"],"a":[4]},{"t":" "},{"t":"together","s":["H6950"]},{"t":" from the "},{"t":"Shihor","s":["H7883"],"a":[6]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[7]},{"t":" even to the entrance of Hamath to "},{"t":"bring","s":["H0935"],"a":[11]},{"t":" the "},{"t":"Ark","s":["H0727"],"a":[13]},{"t":" of "},{"t":"God","s":["H0430"],"a":[14]},{"t":" from "},{"t":"Kiriath","s":["H7157"],"a":[15]},{"t":"-"},{"t":"jearim","s":["H7157"],"a":[15]},{"t":"."}]},{"n":6,"text":"And David went up with all Israel to Baalah, that is, to Kiriath-jearim, which is Judah’s, to bring up from there the Ark of God, of Jehovah, who is enthroned between the cherubim, which is called by the Name;","tok":[{"t":"And "},{"t":"David","s":["H1732"],"a":[1]},{"t":" went "},{"t":"up","s":["H5927"],"a":[0]},{"t":" with all "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":" to "},{"t":"Baalah","s":["H1173"],"a":[4]},{"t":", that is, to "},{"t":"Kiriath","s":["H7157"],"a":[6]},{"t":"-"},{"t":"jearim","s":["H7157"],"a":[6]},{"t":", which is Judah’s, to bring "},{"t":"up","s":["H5927"],"a":[10]},{"t":" from there the "},{"t":"Ark","s":["H0727"],"a":[13]},{"t":" of "},{"t":"God","s":["H0430"],"a":[14]},{"t":", of "},{"t":"Jehovah","s":["H3068"],"a":[15]},{"t":", who is enthroned between the "},{"t":"cherubim","s":["H3742"],"a":[17]},{"t":", which is "},{"t":"called","s":["H7121"],"a":[19]},{"t":" by the "},{"t":"Name","s":["H8034"],"a":[20]},{"t":";"}]},{"n":7,"text":"And they set the Ark of God upon a new cart from the house of Abinadab, and Uzzah and Ahio drove the cart.","tok":[{"t":"And they set the "},{"t":"Ark","s":["H0727"],"a":[2]},{"t":" of "},{"t":"God","s":["H0430"],"a":[3]},{"t":" upon a "},{"t":"new","s":["H2319"],"a":[6]},{"t":" "},{"t":"cart","s":["H5699"],"a":[5]},{"t":" from the "},{"t":"house","s":["H1004"],"a":[7]},{"t":" of "},{"t":"Abinadab","s":["H0041"],"a":[8]},{"t":", and "},{"t":"Uzzah","s":["H5798"],"a":[9]},{"t":" and "},{"t":"Ahio","s":["H0283"],"a":[10]},{"t":" "},{"t":"drove","s":["H5090"],"a":[11]},{"t":" the "},{"t":"cart","s":["H5699"],"a":[12]},{"t":"."}]},{"n":8,"text":"And David and all Israel played before God with all their strength, even with songs and with lyres and with harps and with tambourines and with cymbals and with trumpets.","tok":[{"t":"And "},{"t":"David","s":["H1732"],"a":[0]},{"t":" and all "},{"t":"Israel","s":["H3478"],"a":[2]},{"t":" "},{"t":"played","s":["H7832"],"a":[3]},{"t":" "},{"t":"before","s":["H6440"],"a":[4]},{"t":" "},{"t":"God","s":["H0430"],"a":[5]},{"t":" with all their strength, even with songs and with lyres and with "},{"t":"harps","s":["H3658"],"a":[9]},{"t":" and with tambourines and with "},{"t":"cymbals","s":["H4700"],"a":[12]},{"t":" and with "},{"t":"trumpets","s":["H2689"],"a":[13]},{"t":"."}]},{"n":9,"text":"And when they came to Chidon’s threshing floor, Uzzah stretched out his hand to take hold of the Ark; for the oxen had stumbled.","tok":[{"t":"And when they "},{"t":"came","s":["H0935"],"a":[0]},{"t":" to Chidon’s threshing floor, Uzzah stretched out his "},{"t":"hand","s":["H3027"],"a":[7]},{"t":" to take "},{"t":"hold","s":["H0270"],"a":[8]},{"t":" of the "},{"t":"Ark","s":["H0727"],"a":[10]},{"t":"; for the "},{"t":"oxen","s":["H1241"],"a":[13]},{"t":" had "},{"t":"stumbled","s":["H8058"],"a":[12]},{"t":"."}]},{"n":10,"text":"And the anger of Jehovah was kindled against Uzzah, and He struck him because he stretched out his hand to the Ark; and he died there before God.","tok":[{"t":"And the "},{"t":"anger","s":["H0639"],"a":[1]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" was "},{"t":"kindled","s":["H2734"],"a":[0]},{"t":" against Uzzah, and He struck him because he stretched out his "},{"t":"hand","s":["H3027"],"a":[8]},{"t":" to the "},{"t":"Ark","s":["H0727"],"a":[10]},{"t":"; and he "},{"t":"died","s":["H4191"],"a":[11]},{"t":" there "},{"t":"before","s":["H6440"],"a":[13]},{"t":" "},{"t":"God","s":["H0430"],"a":[14]},{"t":"."}]},{"n":11,"text":"And David was angry because Jehovah had broken forth with an outburst upon Uzzah, and he called that place Perez-uzzah, as it is to this day.","tok":[{"t":"And "},{"t":"David","s":["H1732"],"a":[1]},{"t":" was angry because "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" had broken forth with an outburst upon Uzzah, and he "},{"t":"called","s":["H7121"],"a":[7]},{"t":" that "},{"t":"place","s":["H4725"],"a":[8]},{"t":" "},{"t":"Perez","s":["H6560"],"a":[10]},{"t":"-"},{"t":"uzzah","s":["H6560"],"a":[10]},{"t":", as it is to this "},{"t":"day","s":["H3117"],"a":[13]},{"t":"."}]},{"n":12,"text":"And David was afraid of God that day, saying, How shall I bring the Ark of God to myself?","tok":[{"t":"And "},{"t":"David","s":["H1732"],"a":[1]},{"t":" was "},{"t":"afraid","s":["H3372"],"a":[0]},{"t":" of "},{"t":"God","s":["H0430"],"a":[3]},{"t":" that "},{"t":"day","s":["H3117"],"a":[4]},{"t":", "},{"t":"saying","s":["H0559"],"a":[6]},{"t":", "},{"t":"How","s":["H1963"],"a":[7]},{"t":" shall I "},{"t":"bring","s":["H0935"],"a":[8]},{"t":" the "},{"t":"Ark","s":["H0727"],"a":[11]},{"t":" of "},{"t":"God","s":["H0430"],"a":[12]},{"t":" to myself?"}]},{"n":13,"text":"So David did not remove the Ark to himself to the city of David, but he carried it aside into the house of Obed-edom the Gittite.","tok":[{"t":"So "},{"t":"David","s":["H1732"],"a":[2]},{"t":" did not remove the "},{"t":"Ark","s":["H0727"],"a":[4]},{"t":" to himself to the "},{"t":"city","s":["H5892"],"a":[7]},{"t":" of "},{"t":"David","s":["H1732"],"a":[8]},{"t":", but he carried it "},{"t":"aside","s":["H5186"],"a":[9]},{"t":" into the "},{"t":"house","s":["H1004"],"a":[11]},{"t":" of "},{"t":"Obed","s":["H5654"],"a":[12]},{"t":"-"},{"t":"edom","s":["H5654"],"a":[12]},{"t":" the "},{"t":"Gittite","s":["H1663"],"a":[14]},{"t":"."}]},{"n":14,"text":"And the Ark of God remained with the house of Obed-edom in his house three months, and Jehovah blessed the house of Obed-edom and all that he had.","tok":[{"t":"And the "},{"t":"Ark","s":["H0727"],"a":[1]},{"t":" of "},{"t":"God","s":["H0430"],"a":[2]},{"t":" "},{"t":"remained","s":["H3427"],"a":[0]},{"t":" with the "},{"t":"house","s":["H1004"],"a":[4]},{"t":" of "},{"t":"Obed","s":["H5654"],"a":[5]},{"t":"-"},{"t":"edom","s":["H5654"],"a":[5]},{"t":" in his "},{"t":"house","s":["H1004"],"a":[7]},{"t":" "},{"t":"three","s":["H7969"],"a":[8]},{"t":" "},{"t":"months","s":["H2320"],"a":[9]},{"t":", and "},{"t":"Jehovah","s":["H3068"],"a":[11]},{"t":" "},{"t":"blessed","s":["H1288"],"a":[10]},{"t":" the "},{"t":"house","s":["H1004"],"a":[13]},{"t":" of "},{"t":"Obed","s":["H5654"],"a":[6]},{"t":"-"},{"t":"edom","s":["H5654"],"a":[6]},{"t":" and all that he had."}]}]}
