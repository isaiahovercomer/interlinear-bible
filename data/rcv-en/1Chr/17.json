ever","s":["H5769"],"a":[8]},{"t":"."}]},{"n":13,"text":"I will be his Father, and he will be My son; and My lovingkindness I will not take from him, as I took it away from him who was before you.","tok":[{"t":"I will be his "},{"t":"Father","s":["H0001"],"a":[3]},{"t":", and he will be My "},{"t":"son","s":["H1121"],"a":[7]},{"t":"; and My lovingkindness I will not "},{"t":"take","s":["H5493"],"a":[10]},{"t":" from him, as I "},{"t":"took","s":["H5493"]},{"t":" it "},{"t":"away","s":["H5493"],"a":[13]},{"t":" from "},{"t":"him","s":["H5493"]},{"t":" who was "},{"t":"before","s":["H6440"],"a":[16]},{"t":" you."}]},{"n":14,"text":"And I will set him in My house and My kingdom forever, and his throne will be established forever.","tok":[{"t":"And I will set him in My "},{"t":"house","s":["H1004"],"a":[1]},{"t":" and My "},{"t":"kingdom","s":["H4438"],"a":[2]},{"t":" forever, and his "},{"t":"throne","s":["H3678"],"a":[5]},{"t":" will be "},{"t":"established","s":["H3559"],"a":[7]},{"t":" "},{"t":"forever","s":["H5769"],"a":[9]},{"t":"."}]},{"n":15,"text":"According to all these words and according to this whole vision did Nathan speak to David.","tok":[{"t":"According to all these "},{"t":"words","s":["H1697"],"a":[1]},{"t":" and according to this whole "},{"t":"vision","s":["H2377"],"a":[4]},{"t":" did "},{"t":"Nathan","s":["H5416"],"a":[8]},{"t":" "},{"t":"speak","s":["H1696"],"a":[7]},{"t":" to "},{"t":"David","s":["H1732"],"a":[10]},{"t":"."}]},{"n":16,"text":"Then King David went and sat before Jehovah; and he said, Who am I, O Jehovah God, and what is my house that You have brought me this far?","tok":[{"t":"Then","s":["H1732"],"a":[2]},{"t":" "},{"t":"King","s":["H4428"],"a":[1]},{"t":" "},{"t":"David","s":["H1732"],"a":[2]},{"t":" went and "},{"t":"sat","s":["H3427"],"a":[3]},{"t":" "},{"t":"before","s":["H6440"],"a":[4]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":"; and he "},{"t":"said","s":["H0559"],"a":[6]},{"t":", Who am I, O "},{"t":"Jehovah","