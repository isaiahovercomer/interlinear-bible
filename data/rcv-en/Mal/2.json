{"v":1,"book":"Mal","ch":2,"verses":[{"n":1,"text":"And now this commandment is for you, O priests.","tok":[{"t":"And "},{"t":"now","s":["H3548"],"a":[4]},{"t":" this "},{"t":"commandment","s":["H4687"],"a":[2]},{"t":" is for you, O "},{"t":"priests","s":["H3548"],"a":[4]},{"t":"."}]},{"n":2,"text":"If you will not hear and take it to heart to give glory to My name, says Jehovah of hosts, I will send the curse among you, and I will curse your blessings; indeed I have cursed them already because you have not taken it to heart.","tok":[{"t":"If you will not "},{"t":"hear","s":["H8085"],"a":[2]},{"t":" and "},{"t":"take","s":["H7760"],"a":[5]},{"t":" it to "},{"t":"heart","s":["H3820"],"a":[7]},{"t":" to "},{"t":"give","s":["H5414"],"a":[8]},{"t":" "},{"t":"glory","s":["H3519"],"a":[9]},{"t":" to My "},{"t":"name","s":["H8034"],"a":[10]},{"t":", "},{"t":"says","s":["H0559"],"a":[11]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[12]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[13]},{"t":", I will "},{"t":"send","s":["H7971"],"a":[14]},{"t":" the "},{"t":"curse","s":["H3994"],"a":[17]},{"t":" among you, and I will "},{"t":"curse","s":["H0779"],"a":[18]},{"t":" your "},{"t":"blessings","s":["H1293"],"a":[20]},{"t":"; indeed I have "},{"t":"cursed","s":["H0779"],"a":[22]},{"t":" them already because you have not taken it to "},{"t":"heart","s":["H3820"],"a":[27]},{"t":"."}]},{"n":3,"text":"I will rebuke your seed and spread dung upon your faces, the dung of your feasts; and they will take you away with it.","tok":[{"t":"I will rebuke your "},{"t":"seed","s":["H2233"],"a":[4]},{"t":" and "},{"t":"spread","s":["H2219"],"a":[5]},{"t":" "},{"t":"dung","s":["H6569"],"a":[6]},{"t":" upon your "},{"t":"faces","s":["H6440"],"a":[8]},{"t":", the "},{"t":"dung","s":["H6569"],"a":[9]},{"t":" of your "},{"t":"feasts","s":["H2282"],"a":[10]},{"t":"; and they will take you "},{"t":"away","s":["H5375"],"a":[11]},{"t":" with it."}]},{"n":4,"text":"And you will know that I have sent this commandment to you, that My covenant may remain with Levi, says Jehovah of hosts.","tok":[{"t":"And you will "},{"t":"know","s":["H3045"],"a":[0]},{"t":" that I have "},{"t":"sent","s":["H7971"],"a":[2]},{"t":" this "},{"t":"commandment","s":["H4687"],"a":[5]},{"t":" to you, that My "},{"t":"covenant","s":["H1285"],"a":[8]},{"t":" may remain with "},{"t":"Levi","s":["H3878"],"a":[10]},{"t":", "},{"t":"says","s":["H0559"],"a":[11]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[12]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[13]},{"t":"."}]},{"n":5,"text":"My covenant was with him as life and peace; and I gave these to him that he might fear; and he did fear Me, and he did stand in awe of My name.","tok":[{"t":"My "},{"t":"covenant","s":["H1285"],"a":[0]},{"t":" was with him as "},{"t":"life","s":["H2416"],"a":[3]},{"t":" and "},{"t":"peace","s":["H7965"],"a":[4]},{"t":"; and I "},{"t":"gave","s":["H5414"],"a":[5]},{"t":" these to him that he might "},{"t":"fear","s":["H3372"],"a":[8]},{"t":"; and he did "},{"t":"fear","s":["H4172"],"a":[7]},{"t":" Me, and he did stand in awe of My "},{"t":"name","s":["H8034"],"a":[10]},{"t":"."}]},{"n":6,"text":"The law of truth was in his mouth, and no wrong was found in his lips; in peace and uprightness he walked with Me, and he turned many away from iniquity.","tok":[{"t":"The "},{"t":"law","s":["H8451"],"a":[0]},{"t":" of "},{"t":"truth","s":["H0571"],"a":[1]},{"t":" was in his "},{"t":"mouth","s":["H6310"],"a":[3]},{"t":", and no wrong was "},{"t":"found","s":["H4672"],"a":[6]},{"t":" in his "},{"t":"lips","s":["H8193"],"a":[7]},{"t":"; in "},{"t":"peace","s":["H7965"],"a":[8]},{"t":" and uprightness he "},{"t":"walked","s":["H1980"],"a":[10]},{"t":" with Me, and he "},{"t":"turned","s":["H7725"],"a":[13]},{"t":" "},{"t":"many","s":["H7227"],"a":[12]},{"t":" "},{"t":"away","s":["H7725"]},{"t":" from "},{"t":"iniquity","s":["H5771"],"a":[14]},{"t":"."}]},{"n":7,"text":"For the priest’s lips should keep knowledge, and men should seek instruction from his mouth, for he is the messenger of Jehovah of hosts.","tok":[{"t":"For the "},{"t":"priest’s","s":["H3548"],"a":[2]},{"t":" "},{"t":"lips","s":["H8193"],"a":[1]},{"t":" should "},{"t":"keep","s":["H8104"],"a":[3]},{"t":" "},{"t":"knowledge","s":["H1847"],"a":[4]},{"t":", and men should "},{"t":"seek","s":["H1245"],"a":[6]},{"t":" instruction from his "},{"t":"mouth","s":["H6310"],"a":[7]},{"t":", for he is the "},{"t":"messenger","s":["H4397"],"a":[9]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[11]},{"t":"."}]},{"n":8,"text":"But you have turned away from the way; you have caused many to stumble at the law; you have corrupted the covenant of Levi, says Jehovah of hosts.","tok":[{"t":"But you have turned away from the "},{"t":"way","s":["H1870"],"a":[3]},{"t":"; you have caused "},{"t":"many","s":["H7227"],"a":[5]},{"t":" to "},{"t":"stumble","s":["H3782"],"a":[4]},{"t":" at the "},{"t":"law","s":["H8451"],"a":[6]},{"t":"; you have "},{"t":"corrupted","s":["H7843"],"a":[7]},{"t":" the "},{"t":"covenant","s":["H1285"],"a":[8]},{"t":" of "},{"t":"Levi","s":["H3878"],"a":[9]},{"t":", "},{"t":"says","s":["H0559"],"a":[10]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[11]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[12]},{"t":"."}]},{"n":9,"text":"Therefore I also have made you despicable and base before all the people to the same extent that you have not kept My ways but have been respecters of persons in the law.","tok":[{"t":"Therefore I also have "},{"t":"made","s":["H5414"],"a":[2]},{"t":" you despicable and "},{"t":"base","s":["H8217"],"a":[5]},{"t":" before all the "},{"t":"people","s":["H5971"],"a":[7]},{"t":" to the same extent that you have not "},{"t":"kept","s":["H8104"],"a":[11]},{"t":" My "},{"t":"ways","s":["H1870"],"a":[13]},{"t":" but have been respecters of persons in the "},{"t":"law","s":["H8451"],"a":[16]},{"t":"."}]},{"n":10,"text":"Have we not all one Father? Has not one God created us? Why are we treacherous, each one to his brother, thus profaning the covenant of our fathers?","tok":[{"t":"Have we not all "},{"t":"one","s":["H0259"],"a":[2]},{"t":" "},{"t":"Father","s":["H0001"],"a":[1]},{"t":"? Has not "},{"t":"one","s":["H0259"],"a":[6]},{"t":" "},{"t":"God","s":["H0410"],"a":[5]},{"t":" "},{"t":"created","s":["H1254"],"a":[7]},{"t":" us? Why are we treacherous, each one to his "},{"t":"brother","s":["H0251"],"a":[11]},{"t":", thus "},{"t":"profaning","s":["H2490"],"a":[12]},{"t":" the "},{"t":"covenant","s":["H1285"],"a":[13]},{"t":" of our "},{"t":"fathers","s":["H0001"],"a":[14]},{"t":"?"}]},{"n":11,"text":"Judah has been treacherous, and an abomination has been done in Israel and in Jerusalem; for Judah has profaned the sanctuary of Jehovah, which He loves, and has married the daughter of a foreign god.","tok":[{"t":"Judah","s":["H3063"],"a":[1]},{"t":" has been treacherous, and an "},{"t":"abomination","s":["H8441"],"a":[2]},{"t":" has been done in "},{"t":"Israel","s":["H3478"],"a":[4]},{"t":" and in "},{"t":"Jerusalem","s":["H3389"],"a":[5]},{"t":"; for "},{"t":"Judah","s":["H3063"],"a":[8]},{"t":" has "},{"t":"profaned","s":["H2490"],"a":[7]},{"t":" the "},{"t":"sanctuary","s":["H6944"],"a":[9]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":", which He "},{"t":"loves","s":["H0157"],"a":[12]},{"t":", and has "},{"t":"married","s":["H1166"],"a":[13]},{"t":" the "},{"t":"daughter","s":["H1323"],"a":[14]},{"t":" of a "},{"t":"foreign","s":["H5236"],"a":[16]},{"t":" "},{"t":"god","s":["H0410"],"a":[15]},{"t":"."}]},{"n":12,"text":"As regards the man who does this, Jehovah will cut off from the tents of Jacob him who wakes and him who answers and him who offers a sacrifice to Jehovah of hosts.","tok":[{"t":"As regards the "},{"t":"man","s":["H0376"],"a":[2]},{"t":" who does this, "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" will cut "},{"t":"off","s":["H3772"],"a":[0]},{"t":" from the tents of "},{"t":"Jacob","s":["H3290"],"a":[8]},{"t":" him who wakes and him who answers and him who "},{"t":"offers","s":["H4503"],"a":[10]},{"t":" a sacrifice to "},{"t":"Jehovah","s":["H3068"],"a":[11]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[12]},{"t":"."}]},{"n":13,"text":"And this second thing you do: You cover the altar of Jehovah with tears, with weeping and sighing, so that He no longer regards the sacrifice or receives it with pleasure from your hand.","tok":[{"t":"And this second thing you do: You "},{"t":"cover","s":["H3680"],"a":[3]},{"t":" the "},{"t":"altar","s":["H4196"],"a":[6]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[7]},{"t":" with "},{"t":"tears","s":["H1832"],"a":[4]},{"t":", with "},{"t":"weeping","s":["H1065"],"a":[8]},{"t":" and sighing, so that He no longer "},{"t":"regards","s":["H6437"],"a":[12]},{"t":" the "},{"t":"sacrifice","s":["H4503"],"a":[14]},{"t":" or "},{"t":"receives","s":["H3947"],"a":[15]},{"t":" it with pleasure from your "},{"t":"hand","s":["H3027"],"a":[17]},{"t":"."}]},{"n":14,"text":"Yet you say, For what reason? Because Jehovah has been the witness between you and the wife of your youth, to whom you have been treacherous; yet she is your companion and your wife of covenant.","tok":[{"t":"Yet you "},{"t":"say","s":["H0559"],"a":[0]},{"t":", For what reason? Because "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":" has been the "},{"t":"witness","s":["H5749"],"a":[6]},{"t":" between you and the "},{"t":"wife","s":["H0802"],"a":[9]},{"t":" of your "},{"t":"youth","s":["H5271"],"a":[10]},{"t":", to whom you have been treacherous; yet she is your "},{"t":"companion","s":["H2278"],"a":[16]},{"t":" and your "},{"t":"wife","s":["H0802"],"a":[17]},{"t":" of "},{"t":"covenant","s":["H1285"],"a":[18]},{"t":"."}]},{"n":15,"text":"But did He not make them one? And the remnant of the Spirit was His. And why the one? He sought the seed of God. Take heed then to your spirit, and let no one be treacherous to the wife of his youth.","tok":[{"t":"But did He not "},{"t":"make","s":["H6213"],"a":[2]},{"t":" them "},{"t":"one","s":["H0259"],"a":[1]},{"t":"? And the "},{"t":"remnant","s":["H7605"],"a":[3]},{"t":" of the "},{"t":"Spirit","s":["H7307"],"a":[4]},{"t":" was His. And why the "},{"t":"one","s":["H0259"],"a":[7]},{"t":"? He sought the "},{"t":"seed","s":["H2233"],"a":[9]},{"t":" of "},{"t":"God","s":["H0430"],"a":[10]},{"t":". "},{"t":"Take","s":["H2233"],"a":[9]},{"t":" "},{"t":"heed","s":["H8104"],"a":[11]},{"t":" then to your "},{"t":"spirit","s":["H7307"],"a":[12]},{"t":", and let no one be treacherous to the "},{"t":"wife","s":["H0802"],"a":[13]},{"t":" of his "},{"t":"youth","s":["H5271"],"a":[14]},{"t":"."}]},{"n":16,"text":"For I hate divorce, says Jehovah the God of Israel; and he who does it behaves in violence, says Jehovah of hosts. Take heed then to your spirit, and do not be treacherous.","tok":[{"t":"For I "},{"t":"hate","s":["H8130"],"a":[1]},{"t":" divorce, "},{"t":"says","s":["H0559"],"a":[3]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" the "},{"t":"God","s":["H0430"],"a":[5]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[6]},{"t":"; and he who does it behaves in "},{"t":"violence","s":["H2555"],"a":[8]},{"t":", "},{"t":"says","s":["H0559"],"a":[11]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[12]},{"t":" of "},{"t":"hosts","s":["H6635"],"a":[13]},{"t":". Take "},{"t":"heed","s":["H8104"],"a":[14]},{"t":" then to your "},{"t":"spirit","s":["H7307"],"a":[15]},{"t":", and do not be treacherous."}]},{"n":17,"text":"You have wearied Jehovah with your words; but you say, How have we wearied Him? By saying, Everyone who does evil is good in the sight of Jehovah, and He delights in them; or, Where is the God of justice?","tok":[{"t":"You have "},{"t":"wearied","s":["H3021"],"a":[0]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" with your "},{"t":"words","s":["H1697"],"a":[2]},{"t":"; but you "},{"t":"say","s":["H0559"],"a":[3]},{"t":", How have we "},{"t":"wearied","s":["H3021"],"a":[5]},{"t":" Him? By "},{"t":"saying","s":["H0559"],"a":[6]},{"t":", Everyone who does "},{"t":"evil","s":["H7451"],"a":[9]},{"t":" is "},{"t":"good","s":["H2896"],"a":[10]},{"t":" in the "},{"t":"sight","s":["H5869"],"a":[11]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[12]},{"t":", and He "},{"t":"delights","s":["H2654"],"a":[15]},{"t":" in them; or, Where is the "},{"t":"God","s":["H0430"],"a":[18]},{"t":" of "},{"t":"justice","s":["H4941"],"a":[19]},{"t":"?"}]}]}
