{"v":1,"book":"Deut","ch":18,"verses":[{"n":1,"text":"The Levitical priests and the whole tribe of Levi shall have no portion or inheritance with Israel; they shall eat Jehovah’s offerings by fire and His inheritance.","tok":[{"t":"The Levitical "},{"t":"priests","s":["H3548"],"a":[2]},{"t":" and the "},{"t":"whole","s":["H3881"],"a":[3]},{"t":" "},{"t":"tribe","s":["H7626"],"a":[5]},{"t":" of "},{"t":"Levi","s":["H3878"],"a":[6]},{"t":" shall have no portion or "},{"t":"inheritance","s":["H5159"],"a":[8]},{"t":" with "},{"t":"Israel","s":["H3478"],"a":[10]},{"t":"; they shall "},{"t":"eat","s":["H0398"],"a":[14]},{"t":" Jehovah’s "},{"t":"offerings","s":["H0801"],"a":[11]},{"t":" by "},{"t":"fire","s":["H0801"]},{"t":" and His "},{"t":"inheritance","s":["H5159"],"a":[13]},{"t":"."}]},{"n":2,"text":"Thus they shall have no inheritance in the midst of their brothers; Jehovah is their inheritance, as He has promised them.","tok":[{"t":"Thus they shall have no "},{"t":"inheritance","s":["H5159"],"a":[0]},{"t":" in the midst of their "},{"t":"brothers","s":["H0251"],"a":[5]},{"t":"; "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" is their "},{"t":"inheritance","s":["H5159"],"a":[8]},{"t":", as He has promised them."}]},{"n":3,"text":"And this shall be the priests’ rightful due from the people, from those who offer a sacrifice, whether an ox or a sheep: They shall give the priest the shoulder, the two cheeks, and the stomach.","tok":[{"t":"And this shall be the priests’ rightful "},{"t":"due","s":["H4941"],"a":[2]},{"t":" from the "},{"t":"people","s":["H5971"],"a":[5]},{"t":", from those who "},{"t":"offer","s":["H2076"],"a":[7]},{"t":" a "},{"t":"sacrifice","s":["H2077"],"a":[8]},{"t":", whether an "},{"t":"ox","s":["H7794"],"a":[10]},{"t":" or a "},{"t":"sheep","s":["H7716"],"a":[12]},{"t":": They shall "},{"t":"give","s":["H5414"],"a":[13]},{"t":" the "},{"t":"priest","s":["H3548"],"a":[14]},{"t":" the "},{"t":"shoulder","s":["H2220"],"a":[15]},{"t":", the two "},{"t":"cheeks","s":["H3895"],"a":[16]},{"t":", and the "},{"t":"stomach","s":["H6896"],"a":[17]},{"t":"."}]},{"n":4,"text":"You shall give him the firstfruits of your grain, of your new wine, and of your fresh oil, and the first shearing of your sheep;","tok":[{"t":"You shall give him the "},{"t":"firstfruits","s":["H7225"],"a":[0]},{"t":" of your grain, of your new "},{"t":"wine","s":["H8492"],"a":[2]},{"t":", and of your fresh "},{"t":"oil","s":["H3323"],"a":[3]},{"t":", and the "},{"t":"first","s":["H7225"],"a":[4]},{"t":" shearing of your "},{"t":"sheep","s":["H6629"],"a":[6]},{"t":";"}]},{"n":5,"text":"For Jehovah your God has chosen him and his sons out of all your tribes to stand and minister in Jehovah’s name always.","tok":[{"t":"For "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" your "},{"t":"God","s":["H0430"],"a":[4]},{"t":" has "},{"t":"chosen","s":["H0977"],"a":[2]},{"t":" him and his "},{"t":"sons","s":["H1121"],"a":[12]},{"t":" out of all your "},{"t":"tribes","s":["H7626"],"a":[6]},{"t":" to "},{"t":"stand","s":["H5975"],"a":[7]},{"t":" and "},{"t":"minister","s":["H8334"],"a":[8]},{"t":" in Jehovah’s "},{"t":"name","s":["H8034"],"a":[9]},{"t":" always."}]},{"n":6,"text":"And if a Levite comes from any of your gates out of all Israel, where he sojourns, and comes according to all his soul’s desire to the place which Jehovah will choose,","tok":[{"t":"And if a "},{"t":"Levite","s":["H3881"],"a":[2]},{"t":" "},{"t":"comes","s":["H0935"],"a":[1]},{"t":" from "},{"t":"any","s":["H0259"],"a":[3]},{"t":" of your "},{"t":"gates","s":["H8179"],"a":[4]},{"t":" out of all "},{"t":"Israel","s":["H3478"],"a":[6]},{"t":", where he "},{"t":"sojourns","s":["H1481"],"a":[9]},{"t":", and "},{"t":"comes","s":["H0935"],"a":[11]},{"t":" according to all his soul’s "},{"t":"desire","s":["H0185"],"a":[13]},{"t":" to the "},{"t":"place","s":["H4725"],"a":[16]},{"t":" which "},{"t":"Jehovah","s":["H3068"],"a":[19]},{"t":" will "},{"t":"choose","s":["H0977"],"a":[18]},{"t":","}]},{"n":7,"text":"He shall minister in the name of Jehovah his God, like all his brothers, the Levites, who stand there before Jehovah.","tok":[{"t":"He shall "},{"t":"minister","s":["H8334"],"a":[0]},{"t":" in the "},{"t":"name","s":["H8034"],"a":[1]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" his "},{"t":"God","s":["H0430"],"a":[3]},{"t":", like all his "},{"t":"brothers","s":["H0251"],"a":[5]},{"t":", the "},{"t":"Levites","s":["H3881"],"a":[6]},{"t":", who "},{"t":"stand","s":["H5975"],"a":[7]},{"t":" there "},{"t":"before","s":["H6440"],"a":[9]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":"."}]},{"n":8,"text":"They shall eat equal portions, besides the proceeds from the sale of his father’s estate.","tok":[{"t":"They shall "},{"t":"eat","s":["H0398"],"a":[2]},{"t":" equal "},{"t":"portions","s":["H2506"],"a":[0]},{"t":", besides the proceeds from the "},{"t":"sale","s":["H4465"],"a":[4]},{"t":" of his father’s estate."}]},{"n":9,"text":"When you enter the land which Jehovah your God is giving you, you shall not learn to do things according to the abominations of those nations.","tok":[{"t":"When you enter the "},{"t":"land","s":["H0776"],"a":[4]},{"t":" which "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" your "},{"t":"God","s":["H0430"],"a":[7]},{"t":" is "},{"t":"giving","s":["H5414"],"a":[8]},{"t":" you, you shall not "},{"t":"learn","s":["H3925"],"a":[11]},{"t":" to "},{"t":"do","s":["H6213"],"a":[12]},{"t":" things according to the "},{"t":"abominations","s":["H8441"],"a":[13]},{"t":" of those "},{"t":"nations","s":["H1471"],"a":[14]},{"t":"."}]},{"n":10,"text":"There shall not be found among you anyone who makes his son or daughter pass through fire; anyone who performs divination, practices soothsaying, or interprets omens; or anyone who employs sorcery","tok":[{"t":"There shall not be "},{"t":"found","s":["H4672"],"a":[1]},{"t":" among you anyone who makes his "},{"t":"son","s":["H1121"],"a":[4]},{"t":" or "},{"t":"daughter","s":["H1323"],"a":[5]},{"t":" "},{"t":"pass","s":["H5674"],"a":[3]},{"t":" through "},{"t":"fire","s":["H0784"],"a":[6]},{"t":"; anyone who performs "},{"t":"divination","s":["H7081"],"a":[8]},{"t":", practices soothsaying, or interprets omens; or anyone who employs sorcery"}]},{"n":11,"text":"Or casts spells; or anyone who consults a spirit of the dead or a familiar spirit or inquires of the dead;","tok":[{"t":"Or casts spells; or anyone who consults a "},{"t":"spirit","s":["H0178"],"a":[3]},{"t":" of the dead or a familiar spirit or inquires of the dead;"}]},{"n":12,"text":"For everyone who does these things is an abomination to Jehovah; and on account of these abominations Jehovah your God is dispossessing them from before you.","tok":[{"t":"For everyone who does these things is an "},{"t":"abomination","s":["H8441"],"a":[1]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":"; and on account of these "},{"t":"abominations","s":["H8441"],"a":[7]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[9]},{"t":" your "},{"t":"God","s":["H0430"],"a":[10]},{"t":" is dispossessing them from "},{"t":"before","s":["H6440"],"a":[13]},{"t":" you."}]},{"n":13,"text":"You shall be blameless toward Jehovah your God.","tok":[{"t":"You shall be blameless toward "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" your "},{"t":"God","s":["H0430"],"a":[4]},{"t":"."}]},{"n":14,"text":"For these nations whom you are dispossessing listen to those who practice soothsaying and to those who perform divination, but Jehovah your God has not allowed you to do so.","tok":[{"t":"For these "},{"t":"nations","s":["H1471"],"a":[1]},{"t":" whom you are dispossessing listen to those who practice soothsaying and to those who perform divination, but "},{"t":"Jehovah","s":["H3068"],"a":[17]},{"t":" your "},{"t":"God","s":["H0430"],"a":[18]},{"t":" has not allowed you to do so."}]},{"n":15,"text":"A Prophet will Jehovah your God raise up for you from your midst, from among your brothers, like me; you shall listen to Him.","tok":[{"t":"A "},{"t":"Prophet","s":["H5030"],"a":[0]},{"t":" will "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" your "},{"t":"God","s":["H0430"],"a":[7]},{"t":" raise "},{"t":"up","s":["H6965"],"a":[4]},{"t":" for you from your "},{"t":"midst","s":["H7130"],"a":[1]},{"t":", from among your "},{"t":"brothers","s":["H0251"],"a":[2]},{"t":", like me; you shall "},{"t":"listen","s":["H8085"],"a":[9]},{"t":" to Him."}]},{"n":16,"text":"This is according to all that you asked of Jehovah your God at Horeb on the day of the assembly, saying, Let me not hear any more of the voice of Jehovah my God, and let me not see this great fire any longer, lest I die.","tok":[{"t":"This is according to all that you asked of "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" your "},{"t":"God","s":["H0430"],"a":[5]},{"t":" at "},{"t":"Horeb","s":["H2722"],"a":[6]},{"t":" on the "},{"t":"day","s":["H3117"],"a":[7]},{"t":" of the "},{"t":"assembly","s":["H6951"],"a":[8]},{"t":", "},{"t":"saying","s":["H0559"],"a":[9]},{"t":", Let me not "},{"t":"hear","s":["H8085"],"a":[12]},{"t":" any more of the "},{"t":"voice","s":["H6963"],"a":[14]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[15]},{"t":" my "},{"t":"God","s":["H0430"],"a":[16]},{"t":", and let me not "},{"t":"see","s":["H7200"],"a":[22]},{"t":" this "},{"t":"great","s":["H1419"],"a":[19]},{"t":" "},{"t":"fire","s":["H0784"],"a":[18]},{"t":" any longer, lest I "},{"t":"die","s":["H4191"],"a":[25]},{"t":"."}]},{"n":17,"text":"And Jehovah said to me, They have done well in what they have spoken.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to me, They have done "},{"t":"well","s":["H3190"],"a":[3]},{"t":" in what they have "},{"t":"spoken","s":["H1696"],"a":[5]},{"t":"."}]},{"n":18,"text":"A Prophet will I raise up for them from the midst of their brothers like you; and I will put My words in His mouth, and He will speak to them all that I command Him.","tok":[{"t":"A "},{"t":"Prophet","s":["H5030"],"a":[0]},{"t":" will I raise "},{"t":"up","s":["H6965"],"a":[1]},{"t":" for them from the midst of their "},{"t":"brothers","s":["H0251"],"a":[4]},{"t":" like you; and I will "},{"t":"put","s":["H5414"],"a":[6]},{"t":" My "},{"t":"words","s":["H1697"],"a":[7]},{"t":" in His "},{"t":"mouth","s":["H6310"],"a":[8]},{"t":", and He will "},{"t":"speak","s":["H1696"],"a":[9]},{"t":" to them all that I "},{"t":"command","s":["H6680"],"a":[14]},{"t":" Him."}]},{"n":19,"text":"And the man who will not listen to My words which He will speak in My name, I Myself will require it from him.","tok":[{"t":"And the man who will not "},{"t":"listen","s":["H8085"],"a":[4]},{"t":" to My "},{"t":"words","s":["H1697"],"a":[6]},{"t":" which He will "},{"t":"speak","s":["H1696"],"a":[8]},{"t":" in My "},{"t":"name","s":["H8034"],"a":[9]},{"t":", I Myself will "},{"t":"require","s":["H1875"],"a":[11]},{"t":" it from him."}]},{"n":20,"text":"But the prophet who speaks a word presumptuously in My name, which I did not command him to speak, or who speaks in the name of other gods, that prophet shall die.","tok":[{"t":"But the "},{"t":"prophet","s":["H5030"],"a":[1]},{"t":" who "},{"t":"speaks","s":["H1696"],"a":[4]},{"t":" a "},{"t":"word","s":["H1697"],"a":[5]},{"t":" presumptuously in My "},{"t":"name","s":["H8034"],"a":[6]},{"t":", which I did not "},{"t":"command","s":["H6680"],"a":[10]},{"t":" him to "},{"t":"speak","s":["H1696"],"a":[11]},{"t":", or who "},{"t":"speaks","s":["H1696"],"a":[13]},{"t":" in the "},{"t":"name","s":["H8034"],"a":[14]},{"t":" of "},{"t":"other","s":["H0312"],"a":[16]},{"t":" "},{"t":"gods","s":["H0430"],"a":[15]},{"t":", that "},{"t":"prophet","s":["H5030"],"a":[18]},{"t":" shall "},{"t":"die","s":["H4191"],"a":[17]},{"t":"."}]},{"n":21,"text":"And if you say in your heart, How shall we know the word that Jehovah has not spoken?","tok":[{"t":"And if you "},{"t":"say","s":["H0559"],"a":[1]},{"t":" in your "},{"t":"heart","s":["H3824"],"a":[2]},{"t":", How shall we "},{"t":"know","s":["H3045"],"a":[4]},{"t":" the "},{"t":"word","s":["H1697"],"a":[6]},{"t":" that "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":" has not "},{"t":"spoken","s":["H1696"],"a":[9]},{"t":"?"}]},{"n":22,"text":"When a prophet speaks in the name of Jehovah and the thing does not happen nor come about, that is the thing which Jehovah has not spoken. The prophet has spoken presumptuously; you shall not be afraid of him.","tok":[{"t":"When a "},{"t":"prophet","s":["H5030"],"a":[2]},{"t":" "},{"t":"speaks","s":["H1696"],"a":[1]},{"t":" in the "},{"t":"name","s":["H8034"],"a":[3]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":" and the "},{"t":"thing","s":["H1697"],"a":[7]},{"t":" does not happen nor come about, that is the "},{"t":"thing","s":["H1697"],"a":[11]},{"t":" which "},{"t":"Jehovah","s":["H3068"],"a":[15]},{"t":" has not "},{"t":"spoken","s":["H1696"],"a":[14]},{"t":". The "},{"t":"prophet","s":["H5030"],"a":[18]},{"t":" has "},{"t":"spoken","s":["H1696"],"a":[17]},{"t":" "},{"t":"presumptuously","s":["H2087"],"a":[16]},{"t":"; you shall not be "},{"t":"afraid","s":["H1481"],"a":[20]},{"t":" of him."}]}]}
