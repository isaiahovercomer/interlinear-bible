to "},{"t":"give","s":["H5414"],"a":[15]},{"t":" them."}]},{"n":12,"text":"And now, O Israel, what does Jehovah your God ask of you except that you fear Jehovah your God so that you would walk in all His ways and love Him and serve Jehovah your God with all your heart and with all your soul;","tok":[{"t":"And now, O "},{"t":"Israel","s":["H3478"],"a":[1]},{"t":", what does "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" your "},{"t":"God","s":["H0430"],"a":[4]},{"t":" ask of you except that you "},{"t":"fear","s":["H3372"],"a":[9]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[11]},{"t":" your "},{"t":"God","s":["H0430"],"a":[12]},{"t":" so that you would "},{"t":"walk","s":["H3212"]},{"t":" in all His "},{"t":"ways","s":["H1870"],"a":[15]},{"t":" and "},{"t":"love","s":["H0157"],"a":[16]},{"t":" Him and "},{"t":"serve","s":["H5647"],"a":[18]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[20]},{"t":" your "},{"t":"God","s":["H0430"],"a":[21]},{"t":" with all your "},{"t":"heart","s":["H3824"],"a":[23]},{"t":" and with all your "},{"t":"soul","s":["H5315"],"a":[25]},{"t":";"}]},{"n":13,"text":"So that you would keep the commandments of Jehovah and His statutes, which I am commanding you today, for your good?","tok":[{"t":"So that you would "},{"t":"keep","s":["H8104"],"a":[0]},{"t":" the "},{"t":"commandments","s":["H4687"],"a":[2]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" and His "},{"t":"statutes","s":["H2708"],"a":[5]},{"t":", which I am "},{"t":"commanding","s":["H6680"],"a":[8]},{"t":" you today, for your "},{"t":"good","s":["H2896"],"a":[10]},{"t":"?"}]},{"n":14,"text":"Behold, heaven and the heaven of heavens belong to Jehovah your God, the earth and all that is in it.","tok":[{"t":"Behold, "},{"t":"heaven","s":["H8064"],"a":[3]},{"t":" and the "},{"t":"heaven","s":["H8064"],"a":[4]},{"t":" of "},{"t":"heavens","s":["H8064"],"a":[5]},{"t":" belong to Jehovah your "},{"t":"God","s":["H0430"],"a":[2]},{"t":", the "},{"t":"earth","s":["H0776"],"a":[6]},{"t":" and all that is in it."}]},{"n":15,"text":"But on your fathers Jehovah set His affection to love them, and He chose their seed after them, that is, you above all the peoples, as it is this day.","tok":[{"t":"But on your "},{"t":"fathers","s":["H0001"],"a":[1]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" set His affection to "},{"t":"love","s":["H0157"],"a":[4]},{"t":" them, and He "},{"t":"chose","s":["H0977"],"a":[6]},{"t":" their "},{"t":"seed","s":["H2233"],"a":[7]},{"t":" "},{"t":"after","s":["H0310"],"a":[8]},{"t":" them, that is, you above all the "},{"t":"peoples","s":["H5971"],"a":[11]},{"t":", as it is this "},{"t":"day","s":["H3117"],"a":[12]},{"t":"."}]},{"n":16,"text":"Circumcise then the foreskin of your heart, and do not be stiff-necked any longer;","tok":[{"t":"Circumcise","s":["H4135"],"a":[0]},{"t":" then the "},{"t":"foreskin","s":["H6190"],"a":[2]},{"t":" of your "},{"t":"heart","s":["H3824"],"a":[3]},{"t":", and do not be stiff-necked any longer;"}]},{"n":17,"text":"For it is Jehovah your God who is the God of gods and the Lord of lords, the great God, mighty and awesome, who does not regard persons and does not take bribes;","tok":[{"t":"For it is "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" your "},{"t":"God","s":["H0430"],"a":[2]},{"t":" who is the "},{"t":"God","s":["H0430"],"a":[4]},{"t":" of "},{"t":"gods","s":["H0430"],"a":[5]},{"t":" and the "},{"t":"Lord","s":["H0113"],"a":[6]},{"t":" of "},{"t":"lords","s":["H0113"],"a":[7]},{"t":", the "},{"t":"great","s":["H1419"],"a":[9]},{"t":" "},{"t":"God","s":["H0410"],"a":[8]},{"t":", "},{"t":"mighty","s":["H1368"],"a":[10]},{"t":" and awesome, who does not "},{"t":"regard","s":["H5375"],"a":[14]},{"t":" "},{"t":"persons","s":["H6440"],"a":[15]},{"t":" and does not "},{"t":"take","s":["H3947"],"a":[17]},{"t":" "},{"t":"bribes","s":["H7810"],"a":[18]},{"t":";"}]},{"n":18,"text":"He executes justice for the orphan and the widow, and He loves the sojourner, giving him food and clothing.","tok":[{"t":"He "},{"t":"executes","s":["H6213"],"a":[0]},{"t":" justice for the orphan and the "},{"t":"widow","s":["H0490"],"a":[3]},{"t":", and He "},{"t":"loves","s":["H0157"],"a":[4]},{"t":" the "},{"t":"sojourner","s":["H1616"],"a":[5]},{"t":", "},{"t":"giving","s":["H5414"],"a":[6]},{"t":" him "},{"t":"food","s":["H3899"],"a":[8]},{"t":" and "},{"t":"clothing","s":["H8071"],"a":[9]},{"t":"."}]},{"n":19,"text":"Therefore love the sojourner, for you were sojourners in the land of Egypt.","tok":[{"t":"Therefore "},{"t":"love","s":["H0157"],"a":[0]},{"t":" the sojourner, for you were sojourners in the "},{"t":"land","s":["H0776"],"a":[6]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[7]},{"t":"."}]},{"n":20,"text":"You shall fear Jehovah your God; Him shall you serve and to Him shall you hold fast and by His name shall you swear.","tok":[{"t":"You shall "},{"t":"fear","s":["H3372"],"a":[3]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" your "},{"t":"God","s":["H0430"],"a":[2]},{"t":"; Him shall you "},{"t":"serve","s":["H5647"],"a":[5]},{"t":" and to Him shall you hold fast and by His "},{"t":"name","s":["H8034"],"a":[8]},{"t":" shall you "},{"t":"swear","s":["H7650"],"a":[9]},{"t":"."}]},{"n":21,"text":"He is your praise and He is your God, who has done these great and awesome things for you, which your eyes have seen.","tok":[{"t":"He is your "},{"t":"praise","s":["H8416"],"a":[1]},{"t":" and He is your "},{"t":"God","s":["H0430"],"a":[3]},{"t":", who has "},{"t":"done","s":["H6213"],"a":[5]},{"t":" these "},{"t":"great","s":["H1419"],"a":[8]},{"t":" and awesome "},{"t":"things","s":["H3372"],"a":[10]},{"t":" for you, which your "},{"t":"eyes","s":["H5869"],"a":[14]},{"t":" have "},{"t":"seen","s":["H7200"],"a":[13]},{"t":"."}]},{"n":22,"text":"Your fathers went down into Egypt as seventy souls; and now Jehovah your God has made you as the stars of heaven in multitude.","tok":[{"t":"Your "},{"t":"fathers","s":["H0001"],"a":[3]},{"t":" went "},{"t":"down","s":["H3381"],"a":[2]},{"t":" into "},{"t":"Egypt","s":["H4714"],"a":[4]},{"t":" as seventy souls; and now "},{"t":"Jehovah","s":["H3068"],"a":[7]},{"t":" your "},{"t":"God","s":["H0430"],"a":[8]},{"t":" has "},{"t":"made","s":["H7760"],"a":[6]},{"t":" you as the "},{"t":"stars","s":["H3556"],"a":[9]},{"t":" of "},{"t":"heaven","s":["H8064"],"a":[10]},{"t":" in "},{"t":"multitude","s":["H7230"],"a":[11]},{"t":"."}]}]}
