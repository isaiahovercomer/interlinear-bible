{"v":1,"book":"Deut","ch":29,"verses":[{"n":1,"text":"These are the words of the covenant which Jehovah commanded Moses to make with the children of Israel in the land of Moab, besides the covenant that He made with them at Horeb.","tok":[{"t":"These are the "},{"t":"words","s":["H1697"],"a":[1]},{"t":" of the "},{"t":"covenant","s":["H1285"],"a":[2]},{"t":" which "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":" "},{"t":"commanded","s":["H6680"],"a":[4]},{"t":" "},{"t":"Moses","s":["H4872"],"a":[7]},{"t":" to "},{"t":"make","s":["H3772"],"a":[8]},{"t":" with the "},{"t":"children","s":["H1121"],"a":[10]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[11]},{"t":" in the "},{"t":"land","s":["H0776"],"a":[12]},{"t":" of "},{"t":"Moab","s":["H4124"],"a":[13]},{"t":", besides the "},{"t":"covenant","s":["H1285"],"a":[15]},{"t":" that He "},{"t":"made","s":["H3772"],"a":[17]},{"t":" with them at "},{"t":"Horeb","s":["H2722"],"a":[19]},{"t":"."}]},{"n":2,"text":"And Moses called to all Israel and said to them, You have seen all that Jehovah did before your eyes in the land of Egypt to Pharaoh, to all his servants, and to all his land,","tok":[{"t":"And "},{"t":"Moses","s":["H4872"],"a":[1]},{"t":" "},{"t":"called","s":["H7121"],"a":[0]},{"t":" to all "},{"t":"Israel","s":["H3478"],"a":[4]},{"t":" and "},{"t":"said","s":["H0559"],"a":[5]},{"t":" to them, You have "},{"t":"seen","s":["H7200"],"a":[8]},{"t":" all that "},{"t":"Jehovah","s":["H3068"],"a":[13]},{"t":" "},{"t":"did","s":["H6213"],"a":[12]},{"t":" before your "},{"t":"eyes","s":["H5869"],"a":[14]},{"t":" in the "},{"t":"land","s":["H0776"],"a":[15]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[16]},{"t":" to "},{"t":"Pharaoh","s":["H6547"],"a":[17]},{"t":", to all his "},{"t":"servants","s":["H5650"],"a":[19]},{"t":", and to all his "},{"t":"land","s":["H0776"],"a":[21]},{"t":","}]},{"n":3,"text":"The great trials which your eyes have seen, those great signs and wonders.","tok":[{"t":"The "},{"t":"great","s":["H1419"],"a":[1]},{"t":" trials which your "},{"t":"eyes","s":["H5869"],"a":[4]},{"t":" have "},{"t":"seen","s":["H7200"],"a":[3]},{"t":", "},{"t":"those","s":["H0226"],"a":[5]},{"t":" "},{"t":"great","s":["H1419"],"a":[7]},{"t":" "},{"t":"signs","s":["H0226"],"a":[5]},{"t":" and wonders."}]},{"n":4,"text":"But Jehovah has not given you a heart to understand and eyes to see and ears to hear until this day.","tok":[{"t":"But "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" has not "},{"t":"given","s":["H5414"],"a":[1]},{"t":" you a "},{"t":"heart","s":["H3820"],"a":[4]},{"t":" to "},{"t":"understand","s":["H3045"],"a":[5]},{"t":" and "},{"t":"eyes","s":["H5869"],"a":[6]},{"t":" to "},{"t":"see","s":["H7200"],"a":[7]},{"t":" and "},{"t":"ears","s":["H0241"],"a":[8]},{"t":" to "},{"t":"hear","s":["H8085"],"a":[9]},{"t":" until this "},{"t":"day","s":["H3117"],"a":[11]},{"t":"."}]},{"n":5,"text":"And I have led you forty years in the wilderness; your clothing did not wear out from upon you, nor did your sandal wear out from upon your foot;","tok":[{"t":"And I have "},{"t":"led","s":["H3212"]},{"t":" you "},{"t":"forty","s":["H0705"],"a":[2]},{"t":" "},{"t":"years","s":["H8141"],"a":[3]},{"t":" in the "},{"t":"wilderness","s":["H4057"],"a":[4]},{"t":"; your "},{"t":"clothing","s":["H8008"],"a":[7]},{"t":" did not wear out from upon you, nor did your sandal wear out from upon your "},{"t":"foot","s":["H7272"],"a":[13]},{"t":";"}]},{"n":6,"text":"You have not eaten bread, nor have you drunk wine or strong drink; that you might know that I am Jehovah your God.","tok":[{"t":"You have not "},{"t":"eaten","s":["H0398"],"a":[2]},{"t":" "},{"t":"bread","s":["H3899"],"a":[0]},{"t":", nor have you "},{"t":"drunk","s":["H8354"],"a":[6]},{"t":" "},{"t":"wine","s":["H3196"],"a":[3]},{"t":" or strong "},{"t":"drink","s":["H7941"],"a":[4]},{"t":"; that you might "},{"t":"know","s":["H3045"],"a":[8]},{"t":" that I am "},{"t":"Jehovah","s":["H3068"],"a":[11]},{"t":" your "},{"t":"God","s":["H0430"],"a":[12]},{"t":"."}]},{"n":7,"text":"And when you came to this place, Sihon the king of Heshbon and Og the king of Bashan came out to meet us in battle, and we slew them;","tok":[{"t":"And when you "},{"t":"came","s":["H0935"],"a":[0]},{"t":" to this "},{"t":"place","s":["H4725"],"a":[2]},{"t":", "},{"t":"Sihon","s":["H5511"],"a":[5]},{"t":" the "},{"t":"king","s":["H4428"],"a":[6]},{"t":" of "},{"t":"Heshbon","s":["H2809"],"a":[7]},{"t":" and "},{"t":"Og","s":["H5747"],"a":[8]},{"t":" the "},{"t":"king","s":["H4428"],"a":[9]},{"t":" of "},{"t":"Bashan","s":["H1316"],"a":[10]},{"t":" came "},{"t":"out","s":["H3318"],"a":[4]},{"t":" to meet us in "},{"t":"battle","s":["H4421"],"a":[12]},{"t":", and we slew them;"}]},{"n":8,"text":"And we took their land and gave it as an inheritance to the Reubenites, to the Gadites, and to the half-tribe of the Manassites.","tok":[{"t":"And we "},{"t":"took","s":["H3947"],"a":[0]},{"t":" their "},{"t":"land","s":["H0776"],"a":[2]},{"t":" and "},{"t":"gave","s":["H5414"],"a":[3]},{"t":" it as an "},{"t":"inheritance","s":["H5159"],"a":[4]},{"t":" to the "},{"t":"Reubenites","s":["H7206"],"a":[5]},{"t":", to the "},{"t":"Gadites","s":["H1425"],"a":[6]},{"t":", and to the "},{"t":"half","s":["H2677"],"a":[7]},{"t":"-"},{"t":"tribe","s":["H7626"],"a":[8]},{"t":" of the "},{"t":"Manassites","s":["H4520"],"a":[9]},{"t":"."}]},{"n":9,"text":"Therefore keep the words of this covenant and do them in order that you may prosper in all that you do.","tok":[{"t":"Therefore "},{"t":"keep","s":["H8104"],"a":[0]},{"t":" the "},{"t":"words","s":["H1697"],"a":[2]},{"t":" of this "},{"t":"covenant","s":["H1285"],"a":[3]},{"t":" and "},{"t":"do","s":["H6213"],"a":[5]},{"t":" them in order that you may "},{"t":"prosper","s":["H7919"],"a":[8]},{"t":" in all that you "},{"t":"do","s":["H6213"],"a":[12]},{"t":"."}]},{"n":10,"text":"You are standing today, all of you, before Jehovah your God, your leaders of your tribes, your elders, and your officers, every man of Israel,","tok":[{"t":"You are "},{"t":"standing","s":["H5324"],"a":[1]},{"t":" today, all of you, "},{"t":"before","s":["H6440"],"a":[4]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":" your "},{"t":"God","s":["H0430"],"a":[6]},{"t":", your leaders of your "},{"t":"tribes","s":["H7626"],"a":[8]},{"t":", your "},{"t":"elders","s":["H2205"],"a":[9]},{"t":", and your "},{"t":"officers","s":["H7860"],"a":[10]},{"t":", every man of "},{"t":"Israel","s":["H3478"],"a":[13]},{"t":","}]},{"n":11,"text":"Your little ones, your wives, and the sojourner with you, who is in the midst of your camp, from the man who chops your wood to the man who draws your water,","tok":[{"t":"Your little "},{"t":"ones","s":["H2945"],"a":[0]},{"t":", your "},{"t":"wives","s":["H0802"],"a":[1]},{"t":", and the sojourner with you, who is "},{"t":"in","s":["H7130"],"a":[4]},{"t":" the midst of your "},{"t":"camp","s":["H4264"],"a":[5]},{"t":", from the man who chops your "},{"t":"wood","s":["H6086"],"a":[7]},{"t":" to the man who draws your "},{"t":"water","s":["H4325"],"a":[10]},{"t":","}]},{"n":12,"text":"In order to enter into a covenant with Jehovah your God and into His oath, which Jehovah your God is making with you today,","tok":[{"t":"In order to "},{"t":"enter","s":["H5674"],"a":[0]},{"t":" into a "},{"t":"covenant","s":["H1285"],"a":[1]},{"t":" with "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" your "},{"t":"God","s":["H0430"],"a":[3]},{"t":" and into His "},{"t":"oath","s":["H0423"],"a":[4]},{"t":", which "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" your "},{"t":"God","s":["H0430"],"a":[7]},{"t":" is "},{"t":"making","s":["H3772"],"a":[8]},{"t":" with you today,"}]},{"n":13,"text":"So that He may establish you today as His people and that He may be your God, even as He has spoken to you and even as He swore to your fathers, to Abraham, to Isaac, and to Jacob.","tok":[{"t":"So that He may "},{"t":"establish","s":["H6965"],"a":[1]},{"t":" you today as His "},{"t":"people","s":["H5971"],"a":[5]},{"t":" and that He may be your "},{"t":"God","s":["H0430"],"a":[9]},{"t":", even as He has spoken to you and even as He swore to your "},{"t":"fathers","s":["H0001"],"a":[15]},{"t":", to "},{"t":"Abraham","s":["H0085"],"a":[16]},{"t":", to "},{"t":"Isaac","s":["H3327"],"a":[17]},{"t":", and to "},{"t":"Jacob","s":["H3290"],"a":[18]},{"t":"."}]},{"n":14,"text":"However not with you alone do I make this covenant and this oath;","tok":[{"t":"However not with you alone do I "},{"t":"make","s":["H3772"],"a":[4]},{"t":" this "},{"t":"covenant","s":["H1285"],"a":[6]},{"t":" and this "},{"t":"oath","s":["H0423"],"a":[9]},{"t":";"}]},{"n":15,"text":"But I make it with him who is here today standing with us before Jehovah our God and with him who is not here with us today.","tok":[{"t":"But I make it with him who is here today "},{"t":"standing","s":["H5975"],"a":[6]},{"t":" with "},{"t":"us","s":["H3117"],"a":[7]},{"t":" "},{"t":"before","s":["H6440"],"a":[8]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[9]},{"t":" our "},{"t":"God","s":["H0430"],"a":[10]},{"t":" and with him who is not here with us today."}]},{"n":16,"text":"For you know that we dwelt in the land of Egypt and that we passed through the midst of the nations whom you passed through,","tok":[{"t":"For you "},{"t":"know","s":["H3045"],"a":[2]},{"t":" that we "},{"t":"dwelt","s":["H3427"],"a":[5]},{"t":" in the "},{"t":"land","s":["H0776"],"a":[6]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[7]},{"t":" and that we passed "},{"t":"through","s":["H7130"],"a":[11]},{"t":" the midst of the "},{"t":"nations","s":["H1471"],"a":[12]},{"t":" whom you passed through,"}]},{"n":17,"text":"And you saw their detestable images and their idols, mere wood and stone, silver and gold, which were with them.","tok":[{"t":"And you saw their detestable images and their "},{"t":"idols","s":["H1544"],"a":[4]},{"t":", mere "},{"t":"wood","s":["H6086"],"a":[5]},{"t":" and "},{"t":"stone","s":["H0068"],"a":[6]},{"t":", "},{"t":"silver","s":["H3701"],"a":[7]},{"t":" and "},{"t":"gold","s":["H2091"],"a":[8]},{"t":", which were with them."}]},{"n":18,"text":"Beware that there is not among you any man or woman or family or tribe whose heart turns away, even today, from Jehovah our God, to go and serve the gods of those nations; that there is not among you a root bearing poisonous fruit and wormwood;","tok":[{"t":"Beware that there is not among you any "},{"t":"man","s":["H0376"],"a":[3]},{"t":" or "},{"t":"woman","s":["H0802"],"a":[5]},{"t":" or "},{"t":"family","s":["H4940"],"a":[7]},{"t":" or "},{"t":"tribe","s":["H7626"],"a":[9]},{"t":" whose "},{"t":"heart","s":["H3824"],"a":[11]},{"t":" turns "},{"t":"away","s":["H6437"],"a":[12]},{"t":", even today, from "},{"t":"Jehovah","s":["H3068"],"a":[15]},{"t":" our "},{"t":"God","s":["H0430"],"a":[16]},{"t":", to "},{"t":"go","s":["H3212"]},{"t":" and "},{"t":"serve","s":["H5647"],"a":[18]},{"t":" the "},{"t":"gods","s":["H0430"],"a":[20]},{"t":" of those "},{"t":"nations","s":["H1471"],"a":[21]},{"t":"; that there is not among you a "},{"t":"root","s":["H8328"],"a":[26]},{"t":" "},{"t":"bearing","s":["H6509"],"a":[27]},{"t":" poisonous fruit and "},{"t":"wormwood","s":["H3939"],"a":[29]},{"t":";"}]},{"n":19,"text":"And that when he hears the words of this oath, he blesses himself in his heart, saying, I will have peace, though I walk in the stubbornness of my heart; to the ruin of the moist with the dry.","tok":[{"t":"And that when he "},{"t":"hears","s":["H8085"],"a":[1]},{"t":" the "},{"t":"words","s":["H1697"],"a":[3]},{"t":" of this oath, he blesses himself in his "},{"t":"heart","s":["H3824"],"a":[7]},{"t":", "},{"t":"saying","s":["H0559"],"a":[8]},{"t":", I will have "},{"t":"peace","s":["H7965"],"a":[9]},{"t":", "},{"t":"though","s":["H3588"],"a":[12]},{"t":" I "},{"t":"walk","s":["H3212"]},{"t":" in the stubbornness of my "},{"t":"heart","s":["H3820"],"a":[14]},{"t":"; to the ruin of the moist with the dry."}]},{"n":20,"text":"Jehovah will not be willing to pardon him; but rather the anger of Jehovah and His jealousy will fume against that man, and all the oath that is written in this book will settle on him, and Jehovah will blot out his name from under heaven.","tok":[{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" "},{"t":"will","s":["H0014"],"a":[1]},{"t":" not be willing to pardon him; but rather the "},{"t":"anger","s":["H0639"],"a":[8]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[9]},{"t":" and His "},{"t":"jealousy","s":["H7068"],"a":[10]},{"t":" will fume against that "},{"t":"man","s":["H0376"],"a":[11]},{"t":", and all the oath that is "},{"t":"written","s":["H3789"],"a":[17]},{"t":" in this "},{"t":"book","s":["H5612"],"a":[18]},{"t":" will settle on him, and "},{"t":"Jehovah","s":["H3068"],"a":[21]},{"t":" will blot "},{"t":"out","s":["H4229"],"a":[20]},{"t":" his "},{"t":"name","s":["H8034"],"a":[23]},{"t":" from under "},{"t":"heaven","s":["H8064"],"a":[25]},{"t":"."}]},{"n":21,"text":"And Jehovah will separate him unto evil out of all the tribes of Israel according to all the oaths of the covenant written in this book of the law.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" will "},{"t":"separate","s":["H0914"],"a":[0]},{"t":" him unto "},{"t":"evil","s":["H7451"],"a":[2]},{"t":" out of all the "},{"t":"tribes","s":["H7626"],"a":[4]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[5]},{"t":" according to all the oaths of the "},{"t":"covenant","s":["H1285"],"a":[8]},{"t":" "},{"t":"written","s":["H3789"],"a":[9]},{"t":" in this "},{"t":"book","s":["H5612"],"a":[10]},{"t":" of the "},{"t":"law","s":["H8451"],"a":[11]},{"t":"."}]},{"n":22,"text":"And the following generation, your children who will rise up after you and the foreigner who will come from a distant land, will say, when they see the plagues of that land and its diseases with which Jehovah has made it sick;","tok":[{"t":"And the following "},{"t":"generation","s":["H1755"],"a":[1]},{"t":", "},{"t":"your","s":["H0314"],"a":[2]},{"t":" "},{"t":"children","s":["H1121"],"a":[3]},{"t":" who will rise "},{"t":"up","s":["H6965"],"a":[5]},{"t":" "},{"t":"after","s":["H0310"],"a":[6]},{"t":" you and the foreigner who will "},{"t":"come","s":["H0935"],"a":[9]},{"t":" from a "},{"t":"distant","s":["H7350"],"a":[11]},{"t":" "},{"t":"land","s":["H0776"],"a":[10]},{"t":", will "},{"t":"say","s":["H0559"],"a":[0]},{"t":", when they "},{"t":"see","s":["H7200"],"a":[12]},{"t":" the "},{"t":"plagues","s":["H4347"],"a":[14]},{"t":" of that "},{"t":"land","s":["H0776"],"a":[15]},{"t":" and its diseases with which "},{"t":"Jehovah","s":["H3068"],"a":[21]},{"t":" has made it sick;"}]},{"n":23,"text":"And that all its land is sulfur and salt, a burning waste; that it is not sown, nor does it sprout, nor does any vegetation come up in it; that it is like the overthrow of Sodom and Gomorrah, Admah and Zeboiim, which Jehovah overthrew in His anger and burning wrath —","tok":[{"t":"And that all its "},{"t":"land","s":["H0776"],"a":[4]},{"t":" is "},{"t":"sulfur","s":["H1614"],"a":[0]},{"t":" and "},{"t":"salt","s":["H4417"],"a":[1]},{"t":", a "},{"t":"burning","s":["H8316"],"a":[2]},{"t":" waste; that it is not "},{"t":"sown","s":["H2232"],"a":[6]},{"t":", nor does it sprout, nor does any vegetation come up in it; that it is like the "},{"t":"overthrow","s":["H4114"],"a":[14]},{"t":" of "},{"t":"Sodom","s":["H5467"],"a":[15]},{"t":" and "},{"t":"Gomorrah","s":["H6017"],"a":[16]},{"t":", "},{"t":"Admah","s":["H0126"],"a":[17]},{"t":" and "},{"t":"Zeboiim","s":["H6636"],"a":[18]},{"t":", which "},{"t":"Jehovah","s":["H3068"],"a":[21]},{"t":" "},{"t":"overthrew","s":["H2015"],"a":[20]},{"t":" in His "},{"t":"anger","s":["H0639"],"a":[22]},{"t":" and burning "},{"t":"wrath","s":["H2534"],"a":[23]},{"t":" —"}]},{"n":24,"text":"Indeed all the nations will say, Why has Jehovah done this to this land? Why the burning of this great anger?","tok":[{"t":"Indeed all the "},{"t":"nations","s":["H1471"],"a":[2]},{"t":" will "},{"t":"say","s":["H0559"],"a":[0]},{"t":", Why has "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" "},{"t":"done","s":["H6213"],"a":[5]},{"t":" this to this "},{"t":"land","s":["H0776"],"a":[8]},{"t":"? Why the burning of this "},{"t":"great","s":["H1419"],"a":[13]},{"t":" "},{"t":"anger","s":["H0639"],"a":[12]},{"t":"?"}]},{"n":25,"text":"And they will say, It is because they forsook the covenant of Jehovah, the God of their fathers, which He made with them when He brought them out from the land of Egypt;","tok":[{"t":"And they will "},{"t":"say","s":["H0559"],"a":[0]},{"t":", It is because they forsook the "},{"t":"covenant","s":["H1285"],"a":[5]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":", the "},{"t":"God","s":["H0430"],"a":[7]},{"t":" of their "},{"t":"fathers","s":["H0001"],"a":[8]},{"t":", which He "},{"t":"made","s":["H3772"],"a":[10]},{"t":" with them when He brought them out from the "},{"t":"land","s":["H0776"],"a":[14]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[15]},{"t":";"}]},{"n":26,"text":"And they went and served other gods and bowed down to them, gods whom they had not known and He had not allotted to them.","tok":[{"t":"And they "},{"t":"went","s":["H3212"]},{"t":" and "},{"t":"served","s":["H5647"],"a":[1]},{"t":" "},{"t":"other","s":["H0312"],"a":[3]},{"t":" "},{"t":"gods","s":["H0430"],"a":[2]},{"t":" and bowed down to them, "},{"t":"gods","s":["H0430"],"a":[6]},{"t":" whom they had not known and He had not allotted to them."}]},{"n":27,"text":"And the anger of Jehovah burned against this land, bringing upon it all the curses written in this book;","tok":[{"t":"And the "},{"t":"anger","s":["H0639"],"a":[1]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" burned against this "},{"t":"land","s":["H0776"],"a":[3]},{"t":", "},{"t":"bringing","s":["H0935"],"a":[5]},{"t":" upon it all the "},{"t":"curses","s":["H7045"],"a":[9]},{"t":" "},{"t":"written","s":["H3789"],"a":[10]},{"t":" in this "},{"t":"book","s":["H5612"],"a":[11]},{"t":";"}]},{"n":28,"text":"And Jehovah plucked them off their land in anger and in burning wrath and in great indignation, and sent them to another land, as they are this day.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" plucked them off their "},{"t":"land","s":["H0127"],"a":[3]},{"t":" in "},{"t":"anger","s":["H0639"],"a":[4]},{"t":" and in burning "},{"t":"wrath","s":["H2534"],"a":[5]},{"t":" and in "},{"t":"great","s":["H1419"],"a":[7]},{"t":" "},{"t":"indignation","s":["H7110"],"a":[6]},{"t":", and sent them to "},{"t":"another","s":["H0312"],"a":[11]},{"t":" "},{"t":"land","s":["H0776"],"a":[10]},{"t":", as they are this "},{"t":"day","s":["H3117"],"a":[12]},{"t":"."}]},{"n":29,"text":"The things that are hidden belong to Jehovah our God; but the things that are revealed, to us and our children forever, that we may do all the words of this law.","tok":[{"t":"The things that are hidden belong to "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" our "},{"t":"God","s":["H0430"],"a":[2]},{"t":"; but the things that are "},{"t":"revealed","s":["H1540"],"a":[3]},{"t":", to us and our "},{"t":"children","s":["H1121"],"a":[5]},{"t":" forever, that we may "},{"t":"do","s":["H6213"],"a":[8]},{"t":" all the "},{"t":"words","s":["H1697"],"a":[11]},{"t":" of this "},{"t":"law","s":["H8451"],"a":[12]},{"t":"."}]}]}
