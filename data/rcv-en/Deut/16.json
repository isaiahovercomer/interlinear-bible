":[1]},{"t":" anything leavened with it; "},{"t":"seven","s":["H7651"],"a":[4]},{"t":" "},{"t":"days","s":["H3117"],"a":[5]},{"t":" you shall "},{"t":"eat","s":["H0398"],"a":[6]},{"t":" unleavened "},{"t":"bread","s":["H4682"],"a":[8]},{"t":" with it, that is, the "},{"t":"bread","s":["H3899"],"a":[9]},{"t":" of "},{"t":"affliction","s":["H6040"],"a":[10]},{"t":" (for in alarmed "},{"t":"haste","s":["H2649"],"a":[12]},{"t":" you came out of the "},{"t":"land","s":["H0776"],"a":[14]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[15]},{"t":"); in order that you may "},{"t":"remember","s":["H2142"],"a":[17]},{"t":" the "},{"t":"day","s":["H3117"],"a":[19]},{"t":" of your coming out of the "},{"t":"land","s":["H0776"],"a":[21]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[22]},{"t":" all the "},{"t":"days","s":["H3117"],"a":[24]},{"t":" of your "},{"t":"life","s":["H2416"],"a":[25]},{"t":"."}]},{"n":4,"text":"And leaven shall not be seen with you in all your territory for seven days, nor shall any of the flesh which you sacrifice in the evening on the first day remain until morning.","tok":[{"t":"And leaven shall not be "},{"t":"seen","s":["H7200"],"a":[1]},{"t":" with you in all your territory for "},{"t":"seven","s":["H7651"],"a":[6]},{"t":" "},{"t":"days","s":["H3117"],"a":[7]},{"t":", nor shall any of the "},{"t":"flesh","s":["H1320"],"a":[11]},{"t":" which you sacrifice in the "},{"t":"evening","s":["H6153"],"a":[14]},{"t":" on the "},{"t":"first","s":["H7223"],"a":[16]},{"t":" "},{"t":"day","s":["H3117"],"a":[15]},{"t":" "},{"t":"remain","s":["H3885"],"a":[9]},{"t":" until "},{"t":"morning","s":["H1242"],"a":[17]},{"t":"."}]},{"n":5,"text":"You may not sacrifice the passover within any of your gates, which Jehovah your God is giving you;","tok":[{"t":"You "},{"t":"may","s":["H3201"],"a":[1]},{"t":" not "},{"t":"sacrifice","s":["H2076"],"a":[2]},{"t":" the "},{"t":"passover","s":["H6453"],"a":[4]},{"t":" within "},{"t":"any","s":["H0259"],"a":[5]},{"t":" of your "},