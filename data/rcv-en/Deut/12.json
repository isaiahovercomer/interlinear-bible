":"offerings","s":["H5071"],"a":[10]},{"t":" and the firstborn of your "},{"t":"herd","s":["H1241"],"a":[12]},{"t":" and of your "},{"t":"flock","s":["H6629"],"a":[13]},{"t":";"}]},{"n":7,"text":"And there you shall eat before Jehovah your God, and you and your households shall rejoice in all your undertakings, in which Jehovah your God has blessed you.","tok":[{"t":"And there you shall "},{"t":"eat","s":["H0398"],"a":[0]},{"t":" "},{"t":"before","s":["H6440"],"a":[2]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" your "},{"t":"God","s":["H0430"],"a":[4]},{"t":", and you and your "},{"t":"households","s":["H1004"],"a":[10]},{"t":" shall "},{"t":"rejoice","s":["H8055"],"a":[5]},{"t":" in all your undertakings, in which "},{"t":"Jehovah","s":["H3068"],"a":[13]},{"t":" your "},{"t":"God","s":["H0430"],"a":[14]},{"t":" has "},{"t":"blessed","s":["H1288"],"a":[12]},{"t":" you."}]},{"n":8,"text":"You shall not do according to all that we do here today, each man doing all that is right in his own eyes;","tok":[{"t":"You shall not "},{"t":"do","s":["H6213"],"a":[1]},{"t":" according to all that we "},{"t":"do","s":["H6213"],"a":[5]},{"t":" here today, each "},{"t":"man","s":["H0376"],"a":[8]},{"t":" doing all that is "},{"t":"right","s":["H3477"],"a":[10]},{"t":" in his own "},{"t":"eyes","s":["H5869"],"a":[11]},{"t":";"}]},{"n":9,"text":"For until now you have not come to the rest and to the inheritance that Jehovah your God is giving you.","tok":[{"t":"For until now you have not "},{"t":"come","s":["H0935"],"a":[2]},{"t":" to the "},{"t":"rest","s":["H4496"],"a":[6]},{"t":" and to the "},{"t":"inheritance","s":["H5159"],"a":[8]},{"t":" that "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":" your "},{"t":"God","s":["H0430"],"a":[11]},{"t":" is "},{"t":"giving","s":["H5414"],"a":[12]},{"t":" you."}]},{"n":10,"text":"But when you cross over the Jordan and dwell in the land which Jehovah your God is giving you as an inheritance, and when He gives you rest from all your