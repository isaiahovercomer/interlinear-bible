{"v":1,"book":"Deut","ch":11,"verses":[{"n":1,"text":"Therefore you shall love Jehovah your God and keep His charge and His statutes and His ordinances and His commandments always.","tok":[{"t":"Therefore you shall "},{"t":"love","s":["H0157"],"a":[0]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" your "},{"t":"God","s":["H0430"],"a":[3]},{"t":" and "},{"t":"keep","s":["H8104"],"a":[4]},{"t":" His "},{"t":"charge","s":["H4931"],"a":[5]},{"t":" and His "},{"t":"statutes","s":["H2708"],"a":[6]},{"t":" and His ordinances and His "},{"t":"commandments","s":["H4687"],"a":[8]},{"t":" "},{"t":"always","s":["H3117"],"a":[10]},{"t":"."}]},{"n":2,"text":"And realize today that I am speaking not with your sons, who do not know and who have not seen the discipline of Jehovah your God, His greatness, His mighty hand and His outstretched arm;","tok":[{"t":"And realize today that I am speaking not with your sons, who do not "},{"t":"know","s":["H3045"],"a":[0]},{"t":" and who have not "},{"t":"seen","s":["H7200"],"a":[11]},{"t":" the "},{"t":"discipline","s":["H4148"],"a":[13]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[14]},{"t":" your "},{"t":"God","s":["H0430"],"a":[15]},{"t":", His "},{"t":"greatness","s":["H1433"],"a":[17]},{"t":", His "},{"t":"mighty","s":["H2389"],"a":[20]},{"t":" "},{"t":"hand","s":["H3027"],"a":[19]},{"t":" and His outstretched "},{"t":"arm","s":["H2220"],"a":[21]},{"t":";"}]},{"n":3,"text":"And His signs and works, which He did in the midst of Egypt against Pharaoh, the king of Egypt, and against all his land;","tok":[{"t":"And His signs and works, which He "},{"t":"did","s":["H6213"],"a":[5]},{"t":" in the "},{"t":"midst","s":["H8432"],"a":[6]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[7]},{"t":" against "},{"t":"Pharaoh","s":["H6547"],"a":[8]},{"t":", the "},{"t":"king","s":["H4428"],"a":[9]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[10]},{"t":", and against all his "},{"t":"land","s":["H0776"],"a":[12]},{"t":";"}]},{"n":4,"text":"An