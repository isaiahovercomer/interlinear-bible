3138"],"a":[4]},{"t":", so that you may "},{"t":"gather","s":["H0622"],"a":[6]},{"t":" your grain and your new "},{"t":"wine","s":["H8492"],"a":[8]},{"t":" and your fresh "},{"t":"oil","s":["H3323"],"a":[9]},{"t":"."}]},{"n":15,"text":"And I will put grass in your field for your cattle, and you will eat and be satisfied.","tok":[{"t":"And I will put "},{"t":"grass","s":["H6212"],"a":[1]},{"t":" in your "},{"t":"field","s":["H7704"],"a":[2]},{"t":" for your "},{"t":"cattle","s":["H0929"],"a":[3]},{"t":", and you will "},{"t":"eat","s":["H0398"],"a":[4]},{"t":" and be "},{"t":"satisfied","s":["H7646"],"a":[5]},{"t":"."}]},{"n":16,"text":"Be careful lest your heart be deceived, and you turn aside and serve other gods and bow down to them,","tok":[{"t":"Be careful lest your "},{"t":"heart","s":["H3824"],"a":[4]},{"t":" be "},{"t":"deceived","s":["H6601"],"a":[3]},{"t":", and you turn "},{"t":"aside","s":["H5493"],"a":[5]},{"t":" and "},{"t":"serve","s":["H5647"],"a":[6]},{"t":" "},{"t":"other","s":["H0312"],"a":[8]},{"t":" "},{"t":"gods","s":["H0430"],"a":[7]},{"t":" and bow down to them,"}]},{"n":17,"text":"And the anger of Jehovah burn against you and He shut up heaven, so that there is no rain and the earth does not yield its produce and you perish quickly from off the good land which Jehovah is giving you.","tok":[{"t":"And the anger of Jehovah burn against you and He shut "},{"t":"up","s":["H6113"],"a":[4]},{"t":" "},{"t":"heaven","s":["H8064"],"a":[6]},{"t":", so that there is no "},{"t":"rain","s":["H4306"],"a":[9]},{"t":" and the earth does not "},{"t":"yield","s":["H5414"],"a":[12]},{"t":" its produce and you "},{"t":"perish","s":["H0006"],"a":[15]},{"t":" "},{"t":"quickly","s":["H4120"],"a":[16]},{"t":" from off the "},{"t":"good","s":["H2896"],"a":[19]},{"t":" "},{"t":"land","s":["H0776"],"a":[18]},{"t":" which "},{"t":"Jehovah","s":["H3068"],"a":[21]},{"t":" is "},{"t":"giving","s":["H5414"],"a":[22]},{"t":" you."}]},{"n":18,"text":"Therefore you shall lay t