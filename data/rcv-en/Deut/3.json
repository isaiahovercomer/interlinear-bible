ained in the valley opposite Beth-peor.","tok":[{"t":"And we remained in the "},{"t":"valley","s":["H1516"],"a":[1]},{"t":" "},{"t":"opposite","s":["H4136"],"a":[2]},{"t":" "},{"t":"Beth","s":["H1047"],"a":[3]},{"t":"-"},{"t":"peor","s":["H1047"],"a":[3]},{"t":"."}]}]}
