od who is fighting for you.","tok":[{"t":"Do not "},{"t":"fear","s":["H3372"],"a":[1]},{"t":" them, for it is "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" your "},{"t":"God","s":["H0430"],"a":[4]},{"t":" who is "},{"t":"fighting","s":["H3898"],"a":[6]},{"t":" for you."}]},{"n":23,"text":"And I pleaded with Jehovah at that time, saying,","tok":[{"t":"And I pleaded with "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" at that "},{"t":"time","s":["H6256"],"a":[3]},{"t":", "},{"t":"saying","s":["H0559"],"a":[5]},{"t":","}]},{"n":24,"text":"O Lord Jehovah, You have begun to show Your servant Your greatness and Your mighty hand. For what god is there in heaven or on earth who can do things like what You have done and things like Your mighty deeds?","tok":[{"t":"O "},{"t":"Lord","s":["H0136"],"a":[0]},{"t":" Jehovah, You have "},{"t":"begun","s":["H2490"],"a":[3]},{"t":" to show Your "},{"t":"servant","s":["H5650"],"a":[6]},{"t":" Your "},{"t":"greatness","s":["H1433"],"a":[8]},{"t":" and Your "},{"t":"mighty","s":["H2389"],"a":[11]},{"t":" "},{"t":"hand","s":["H3027"],"a":[10]},{"t":". For what "},{"t":"god","s":["H0410"],"a":[14]},{"t":" is there in "},{"t":"heaven","s":["H8064"],"a":[15]},{"t":" or on "},{"t":"earth","s":["H0776"],"a":[16]},{"t":" who can "},{"t":"do","s":["H6213"],"a":[18]},{"t":" things like what You have done and things like Your mighty deeds?"}]},{"n":25,"text":"Let me please cross over and see the good land that is across the Jordan, this fine hill country and Lebanon.","tok":[{"t":"Let me please cross "},{"t":"over","s":["H5674"],"a":[0]},{"t":" and "},{"t":"see","s":["H7200"],"a":[2]},{"t":" the "},{"t":"good","s":["H2896"],"a":[5]},{"t":" "},{"t":"land","s":["H0776"],"a":[4]},{"t":" that is "},{"t":"across","s":["H5676"],"a":[7]},{"t":" the "},{"t":"Jordan","s":["H3383"],"a":[8]},{"t":", this fine hill country and "},{"t":"Lebanon","s":["H3844"],"a":[12]},{"t":"."}]},{"n":26,"text":"But Jehovah was infuriated with me on your account and did no