0559"],"a":[0]},{"t":" to me, See, I have "},{"t":"begun","s":["H2490"],"a":[4]},{"t":" to "},{"t":"deliver","s":["H5414"],"a":[5]},{"t":" "},{"t":"Sihon","s":["H5511"],"a":[8]},{"t":" and his "},{"t":"land","s":["H0776"],"a":[10]},{"t":" up "},{"t":"before","s":["H6440"],"a":[6]},{"t":" you. "},{"t":"Begin","s":["H2490"],"a":[11]},{"t":" to "},{"t":"possess","s":["H3423"],"a":[12]},{"t":" it that you may occupy his "},{"t":"land","s":["H0776"],"a":[15]},{"t":"."}]},{"n":32,"text":"Then Sihon came out to meet us, he and all his people, for battle at Jahaz.","tok":[{"t":"Then "},{"t":"Sihon","s":["H5511"],"a":[1]},{"t":" came "},{"t":"out","s":["H3318"],"a":[0]},{"t":" to meet us, he and all his "},{"t":"people","s":["H5971"],"a":[5]},{"t":", for "},{"t":"battle","s":["H4421"],"a":[6]},{"t":" at "},{"t":"Jahaz","s":["H3096"],"a":[7]},{"t":"."}]},{"n":33,"text":"And Jehovah our God delivered him up before us, and we slew him and his sons and all his people.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" our "},{"t":"God","s":["H0430"],"a":[2]},{"t":" "},{"t":"delivered","s":["H5414"],"a":[0]},{"t":" him up "},{"t":"before","s":["H6440"],"a":[3]},{"t":" us, and we slew him and his "},{"t":"sons","s":["H1121"],"a":[7]},{"t":" and all his "},{"t":"people","s":["H5971"],"a":[10]},{"t":"."}]},{"n":34,"text":"And we captured all his cities at that time, and utterly destroyed every city — men, women, and children; we left no survivors.","tok":[{"t":"And we captured all his "},{"t":"cities","s":["H5892"],"a":[3]},{"t":" at that "},{"t":"time","s":["H6256"],"a":[4]},{"t":", and utterly "},{"t":"destroyed","s":["H2763"],"a":[6]},{"t":" every "},{"t":"city","s":["H5892"],"a":[9]},{"t":" — "},{"t":"men","s":["H4962"],"a":[10]},{"t":", "},{"t":"women","s":["H0802"],"a":[11]},{"t":", and children; we "},{"t":"left","s":["H7604"],"a":[14]},{"t":" no survivors."}]},{"n":35,"text":"We took only the cattle as our plunder, as well as the spoil of the cities which we captured.","tok":[{"t":"We took only the "},{"t":"cattle","s":["H0929"],"a":[1]},{"t":" as our plunder, as well as the "},{"t":"spoil","s":["H7998"],"a":[4]},{"t":" of the "},{"t":"cities","s":["H5892"],"a":[5]},{"t":" which we captured."}]},{"n":36,"text":"From Aroer, which is on the edge of the valley of the Arnon, and from the city which is in the valley, even to Gilead, there was not a town too high for us; Jehovah our God delivered them all up before us.","tok":[{"t":"From "},{"t":"Aroer","s":["H6177"],"a":[0]},{"t":", which is on the edge of the valley of the "},{"t":"Arnon","s":["H0769"],"a":[5]},{"t":", and from the "},{"t":"city","s":["H5892"],"a":[6]},{"t":" which is in the valley, even to "},{"t":"Gilead","s":["H1568"],"a":[10]},{"t":", there was not a town too high for us; "},{"t":"Jehovah","s":["H3068"],"a":[20]},{"t":" our "},{"t":"God","s":["H0430"],"a":[21]},{"t":" "},{"t":"delivered","s":["H5414"],"a":[19]},{"t":" them all up before "},{"t":"us","s":["H6440"],"a":[22]},{"t":"."}]},{"n":37,"text":"But you did not go near the land of the children of Ammon, all along the river Jabbok, nor the cities of the hill country, nor any place that Jehovah our God commanded us not to.","tok":[{"t":"But you did not go near the "},{"t":"land","s":["H0776"],"a":[2]},{"t":" of the "},{"t":"children","s":["H1121"],"a":[3]},{"t":" of "},{"t":"Ammon","s":["H5983"],"a":[4]},{"t":", all along the "},{"t":"river","s":["H5158"],"a":[9]},{"t":" "},{"t":"Jabbok","s":["H2999"],"a":[10]},{"t":", nor the "},{"t":"cities","s":["H5892"],"a":[11]},{"t":" of the hill country, nor any "},{"t":"place","s":["H3027"],"a":[8]},{"t":" that "},{"t":"Jehovah","s":["H3068"],"a":[16]},{"t":" our "},{"t":"God","s":["H0430"],"a":[17]},{"t":" commanded us not to."}]}]}
