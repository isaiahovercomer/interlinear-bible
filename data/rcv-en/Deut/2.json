["H6440"],"a":[17]},{"t":"."}]},{"n":26,"text":"Then I sent messengers from the wilderness of Kedemoth to Sihon the king of Heshbon with words of peace, saying,","tok":[{"t":"Then I "},{"t":"sent","s":["H7971"],"a":[0]},{"t":" "},{"t":"messengers","s":["H4397"],"a":[1]},{"t":" from the "},{"t":"wilderness","s":["H4057"],"a":[2]},{"t":" of "},{"t":"Kedemoth","s":["H6932"],"a":[3]},{"t":" to "},{"t":"Sihon","s":["H5511"],"a":[5]},{"t":" the "},{"t":"king","s":["H4428"],"a":[6]},{"t":" of "},{"t":"Heshbon","s":["H2809"],"a":[7]},{"t":" with "},{"t":"words","s":["H1697"],"a":[8]},{"t":" of "},{"t":"peace","s":["H7965"],"a":[9]},{"t":", "},{"t":"saying","s":["H0559"],"a":[10]},{"t":","}]},{"n":27,"text":"Let me pass through your land. Only on the road I will go; I will not turn to the right or to the left.","tok":[{"t":"Let me "},{"t":"pass","s":["H5674"],"a":[0]},{"t":" through your "},{"t":"land","s":["H0776"],"a":[1]},{"t":". Only on the road I will "},{"t":"go","s":["H3212"]},{"t":"; I will not "},{"t":"turn","s":["H5493"],"a":[6]},{"t":" to the "},{"t":"right","s":["H3225"],"a":[7]},{"t":" or to the "},{"t":"left","s":["H8040"],"a":[8]},{"t":"."}]},{"n":28,"text":"You will sell me food for money, that I may eat; and you will give me water for money, that I may drink; only let me pass through on foot —","tok":[{"t":"You will "},{"t":"sell","s":["H7666"],"a":[2]},{"t":" me food for "},{"t":"money","s":["H3701"],"a":[1]},{"t":", that I may "},{"t":"eat","s":["H0398"],"a":[3]},{"t":"; and you will "},{"t":"give","s":["H5414"],"a":[6]},{"t":" me "},{"t":"water","s":["H4325"],"a":[4]},{"t":" for "},{"t":"money","s":["H3701"],"a":[5]},{"t":", that I may "},{"t":"drink","s":["H8354"],"a":[8]},{"t":"; only let me pass "},{"t":"through","s":["H5674"],"a":[10]},{"t":" on "},{"t":"foot","s":["H7272"],"a":[11]},{"t":" —"}]},{"n":29,"text":"As the children of Esau, who dwell in Seir, and the Moabites, who dwell in Ar, did for me — until I cross over the Jordan into the land which