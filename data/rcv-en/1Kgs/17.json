 "},{"t":"up","s":["H5927"],"a":[8]},{"t":" into the upper chamber where he was staying, and he "},{"t":"laid","s":["H7901"],"a":[15]},{"t":" him upon his own "},{"t":"bed","s":["H4296"],"a":[17]},{"t":"."}]},{"n":20,"text":"And he cried to Jehovah and said, Jehovah, my God, have You also brought evil upon the widow, to whom I am a guest, by slaying her son?","tok":[{"t":"And he "},{"t":"cried","s":["H7121"],"a":[0]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" and "},{"t":"said","s":["H0559"],"a":[3]},{"t":", "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":", my "},{"t":"God","s":["H0430"],"a":[5]},{"t":", have You also brought "},{"t":"evil","s":["H7489"],"a":[13]},{"t":" upon the "},{"t":"widow","s":["H0490"],"a":[8]},{"t":", to whom I am a guest, by "},{"t":"slaying","s":["H4191"],"a":[14]},{"t":" her "},{"t":"son","s":["H1121"],"a":[16]},{"t":"?"}]},{"n":21,"text":"And he stretched himself upon the child three times and cried to Jehovah and said, Jehovah, my God, I beg You, let this child’s soul come into him again!","tok":[{"t":"And he "},{"t":"stretched","s":["H4058"],"a":[0]},{"t":" himself upon the "},{"t":"child","s":["H3206"],"a":[2]},{"t":" "},{"t":"three","s":["H7969"],"a":[3]},{"t":" "},{"t":"times","s":["H6471"],"a":[4]},{"t":" and "},{"t":"cried","s":["H7121"],"a":[5]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[7]},{"t":" and "},{"t":"said","s":["H0559"],"a":[8]},{"t":", "},{"t":"Jehovah","s":["H3068"],"a":[9]},{"t":", my "},{"t":"God","s":["H0430"],"a":[10]},{"t":", I beg You, let this "},{"t":"child’s","s":["H3206"],"a":[14]},{"t":" "},{"t":"soul","s":["H5315"],"a":[13]},{"t":" "},{"t":"come","s":["H7725"],"a":[11]},{"t":" into "},{"t":"him","s":["H7130"],"a":[17]},{"t":" "},{"t":"again","s":["H7725"]},{"t":"!"}]},{"n":22,"text":"And Jehovah listened to the voice of Elijah; and the child’s soul came into him again, and he lived.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"listened","s":["H8085"],"a":[0]