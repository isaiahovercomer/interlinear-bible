t":" "},{"t":"sackcloth","s":["H8242"],"a":[10]},{"t":" upon all the "},{"t":"loins","s":["H4975"],"a":[9]},{"t":" And "},{"t":"baldness","s":["H7144"],"a":[14]},{"t":" upon every "},{"t":"head","s":["H7218"],"a":[13]},{"t":"; And I will "},{"t":"make","s":["H7760"],"a":[15]},{"t":" it like the "},{"t":"mourning","s":["H0060"],"a":[16]},{"t":" for an "},{"t":"only","s":["H3173"],"a":[17]},{"t":" child And the "},{"t":"end","s":["H0319"],"a":[18]},{"t":" of it like a "},{"t":"bitter","s":["H4751"],"a":[20]},{"t":" "},{"t":"day","s":["H3117"],"a":[19]},{"t":"."}]},{"n":11,"text":"Indeed days are coming, Declares the Lord Jehovah, When I will send a hunger into the land, Not a hunger for bread Nor a thirst for water, But for hearing the words of Jehovah.","tok":[{"t":"Indeed "},{"t":"days","s":["H3117"],"a":[1]},{"t":" are "},{"t":"coming","s":["H0935"],"a":[2]},{"t":", "},{"t":"Declares","s":["H5002"],"a":[3]},{"t":" the "},{"t":"Lord","s":["H0136"],"a":[4]},{"t":" Jehovah, When I will "},{"t":"send","s":["H7971"],"a":[6]},{"t":" a "},{"t":"hunger","s":["H7458"],"a":[7]},{"t":" into the "},{"t":"land","s":["H0776"],"a":[8]},{"t":", Not a "},{"t":"hunger","s":["H7458"],"a":[10]},{"t":" for "},{"t":"bread","s":["H3899"],"a":[11]},{"t":" Nor a "},{"t":"thirst","s":["H6772"],"a":[13]},{"t":" for "},{"t":"water","s":["H4325"],"a":[14]},{"t":", But for "},{"t":"hearing","s":["H8085"],"a":[17]},{"t":" the "},{"t":"words","s":["H1697"],"a":[19]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[20]},{"t":"."}]},{"n":12,"text":"And they will totter from sea to sea, And from the north even to the east; They will rove about, seeking the word of Jehovah, But they will not find it.","tok":[{"t":"And they will totter from "},{"t":"sea","s":["H3220"],"a":[1]},{"t":" to "},{"t":"sea","s":["H3220"],"a":[3]},{"t":", And from the "},{"t":"north","s":["H6828"],"a":[4]},{"t":" even to the "},{"t":"east","s":["H4217"],"a":[6]},{"t":"; They will rove about, "},{"t":"seeking","s":["H1245"],"a":