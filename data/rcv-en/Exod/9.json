"],"a":[15]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[16]},{"t":"."}]},{"n":10,"text":"So they took ashes from the furnace and stood before Pharaoh; and Moses sprinkled it toward heaven, and it became boils breaking forth with sores on man and on beast.","tok":[{"t":"So they "},{"t":"took","s":["H3947"],"a":[0]},{"t":" "},{"t":"ashes","s":["H6368"],"a":[2]},{"t":" from the "},{"t":"furnace","s":["H3536"],"a":[3]},{"t":" and "},{"t":"stood","s":["H5975"],"a":[4]},{"t":" "},{"t":"before","s":["H6440"],"a":[5]},{"t":" "},{"t":"Pharaoh","s":["H6547"],"a":[6]},{"t":"; and "},{"t":"Moses","s":["H4872"],"a":[9]},{"t":" "},{"t":"sprinkled","s":["H2236"],"a":[7]},{"t":" it toward "},{"t":"heaven","s":["H8064"],"a":[10]},{"t":", and it became "},{"t":"boils","s":["H7822"],"a":[12]},{"t":" breaking "},{"t":"forth","s":["H6524"],"a":[14]},{"t":" with "},{"t":"sores","s":["H0076"],"a":[13]},{"t":" on "},{"t":"man","s":["H0120"],"a":[15]},{"t":" and on "},{"t":"beast","s":["H0929"],"a":[16]},{"t":"."}]},{"n":11,"text":"And the magicians could not stand before Moses because of the boils, for the boils were on the magicians as well as on all the Egyptians.","tok":[{"t":"And the "},{"t":"magicians","s":["H2748"],"a":[2]},{"t":" "},{"t":"could","s":["H3201"],"a":[1]},{"t":" not "},{"t":"stand","s":["H5975"],"a":[3]},{"t":" "},{"t":"before","s":["H6440"],"a":[4]},{"t":" "},{"t":"Moses","s":["H4872"],"a":[5]},{"t":" "},{"t":"because","s":["H6440"],"a":[6]},{"t":" of the "},{"t":"boils","s":["H7822"],"a":[7]},{"t":", for the "},{"t":"boils","s":["H7822"],"a":[10]},{"t":" were on the "},{"t":"magicians","s":["H2748"],"a":[11]},{"t":" as well as on all the "},{"t":"Egyptians","s":["H4714"]},{"t":"."}]},{"n":12,"text":"And Jehovah hardened Pharaoh’s heart, and he did not listen to them, just as Jehovah had spoken to Moses.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"hardened","s":["H2388"],"a":[0]},{"t":" Pharaoh’s "},{"t":"heart","s":["H3820"],"a":[3]},{"t":", and he did not listen to them, just as "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":" had "},{"t":"spoken","s":["H1696"],"a":[9]},{"t":" to "},{"t":"Moses","s":["H4872"],"a":[12]},{"t":"."}]},{"n":13,"text":"Then Jehovah said to Moses, Rise up early in the morning, and present yourself before Pharaoh, and say to him, Thus says Jehovah, the God of the Hebrews, Let My people go that they may serve Me.","tok":[{"t":"Then "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to "},{"t":"Moses","s":["H4872"],"a":[3]},{"t":", Rise up "},{"t":"early","s":["H7925"],"a":[4]},{"t":" in the "},{"t":"morning","s":["H1242"],"a":[5]},{"t":", and present yourself "},{"t":"before","s":["H6440"],"a":[7]},{"t":" "},{"t":"Pharaoh","s":["H6547"],"a":[8]},{"t":", and "},{"t":"say","s":["H0559"],"a":[9]},{"t":" to him, Thus "},{"t":"says","s":["H0559"],"a":[12]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[13]},{"t":", the "},{"t":"God","s":["H0430"],"a":[14]},{"t":" of the "},{"t":"Hebrews","s":["H5680"],"a":[15]},{"t":", Let My "},{"t":"people","s":["H5971"],"a":[18]},{"t":" "},{"t":"go","s":["H7971"],"a":[16]},{"t":" that they may "},{"t":"serve","s":["H5647"],"a":[19]},{"t":" Me."}]},{"n":14,"text":"For this time I am going to send all My plagues against you and on your servants and on your people, so that you may know that there is no one like Me in all the earth.","tok":[{"t":"For this "},{"t":"time","s":["H6471"],"a":[1]},{"t":" I am going to "},{"t":"send","s":["H7971"],"a":[4]},{"t":" all My "},{"t":"plagues","s":["H4046"],"a":[7]},{"t":" against you and on your "},{"t":"servants","s":["H5650"],"a":[10]},{"t":" and on your "},{"t":"people","s":["H5971"],"a":[11]},{"t":", so that you may "},{"t":"know","s":["H3045"],"a":[13]},{"t":" that there is no one like Me in all the "},{"t":"earth","s":["H0776"],"a":[18]},{"t":"."}]},{"n":15,"text":"For if by now I had stretched out My hand and struck you and your people with pestilence, you would have been cut off from the earth.","tok":[{"t":"For if by now I had stretched "},{"t":"out","s":["H7971"],"a":[2]},{"t":" My "},{"t":"hand","s":["H3027"],"a":[4]},{"t":" and struck you and your "},{"t":"people","s":["H5971"],"a":[8]},{"t":" with "},{"t":"pestilence","s":["H1698"],"a":[9]},{"t":", you would have been cut "},{"t":"off","s":["H3582"],"a":[10]},{"t":" from the "},{"t":"earth","s":["H0776"],"a":[12]},{"t":"."}]},{"n":16,"text":"But indeed for this cause I have made you stand, to show you My power and to have My name proclaimed throughout all the earth.","tok":[{"t":"But indeed for this cause I have made you stand, to show you My "},{"t":"power","s":["H3581"],"a":[7]},{"t":" and to have My "},{"t":"name","s":["H8034"],"a":[10]},{"t":" proclaimed throughout all the "},{"t":"earth","s":["H0776"],"a":[12]},{"t":"."}]},{"n":17,"text":"You are still exalting yourself against My people by not letting them go.","tok":[{"t":"You are still "},{"t":"exalting","s":["H5549"],"a":[1]},{"t":" yourself against My "},{"t":"people","s":["H5971"],"a":[2]},{"t":" by not letting them "},{"t":"go","s":["H7971"],"a":[4]},{"t":"."}]},{"n":18,"text":"Tomorrow about this time I am going to cause very heavy hail to fall, such as has never occurred in Egypt since the day it was founded even until now.","tok":[{"t":"Tomorrow about this "},{"t":"time","s":["H6256"],"a":[2]},{"t":" I am going to cause "},{"t":"very","s":["H3966"],"a":[6]},{"t":" "},{"t":"heavy","s":["H3515"],"a":[5]},{"t":" "},{"t":"hail","s":["H1259"],"a":[4]},{"t":" to fall, such as has never occurred in "},{"t":"Egypt","s":["H4714"],"a":[11]},{"t":" "},{"t":"since","s":["H4480"],"a":[12]},{"t":" the day it was founded even until now."}]},{"n":19,"text":"Now therefore send men and secure your livestock and all that you have in the field; every man and beast that is found in the field and is not brought home when the hail comes down shall die.","tok":[{"t":"Now therefore "},{"t":"send","s":["H7971"],"a":[1]},{"t"