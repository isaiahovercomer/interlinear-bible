{"v":1,"book":"Exod","ch":1,"verses":[{"n":1,"text":"Now these are the names of the sons of Israel who came to Egypt with Jacob; each man came with his household:","tok":[{"t":"Now these are the "},{"t":"names","s":["H8034"],"a":[1]},{"t":" of the "},{"t":"sons","s":["H1121"],"a":[2]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":" who "},{"t":"came","s":["H0935"],"a":[4]},{"t":" to "},{"t":"Egypt","s":["H4714"],"a":[5]},{"t":" with "},{"t":"Jacob","s":["H3290"],"a":[7]},{"t":"; each "},{"t":"man","s":["H0376"],"a":[8]},{"t":" "},{"t":"came","s":["H0935"],"a":[10]},{"t":" with his "},{"t":"household","s":["H1004"],"a":[9]},{"t":":"}]},{"n":2,"text":"Reuben, Simeon, Levi, and Judah,","tok":[{"t":"Reuben","s":["H7205"],"a":[0]},{"t":", "},{"t":"Simeon","s":["H8095"],"a":[1]},{"t":", "},{"t":"Levi","s":["H3878"],"a":[2]},{"t":", and "},{"t":"Judah","s":["H3063"],"a":[3]},{"t":","}]},{"n":3,"text":"Issachar, Zebulun, and Benjamin,","tok":[{"t":"Issachar","s":["H3485"],"a":[0]},{"t":", "},{"t":"Zebulun","s":["H2074"],"a":[1]},{"t":", and "},{"t":"Benjamin","s":["H1144"],"a":[2]},{"t":","}]},{"n":4,"text":"Dan and Naphtali, Gad and Asher.","tok":[{"t":"Dan","s":["H1835"],"a":[0]},{"t":" and "},{"t":"Naphtali","s":["H5321"],"a":[1]},{"t":", "},{"t":"Gad","s":["H1410"],"a":[2]},{"t":" and "},{"t":"Asher","s":["H0836"],"a":[3]},{"t":"."}]},{"n":5,"text":"And all the persons who came forth from the loins of Jacob were seventy persons, but Joseph was already in Egypt.","tok":[{"t":"And all the persons who came forth from the "},{"t":"loins","s":["H3409"],"a":[4]},{"t":" of "},{"t":"Jacob","s":["H3290"],"a":[5]},{"t":" were "},{"t":"seventy","s":["H7657"],"a":[6]},{"t":" "},{"t":"persons","s":["H5315"],"a":[7]},{"t":", but "},{"t":"Joseph","s":["H3130"],"a":[8]},{"t":" was already in "},{"t":"Egypt","s":["H4714"],"a":[10]},{"t":"."}]},{"n":6,"text":"And Joseph died, and all his brothers, and all that generation.","tok":[{"t":"And "},{"t":"Joseph","s":["H3130"],"a":[1]},{"t":" "},{"t":"died","s":["H4191"],"a":[0]},{"t":", and all his "},{"t":"brothers","s":["H0251"],"a":[3]},{"t":", and all that "},{"t":"generation","s":["H1755"],"a":[5]},{"t":"."}]},{"n":7,"text":"But the children of Israel were fruitful and increased abundantly and multiplied and grew exceedingly strong, and the land was filled with them.","tok":[{"t":"But the "},{"t":"children","s":["H1121"],"a":[0]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[1]},{"t":" were "},{"t":"fruitful","s":["H6509"],"a":[2]},{"t":" and increased "},{"t":"abundantly","s":["H8317"],"a":[3]},{"t":" and "},{"t":"multiplied","s":["H7235"],"a":[4]},{"t":" and grew exceedingly strong, and the "},{"t":"land","s":["H0776"],"a":[9]},{"t":" was "},{"t":"filled","s":["H4390"],"a":[8]},{"t":" with them."}]},{"n":8,"text":"And a new king rose up over Egypt, who did not know of Joseph.","tok":[{"t":"And a "},{"t":"new","s":["H2319"],"a":[2]},{"t":" "},{"t":"king","s":["H4428"],"a":[1]},{"t":" rose "},{"t":"up","s":["H6965"],"a":[0]},{"t":" over "},{"t":"Egypt","s":["H4714"],"a":[4]},{"t":", who did not know of "},{"t":"Joseph","s":["H3130"],"a":[9]},{"t":"."}]},{"n":9,"text":"And he said to his people, The people of the children of Israel are now more numerous and stronger than we.","tok":[{"t":"And he "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to his "},{"t":"people","s":["H5971"],"a":[2]},{"t":", The "},{"t":"people","s":["H5971"],"a":[4]},{"t":" of the "},{"t":"children","s":["H1121"],"a":[5]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[6]},{"t":" are now "},{"t":"more","s":["H7227"],"a":[7]},{"t":" numerous and stronger than we."}]},{"n":10,"text":"Come, let us deal wisely with them, lest they multiply and, when some war occurs, they also join themselves to those who hate us and fight against us and go up from the land.","tok":[{"t":"Come, let us deal "},{"t":"wisely","s":["H2449"],"a":[1]},{"t":" with them, lest they "},{"t":"multiply","s":["H7235"],"a":[4]},{"t":" and, when some "},{"t":"war","s":["H4421"],"a":[8]},{"t":" occurs, "},{"t":"they","s":["H1931"],"a":[11]},{"t":" also "},{"t":"join","s":["H3254"],"a":[9]},{"t":" themselves to those who hate us and "},{"t":"fight","s":["H3898"],"a":[14]},{"t":" against us and go "},{"t":"up","s":["H5927"],"a":[16]},{"t":" from the "},{"t":"land","s":["H0776"],"a":[18]},{"t":"."}]},{"n":11,"text":"So they set taskmasters over them to afflict them with their burdens. And they built storage cities for Pharaoh, Pithom and Raamses.","tok":[{"t":"So they "},{"t":"set","s":["H7760"],"a":[0]},{"t":" "},{"t":"taskmasters","s":["H4522"],"a":[3]},{"t":" over them to "},{"t":"afflict","s":["H6031"],"a":[5]},{"t":" them with their "},{"t":"burdens","s":["H5450"],"a":[6]},{"t":". And they "},{"t":"built","s":["H1129"],"a":[7]},{"t":" storage "},{"t":"cities","s":["H5892"],"a":[8]},{"t":" for "},{"t":"Pharaoh","s":["H6547"],"a":[10]},{"t":", "},{"t":"Pithom","s":["H6619"],"a":[12]},{"t":" and "},{"t":"Raamses","s":["H7486"],"a":[14]},{"t":"."}]},{"n":12,"text":"But the more they afflicted them, the more they multiplied and the more they spread out so that they came to dread the children of Israel.","tok":[{"t":"But the more they "},{"t":"afflicted","s":["H6031"],"a":[1]},{"t":" them, the "},{"t":"more","s":["H3651"],"a":[3]},{"t":" they "},{"t":"multiplied","s":["H7235"],"a":[4]},{"t":" and the more they spread out so that they came to dread the "},{"t":"children","s":["H1121"],"a":[9]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[10]},{"t":"."}]},{"n":13,"text":"And the Egyptians made the children of Israel serve with harshness,","tok":[{"t":"And the "},{"t":"Egyptians","s":["H4714"]},{"t":" "},{"t":"made","s":["H5647"],"a":[0]},{"t":" the "},{"t":"children","s":["H1121"],"a":[3]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[4]},{"t":" "},{"t":"serve","s":["H5647"]},{"t":" with "},{"t":"harshness","s":["H6531"],"a":[5]},{"t":","}]},{"n":14,"text":"And they made their lives bitter with hard labor in mortar and in brick and in all kinds of labor in the field; all their labor with which they made them serve was with harshness.","tok":[{"t":"And they "},{"t":"made","s":["H4843"],"a":[0]},{"t":" their "},{"t":"lives","s":["H2416"],"a":[2]},{"t":" "},{"t":"bitter","s":["H4843"]},{"t":" with "},{"t":"hard","s":["H7186"],"a":[4]},{"t":" labor in mortar and in "},{"t":"brick","s":["H3843"],"a":[6]},{"t":" and in all kinds of labor in the "},{"t":"field","s":["H7704"],"a":[9]},{"t":"; all their labor with which they made them "},{"t":"serve","s":["H5647"],"a":[14]},{"t":" was with "},{"t":"harshness","s":["H6531"],"a":[16]},{"t":"."}]},{"n":15,"text":"And the king of Egypt spoke to the Hebrew midwives, one whose name was Shiphrah and the other whose name was Puah;","tok":[{"t":"And the "},{"t":"king","s":["H4428"],"a":[1]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[2]},{"t":" "},{"t":"spoke","s":["H0559"],"a":[0]},{"t":" to the "},{"t":"Hebrew","s":["H5680"],"a":[4]},{"t":" "},{"t":"midwives","s":["H3205"],"a":[3]},{"t":", "},{"t":"one","s":["H0259"],"a":[7]},{"t":" whose "},{"t":"name","s":["H8034"],"a":[6]},{"t":" was "},{"t":"Shiphrah","s":["H8236"],"a":[8]},{"t":" and the "},{"t":"other","s":["H8145"],"a":[10]},{"t":" whose "},{"t":"name","s":["H8034"],"a":[9]},{"t":" was "},{"t":"Puah","s":["H6326"],"a":[11]},{"t":";"}]},{"n":16,"text":"And he said, When you act as midwives for the Hebrew women and see them on the birthstool, if it is a son, then you shall put him to death; but if it is a daughter, then she shall live.","tok":[{"t":"And he "},{"t":"said","s":["H0559"],"a":[0]},{"t":", When you act as midwives for the Hebrew "},{"t":"women","s":["H5680"],"a":[3]},{"t":" and "},{"t":"see","s":["H7200"],"a":[4]},{"t":" them on the birthstool, if it is a "},{"t":"son","s":["H1121"],"a":[8]},{"t":", then you shall put him to death; but if it is a "},{"t":"daughter","s":["H1323"],"a":[13]},{"t":", then she shall "},{"t":"live","s":["H2425"]},{"t":"."}]},{"n":17,"text":"But the midwives feared God and did not do as the king of Egypt had commanded them but let the male children live.","tok":[{"t":"But the "},{"t":"midwives","s":["H3205"],"a":[1]},{"t":" "},{"t":"feared","s":["H3372"],"a":[0]},{"t":" "},{"t":"God","s":["H0430"],"a":[3]},{"t":" and "},{"t":"did","s":["H6213"],"a":[5]},{"t":" not do as the "},{"t":"king","s":["H4428"],"a":[9]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[10]},{"t":" had "},{"t":"commanded","s":["H1696"],"a":[7]},{"t":" them but let the male "},{"t":"children","s":["H3206"],"a":[13]},{"t":" "},{"t":"live","s":["H2421"]},{"t":"."}]},{"n":18,"text":"So the king of Egypt called for the midwives and said to them, Why have you done this thing and let the male children live?","tok":[{"t":"So the "},{"t":"king","s":["H4428"],"a":[1]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[2]},{"t":" "},{"t":"called","s":["H7121"],"a":[0]},{"t":" for the "},{"t":"midwives","s":["H3205"],"a":[3]},{"t":" and "},{"t":"said","s":["H0559"],"a":[4]},{"t":" to them, "},{"t":"Why","s":["H4069"],"a":[6]},{"t":" have you "},{"t":"done","s":["H6213"],"a":[7]},{"t":" this "},{"t":"thing","s":["H1697"],"a":[8]},{"t":" and let the male "},{"t":"children","s":["H3206"],"a":[12]},{"t":" "},{"t":"live","s":["H2421"]},{"t":"?"}]},{"n":19,"text":"And the midwives said to Pharaoh, Because the Hebrew women are not like the Egyptian women; for they are vigorous: before the midwife comes to them, they give birth.","tok":[{"t":"And the "},{"t":"midwives","s":["H3205"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to "},{"t":"Pharaoh","s":["H6547"],"a":[3]},{"t":", Because the "},{"t":"Hebrew","s":["H5680"],"a":[8]},{"t":" "},{"t":"women","s":["H0802"],"a":[6]},{"t":" are not like the Egyptian "},{"t":"women","s":["H4713"],"a":[7]},{"t":"; for they are vigorous: before the midwife comes to them, they give birth."}]},{"n":20,"text":"And God dealt well with the midwives, and the people multiplied and grew very strong.","tok":[{"t":"And "},{"t":"God","s":["H0430"],"a":[1]},{"t":" dealt "},{"t":"well","s":["H3190"],"a":[0]},{"t":" with the "},{"t":"midwives","s":["H3205"],"a":[2]},{"t":", and the "},{"t":"people","s":["H5971"],"a":[4]},{"t":" "},{"t":"multiplied","s":["H7235"],"a":[3]},{"t":" and grew "},{"t":"very","s":["H3966"],"a":[6]},{"t":" "},{"t":"strong","s":["H6105"],"a":[5]},{"t":"."}]},{"n":21,"text":"And because the midwives feared God, He established households for them.","tok":[{"t":"And because the "},{"t":"midwives","s":["H3205"],"a":[3]},{"t":" "},{"t":"feared","s":["H3372"],"a":[2]},{"t":" "},{"t":"God","s":["H0430"],"a":[5]},{"t":", He established households for them."}]},{"n":22,"text":"And Pharaoh commanded all his people, saying, Every son who is born you shall cast into the River, but every daughter you shall let live.","tok":[{"t":"And "},{"t":"Pharaoh","s":["H6547"],"a":[1]},{"t":" commanded all his "},{"t":"people","s":["H5971"],"a":[3]},{"t":", "},{"t":"saying","s":["H0559"],"a":[4]},{"t":", Every "},{"t":"son","s":["H1121"],"a":[6]},{"t":" who is "},{"t":"born","s":["H3209"],"a":[7]},{"t":" you shall "},{"t":"cast","s":["H7993"],"a":[9]},{"t":" into the "},{"t":"River","s":["H2975"],"a":[8]},{"t":", but every "},{"t":"daughter","s":["H1323"],"a":[11]},{"t":" you shall let live."}]}]}
