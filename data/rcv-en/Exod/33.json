64"],"a":[14]},{"t":", but his attendant "},{"t":"Joshua","s":["H3091"],"a":[16]},{"t":" the "},{"t":"son","s":["H1121"],"a":[17]},{"t":" of "},{"t":"Nun","s":["H5126"],"a":[18]},{"t":", a young "},{"t":"man","s":["H5288"],"a":[19]},{"t":", would not "},{"t":"depart","s":["H4185"],"a":[21]},{"t":" "},{"t":"out","s":["H8432"],"a":[22]},{"t":" of the "},{"t":"tent","s":["H0168"],"a":[23]},{"t":"."}]},{"n":12,"text":"And Moses said to Jehovah, See, You say to me, Bring up this people; but You have not let me know whom You will send with me. Yet You have said, I know you by name, and you have also found favor in My sight.","tok":[{"t":"And "},{"t":"Moses","s":["H4872"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":", "},{"t":"See","s":["H7200"],"a":[4]},{"t":", You "},{"t":"say","s":["H0559"],"a":[6]},{"t":" to me, Bring "},{"t":"up","s":["H5927"],"a":[8]},{"t":" this "},{"t":"people","s":["H5971"],"a":[10]},{"t":"; but You have not let me "},{"t":"know","s":["H3045"],"a":[14]},{"t":" whom You will "},{"t":"send","s":["H7971"],"a":[17]},{"t":" with me. Yet You have "},{"t":"said","s":["H0559"],"a":[20]},{"t":", I "},{"t":"know","s":["H3045"],"a":[21]},{"t":" you by "},{"t":"name","s":["H8034"],"a":[22]},{"t":", and you have also "},{"t":"found","s":["H4672"],"a":[24]},{"t":" favor in My "},{"t":"sight","s":["H5869"],"a":[26]},{"t":"."}]},{"n":13,"text":"Now therefore if I have found favor in Your sight, please let me know now Your ways, that I may know You, so that I may continue to find favor in Your sight. Consider also that this nation is Your people.","tok":[{"t":"Now therefore if I have "},{"t":"found","s":["H4672"],"a":[3]},{"t":" favor in Your "},{"t":"sight","s":["H5869"],"a":[5]},{"t":", please let me know now Your "},{"t":"ways","s":["H1870"],"a":[9]},{"t":", that I may "},{"t":"know","s":["H3045"],"a":[10]},{"t":" You, so that I may continue to "},{"t":"find","s":["H4672"],"a":[12]},{"t":" favor in Your "},{"t":"sight","s":["H5869"],"a":[14]},{"t":". "},{"t":"Consider","s":["H7200"],"a":[15]},{"t":" also that this "},{"t":"nation","s":["H1471"],"a":[18]},{"t":" is Your "},{"t":"people","s":["H5971"],"a":[17]},{"t":"."}]},{"n":14,"text":"And He said, My presence shall go with you, and I will give you rest.","tok":[{"t":"And He "},{"t":"said","s":["H0559"],"a":[0]},{"t":", My "},{"t":"presence","s":["H6440"],"a":[1]},{"t":" shall "},{"t":"go","s":["H3212"]},{"t":" with you, and I will give you "},{"t":"rest","s":["H5117"],"a":[3]},{"t":"."}]},{"n":15,"text":"And he said to Him, If Your presence does not go with us, do not bring us up from here.","tok":[{"t":"And he "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to Him, If Your "},{"t":"presence","s":["H6440"],"a":[4]},{"t":" does not "},{"t":"go","s":["H1980"],"a":[5]},{"t":" with us, do not bring us "},{"t":"up","s":["H5927"],"a":[7]},{"t":" from here."}]},{"n":16,"text":"For how then shall it be known that I have found favor in Your sight, I and Your people? Is it not by Your going with us, so that we, I and Your people, are distinct from all the other people who are on the face of the earth?","tok":[{"t":"For how then shall it be "},{"t":"known","s":["H3045"],"a":[1]},{"t":" that I have "},{"t":"found","s":["H4672"],"a":[4]},{"t":" favor in Your "},{"t":"sight","s":["H5869"],"a":[6]},{"t":", I and Your "},{"t":"people","s":["H5971"],"a":[8]},{"t":"? Is it not by Your going with us, so that we, I and Your "},{"t":"people","s":["H5971"],"a":[14]},{"t":", are distinct from all the other "},{"t":"people","s":["H5971"],"a":[16]},{"t":" who are on the "},{"t":"face","s":["H6440"],"a":[19]},{"t":" of the "},{"t":"earth","s":["H0127"],"a":[20]},{"t":"?"}]},{"n":17,"text":"And Jehovah said to Moses, I will do this thing also that you have spoken; for you have found favor in My sight, and I know you by name.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" 