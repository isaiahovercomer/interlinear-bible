{"v":1,"book":"Exod","ch":33,"verses":[{"n":1,"text":"Then Jehovah spoke to Moses, Depart; go up from here, you and the people whom you have brought up out of the land of Egypt, to the land of which I swore to Abraham, to Isaac, and to Jacob, saying, To your seed I will give it.","tok":[{"t":"Then "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"spoke","s":["H1696"],"a":[0]},{"t":" to "},{"t":"Moses","s":["H4872"],"a":[3]},{"t":", "},{"t":"Depart","s":["H3212"]},{"t":"; go "},{"t":"up","s":["H5927"],"a":[5]},{"t":" from here, you and the "},{"t":"people","s":["H5971"],"a":[8]},{"t":" whom you have brought "},{"t":"up","s":["H5927"],"a":[10]},{"t":" out of the "},{"t":"land","s":["H0776"],"a":[11]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[12]},{"t":", to the "},{"t":"land","s":["H0776"],"a":[14]},{"t":" of which I "},{"t":"swore","s":["H7650"],"a":[16]},{"t":" to "},{"t":"Abraham","s":["H0085"],"a":[17]},{"t":", to "},{"t":"Isaac","s":["H3327"],"a":[18]},{"t":", and to "},{"t":"Jacob","s":["H3290"],"a":[19]},{"t":", "},{"t":"saying","s":["H0559"],"a":[20]},{"t":", To your "},{"t":"seed","s":["H2233"],"a":[21]},{"t":" I will "},{"t":"give","s":["H5414"],"a":[22]},{"t":" it."}]},{"n":2,"text":"And I will send an Angel before you; and I will drive out the Canaanites, the Amorites, and the Hittites, and the Perizzites, the Hivites, and the Jebusites.","tok":[{"t":"And I will "},{"t":"send","s":["H7971"],"a":[0]},{"t":" an "},{"t":"Angel","s":["H4397"],"a":[2]},{"t":" "},{"t":"before","s":["H6440"],"a":[1]},{"t":" you; and I will drive "},{"t":"out","s":["H1644"],"a":[3]},{"t":" the "},{"t":"Canaanites","s":["H3669"],"a":[5]},{"t":", the "},{"t":"Amorites","s":["H0567"],"a":[6]},{"t":", and the "},{"t":"Hittites","s":["H2850"],"a":[7]},{"t":", and the "},{"t":"Perizzites","s":["H6522"],"a":[8]},{"t":", the "},{"t":"Hivites","s":["H2340"],"a":[9]},{"t":", and the "},{"t":"Jebusites","s":["H2983"],"a":[10]},{"t":"."}]},{"n":3,"text":"Go up to a land flowing with