 "},{"t":"met","s":["H7122"],"a":[3]},{"t":" with us. Let us "},{"t":"go","s":["H3212"]},{"t":" a "},{"t":"three","s":["H7969"],"a":[8]},{"t":" "},{"t":"days","s":["H3117"],"a":[9]},{"t":"’ "},{"t":"journey","s":["H1870"],"a":[7]},{"t":" into the wilderness that we may "},{"t":"sacrifice","s":["H2076"],"a":[11]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[12]},{"t":" our "},{"t":"God","s":["H0430"],"a":[13]},{"t":"; otherwise He will "},{"t":"fall","s":["H6293"],"a":[15]},{"t":" upon us with "},{"t":"pestilence","s":["H1698"],"a":[16]},{"t":" or "},{"t":"sword","s":["H2719"],"a":[18]},{"t":"."}]},{"n":4,"text":"Then the king of Egypt said to them, Moses and Aaron, why are you trying to release the people from their work? Get back to your burdens.","tok":[{"t":"Then the "},{"t":"king","s":["H4428"],"a":[2]},{"t":" of "},{"t":"Egypt","s":["H4714"],"a":[3]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to them, "},{"t":"Moses","s":["H4872"],"a":[5]},{"t":" and "},{"t":"Aaron","s":["H0175"],"a":[6]},{"t":", why are you trying to release the "},{"t":"people","s":["H5971"],"a":[9]},{"t":" from their "},{"t":"work","s":["H4639"],"a":[10]},{"t":"? "},{"t":"Get","s":["H3212"]},{"t":" back to your "},{"t":"burdens","s":["H5450"],"a":[12]},{"t":"."}]},{"n":5,"text":"And Pharaoh said, Look, the people of the land are now many, yet you want them to cease from their burdens.","tok":[{"t":"And "},{"t":"Pharaoh","s":["H6547"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":", Look, the "},{"t":"people","s":["H5971"],"a":[5]},{"t":" of the "},{"t":"land","s":["H0776"],"a":[6]},{"t":" are now "},{"t":"many","s":["H7227"],"a":[3]},{"t":", yet you want them to cease from their "},{"t":"burdens","s":["H5450"],"a":[9]},{"t":"."}]},{"n":6,"text":"And the same day Pharaoh commanded the taskmasters of the people and their officers, saying,","tok":[{"t":"And the same "},{"t":"day","s":["H3117"],"a":[2]},{"t":" "},{"t":"Pharaoh","s":["H6547"],"a":[1]},{"t":" "},{"t":"comma