{"v":1,"book":"1Sam","ch":8,"verses":[{"n":1,"text":"Now when Samuel was old, he made his sons judges over Israel.","tok":[{"t":"Now when "},{"t":"Samuel","s":["H8050"],"a":[3]},{"t":" was "},{"t":"old","s":["H2204"],"a":[2]},{"t":", he "},{"t":"made","s":["H7760"],"a":[4]},{"t":" his "},{"t":"sons","s":["H1121"],"a":[6]},{"t":" "},{"t":"judges","s":["H8199"],"a":[7]},{"t":" over "},{"t":"Israel","s":["H3478"],"a":[8]},{"t":"."}]},{"n":2,"text":"And the name of his firstborn son was Joel, and the name of his second was Abijah; they were judges in Beer-sheba.","tok":[{"t":"And the "},{"t":"name","s":["H8034"],"a":[1]},{"t":" of his "},{"t":"firstborn","s":["H1121"],"a":[2]},{"t":" son was "},{"t":"Joel","s":["H3100"],"a":[4]},{"t":", and the "},{"t":"name","s":["H8034"],"a":[5]},{"t":" of his "},{"t":"second","s":["H4932"],"a":[6]},{"t":" was Abijah; they were "},{"t":"judges","s":["H8199"],"a":[8]},{"t":" in "},{"t":"Beer","s":["H0884"],"a":[9]},{"t":"-"},{"t":"sheba","s":["H0884"],"a":[9]},{"t":"."}]},{"n":3,"text":"But his sons did not follow in his ways, but turned aside after unjust gain and took bribes and perverted justice.","tok":[{"t":"But his "},{"t":"sons","s":["H1121"],"a":[2]},{"t":" did not follow in his "},{"t":"ways","s":["H1870"],"a":[3]},{"t":", but turned "},{"t":"aside","s":["H5186"],"a":[4]},{"t":" "},{"t":"after","s":["H0310"],"a":[5]},{"t":" unjust gain and "},{"t":"took","s":["H3947"],"a":[7]},{"t":" "},{"t":"bribes","s":["H7810"],"a":[8]},{"t":" and "},{"t":"perverted","s":["H5186"],"a":[9]},{"t":" "},{"t":"justice","s":["H4941"],"a":[10]},{"t":"."}]},{"n":4,"text":"Then all the elders of Israel gathered together and came to Samuel at Ramah.","tok":[{"t":"Then all the "},{"t":"elders","s":["H2205"],"a":[2]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":" gathered "},{"t":"together","s":["H6908"],"a":[0]},{"t":" and "},{"t":"came","s":["H0935"],"a":[4]},{"t":" to "},{"t":"Samuel","s":["H8050"],"a":[6]},{"t":" at "},{"t":"Ramah","s":["H7414"],"a":[7]},{"t":"."}]},{"n":5,"text":"And they said to him, You are now old, and your sons do not follow in your ways. Appoint now for us a king to judge us like all the nations.","tok":[{"t":"And they "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to him, You are now "},{"t":"old","s":["H2204"],"a":[4]},{"t":", and your "},{"t":"sons","s":["H1121"],"a":[5]},{"t":" do not follow in your "},{"t":"ways","s":["H1870"],"a":[8]},{"t":". Appoint now for us a "},{"t":"king","s":["H4428"],"a":[12]},{"t":" to "},{"t":"judge","s":["H8199"],"a":[13]},{"t":" us like all the "},{"t":"nations","s":["H1471"],"a":[15]},{"t":"."}]},{"n":6,"text":"But the matter displeased Samuel when they said, Give us a king to judge us. Then Samuel prayed to Jehovah.","tok":[{"t":"But the "},{"t":"matter","s":["H1697"],"a":[1]},{"t":" "},{"t":"displeased","s":["H3415"]},{"t":" "},{"t":"Samuel","s":["H8050"],"a":[3]},{"t":" when they "},{"t":"said","s":["H0559"],"a":[5]},{"t":", "},{"t":"Give","s":["H5414"],"a":[6]},{"t":" us a "},{"t":"king","s":["H4428"],"a":[8]},{"t":" to "},{"t":"judge","s":["H8199"],"a":[9]},{"t":" us. Then "},{"t":"Samuel","s":["H8050"],"a":[11]},{"t":" "},{"t":"prayed","s":["H6419"],"a":[10]},{"t":" to "},{"t":"Jehovah","s":["H3068"],"a":[13]},{"t":"."}]},{"n":7,"text":"And Jehovah said to Samuel, Listen to the voice of the people according to all that they have said to you; for it is not you whom they have rejected, but they have rejected Me from being King over them.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to "},{"t":"Samuel","s":["H8050"],"a":[3]},{"t":", "},{"t":"Listen","s":["H8085"],"a":[4]},{"t":" to the "},{"t":"voice","s":["H6963"],"a":[5]},{"t":" of the "},{"t":"people","s":["H5971"],"a":[6]},{"t":" according to all that they have said to you; for it is not you whom they have "},{"t":"rejected","s":["H3988"],"a":[17]},{"t":", but they have "},{"t":"rejected","s":["H3988"],"a":[14]},{"t":" Me from being King over them."}]},{"n":8,"text":"Like all the deeds that they have done since the day that I brought them up out of Egypt to this very day by forsaking Me and serving other gods, so they do also to you.","tok":[{"t":"Like all the deeds that they have "},{"t":"done","s":["H6213"],"a":[3]},{"t":" since the "},{"t":"day","s":["H3117"],"a":[4]},{"t":" that I brought them "},{"t":"up","s":["H5927"],"a":[5]},{"t":" out of "},{"t":"Egypt","s":["H4714"],"a":[7]},{"t":" to this very "},{"t":"day","s":["H3117"],"a":[9]},{"t":" by forsaking Me and "},{"t":"serving","s":["H5647"],"a":[12]},{"t":" "},{"t":"other","s":["H0312"],"a":[14]},{"t":" "},{"t":"gods","s":["H0430"],"a":[13]},{"t":", so they "},{"t":"do","s":["H6213"],"a":[17]},{"t":" also to you."}]},{"n":9,"text":"Now therefore listen to their voice, but you shall solemnly warn them and declare to them the practice of the king who will reign over them.","tok":[{"t":"Now therefore "},{"t":"listen","s":["H8085"],"a":[1]},{"t":" to their "},{"t":"voice","s":["H6963"],"a":[2]},{"t":", but you shall "},{"t":"solemnly","s":["H5749"],"a":[6]},{"t":" warn them and declare to them the practice of the "},{"t":"king","s":["H4428"],"a":[11]},{"t":" who will "},{"t":"reign","s":["H4427"],"a":[13]},{"t":" over them."}]},{"n":10,"text":"So Samuel spoke all the words of Jehovah to the people, who had asked him for a king.","tok":[{"t":"So "},{"t":"Samuel","s":["H8050"],"a":[1]},{"t":" spoke all the "},{"t":"words","s":["H1697"],"a":[4]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":" to the "},{"t":"people","s":["H5971"],"a":[7]},{"t":", who had "},{"t":"asked","s":["H7592"],"a":[8]},{"t":" him for a "},{"t":"king","s":["H4428"],"a":[10]},{"t":"."}]},{"n":11,"text":"And he said, This will be the practice of the king who will reign over you: He will take your sons and appoint them for himself to his chariots and as his horsemen, and they will run before his chariots;","tok":[{"t":"And he "},{"t":"said","s":["H0559"],"a":[0]},{"t":", This will be the practice of the "},{"t":"king","s":["H4428"],"a":[4]},{"t":" who will "},{"t":"reign","s":["H4427"],"a":[6]},{"t":" over you: He will "},{"t":"take","s":["H3947"],"a":[10]},{"t":" your "},{"t":"sons","s":["H1121"],"a":[9]},{"t":" and "},{"t":"appoint","s":["H7760"],"a":[11]},{"t":" them for himself to his "},{"t":"chariots","s":["H4818"],"a":[13]},{"t":" and as his "},{"t":"horsemen","s":["H6571"],"a":[14]},{"t":", and they will "},{"t":"run","s":["H7323"],"a":[15]},{"t":" "},{"t":"before","s":["H6440"],"a":[16]},{"t":" his "},{"t":"chariots","s":["H4818"],"a":[17]},{"t":";"}]},{"n":12,"text":"And he will appoint them for himself as captains of thousands and as captains of fifties, and to plow his ground and reap his harvest, and to make his instruments of war and the equipment for his chariots.","tok":[{"t":"And he will "},{"t":"appoint","s":["H7760"],"a":[0]},{"t":" them for himself as "},{"t":"captains","s":["H8269"],"a":[4]},{"t":" of "},{"t":"thousands","s":["H0505"],"a":[3]},{"t":" and as "},{"t":"captains","s":["H8269"],"a":[2]},{"t":" of "},{"t":"fifties","s":["H2572"],"a":[5]},{"t":", and to plow his "},{"t":"ground","s":["H2758"],"a":[7]},{"t":" and "},{"t":"reap","s":["H7114"],"a":[8]},{"t":" his "},{"t":"harvest","s":["H7105"],"a":[9]},{"t":", and to "},{"t":"make","s":["H6213"],"a":[10]},{"t":" his "},{"t":"instruments","s":["H3627"],"a":[11]},{"t":" of "},{"t":"war","s":["H4421"],"a":[12]},{"t":" and the equipment for his "},{"t":"chariots","s":["H7393"],"a":[14]},{"t":"."}]},{"n":13,"text":"And he will take your daughters to be perfumers and cooks and bakers.","tok":[{"t":"And he will "},{"t":"take","s":["H3947"],"a":[2]},{"t":" your "},{"t":"daughters","s":["H1323"],"a":[1]},{"t":" to be "},{"t":"perfumers","s":["H7548"],"a":[3]},{"t":" and "},{"t":"cooks","s":["H2879"],"a":[4]},{"t":" and "},{"t":"bakers","s":["H0644"],"a":[5]},{"t":"."}]},{"n":14,"text":"And he will take your best fields and vineyards and olive groves, and give them to his servants.","tok":[{"t":"And he will "},{"t":"take","s":["H3947"],"a":[6]},{"t":" your "},{"t":"best","s":["H2896"],"a":[5]},{"t":" "},{"t":"fields","s":["H7704"],"a":[1]},{"t":" and "},{"t":"vineyards","s":["H3754"],"a":[3]},{"t":" and olive groves, and "},{"t":"give","s":["H5414"],"a":[7]},{"t":" them to his "},{"t":"servants","s":["H5650"],"a":[8]},{"t":"."}]},{"n":15,"text":"And he will exact a tenth of your seed and of your vineyards, and give it to his eunuchs and servants.","tok":[{"t":"And he will exact a "},{"t":"tenth","s":["H6237"],"a":[2]},{"t":" of your "},{"t":"seed","s":["H2233"],"a":[0]},{"t":" and of your "},{"t":"vineyards","s":["H3754"],"a":[1]},{"t":", and "},{"t":"give","s":["H5414"],"a":[3]},{"t":" it to his eunuchs and "},{"t":"servants","s":["H5650"],"a":[5]},{"t":"."}]},{"n":16,"text":"And he will take your male servants and your female servants and your best young men and your donkeys, and put them to his work.","tok":[{"t":"And he will "},{"t":"take","s":["H3947"],"a":[9]},{"t":" your male servants and your female servants and your best young "},{"t":"men","s":["H0970"],"a":[5]},{"t":" and your donkeys, and "},{"t":"put","s":["H6213"],"a":[10]},{"t":" them to his "},{"t":"work","s":["H4399"],"a":[11]},{"t":"."}]},{"n":17,"text":"He will exact a tenth of your flocks, and you will be his servants.","tok":[{"t":"He will exact a "},{"t":"tenth","s":["H6237"],"a":[1]},{"t":" of your flocks, and you will be his "},{"t":"servants","s":["H5650"],"a":[5]},{"t":"."}]},{"n":18,"text":"And you will cry out in that day on account of your king, whom you have chosen for yourselves; but Jehovah will not answer you in that day.","tok":[{"t":"And you will cry "},{"t":"out","s":["H2199"],"a":[0]},{"t":" in that "},{"t":"day","s":["H3117"],"a":[1]},{"t":" on account of your "},{"t":"king","s":["H4428"],"a":[4]},{"t":", whom you have "},{"t":"chosen","s":["H0977"],"a":[6]},{"t":" for yourselves; but "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":" will not answer you in that "},{"t":"day","s":["H3117"],"a":[12]},{"t":"."}]},{"n":19,"text":"But the people refused to listen to the voice of Samuel, and they said, No; but there will be a king over us,","tok":[{"t":"But the "},{"t":"people","s":["H5971"],"a":[1]},{"t":" "},{"t":"refused","s":["H3985"],"a":[0]},{"t":" to "},{"t":"listen","s":["H8085"],"a":[2]},{"t":" to the "},{"t":"voice","s":["H6963"],"a":[3]},{"t":" of "},{"t":"Samuel","s":["H8050"],"a":[4]},{"t":", and they "},{"t":"said","s":["H0559"],"a":[5]},{"t":", No; but there will be a "},{"t":"king","s":["H4428"],"a":[9]},{"t":" over us,"}]},{"n":20,"text":"That we also may be like all the nations, and that our king may judge us and go out before us and fight our battles.","tok":[{"t":"That we also may be like all the "},{"t":"nations","s":["H1471"],"a":[4]},{"t":", and that our "},{"t":"king","s":["H4428"],"a":[6]},{"t":" may "},{"t":"judge","s":["H8199"],"a":[5]},{"t":" us and go "},{"t":"out","s":["H3318"],"a":[7]},{"t":" "},{"t":"before","s":["H6440"],"a":[8]},{"t":" us and "},{"t":"fight","s":["H3898"],"a":[9]},{"t":" our "},{"t":"battles","s":["H4421"],"a":[11]},{"t":"."}]},{"n":21,"text":"And Samuel heard all the words of the people, and he spoke them in the hearing of Jehovah.","tok":[{"t":"And "},{"t":"Samuel","s":["H8050"],"a":[1]},{"t":" "},{"t":"heard","s":["H8085"],"a":[0]},{"t":" all the "},{"t":"words","s":["H1697"],"a":[4]},{"t":" of the "},{"t":"people","s":["H5971"],"a":[5]},{"t":", and he spoke them in the hearing of "},{"t":"Jehovah","s":["H3068"],"a":[8]},{"t":"."}]},{"n":22,"text":"Then Jehovah said to Samuel, Listen to their voice, and appoint a king to them. And Samuel said to the men of Israel, Go, each one to his city.","tok":[{"t":"Then "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to "},{"t":"Samuel","s":["H8050"],"a":[3]},{"t":", "},{"t":"Listen","s":["H8085"],"a":[4]},{"t":" to their "},{"t":"voice","s":["H6963"],"a":[5]},{"t":", and "},{"t":"appoint","s":["H4427"],"a":[6]},{"t":" a "},{"t":"king","s":["H4428"],"a":[8]},{"t":" to them. And "},{"t":"Samuel","s":["H8050"],"a":[10]},{"t":" "},{"t":"said","s":["H0559"],"a":[9]},{"t":" to the "},{"t":"men","s":["H0582"],"a":[12]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[13]},{"t":", "},{"t":"Go","s":["H3212"]},{"t":", each one to his "},{"t":"city","s":["H5892"],"a":[16]},{"t":"."}]}]}
