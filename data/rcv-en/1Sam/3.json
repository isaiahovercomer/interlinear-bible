e and stood by and called as at the other times, Samuel! Samuel! And Samuel said, Speak, for Your servant is listening.","tok":[{"t":"Then "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"came","s":["H0935"],"a":[0]},{"t":" and "},{"t":"stood","s":["H3320"],"a":[2]},{"t":" by and "},{"t":"called","s":["H7121"],"a":[3]},{"t":" as at the other "},{"t":"times","s":["H6471"],"a":[4]},{"t":", "},{"t":"Samuel","s":["H8050"],"a":[6]},{"t":"! "},{"t":"Samuel","s":["H8050"],"a":[7]},{"t":"! And "},{"t":"Samuel","s":["H8050"],"a":[9]},{"t":" "},{"t":"said","s":["H0559"],"a":[8]},{"t":", "},{"t":"Speak","s":["H1696"],"a":[10]},{"t":", for Your "},{"t":"servant","s":["H5650"],"a":[13]},{"t":" is "},{"t":"listening","s":["H8085"],"a":[12]},{"t":"."}]},{"n":11,"text":"And Jehovah said to Samuel, I am about to do something in Israel which will make both ears of anyone who hears of it tingle.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"said","s":["H0559"],"a":[0]},{"t":" to "},{"t":"Samuel","s":["H8050"],"a":[3]},{"t":", I am about to "},{"t":"do","s":["H6213"],"a":[6]},{"t":" "},{"t":"something","s":["H1697"],"a":[7]},{"t":" in "},{"t":"Israel","s":["H3478"],"a":[8]},{"t":" which will make "},{"t":"both","s":["H8147"],"a":[13]},{"t":" "},{"t":"ears","s":["H0241"],"a":[14]},{"t":" of anyone who "},{"t":"hears","s":["H8085"],"a":[11]},{"t":" of it "},{"t":"tingle","s":["H6750"],"a":[12]},{"t":"."}]},{"n":12,"text":"On that day I will fulfill against Eli all that I have spoken concerning his house, from beginning to end.","tok":[{"t":"On that "},{"t":"day","s":["H3117"],"a":[0]},{"t":" I will fulfill against "},{"t":"Eli","s":["H5941"],"a":[4]},{"t":" all that I have "},{"t":"spoken","s":["H1696"],"a":[8]},{"t":" "},{"t":"concerning","s":["H0413"],"a":[3]},{"t":" his "},{"t":"house","s":["H1004"],"a":[10]},{"t":", from "},{"t":"beginning","s":["H2490"],"a":[11]},{"t":" to "},{"t":"end","s":["H3615"],"a":[12]},{"t":"."}]},{"n":13,"text":"For I ha