"H8050"],"a":[3]},{"t":". And he said, Here I am."}]},{"n":5,"text":"And he ran to Eli and said, Here I am, for you called me. And he said, I did not call. Go back and lie down. And he went and lay down.","tok":[{"t":"And he "},{"t":"ran","s":["H7323"],"a":[0]},{"t":" to "},{"t":"Eli","s":["H5941"],"a":[2]},{"t":" and "},{"t":"said","s":["H0559"],"a":[3]},{"t":", Here "},{"t":"I","s":["H2009"]},{"t":" am, for you "},{"t":"called","s":["H7121"],"a":[10]},{"t":" me. And he "},{"t":"said","s":["H0559"],"a":[8]},{"t":", I did not call. Go back and lie "},{"t":"down","s":["H7901"],"a":[12]},{"t":". And "},{"t":"he","s":["H7725"],"a":[11]},{"t":" "},{"t":"went","s":["H3212"]},{"t":" and lay "},{"t":"down","s":["H7901"],"a":[14]},{"t":"."}]},{"n":6,"text":"And Jehovah called yet again, Samuel. And Samuel rose up and went to Eli and said, Here I am, for you called me. And he said, I did not call, my son. Go back and lie down.","tok":[{"t":"And "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" "},{"t":"called","s":["H7121"],"a":[2]},{"t":" yet "},{"t":"again","s":["H3254"],"a":[0]},{"t":", "},{"t":"Samuel","s":["H8050"],"a":[6]},{"t":". And "},{"t":"Samuel","s":["H8050"],"a":[4]},{"t":" rose up and "},{"t":"went","s":["H3212"]},{"t":" to "},{"t":"Eli","s":["H5941"],"a":[9]},{"t":" and "},{"t":"said","s":["H0559"],"a":[10]},{"t":", Here I am, for you "},{"t":"called","s":["H7121"],"a":[17]},{"t":" me. And he said, I did not "},{"t":"call","s":["H7121"],"a":[13]},{"t":", my "},{"t":"son","s":["H1121"],"a":[18]},{"t":". Go back and lie "},{"t":"down","s":["H7901"],"a":[20]},{"t":"."}]},{"n":7,"text":"Now Samuel did not yet know Jehovah, and the word of Jehovah had not yet been revealed to him.","tok":[{"t":"Now "},{"t":"Samuel","s":["H8050"],"a":[0]},{"t":" did not "},{"t":"yet","s":["H2962"],"a":[1]},{"t":" "},{"t":"know","s":["H3045"],"a":[2]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[4]},{"t":", and the "},{"t":"word","s":["H1697"],"a":[8]},{"t":" of "},{"t":"Jehovah","s":["