{"v":1,"book":"Lam","ch":5,"verses":[{"n":1,"text":"Remember, O Jehovah, what has come upon us; Look and see our reproach.","tok":[{"t":"Remember","s":["H2142"],"a":[0]},{"t":", O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", what has come upon us; Look and see our "},{"t":"reproach","s":["H2781"],"a":[8]},{"t":"."}]},{"n":2,"text":"Our inheritance has been turned over to strangers, Our houses to foreigners.","tok":[{"t":"Our "},{"t":"inheritance","s":["H5159"],"a":[0]},{"t":" has been "},{"t":"turned","s":["H2015"],"a":[1]},{"t":" over to "},{"t":"strangers","s":["H2114"],"a":[2]},{"t":", Our "},{"t":"houses","s":["H1004"],"a":[3]},{"t":" to "},{"t":"foreigners","s":["H5237"],"a":[4]},{"t":"."}]},{"n":3,"text":"We are orphans without father; Our mothers are like widows.","tok":[{"t":"We are "},{"t":"orphans","s":["H3490"],"a":[0]},{"t":" without father; Our "},{"t":"mothers","s":["H0517"],"a":[4]},{"t":" are like "},{"t":"widows","s":["H0490"],"a":[5]},{"t":"."}]},{"n":4,"text":"We have drunk our water for money; Our wood comes to us at a price.","tok":[{"t":"We have drunk our "},{"t":"water","s":["H4325"],"a":[0]},{"t":" for "},{"t":"money","s":["H3701"],"a":[1]},{"t":"; Our "},{"t":"wood","s":["H6086"],"a":[3]},{"t":" comes to us at a price."}]},{"n":5,"text":"On our necks are our pursuers; We are weary; we have no rest.","tok":[{"t":"On our "},{"t":"necks","s":["H6677"],"a":[1]},{"t":" are our pursuers; We are weary; we have no "},{"t":"rest","s":["H5117"],"a":[5]},{"t":"."}]},{"n":6,"text":"We have given our hand to Egypt And to Assyria, so as to be satisfied with bread.","tok":[{"t":"We have "},{"t":"given","s":["H5414"],"a":[1]},{"t":" our "},{"t":"hand","s":["H3027"],"a":[2]},{"t":" to Egypt And to Assyria, so as to be "},{"t":"satisfied","s":["H7646"],"a":[4]},{"t":" with "},{"t":"bread","s":["H3899"],"a":[5]},{"t":"."}]},{"n":7,"text":"Our fathers sinned and they are not, And we ourselves bear their iniquities.","tok":[{"t":"Our "},{"t":"fathers","s":["H0001"],"a":[0]},{"t":" "},{"t":"sinned","s":["H2398"],"a":[1]},{"t":" and they are "},{"t":"not","s":["H0369"],"a":[2]},{"t":", And we ourselves bear their "},{"t":"iniquities","s":["H5771"],"a":[4]},{"t":"."}]},{"n":8,"text":"Slaves rule over us; There is no one to deliver us from their hand.","tok":[{"t":"Slaves","s":["H5650"],"a":[0]},{"t":" "},{"t":"rule","s":["H4910"],"a":[1]},{"t":" over us; There is no one to "},{"t":"deliver","s":["H6561"],"a":[3]},{"t":" us from their "},{"t":"hand","s":["H3027"],"a":[5]},{"t":"."}]},{"n":9,"text":"We get our bread at the risk of our lives Because of the sword from the wilderness.","tok":[{"t":"We get our "},{"t":"bread","s":["H3899"],"a":[2]},{"t":" at the risk of our "},{"t":"lives","s":["H5315"],"a":[0]},{"t":" "},{"t":"Because","s":["H6440"],"a":[3]},{"t":" of the "},{"t":"sword","s":["H2719"],"a":[4]},{"t":" from the "},{"t":"wilderness","s":["H4057"],"a":[5]},{"t":"."}]},{"n":10,"text":"Our skin is black like an oven Because of the burning heat of famine.","tok":[{"t":"Our "},{"t":"skin","s":["H5785"],"a":[0]},{"t":" is "},{"t":"black","s":["H3648"],"a":[2]},{"t":" like an "},{"t":"oven","s":["H8574"],"a":[1]},{"t":" "},{"t":"Because","s":["H6440"],"a":[3]},{"t":" of the burning heat of "},{"t":"famine","s":["H7458"],"a":[5]},{"t":"."}]},{"n":11,"text":"They have ravished the women in Zion, The virgins in the cities of Judah.","tok":[{"t":"They have "},{"t":"ravished","s":["H6031"],"a":[2]},{"t":" the "},{"t":"women","s":["H0802"],"a":[0]},{"t":" in "},{"t":"Zion","s":["H6726"],"a":[1]},{"t":", The "},{"t":"virgins","s":["H1330"],"a":[3]},{"t":" in the "},{"t":"cities","s":["H5892"],"a":[4]},{"t":" of "},{"t":"Judah","s":["H3063"],"a":[5]},{"t":"."}]},{"n":12,"text":"Princes were hanged by them. The faces of the elders were not honored.","tok":[{"t":"Princes","s":["H8269"],"a":[0]},{"t":" were hanged by them. The "},{"t":"faces","s":["H6440"],"a":[3]},{"t":" of the "},{"t":"elders","s":["H2205"],"a":[4]},{"t":" were not honored."}]},{"n":13,"text":"The young men bore the mill, And the young boys stumbled under the wood.","tok":[{"t":"The "},{"t":"young","s":["H5375"],"a":[2]},{"t":" "},{"t":"men","s":["H0970"],"a":[0]},{"t":" bore the mill, And the young boys stumbled under the "},{"t":"wood","s":["H6086"],"a":[4]},{"t":"."}]},{"n":14,"text":"The old men have ceased from the gate, The young men from their music.","tok":[{"t":"The old men have "},{"t":"ceased","s":["H7673"],"a":[2]},{"t":" from the "},{"t":"gate","s":["H8179"],"a":[1]},{"t":", The young "},{"t":"men","s":["H0970"],"a":[3]},{"t":" from their music."}]},{"n":15,"text":"The joy of our heart has ceased; Our dance has been turned into mourning.","tok":[{"t":"The "},{"t":"joy","s":["H4885"],"a":[1]},{"t":" of our "},{"t":"heart","s":["H3820"],"a":[2]},{"t":" has "},{"t":"ceased","s":["H7673"],"a":[0]},{"t":"; Our "},{"t":"dance","s":["H4234"],"a":[5]},{"t":" has been "},{"t":"turned","s":["H2015"],"a":[3]},{"t":" into "},{"t":"mourning","s":["H0060"],"a":[4]},{"t":"."}]},{"n":16,"text":"The crown has fallen from our head. Woe to us! For we have sinned.","tok":[{"t":"The "},{"t":"crown","s":["H5850"],"a":[1]},{"t":" has "},{"t":"fallen","s":["H5307"],"a":[0]},{"t":" from our "},{"t":"head","s":["H7218"],"a":[2]},{"t":". "},{"t":"Woe","s":["H0188"],"a":[3]},{"t":" to us! For we have "},{"t":"sinned","s":["H2398"],"a":[7]},{"t":"."}]},{"n":17,"text":"Because of this our heart is faint; Because of these things our eyes are dim;","tok":[{"t":"Because of this our "},{"t":"heart","s":["H3820"],"a":[4]},{"t":" is "},{"t":"faint","s":["H1739"],"a":[3]},{"t":"; Because of these things our "},{"t":"eyes","s":["H5869"],"a":[8]},{"t":" are "},{"t":"dim","s":["H2821"],"a":[7]},{"t":";"}]},{"n":18,"text":"Because of Mount Zion, which is desolate — Foxes rove in it.","tok":[{"t":"Because of Mount "},{"t":"Zion","s":["H6726"],"a":[2]},{"t":", which is "},{"t":"desolate","s":["H8074"],"a":[3]},{"t":" — "},{"t":"Foxes","s":["H7776"],"a":[4]},{"t":" "},{"t":"rove","s":["H1980"],"a":[5]},{"t":" in it."}]},{"n":19,"text":"You, O Jehovah, abide forever; Your throne is from generation to generation.","tok":[{"t":"You, O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", abide forever; Your "},{"t":"throne","s":["H3678"],"a":[4]},{"t":" is from "},{"t":"generation","s":["H1755"],"a":[5]},{"t":" to "},{"t":"generation","s":["H1755"],"a":[6]},{"t":"."}]},{"n":20,"text":"Why do You forget us forever And forsake us for so long a time?","tok":[{"t":"Why do You "},{"t":"forget","s":["H7911"],"a":[2]},{"t":" us forever And "},{"t":"forsake","s":["H5800"],"a":[3]},{"t":" us for so "},{"t":"long","s":["H0753"],"a":[4]},{"t":" a "},{"t":"time","s":["H3117"],"a":[5]},{"t":"?"}]},{"n":21,"text":"Turn us back to You, O Jehovah, and we will be turned; Renew our days as before.","tok":[{"t":"Turn","s":["H7725"],"a":[0]},{"t":" us back to You, O "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":", and we will be "},{"t":"turned","s":["H7725"],"a":[3]},{"t":"; "},{"t":"Renew","s":["H2318"],"a":[4]},{"t":" our "},{"t":"days","s":["H3117"],"a":[5]},{"t":" as "},{"t":"before","s":["H6924"],"a":[6]},{"t":"."}]},{"n":22,"text":"Or have You utterly rejected us? Are You exceedingly angry with us?","tok":[{"t":"Or have You "},{"t":"utterly","s":["H3988"],"a":[2]},{"t":" "},{"t":"rejected","s":["H3988"],"a":[3]},{"t":" us? Are You exceedingly angry with us?"}]}]}
