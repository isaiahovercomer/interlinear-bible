":" to "},{"t":"hate","s":["H8130"],"a":[3]},{"t":"; A "},{"t":"time","s":["H6256"],"a":[4]},{"t":" for "},{"t":"war","s":["H4421"],"a":[5]},{"t":", and a "},{"t":"time","s":["H6256"],"a":[6]},{"t":" for "},{"t":"peace","s":["H7965"],"a":[7]},{"t":"."}]},{"n":9,"text":"What profit does the worker have in that on which he labors?","tok":[{"t":"What "},{"t":"profit","s":["H3504"],"a":[1]},{"t":" does the worker have in that on which he labors?"}]},{"n":10,"text":"I have seen the travail that God has given the children of men to travail in.","tok":[{"t":"I have "},{"t":"seen","s":["H7200"],"a":[0]},{"t":" the "},{"t":"travail","s":["H6045"],"a":[2]},{"t":" that "},{"t":"God","s":["H0430"],"a":[5]},{"t":" has "},{"t":"given","s":["H5414"],"a":[4]},{"t":" the "},{"t":"children","s":["H1121"],"a":[6]},{"t":" of "},{"t":"men","s":["H0120"],"a":[7]},{"t":" to "},{"t":"travail","s":["H6031"],"a":[8]},{"t":" in."}]},{"n":11,"text":"He has made everything beautiful in its own time; also He has put eternity in their heart, yet so that man does not find out what God has done from the beginning to the end.","tok":[{"t":"He has "},{"t":"made","s":["H6213"],"a":[2]},{"t":" everything "},{"t":"beautiful","s":["H3303"],"a":[3]},{"t":" in its own "},{"t":"time","s":["H6256"],"a":[4]},{"t":"; also He has put eternity in their "},{"t":"heart","s":["H3820"],"a":[9]},{"t":", yet so "},{"t":"that","s":["H1097"],"a":[10]},{"t":" "},{"t":"man","s":["H0120"],"a":[14]},{"t":" does not find "},{"t":"out","s":["H4672"],"a":[13]},{"t":" "},{"t":"what","s":["H4639"],"a":[16]},{"t":" "},{"t":"God","s":["H0430"],"a":[19]},{"t":" has done from the "},{"t":"beginning","s":["H7218"],"a":[20]},{"t":" to the "},{"t":"end","s":["H5490"],"a":[22]},{"t":"."}]},{"n":12,"text":"I know that there is nothing better for them than to rejoice and do good in their lifetime;","tok":[{"t":"I "},{"t":"know","s":["H3045"],"a":[0]},{"t":" that there is nothing better for them than to "},{"t":"rejoice","s":["H8055"],"a":[7]},{"t":" and "},{"t":"do","s":["H6213"],"a":[8]},{"t":" "},{"t":"good","s":["H2896"],"a":[9]},{"t":" in their lifetime;"}]},{"n":13,"text":"Moreover, that every man should eat and drink and taste enjoyment in all his labor; it is the gift of God.","tok":[{"t":"Moreover, that every "},{"t":"man","s":["H0120"],"a":[2]},{"t":" should "},{"t":"eat","s":["H0398"],"a":[3]},{"t":" and "},{"t":"drink","s":["H8354"],"a":[4]},{"t":" and taste enjoyment in all his labor; it is the "},{"t":"gift","s":["H4991"],"a":[9]},{"t":" of "},{"t":"God","s":["H0430"],"a":[10]},{"t":"."}]},{"n":14,"text":"I know that whatever God does, it will be forever; nothing can be added to it, nor can anything be taken from it. God has so done, that all would fear Him.","tok":[{"t":"I "},{"t":"know","s":["H3045"],"a":[0]},{"t":" that whatever "},{"t":"God","s":["H0430"],"a":[5]},{"t":" does, it will be forever; "},{"t":"nothing","s":["H0369"],"a":[10]},{"t":" can be added to it, nor can anything be "},{"t":"taken","s":["H1639"],"a":[14]},{"t":" from it. "},{"t":"God","s":["H0430"],"a":[15]},{"t":" has so done, that all would "},{"t":"fear","s":["H3372"],"a":[17]},{"t":" "},{"t":"Him","s":["H6440"],"a":[18]},{"t":"."}]},{"n":15,"text":"That which is has already been, and that which will be has already been; and God seeks what has passed.","tok":[{"t":"That which is has already been, and that which will be has "},{"t":"already","s":["H3528"],"a":[6]},{"t":" been; and "},{"t":"God","s":["H0430"],"a":[8]},{"t":" seeks what has passed."}]},{"n":16,"text":"Moreover I saw under the sun that in the place of judgment, wickedness is there; and in the place of righteousness, wickedness is there.","tok":[{"t":"Moreover I "},{"t":"saw","s":["H7200"],"a":[1]},{"t":" under the "},{"t":"sun","s":["H8121"],"a":[3]},{"t":" that in the "},{"t":"place","s":["H4725"],"a":[4]},{"t":" of "},{"t":"judgment","s":["H4941"],"a":[5]},{"t":", "},{"t":"wickedness","s":["H7562"],"a":[7]},{"t":" is there; and in the "},{"t":"place","s":["H4725"],"a":[8]},{"t":" of "},{"t":"righteousness","s":["H6664"],"a":[9]},{"t":", wickedness is there."}]},{"n":17,"text":"I said in my heart, God will judge the righteous and the wicked; for there is a time there for every purpose and every work.","tok":[{"t":"I "},{"t":"said","s":["H0559"],"a":[0]},{"t":" in my "},{"t":"heart","s":["H3820"],"a":[2]},{"t":", "},{"t":"God","s":["H0430"],"a":[8]},{"t":" will "},{"t":"judge","s":["H8199"],"a":[7]},{"t":" the "},{"t":"righteous","s":["H6662"],"a":[4]},{"t":" and the "},{"t":"wicked","s":["H7563"],"a":[6]},{"t":"; for there is a "},{"t":"time","s":["H6256"],"a":[10]},{"t":" there for every "},{"t":"purpose","s":["H2656"],"a":[12]},{"t":" and every "},{"t":"work","s":["H4639"],"a":[15]},{"t":"."}]},{"n":18,"text":"I said in my heart, This is so for the sake of the children of men, that God may prove them and that they may see for themselves that they are but beasts.","tok":[{"t":"I "},{"t":"said","s":["H0559"],"a":[0]},{"t":" in my "},{"t":"heart","s":["H3820"],"a":[2]},{"t":", This is so for the sake of the children of "},{"t":"men","s":["H0120"],"a":[6]},{"t":", that "},{"t":"God","s":["H0430"],"a":[8]},{"t":" may prove them and that they may "},{"t":"see","s":["H7200"],"a":[9]},{"t":" for themselves that "},{"t":"they","s":["H1992"],"a":[10]},{"t":" are but "},{"t":"beasts","s":["H0929"],"a":[11]},{"t":"."}]},{"n":19,"text":"For what happens to the children of men happens also to beasts; even the same thing happens to them both: As the one dies, so dies the other; and they all have one breath; and man has no advantage over the beast; for all is vanity.","tok":[{"t":"For what happens to the children of "},{"t":"men","s":["H0120"],"a":[3]},{"t":" happens also to "},{"t":"beasts","s":["H0929"],"a":[5]},{"t":"; even the same "},{"t":"thing","s":["H0259"],"a":[7]},{"t":" happens to them both: As the one dies, so dies the "},{"t":"other","s":["H2088"],"a":[10]},{"t":"; and they all have "},{"t":"one","s":["H0259"],"a":[15]},{"t":" "},{"t":"breath","s":["H7307"],"a":[14]},{"t":"; and "},{"t":"man","s":["H0120"],"a":[18]},{"t":" has no advantage over the "},{"t":"beast","s":["H0929"],"a":[20]},{"t":"; for all is "},{"t":"vanity","s":["H1892"],"a":[24]},{"t":"."}]},{"n":20,"text":"All go to one place: all are of dust, and all return to dust.","tok":[{"t":"All "},{"t":"go","s":["H1980"],"a":[1]},{"t":" to "},{"t":"one","s":["H0259"],"a":[4]},{"t":" "},{"t":"place","s":["H4725"],"a":[3]},{"t":": all are of "},{"t":"dust","s":["H6083"],"a":[8]},{"t":", and all return to "},{"t":"dust","s":["H6083"],"a":[12]},{"t":"."}]},{"n":21,"text":"Who knows the breath of the children of men, that it goes upward; or the breath of the beasts, that it goes downward to the earth?","tok":[{"t":"Who "},{"t":"knows","s":["H3045"],"a":[1]},{"t":" the breath of the children of men, that it goes "},{"t":"upward","s":["H4605"],"a":[7]},{"t":"; or the "},{"t":"breath","s":["H7307"],"a":[8]},{"t":" of the "},{"t":"beasts","s":["H0929"],"a":[9]},{"t":", that it "},{"t":"goes","s":["H3381"],"a":[10]},{"t":" "},{"t":"downward","s":["H4295"],"a":[12]},{"t":" to the "},{"t":"earth","s":["H0776"],"a":[13]},{"t":"?"}]},{"n":22,"text":"Therefore I saw that there is nothing better than that a man should rejoice in his works, for that is his portion. For who will bring him to see what will be after him?","tok":[{"t":"Therefore I saw that there is nothing "},{"t":"better","s":["H2896"],"a":[3]},{"t":" than that a "},{"t":"man","s":["H0120"],"a":[6]},{"t":" should "},{"t":"rejoice","s":["H8055"],"a":[5]},{"t":" in his "},{"t":"works","s":["H4639"],"a":[7]},{"t":", for that is his "},{"t":"portion","s":["H2506"],"a":[10]},{"t":". For who will "},{"t":"bring","s":["H0935"],"a":[13]},{"t":" him to "},{"t":"see","s":["H7200"],"a":[14]},{"t":" what will be "},{"t":"after","s":["H0310"],"a":[17]},{"t":" him?"}]}]}
