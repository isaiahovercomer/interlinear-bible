t":"praise","s":["H8416"],"a":[10]},{"t":"."}]},{"n":4,"text":"And His brightness is like the light: Rays come forth from His hand, And the hiding of His power is there.","tok":[{"t":"And His "},{"t":"brightness","s":["H5051"],"a":[0]},{"t":" is like the "},{"t":"light","s":["H0216"],"a":[1]},{"t":": Rays come forth from His "},{"t":"hand","s":["H3027"],"a":[4]},{"t":", And the "},{"t":"hiding","s":["H2253"],"a":[7]},{"t":" of His "},{"t":"power","s":["H5797"],"a":[8]},{"t":" is there."}]},{"n":5,"text":"Before Him goes pestilence, And the fire bolt comes forth at His feet.","tok":[{"t":"Before","s":["H6440"],"a":[0]},{"t":" Him goes "},{"t":"pestilence","s":["H1698"],"a":[2]},{"t":", And the fire bolt comes "},{"t":"forth","s":["H3318"],"a":[3]},{"t":" at His "},{"t":"feet","s":["H7272"],"a":[5]},{"t":"."}]},{"n":6,"text":"He stands and measures the earth; He looks and startles the nations; And the ancient mountains are shattered into dust, And the everlasting hills sink down; His goings are eternal.","tok":[{"t":"He stands and "},{"t":"measures","s":["H4128"],"a":[1]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[2]},{"t":"; He looks and startles the "},{"t":"nations","s":["H1471"],"a":[5]},{"t":"; And the "},{"t":"ancient","s":["H5703"],"a":[8]},{"t":" "},{"t":"mountains","s":["H2042"],"a":[7]},{"t":" are shattered into dust, And the "},{"t":"everlasting","s":["H5703"],"a":[8]},{"t":" "},{"t":"hills","s":["H1389"],"a":[10]},{"t":" sink down; His goings are eternal."}]},{"n":7,"text":"I see the tents of Cushan Under affliction; The tent curtains of the land of Midian tremble.","tok":[{"t":"I see the "},{"t":"tents","s":["H0168"],"a":[3]},{"t":" of "},{"t":"Cushan","s":["H3572"],"a":[4]},{"t":" Under "},{"t":"affliction","s":["H0205"],"a":[1]},{"t":"; The tent "},{"t":"curtains","s":["H3407"],"a":[6]},{"t":" of the "},{"t":"land","s":["H0776"],"a":[7]},{"t":" of "},{"t":"Midian","s":["H4080"],"a":[8]},{"t":" "},{"t":"tremble","s":["H7264"],"a":[5]},{"t":"."}]},{"n":8,"text":"Is it against the rivers, O Jehovah, Against the rivers that Your anger is kindled? Is Your overflowing wrath against the sea That You ride upon Your horses, Upon Your chariots of salvation?","tok":[{"t":"Is it against the "},{"t":"rivers","s":["H5104"],"a":[0]},{"t":", O "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":", Against the "},{"t":"rivers","s":["H5104"],"a":[4]},{"t":" that Your "},{"t":"anger","s":["H0639"],"a":[5]},{"t":" is kindled? Is Your overflowing "},{"t":"wrath","s":["H5678"],"a":[8]},{"t":" against the "},{"t":"sea","s":["H3220"],"a":[7]},{"t":" That You "},{"t":"ride","s":["H7392"],"a":[10]},{"t":" upon Your "},{"t":"horses","s":["H5483"],"a":[12]},{"t":", Upon Your "},{"t":"chariots","s":["H4818"],"a":[13]},{"t":" of "},{"t":"salvation","s":["H3444"],"a":[14]},{"t":"?"}]},{"n":9,"text":"Your bow is bared utterly; The rods of discipline are sworn according to Your word. Selah You cleave the earth with rivers.","tok":[{"t":"Your "},{"t":"bow","s":["H7198"],"a":[2]},{"t":" is bared utterly; The rods of discipline are sworn according to Your "},{"t":"word","s":["H0562"],"a":[5]},{"t":". "},{"t":"Selah","s":["H5542"],"a":[6]},{"t":" You "},{"t":"cleave","s":["H1234"],"a":[8]},{"t":" the "},{"t":"earth","s":["H0776"],"a":[9]},{"t":" with "},{"t":"rivers","s":["H5104"],"a":[7]},{"t":"."}]},{"n":10,"text":"The mountains see You; they writhe; The tempest of water passes by; The deep utters its voice, It lifts its hands high.","tok":[{"t":"The "},{"t":"mountains","s":["H2022"],"a":[2]},{"t":" see You; they writhe; The tempest of "},{"t":"water","s":["H4325"],"a":[4]},{"t":" passes "},{"t":"by","s":["H5674"],"a":[5]},{"t":"; The "},{"t":"deep","s":["H8415"],"a":[7]},{"t":" "},{"t":"utters","s":["H5414"],"a":[6]},{"t":" its "},{"t":"voice","s":["H6963"],"a":[8]},{"t":", It lifts its "},{"t":"hands","s":["H3027"],"a":[10]},{"t":" "},{"t":"high","s":["H7315"],"a":[9]},{"t":"."}]},{"n":11,"text":"The sun and the moon stand still in their high abode 