tten","s":["H3789"],"a":[6]},{"t":" in the "},{"t":"book","s":["H5612"],"a":[7]},{"t":" of the "},{"t":"law","s":["H8451"],"a":[8]},{"t":" of "},{"t":"Moses","s":["H4872"],"a":[9]},{"t":", not "},{"t":"turning","s":["H5493"],"a":[11]},{"t":" away from it to the right or to the "},{"t":"left","s":["H8040"],"a":[14]},{"t":","}]},{"n":7,"text":"And not going unto these nations, these that remain with you; neither shall you make mention of the names of their gods, nor cause anyone to swear by them, nor serve them, nor bow down to them;","tok":[{"t":"And not going unto these "},{"t":"nations","s":["H1471"],"a":[2]},{"t":", these that "},{"t":"remain","s":["H7604"],"a":[4]},{"t":" with you; neither shall you make "},{"t":"mention","s":["H2142"],"a":[10]},{"t":" of the "},{"t":"names","s":["H8034"],"a":[7]},{"t":" of their "},{"t":"gods","s":["H0430"],"a":[8]},{"t":", nor cause anyone to "},{"t":"swear","s":["H7650"],"a":[12]},{"t":" by them, nor "},{"t":"serve","s":["H5647"],"a":[14]},{"t":" them, nor "},{"t":"bow","s":["H7812"],"a":[16]},{"t":" down to them;"}]},{"n":8,"text":"But you shall cling to Jehovah your God, as you have done to this day.","tok":[{"t":"But you shall cling to "},{"t":"Jehovah","s":["H3068"],"a":[2]},{"t":" your "},{"t":"God","s":["H0430"],"a":[3]},{"t":", as you have "},{"t":"done","s":["H6213"],"a":[6]},{"t":" to this "},{"t":"day","s":["H3117"],"a":[8]},{"t":"."}]},{"n":9,"text":"For Jehovah has dispossessed great and strong nations because of you; but as for you, no one has stood before you to this day.","tok":[{"t":"For "},{"t":"Jehovah","s":["H3068"],"a":[1]},{"t":" has dispossessed "},{"t":"great","s":["H1419"],"a":[4]},{"t":" and "},{"t":"strong","s":["H6099"],"a":[5]},{"t":" "},{"t":"nations","s":["H1471"],"a":[3]},{"t":" because of you; but as for you, no one has stood "},{"t":"before","s":["H6440"],"a":[10]},{"t":" you to this "},{"t":"day","s":["H3117"],"a":[12]},{"t":"."}]},{"n":10,"text":"One man of you chases a thousand, for it is Je