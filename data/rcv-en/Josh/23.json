{"v":1,"book":"Josh","ch":23,"verses":[{"n":1,"text":"And many days after Jehovah had given Israel rest from all their enemies around them and Joshua was old and advanced in age,","tok":[{"t":"And many days "},{"t":"after","s":["H0310"],"a":[3]},{"t":" "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" had given "},{"t":"Israel","s":["H3478"],"a":[7]},{"t":" "},{"t":"rest","s":["H5117"],"a":[5]},{"t":" from all their "},{"t":"enemies","s":["H0341"],"a":[9]},{"t":" around them and "},{"t":"Joshua","s":["H3091"],"a":[11]},{"t":" was "},{"t":"old","s":["H2204"],"a":[12]},{"t":" and "},{"t":"advanced","s":["H0935"],"a":[13]},{"t":" in "},{"t":"age","s":["H3117"],"a":[14]},{"t":","}]},{"n":2,"text":"Joshua called for all Israel, for their elders and their heads and their judges and their officers; and he said to them, I am old and advanced in age;","tok":[{"t":"Joshua","s":["H3091"],"a":[1]},{"t":" "},{"t":"called","s":["H7121"],"a":[0]},{"t":" for all "},{"t":"Israel","s":["H3478"],"a":[3]},{"t":", for their "},{"t":"elders","s":["H2205"],"a":[4]},{"t":" and their "},{"t":"heads","s":["H7218"],"a":[5]},{"t":" and their "},{"t":"judges","s":["H8199"],"a":[6]},{"t":" and their "},{"t":"officers","s":["H7860"],"a":[7]},{"t":"; and he "},{"t":"said","s":["H0559"],"a":[8]},{"t":" to them, I am "},{"t":"old","s":["H2204"],"a":[11]},{"t":" and "},{"t":"advanced","s":["H0935"],"a":[12]},{"t":" in "},{"t":"age","s":["H3117"],"a":[13]},{"t":";"}]},{"n":3,"text":"And you have seen all that Jehovah your God has done to all these nations because of you, for it was Jehovah your God who fought for you.","tok":[{"t":"And you have "},{"t":"seen","s":["H7200"],"a":[1]},{"t":" all that "},{"t":"Jehovah","s":["H3068"],"a":[6]},{"t":" your "},{"t":"God","s":["H0430"],"a":[7]},{"t":" has "},{"t":"done","s":["H6213"],"a":[5]},{"t":" to all these "},{"t":"nations","s":["H1471"],"a":[9]},{"t":" "},{"t":"because","s":["H6440"],"a":[11]},{"t":" of you, for it was "},{"t":"Jehovah","s":["H3068"],"a":