."}]},{"n":9,"text":"Have I not commanded you? Be strong and take courage; do not be afraid or dismayed. For Jehovah your God is with you wherever you go.","tok":[{"t":"Have I not "},{"t":"commanded","s":["H6680"],"a":[1]},{"t":" you? Be "},{"t":"strong","s":["H2388"],"a":[2]},{"t":" and take "},{"t":"courage","s":["H0553"],"a":[3]},{"t":"; do not be "},{"t":"afraid","s":["H6206"],"a":[5]},{"t":" or "},{"t":"dismayed","s":["H2865"],"a":[7]},{"t":". For "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":" your "},{"t":"God","s":["H0430"],"a":[11]},{"t":" is with you wherever you go."}]},{"n":10,"text":"Then Joshua commanded the officers of the people, saying,","tok":[{"t":"Then "},{"t":"Joshua","s":["H3091"],"a":[1]},{"t":" "},{"t":"commanded","s":["H6680"],"a":[0]},{"t":" the "},{"t":"officers","s":["H7860"],"a":[3]},{"t":" of the "},{"t":"people","s":["H5971"],"a":[4]},{"t":", "},{"t":"saying","s":["H0559"],"a":[5]},{"t":","}]},{"n":11,"text":"Go through the midst of the camp, and command the people, saying, Prepare provisions for yourselves, for in three days you are to cross this Jordan to enter and possess the land which Jehovah your God is giving you to possess.","tok":[{"t":"Go","s":["H5674"],"a":[0]},{"t":" "},{"t":"through","s":["H7130"],"a":[1]},{"t":" the midst of the camp, and "},{"t":"command","s":["H6680"],"a":[3]},{"t":" the "},{"t":"people","s":["H5971"],"a":[5]},{"t":", "},{"t":"saying","s":["H0559"],"a":[6]},{"t":", "},{"t":"Prepare","s":["H3559"],"a":[7]},{"t":" provisions for yourselves, for in "},{"t":"three","s":["H7969"],"a":[12]},{"t":" "},{"t":"days","s":["H3117"],"a":[13]},{"t":" you are to cross this "},{"t":"Jordan","s":["H3383"],"a":[17]},{"t":" to enter and "},{"t":"possess","s":["H3423"],"a":[20]},{"t":" the "},{"t":"land","s":["H0776"],"a":[22]},{"t":" which "},{"t":"Jehovah","s":["H3068"],"a":[24]},{"t":" your "},{"t":"God","s":["H0430"],"a":[25]},{"t":" is "},{"t":"giving","s":["H5414"],"a":[26]},{"t":" you to "},{"t":"possess","s":["H34