,"s":["H3383"],"a":[10]},{"t":"; but you yourselves shall cross over in battle array "},{"t":"before","s":["H6440"],"a":[14]},{"t":" your "},{"t":"brothers","s":["H0251"],"a":[15]},{"t":", "},{"t":"all","s":["H2571"],"a":[13]},{"t":" the "},{"t":"mighty","s":["H1368"],"a":[17]},{"t":" men of valor; and you shall "},{"t":"help","s":["H5826"],"a":[19]},{"t":" them,"}]},{"n":15,"text":"Until Jehovah gives rest to your brothers as He has to you, and they also possess the land which Jehovah your God is giving them. Then you shall return to the land of your possession, and you will possess that which Moses the servant of Jehovah has given you beyond the Jordan toward the rising of the sun.","tok":[{"t":"Until "},{"t":"Jehovah","s":["H3068"],"a":[3]},{"t":" gives "},{"t":"rest","s":["H5117"]},{"t":" to your "},{"t":"brothers","s":["H0251"],"a":[4]},{"t":" as He has to you, and they also possess the "},{"t":"land","s":["H0776"],"a":[10]},{"t":" which "},{"t":"Jehovah","s":["H3068"],"a":[12]},{"t":" your "},{"t":"God","s":["H0430"],"a":[13]},{"t":" is "},{"t":"giving","s":["H5414"],"a":[14]},{"t":" them. Then you shall "},{"t":"return","s":["H7725"],"a":[16]},{"t":" to the "},{"t":"land","s":["H0776"],"a":[17]},{"t":" of your "},{"t":"possession","s":["H3425"],"a":[18]},{"t":", and you will possess that which "},{"t":"Moses","s":["H4872"],"a":[24]},{"t":" the "},{"t":"servant","s":["H5650"],"a":[25]},{"t":" of Jehovah has "},{"t":"given","s":["H5117"],"a":[2]},{"t":" you beyond the "},{"t":"Jordan","s":["H3383"],"a":[28]},{"t":" toward the rising of the sun."}]},{"n":16,"text":"And they answered Joshua, saying, All that you have commanded us we will do, and wherever you send us we will go.","tok":[{"t":"And they "},{"t":"answered","s":["H6030"],"a":[0]},{"t":" "},{"t":"Joshua","s":["H3091"],"a":[2]},{"t":", "},{"t":"saying","s":["H0559"],"a":[3]},{"t":", All that you have "},{"t":"commanded","s":["H6680"],"a":[6]},{"t":" us we will "},{"t":"do","s":["H6213"],"a":[7]},{"t":", and wherever you "},{"t":"send","s":["H7971"],"a":[11]},{"t":" us we will "},{"t":"go","s":["H3212"]},{"t":"."}]},{"n":17,"text":"As in all things we listened to Moses, so we will listen to you. Only may Jehovah your God be with you, as He was with Moses.","tok":[{"t":"As in all things we listened to "},{"t":"Moses","s":["H4872"],"a":[4]},{"t":", so we will "},{"t":"listen","s":["H8085"],"a":[6]},{"t":" to you. Only may "},{"t":"Jehovah","s":["H3068"],"a":[10]},{"t":" your "},{"t":"God","s":["H0430"],"a":[11]},{"t":" be with you, as He was with "},{"t":"Moses","s":["H4872"],"a":[16]},{"t":"."}]},{"n":18,"text":"Any man who rebels against your command or does not listen to your words in all that you command him, let him be put to death. Only be strong and take courage.","tok":[{"t":"Any man who "},{"t":"rebels","s":["H4784"],"a":[3]},{"t":" against your command or does not "},{"t":"listen","s":["H8085"],"a":[7]},{"t":" to your "},{"t":"words","s":["H1697"],"a":[9]},{"t":" in all that you "},{"t":"command","s":["H6680"],"a":[12]},{"t":" him, let him be put to "},{"t":"death","s":["H4191"],"a":[13]},{"t":". Only be "},{"t":"strong","s":["H2388"],"a":[15]},{"t":" and take "},{"t":"courage","s":["H0553"],"a":[16]},{"t":"."}]}]}
