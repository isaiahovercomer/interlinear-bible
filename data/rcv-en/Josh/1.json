H4872"],"a":[12]},{"t":"."}]},{"n":4,"text":"From the wilderness and this Lebanon even to the great river, the river Euphrates, all the land of the Hittites, and to the Great Sea toward the setting of the sun will be your territory.","tok":[{"t":"From the "},{"t":"wilderness","s":["H4057"],"a":[0]},{"t":" and this "},{"t":"Lebanon","s":["H3844"],"a":[1]},{"t":" even to the "},{"t":"great","s":["H1419"],"a":[5]},{"t":" "},{"t":"river","s":["H5104"],"a":[4]},{"t":", the "},{"t":"river","s":["H5104"],"a":[6]},{"t":" "},{"t":"Euphrates","s":["H6578"],"a":[7]},{"t":", all the "},{"t":"land","s":["H0776"],"a":[9]},{"t":" of the "},{"t":"Hittites","s":["H2850"],"a":[10]},{"t":", and to the "},{"t":"Great","s":["H1419"],"a":[13]},{"t":" "},{"t":"Sea","s":["H3220"],"a":[12]},{"t":" toward the setting of the "},{"t":"sun","s":["H8121"],"a":[15]},{"t":" will be your territory."}]},{"n":5,"text":"No man will be able to stand before you all the days of your life. As I was with Moses, I will be with you; I will not fail you nor forsake you.","tok":[{"t":"No "},{"t":"man","s":["H0376"],"a":[2]},{"t":" will be able to "},{"t":"stand","s":["H3320"],"a":[1]},{"t":" "},{"t":"before","s":["H6440"],"a":[3]},{"t":" you all the "},{"t":"days","s":["H3117"],"a":[5]},{"t":" of your "},{"t":"life","s":["H2416"],"a":[6]},{"t":". As I was with "},{"t":"Moses","s":["H4872"],"a":[10]},{"t":", I will be with you; I will not "},{"t":"fail","s":["H7503"],"a":[14]},{"t":" you nor "},{"t":"forsake","s":["H5800"],"a":[16]},{"t":" you."}]},{"n":6,"text":"Be strong and take courage, for you will cause this people to inherit the land which I swore to their fathers to give to them.","tok":[{"t":"Be "},{"t":"strong","s":["H2388"],"a":[0]},{"t":" and take "},{"t":"courage","s":["H0553"],"a":[1]},{"t":", for you will cause this "},{"t":"people","s":["H5971"],"a":[6]},{"t":" to "},{"t":"inherit","s":["H5157"],"a":[4]},{"t":" the "},{"t":"land","s":["H0776"],"a":[9]},{"t":" which I "},{"t":"swore","s":["H7650"