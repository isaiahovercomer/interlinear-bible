t":" to this "},{"t":"day","s":["H3117"],"a":[16]},{"t":"."}]},{"n":10,"text":"And the children of Israel camped in Gilgal; and they held the Passover on the fourteenth day of the month in the evening on the plains of Jericho.","tok":[{"t":"And the "},{"t":"children","s":["H1121"],"a":[1]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[2]},{"t":" "},{"t":"camped","s":["H2583"],"a":[0]},{"t":" in "},{"t":"Gilgal","s":["H1537"],"a":[3]},{"t":"; and they held the "},{"t":"Passover","s":["H6453"],"a":[6]},{"t":" on the "},{"t":"fourteenth","s":["H0702"],"a":[7]},{"t":" "},{"t":"day","s":["H3117"],"a":[9]},{"t":" of the "},{"t":"month","s":["H2320"],"a":[10]},{"t":" in the "},{"t":"evening","s":["H6153"],"a":[11]},{"t":" on the "},{"t":"plains","s":["H6160"],"a":[12]},{"t":" of "},{"t":"Jericho","s":["H3405"],"a":[13]},{"t":"."}]},{"n":11,"text":"And on the day after the Passover, on that very day, they ate of the produce of the land, unleavened cakes and parched grain.","tok":[{"t":"And on the day after the "},{"t":"Passover","s":["H6453"],"a":[4]},{"t":", on that very "},{"t":"day","s":["H3117"],"a":[8]},{"t":", they ate of the produce of the "},{"t":"land","s":["H0776"],"a":[2]},{"t":", unleavened "},{"t":"cakes","s":["H4682"],"a":[5]},{"t":" and "},{"t":"parched","s":["H7033"],"a":[6]},{"t":" grain."}]},{"n":12,"text":"And the manna ceased on that day, when they ate of the produce of the land; and there was no longer manna for the children of Israel, but they ate of the yield of the land of Canaan that year.","tok":[{"t":"And the "},{"t":"manna","s":["H4478"],"a":[1]},{"t":" "},{"t":"ceased","s":["H7673"],"a":[0]},{"t":" on that day, when they ate of the produce of the "},{"t":"land","s":["H0776"],"a":[5]},{"t":"; and there was no longer "},{"t":"manna","s":["H4478"],"a":[11]},{"t":" for the "},{"t":"children","s":["H1121"],"a":[9]},{"t":" of "},{"t":"Israel","s":["H3478"],"a":[10]},{"t":", but they ate of the yield of the "},{"t":"land","s":["H0776"],"a":[14]},{"t":"