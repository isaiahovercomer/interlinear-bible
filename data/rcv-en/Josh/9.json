":"saying","s":["H0559"],"a":[5]},{"t":", Why have you deceived us, "},{"t":"saying","s":["H0559"],"a":[9]},{"t":", We are "},{"t":"very","s":["H3966"],"a":[13]},{"t":" "},{"t":"far","s":["H7350"],"a":[10]},{"t":" from you; when you "},{"t":"dwell","s":["H3427"],"a":[16]},{"t":" "},{"t":"among","s":["H7130"],"a":[15]},{"t":" us?"}]},{"n":23,"text":"Now therefore you shall be cursed; and there shall never fail to be slaves from among you, woodcutters and drawers of water for the house of my God.","tok":[{"t":"Now therefore you shall be "},{"t":"cursed","s":["H0779"],"a":[1]},{"t":"; and there shall never fail to be slaves from among you, woodcutters and "},{"t":"drawers","s":["H7579"],"a":[9]},{"t":" of "},{"t":"water","s":["H4325"],"a":[10]},{"t":" for the "},{"t":"house","s":["H1004"],"a":[11]},{"t":" of my "},{"t":"God","s":["H0430"],"a":[12]},{"t":"."}]},{"n":24,"text":"And they answered Joshua and said, Because it had been told to your servants for certain that Jehovah your God had commanded Moses His servant to give you all the land and to destroy all the inhabitants of the land from before you. Therefore we were very afraid for our lives because of you, and we did this thing.","tok":[{"t":"And they "},{"t":"answered","s":["H6030"],"a":[0]},{"t":" "},{"t":"Joshua","s":["H3091"],"a":[2]},{"t":" and "},{"t":"said","s":["H0559"],"a":[3]},{"t":", Because it had been "},{"t":"told","s":["H5046"],"a":[6]},{"t":" to your "},{"t":"servants","s":["H5650"],"a":[7]},{"t":" for "},{"t":"certain","s":["H5046"],"a":[5]},{"t":" that "},{"t":"Jehovah","s":["H3068"],"a":[11]},{"t":" your "},{"t":"God","s":["H0430"],"a":[12]},{"t":" had "},{"t":"commanded","s":["H6680"],"a":[10]},{"t":" "},{"t":"Moses","s":["H4872"],"a":[14]},{"t":" His "},{"t":"servant","s":["H5650"],"a":[15]},{"t":" to "},{"t":"give","s":["H5414"],"a":[16]},{"t":" you all the "},{"t":"land","s":["H0776"],"a":[20]},{"t":" and to "},{"t":"destroy","s":["H8045"],"a":[21]},{"t":" all the "},{"t":"inhabitants","s":