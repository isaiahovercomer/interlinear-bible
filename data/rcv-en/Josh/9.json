,"s":["H6679"],"a":[3]},{"t":" from our "},{"t":"houses","s":["H1004"],"a":[5]},{"t":" on the "},{"t":"day","s":["H3117"],"a":[6]},{"t":" we went "},{"t":"forth","s":["H3318"],"a":[7]},{"t":" to come to you; and here it now is: it is "},{"t":"dry","s":["H3001"],"a":[12]},{"t":" and has become moldy."}]},{"n":13,"text":"And these wineskins, which we filled, were new; and here they are: they are torn up. And these clothes and sandals of ours have become old because of the very long journey.","tok":[{"t":"And these wineskins, which we "},{"t":"filled","s":["H4390"],"a":[4]},{"t":", were "},{"t":"new","s":["H2319"],"a":[5]},{"t":"; and here they are: they are torn up. And these clothes and sandals of ours have become "},{"t":"old","s":["H1086"],"a":[11]},{"t":" because of the "},{"t":"very","s":["H3966"],"a":[14]},{"t":" "},{"t":"long","s":["H7230"],"a":[12]},{"t":" "},{"t":"journey","s":["H1870"],"a":[13]},{"t":"."}]},{"n":14,"text":"And the men took some of their provisions, but they did not ask for the counsel of Jehovah.","tok":[{"t":"And the "},{"t":"men","s":["H0582"],"a":[1]},{"t":" "},{"t":"took","s":["H3947"],"a":[0]},{"t":" some of their provisions, but they did not "},{"t":"ask","s":["H7592"],"a":[7]},{"t":" for the "},{"t":"counsel","s":["H6310"],"a":[4]},{"t":" of "},{"t":"Jehovah","s":["H3068"],"a":[5]},{"t":"."}]},{"n":15,"text":"And Joshua made peace with them and made a covenant with them to let them live, and the leaders of the assembly swore an oath to them.","tok":[{"t":"And "},{"t":"Joshua","s":["H3091"],"a":[2]},{"t":" "},{"t":"made","s":["H6213"],"a":[0]},{"t":" "},{"t":"peace","s":["H7965"],"a":[3]},{"t":" with them and "},{"t":"made","s":["H3772"],"a":[4]},{"t":" a covenant with them to let them "},{"t":"live","s":["H2421"],"a":[7]},{"t":", and the leaders of the assembly "},{"t":"swore","s":["H7650"],"a":[8]},{"t":" an oath to them."}]},{"n":16,"text":"Then at the end of three days, after they had made the covenant with them, they heard that th