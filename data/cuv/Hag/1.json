]},{"t":"，"},{"t":"且得榮耀","s":["H3513"],"a":[8]},{"t":"。"},{"t":"這是耶和華","s":["H3068"],"a":[10]},{"t":"說","s":["H0559"],"a":[9]},{"t":"的。"}]},{"n":9,"text":"你們盼望多得，所得的卻少；你們收到家中，我就吹去。這是為甚麼呢？因為我的殿荒涼，你們各人卻顧（原文是奔）自己的房屋。這是萬軍之耶和華說的。","tok":[{"t":"你們盼望","s":["H6437","H0413"],"a":[0,1]},{"t":"多","s":["H7235"],"a":[2]},{"t":"得，"},{"t":"所得的卻少","s":["H9001","H4592"],"a":[5,4]},{"t":"；"},{"t":"你們收","s":["H0935"]},{"t":"到家","s":["H1004"],"a":[6]},{"t":"中，"},{"t":"我就吹","s":["H5301"],"a":[7]},{"t":"去。"},{"t":"這是為","s":["H3282"],"a":[9]},{"t":"甚麼","s":["H4100"],"a":[10]},{"t":"呢？"},{"t":"因為","s":["H3282"],"a":[14]},{"t":"我的殿","s":["H1004","H0834","H1931"],"a":[15,16,17]},{"t":"荒涼","s":["H2720"],"a":[18]},{"t":"，"},{"t":"你們","s":["H0859"],"a":[19]},{"t":"各人","s":["H0376"],"a":[21]},{"t":"卻顧（"},{"t":"原文是奔","s":["H7323"],"a":[20]},{"t":"）"},{"t":"自己的房屋","s":["H9001","H1004"],"a":[22]},{"t":"。"},{"t":"這是萬軍","s":["H6635"],"a":[13]},{"t":"之耶和華","s":["H3068"],"a":[12]},{"t":"說的","s":["H5002"],"a":[11]},{"t":"。"}]},{"n":10,"text":"所以為你們的緣故，天就不降甘露，地也不出土產。","tok":[{"t":"所以","s":["H5921","H3651"],"a":[0,1]},{"t":"為你們的緣故","s":["H5921"],"a":[2]},{"t":"，"},{"t":"天","s":["H8064"],"a":[4]},{"t":"就不降","s":["H3607"],"a":[3]},{"t":"甘露","s":["H4480","H2919"],"a":[5]},{"t":"，"},{"t":"地","s":["H0776"],"a":[6]},{"t":"也不出","s":["H3607"],"a":[7]},{"t":"土產","s":["H2981"],"a":[8]},{"t":"。"}]},{"n":11,"text":"我命乾旱臨到地土、山岡、五穀、新酒，和油，並地上的出產、人民、牲畜，以及人手一切勞碌得來的。」","tok":[{"t":"我命","s":["H7121"],"a":[0]},{"t":"乾旱","s":["H2721"],"a":[1]},{"t":"臨到","s":["H5921"],"a":[2]},{"t":"地土","s":["H0776"],"a":[3]},{"t":"、"},{"t":"山岡","s":["H2022"],"a":[5]},{"t":"、"},{"t":"五穀","s":["H1715"],"a":[7]},{"t":"、"},{"t":"新酒","s":["H8492"],"a":[9]},{"t":"，"},{"t":"和","s":["H5921"],"a":[4]},{"t":"油","s":["H3323"],"a":[11]},{"t":"，"},{"t":"並","s":["H5921"],"a":[6]},{"t":"地","s":["H0127"],"a":[15]},{"t":"上的","s":["H0834"],"a":[13]},{"t":"出產","s":["H3318"],"a":[14]},{"t":"、"},{"t":"人民","s":["H0120"],"a":[17]},{"t":"、"},{"t":"牲畜","s":["H0929"],