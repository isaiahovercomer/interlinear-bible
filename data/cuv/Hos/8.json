002","H1471"],"a":[3]},{"t":"賄買","s":["H8566"],"a":[2]},{"t":"人，"},{"t":"現在","s":["H6258"],"a":[4]},{"t":"我卻要聚集","s":["H6908"],"a":[5]},{"t":"懲罰他們；"},{"t":"他們因君王","s":["H4428"],"a":[9]},{"t":"和首領","s":["H8269"],"a":[10]},{"t":"所加的重擔","s":["H4480","H4853"],"a":[8]},{"t":"日漸","s":["H4592"],"a":[7]},{"t":"衰微","s":["H2490"],"a":[6]},{"t":"。"}]},{"n":11,"text":"以法蓮增添祭壇取罪；因此，祭壇使他犯罪。","tok":[{"t":"以法蓮","s":["H0669"],"a":[2]},{"t":"增添","s":["H7235"],"a":[1]},{"t":"祭壇","s":["H4196"],"a":[3]},{"t":"取罪","s":["H9001","H2398"],"a":[4]},{"t":"；因此，"},{"t":"祭壇","s":["H4196"],"a":[7]},{"t":"使","s":["H1961"],"a":[5]},{"t":"他","s":["H9001"]},{"t":"犯罪","s":["H9001","H2398"],"a":[8]},{"t":"。"}]},{"n":12,"text":"我為他寫了律法萬條，他卻以為與他毫無關涉。","tok":[{"t":"我為他","s":["H9001"]},{"t":"寫了","s":["H3789"],"a":[0]},{"t":"律法","s":["H8451"],"a":[3]},{"t":"萬條","s":["H7230","H7239"],"a":[2]},{"t":"，"},{"t":"他卻以為","s":["H2803"],"a":[6]},{"t":"與他","s":["H3644"],"a":[4]},{"t":"毫無關涉","s":["H2114"],"a":[5]},{"t":"。"}]},{"n":13,"text":"至於獻給我的祭物，他們自食其肉，耶和華卻不悅納他們。現在必記念他們的罪孽，追討他們的罪惡；他們必歸回埃及。","tok":[{"t":"至於獻","s":["H2076"],"a":[2]},{"t":"給我的祭物","s":["H2077","H1890"],"a":[0,1]},{"t":"，"},{"t":"他們自食","s":["H0398"],"a":[4]},{"t":"其肉","s":["H1320"],"a":[3]},{"t":"，"},{"t":"耶和華","s":["H3068"],"a":[5]},{"t":"卻不","s":["H3808"],"a":[6]},{"t":"悅納他們","s":["H7521"],"a":[7]},{"t":"。"},{"t":"現在","s":["H6258"],"a":[8]},{"t":"必記念","s":["H2142"],"a":[9]},{"t":"他們的罪孽","s":["H5771"],"a":[10]},{"t":"，"},{"t":"追討","s":["H6485"],"a":[11]},{"t":"他們的罪惡","s":["H2403"],"a":[12]},{"t":"；"},{"t":"他們","s":["H1992"],"a":[13]},{"t":"必歸回","s":["H7725"],"a":[15]},{"t":"埃及","s":["H4714"],"a":[14]},{"t":"。"}]},{"n":14,"text":"以色列忘記造他的主，建造宮殿；猶大多造堅固城，我卻要降火焚燒他的城邑，燒滅其中的宮殿。","tok":[{"t":"以色列","s":["H3478"],"a":[1]},{"t":"忘記","s":["H7911","H0853"],"a":[0,2]},{"t":"造他的主","s":["H6213"],"a":[3]},{"t":"，"},{"t":"建造","s":["H1129"],"a":[4]},{"t":"宮殿","s":["H1964"],"a":[5]},{"t":"；"},{"t":"猶大","s":["H3063"],"a":[6]},{"t":"多造","s":["H7235"],"a":[7]},{"t":"堅固","s