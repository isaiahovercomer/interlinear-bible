":"我們心中","s":["H3820"],"a":[2]},{"t":"的快樂","s":["H4885"],"a":[1]},{"t":"止息","s":["H7673"],"a":[0]},{"t":"，"},{"t":"跳舞","s":["H4234"],"a":[5]},{"t":"變為","s":["H2015"],"a":[3]},{"t":"悲哀","s":["H9001","H0060"],"a":[4]},{"t":"。"}]},{"n":16,"text":"冠冕從我們的頭上落下；我們犯罪了，我們有禍了！","tok":[{"t":"冠冕","s":["H5850"],"a":[1]},{"t":"從我們的頭","s":["H7218"],"a":[2]},{"t":"上落下","s":["H5307"],"a":[0]},{"t":"；"},{"t":"我們犯罪了","s":["H2398"],"a":[7]},{"t":"，"},{"t":"我們","s":["H9001"]},{"t":"有禍了","s":["H0188","H4994"],"a":[3,4]},{"t":"！"}]},{"n":17,"text":"這些事我們心裡發昏，我們的眼睛昏花。","tok":[{"t":"這些事","s":["H2088"],"a":[1]},{"t":"我們心裡","s":["H3820"],"a":[4]},{"t":"發昏","s":["H1961","H1739"],"a":[2,3]},{"t":"，"},{"t":"我們的眼睛","s":["H5869"],"a":[8]},{"t":"昏花","s":["H2821"],"a":[7]},{"t":"。"}]},{"n":18,"text":"錫安山荒涼，野狗（或譯：狐狸）行在其上。","tok":[{"t":"錫安","s":["H6726"],"a":[2]},{"t":"山","s":["H2022"],"a":[1]},{"t":"荒涼，野狗（或譯："},{"t":"狐狸","s":["H7776"],"a":[4]},{"t":"）"},{"t":"行在","s":["H1980"],"a":[5]},{"t":"其上","s":["H9002"]},{"t":"。"}]},{"n":19,"text":"耶和華啊，你存到永遠；你的寶座存到萬代。","tok":[{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"啊，"},{"t":"你","s":["H0859"],"a":[0]},{"t":"存","s":["H3427"],"a":[3]},{"t":"到永遠","s":["H9001","H5769"],"a":[2]},{"t":"；"},{"t":"你的寶座","s":["H3678"],"a":[4]},{"t":"存到萬代","s":["H9001","H1755","H1755"],"a":[5,6]},{"t":"。"}]},{"n":20,"text":"你為何永遠忘記我們？為何許久離棄我們？","tok":[{"t":"你為何","s":["H9001","H4100"],"a":[0]},{"t":"永遠","s":["H9001","H5331"],"a":[1]},{"t":"忘記我們","s":["H7911"],"a":[2]},{"t":"？"},{"t":"為何許久","s":["H9001","H0753","H3117"],"a":[4,5]},{"t":"離棄我們","s":["H5800"],"a":[3]},{"t":"？"}]},{"n":21,"text":"耶和華啊，求你使我們向你回轉，我們便得回轉。求你復新我們的日子，像古時一樣。","tok":[{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"啊，"},{"t":"求你使我們向你","s":["H0413"],"a":[2]},{"t":"回轉","s":["H7725"],"a":[0]},{"t":"，"},{"t":"我們便得回轉","s":["H7725"],"a":[3]},{"t":"。"},{"t":"求你復新","s":["H2318"],"a":[4]},{"t":"我們的日子","s":["H3117"],"a":[5]},{"t":"，"},{"t":"像古時一樣","s":["H9003","H6924"],"a":[6]},{"t":"。"}]},{"n":22,"text":"你竟全然棄絕我們，向我們大發烈怒？","tok":[{"t"