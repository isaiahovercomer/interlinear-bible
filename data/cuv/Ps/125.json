{"v":1,"book":"Ps","ch":125,"verses":[{"n":0,"text":"（上行之詩。）","tok":[{"t":"（"},{"t":"上行","s":["H4609"],"a":[1]},{"t":"之詩","s":["H7892"],"a":[0]},{"t":"。）"}]},{"n":1,"text":"倚靠耶和華的人好像錫安山，永不動搖。","tok":[{"t":"倚靠","s":["H0982"],"a":[0]},{"t":"耶和華","s":["H9002","H3068"],"a":[1]},{"t":"的人好像錫安","s":["H6726"],"a":[3]},{"t":"山","s":["H9003","H2022"],"a":[2]},{"t":"，"},{"t":"永","s":["H9001","H5769"],"a":[6]},{"t":"不","s":["H3808"],"a":[4]},{"t":"動搖","s":["H4131"],"a":[5]},{"t":"。"}]},{"n":2,"text":"眾山怎樣圍繞耶路撒冷，耶和華也照樣圍繞他的百姓，從今時直到永遠。","tok":[{"t":"眾山","s":["H2022"],"a":[1]},{"t":"怎樣圍繞","s":["H5439","H9001"],"a":[2]},{"t":"耶路撒冷","s":["H3389"],"a":[0]},{"t":"，"},{"t":"耶和華","s":["H3068"],"a":[4]},{"t":"也照樣圍繞","s":["H5439"],"a":[5]},{"t":"他的百姓","s":["H9001","H5971"],"a":[6]},{"t":"，"},{"t":"從今時","s":["H4480","H6258"],"a":[7]},{"t":"直到","s":["H5704"],"a":[8]},{"t":"永遠","s":["H5769"],"a":[9]},{"t":"。"}]},{"n":3,"text":"惡人的杖不常落在義人的分上，免得義人伸手作惡。","tok":[{"t":"惡人","s":["H7562"],"a":[4]},{"t":"的杖","s":["H7626"],"a":[3]},{"t":"不","s":["H3808"],"a":[1]},{"t":"常落","s":["H5117"],"a":[2]},{"t":"在","s":["H5921"],"a":[5]},{"t":"義人","s":["H6662"],"a":[7]},{"t":"的分上","s":["H1486"],"a":[6]},{"t":"，"},{"t":"免得","s":["H9001","H4616","H3808"],"a":[8,9]},{"t":"義人","s":["H6662"],"a":[11]},{"t":"伸","s":["H7971"],"a":[10]},{"t":"手","s":["H3027"],"a":[13]},{"t":"作惡","s":["H9002","H5766"],"a":[12]},{"t":"。"}]},{"n":4,"text":"耶和華啊，求你善待那些為善和心裡正直的人。","tok":[{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"啊，"},{"t":"求你善待","s":["H2895"]},{"t":"那些為善","s":["H9001","H2896"],"a":[2]},{"t":"和心裡","s":["H9002","H3826"],"a":[3,4]},{"t":"正直","s":["H9001","H3477"]},{"t":"的人。"}]},{"n":5,"text":"至於那偏行彎曲道路的人，耶和華必使他和作惡的人一同出去受刑。願平安歸於以色列！","tok":[{"t":"至於那偏行","s":["H5186"],"a":[0]},{"t":"彎曲道路","s":["H6128"],"a":[1]},{"t":"的人，"},{"t":"耶和華","s":["H3068"],"a":[3]},{"t":"必使他和","s":["H0854"],"a":[4]},{"t":"作","s":["H6466"],"a":[5]},{"t":"惡","s":["H0205"],"a":[6]},{"t":"的人一同","s":["H0854"]},{"t":"出去","s":["H3212"]},{"t":"受刑。"},{"t":"願平安","s":["H7965"],"a":[7]},{"t":"歸於","s":["H5921"],"a":[8]},{"t":"以色列","s":["H3478"],"a":[9]},{"t":"！"}]}]}
