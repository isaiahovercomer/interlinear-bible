{"v":1,"book":"Ps","ch":111,"verses":[{"n":1,"text":"你們要讚美耶和華！我要在正直人的大會中，並公會中，一心稱謝耶和華。","tok":[{"t":"你們要讚美","s":["H1984"],"a":[0]},{"t":"耶和華","s":["H3050"],"a":[1]},{"t":"！"},{"t":"我要在正直人","s":["H3477"],"a":[7]},{"t":"的大會中","s":["H9002","H5475"],"a":[8,6]},{"t":"，"},{"t":"並公會","s":["H5712"]},{"t":"中，"},{"t":"一","s":["H9002","H3605"],"a":[4]},{"t":"心","s":["H3824"],"a":[5]},{"t":"稱謝","s":["H3034"],"a":[2]},{"t":"耶和華","s":["H3068"],"a":[3]},{"t":"。"}]},{"n":2,"text":"耶和華的作為本為大；凡喜愛的都必考察。","tok":[{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"的作為","s":["H4639"],"a":[1]},{"t":"本為大","s":["H1419"],"a":[0]},{"t":"；"},{"t":"凡","s":["H9001","H3605"],"a":[4]},{"t":"喜愛的","s":["H2656"],"a":[5]},{"t":"都必考察","s":["H1875"],"a":[3]},{"t":"。"}]},{"n":3,"text":"他所行的是尊榮和威嚴；他的公義存到永遠。","tok":[{"t":"他所行的","s":["H6467"],"a":[2]},{"t":"是尊榮","s":["H1935"],"a":[0]},{"t":"和威嚴","s":["H1926"],"a":[1]},{"t":"；"},{"t":"他的公義","s":["H6666"],"a":[3]},{"t":"存到","s":["H5975"],"a":[4]},{"t":"永遠","s":["H9001","H5703"],"a":[5]},{"t":"。"}]},{"n":4,"text":"他行了奇事，使人記念；耶和華有恩惠，有憐憫。","tok":[{"t":"他行了","s":["H6213"],"a":[1]},{"t":"奇事","s":["H9001","H6381"],"a":[2]},{"t":"，"},{"t":"使人記念","s":["H2143"],"a":[0]},{"t":"；"},{"t":"耶和華","s":["H3068"],"a":[5]},{"t":"有恩惠","s":["H2587"],"a":[3]},{"t":"，"},{"t":"有憐憫","s":["H7349"],"a":[4]},{"t":"。"}]},{"n":5,"text":"他賜糧食給敬畏他的人；他必永遠記念他的約。","tok":[{"t":"他賜","s":["H5414"],"a":[1]},{"t":"糧食","s":["H2964"],"a":[0]},{"t":"給敬畏他的人","s":["H9001","H3373"],"a":[2]},{"t":"；"},{"t":"他必永遠","s":["H9001","H5769"],"a":[4]},{"t":"記念","s":["H2142"],"a":[3]},{"t":"他的約","s":["H1285"],"a":[5]},{"t":"。"}]},{"n":6,"text":"他向百姓顯出大能的作為，把外邦的地賜給他們為業。","tok":[{"t":"他向百姓","s":["H9001","H5971"],"a":[3]},{"t":"顯出","s":["H5046"],"a":[2]},{"t":"大能","s":["H3581"],"a":[0]},{"t":"的作為","s":["H4639"],"a":[1]},{"t":"，"},{"t":"把外邦","s":["H1471"],"a":[7]},{"t":"的地賜","s":["H9001","H5414"],"a":[4]},{"t":"給他們","s":["H9001"]},{"t":"為業","s":["H5159"],"a":[6]},{"t":"。"}]},{"n":7,"text":"他手所行的是誠實公平；他的訓詞都是確實的，","tok":[{"t":"他手","s":["H3027"],"a":[1]},{"t":"所行的","s":["H4639"],"a":[0]},{"t":"是誠實","s":["H0571"],"a":[2]},{"t":"公平","s":["H4941"],"a":[3]},{"t":"；"},{"t":"他的訓詞","s":["H6490"],"a":[6]},{"t":"都","s":["H3605"],"a":[5]},{"t":"是確實的","s":["H0539"],"a":[4]},{"t":"，"}]},{"n":8,"text":"是永永遠遠堅定的，是按誠實正直設立的。","tok":[{"t":"是永永","s":["H9001","H5703"],"a":[1]},{"t":"遠遠","s":["H9001","H5769"],"a":[2]},{"t":"堅定的","s":["H5564"],"a":[0]},{"t":"，"},{"t":"是按誠實","s":["H9002","H0571"],"a":[5,4]},{"t":"正直","s":["H3477"]},{"t":"設立的","s":["H6213"],"a":[3]},{"t":"。"}]},{"n":9,"text":"他向百姓施行救贖，命定他的約，直到永遠；他的名聖而可畏。","tok":[{"t":"他向百姓","s":["H9001","H5971"],"a":[2]},{"t":"施行","s":["H7971"],"a":[1]},{"t":"救贖","s":["H6304"],"a":[0]},{"t":"，"},{"t":"命定","s":["H6680"],"a":[3]},{"t":"他的約","s":["H1285"],"a":[5]},{"t":"，"},{"t":"直到永遠","s":["H9001","H5769"],"a":[4]},{"t":"；"},{"t":"他的名","s":["H8034"],"a":[8]},{"t":"聖","s":["H6918"],"a":[6]},{"t":"而可畏","s":["H3372"],"a":[7]},{"t":"。"}]},{"n":10,"text":"敬畏耶和華是智慧的開端；凡遵行他命令的是聰明人。耶和華是永遠當讚美的！","tok":[{"t":"敬畏","s":["H3374"],"a":[2]},{"t":"耶和華","s":["H3068"],"a":[3]},{"t":"是智慧","s":["H2451"],"a":[1]},{"t":"的開端","s":["H7225"],"a":[0]},{"t":"；"},{"t":"凡","s":["H9001","H3605"],"a":[6]},{"t":"遵行","s":["H6213"],"a":[7]},{"t":"他命令的是聰明","s":["H7922","H2896"],"a":[4,5]},{"t":"人。"},{"t":"耶和華是永遠","s":["H5975","H9001","H5703"],"a":[9,10]},{"t":"當讚美","s":["H8416"],"a":[8]},{"t":"的！"}]}]}
