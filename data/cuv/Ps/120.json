t":"願和睦","s":["H7965"],"a":[1]},{"t":"，"},{"t":"但","s":["H3588"],"a":[2]},{"t":"我發言","s":["H1696"],"a":[3]},{"t":"，"},{"t":"他們就要","s":["H1992"],"a":[4]},{"t":"爭戰","s":["H9001","H4421"],"a":[5]},{"t":"。"}]}]}
