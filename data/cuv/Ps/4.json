t":"，"},{"t":"並要肅靜","s":["H1826"]},{"t":"。（"},{"t":"細拉","s":["H5542"],"a":[8]},{"t":"）"}]},{"n":5,"text":"當獻上公義的祭，又當倚靠耶和華。","tok":[{"t":"當獻上","s":["H2076"],"a":[0]},{"t":"公義","s":["H6664"],"a":[2]},{"t":"的祭","s":["H2077"],"a":[1]},{"t":"，"},{"t":"又當倚靠","s":["H0982","H0413"],"a":[3,4]},{"t":"耶和華","s":["H3068"],"a":[5]},{"t":"。"}]},{"n":6,"text":"有許多人說：誰能指示我們甚麼好處？耶和華啊，求你仰起臉來，光照我們。","tok":[{"t":"有許多人","s":["H7227"],"a":[0]},{"t":"說","s":["H0559"],"a":[1]},{"t":"："},{"t":"誰","s":["H4310"],"a":[2]},{"t":"能指示我們","s":["H7200"],"a":[3]},{"t":"甚麼好處","s":["H2896"],"a":[4]},{"t":"？"},{"t":"耶和華","s":["H3068"],"a":[9]},{"t":"啊，"},{"t":"求你仰起","s":["H5375"],"a":[5]},{"t":"臉","s":["H6440"],"a":[8]},{"t":"來，"},{"t":"光照","s":["H0216"],"a":[7]},{"t":"我們","s":["H5921"],"a":[6]},{"t":"。"}]},{"n":7,"text":"你使我心裡快樂，勝過那豐收五穀新酒的人。","tok":[{"t":"你使","s":["H5414"],"a":[0]},{"t":"我心裡","s":["H9002","H3820"],"a":[5,2]},{"t":"快樂","s":["H8057"],"a":[1]},{"t":"，勝過"},{"t":"那豐收","s":["H7231"],"a":[6]},{"t":"五穀","s":["H1715"],"a":[4]},{"t":"新酒","s":["H8492"]},{"t":"的人。"}]},{"n":8,"text":"我必安然躺下睡覺，因為獨有你─耶和華使我安然居住。","tok":[{"t":"我必","s":["H3162"],"a":[1]},{"t":"安然","s":["H9002","H7965"],"a":[3,0]},{"t":"躺下","s":["H7901"],"a":[2]},{"t":"睡覺","s":["H3462"]},{"t":"，"},{"t":"因為","s":["H3588"],"a":[4]},{"t":"獨有","s":["H9001","H0910"],"a":[7]},{"t":"你","s":["H0859"],"a":[5]},{"t":"─"},{"t":"耶和華","s":["H3068"],"a":[6]},{"t":"使我安然","s":["H9001","H0983"],"a":[8]},{"t":"居住","s":["H3427"],"a":[9]},{"t":"。"}]}]}
