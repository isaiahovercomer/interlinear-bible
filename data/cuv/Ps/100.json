{"v":1,"book":"Ps","ch":100,"verses":[{"n":0,"text":"（稱謝詩。）","tok":[{"t":"（"},{"t":"稱謝","s":["H9001","H8426"],"a":[1]},{"t":"詩","s":["H4210"],"a":[0]},{"t":"。）"}]},{"n":1,"text":"普天下當向耶和華歡呼！","tok":[{"t":"普","s":["H3605"],"a":[2]},{"t":"天下","s":["H0776"],"a":[3]},{"t":"當向耶和華","s":["H9001","H3068"],"a":[1]},{"t":"歡呼","s":["H7321"],"a":[0]},{"t":"！"}]},{"n":2,"text":"你們當樂意事奉耶和華，當來向他歌唱！","tok":[{"t":"你們當樂意","s":["H9002","H8057"],"a":[3]},{"t":"事奉","s":["H5647","H0853"],"a":[0,1]},{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"，"},{"t":"當來","s":["H0935"],"a":[4]},{"t":"向他","s":["H9001","H6440"],"a":[5]},{"t":"歌唱","s":["H9002","H7445"],"a":[6]},{"t":"！"}]},{"n":3,"text":"你們當曉得耶和華是　神！我們是他造的，也是屬他的；我們是他的民，也是他草場的羊。","tok":[{"t":"你們當曉得","s":["H3045","H3588"],"a":[0,1]},{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"是","s":["H1931"],"a":[3]},{"t":"　"},{"t":"神","s":["H0430"],"a":[4]},{"t":"！"},{"t":"我們是他","s":["H1931"],"a":[5]},{"t":"造的","s":["H6213"],"a":[6]},{"t":"，也是屬他的；"},{"t":"我們是他的民","s":["H5971"],"a":[9]},{"t":"，"},{"t":"也是他草場","s":["H4830"],"a":[11]},{"t":"的羊","s":["H6629"],"a":[10]},{"t":"。"}]},{"n":4,"text":"當稱謝進入他的門；當讚美進入他的院。當感謝他，稱頌他的名！","tok":[{"t":"當稱謝","s":["H9002","H8426"],"a":[2]},{"t":"進入","s":["H0935"],"a":[0]},{"t":"他的門","s":["H8179"],"a":[1]},{"t":"；"},{"t":"當讚美","s":["H9002","H8416"],"a":[4]},{"t":"進入他的院","s":["H2691"],"a":[3]},{"t":"。"},{"t":"當感謝","s":["H3034"],"a":[5]},{"t":"他","s":["H9001"]},{"t":"，"},{"t":"稱頌","s":["H1288"],"a":[7]},{"t":"他的名","s":["H8034"],"a":[8]},{"t":"！"}]},{"n":5,"text":"因為耶和華本為善。他的慈愛存到永遠；他的信實直到萬代。","tok":[{"t":"因為","s":["H3588"],"a":[0]},{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"本為善","s":["H2896"],"a":[1]},{"t":"。"},{"t":"他的慈愛","s":["H2617"],"a":[4]},{"t":"存到永遠","s":["H9001","H5769"],"a":[3]},{"t":"；"},{"t":"他的信實","s":["H0530"],"a":[8]},{"t":"直到","s":["H5704"],"a":[5]},{"t":"萬代","s":["H1755","H1755"],"a":[6,7]},{"t":"。"}]}]}
