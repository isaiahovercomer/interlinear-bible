{"v":1,"book":"Ps","ch":138,"verses":[{"n":0,"text":"（大衛的詩。）","tok":[{"t":"（"},{"t":"大衛的","s":["H9001","H1732"],"a":[0]},{"t":"詩。）"}]},{"n":1,"text":"我要一心稱謝你，在諸神面前歌頌你。","tok":[{"t":"我要一","s":["H9002","H3605"],"a":[1]},{"t":"心","s":["H3820"],"a":[2]},{"t":"稱謝你","s":["H3034"],"a":[0]},{"t":"，"},{"t":"在諸神","s":["H0430"],"a":[4]},{"t":"面前","s":["H5048"],"a":[3]},{"t":"歌頌你","s":["H2167"],"a":[5]},{"t":"。"}]},{"n":2,"text":"我要向你的聖殿下拜，為你的慈愛和誠實稱讚你的名；因你使你的話顯為大，過於你所應許的（或譯：超乎你的名聲）。","tok":[{"t":"我要向","s":["H0413"],"a":[1]},{"t":"你的聖","s":["H6944"],"a":[3]},{"t":"殿","s":["H1964"],"a":[2]},{"t":"下拜","s":["H7812"],"a":[0]},{"t":"，"},{"t":"為","s":["H5921"],"a":[7]},{"t":"你的慈愛","s":["H2617"],"a":[8]},{"t":"和","s":["H5921"],"a":[9]},{"t":"誠實","s":["H0571"],"a":[10]},{"t":"稱讚","s":["H3034","H0853"],"a":[4,5]},{"t":"你的名","s":["H8034"],"a":[6]},{"t":"；"},{"t":"因","s":["H3588"],"a":[11]},{"t":"你使你的話","s":["H0565"],"a":[16]},{"t":"顯為大","s":["H1431"],"a":[12]},{"t":"，過於你所應許的（或譯："},{"t":"超乎","s":["H5921","H3605"],"a":[13,14]},{"t":"你的名聲","s":["H8034"],"a":[15]},{"t":"）。"}]},{"n":3,"text":"我呼求的日子，你就應允我，鼓勵我，使我心裡有能力。","tok":[{"t":"我呼求","s":["H7121"],"a":[1]},{"t":"的日子","s":["H9002","H3117"],"a":[0]},{"t":"，"},{"t":"你就應允我","s":["H6030"],"a":[2]},{"t":"，"},{"t":"鼓勵我","s":["H7292"],"a":[3]},{"t":"，"},{"t":"使我心裡","s":["H9002","H5315"],"a":[4]},{"t":"有能力","s":["H5797"],"a":[5]},{"t":"。"}]},{"n":4,"text":"耶和華啊，地上的君王都要稱謝你，因他們聽見了你口中的言語。","tok":[{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"啊，"},{"t":"地上","s":["H0776"],"a":[4]},{"t":"的君王","s":["H4428"],"a":[3]},{"t":"都","s":["H3605"],"a":[2]},{"t":"要稱謝你","s":["H3034"],"a":[0]},{"t":"，"},{"t":"因","s":["H3588"],"a":[5]},{"t":"他們聽見了","s":["H8085"],"a":[6]},{"t":"你口中","s":["H6310"],"a":[8]},{"t":"的言語","s":["H0561"],"a":[7]},{"t":"。"}]},{"n":5,"text":"他們要歌頌耶和華的作為，因耶和華大有榮耀。","tok":[{"t":"他們要歌頌","s":["H7891"],"a":[0]},{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"的作為","s":["H9002","H1870"],"a":[1]},{"t":"，"},{"t":"因","s":["H3588"],"a":[3]},{"t":"耶和華","s":["H3068"],"a":[6]},{"t":"大","s":["H1419"],"a":[4]},{"t":"有榮耀","s":["H3519"],"a":[5]},{"t":"。"}]},{"n":6,"text":"耶和華雖高，仍看顧低微的人；他卻從遠處看出驕傲的人。","tok":[{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"雖","s":["H3588"],"a":[0]},{"t":"高","s":["H7311"],"a":[1]},{"t":"，"},{"t":"仍看顧","s":["H7200"],"a":[4]},{"t":"低微","s":["H8217"],"a":[3]},{"t":"的人；"},{"t":"他卻從遠處","s":["H4480","H4801"],"a":[6]},{"t":"看出","s":["H3045"],"a":[7]},{"t":"驕傲","s":["H1364"],"a":[5]},{"t":"的人。"}]},{"n":7,"text":"我雖行在患難中，你必將我救活；我的仇敵發怒，你必伸手抵擋他們；你的右手也必救我。","tok":[{"t":"我雖","s":["H0518"],"a":[0]},{"t":"行","s":["H3212"]},{"t":"在患難","s":["H6869"],"a":[3]},{"t":"中","s":["H9002","H7130"],"a":[10,2]},{"t":"，"},{"t":"你必將我救活","s":["H2421"],"a":[4]},{"t":"；"},{"t":"我的仇敵","s":["H0341"],"a":[7]},{"t":"發怒","s":["H0639"],"a":[6]},{"t":"，"},{"t":"你必伸","s":["H7971"],"a":[8]},{"t":"手","s":["H3027"],"a":[9]},{"t":"抵擋他們；"},{"t":"你的右手","s":["H3225"],"a":[11]},{"t":"也必救我","s":["H3467"]},{"t":"。"}]},{"n":8,"text":"耶和華必成全關乎我的事；耶和華啊，你的慈愛永遠長存！求你不要離棄你手所造的。","tok":[{"t":"耶和華","s":["H3068"],"a":[0]},{"t":"必成全","s":["H1584"],"a":[1]},{"t":"關乎我的事","s":["H1157"],"a":[2]},{"t":"；"},{"t":"耶和華","s":["H3068"],"a":[3]},{"t":"啊，"},{"t":"你的慈愛","s":["H2617"],"a":[4]},{"t":"永遠長存","s":["H9001","H5769"],"a":[5]},{"t":"！"},{"t":"求你不要","s":["H0408"],"a":[8]},{"t":"離棄","s":["H7503"],"a":[9]},{"t":"你手","s":["H3027"],"a":[7]},{"t":"所造的","s":["H4639"],"a":[6]},{"t":"。"}]}]}
