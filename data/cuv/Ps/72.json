t":"。"}]},{"n":7,"text":"在他的日子，義人要發旺，大有平安，好像月亮長存。","tok":[{"t":"在他的日子","s":["H9002","H3117"],"a":[3,1]},{"t":"，"},{"t":"義人","s":["H6662"],"a":[2]},{"t":"要發旺","s":["H6524"],"a":[0]},{"t":"，"},{"t":"大有","s":["H7230"]},{"t":"平安","s":["H7965"],"a":[4]},{"t":"，"},{"t":"好像月亮","s":["H3394"],"a":[7]},{"t":"長存","s":["H5704","H1097"],"a":[5,6]},{"t":"。"}]},{"n":8,"text":"他要執掌權柄，從這海直到那海，從大河直到地極。","tok":[{"t":"他要執掌權柄","s":["H7287"],"a":[0]},{"t":"，"},{"t":"從這海","s":["H4480","H3220"],"a":[1]},{"t":"直到","s":["H5704"],"a":[2]},{"t":"那海","s":["H3220"],"a":[3]},{"t":"，"},{"t":"從大河","s":["H4480","H5104"],"a":[4]},{"t":"直到","s":["H5704"],"a":[5]},{"t":"地","s":["H0776"],"a":[7]},{"t":"極","s":["H0657"],"a":[6]},{"t":"。"}]},{"n":9,"text":"住在曠野的，必在他面前下拜；他的仇敵必要舔土。","tok":[{"t":"住在曠野的","s":["H6728"],"a":[2]},{"t":"，"},{"t":"必在他面前","s":["H9001","H6440"],"a":[0]},{"t":"下拜","s":["H3766"],"a":[1]},{"t":"；"},{"t":"他的仇敵","s":["H0341"],"a":[3]},{"t":"必要舔","s":["H3897"],"a":[5]},{"t":"土","s":["H6083"],"a":[4]},{"t":"。"}]},{"n":10,"text":"他施和海島的王要進貢；示巴和西巴的王要獻禮物。","tok":[{"t":"他施","s":["H8659"],"a":[1]},{"t":"和海島","s":["H0339"],"a":[2]},{"t":"的王","s":["H4428"],"a":[0]},{"t":"要進","s":["H7725"],"a":[4]},{"t":"貢","s":["H4503"],"a":[3]},{"t":"；"},{"t":"示巴","s":["H7614"],"a":[6]},{"t":"和西巴","s":["H5434"],"a":[7]},{"t":"的王","s":["H4428"],"a":[5]},{"t":"要獻","s":["H7126"],"a":[9]},{"t":"禮物","s":["H0814"],"a":[8]},{"t":"。"}]},{"n":11,"text":"諸王都要叩拜他；萬國都要事奉他。","tok":[{"t":"諸","s":["H3605"],"a":[2]},{"t":"王","s":["H4428"],"a":[3]},{"t":"都要叩拜","s":["H7812"],"a":[0]},{"t":"他","s":["H9001"]},{"t":"；"},{"t":"萬","s":["H3605"],"a":[4]},{"t":"國","s":["H1471"],"a":[5]},{"t":"都要事奉他","s":["H5647"],"a":[6]},{"t":"。"}]},{"n":12,"text":"因為，窮乏人呼求的時候，他要搭救；沒有人幫助的困苦人，他也要搭救。","tok":[{"t":"因為","s":["H3588"],"a":[0]},{"t":"，"},{"t":"窮乏人","s":["H0034"],"a":[2]},{"t":"呼求","s":["H7768"],"a":[3]},{"t":"的時候，"},{"t":"他要搭救","s":["H5337"],"a":[1]},{"t":"；"},{"t":"沒有人","s":["H0369"],"a":[5]},{"t":"幫助","s":["H5826"],"a":[6]},{"t":"的困苦人","s"