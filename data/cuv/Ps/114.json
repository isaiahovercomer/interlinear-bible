{"v":1,"book":"Ps","ch":114,"verses":[{"n":1,"text":"以色列出了埃及，雅各家離開說異言之民；","tok":[{"t":"以色列","s":["H3478"],"a":[1]},{"t":"出了","s":["H9002","H3318"],"a":[0]},{"t":"埃及","s":["H4480","H4714"],"a":[2]},{"t":"，"},{"t":"雅各","s":["H3290"],"a":[4]},{"t":"家","s":["H1004"],"a":[3]},{"t":"離開說異言","s":["H3937"],"a":[6]},{"t":"之民","s":["H4480","H5971"],"a":[5]},{"t":"；"}]},{"n":2,"text":"那時，猶大為主的聖所，以色列為他所治理的國度。","tok":[{"t":"那時，"},{"t":"猶大","s":["H3063"],"a":[1]},{"t":"為","s":["H1961"],"a":[0]},{"t":"主的聖所","s":["H9001","H6944"],"a":[2]},{"t":"，"},{"t":"以色列","s":["H3478"],"a":[3]},{"t":"為他所治理的國度","s":["H4475"],"a":[4]},{"t":"。"}]},{"n":3,"text":"滄海看見就奔逃；約旦河也倒流。","tok":[{"t":"滄海","s":["H3220"],"a":[0]},{"t":"看見","s":["H7200"],"a":[1]},{"t":"就奔逃","s":["H5127"],"a":[2]},{"t":"；"},{"t":"約旦河","s":["H3383"],"a":[3]},{"t":"也倒","s":["H9001","H0268"],"a":[5]},{"t":"流","s":["H5437"],"a":[4]},{"t":"。"}]},{"n":4,"text":"大山踴躍，如公羊；小山跳舞，如羊羔。","tok":[{"t":"大山","s":["H2022"],"a":[0]},{"t":"踴躍","s":["H7540"],"a":[1]},{"t":"，"},{"t":"如公羊","s":["H9003","H0352"],"a":[2]},{"t":"；"},{"t":"小山","s":["H1389"],"a":[3]},{"t":"跳舞，"},{"t":"如羊羔","s":["H9003","H1121","H6629"],"a":[4,5]},{"t":"。"}]},{"n":5,"text":"滄海啊，你為何奔逃？約旦哪，你為何倒流？","tok":[{"t":"滄海","s":["H3220"],"a":[2]},{"t":"啊，"},{"t":"你","s":["H9001"]},{"t":"為何","s":["H4100","H3588"],"a":[0,3]},{"t":"奔逃","s":["H5127"],"a":[4]},{"t":"？"},{"t":"約旦","s":["H3383"],"a":[5]},{"t":"哪，"},{"t":"你為何倒","s":["H9001","H0268"],"a":[7]},{"t":"流","s":["H5437"],"a":[6]},{"t":"？"}]},{"n":6,"text":"大山哪，你為何踴躍，如公羊？小山哪，你為何跳舞，如羊羔？","tok":[{"t":"大山","s":["H2022"],"a":[0]},{"t":"哪，"},{"t":"你為何踴躍","s":["H7540"],"a":[1]},{"t":"，"},{"t":"如公羊","s":["H9003","H0352"],"a":[2]},{"t":"？"},{"t":"小山","s":["H1389"],"a":[3]},{"t":"哪，你為何跳舞，"},{"t":"如羊羔","s":["H9003","H1121","H6629"],"a":[4,5]},{"t":"？"}]},{"n":7,"text":"大地啊，你因見主的面，就是雅各　神的面，便要震動。","tok":[{"t":"大地","s":["H0776"],"a":[3]},{"t":"啊，"},{"t":"你因見主","s":["H0113"],"a":[1]},{"t":"的面","s":["H4480","H9001","H6440"],"a":[0]},{"t":"，"},{"t":"就是雅各","s":["H3290"],"a":[6]},{"t":"　"},{"t":"神","s":["H0433"],"a":[5]},{"t":"的面","s":["H4480","H9001","H6440"],"a":[4]},{"t":"，"},{"t":"便要震動","s":["H2342"],"a":[2]},{"t":"。"}]},{"n":8,"text":"他叫磐石變為水池，叫堅石變為泉源。","tok":[{"t":"他叫磐石","s":["H6697"],"a":[1]},{"t":"變為","s":["H2015"],"a":[0]},{"t":"水","s":["H4325"],"a":[3]},{"t":"池","s":["H0098"],"a":[2]},{"t":"，"},{"t":"叫堅石","s":["H2496"],"a":[4]},{"t":"變為泉源","s":["H9001","H4599","H4325"],"a":[5,6]},{"t":"。"}]}]}
