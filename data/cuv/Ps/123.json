{"v":1,"book":"Ps","ch":123,"verses":[{"n":0,"text":"（上行之詩。）","tok":[{"t":"（"},{"t":"上行","s":["H4609"],"a":[1]},{"t":"之詩","s":["H7892"],"a":[0]},{"t":"。）"}]},{"n":1,"text":"坐在天上的主啊，我向你舉目。","tok":[{"t":"坐","s":["H3427"],"a":[4]},{"t":"在天上","s":["H9002","H8064"],"a":[5]},{"t":"的主啊，"},{"t":"我向你","s":["H0413"],"a":[0]},{"t":"舉","s":["H5375","H0853"],"a":[1,2]},{"t":"目","s":["H5869"],"a":[3]},{"t":"。"}]},{"n":2,"text":"看哪，僕人的眼睛怎樣望主人的手，使女的眼睛怎樣望主母的手，我們的眼睛也照樣望耶和華─我們的　神，直到他憐憫我們。","tok":[{"t":"看哪","s":["H2009"],"a":[0]},{"t":"，"},{"t":"僕人","s":["H5650"],"a":[2]},{"t":"的眼睛","s":["H9003","H5869"],"a":[1]},{"t":"怎樣望","s":["H0413"],"a":[3]},{"t":"主人","s":["H0113"],"a":[5]},{"t":"的手","s":["H3027"],"a":[4]},{"t":"，"},{"t":"使女","s":["H8198"],"a":[7]},{"t":"的眼睛","s":["H9003","H5869"],"a":[6]},{"t":"怎樣望","s":["H0413"],"a":[8]},{"t":"主母","s":["H1404"],"a":[10]},{"t":"的手","s":["H3027"],"a":[9]},{"t":"，"},{"t":"我們的眼睛","s":["H5869"],"a":[12]},{"t":"也照樣","s":["H3651"],"a":[11]},{"t":"望","s":["H0413"],"a":[13]},{"t":"耶和華","s":["H3068"],"a":[14]},{"t":"─我們的　"},{"t":"神","s":["H0430"],"a":[15]},{"t":"，"},{"t":"直到","s":["H5704"],"a":[16]},{"t":"他憐憫我們","s":["H7945","H2603"],"a":[17]},{"t":"。"}]},{"n":3,"text":"耶和華啊，求你憐憫我們，憐憫我們！因為我們被藐視，已到極處。","tok":[{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"啊，"},{"t":"求你憐憫我們","s":["H2603"],"a":[0]},{"t":"，"},{"t":"憐憫我們","s":["H2603"],"a":[2]},{"t":"！"},{"t":"因為","s":["H3588"],"a":[3]},{"t":"我們被藐視","s":["H0937"],"a":[6]},{"t":"，"},{"t":"已到極處","s":["H7227","H7646"],"a":[4,5]},{"t":"。"}]},{"n":4,"text":"我們被那些安逸人的譏誚和驕傲人的藐視，已到極處。","tok":[{"t":"我們","s":["H5315"],"a":[3]},{"t":"被那些安逸人","s":["H7600"],"a":[5]},{"t":"的譏誚","s":["H3933"],"a":[4]},{"t":"和驕傲人","s":["H3238","H1343","H9001","H1349"],"a":[7]},{"t":"的藐視","s":["H0937"],"a":[6]},{"t":"，"},{"t":"已到極處","s":["H7227","H7646","H9001"],"a":[0,1]},{"t":"。"}]}]}
