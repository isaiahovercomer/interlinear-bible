{"v":1,"book":"Ps","ch":93,"verses":[{"n":1,"text":"耶和華作王！他以威嚴為衣穿上；耶和華以能力為衣，以能力束腰，世界就堅定，不得動搖。","tok":[{"t":"耶和華","s":["H3068"],"a":[0]},{"t":"作王","s":["H4427"],"a":[1]},{"t":"！"},{"t":"他以威嚴","s":["H1348"],"a":[2]},{"t":"為衣穿上","s":["H3847"],"a":[3]},{"t":"；"},{"t":"耶和華","s":["H3068"],"a":[5]},{"t":"以能力","s":["H5797"],"a":[6]},{"t":"為衣","s":["H3847"],"a":[4]},{"t":"，"},{"t":"以能力束腰","s":["H0247"],"a":[7]},{"t":"，"},{"t":"世界","s":["H8398"],"a":[10]},{"t":"就","s":["H0637"],"a":[8]},{"t":"堅定","s":["H3559"],"a":[9]},{"t":"，"},{"t":"不得","s":["H1077"],"a":[11]},{"t":"動搖","s":["H4131"],"a":[12]},{"t":"。"}]},{"n":2,"text":"你的寶座從太初立定；你從亙古就有。","tok":[{"t":"你的寶座","s":["H3678"],"a":[1]},{"t":"從太初","s":["H4480","H0227"],"a":[2]},{"t":"立定","s":["H3559"],"a":[0]},{"t":"；"},{"t":"你","s":["H0859"],"a":[4]},{"t":"從亙古","s":["H4480","H5769"],"a":[3]},{"t":"就有。"}]},{"n":3,"text":"耶和華啊，大水揚起，大水發聲，波浪澎湃。","tok":[{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"啊，"},{"t":"大水","s":["H5104"],"a":[1]},{"t":"揚起","s":["H5375"],"a":[0]},{"t":"，"},{"t":"大水","s":["H5104"],"a":[4]},{"t":"發","s":["H5375"],"a":[3]},{"t":"聲","s":["H6963"],"a":[5]},{"t":"，"},{"t":"波浪","s":["H5104"],"a":[7]},{"t":"澎湃","s":["H5375","H1796"],"a":[6,8]},{"t":"。"}]},{"n":4,"text":"耶和華在高處大有能力，勝過諸水的響聲，洋海的大浪。","tok":[{"t":"耶和華","s":["H3068"],"a":[8]},{"t":"在高處","s":["H9002","H4791"],"a":[7]},{"t":"大有能力","s":["H0117"],"a":[3]},{"t":"，"},{"t":"勝過","s":["H7227"],"a":[2]},{"t":"諸水","s":["H4325"],"a":[1]},{"t":"的響聲","s":["H4480","H6963"],"a":[0]},{"t":"，"},{"t":"洋海","s":["H3220"],"a":[5]},{"t":"的大","s":["H0117"],"a":[6]},{"t":"浪","s":["H4867"],"a":[4]},{"t":"。"}]},{"n":5,"text":"耶和華啊，你的法度最的確；你的殿永稱為聖，是合宜的。","tok":[{"t":"耶和華","s":["H3068"],"a":[6]},{"t":"啊，"},{"t":"你的法度","s":["H5713"],"a":[0]},{"t":"最","s":["H3966"],"a":[2]},{"t":"的確","s":["H0539"],"a":[1]},{"t":"；"},{"t":"你的殿","s":["H9001","H1004"],"a":[3]},{"t":"永","s":["H9001","H0753","H3117"],"a":[7,8]},{"t":"稱為聖","s":["H6944"],"a":[5]},{"t":"，"},{"t":"是合宜的","s":["H4998"],"a":[4]},{"t":"。"}]}]