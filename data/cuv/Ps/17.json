H1077"],"a":[3]},{"t":"曾滑跌","s":["H4131"],"a":[4]},{"t":"。"}]},{"n":6,"text":"神啊，我曾求告你，因為你必應允我；求你向我側耳，聽我的言語。","tok":[{"t":"神","s":["H0410"],"a":[4]},{"t":"啊，"},{"t":"我","s":["H0589"],"a":[0]},{"t":"曾求告你","s":["H7121"],"a":[1]},{"t":"，"},{"t":"因為","s":["H3588"],"a":[2]},{"t":"你必應允我","s":["H6030"],"a":[3]},{"t":"；"},{"t":"求你向我","s":["H9001"]},{"t":"側","s":["H5186"],"a":[5]},{"t":"耳","s":["H0241"],"a":[6]},{"t":"，"},{"t":"聽","s":["H8085"],"a":[8]},{"t":"我的言語","s":["H0565"],"a":[9]},{"t":"。"}]},{"n":7,"text":"求你顯出你奇妙的慈愛來；你是那用右手拯救投靠你的脫離起來攻擊他們的人。","tok":[{"t":"求你顯出你奇妙的","s":["H6395"],"a":[0]},{"t":"慈愛","s":["H2617"],"a":[1]},{"t":"來；"},{"t":"你是那用右手","s":["H9002","H3225"],"a":[5]},{"t":"拯救","s":["H3467"],"a":[2]},{"t":"投靠","s":["H2620"],"a":[3]},{"t":"你的脫離起來攻擊他們的人","s":["H4480","H6965"],"a":[4]},{"t":"。"}]},{"n":8,"text":"求你保護我，如同保護眼中的瞳人；將我隱藏在你翅膀的蔭下，","tok":[{"t":"求你保護我","s":["H8104"],"a":[0]},{"t":"，"},{"t":"如同保護眼中","s":["H1323","H5869"],"a":[2,3]},{"t":"的瞳人","s":["H9003","H0380"],"a":[4,1]},{"t":"；"},{"t":"將我隱藏","s":["H5641"],"a":[6]},{"t":"在你翅膀","s":["H3671"],"a":[5]},{"t":"的蔭下","s":["H9002","H6738"]},{"t":"，"}]},{"n":9,"text":"使我脫離那欺壓我的惡人，就是圍困我要害我命的仇敵。","tok":[{"t":"使我脫離","s":["H4480","H6440"],"a":[0]},{"t":"那","s":["H2098"],"a":[2]},{"t":"欺壓我的","s":["H7703"],"a":[3]},{"t":"惡人","s":["H7563"],"a":[1]},{"t":"，"},{"t":"就是圍困","s":["H5362"],"a":[6]},{"t":"我","s":["H5921"],"a":[7]},{"t":"要害我命","s":["H9002","H5315"],"a":[5]},{"t":"的仇敵","s":["H0341"],"a":[4]},{"t":"。"}]},{"n":10,"text":"他們的心被脂油包裹；他們用口說驕傲的話。","tok":[{"t":"他們的心被脂油","s":["H2459"],"a":[0]},{"t":"包裹","s":["H5462"],"a":[1]},{"t":"；"},{"t":"他們用口","s":["H6310"],"a":[2]},{"t":"說","s":["H1696"],"a":[3]},{"t":"驕傲","s":["H9002","H1348"],"a":[4]},{"t":"的話。"}]},{"n":11,"text":"他們圍困了我們的腳步；他們瞪著眼，要把我們推倒在地。","tok":[{"t":"他們圍困了","s":["H5437"],"a":[2]},{"t":"我們的腳步","s":["H0838"],"a":[0]},{"t":"；"},{"t":"他們瞪著","s":["H7896"],"a":[4]},{"t":"眼","s":["H5869"],"a":[3]},{"t":"，"},{"t":"要把我們推倒","s":["H9001","H5186"],"a":[5]},{"t":"在地","s":["H9002","H0776"],"a":[6]},{"t":"。"}]},{"n":12,"text":"他像獅子急要抓食，又像少壯獅子蹲伏在暗處。","tok":[{"t":"他像","s":["H1825"],"a":[0]},{"t":"獅子","s":["H9003","H0738"],"a":[6,1]},{"t":"急要","s":["H3700"],"a":[2]},{"t":"抓食","s":["H9001","H2963"],"a":[3]},{"t":"，"},{"t":"又像少壯獅子","s":["H9003","H3715"],"a":[4]},{"t":"蹲伏","s":["H3427"],"a":[5]},{"t":"在暗處","s":["H9002","H4565"]},{"t":"。"}]},{"n":13,"text":"耶和華啊，求你起來，前去迎敵，將他打倒！用你的刀救護我命脫離惡人。","tok":[{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"啊，"},{"t":"求你起來","s":["H6965"],"a":[0]},{"t":"，"},{"t":"前去","s":["H6923"],"a":[2]},{"t":"迎敵","s":["H6440"],"a":[3]},{"t":"，"},{"t":"將他打倒","s":["H3766"],"a":[4]},{"t":"！"},{"t":"用你的刀","s":["H2719"],"a":[8]},{"t":"救護","s":["H6403"],"a":[5]},{"t":"我命","s":["H5315"],"a":[6]},{"t":"脫離惡人","s":["H4480","H7563"],"a":[7]},{"t":"。"}]},{"n":14,"text":"耶和華啊，求你用手救我脫離世人，脫離那只在今生有福分的世人！你把你的財寶充滿他們的肚腹；他們因有兒女就心滿意足，將其餘的財物留給他們的嬰孩。","tok":[{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"啊，"},{"t":"求你用手","s":["H3027"],"a":[1]},{"t":"救我脫離世人","s":["H4480","H4962"],"a":[0]},{"t":"，"},{"t":"脫離那只在今生","s":["H9002","H2416"],"a":[7,6]},{"t":"有福分","s":["H2506"],"a":[5]},{"t":"的世","s":["H4480","H2465"],"a":[4]},{"t":"人","s":["H4480","H4962"],"a":[3]},{"t":"！"},{"t":"你把你的財寶","s":["H6840"]},{"t":"充滿","s":["H4390"],"a":[8]},{"t":"他們的肚腹","s":["H0990"],"a":[9]},{"t":"；"},{"t":"他們因有兒女","s":["H1121"],"a":[11]},{"t":"就心滿意足","s":["H7646"],"a":[10]},{"t":"，"},{"t":"將其餘","s":["H3499"],"a":[13]},{"t":"的財物留給","s":["H5117"],"a":[12]},{"t":"他們的嬰孩","s":["H9001","H5768"],"a":[14]},{"t":"。"}]},{"n":15,"text":"至於我，我必在義中見你的面；我醒了的時候，得見（或譯：著）你的形像就心滿意足了。","tok":[{"t":"至於我","s":["H0589"],"a":[0]},{"t":"，"},{"t":"我必在義中","s":["H9002","H6664"],"a":[1]},{"t":"見","s":["H2372"],"a":[2]},{"t":"你的面","s":["H6440"],"a":[3]},{"t":"；"},{"t":"我醒了的時候","s":["H9002","H6974"],"a":[5]},{"t":"，得見（或譯：著）"},{"t":"你的形像","s":["H8544"],"a":[6]},{"t":"就心滿意足了","s":["H7646"],"a":[4]},{"t":"。"}]}]}
