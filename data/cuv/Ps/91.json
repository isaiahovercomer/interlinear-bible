{"v":1,"book":"Ps","ch":91,"verses":[{"n":1,"text":"住在至高者隱密處的，必住在全能者的蔭下。","tok":[{"t":"住","s":["H3427"],"a":[0]},{"t":"在至高者","s":["H5945"],"a":[2]},{"t":"隱密處","s":["H9002","H5643"],"a":[1]},{"t":"的，"},{"t":"必住","s":["H3885"],"a":[5]},{"t":"在全能者","s":["H7706"],"a":[4]},{"t":"的蔭下","s":["H9002","H6738"],"a":[3]},{"t":"。"}]},{"n":2,"text":"我要論到耶和華說：他是我的避難所，是我的山寨，是我的　神，是我所倚靠的。","tok":[{"t":"我要論到耶和華","s":["H9001","H3068"],"a":[1]},{"t":"說","s":["H0559"],"a":[0]},{"t":"："},{"t":"他是我的避難所","s":["H4268"],"a":[2]},{"t":"，"},{"t":"是我的山寨","s":["H4686"],"a":[3]},{"t":"，是我的　"},{"t":"神","s":["H0430"],"a":[4]},{"t":"，"},{"t":"是我所倚靠的","s":["H0982","H9002"],"a":[5]},{"t":"。"}]},{"n":3,"text":"他必救你脫離捕鳥人的網羅和毒害的瘟疫。","tok":[{"t":"他必","s":["H1931"],"a":[1]},{"t":"救你","s":["H5337"],"a":[2]},{"t":"脫離捕鳥人","s":["H3353"],"a":[4]},{"t":"的網羅","s":["H4480","H6341"],"a":[3]},{"t":"和毒害","s":["H1942"],"a":[6]},{"t":"的瘟疫","s":["H4480","H1698"],"a":[5]},{"t":"。"}]},{"n":4,"text":"他必用自己的翎毛遮蔽你；你要投靠在他的翅膀底下；他的誠實是大小的盾牌。","tok":[{"t":"他必用自己的翎毛","s":["H9002","H0084"],"a":[3,0]},{"t":"遮蔽","s":["H5526"],"a":[1]},{"t":"你","s":["H9001"]},{"t":"；"},{"t":"你要投靠","s":["H2620"],"a":[5]},{"t":"在他的翅膀","s":["H3671"],"a":[4]},{"t":"底下","s":["H8478"]},{"t":"；"},{"t":"他的誠實","s":["H0571"],"a":[8]},{"t":"是大小的盾","s":["H6793"],"a":[6]},{"t":"牌","s":["H5507"],"a":[7]},{"t":"。"}]},{"n":5,"text":"你必不怕黑夜的驚駭，或是白日飛的箭，","tok":[{"t":"你必不","s":["H3808"],"a":[0]},{"t":"怕","s":["H3372"],"a":[1]},{"t":"黑夜","s":["H3915"],"a":[3]},{"t":"的驚駭","s":["H4480","H6343"],"a":[2]},{"t":"，"},{"t":"或是白日","s":["H3119"],"a":[6]},{"t":"飛","s":["H5774"],"a":[5]},{"t":"的箭","s":["H4480","H2671"],"a":[4]},{"t":"，"}]},{"n":6,"text":"也不怕黑夜行的瘟疫，或是午間滅人的毒病。","tok":[{"t":"也不怕黑夜","s":["H9002","H0652"],"a":[1]},{"t":"行","s":["H1980"],"a":[2]},{"t":"的瘟疫","s":["H4480","H1698"],"a":[0]},{"t":"，"},{"t":"或是午間","s":["H6672"],"a":[5]},{"t":"滅人的","s":["H7736"],"a":[4]},{"t":"毒病","s":["H4480","H6986"],"a":[3]},{"t":"。"}]},{"n":7,"text":"雖有千人仆倒在你旁邊，萬人仆倒在你右邊，這災卻不得臨近你。","tok":[{"t":"雖有千","s":["H0505"],"a":[2]},{"t":"人仆倒","s":["H5307"],"a":[0]},{"t":"在你旁邊","s":["H4480","H6654"],"a":[1]},{"t":"，"},{"t":"萬","s":["H7233"],"a":[3]},{"t":"人仆倒在你右邊","s":["H4480","H3225"],"a":[4]},{"t":"，"},{"t":"這災卻不得","s":["H3808"],"a":[6]},{"t":"臨近","s":["H5066"],"a":[7]},{"t":"你","s":["H0413"],"a":[5]},{"t":"。"}]},{"n":8,"text":"你惟親眼觀看，見惡人遭報。","tok":[{"t":"你惟","s":["H7535"],"a":[0]},{"t":"親眼","s":["H9002","H5869"],"a":[3,1]},{"t":"觀看","s":["H5027"],"a":[2]},{"t":"，"},{"t":"見","s":["H7200"],"a":[5]},{"t":"惡人","s":["H7563"],"a":[4]},{"t":"遭報","s":["H8011"]},{"t":"。"}]},{"n":9,"text":"耶和華是我的避難所；你已將至高者當你的居所，","tok":[{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"是我的避難所","s":["H4268"],"a":[3]},{"t":"；"},{"t":"你","s":["H0859"],"a":[1]},{"t":"已將至高者","s":["H5945"],"a":[4]},{"t":"當","s":["H7760"],"a":[5]},{"t":"你的居所","s":["H4583"],"a":[6]},{"t":"，"}]},{"n":10,"text":"禍患必不臨到你，災害也不挨近你的帳棚。","tok":[{"t":"禍患","s":["H7451"],"a":[3]},{"t":"必不","s":["H3808"],"a":[0]},{"t":"臨到","s":["H0579"],"a":[1]},{"t":"你","s":["H0413"],"a":[2]},{"t":"，"},{"t":"災害","s":["H5061"],"a":[4]},{"t":"也不","s":["H3808"],"a":[5]},{"t":"挨近","s":["H7126"],"a":[6]},{"t":"你的帳棚","s":["H9002","H0168"],"a":[7]},{"t":"。"}]},{"n":11,"text":"因他要為你吩咐他的使者，在你行的一切道路上保護你。","tok":[{"t":"因","s":["H3588"],"a":[0]},{"t":"他要為你","s":["H9001"]},{"t":"吩咐","s":["H6680"],"a":[2]},{"t":"他的使者","s":["H4397"],"a":[1]},{"t":"，"},{"t":"在你行的一切","s":["H9002","H3605"],"a":[5]},{"t":"道路","s":["H1870"],"a":[6]},{"t":"上保護你","s":["H9001","H8104"],"a":[4]},{"t":"。"}]},{"n":12,"text":"他們要用手托著你，免得你的腳碰在石頭上。","tok":[{"t":"他們要用","s":["H5921"],"a":[0]},{"t":"手","s":["H3709"],"a":[1]},{"t":"托著你","s":["H5375"],"a":[2]},{"t":"，"},{"t":"免得","s":["H6435"],"a":[3]},{"t":"你的腳","s":["H7272"],"a":[6]},{"t":"碰","s":["H5062"],"a":[4]},{"t":"在石頭上","s":["H9002","H0068"],"a":[5]},{"t":"。"}]},{"n":13,"text":"你要踹在獅子和虺蛇的身上，踐踏少壯獅子和大蛇。","tok":[{"t":"你要踹","s":["H1869"],"a":[3]},{"t":"在","s":["H5921"],"a":[0]},{"t":"獅子","s":["H7826"],"a":[1]},{"t":"和虺蛇","s":["H6620"],"a":[2]},{"t":"的身上，"},{"t":"踐踏","s":["H7429"],"a":[4]},{"t":"少壯獅子","s":["H3715"],"a":[5]},{"t":"和大蛇","s":["H8577"],"a":[6]},{"t":"。"}]},{"n":14,"text":"神說：因為他專心愛我，我就要搭救他；因為他知道我的名，我要把他安置在高處。","tok":[{"t":"神說："},{"t":"因為","s":["H3588"],"a":[0]},{"t":"他專心愛","s":["H2836"],"a":[2]},{"t":"我","s":["H9002"],"a":[3]},{"t":"，"},{"t":"我就要搭救他","s":["H6403"]},{"t":"；"},{"t":"因為","s":["H3588"],"a":[5]},{"t":"他知道","s":["H3045"],"a":[6]},{"t":"我的名","s":["H8034"],"a":[7]},{"t":"，"},{"t":"我要把他安置在高處","s":["H7682"],"a":[4]},{"t":"。"}]},{"n":15,"text":"他若求告我，我就應允他；他在急難中，我要與他同在；我要搭救他，使他尊貴。","tok":[{"t":"他若求告我","s":["H7121"],"a":[0]},{"t":"，"},{"t":"我就應允他","s":["H6030"],"a":[1]},{"t":"；"},{"t":"他在急難中","s":["H9002","H6869"],"a":[6,4]},{"t":"，"},{"t":"我要","s":["H0595"],"a":[3]},{"t":"與他同在","s":["H5973"],"a":[2]},{"t":"；"},{"t":"我要搭救他","s":["H2502"],"a":[5]},{"t":"，"},{"t":"使他尊貴","s":["H3513"]},{"t":"。"}]},{"n":16,"text":"我要使他足享長壽，將我的救恩顯明給他。","tok":[{"t":"我要使他足享","s":["H7646"],"a":[2]},{"t":"長","s":["H0753"],"a":[0]},{"t":"壽","s":["H3117"],"a":[1]},{"t":"，"},{"t":"將我的救恩","s":["H9002","H3444"],"a":[3,4]},{"t":"顯明給他","s":["H7200"]},{"t":"。"}]}]}
