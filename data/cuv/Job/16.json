{"v":1,"book":"Job","ch":16,"verses":[{"n":1,"text":"約伯回答說：","tok":[{"t":"約伯","s":["H0347"],"a":[1]},{"t":"回答","s":["H6030"],"a":[0]},{"t":"說","s":["H0559"],"a":[2]},{"t":"："}]},{"n":2,"text":"這樣的話我聽了許多；你們安慰人，反叫人愁煩。","tok":[{"t":"這樣的話","s":["H9003","H0428"],"a":[1]},{"t":"我聽了","s":["H8085"],"a":[0]},{"t":"許多","s":["H7227"],"a":[2]},{"t":"；"},{"t":"你們","s":["H3605"],"a":[5]},{"t":"安慰人","s":["H5162"],"a":[3]},{"t":"，"},{"t":"反叫人愁煩","s":["H5999"],"a":[4]},{"t":"。"}]},{"n":3,"text":"虛空的言語有窮盡嗎？有甚麼話惹動你回答呢？","tok":[{"t":"虛空的","s":["H7307"],"a":[2]},{"t":"言語","s":["H9001","H1697"],"a":[1]},{"t":"有窮盡","s":["H7093"],"a":[0]},{"t":"嗎？"},{"t":"有甚麼","s":["H4100"],"a":[4]},{"t":"話惹動你","s":["H4834","H3588"],"a":[5,6]},{"t":"回答","s":["H6030"],"a":[7]},{"t":"呢？"}]},{"n":4,"text":"我也能說你們那樣的話；你們若處在我的境遇，我也會聯絡言語攻擊你們，又能向你們搖頭。","tok":[{"t":"我","s":["H0595"],"a":[1]},{"t":"也","s":["H1571"],"a":[0]},{"t":"能說","s":["H1696"],"a":[3]},{"t":"你們","s":["H9003"],"a":[11]},{"t":"那樣的話；"},{"t":"你們","s":["H5315"],"a":[6]},{"t":"若","s":["H3863"],"a":[4]},{"t":"處在","s":["H3426"],"a":[5]},{"t":"我的","s":["H5315"],"a":[8]},{"t":"境遇","s":["H8478"],"a":[7]},{"t":"，"},{"t":"我也會聯絡","s":["H2266"],"a":[9]},{"t":"言語","s":["H9002","H4405"],"a":[12]},{"t":"攻擊你們","s":["H5921"],"a":[10]},{"t":"，"},{"t":"又能向你們","s":["H5921"],"a":[13]},{"t":"搖","s":["H5128","H1119"],"a":[14]},{"t":"頭","s":["H7218"],"a":[15]},{"t":"。"}]},{"n":5,"text":"但我必用口堅固你們，用嘴消解你們的憂愁。","tok":[{"t":"但我必用","s":["H1119"],"a":[1]},{"t":"口","s":["H6310"],"a":[2]},{"t":"堅固你們","s":["H0553"],"a":[0]},{"t":"，"},{"t":"用","s":["H5205"],"a":[3]},{"t":"嘴","s":["H8193"],"a":[4]},{"t":"消解你們的憂愁","s":["H2820"],"a":[5]},{"t":"。"}]},{"n":6,"text":"我雖說話，憂愁仍不得消解；我雖停住不說，憂愁就離開我嗎？","tok":[{"t":"我雖","s":["H0518"],"a":[0]},{"t":"說話","s":["H1696"],"a":[1]},{"t":"，"},{"t":"憂愁","s":["H3511"],"a":[4]},{"t":"仍不得","s":["H3808"],"a":[2]},{"t":"消解","s":["H2820"],"a":[3]},{"t":"；"},{"t":"我雖停住不說","s":["H2308"],"a":[5]},{"t":"，"},{"t":"憂愁就離開","s":["H1980"],"a":[8]},{"t":"我","s":["H448