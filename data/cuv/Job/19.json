{"v":1,"book":"Job","ch":19,"verses":[{"n":1,"text":"約伯回答說：","tok":[{"t":"約伯","s":["H0347"],"a":[1]},{"t":"回答","s":["H6030"],"a":[0]},{"t":"說","s":["H0559"],"a":[2]},{"t":"："}]},{"n":2,"text":"你們攪擾我的心，用言語壓碎我要到幾時呢？","tok":[{"t":"你們攪擾","s":["H3013"],"a":[2]},{"t":"我的心","s":["H5315"],"a":[3]},{"t":"，"},{"t":"用言語","s":["H9002","H4405"],"a":[4,5]},{"t":"壓碎我","s":["H1792"]},{"t":"要到","s":["H5704"],"a":[0]},{"t":"幾時","s":["H0575"],"a":[1]},{"t":"呢？"}]},{"n":3,"text":"你們這十次羞辱我；你們苦待我也不以為恥。","tok":[{"t":"你們這","s":["H2088"],"a":[0]},{"t":"十","s":["H6235"],"a":[1]},{"t":"次","s":["H6471"],"a":[2]},{"t":"羞辱我","s":["H3637"],"a":[3]},{"t":"；"},{"t":"你們苦待","s":["H1970"],"a":[6]},{"t":"我","s":["H9001"]},{"t":"也不","s":["H3808"],"a":[4]},{"t":"以為恥","s":["H0954"],"a":[5]},{"t":"。"}]},{"n":4,"text":"果真我有錯，這錯乃是在我。","tok":[{"t":"果","s":["H0637"],"a":[0]},{"t":"真","s":["H0551"],"a":[1]},{"t":"我有錯","s":["H7686"],"a":[2]},{"t":"，"},{"t":"這錯","s":["H4879"],"a":[5]},{"t":"乃是在","s":["H3885"],"a":[4]},{"t":"我","s":["H0854"],"a":[3]},{"t":"。"}]},{"n":5,"text":"你們果然要向我誇大，以我的羞辱為證指責我，","tok":[{"t":"你們果","s":["H0518"],"a":[0]},{"t":"然","s":["H0551"],"a":[1]},{"t":"要向我","s":["H5921"],"a":[2]},{"t":"誇大","s":["H1431"],"a":[3]},{"t":"，"},{"t":"以我的羞辱","s":["H2781"],"a":[6]},{"t":"為證指責","s":["H3198"],"a":[4]},{"t":"我","s":["H5921"],"a":[5]},{"t":"，"}]},{"n":6,"text":"就該知道是　神傾覆我，用網羅圍繞我。","tok":[{"t":"就該","s":["H0645"],"a":[1]},{"t":"知道","s":["H3045"],"a":[0]},{"t":"是","s":["H3588"],"a":[2]},{"t":"　"},{"t":"神","s":["H0433"],"a":[3]},{"t":"傾覆我","s":["H5791"],"a":[4]},{"t":"，"},{"t":"用網羅","s":["H4686"]},{"t":"圍繞","s":["H5362"],"a":[7]},{"t":"我","s":["H5921"],"a":[6]},{"t":"。"}]},{"n":7,"text":"我因委曲呼叫，卻不蒙應允；我呼求，卻不得公斷。","tok":[{"t":"我因委曲","s":["H2555"],"a":[2]},{"t":"呼叫","s":["H6817"],"a":[1]},{"t":"，"},{"t":"卻不","s":["H3808"],"a":[3]},{"t":"蒙應允","s":["H6030"],"a":[4]},{"t":"；"},{"t":"我呼求","s":["H7768"],"a":[5]},{"t":"，"},{"t":"卻不得","s":["H0369"],"a":[6]},{"t":"公斷","s":["H4941"],"a":[7]},{"t":"。"}]},{"n":8,"text":"神用籬笆攔住我的道路，使我不得經過；又使我的路徑黑暗。","tok":[{"t":"神用籬笆攔住","s":["H1443"],"a":[1]},{"t":"我的道路","s":["H0734"],"a":[0]},{"t":"，"},{"t":"使我不得","s":["H3808"],"a":[2]},{"t":"經過","s":["H5674"],"a":[3]},{"t":"；"},{"t":"又使","s":["H7760","H5921"],"a":[7,4]},{"t":"我的路徑","s":["H5410"],"a":[5]},{"t":"黑暗","s":["H2822"],"a":[6]},{"t":"。"}]},{"n":9,"text":"他剝去我的榮光，摘去我頭上的冠冕。","tok":[{"t":"他剝去","s":["H6584","H4480","H5921"],"a":[2,1]},{"t":"我的榮光","s":["H3519"],"a":[0]},{"t":"，"},{"t":"摘去","s":["H5493"],"a":[3]},{"t":"我頭上","s":["H7218"],"a":[5]},{"t":"的冠冕","s":["H5850"],"a":[4]},{"t":"。"}]},{"n":10,"text":"他在四圍攻擊我，我便歸於死亡，將我的指望如樹拔出來。","tok":[{"t":"他在四圍","s":["H5439"],"a":[1]},{"t":"攻擊","s":["H5422"],"a":[0]},{"t":"我，"},{"t":"我便歸於死亡","s":["H3212"]},{"t":"，"},{"t":"將我的指望","s":["H8615"],"a":[5]},{"t":"如樹","s":["H9003","H6086"],"a":[4]},{"t":"拔出來","s":["H5265"],"a":[3]},{"t":"。"}]},{"n":11,"text":"他的忿怒向我發作，以我為敵人。","tok":[{"t":"他的忿怒","s":["H0639"],"a":[2]},{"t":"向我","s":["H5921"],"a":[1]},{"t":"發作","s":["H2734"],"a":[0]},{"t":"，"},{"t":"以我","s":["H2803"],"a":[3]},{"t":"為"},{"t":"敵人","s":["H9003","H6862"],"a":[5]},{"t":"。"}]},{"n":12,"text":"他的軍旅一齊上來，修築戰路攻擊我，在我帳棚的四圍安營。","tok":[{"t":"他的軍旅","s":["H1416"],"a":[2]},{"t":"一齊","s":["H3162"],"a":[0]},{"t":"上來","s":["H0935"],"a":[1]},{"t":"，"},{"t":"修築","s":["H5549"],"a":[3]},{"t":"戰路","s":["H1870"],"a":[5]},{"t":"攻擊我","s":["H5921"],"a":[4]},{"t":"，"},{"t":"在我帳棚","s":["H9001","H0168"],"a":[6,8]},{"t":"的四圍","s":["H5439"],"a":[7]},{"t":"安營","s":["H2583"]},{"t":"。"}]},{"n":13,"text":"他把我的弟兄隔在遠處，使我所認識的全然與我生疏。","tok":[{"t":"他把我的弟兄","s":["H0251"],"a":[0]},{"t":"隔","s":["H7368"],"a":[2]},{"t":"在","s":["H4480","H5921"],"a":[6,1]},{"t":"遠處，"},{"t":"使我所認識的","s":["H3045"],"a":[3]},{"t":"全然","s":["H0389"],"a":[4]},{"t":"與我","s":["H4480"]},{"t":"生疏","s":["H2114"],"a":[5]},{"t":"。"}]},{"n":14,"text":"我的親戚與我斷絕；我的密友都忘記我。","tok":[{"t":"我的親戚","s":["H7138"],"a":[1]},{"t":"與我斷絕","s":["H2308"],"a":[0]},{"t":"；"},{"t":"我的密友","s":["H3045"],"a":[2]},{"t":"都忘記","s":["H7911"],"a":[3]},{"t":"我。"}]},{"n":15,"text":"在我家寄居的，和我的使女都以我為外人；我在他們眼中看為外邦人。","tok":[{"t":"在我家","s":["H1004"],"a":[1]},{"t":"寄居","s":["H1481"],"a":[0]},{"t":"的，"},{"t":"和我的使女","s":["H0519"],"a":[2]},{"t":"都以我為","s":["H2803"],"a":[4]},{"t":"外人","s":["H9001","H2114"],"a":[3]},{"t":"；"},{"t":"我在他們眼中","s":["H9002","H5869"],"a":[7]},{"t":"看為","s":["H1961"],"a":[6]},{"t":"外邦人","s":["H5237"],"a":[5]},{"t":"。"}]},{"n":16,"text":"我呼喚僕人，雖用口求他，他還是不回答。","tok":[{"t":"我呼喚","s":["H7121"],"a":[1]},{"t":"僕人","s":["H9001","H5650"],"a":[0]},{"t":"，"},{"t":"雖用","s":["H1119"],"a":[4]},{"t":"口","s":["H6310"],"a":[5]},{"t":"求","s":["H2603"],"a":[6]},{"t":"他","s":["H9001"]},{"t":"，"},{"t":"他還是不","s":["H3808"],"a":[2]},{"t":"回答","s":["H6030"],"a":[3]},{"t":"。"}]},{"n":17,"text":"我口的氣味，我妻子厭惡；我的懇求，我同胞也憎嫌。","tok":[{"t":"我口的氣味","s":["H7307"],"a":[0]},{"t":"，"},{"t":"我妻子","s":["H9001","H0802"],"a":[3,2]},{"t":"厭惡","s":["H2114"],"a":[1]},{"t":"；"},{"t":"我的懇求","s":["H2589"]},{"t":"，"},{"t":"我同胞","s":["H9001","H1121","H0990"],"a":[4,5]},{"t":"也憎嫌。"}]},{"n":18,"text":"連小孩子也藐視我；我若起來，他們都嘲笑我。","tok":[{"t":"連小孩子","s":["H5759"],"a":[1]},{"t":"也","s":["H1571"],"a":[0]},{"t":"藐視","s":["H3988"],"a":[2]},{"t":"我","s":["H9002"]},{"t":"；"},{"t":"我若起來","s":["H6965"],"a":[4]},{"t":"，"},{"t":"他們都嘲笑","s":["H1696"],"a":[5]},{"t":"我","s":["H9002"]},{"t":"。"}]},{"n":19,"text":"我的密友都憎惡我；我平日所愛的人向我翻臉。","tok":[{"t":"我的密","s":["H5475"],"a":[3]},{"t":"友","s":["H4962"],"a":[2]},{"t":"都","s":["H3605"],"a":[1]},{"t":"憎惡我","s":["H8581"],"a":[0]},{"t":"；"},{"t":"我平日所","s":["H2088"],"a":[4]},{"t":"愛","s":["H0157"],"a":[5]},{"t":"的人向我","s":["H9002"]},{"t":"翻臉","s":["H2015"],"a":[6]},{"t":"。"}]},{"n":20,"text":"我的皮肉緊貼骨頭；我只剩牙皮逃脫了。","tok":[{"t":"我的皮","s":["H9002","H5785"],"a":[1,0]},{"t":"肉","s":["H9002","H1320"]},{"t":"緊貼","s":["H1692"],"a":[2]},{"t":"骨頭","s":["H6106"],"a":[3]},{"t":"；"},{"t":"我只剩牙","s":["H8127"],"a":[6]},{"t":"皮","s":["H9002","H5785"],"a":[5]},{"t":"逃脫了","s":["H4422"],"a":[4]},{"t":"。"}]},{"n":21,"text":"我朋友啊，可憐我！可憐我！因為　神的手攻擊