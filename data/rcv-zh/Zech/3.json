{"v":1,"book":"Zech","ch":3,"verses":[{"n":1,"text":"祂又指給我看，大祭司約書亞站在耶和華的使者面前，撒但也站在約書亞的右邊，作他的對頭。","tok":[{"t":"祂"},{"t":"又指給我看","s":["H7200"],"a":[0]},{"t":"，"},{"t":"大","s":["H1419"],"a":[4]},{"t":"祭司","s":["H3548"],"a":[3]},{"t":"約書亞","s":["H3091"],"a":[2]},{"t":"站在","s":["H5975"],"a":[5]},{"t":"耶和華","s":["H3068"],"a":[8]},{"t":"的使者","s":["H4397"],"a":[7]},{"t":"面前","s":["H9001","H6440"],"a":[6]},{"t":"，"},{"t":"撒但","s":["H7854"],"a":[9]},{"t":"也站","s":["H5975"],"a":[10]},{"t":"在"},{"t":"約書亞的右邊","s":["H3225"],"a":[12]},{"t":"，作"},{"t":"他","s":["H9001","H7853"],"a":[13]},{"t":"的對頭。"}]},{"n":2,"text":"耶和華對撒但說，撒但哪，耶和華責備你！就是揀選耶路撒冷的耶和華責備你！這不是從火中抽出來的一根柴麼？","tok":[{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"對"},{"t":"撒但","s":["H7854"],"a":[3]},{"t":"說","s":["H0559"],"a":[0]},{"t":"，"},{"t":"撒但","s":["H7854"],"a":[7]},{"t":"哪，"},{"t":"耶和華","s":["H3068"],"a":[5]},{"t":"責備","s":["H1605"],"a":[4]},{"t":"你","s":["H9002"],"a":[8]},{"t":"！"},{"t":"就是揀選","s":["H0977"],"a":[11]},{"t":"耶路撒冷","s":["H9002","H3389"],"a":[12]},{"t":"的耶和華","s":["H3068"],"a":[9]},{"t":"責備","s":["H1605"]},{"t":"你","s":["H9002"]},{"t":"！"},{"t":"這","s":["H2088"],"a":[14]},{"t":"不是","s":["H3808"],"a":[13]},{"t":"從火","s":["H4480","H0784"],"a":[17]},{"t":"中抽出來","s":["H5337"],"a":[16]},{"t":"的一根柴","s":["H0181"],"a":[15]},{"t":"麼？"}]},{"n":3,"text":"約書亞穿著污穢的衣服，站在那使者面前。","tok":[{"t":"約書亞","s":["H3091","H1961"],"a":[0,1]},{"t":"穿著","s":["H3847"],"a":[2]},{"t":"污穢","s":["H6674"],"a":[4]},{"t":"的衣服","s":["H0899"],"a":[3]},{"t":"，"},{"t":"站","s":["H5975"],"a":[5]},{"t":"在那"},{"t":"使者","s":["H4397"],"a":[7]},{"t":"面前","s":["H9001","H6440"],"a":[6]},{"t":"。"}]},{"n":4,"text":"祂吩咐那些站在祂面前的說，你們要脫去他身上污穢的衣服。又對約書亞說，你看，我使你的罪孽離開你，給你穿上華美的衣袍。","tok":[{"t":"祂"},{"t":"吩咐","s":["H0559","H0413"],"a":[1,2]},{"t":"那些"},{"t":"站在","s":["H5975"],"a":[3]},{"t":"祂"},{"t":"面前","s":["H9001","H6440"],"a":[0,4]},{"t":"的說","s":["H9001","H0559"],"a":[10,5]},{"t":"，"},{"t":"你們要脫去","s":["H5493"],"a":[6]},{"t":"他","s":["H4480","H5921"],"a":[9]},{"t":"