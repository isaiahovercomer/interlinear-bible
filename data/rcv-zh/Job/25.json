{"v":1,"book":"Job","ch":25,"verses":[{"n":1,"text":"書亞人比勒達回答說，","tok":[{"t":"書亞人","s":["H7747"],"a":[2]},{"t":"比勒達","s":["H1085"],"a":[1]},{"t":"回答","s":["H6030"],"a":[0]},{"t":"說","s":["H0559"],"a":[3]},{"t":"，"}]},{"n":2,"text":"神有治理之權，威嚴可畏；祂在高處施行和平。","tok":[{"t":"神有","s":["H5973"],"a":[2]},{"t":"治理之權","s":["H4910"],"a":[0]},{"t":"，"},{"t":"威嚴可畏","s":["H6343"],"a":[1]},{"t":"；祂"},{"t":"在高處","s":["H9002","H4791"],"a":[5]},{"t":"施行","s":["H6213"],"a":[3]},{"t":"和平","s":["H7965"],"a":[4]},{"t":"。"}]},{"n":3,"text":"祂的眾軍，豈能數算？祂的光一發，誰不蒙照呢？","tok":[{"t":"祂的眾"},{"t":"軍","s":["H9001","H1416"],"a":[2]},{"t":"，"},{"t":"豈能","s":["H3426"],"a":[0]},{"t":"數算","s":["H4557"],"a":[1]},{"t":"？祂"},{"t":"的光","s":["H0216"],"a":[7]},{"t":"一發","s":["H6965"],"a":[6]},{"t":"，"},{"t":"誰","s":["H4310"],"a":[4]},{"t":"不","s":["H3808"],"a":[5]},{"t":"蒙照呢？"}]},{"n":4,"text":"這樣，在神面前人怎能成為義的？婦人所生的怎能是潔淨的？","tok":[{"t":"這樣","s":["H5973"],"a":[3]},{"t":"，在"},{"t":"神","s":["H0410"],"a":[4]},{"t":"面前"},{"t":"人","s":["H0582"],"a":[2]},{"t":"怎能","s":["H4100"],"a":[0]},{"t":"成為"},{"t":"義","s":["H6663"],"a":[1]},{"t":"的？"},{"t":"婦人","s":["H0802"],"a":[8]},{"t":"所生的","s":["H3205"],"a":[7]},{"t":"怎能","s":["H4100"],"a":[5]},{"t":"是"},{"t":"潔淨","s":["H2135"],"a":[6]},{"t":"的？"}]},{"n":5,"text":"看哪，在神眼前，月亮也無光亮，星宿也不純潔；","tok":[{"t":"看哪，在"},{"t":"神眼前","s":["H9002","H5869"],"a":[3,8]},{"t":"，"},{"t":"月亮","s":["H3394"],"a":[2]},{"t":"也"},{"t":"無","s":["H3808"],"a":[6]},{"t":"光亮","s":["H0166"],"a":[4]},{"t":"，"},{"t":"星宿","s":["H3556"],"a":[5]},{"t":"也不","s":["H3808"]},{"t":"純"},{"t":"潔","s":["H2141"],"a":[7]},{"t":"；"}]},{"n":6,"text":"何況如蟲的人，如蛆的世人呢！","tok":[{"t":"何況","s":["H0637","H3588"],"a":[0,1]},{"t":"如蟲","s":["H7415"],"a":[3]},{"t":"的人","s":["H0582"],"a":[2]},{"t":"，"},{"t":"如蛆","s":["H8438"],"a":[6]},{"t":"的世人","s":["H1121","H0120"],"a":[4,5]},{"t":"呢！"}]}]}
