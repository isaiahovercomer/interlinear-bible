{"v":1,"book":"Esth","ch":10,"verses":[{"n":1,"text":"亞哈隨魯王使陸地和海島的人民都進貢。","tok":[{"t":"亞哈隨魯","s":["H0325"],"a":[2]},{"t":"王","s":["H4428G"],"a":[1]},{"t":"使","s":["H7760H"],"a":[0]},{"t":"陸"},{"t":"地","s":["H0776G"],"a":[5]},{"t":"和海","s":["H3220G"],"a":[7]},{"t":"島","s":["H0339"],"a":[6]},{"t":"的人民都進"},{"t":"貢","s":["H4522"],"a":[3]},{"t":"。"}]},{"n":2,"text":"他以權柄勇力所行的，並王使末底改得尊大的詳確經過，豈不都寫在瑪代和波斯王的年代志上麼？","tok":[{"t":"他"},{"t":"以權柄","s":["H8633"],"a":[2]},{"t":"勇力","s":["H1369"],"a":[3]},{"t":"所"},{"t":"行","s":["H4639G"],"a":[1]},{"t":"的，"},{"t":"並王","s":["H4428G"],"a":[9]},{"t":"使"},{"t":"末底改","s":["H4782H"],"a":[6]},{"t":"得"},{"t":"尊大","s":["H1431"],"a":[8]},{"t":"的"},{"t":"詳確經","s":["H6575"],"a":[4]},{"t":"過，"},{"t":"豈不","s":["H3808"],"a":[10]},{"t":"都寫","s":["H3789"],"a":[12]},{"t":"在"},{"t":"瑪代","s":["H4074H"],"a":[18]},{"t":"和"},{"t":"波斯","s":["H6539"],"a":[19]},{"t":"王","s":["H4428G"],"a":[17]},{"t":"的年","s":["H3117G"],"a":[16]},{"t":"代","s":["H4074H"],"a":[18]},{"t":"志上麼？"}]},{"n":3,"text":"猶大人末底改作亞哈隨魯王的宰相，在猶大人中為大，得他眾弟兄的喜悅；他為本族的人求好處，為他種族所有人的幸福說話。","tok":[{"t":"猶大人","s":["H3064"],"a":[2]},{"t":"末底改","s":["H4782H"],"a":[1]},{"t":"作"},{"t":"亞哈隨魯","s":["H0325"],"a":[5]},{"t":"王","s":["H4428G"],"a":[4]},{"t":"的"},{"t":"宰相","s":["H4932H"],"a":[3]},{"t":"，在"},{"t":"猶大人","s":["H3064"],"a":[7]},{"t":"中為大","s":["H1419A"],"a":[6]},{"t":"，"},{"t":"得他眾","s":["H7230"],"a":[9]},{"t":"弟兄","s":["H0251I"],"a":[10]},{"t":"的喜悅","s":["H7521"],"a":[8]},{"t":"；他"},{"t":"為本族的人","s":["H5971A"],"a":[13]},{"t":"求","s":["H1875"],"a":[11]},{"t":"好處","s":["H2896B"],"a":[12]},{"t":"，為他"},{"t":"種","s":["H2233H"],"a":[17]},{"t":"族","s":["H5971A"],"a":[13]},{"t":"所有","s":["H3605"],"a":[16]},{"t":"人的幸"},{"t":"福","s":["H2896B"],"a":[12]},{"t":"說話","s":["H1696G"],"a":[14]},{"t":"。"}]}]}
