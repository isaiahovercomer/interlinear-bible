{"v":1,"book":"Esth","ch":10,"verses":[{"n":1,"text":"亞哈隨魯王使陸地和海島的人民都進貢。","tok":[{"t":"亞哈隨魯","s":["H0325"],"a":[2]},{"t":"王","s":["H4428"],"a":[1]},{"t":"使","s":["H7760","H5921"],"a":[0,4]},{"t":"陸"},{"t":"地","s":["H0776"],"a":[5]},{"t":"和海","s":["H3220"],"a":[7]},{"t":"島","s":["H0339"],"a":[6]},{"t":"的人民都進貢","s":["H4522"],"a":[3]},{"t":"。"}]},{"n":2,"text":"他以權柄勇力所行的，並王使末底改得尊大的詳確經過，豈不都寫在瑪代和波斯王的年代志上麼？","tok":[{"t":"他以權柄","s":["H8633"],"a":[2]},{"t":"勇"},{"t":"力","s":["H1369"],"a":[3]},{"t":"所"},{"t":"行","s":["H4639"],"a":[1]},{"t":"的，並王使"},{"t":"末底改","s":["H4782"],"a":[6]},{"t":"得尊大的詳確經過，"},{"t":"豈不","s":["H3808"],"a":[10]},{"t":"都"},{"t":"寫","s":["H3789"],"a":[12]},{"t":"在瑪代"},{"t":"和波斯","s":["H6539"],"a":[19]},{"t":"王","s":["H9001","H4428"],"a":[9]},{"t":"的年代志上麼？"}]},{"n":3,"text":"猶大人末底改作亞哈隨魯王的宰相，在猶大人中為大，得他眾弟兄的喜悅；他為本族的人求好處，為他種族所有人的幸福說話。","tok":[{"t":"猶大人","s":["H3064"],"a":[2]},{"t":"末底改","s":["H4782"],"a":[1]},{"t":"作亞哈隨魯","s":["H0325"],"a":[5]},{"t":"王","s":["H9001","H4428"],"a":[4]},{"t":"的宰相","s":["H4932"],"a":[3]},{"t":"，"},{"t":"在猶大人","s":["H9001","H3064"],"a":[7]},{"t":"中為大","s":["H1419"],"a":[6]},{"t":"，"},{"t":"得他眾","s":["H9001","H7230"],"a":[9]},{"t":"弟兄","s":["H0251"],"a":[10]},{"t":"的喜悅","s":["H7521"],"a":[8]},{"t":"；他"},{"t":"為本族的人","s":["H9001","H5971"],"a":[13]},{"t":"求","s":["H1875"],"a":[11]},{"t":"好處","s":["H2896"],"a":[12]},{"t":"，為"},{"t":"他","s":["H2233"],"a":[17]},{"t":"種族所有人的幸福"},{"t":"說","s":["H1696"],"a":[14]},{"t":"話。"}]}]}
