{"v":1,"book":"Ps","ch":138,"verses":[{"n":0,"text":"大衛的詩。","tok":[{"t":"大衛的","s":["H9001","H1732"],"a":[0]},{"t":"詩。"}]},{"n":1,"text":"我要全心稱謝你，在諸神面前歌頌你。","tok":[{"t":"我要","s":["H9002","H3605"],"a":[1]},{"t":"全"},{"t":"心","s":["H3820"],"a":[2]},{"t":"稱謝你","s":["H3034"],"a":[0]},{"t":"，"},{"t":"在諸神","s":["H0430"],"a":[4]},{"t":"面前","s":["H5048"],"a":[3]},{"t":"歌頌你","s":["H2167"],"a":[5]},{"t":"。"}]},{"n":2,"text":"我要向你的聖殿下拜，為你的慈愛和真實稱謝你的名；因你使你的話顯為大，超過你一切的名聲。","tok":[{"t":"我要向","s":["H0413"],"a":[1]},{"t":"你的聖","s":["H6944"],"a":[3]},{"t":"殿","s":["H1964"],"a":[2]},{"t":"下拜","s":["H7812"],"a":[0]},{"t":"，"},{"t":"為","s":["H5921"],"a":[7]},{"t":"你的慈愛","s":["H2617"],"a":[8]},{"t":"和真"},{"t":"實","s":["H0571"],"a":[10]},{"t":"稱","s":["H3034","H0853"],"a":[4,5]},{"t":"謝"},{"t":"你的名","s":["H8034"],"a":[6]},{"t":"；"},{"t":"因","s":["H3588"],"a":[11]},{"t":"你使你的話","s":["H0565"],"a":[16]},{"t":"顯為大","s":["H1431"],"a":[12]},{"t":"，超過你一切"},{"t":"的名聲","s":["H8034"],"a":[15]},{"t":"。"}]},{"n":3,"text":"我呼求的日子，你就應允我，鼓勵我，使我魂裏有能力。","tok":[{"t":"我呼求","s":["H7121"],"a":[1]},{"t":"的日子","s":["H9002","H3117"],"a":[0]},{"t":"，"},{"t":"你就應允我","s":["H6030"],"a":[2]},{"t":"，"},{"t":"鼓勵我","s":["H7292"],"a":[3]},{"t":"，"},{"t":"使我","s":["H9002","H5315"],"a":[4]},{"t":"魂裏"},{"t":"有能力","s":["H5797"],"a":[5]},{"t":"。"}]},{"n":4,"text":"耶和華阿，地上的君王都要稱謝你，因他們聽見了你口中的言語。","tok":[{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"阿，"},{"t":"地上","s":["H0776"],"a":[4]},{"t":"的君王","s":["H4428"],"a":[3]},{"t":"都"},{"t":"要稱謝你","s":["H3034"],"a":[0]},{"t":"，"},{"t":"因","s":["H3588"],"a":[5]},{"t":"他們聽見了","s":["H8085"],"a":[6]},{"t":"你口中","s":["H6310"],"a":[8]},{"t":"的言語","s":["H0561"],"a":[7]},{"t":"。"}]},{"n":5,"text":"他們要歌頌耶和華的作為，因耶和華大有榮耀。","tok":[{"t":"他們要歌頌","s":["H7891"],"a":[0]},{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"的作為","s":["H9002","H1870"],"a":[1]},{"t":"，"},{"t":"因","s":["H3588"],"a":[3]},{"t":"耶和華","s":["H3068"],"a":[6]},{"t":"大","s":["H1419"],"a":[4]},{"t":"有榮耀","s":["H3519"],"a":[5]},{"t":"。"}]},{"n":6,"tex