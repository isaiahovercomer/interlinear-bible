{"v":1,"book":"Ps","ch":138,"verses":[{"n":0,"text":"大衛的詩。","tok":[{"t":"大衛的","s":["H1732"],"a":[0]},{"t":"詩。"}]},{"n":1,"text":"我要全心稱謝你，在諸神面前歌頌你。","tok":[{"t":"我要"},{"t":"全","s":["H3605"],"a":[1]},{"t":"心","s":["H3820A"],"a":[2]},{"t":"稱謝你","s":["H3034"],"a":[0]},{"t":"，"},{"t":"在諸神","s":["H0430J"],"a":[4]},{"t":"面前","s":["H5048"],"a":[3]},{"t":"歌頌你","s":["H2167"],"a":[5]},{"t":"。"}]},{"n":2,"text":"我要向你的聖殿下拜，為你的慈愛和真實稱謝你的名；因你使你的話顯為大，超過你一切的名聲。","tok":[{"t":"我"},{"t":"要","s":["H0413"],"a":[1]},{"t":"向"},{"t":"你的聖","s":["H6944G"],"a":[3]},{"t":"殿","s":["H1964G"],"a":[2]},{"t":"下拜","s":["H7812"],"a":[0]},{"t":"，為你"},{"t":"的慈愛","s":["H2617A"],"a":[8]},{"t":"和真實","s":["H0571G"],"a":[10]},{"t":"稱謝","s":["H3034"],"a":[4]},{"t":"你"},{"t":"的名","s":["H8034"],"a":[6]},{"t":"；"},{"t":"因","s":["H3588A"],"a":[11]},{"t":"你使你的"},{"t":"話","s":["H0565A"],"a":[16]},{"t":"顯為大","s":["H1431"],"a":[12]},{"t":"，超過你"},{"t":"一切的","s":["H3605"],"a":[14]},{"t":"名聲","s":["H8034"],"a":[15]},{"t":"。"}]},{"n":3,"text":"我呼求的日子，你就應允我，鼓勵我，使我魂裏有能力。","tok":[{"t":"我呼求","s":["H7121G"],"a":[1]},{"t":"的日子","s":["H3117G"],"a":[0]},{"t":"，"},{"t":"你就應允我","s":["H6030B"],"a":[2]},{"t":"，"},{"t":"鼓勵我","s":["H7292"],"a":[3]},{"t":"，使"},{"t":"我魂裏","s":["H5315G"],"a":[4]},{"t":"有能力","s":["H5797"],"a":[5]},{"t":"。"}]},{"n":4,"text":"耶和華阿，地上的君王都要稱謝你，因他們聽見了你口中的言語。","tok":[{"t":"耶和華","s":["H3068G"],"a":[1]},{"t":"阿，"},{"t":"地上","s":["H0776G"],"a":[4]},{"t":"的君王","s":["H4428G"],"a":[3]},{"t":"都"},{"t":"要稱謝你","s":["H3034"],"a":[0]},{"t":"，"},{"t":"因","s":["H3588A"],"a":[5]},{"t":"他們聽見了","s":["H8085G"],"a":[6]},{"t":"你口中","s":["H6310G"],"a":[8]},{"t":"的"},{"t":"言語","s":["H0561"],"a":[7]},{"t":"。"}]},{"n":5,"text":"他們要歌頌耶和華的作為，因耶和華大有榮耀。","tok":[{"t":"他們要歌頌","s":["H7891"],"a":[0]},{"t":"耶和華","s":["H3068G"],"a":[2]},{"t":"的"},{"t":"作","s":["H1870G"],"a":[1]},{"t":"為，"},{"t":"因","s":["H3588A"],"a":[3]},{"t":"耶和華","s":["H3068G"],"a":[6]},{"t":"大","s":["H1419A"],"a":[4]},{"t":"有榮耀","s":["H3519"],"a":[5]},{"t":"。"}]},{"n":6,"text":"耶和華雖高，仍看顧低微的人；祂卻從遠處認出驕傲的人。","tok":[{"t":"耶和華","s":["H3068G"],"a":[2]},{"t":"雖","s":["H3588A"],"a":[0]},{"t":"高","s":["H7311A"],"a":[1]},{"t":"，"},{"t":"仍看顧","s":["H7200G"],"a":[4]},{"t":"低微的","s":["H8217"],"a":[3]},{"t":"人；祂卻"},{"t":"從遠處","s":["H4801"],"a":[6]},{"t":"認出","s":["H3045"],"a":[7]},{"t":"驕傲","s":["H1364"],"a":[5]},{"t":"的人。"}]},{"n":7,"text":"我雖行在患難中，你必使我存活；我的仇敵發怒，你必伸手抵擋他們，你的右手也必救我。","tok":[{"t":"我"},{"t":"雖","s":["H0518A"],"a":[0]},{"t":"行","s":["H1980I"],"a":[1]},{"t":"在患難","s":["H6869B"],"a":[3]},{"t":"中","s":["H7130G"],"a":[2]},{"t":"，"},{"t":"你必使我存活","s":["H2421"],"a":[4]},{"t":"；我"},{"t":"的仇敵","s":["H0341"],"a":[7]},{"t":"發怒","s":["H0639G"],"a":[6]},{"t":"，"},{"t":"你必伸","s":["H7971K"],"a":[8]},{"t":"手","s":["H3027G"],"a":[9]},{"t":"抵擋他們，你"},{"t":"的右手","s":["H3225G"],"a":[11]},{"t":"也必救我","s":["H3467"],"a":[10]},{"t":"。"}]},{"n":8,"text":"耶和華必成全關乎我的事；耶和華阿，你的慈愛永遠長存；求你不要撇棄你親手所造的。","tok":[{"t":"耶和華","s":["H3068G"],"a":[0]},{"t":"必成全","s":["H1584"],"a":[1]},{"t":"關乎我的","s":["H1157"],"a":[2]},{"t":"事；"},{"t":"耶和華","s":["H3068G"],"a":[3]},{"t":"阿，你"},{"t":"的慈愛","s":["H2617A"],"a":[4]},{"t":"永遠長存","s":["H5769G"],"a":[5]},{"t":"；求你"},{"t":"不要","s":["H0408"],"a":[8]},{"t":"撇棄","s":["H7503"],"a":[9]},{"t":"你親手","s":["H3027G"],"a":[7]},{"t":"所"},{"t":"造","s":["H4639G"],"a":[6]},{"t":"的。"}]}]}
