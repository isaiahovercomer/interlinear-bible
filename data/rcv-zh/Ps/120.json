{"v":1,"book":"Ps","ch":120,"verses":[{"n":0,"text":"上行之歌。","tok":[{"t":"上行之"},{"t":"歌","s":["H7892A"],"a":[0]},{"t":"。"}]},{"n":1,"text":"我在急難中呼求耶和華，祂就應允我。","tok":[{"t":"我在"},{"t":"急難中","s":["H6869B"],"a":[2]},{"t":"呼求","s":["H7121G"],"a":[4]},{"t":"耶和華","s":["H3068G"],"a":[1]},{"t":"，祂"},{"t":"就應允我","s":["H6030B"],"a":[5]},{"t":"。"}]},{"n":2,"text":"耶和華阿，求你救我脫離說謊的嘴脣，脫離詭詐的舌頭。","tok":[{"t":"耶和華","s":["H3068G"],"a":[0]},{"t":"阿，"},{"t":"求你救","s":["H5337"],"a":[1]},{"t":"我","s":["H9020"],"a":[2]},{"t":"脫離"},{"t":"說謊的","s":["H8267"],"a":[4]},{"t":"嘴脣","s":["H8193G"],"a":[3]},{"t":"，脫離"},{"t":"詭詐","s":["H7423A"],"a":[6]},{"t":"的舌頭","s":["H3956G"],"a":[5]},{"t":"。"}]},{"n":3,"text":"詭詐的舌頭阿，要給你甚麼呢？要拿甚麼加給你呢？","tok":[{"t":"詭詐","s":["H7423A"],"a":[7]},{"t":"的舌頭","s":["H3956G"],"a":[6]},{"t":"阿，"},{"t":"要","s":["H5414G"],"a":[1]},{"t":"給"},{"t":"你","s":["H9031"],"a":[2]},{"t":"甚麼呢？"},{"t":"要拿甚麼","s":["H4100"],"a":[3]},{"t":"加","s":["H3254H"],"a":[4]},{"t":"給"},{"t":"你","s":["H9032"],"a":[5]},{"t":"呢？"}]},{"n":4,"text":"就是勇士的利箭，連同羅騰木的炭火！","tok":[{"t":"就是勇士","s":["H1368"],"a":[1]},{"t":"的"},{"t":"利","s":["H8150"],"a":[2]},{"t":"箭","s":["H2671"],"a":[0]},{"t":"，連同"},{"t":"羅騰木","s":["H7574"],"a":[5]},{"t":"的炭火","s":["H1513"],"a":[4]},{"t":"！"}]},{"n":5,"text":"我有禍了，因我寄居在米設，住在基達帳棚之中。","tok":[{"t":"我","s":["H9030"],"a":[1]},{"t":"有禍","s":["H0190"],"a":[0]},{"t":"了，"},{"t":"因","s":["H3588A"],"a":[2]},{"t":"我寄居","s":["H1481A"],"a":[3]},{"t":"在"},{"t":"米設","s":["H4902H"],"a":[4]},{"t":"，"},{"t":"住","s":["H7931"],"a":[5]},{"t":"在"},{"t":"基達","s":["H6938"],"a":[8]},{"t":"帳棚","s":["H0168G"],"a":[7]},{"t":"之"},{"t":"中","s":["H5973A"],"a":[6]},{"t":"。"}]},{"n":6,"text":"我與那恨惡和平的人，許久同住。","tok":[{"t":"我","s":["H9020"],"a":[3]},{"t":"與那"},{"t":"恨惡","s":["H8130"],"a":[5]},{"t":"和"},{"t":"平","s":["H7965G"],"a":[6]},{"t":"的人，"},{"t":"許久","s":["H7227A"],"a":[0]},{"t":"同"},{"t":"住","s":["H7931"],"a":[1]},{"t":"。"}]},{"n":7,"text":"我願和平；但我發言，他們就要爭戰。","tok":[{"t":"我","s":["H0589"],"a":[0]},{"t":"願和平","s":["H7965G"],"a":[1]},{"t":"；"},{"t":"但","s":["H3588A"],"a":[2]},{"t":"我發言","s":["H1696G"],"a":[3]},{"t":"，"},{"t":"他們","s":["H1992"],"a":[4]},{"t":"就"},{"t":"要爭戰","s":["H4421"],"a":[5]},{"t":"。"}]}]}
