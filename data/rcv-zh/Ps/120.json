{"v":1,"book":"Ps","ch":120,"verses":[{"n":0,"text":"上行之歌。"},{"n":1,"text":"我在急難中呼求耶和華，祂就應允我。","tok":[{"t":"我","s":["H9001"],"a":[5]},{"t":"在急難中","s":["H9002","H6869"],"a":[2]},{"t":"呼"},{"t":"求","s":["H7121","H0413"],"a":[4,0]},{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"，祂"},{"t":"就應允我","s":["H6030"]},{"t":"。"}]},{"n":2,"text":"耶和華阿，求你救我脫離說謊的嘴脣，脫離詭詐的舌頭。","tok":[{"t":"耶和華","s":["H3068"],"a":[0]},{"t":"阿，"},{"t":"求你救","s":["H5337"],"a":[1]},{"t":"我","s":["H5315"],"a":[2]},{"t":"脫離說謊","s":["H8267"],"a":[4]},{"t":"的嘴","s":["H4480","H8193"],"a":[3]},{"t":"脣，脫離"},{"t":"詭詐","s":["H7423"],"a":[6]},{"t":"的舌頭","s":["H4480","H3956"],"a":[5]},{"t":"。"}]},{"n":3,"text":"詭詐的舌頭阿，要給你甚麼呢？要拿甚麼加給你呢？","tok":[{"t":"詭詐","s":["H7423"],"a":[7]},{"t":"的舌頭","s":["H3956"],"a":[6]},{"t":"阿，"},{"t":"要給","s":["H5414"],"a":[1]},{"t":"你","s":["H9001"]},{"t":"甚麼","s":["H4100"],"a":[0]},{"t":"呢？"},{"t":"要拿甚麼","s":["H4100"],"a":[3]},{"t":"加","s":["H3254"],"a":[4]},{"t":"給你","s":["H9001"]},{"t":"呢？"}]},{"n":4,"text":"就是勇士的利箭，連同羅騰木的炭火！","tok":[{"t":"就是勇士","s":["H1368"],"a":[1]},{"t":"的利","s":["H8150"],"a":[2]},{"t":"箭","s":["H2671"],"a":[0]},{"t":"，連同"},{"t":"羅騰木","s":["H7574"],"a":[5]},{"t":"的炭火","s":["H1513"],"a":[4]},{"t":"！"}]},{"n":5,"text":"我有禍了，因我寄居在米設，住在基達帳棚之中。","tok":[{"t":"我"},{"t":"有禍了","s":["H0190","H9001"],"a":[0]},{"t":"，因"},{"t":"我寄居","s":["H1481"],"a":[3]},{"t":"在米設","s":["H4902"],"a":[4]},{"t":"，"},{"t":"住","s":["H7931"],"a":[5]},{"t":"在基達","s":["H6938"],"a":[8]},{"t":"帳棚","s":["H0168"],"a":[7]},{"t":"之中","s":["H5973"],"a":[6]},{"t":"。"}]},{"n":6,"text":"我與那恨惡和平的人，許久同住。","tok":[{"t":"我","s":["H5315"],"a":[3]},{"t":"與"},{"t":"那恨惡","s":["H8130"],"a":[5]},{"t":"和平"},{"t":"的人","s":["H7227"],"a":[0]},{"t":"，"},{"t":"許久","s":["H7227"]},{"t":"同住","s":["H7931","H9001"],"a":[1]},{"t":"。"}]},{"n":7,"text":"我願和平；但我發言，他們就要爭戰。","tok":[{"t":"我","s":["H0589"],"a":[0]},{"t":"願和","s":["H7965"],"a":[1]},{"t":"平；"},{"t":"但","s":["H3588"],"a":[2]},{"t":"我發言","s":["H1696"],"a":[3]},{"t":"，"},{"t":"他們就要","s":["H1992"],"a":[4]},{"t":"爭戰","s":["H9001","H4421"],"a":[5]},{"t":"。"}]}]}
