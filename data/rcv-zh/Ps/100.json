{"v":1,"book":"Ps","ch":100,"verses":[{"n":0,"text":"稱謝的詩。","tok":[{"t":"稱謝","s":["H9001","H8426"],"a":[1]},{"t":"的"},{"t":"詩","s":["H4210"],"a":[0]},{"t":"。"}]},{"n":1,"text":"全地當向耶和華歡呼。","tok":[{"t":"全地"},{"t":"當向耶和華","s":["H9001","H3068"],"a":[1]},{"t":"歡呼","s":["H7321"],"a":[0]},{"t":"。"}]},{"n":2,"text":"你們當歡喜的事奉耶和華；當歡唱著到祂面前來。","tok":[{"t":"你們當","s":["H9002","H8057"],"a":[3]},{"t":"歡喜的"},{"t":"事奉","s":["H5647","H0853"],"a":[0,1]},{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"；"},{"t":"當","s":["H0935"],"a":[4]},{"t":"歡唱著到祂面前"},{"t":"來","s":["H0935"]},{"t":"。"}]},{"n":3,"text":"你們當曉得耶和華是神；我們是祂造的，也是屬祂的；我們是祂的民，也是祂草場的羊。","tok":[{"t":"你們當曉得","s":["H3045","H3588"],"a":[0,1]},{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"是"},{"t":"神","s":["H0430"],"a":[4]},{"t":"；"},{"t":"我們是","s":["H1931"],"a":[3]},{"t":"祂"},{"t":"造的","s":["H6213"],"a":[6]},{"t":"，也是屬祂的；"},{"t":"我們是","s":["H5971"],"a":[9]},{"t":"祂"},{"t":"的民","s":["H5971"]},{"t":"，也是祂"},{"t":"草場","s":["H4830"],"a":[11]},{"t":"的羊","s":["H6629"],"a":[10]},{"t":"。"}]},{"n":4,"text":"當稱謝著進入祂的門，讚美著進入祂的院；當感謝祂，頌讚祂的名。","tok":[{"t":"當稱謝","s":["H9002","H8426"],"a":[2]},{"t":"著"},{"t":"進入","s":["H0935"],"a":[0]},{"t":"祂"},{"t":"的門","s":["H8179"],"a":[1]},{"t":"，"},{"t":"讚美","s":["H9002","H8416"],"a":[4]},{"t":"著"},{"t":"進入","s":["H2691"],"a":[3]},{"t":"祂"},{"t":"的院","s":["H2691"]},{"t":"；"},{"t":"當感謝","s":["H3034"],"a":[5]},{"t":"祂，"},{"t":"頌","s":["H1288"],"a":[7]},{"t":"讚祂"},{"t":"的名","s":["H8034"],"a":[8]},{"t":"。"}]},{"n":5,"text":"因為耶和華本為善；祂的慈愛存到永遠，祂的信實直到萬代。","tok":[{"t":"因為","s":["H3588"],"a":[0]},{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"本為善","s":["H2896"],"a":[1]},{"t":"；祂"},{"t":"的慈愛","s":["H2617"],"a":[4]},{"t":"存到永遠","s":["H9001","H5769"],"a":[3]},{"t":"，祂"},{"t":"的信實","s":["H0530"],"a":[8]},{"t":"直到","s":["H5704"],"a":[5]},{"t":"萬代","s":["H1755","H1755"],"a":[6,7]},{"t":"。"}]}]}
