{"v":1,"book":"Ps","ch":3,"verses":[{"n":0,"text":"大衛逃避他兒子押沙龍的時候作的詩。","tok":[{"t":"大衛","s":["H9001","H1732"],"a":[1]},{"t":"逃避","s":["H9002","H1272","H4480","H6440"],"a":[2,3]},{"t":"他兒子","s":["H1121"],"a":[5]},{"t":"押沙龍","s":["H0053"],"a":[4]},{"t":"的時候作的詩","s":["H4210"],"a":[0]},{"t":"。"}]},{"n":1,"text":"耶和華阿，我的敵人何其多！有許多人起來攻擊我！","tok":[{"t":"耶和華","s":["H3068"],"a":[0]},{"t":"阿，"},{"t":"我的敵人","s":["H6862"],"a":[3]},{"t":"何其","s":["H4100"],"a":[1]},{"t":"多！"},{"t":"有許多人","s":["H7227"],"a":[4]},{"t":"起來","s":["H6965"],"a":[5]},{"t":"攻擊我","s":["H5921"],"a":[6]},{"t":"！"}]},{"n":2,"text":"有許多人論到我說，他得不著神的拯救！〔細拉〕","tok":[{"t":"有許多人","s":["H7227"],"a":[0]},{"t":"論","s":["H0559","H0000"],"a":[1]},{"t":"到"},{"t":"我","s":["H9001","H5315"],"a":[2]},{"t":"說","s":["H0559"]},{"t":"，"},{"t":"他","s":["H9001"]},{"t":"得不著","s":["H0369"],"a":[3]},{"t":"神","s":["H9002","H0430"],"a":[6]},{"t":"的拯救！〔"},{"t":"細拉","s":["H5542"],"a":[7]},{"t":"〕"}]},{"n":3,"text":"但你耶和華是我四圍的盾牌，是我的榮耀，又是叫我抬起頭來的。","tok":[{"t":"但你","s":["H0859"],"a":[0]},{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"是我四圍","s":["H1157"],"a":[3]},{"t":"的盾牌","s":["H4043"],"a":[2]},{"t":"，"},{"t":"是我的榮耀","s":["H3519"],"a":[4]},{"t":"，"},{"t":"又是叫我抬起","s":["H7311"],"a":[5]},{"t":"頭","s":["H7218"],"a":[6]},{"t":"來的。"}]},{"n":4,"text":"我用我的聲音呼求耶和華，祂就從祂的聖山上應允我。〔細拉〕","tok":[{"t":"我用我的聲音","s":["H6963"],"a":[0]},{"t":"呼"},{"t":"求","s":["H7121","H0413"],"a":[3,1]},{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"，祂就從祂"},{"t":"的聖","s":["H6944"],"a":[6]},{"t":"山","s":["H4480","H2022"],"a":[5]},{"t":"上應允我","s":["H6030"],"a":[4]},{"t":"。〔"},{"t":"細拉","s":["H5542"],"a":[7]},{"t":"〕"}]},{"n":5,"text":"我躺下睡覺，我醒過來，因為有耶和華扶持我。","tok":[{"t":"我","s":["H0589"],"a":[0]},{"t":"躺下","s":["H7901"],"a":[1]},{"t":"睡覺","s":["H3462"],"a":[2]},{"t":"，"},{"t":"我醒","s":["H6974"],"a":[3]},{"t":"過來，因為有"},{"t":"耶和華","s":["H3068"],"a":[5]},{"t":"扶持"},{"t":"我","s":["H5564"],"a":[6]},{"t":"。"}]},{"n":6,"text":"雖有成萬的民周圍攻擊我，我也不怕。","tok":[{"t":"雖有成萬","s":["H4480","H7233"],"a":[2]},{"t":"的民"},{"t":"周圍","s":["H5439"],"a":[5]},{"t":"攻擊我","s":["H5921"],"a":[7]},{"t":"，"},{"t":"我也不","s":["H3808"],"a":[0]},{"t":"怕","s":["H3372"],"a":[1]},{"t":"。"}]},{"n":7,"text":"耶和華阿，求你起來；我的神阿，求你救我！願你擊打我一切仇敵的腮骨，敲碎惡人的牙齒。","tok":[{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"阿，"},{"t":"求你起來","s":["H6965"],"a":[0]},{"t":"；我的"},{"t":"神","s":["H0430"],"a":[3]},{"t":"阿，"},{"t":"求你救我","s":["H3467"],"a":[2]},{"t":"！願"},{"t":"你","s":["H5221","H0853"],"a":[5,6]},{"t":"擊"},{"t":"打","s":["H5221","H0853"]},{"t":"我一切","s":["H3605"],"a":[7]},{"t":"仇敵","s":["H0341"],"a":[8]},{"t":"的腮骨","s":["H3895"],"a":[9]},{"t":"，"},{"t":"敲碎","s":["H7665"],"a":[12]},{"t":"惡人","s":["H7563"],"a":[11]},{"t":"的牙齒","s":["H8127"],"a":[10]},{"t":"。"}]},{"n":8,"text":"拯救屬於耶和華；願你賜福給你的民。〔細拉〕","tok":[{"t":"拯"},{"t":"救","s":["H3444"],"a":[1]},{"t":"屬","s":["H9001","H3068"],"a":[0]},{"t":"於"},{"t":"耶和華","s":["H9001","H3068"]},{"t":"；"},{"t":"願你賜福","s":["H1293"],"a":[4]},{"t":"給"},{"t":"你的","s":["H5971"],"a":[3]},{"t":"民。〔"},{"t":"細拉","s":["H5542"],"a":[5]},{"t":"〕"}]}]}
