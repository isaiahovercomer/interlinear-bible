{"v":1,"book":"Ps","ch":130,"verses":[{"n":0,"text":"上行之歌。","tok":[{"t":"上行","s":["H4609"],"a":[1]},{"t":"之歌。"}]},{"n":1,"text":"耶和華阿，我從深處向你呼求。","tok":[{"t":"耶和華","s":["H3068"],"a":[2]},{"t":"阿，"},{"t":"我從深處","s":["H4480","H4615"],"a":[0]},{"t":"向你","s":["H7121"],"a":[1]},{"t":"呼"},{"t":"求","s":["H7121"]},{"t":"。"}]},{"n":2,"text":"主阿，求你聽我的聲音；願你側耳聽我懇求的聲音。","tok":[{"t":"主","s":["H0136"],"a":[0]},{"t":"阿，"},{"t":"求你聽","s":["H8085"],"a":[1]},{"t":"我的聲音","s":["H9002","H6963"],"a":[2]},{"t":"；"},{"t":"願","s":["H1961"],"a":[3]},{"t":"你側","s":["H7183"],"a":[5]},{"t":"耳","s":["H0241"],"a":[4]},{"t":"聽我懇求","s":["H8469"],"a":[7]},{"t":"的聲音","s":["H9001","H6963"],"a":[6]},{"t":"。"}]},{"n":3,"text":"耶和華阿，你若察看罪孽，主阿，誰能站得住呢？","tok":[{"t":"耶和華","s":["H3050"],"a":[3]},{"t":"阿，"},{"t":"你若","s":["H0518"],"a":[0]},{"t":"察","s":["H8104"],"a":[2]},{"t":"看"},{"t":"罪孽","s":["H5771"],"a":[1]},{"t":"，"},{"t":"主","s":["H0136"],"a":[4]},{"t":"阿，"},{"t":"誰","s":["H4310"],"a":[5]},{"t":"能站","s":["H5975"],"a":[6]},{"t":"得住呢？"}]},{"n":4,"text":"但在你有赦免之恩，要叫人敬畏你。","tok":[{"t":"但","s":["H3588"],"a":[0]},{"t":"在你","s":["H5973"],"a":[1]},{"t":"有赦免之恩","s":["H5547"],"a":[2]},{"t":"，"},{"t":"要","s":["H9001","H4616"],"a":[3]},{"t":"叫人敬畏你","s":["H3372"],"a":[4]},{"t":"。"}]},{"n":5,"text":"我等候耶和華；我的魂等候，我也仰望祂的話。","tok":[{"t":"我等候","s":["H6960"],"a":[0]},{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"；"},{"t":"我的","s":["H5315"],"a":[3]},{"t":"魂"},{"t":"等候","s":["H6960"],"a":[2]},{"t":"，"},{"t":"我也仰望","s":["H3176"],"a":[5]},{"t":"祂"},{"t":"的話","s":["H9001","H1697"],"a":[4]},{"t":"。"}]},{"n":6,"text":"我的魂等候主，勝於守夜的等候天亮，勝於守夜的等候天亮。","tok":[{"t":"我的","s":["H5315"],"a":[0]},{"t":"魂"},{"t":"等候主","s":["H9001","H0136"],"a":[1]},{"t":"，"},{"t":"勝於守夜的","s":["H4480","H8104"],"a":[2]},{"t":"等候天亮","s":["H9001","H1242"],"a":[3]},{"t":"，"},{"t":"勝於守夜的","s":["H8104"],"a":[4]},{"t":"等候天亮","s":["H9001","H1242"],"a":[5]},{"t":"。"}]},{"n":7,"text":"以色列阿，你當仰望耶和華；因耶和華有慈愛，在祂那裏有豐盛的救贖；","tok":[{"t":"以色列","s":["H3478"],"a":[1]},{"t":"阿，"},{"t":"你當仰望","s":["H3176","H0413"],"a":[0,2]},{"t":"耶和華","s":["H3068"],"a":[3]},{"t":"；"},{"t":"因","s":["H3588"],"a":[4]},{"t":"耶和華"},{"t":"有","s":["H5973"],"a":[5]},{"t":"慈愛","s":["H2617"],"a":[7]},{"t":"，在祂那裏"},{"t":"有","s":["H5973"],"a":[9]},{"t":"豐盛的","s":["H7235"],"a":[8]},{"t":"救","s":["H6304"],"a":[10]},{"t":"贖；"}]},{"n":8,"text":"祂必救贖以色列脫離一切的罪孽。","tok":[{"t":"祂"},{"t":"必","s":["H1931"],"a":[0]},{"t":"救贖","s":["H6299","H0853"],"a":[1,2]},{"t":"以色列","s":["H3478"],"a":[3]},{"t":"脫離一切的","s":["H4480","H3605"],"a":[4]},{"t":"罪孽","s":["H5771"],"a":[5]},{"t":"。"}]}]}
