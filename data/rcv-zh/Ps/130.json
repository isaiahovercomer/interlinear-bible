{"v":1,"book":"Ps","ch":130,"verses":[{"n":0,"text":"上行之歌。","tok":[{"t":"上"},{"t":"行","s":["H4609B"],"a":[1]},{"t":"之"},{"t":"歌","s":["H7892A"],"a":[0]},{"t":"。"}]},{"n":1,"text":"耶和華阿，我從深處向你呼求。","tok":[{"t":"耶和華","s":["H3068G"],"a":[2]},{"t":"阿，我"},{"t":"從深處","s":["H4615"],"a":[0]},{"t":"向你呼求","s":["H7121G"],"a":[1]},{"t":"。"}]},{"n":2,"text":"主阿，求你聽我的聲音；願你側耳聽我懇求的聲音。","tok":[{"t":"主","s":["H0136"],"a":[0]},{"t":"阿，"},{"t":"求你聽","s":["H8085G"],"a":[1]},{"t":"我的聲音","s":["H6963A"],"a":[2]},{"t":"；"},{"t":"願","s":["H1961"],"a":[3]},{"t":"你","s":["H9021"],"a":[4]},{"t":"側","s":["H7183B"],"a":[5]},{"t":"耳","s":["H0241G"],"a":[4]},{"t":"聽"},{"t":"我懇求","s":["H8469"],"a":[7]},{"t":"的聲音","s":["H6963A"],"a":[6]},{"t":"。"}]},{"n":3,"text":"耶和華阿，你若察看罪孽，主阿，誰能站得住呢？","tok":[{"t":"耶和華","s":["H3050"],"a":[3]},{"t":"阿，你"},{"t":"若","s":["H0518A"],"a":[0]},{"t":"察看","s":["H8104I"],"a":[2]},{"t":"罪孽","s":["H5771G"],"a":[1]},{"t":"，"},{"t":"主","s":["H0136"],"a":[4]},{"t":"阿，"},{"t":"誰","s":["H4310"],"a":[5]},{"t":"能站","s":["H5975G"],"a":[6]},{"t":"得住呢？"}]},{"n":4,"text":"但在你有赦免之恩，要叫人敬畏你。","tok":[{"t":"但","s":["H3588A"],"a":[0]},{"t":"在"},{"t":"你","s":["H9031"],"a":[1]},{"t":"有赦免之恩","s":["H5547"],"a":[2]},{"t":"，"},{"t":"要","s":["H4616"],"a":[3]},{"t":"叫人"},{"t":"敬畏你","s":["H3372H"],"a":[4]},{"t":"。"}]},{"n":5,"text":"我等候耶和華；我的魂等候，我也仰望祂的話。","tok":[{"t":"我等候","s":["H6960A"],"a":[0]},{"t":"耶和華","s":["H3068G"],"a":[1]},{"t":"；"},{"t":"我的魂","s":["H5315G"],"a":[3]},{"t":"等候","s":["H6960A"],"a":[2]},{"t":"，我也"},{"t":"仰望","s":["H3176H"],"a":[5]},{"t":"祂的話","s":["H1697G"],"a":[4]},{"t":"。"}]},{"n":6,"text":"我的魂等候主，勝於守夜的等候天亮，勝於守夜的等候天亮。","tok":[{"t":"我的魂","s":["H5315G"],"a":[0]},{"t":"等候主","s":["H0136"],"a":[1]},{"t":"，勝"},{"t":"於守夜的","s":["H8104H"],"a":[2]},{"t":"等"},{"t":"候天亮","s":["H1242"],"a":[3]},{"t":"，勝"},{"t":"於守夜的","s":["H8104H"],"a":[4]},{"t":"等"},{"t":"候天亮","s":["H1242"],"a":[5]},{"t":"。"}]},{"n":7,"text":"以色列阿，你當仰望耶和華；因耶和華有慈愛，在祂那裏有豐盛的救贖；","tok":[{"t":"以色列","s":["H3478"],"a":[1]},{"t":"阿，"},{"t":"你當仰望","s":["H3176H"],"a":[0]},{"t":"耶和華","s":["H3068G"],"a":[3]},{"t":"；"},{"t":"因","s":["H3588A"],"a":[4]},{"t":"耶和華"},{"t":"有","s":["H5973A"],"a":[5]},{"t":"慈愛","s":["H2617A"],"a":[7]},{"t":"，在祂"},{"t":"那","s":["H2617A"],"a":[7]},{"t":"裏"},{"t":"有","s":["H5973A"],"a":[9]},{"t":"豐盛","s":["H7235A"],"a":[8]},{"t":"的"},{"t":"救贖","s":["H6304"],"a":[10]},{"t":"；"}]},{"n":8,"text":"祂必救贖以色列脫離一切的罪孽。","tok":[{"t":"祂必","s":["H1931"],"a":[0]},{"t":"救贖","s":["H6299"],"a":[1]},{"t":"以色列","s":["H3478"],"a":[3]},{"t":"脫離一切的","s":["H3605"],"a":[4]},{"t":"罪孽","s":["H5771G"],"a":[5]},{"t":"。"}]}]}
