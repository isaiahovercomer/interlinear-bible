{"v":1,"book":"Ps","ch":112,"verses":[{"n":1,"text":"阿利路亞！敬畏耶和華，甚喜愛祂命令的，這人便為有福。","tok":[{"t":"阿利路亞！"},{"t":"敬畏","s":["H3372","H0853"],"a":[5]},{"t":"耶和華","s":["H3068"],"a":[6]},{"t":"，"},{"t":"甚","s":["H3966"],"a":[9]},{"t":"喜愛","s":["H2654"],"a":[8]},{"t":"祂"},{"t":"命令","s":["H9002","H4687"],"a":[7]},{"t":"的，"},{"t":"這人","s":["H0376"],"a":[3]},{"t":"便為有福","s":["H0835"],"a":[2]},{"t":"。"}]},{"n":2,"text":"他的後裔在地上必強盛；正直人的後代必蒙福。","tok":[{"t":"他的後裔","s":["H2233"],"a":[3]},{"t":"在地上"},{"t":"必","s":["H1961"],"a":[2]},{"t":"強盛","s":["H1368"],"a":[0]},{"t":"；"},{"t":"正直人","s":["H3477"],"a":[5]},{"t":"的後代","s":["H1755"],"a":[4]},{"t":"必蒙福","s":["H1288"],"a":[6]},{"t":"。"}]},{"n":3,"text":"他家中有貲財和財富，他的義存到永遠。","tok":[{"t":"他家中","s":["H9002","H1004"],"a":[1,2]},{"t":"有","s":["H1952"],"a":[0]},{"t":"貲財和財富，"},{"t":"他的義","s":["H6666"],"a":[3]},{"t":"存","s":["H5975"],"a":[4]},{"t":"到永遠","s":["H9001","H5703"],"a":[5]},{"t":"。"}]},{"n":4,"text":"正直人在黑暗中，有光向他出現；他有恩惠，有憐恤，有公義。","tok":[{"t":"正直人","s":["H9001","H3477"],"a":[3]},{"t":"在黑暗中","s":["H9002","H2822"],"a":[5,1]},{"t":"，"},{"t":"有光","s":["H0216"],"a":[2]},{"t":"向他","s":["H2224"],"a":[0]},{"t":"出"},{"t":"現","s":["H2224"]},{"t":"；"},{"t":"他有恩惠","s":["H2587"],"a":[4]},{"t":"，"},{"t":"有憐","s":["H7349"]},{"t":"恤，"},{"t":"有公義","s":["H6662"],"a":[6]},{"t":"。"}]},{"n":5,"text":"施恩與人，借貸與人的，這人必得亨通；他被審判的時候，要訴明自己的冤。","tok":[{"t":"施恩","s":["H2603"],"a":[2]},{"t":"與人，"},{"t":"借貸","s":["H3867"],"a":[3]},{"t":"與人的，"},{"t":"這人","s":["H0376"],"a":[1]},{"t":"必得亨通；"},{"t":"他被審判的時候","s":["H9002","H4941"],"a":[6]},{"t":"，"},{"t":"要訴明","s":["H3557"],"a":[4]},{"t":"自己的冤","s":["H1697"],"a":[5]},{"t":"。"}]},{"n":6,"text":"因為他永不動搖；義人必被記念，直到永遠。","tok":[{"t":"因為"},{"t":"他永","s":["H9001","H5769"],"a":[1]},{"t":"不","s":["H3808"],"a":[2]},{"t":"動搖","s":["H4131"],"a":[3]},{"t":"；"},{"t":"義人","s":["H6662","H1961"],"a":[7,6]},{"t":"必"},{"t":"被記念","s":["H9001","H2143"],"a":[4]},{"t":"，"},{"t":"直到永遠","s":["H5769"],"a":[5]},{"t":"。"}]},{"n":7,"text":"他必不怕兇惡的信息；他心堅定，信靠耶和華。","tok":[{"t":"他必不","s":["H3808"],"a":[2]},{"t":"怕","s":["H3372"],"a":[3]},{"t":"兇"},{"t":"惡","s":["H7451"],"a":[1]},{"t":"的信息","s":["H4480","H8052"],"a":[0]},{"t":"；"},{"t":"他心","s":["H3820"],"a":[5]},{"t":"堅定","s":["H3559"],"a":[4]},{"t":"，信"},{"t":"靠","s":["H0982"],"a":[6]},{"t":"耶和華","s":["H9002","H3068"],"a":[7]},{"t":"。"}]},{"n":8,"text":"他的心得了扶持，總不懼怕，直到他看見敵人遭報。","tok":[{"t":"他","s":["H3820"],"a":[1]},{"t":"的"},{"t":"心","s":["H3820"]},{"t":"得了扶持，"},{"t":"總不","s":["H3808"],"a":[2]},{"t":"懼怕","s":["H3372"],"a":[3]},{"t":"，"},{"t":"直到","s":["H5704","H0834"],"a":[4,5]},{"t":"他看見","s":["H7200"],"a":[6]},{"t":"敵人","s":["H9002","H6862"],"a":[7]},{"t":"遭報。"}]},{"n":9,"text":"他分施賙濟貧窮；他的義存到永遠。他的角必被高舉，而有尊榮。","tok":[{"t":"他","s":["H6340"],"a":[0]},{"t":"分"},{"t":"施","s":["H6340"]},{"t":"賙濟","s":["H5414"],"a":[1]},{"t":"貧窮","s":["H9001","H0034"],"a":[2]},{"t":"；"},{"t":"他的義","s":["H6666"],"a":[3]},{"t":"存","s":["H5975"],"a":[4]},{"t":"到永遠","s":["H9001","H5703"],"a":[5]},{"t":"。"},{"t":"他的角","s":["H7161"],"a":[6]},{"t":"必被高舉","s":["H7311"],"a":[7]},{"t":"，而"},{"t":"有","s":["H9002","H3519"],"a":[8]},{"t":"尊"},{"t":"榮","s":["H9002","H3519"]},{"t":"。"}]},{"n":10,"text":"惡人看見便惱恨，必咬牙而融化；惡人的心願要歸滅絕。","tok":[{"t":"惡人","s":["H7563"],"a":[0]},{"t":"看見","s":["H7200"],"a":[1]},{"t":"便惱恨","s":["H3707"],"a":[2]},{"t":"，"},{"t":"必咬","s":["H2786"],"a":[4]},{"t":"牙","s":["H8127"],"a":[3]},{"t":"而融"},{"t":"化","s":["H4549"],"a":[5]},{"t":"；"},{"t":"惡人","s":["H7563"],"a":[7]},{"t":"的心願","s":["H8378"],"a":[6]},{"t":"要歸滅絕","s":["H0006"],"a":[8]},{"t":"。"}]}]}
