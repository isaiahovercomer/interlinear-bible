{"v":1,"book":"Ps","ch":112,"verses":[{"n":1,"text":"阿利路亞！敬畏耶和華，甚喜愛祂命令的，這人便為有福。","tok":[{"t":"阿"},{"t":"利路亞","s":["H3050"],"a":[1]},{"t":"！"},{"t":"敬畏","s":["H3373"],"a":[4]},{"t":"耶和華","s":["H3068G"],"a":[6]},{"t":"，"},{"t":"甚","s":["H3966"],"a":[9]},{"t":"喜愛","s":["H2654A"],"a":[8]},{"t":"祂命令","s":["H4687"],"a":[7]},{"t":"的，這"},{"t":"人","s":["H0376G"],"a":[3]},{"t":"便為"},{"t":"有福","s":["H0835"],"a":[2]},{"t":"。"}]},{"n":2,"text":"他的後裔在地上必強盛；正直人的後代必蒙福。","tok":[{"t":"他的後裔","s":["H2233H"],"a":[3]},{"t":"在地上","s":["H0776G"],"a":[1]},{"t":"必","s":["H1961"],"a":[2]},{"t":"強盛","s":["H1368"],"a":[0]},{"t":"；"},{"t":"正直人","s":["H3477G"],"a":[5]},{"t":"的"},{"t":"後代","s":["H1755"],"a":[4]},{"t":"必蒙福","s":["H1288"],"a":[6]},{"t":"。"}]},{"n":3,"text":"他家中有貲財和財富，他的義存到永遠。","tok":[{"t":"他家中","s":["H1004B"],"a":[2]},{"t":"有貲財和財"},{"t":"富","s":["H6239"],"a":[1]},{"t":"，"},{"t":"他的義","s":["H6666"],"a":[3]},{"t":"存","s":["H5975G"],"a":[4]},{"t":"到永遠","s":["H5703"],"a":[5]},{"t":"。"}]},{"n":4,"text":"正直人在黑暗中，有光向他出現；他有恩惠，有憐恤，有公義。","tok":[{"t":"正直人","s":["H3477G"],"a":[3]},{"t":"在黑暗中","s":["H2822"],"a":[1]},{"t":"，"},{"t":"有光","s":["H0216"],"a":[2]},{"t":"向"},{"t":"他","s":["H2224"],"a":[0]},{"t":"出現；他"},{"t":"有恩惠","s":["H2587"],"a":[4]},{"t":"，"},{"t":"有憐恤","s":["H7349"],"a":[5]},{"t":"，"},{"t":"有公義","s":["H6662"],"a":[6]},{"t":"。"}]},{"n":5,"text":"施恩與人，借貸與人的，這人必得亨通；他被審判的時候，要訴明自己的冤。","tok":[{"t":"施恩","s":["H2603A"],"a":[2]},{"t":"與人，"},{"t":"借貸","s":["H3867B"],"a":[3]},{"t":"與"},{"t":"人","s":["H0376G"],"a":[1]},{"t":"的，"},{"t":"這人","s":["H0376G"],"a":[1]},{"t":"必得亨通；他"},{"t":"被審判的時候","s":["H4941H"],"a":[6]},{"t":"，"},{"t":"要訴明","s":["H3557"],"a":[4]},{"t":"自己","s":["H1697L"],"a":[5]},{"t":"的冤。"}]},{"n":6,"text":"因為他永不動搖；義人必被記念，直到永遠。","tok":[{"t":"因為","s":["H3588A"],"a":[0]},{"t":"他"},{"t":"永","s":["H5769G"],"a":[1]},{"t":"不","s":["H3808"],"a":[2]},{"t":"動搖","s":["H4131"],"a":[3]},{"t":"；"},{"t":"義人","s":["H6662"],"a":[7]},{"t":"必被"},{"t":"記念","s":["H2143"],"a":[4]},{"t":"，直到"},{"t":"永遠","s":["H5769G"],"a":[5]},{"t":"。"}]},{"n":7,"text":"他必不怕兇惡的信息；他心堅定，信靠耶和華。","tok":[{"t":"他"},{"t":"必不","s":["H3808"],"a":[2]},{"t":"怕","s":["H3372G"],"a":[3]},{"t":"兇"},{"t":"惡","s":["H7451A"],"a":[1]},{"t":"的"},{"t":"信息","s":["H8052"],"a":[0]},{"t":"；"},{"t":"他心","s":["H3820A"],"a":[5]},{"t":"堅定","s":["H3559H"],"a":[4]},{"t":"，信"},{"t":"靠","s":["H0982"],"a":[6]},{"t":"耶和華","s":["H3068G"],"a":[7]},{"t":"。"}]},{"n":8,"text":"他的心得了扶持，總不懼怕，直到他看見敵人遭報。","tok":[{"t":"他的心","s":["H3820A"],"a":[1]},{"t":"得了"},{"t":"扶","s":["H5564"],"a":[0]},{"t":"持，"},{"t":"總不","s":["H3808"],"a":[2]},{"t":"懼怕","s":["H3372G"],"a":[3]},{"t":"，"},{"t":"直到","s":["H5704"],"a":[4]},{"t":"他"},{"t":"看見","s":["H7200G"],"a":[6]},{"t":"敵人遭報","s":["H6862C"],"a":[7]},{"t":"。"}]},{"n":9,"text":"他分施賙濟貧窮；他的義存到永遠。他的角必被高舉，而有尊榮。","tok":[{"t":"他分施","s":["H6340"],"a":[0]},{"t":"賙濟","s":["H5414G"],"a":[1]},{"t":"貧窮","s":["H0034"],"a":[2]},{"t":"；"},{"t":"他的義","s":["H6666"],"a":[3]},{"t":"存","s":["H5975G"],"a":[4]},{"t":"到永遠","s":["H5703"],"a":[5]},{"t":"。"},{"t":"他的角","s":["H7161A"],"a":[6]},{"t":"必被高舉","s":["H7311A"],"a":[7]},{"t":"，而"},{"t":"有尊榮","s":["H3519"],"a":[8]},{"t":"。"}]},{"n":10,"text":"惡人看見便惱恨，必咬牙而融化；惡人的心願要歸滅絕。","tok":[{"t":"惡人","s":["H7563"],"a":[0]},{"t":"看見","s":["H7200G"],"a":[1]},{"t":"便"},{"t":"惱恨","s":["H3707"],"a":[2]},{"t":"，"},{"t":"必咬","s":["H2786"],"a":[4]},{"t":"牙","s":["H8127G"],"a":[3]},{"t":"而"},{"t":"融化","s":["H4549"],"a":[5]},{"t":"；"},{"t":"惡人","s":["H7563"],"a":[7]},{"t":"的心願","s":["H8378"],"a":[6]},{"t":"要歸滅絕","s":["H0006"],"a":[8]},{"t":"。"}]}]}
