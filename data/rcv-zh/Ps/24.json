{"v":1,"book":"Ps","ch":24,"verses":[{"n":0,"text":"大衛的詩。","tok":[{"t":"大衛的","s":["H1732"],"a":[0]},{"t":"詩","s":["H4210"],"a":[1]},{"t":"。"}]},{"n":1,"text":"地和其中所充滿的，世界和住在其間的，都屬耶和華。","tok":[{"t":"地","s":["H0776G"],"a":[1]},{"t":"和"},{"t":"其中所充滿的","s":["H4393"],"a":[2]},{"t":"，"},{"t":"世界","s":["H8398"],"a":[3]},{"t":"和住","s":["H3427"],"a":[4]},{"t":"在其間的，"},{"t":"都屬耶和華","s":["H3068G"],"a":[0]},{"t":"。"}]},{"n":2,"text":"祂把地奠定在海上，堅立在江河之上。","tok":[{"t":"祂把"},{"t":"地奠定","s":["H3245"],"a":[4]},{"t":"在海上","s":["H3220G"],"a":[3]},{"t":"，"},{"t":"堅","s":["H3559H"],"a":[7]},{"t":"立在"},{"t":"江河","s":["H5104H"],"a":[6]},{"t":"之"},{"t":"上","s":["H5921A"],"a":[5]},{"t":"。"}]},{"n":3,"text":"誰能登耶和華的山，誰能站在祂的聖所？","tok":[{"t":"誰","s":["H4310"],"a":[0]},{"t":"能登","s":["H5927G"],"a":[1]},{"t":"耶和華","s":["H3068G"],"a":[3]},{"t":"的山","s":["H2022G"],"a":[2]},{"t":"，"},{"t":"誰","s":["H4310"],"a":[4]},{"t":"能站","s":["H6965I"],"a":[5]},{"t":"在祂"},{"t":"的聖所","s":["H6944G"],"a":[7]},{"t":"？"}]},{"n":4,"text":"就是手潔心清，魂不仰慕虛妄，不詭詐起誓的人。","tok":[{"t":"就是手","s":["H3709G"],"a":[1]},{"t":"潔"},{"t":"心","s":["H3824"],"a":[3]},{"t":"清","s":["H1249"],"a":[2]},{"t":"，"},{"t":"魂","s":["H5315G"],"a":[8]},{"t":"不","s":["H3808"],"a":[5]},{"t":"仰","s":["H5375O"],"a":[6]},{"t":"慕"},{"t":"虛妄","s":["H7723G"],"a":[7]},{"t":"，不"},{"t":"詭詐","s":["H4820"],"a":[11]},{"t":"起誓的","s":["H7650"],"a":[10]},{"t":"人。"}]},{"n":5,"text":"他必從耶和華得著祝福，又從救他的神得著公義。","tok":[{"t":"他必","s":["H5375H"],"a":[0]},{"t":"從"},{"t":"耶和華","s":["H3068G"],"a":[3]},{"t":"得著"},{"t":"祝福","s":["H1293"],"a":[1]},{"t":"，又從"},{"t":"救他","s":["H3468"],"a":[6]},{"t":"的神","s":["H0430G"],"a":[5]},{"t":"得著"},{"t":"公義","s":["H6666"],"a":[4]},{"t":"。"}]},{"n":6,"text":"這是尋求耶和華的族類，是尋求你面的雅各。〔細拉〕","tok":[{"t":"這","s":["H2088"],"a":[0]},{"t":"是尋求","s":["H1875"],"a":[2]},{"t":"耶和華"},{"t":"的族類","s":["H1755"],"a":[1]},{"t":"，是尋"},{"t":"求","s":["H1245"],"a":[3]},{"t":"你面","s":["H6440H"],"a":[4]},{"t":"的雅各","s":["H3290"],"a":[5]},{"t":"。〔"},{"t":"細拉〕","s":["H5542"],"a