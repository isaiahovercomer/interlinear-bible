{"v":1,"book":"Ps","ch":129,"verses":[{"n":0,"text":"上行之歌。","tok":[{"t":"上行","s":["H4609"],"a":[1]},{"t":"之歌。"}]},{"n":1,"text":"以色列當說，從我幼年以來，敵人屢次苦害我，","tok":[{"t":"以色列","s":["H3478"],"a":[5]},{"t":"當","s":["H4994"],"a":[4]},{"t":"說","s":["H0559"],"a":[3]},{"t":"，"},{"t":"從我幼年以來","s":["H4480","H5271"],"a":[2]},{"t":"，"},{"t":"敵人屢次","s":["H7227"],"a":[0]},{"t":"苦害我","s":["H6887"],"a":[1]},{"t":"，"}]},{"n":2,"text":"從我幼年以來，敵人屢次苦害我，卻沒有勝過我。","tok":[{"t":"從我幼年以來","s":["H4480","H5271"],"a":[2]},{"t":"，"},{"t":"敵人屢次","s":["H7227"],"a":[0]},{"t":"苦害我","s":["H6887"],"a":[1]},{"t":"，"},{"t":"卻","s":["H1571"],"a":[3]},{"t":"沒有","s":["H3808"],"a":[4]},{"t":"勝","s":["H3201"],"a":[5]},{"t":"過"},{"t":"我","s":["H9001"]},{"t":"。"}]},{"n":3,"text":"他們好像扶犁的，在我背上扶犁而耕；耕的犁溝甚長。","tok":[{"t":"他們好像"},{"t":"扶犁的","s":["H2790"],"a":[2]},{"t":"，在"},{"t":"我背","s":["H1354"],"a":[1]},{"t":"上扶犁而耕","s":["H2790"],"a":[3]},{"t":"；"},{"t":"耕的犁溝","s":["H9001","H4618"],"a":[5]},{"t":"甚長","s":["H0748"],"a":[4]},{"t":"。"}]},{"n":4,"text":"耶和華是公義的；祂砍斷了惡人的繩索。","tok":[{"t":"耶和華","s":["H3068"],"a":[0]},{"t":"是公義的","s":["H6662"],"a":[1]},{"t":"；祂"},{"t":"砍斷了","s":["H7112"],"a":[2]},{"t":"惡人","s":["H7563"],"a":[4]},{"t":"的繩索","s":["H5688"],"a":[3]},{"t":"。"}]},{"n":5,"text":"願恨惡錫安的，都蒙羞退後。","tok":[{"t":"願恨惡","s":["H8130"],"a":[4]},{"t":"錫安","s":["H6726"],"a":[5]},{"t":"的，都"},{"t":"蒙羞","s":["H0954"],"a":[0]},{"t":"退","s":["H5472"],"a":[1]},{"t":"後","s":["H0268"],"a":[2]},{"t":"。"}]},{"n":6,"text":"願他們像房頂上的草，未長成而枯萎；","tok":[{"t":"願他們","s":["H1961"],"a":[0]},{"t":"像房頂上","s":["H1406"],"a":[2]},{"t":"的草","s":["H9003","H2682"],"a":[1]},{"t":"，"},{"t":"未","s":["H7945","H6927"],"a":[3]},{"t":"長成","s":["H8025"],"a":[4]},{"t":"而枯","s":["H3001"],"a":[5]},{"t":"萎；"}]},{"n":7,"text":"收割的不彀一把，捆禾的也不彀滿懷。","tok":[{"t":"收割的","s":["H7114"],"a":[3]},{"t":"不","s":["H7945","H3808"],"a":[0]},{"t":"彀"},{"t":"一把","s":["H3709"],"a":[2]},{"t":"，"},{"t":"捆禾的","s":["H6014"],"a":[5]},{"t":"也不","s":["H2683"],"a":[4]},{"t":"彀"},{"t":"滿懷","s":["