{"v":1,"book":"Ps","ch":99,"verses":[{"n":1,"text":"耶和華作王；眾民當戰抖。祂坐在二基路伯之間；地當動搖。","tok":[{"t":"耶和華","s":["H3068G"],"a":[0]},{"t":"作王","s":["H4427A"],"a":[1]},{"t":"；眾"},{"t":"民","s":["H5971A"],"a":[3]},{"t":"當戰抖","s":["H7264"],"a":[2]},{"t":"。祂"},{"t":"坐","s":["H3427"],"a":[4]},{"t":"在"},{"t":"二基路伯","s":["H3742"],"a":[5]},{"t":"之間；"},{"t":"地","s":["H0776G"],"a":[7]},{"t":"當動搖","s":["H5120"],"a":[6]},{"t":"。"}]},{"n":2,"text":"耶和華在錫安為大；祂被尊崇，超乎萬民之上。","tok":[{"t":"耶和華","s":["H3068G"],"a":[0]},{"t":"在錫安","s":["H6726"],"a":[1]},{"t":"為大","s":["H1419A"],"a":[2]},{"t":"；祂被尊"},{"t":"崇","s":["H7311A"],"a":[3]},{"t":"，超乎"},{"t":"萬","s":["H3605"],"a":[6]},{"t":"民","s":["H5971A"],"a":[7]},{"t":"之"},{"t":"上","s":["H5921A"],"a":[5]},{"t":"。"}]},{"n":3,"text":"他們當讚美你大而可畏的名，這名是聖別的；","tok":[{"t":"他們當讚","s":["H3034"],"a":[0]},{"t":"美"},{"t":"你","s":["H9021"],"a":[1]},{"t":"大","s":["H1419A"],"a":[2]},{"t":"而可畏的","s":["H3372H"],"a":[3]},{"t":"名","s":["H8034"],"a":[1]},{"t":"，這名是"},{"t":"聖","s":["H6918G"],"a":[4]},{"t":"別的；"}]},{"n":4,"text":"又當讚美王的能力，祂喜愛公平。你堅立公正，在雅各中施行公理和公義。","tok":[{"t":"又當讚美"},{"t":"王","s":["H4428G"],"a":[1]},{"t":"的能力","s":["H5797"],"a":[0]},{"t":"，"},{"t":"祂喜愛","s":["H0157G"],"a":[3]},{"t":"公","s":["H4941H"],"a":[2]},{"t":"平。"},{"t":"你堅立","s":["H3559H"],"a":[5]},{"t":"公正","s":["H4339"],"a":[6]},{"t":"，"},{"t":"在雅各中","s":["H3290"],"a":[9]},{"t":"施行","s":["H6213A"],"a":[11]},{"t":"公","s":["H4941H"],"a":[7]},{"t":"理"},{"t":"和公義","s":["H6666"],"a":[8]},{"t":"。"}]},{"n":5,"text":"你們當尊崇耶和華我們的神，在祂腳凳前下拜；祂是聖別的。","tok":[{"t":"你們當尊崇","s":["H7311A"],"a":[0]},{"t":"耶和華","s":["H3068G"],"a":[1]},{"t":"我們"},{"t":"的神","s":["H0430G"],"a":[2]},{"t":"，在祂"},{"t":"腳","s":["H7272"],"a":[5]},{"t":"凳前","s":["H1916"],"a":[4]},{"t":"下拜","s":["H7812"],"a":[3]},{"t":"；祂是"},{"t":"聖別","s":["H6918G"],"a":[6]},{"t":"的。"}]},{"n":6,"text":"在祂的祭司中有摩西和亞倫，在呼求祂名的人中有撒母耳，他們呼求耶和華，祂就應允他們。","tok":[{"t":"在祂"},{"t":"的祭司中","s":["H3548"],"a":[2]},{"t":"有摩西","s":["H4872"],"a":[0]},{"t":"和亞倫","s":["H0175"],"a":[1]},{"t":"，在"},{"t":"呼求","s":["H7121G"],"a":[4]},{"t":"祂名","s":["H8034"],"a":[5]},{"t":"的人中有"},{"t":"撒母耳","s":["H8050G"],"a":[3]},{"t":"，他們呼"},{"t":"求","s":["H7121G"],"a":[6]},{"t":"耶和華","s":["H3068G"],"a":[8]},{"t":"，祂"},{"t":"就應允他們","s":["H6030B"],"a":[10]},{"t":"。"}]},{"n":7,"text":"祂在雲柱中對他們說話；他們遵守祂的法度，和祂所賜給他們的律例。","tok":[{"t":"祂"},{"t":"在雲","s":["H6051"],"a":[1]},{"t":"柱中","s":["H5982G"],"a":[0]},{"t":"對他們","s":["H9038"],"a":[3]},{"t":"說話","s":["H1696G"],"a":[2]},{"t":"；他們"},{"t":"遵守","s":["H8104G"],"a":[4]},{"t":"祂"},{"t":"的法度","s":["H5713B"],"a":[5]},{"t":"，和祂所"},{"t":"賜","s":["H5414G"],"a":[7]},{"t":"給"},{"t":"他們","s":["H9038"],"a":[8]},{"t":"的律例","s":["H2706G"],"a":[6]},{"t":"。"}]},{"n":8,"text":"耶和華我們的神阿，你應允了他們；你是赦免他們的神，卻也是按他們所行施行報應的一位。","tok":[{"t":"耶和華","s":["H3068G"],"a":[0]},{"t":"我們"},{"t":"的神","s":["H0430G"],"a":[1]},{"t":"阿，"},{"t":"你","s":["H0859A"],"a":[2]},{"t":"應允了","s":["H6030B"],"a":[3]},{"t":"他們；"},{"t":"你","s":["H1961"],"a":[6]},{"t":"是"},{"t":"赦免","s":["H5375I"],"a":[5]},{"t":"他們的"},{"t":"神","s":["H0410G"],"a":[4]},{"t":"，卻也是"},{"t":"按","s":["H5921A"],"a":[9]},{"t":"他們所"},{"t":"行施行","s":["H5949"],"a":[10]},{"t":"報應","s":["H5358"],"a":[8]},{"t":"的一位。"}]},{"n":9,"text":"你們要尊崇耶和華我們的神，在祂的聖山下拜；因為耶和華我們的神是聖別的。","tok":[{"t":"你們要尊崇","s":["H7311A"],"a":[0]},{"t":"耶和華","s":["H3068G"],"a":[1]},{"t":"我們"},{"t":"的神","s":["H0430G"],"a":[2]},{"t":"，在"},{"t":"祂的聖","s":["H6944G"],"a":[5]},{"t":"山","s":["H2022G"],"a":[4]},{"t":"下拜","s":["H7812"],"a":[3]},{"t":"；"},{"t":"因為","s":["H3588A"],"a":[6]},{"t":"耶和華","s":["H3068G"],"a":[8]},{"t":"我們"},{"t":"的神","s":["H0430G"],"a":[9]},{"t":"是"},{"t":"聖別","s":["H6918G"],"a":[7]},{"t":"的。"}]}]}
