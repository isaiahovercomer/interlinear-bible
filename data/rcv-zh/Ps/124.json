{"v":1,"book":"Ps","ch":124,"verses":[{"n":0,"text":"大衛的上行之歌。","tok":[{"t":"大衛","s":["H9001","H1732"],"a":[2]},{"t":"的"},{"t":"上行","s":["H4609"],"a":[1]},{"t":"之歌。"}]},{"n":1,"text":"以色列人要說，若不是耶和華在我們這邊，","tok":[{"t":"以色列","s":["H3478"],"a":[6]},{"t":"人要","s":["H4994"],"a":[5]},{"t":"說","s":["H0559"],"a":[4]},{"t":"，"},{"t":"若不是","s":["H3884"],"a":[0]},{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"在"},{"t":"我們","s":["H9001"]},{"t":"這邊，"}]},{"n":2,"text":"若不是耶和華在我們這邊，當人起來攻擊我們，","tok":[{"t":"若不是","s":["H3884"],"a":[0]},{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"在"},{"t":"我們","s":["H9001"]},{"t":"這邊，"},{"t":"當人","s":["H0120"],"a":[6]},{"t":"起來","s":["H9002","H6965"],"a":[4]},{"t":"攻擊我們","s":["H5921"],"a":[5]},{"t":"，"}]},{"n":3,"text":"向我們發怒的時候，早就把我們活活的吞了；","tok":[{"t":"向我們","s":["H9002"]},{"t":"發","s":["H9002","H2734"],"a":[3]},{"t":"怒","s":["H0639"],"a":[4]},{"t":"的時候，早就"},{"t":"把我們活活","s":["H2416"],"a":[1]},{"t":"的"},{"t":"吞了","s":["H1104"],"a":[2]},{"t":"；"}]},{"n":4,"text":"那時，大水必漫過我們，河水必淹沒我們；","tok":[{"t":"那時","s":["H0233"],"a":[0]},{"t":"，大水"},{"t":"必漫過我們","s":["H7857"],"a":[2]},{"t":"，"},{"t":"河水","s":["H5158"],"a":[3]},{"t":"必淹","s":["H5674"],"a":[4]},{"t":"沒","s":["H5921"],"a":[5]},{"t":"我們","s":["H5315"],"a":[6]},{"t":"；"}]},{"n":5,"text":"那時，狂傲的水必淹沒我們。","tok":[{"t":"那時，"},{"t":"狂傲的","s":["H2121"],"a":[5]},{"t":"水","s":["H4325"],"a":[4]},{"t":"必淹","s":["H5674"],"a":[1]},{"t":"沒","s":["H5921"],"a":[2]},{"t":"我們","s":["H5315"],"a":[3]},{"t":"。"}]},{"n":6,"text":"耶和華是當受頌讚的，祂沒有把我們交給敵人，作他們爪牙下的獵物。","tok":[{"t":"耶和華","s":["H3068"],"a":[1]},{"t":"是當","s":["H1288"],"a":[0]},{"t":"受"},{"t":"頌","s":["H1288"]},{"t":"讚的，祂"},{"t":"沒有","s":["H7945","H3808"],"a":[2]},{"t":"把我們","s":["H2964"],"a":[4]},{"t":"交","s":["H5414"],"a":[3]},{"t":"給敵人，作他們爪"},{"t":"牙","s":["H9001","H8127"],"a":[5]},{"t":"下的獵物。"}]},{"n":7,"text":"我們好像雀鳥從捕鳥人的網羅裏逃脫；網羅破裂，我們逃脫了。","tok":[{"t":"我們","s":["H5315"],"a":[0]},{"t":"好像雀鳥","s":["H9003","H6833"],"a":[1]},{"t":"從捕鳥人","s":["H3369"],"a":[4]},{"t":"的網羅","s":["H4480","H6341"],"a":[3]},{"t":"裏"},{"t":"逃脫","s":["H4422"],"a":[2]},{"t":"；"},{"t":"網羅","s":["H6341"],"a":[5]},{"t":"破裂","s":["H7665"],"a":[6]},{"t":"，"},{"t":"我們","s":["H0587"],"a":[7]},{"t":"逃脫了","s":["H4422"],"a":[8]},{"t":"。"}]},{"n":8,"text":"我們得幫助，是在於造天地之耶和華的名。","tok":[{"t":"我們得幫助","s":["H5828"],"a":[0]},{"t":"，是在於"},{"t":"造","s":["H6213"],"a":[3]},{"t":"天","s":["H8064"],"a":[4]},{"t":"地","s":["H0776"],"a":[5]},{"t":"之耶和華","s":["H3068"],"a":[2]},{"t":"的名","s":["H9002","H8034"],"a":[1]},{"t":"。"}]}]}
