{"v":1,"book":"Ps","ch":70,"verses":[{"n":0,"text":"大衛的記念詩，交與歌詠長。","tok":[{"t":"大衛的","s":["H1732"],"a":[1]},{"t":"記念","s":["H2142"],"a":[2]},{"t":"詩，"},{"t":"交與","s":["H5329"],"a":[0]},{"t":"歌詠"},{"t":"長","s":["H5329"],"a":[0]},{"t":"。"}]},{"n":1,"text":"神阿，求你快快搭救我；耶和華阿，求你快快幫助我。","tok":[{"t":"神","s":["H0430G"],"a":[0]},{"t":"阿，求"},{"t":"你","s":["H9030"],"a":[1]},{"t":"快快"},{"t":"搭救我","s":["H5337"],"a":[1]},{"t":"；"},{"t":"耶和華","s":["H3068G"],"a":[2]},{"t":"阿，"},{"t":"求你快快","s":["H2363A"],"a":[4]},{"t":"幫助我","s":["H5833"],"a":[3]},{"t":"。"}]},{"n":2,"text":"願那些尋索我命的，抱愧蒙羞；願那些喜悅我遭難的，退後受辱。","tok":[{"t":"願那"},{"t":"些尋索","s":["H1245"],"a":[2]},{"t":"我命","s":["H5315H"],"a":[3]},{"t":"的，"},{"t":"抱愧","s":["H0954"],"a":[0]},{"t":"蒙羞","s":["H2659"],"a":[1]},{"t":"；願那些"},{"t":"喜悅","s":["H2655"],"a":[7]},{"t":"我遭","s":["H7451C"],"a":[8]},{"t":"難的，退"},{"t":"後","s":["H0268"],"a":[5]},{"t":"受辱","s":["H3637"],"a":[6]},{"t":"。"}]},{"n":3,"text":"願那些對我說，阿哈，阿哈的，因羞愧退去。","tok":[{"t":"願"},{"t":"那些對我說","s":["H0559"],"a":[4]},{"t":"，阿哈，阿哈的，因"},{"t":"羞愧","s":["H1322"],"a":[3]},{"t":"退","s":["H7725G"],"a":[0]},{"t":"去。"}]},{"n":4,"text":"願一切尋求你的，因你歡喜快樂；願那些愛你救恩的，常說，當尊神為大！","tok":[{"t":"願"},{"t":"一切","s":["H3605"],"a":[3]},{"t":"尋求","s":["H1245"],"a":[4]},{"t":"你的，因你歡喜"},{"t":"快樂","s":["H8055"],"a":[1]},{"t":"；願那"},{"t":"些愛","s":["H0157G"],"a":[9]},{"t":"你救恩","s":["H3444"],"a":[10]},{"t":"的，"},{"t":"常","s":["H8548"],"a":[6]},{"t":"說","s":["H0559"],"a":[5]},{"t":"，當"},{"t":"尊","s":["H1431"],"a":[7]},{"t":"神","s":["H0430G"],"a":[8]},{"t":"為大","s":["H1431"],"a":[7]},{"t":"！"}]},{"n":5,"text":"但我是困苦窮乏的；神阿，求你速速到我這裏來。你是幫助我的，搭救我的；耶和華阿，求你不要耽延。","tok":[{"t":"但我","s":["H0589"],"a":[0]},{"t":"是困苦","s":["H6041"],"a":[1]},{"t":"窮乏的","s":["H0034"],"a":[2]},{"t":"；"},{"t":"神","s":["H0430G"],"a":[3]},{"t":"阿，"},{"t":"求你速速","s":["H2363A"],"a":[4]},{"t":"到"},{"t":"我","s":["H9030"],"a":[5]},{"t":"這裏來。"},{"t":"你","s":["H0859A"],"a":[8]},{"t":"是"},{"t":"幫助我","s":["H5828"],"a":[6]},{"t":"的，"},{"t":"搭救我","s":["H6403"],"a":[7]},{"t":"的；"},{"t":"耶和華","s":["H3068G"],"a":[9]},{"t":"阿，"},{"t":"求你不要","s":["H0408"],"a":[10]},{"t":"耽延","s":["H0309"],"a":[11]},{"t":"。"}]}]}
